list menu (
    name: Menu
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select nivel as level_value
            , "NOMBRE" as label_value
            , CASE WHEN TARGET>0 THEN 'f?p=&APP_ID.:'|| TARGET ||':'||:APP_SESSION||'::::'  END  as target_value
            , NULL as is_current
            , "ICONO" as image_value
            , null as image_attr_value
            , null as image_alt_value
            from "BSW_FORMAS_APEX"
            order by ID_FORMA asc;
            ```
    }
)

list menu-dinamico (
    name: Menu Dinamico
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
                LEVEL "level",
                NAV_NAME "label",
                decode( connect_by_isleaf, 0, '','f?p=&APP_ID.:'
            	    	|| TO_CHAR(PAGE_NO) 
            	    	|| ':&SESSION.:::::' 
            	    	) target,
                NULL as is_current,
                decode(nvl(ICON_IMG, 'A'), 'A', '', ICON_IMG) image
            from
                BSW_FORMAS_PAGINAS
                WHERE NAV_ID IN (SELECT PAGINA_ID
                                        FROM BSW_ACCESO_POR_GRUPOS_APEX
                                       WHERE ID_GRUPO = :P0_GRUPO_USUARIO)
                                                           AND
            
                      NVL(MOSTRAR_MENU,'N')='S'
            
                 ---(PAGE_NO NOT IN (SELECT PAGE_ID FROM 
                --APEX_APPLICATION_PAGES 
             --WHERE application_id = :APP_ID AND PAGE_MODE='Modal Dialog' and PAGE_FUNCTION='Form') OR PAGE_NO IS  NULL)
              
             
             
            start with
                PARENT_ID is null
            connect by
                prior NAV_ID = PARENT_ID 
                ORDER SIBLINGS BY ORDEN ASC
                
            ```
    }

    entry carga-de-pedidos-de-produccion (
        label: Carga de Pedidos de Produccion
        icon {
            imageIconCssClasses: fa-forms
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 872
        }
        link {
            target: {
                page: 872
            }
        }
    )

    entry maquinas (
        label: Maquinas
        icon {
            imageIconCssClasses: fa-table-pointer
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 868
        }
        link {
            target: {
                page: 868
            }
        }
    )

    entry operaciones (
        label: Operaciones
        icon {
            imageIconCssClasses: fa-table-pointer
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: pages
            pages: 865
        }
        link {
            target: {
                page: 865
            }
        }
    )

    entry pedidos-de-produccion (
        label: Pedidos de Produccion
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 30
        }
        isCurrent {
