restDataSource Grupos_de_Contactos (
    name: Grupos de Contactos
    source {
        type: http
        remoteServer: @whats_flow_com_py_api_get
        urlPathPrefix: groups
    }
    authentication {
        credentials: @Credentials_for_Mensajes_Pendientes
    }
    synchronization {
        localTableOwner: INV
        localTableName: WH_GRUPOS
        httpRequestLimit: 1000
    }
    advanced {
        passEcid: Y
    }

    operation get (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )

    dataProfile {
        name: Grupos de Contactos
        rowSelector: data
    }

    dataProfileColumn id (
        columnName: ID
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: id
        }
    )

    dataProfileColumn name (
        columnName: NAME
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: name
        }
    )

)

