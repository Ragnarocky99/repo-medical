restDataSource Mensajes_Recibios (
    name: Mensajes Recibios
    source {
        type: http
        remoteServer: @whats_flow_com_py_api_get
        urlPathPrefix: wa.sent
    }
    authentication {
        credentials: @Credentials_for_Mensajes_Pendientes
    }
    advanced {
        passEcid: Y
    }

    operation get (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )

    parameter limit (
        name: limit
        parameter {
            type: urlQueryString
        }
        value {
            defaultValueType: staticValue
            staticValue: 100
        }
    )

    dataProfile {
        name: Mensajes Recibidos
        rowSelector: data
    }

    dataProfileColumn account (
        columnName: ACCOUNT
        source {
            sequence: 4
            dataType: number
        }
        parsing {
            pathExpression: account
        }
    )

    dataProfileColumn api (
        columnName: API
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: api
        }
    )

    dataProfileColumn attachment (
        columnName: ATTACHMENT
        source {
            sequence: 8
            dataType: varchar2
        }
        parsing {
            pathExpression: attachment
        }
    )

    dataProfileColumn created (
        columnName: CREATED
        source {
            sequence: 5
            dataType: number
        }
        parsing {
            pathExpression: created
        }
    )

    dataProfileColumn id (
        columnName: ID
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: id
        }
    )

    dataProfileColumn message (
        columnName: MESSAGE
        source {
            sequence: 6
            dataType: varchar2
        }
        parsing {
            pathExpression: message
        }
    )

    dataProfileColumn recipient (
        columnName: RECIPIENT
        source {
            sequence: 7
            dataType: number
        }
        parsing {
            pathExpression: recipient
        }
    )

    dataProfileColumn status (
        columnName: STATUS
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            pathExpression: status
        }
    )

)

