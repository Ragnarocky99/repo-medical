restDataSource Mensajes_Pendientes (
    name: Mensajes Pendientes
    source {
        type: http
        remoteServer: @whats_flow_com_py_api_get
        urlPathPrefix: /wa.pending
    }
    authentication {
        credentials: @Credentials_for_Mensajes_Pendientes
    }
    advanced {
        passEcid: Y
    }

    operation get (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )

    dataProfile {
        name: Mensajes Pendientes
        rowSelector: data
    }

    dataProfileColumn message (
        columnName: MESSAGE
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: message
        }
    )

    dataProfileColumn status (
        columnName: STATUS
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: status
        }
    )

)

