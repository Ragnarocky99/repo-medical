restDataSource Cuentas_de_WhatsApp (
    name: Cuentas de WhatsApp
    source {
        type: http
        remoteServer: @whats_flow_com_py_api_get
        urlPathPrefix: wa.accounts
    }
    authentication {
        credentials: @Credentials_for_Mensajes_Pendientes
    }
    advanced {
        passEcid: Y
    }

    operation get (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )

    dataProfile {
        name: Cuentas de WhatsApp
        rowSelector: data
    }

    dataProfileColumn created (
        columnName: CREATED
        source {
            sequence: 4
            dataType: number
        }
        parsing {
            pathExpression: created
        }
    )

    dataProfileColumn id (
        columnName: ID
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: id
        }
    )

    dataProfileColumn phone (
        columnName: PHONE
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: phone
        }
    )

    dataProfileColumn unique (
        columnName: UNIQUE_
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            pathExpression: unique
        }
    )

)

