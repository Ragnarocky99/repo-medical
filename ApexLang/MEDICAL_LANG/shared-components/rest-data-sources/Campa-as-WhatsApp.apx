restDataSource Campa_as_WhatsApp (
    name: Campañas WhatsApp
    source {
        type: http
        remoteServer: @whats_flow_com_py_api_get
        urlPathPrefix: wa.campaigns
    }
    authentication {
        credentials: @Credentials_for_Mensajes_Pendientes
    }
    synchronization {
        localTableOwner: INV
        localTableName: WH_CAMPANHAS_WHATSAPP
        type: fullRefreshDelete
        schedule: FREQ=DAILY;INTERVAL=1;BYHOUR=0;BYMINUTE=0;BYSECOND=0
        httpRequestLimit: 1000
    }
    advanced {
        passEcid: Y
    }

    operation get (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )

    dataProfile {
        name: Campañas WhatsApp
        rowSelector: data
    }

    dataProfileColumn account (
        columnName: ACCOUNT
        source {
            sequence: 5
            dataType: number
        }
        parsing {
            pathExpression: account
        }
    )

    dataProfileColumn contacts (
        columnName: CONTACTS
        source {
            sequence: 7
            dataType: number
        }
        parsing {
            pathExpression: contacts
        }
    )

    dataProfileColumn created (
        columnName: CREATED
        source {
            sequence: 6
            dataType: number
        }
        parsing {
            pathExpression: created
        }
    )

    dataProfileColumn id (
        columnName: ID
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: id
        }
    )

    dataProfileColumn name (
        columnName: NAME
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: name
        }
    )

    dataProfileColumn status (
        columnName: STATUS
        source {
            sequence: 4
            dataType: varchar2
        }
        parsing {
            pathExpression: status
        }
    )

    dataProfileColumn type (
        columnName: TYPE
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            pathExpression: type
        }
    )

)

