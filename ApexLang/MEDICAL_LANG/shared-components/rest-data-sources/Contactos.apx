restDataSource Contactos (
    name: Contactos
    source {
        type: http
        remoteServer: @whats_flow_com_py_api_get
        urlPathPrefix: contacts
    }
    authentication {
        credentials: @Credentials_for_Mensajes_Pendientes
    }
    advanced {
        passEcid: Y
    }

    operation get (
        label: GET
        operation {
            urlPattern: .
            httpMethod: get
            databaseOperation: fetchRows
        }
    )

    parameter limit (
        name: limit
        parameter {
            type: httpHeader
        }
        value {
            defaultValueType: staticValue
            staticValue: 100
        }
    )

    dataProfile {
        name: Contactos
        rowSelector: data
    }

    dataProfileColumn groups (
        columnName: groups
        source {
            sequence: 4
            dataType: jsonDocument
        }
        parsing {
            pathExpression: groups
        }
    )

    dataProfileColumn id (
        columnName: ID
        source {
            sequence: 1
            dataType: number
        }
        parsing {
            pathExpression: id
        }
    )

    dataProfileColumn name (
        columnName: NAME
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: name
        }
    )

    dataProfileColumn phone (
        columnName: PHONE
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            pathExpression: phone
        }
    )

)

