lov lv-facturas-p (
    name: LV_FACTURAS_P807
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            WITH PENDIENTES AS(
                 SELECT DISTINCT DEV.ID_FACTURA_REF,
                                 VC.TOT_COMPROBANTE
                   FROM VTW_COMPROBANTES_CABECERA_SOL DEV
                   JOIN VTW_COMPROBANTES_CABECERA     VC ON VC.ID = DEV.ID_FACTURA_REF
                  WHERE NVL(VC.ESTADO, 'P') = 'A'
                 UNION ALL
                 SELECT DEV.ID_FACTURA_REF,
                        SUM(NC.TOT_COMPROBANTE) TOT_COMPROBANTE
                   FROM VTW_COMPROBANTES_CABECERA_SOL DEV
                   JOIN VTW_COMPROBANTES_CABECERA     VC ON VC.ID = DEV.ID_FACTURA_REF
                   JOIN VTW_COMPROBANTES_CABECERA     NC ON NC.ID = DEV.ID_NCR_REF
                  WHERE NVL(VC.ESTADO, 'P') != 'A'
                 GROUP BY DEV.ID_FACTURA_REF,
                          VC.TOT_COMPROBANTE
            )
               SELECT 
                      VC.ID,
                      VC.ID_CLIENTE,
                      VC.FEC_COMPROBANTE,
                      VC.TIP_COMPROBANTE,
                      VC.SER_TIMBRADO,
                      VC.NRO_COMPROBANTE,
                      VC.NOM_CLIENTE,
                      VC.TIP_COMPROBANTE||' '||VC.SER_TIMBRADO||'-'||LPAD(VC.NRO_COMPROBANTE, 7, '0') DISPLAY
                 FROM VTW_COMPROBANTES_CABECERA VC
            LEFT JOIN PENDIENTES                PE ON VC.ID = PE.ID_FACTURA_REF
                WHERE VC.TOT_COMPROBANTE - NVL(PE.TOT_COMPROBANTE, 0) > 0
                  AND VC.ID_CLIENTE = :P807_ID_CLIENTE
                  AND VC.ID_EMPRESA = :P0_ID_EMPRESA
                  AND VC.TIP_COMPROBANTE = 'FVE'
                  AND :P807_ID IS NULL
            UNION ALL
            SELECT 
                      VC.ID,
                      VC.ID_CLIENTE,
                      VC.FEC_COMPROBANTE,
                      VC.TIP_COMPROBANTE,
                      VC.SER_TIMBRADO,
                      VC.NRO_COMPROBANTE,
                      VC.NOM_CLIENTE,
                      VC.TIP_COMPROBANTE||' '||VC.SER_TIMBRADO||'-'||LPAD(VC.NRO_COMPROBANTE, 7, '0') DISPLAY
                 FROM VTW_COMPROBANTES_CABECERA VC
                WHERE VC.ID = :P807_ID_FACTURA_REF
                  AND :P807_ID IS NOT NULL
            ORDER BY 1 DESC
            ```
    }
    columnMapping {
        return: ID
        display: DISPLAY
    }

    column DISPLAY (
        show: false
        heading {
            heading: Display
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column FEC_COMPROBANTE (
        heading {
            heading: <p>Fecha</p>
        }
        layout {
            sequence: 20
        }
        source {
            dataType: date
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column ID_CLIENTE (
        show: false
        heading {
            heading: Id Cliente
        }
        layout {
            sequence: 30
        }
        source {
            dataType: number
        }
    )

    column NOM_CLIENTE (
        heading {
            heading: <p>Cliente</p>
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

    column NRO_COMPROBANTE (
        heading {
            heading: <p>Nro. Comprobante</p>
        }
        layout {
            sequence: 50
