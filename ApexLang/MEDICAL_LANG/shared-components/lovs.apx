lov lv-usuarios (
    name: LV_USUARIOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT P.NOMBRE, U.ID
            FROM BSW_USUARIOS U inner join BSW_PERSONAS P
            ON U.ID_PERSONA = P.ID
            WHERE ID_EMPRESA=:P0_COD_EMPRESA
            ORDER BY COD_USUARIO
            ```
    }
    columnMapping {
        return: ID
        display: NOMBRE
    }
)

lov lv-usuarios-bpm (
    name: LV_USUARIOS_BPM
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select u.cod_usuario, upper(nvl(P.NOMBRE, p.nomb_fantasia)) NOMBRE
              from bsw_usuarios u, bsw_personas p, bpm_actividades a
             where u.id_empresa  = :P0_ID_EMPRESA
               and p.id          = u.id_persona
               and a.cod_usuario = u.cod_usuario
               and a.cod_empresa = u.id_empresa
              group by u.cod_usuario, upper(nvl(P.NOMBRE, p.nomb_fantasia))
            ```
    }
    columnMapping {
        return: COD_USUARIO
        display: NOMBRE
        defaultSort: NOMBRE
    }
)

lov lv-usuarios-pg (
    name: LV_USUARIOS_PG621
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT      P.NOMBRE, U.ID
              FROM      BSW_USUARIOS U
            INNER JOIN  BSW_PERSONAS P ON U.ID_PERSONA = P.ID
             WHERE  ID_EMPRESA=:P0_ID_EMPRESA
               AND  U.COD_USUARIO = :APP_USER
