lov lv-departamentos-rrhh (
    name: LV_DEPARTAMENTOS_RRHH
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ID,
                   COD_DEPARTAMENTO,
                   DESCRIPCION,
                   ID_EMPRESA,
                   ID_SUCURSAL,
                   ACTIVO,
                   CASE ACTIVO
                    WHEN 'S' THEN 'fa fa-check u-success-text'
                    WHEN 'N' THEN 'fa fa-remove u-danger-text'
                   END ACTIVO_ICON       
              from RHW_DEPARTAMENTOS
              where ID_EMPRESA=:P0_ID_EMPRESA
              AND ID_SUCURSAL=:P0_ID_SUCURSAL
              AND ACTIVO = 'S'
              order by ID ASC;
            ```
    }
    columnMapping {
        return: ID
        display: DESCRIPCION
    }
)

