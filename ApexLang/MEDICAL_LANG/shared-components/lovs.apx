lov lv-anticipos-clientes (
    name: LV_ANTICIPOS_CLIENTES_75
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT SAL.TIPO_COMPROBANTE || '-' || SAL.SER_COMPROBANTE || '-' || SAL.NRO_COMPROBANTE AS ANTICIPO,
                   FEC_COMPROBANTE,
                   TO_CHAR(SAL.SALDO_CUOTA, '999G999G999') AS MONTO,
                   MON.DESCRIPCION AS MONEDA,
                   PER.NOMBRE AS CLIENTE,
                   CAB.ID AS ID_ANTICIPO,
                   CAB.NRO_COMPROBANTE 
              FROM CCW_ANTICIPOS_CLIENTES_CAB CAB
              JOIN CCW_CLIENTES CLI
                ON CAB.ID_CLIENTE = CLI.ID
              JOIN BSW_PERSONAS PER
                ON CLI.ID_PERSONA = PER.ID
              JOIN BSW_MONEDAS MON
                ON CAB.ID_MONEDA = MON.ID
              JOIN CCW_SALDOS SAL
                ON  CAB.ID = SAL.Id_Comprobante_Ant
                AND SAL.TIPO_COMPROBANTE = 'ADD'    
                WHERE CAB.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (CAB.ID_CLIENTE = :P75_ID_CLIENTE OR :P75_ID_CLIENTE  IS NULL);
            
            ```
    }
    columnMapping {
        return: ID_ANTICIPO
        display: NRO_COMPROBANTE
        defaultSort: ANTICIPO
