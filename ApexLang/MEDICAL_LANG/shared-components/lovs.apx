lov lv-nro-fac-clientes (
    name: LV_NRO_FAC_CLIENTES_822
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 
             FC.ID_COMPROBANTE AS RETURN,
             FC.TIP_COMPROBANTE,
             FC.SER_COMPROBANTE,
             FC.NRO_COMPROBANTE,
             FC.FEC_COMPROBANTE,
             FC.nombre_cliente
             FROM FEWV_FACTURA_CAB FC 
             WHERE FC.ID_EMPRESA = :P0_ID_EMPRESA 
             and nvl(FC.ind_aprobado_fe,'N')<>'S'
             UNION ALL
              SELECT 
             FC.ID_COMPROBANTE AS RETURN,
             FC.TIP_COMPROBANTE,
             FC.SER_COMPROBANTE,
             FC.NRO_COMPROBANTE,
             FC.FEC_COMPROBANTE,
             FC.nombre_cliente
             FROM FEWV_NOTCRED_CAB FC 
             WHERE FC.ID_EMPRESA = :P0_ID_EMPRESA 
             and nvl(FC.ind_aprobado_fe,'N')<>'S'
             UNION ALL
            SELECT 
             FC.ID_REMISION AS RETURN,
             FC.TIP_COMPROBANTE,
             FC.SER_COMPROBANTE,
             FC.NRO_COMPROBANTE,
             FC.FEC_COMPROBANTE,
             FC.nombre_cliente
             FROM FEWV_REMISION_CAB FC 
             WHERE FC.ID_EMPRESA = :P0_ID_EMPRESA 
             and nvl(FC.ind_aprobado_fe,'N')<>'S'
            ```
    }
    columnMapping {
        return: RETURN
        display: NOMBRE_CLIENTE
    }

