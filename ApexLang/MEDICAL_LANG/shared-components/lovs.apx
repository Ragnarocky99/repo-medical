lov lv-cuentas-contables-asentable-p (
    name: LV_CUENTAS_CONTABLES_ASENTABLE_P392
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT '('||PC.COD_CUENTA||')'||PC.NOMBRE_CUENTA NOMBRE_CUENTA,PC.ID FROM COW_PLAN_CUENTAS PC
            WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND PC.ASENTABLE = 'S'
                AND (SUBSTR(PC.COD_CUENTA, 1, 1) = '2' OR EXISTS (SELECT 1
                                                       FROM CCW_CUENTAS_BANCARIAS CB
