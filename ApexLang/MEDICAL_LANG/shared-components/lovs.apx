                            A.COD_ORIGEN_ART AS "COD FABRICANTE"               
              FROM STW_ARTICULOS A
              LEFT JOIN STW_MARCAS M
                ON M.ID = A.ID_MARCA
              LEFT JOIN STW_ENVASES E
                ON E.ID = A.ID_ENVASE
              LEFT JOIN STW_UNIDADES_MEDIDA U
                ON U.ID = A.ID_UNIDAD_MEDIDA
             WHERE A.ID_EMPRESA = :P0_COD_EMPRESA
               AND NVL(A.ESTADO, 'N') = 'S' 
               order by to_number(a.cod_articulo) asc
            
            ```
    }
    columnMapping {
        return: ID
        display: COD_ARTICULO
    }

    column "COD FABRICANTE" (
        heading {
            heading: Cod Fabricante
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column COD_ARTICULO (
        heading {
            heading: Cod Articulo
        }
        layout {
            sequence: 30
        }
        source {
            dataType: number
        }
    )

    column DESCRIPCION (
        heading {
            heading: Descripcion
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

