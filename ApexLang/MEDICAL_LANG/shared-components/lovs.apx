lov lv-talonarios-recibo (
    name: LV_TALONARIOS_RECIBO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT S.ID, S.NUM_INICIAL, S.NUM_FINAL, S.TIP_COMPROBANTE, S.SER_COMPROBANTE, S.NRO_TIMBRADO, S.SER_TIMBRADO, S.IND_AUTO_IMPRESION,
            S.IND_AUTO_IMPRESION_TICKET
            FROM BSW_SERIES_COMPROB S, BSW_USUARIOS U
            WHERE S.ID_EMPRESA = :P0_ID_EMPRESA
            AND NVL(S.ID_SUCURSAL, :P0_ID_SUCURSAL) = :P0_ID_SUCURSAL
            AND S.TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT', 'TIPO_RECIBO')
            AND nvl( S.IND_ACTIVO, 'N' ) <> 'N'
            ---AND TERMINAL=:P135_TRAER_IP
            --AND S.TERMINAL = U.TERMINAL
            AND U.COD_USUARIO = :APP_USER
            ---and s.fec_vencimiento <= SYSDATE
            order by 1
            ```
