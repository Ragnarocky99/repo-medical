        heading {
            heading: IVA
        }
        layout {
            sequence: 80
        }
        source {
            dataType: varchar2
        }
    )

    column MONTO_TOTAL (
        heading {
            heading: Monto Total
        }
        layout {
            sequence: 90
        }
        source {
            dataType: number
        }
    )

    column NRO_COMPROBANTE (
