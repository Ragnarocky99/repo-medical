lov lv-tip-comprobantes (
    name: LV_TIP_COMPROBANTES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT T.ID,
                   T.TIP_COMPROBANTE,
                   T.DESCRIPCION,
                   T.ID_MODULO,
                   '(' ||M.COD_MODULO || ') ' || M.DESCRIPCION AS MODULO,
                   DECODE(T.IND_RES_90,'S','Sí','No')   AS RES_90,
                   DECODE(T.IND_ASIENTOS,'S','Sí','No') AS ASIENTOS
                   
            FROM BSW_TIPOS_COMPROBANTES T,
                 BSW_MODULOS            M
            WHERE T.ID_EMPRESA = :P0_ID_EMPRESA
              AND T.ID_MODULO  = M.ID
              AND T.ESTADO     = 'S'
            ```
    }
    columnMapping {
        return: ID
        display: TIP_COMPROBANTE
        defaultSort: TIP_COMPROBANTE
    }

    column ASIENTOS (
        heading {
            heading: Asientos
        }
        layout {
            sequence: 60
