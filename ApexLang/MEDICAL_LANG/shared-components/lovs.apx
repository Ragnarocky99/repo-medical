lov lv-proformas (
    name: LV_PROFORMAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select pro.tip_comprobante,
                   pro.ser_comprobante,
                   pro.nro_comprobante,
                   pro.referencia,
                   pro.fec_comprobante,
                   pr.cod_proveedor,
                   ltrim(pe.nombre) nombre,
                   sum(nvl(prod.cantidad, 0) - nvl(prod.cantidad_confirmada, 0)) cantidad,
                   pro.id
              from cmw_proformas_cabecera pro,
                   bsw_personas              pe,
                   cmw_proveedores        pr,
                   cmw_proformas_detalle  prod,
                   bsw_parametros_generales  pg
             where pro.id_empresa = :P0_ID_EMPRESA
               and pg.id_modulo = W_BUSCA_PARAMETRO('CM','ID_MODULO_CM')
               and pg.parametro = 'TIPO_PROFORMA'
               and pro.tip_comprobante = ltrim(rtrim(pg.valor))
              -- and pro.ser_comprobante = 'A'
               and nvl(pro.anulado, 'N') = 'N'
               and pro.id_empresa = pr.id_empresa
               and pro.id_proveedor = pr.id
               and pe.id = pr.id_persona
               and pro.id_empresa = prod.id_empresa
               and pro.id=prod.id_proforma_cabecera
               and nvl(prod.cantidad, 0) - nvl(prod.cantidad_confirmada, 0) > 0
             group by pro.tip_comprobante,
                      pro.ser_comprobante,
                      pro.nro_comprobante,
                      pro.referencia,
                      pro.fec_comprobante,
                      pr.cod_proveedor,
                      ltrim(pe.nombre),
                      pro.id
            having sum(nvl(prod.cantidad, 0) - nvl(prod.cantidad_confirmada, 0)) > 0
             order by pro.fec_comprobante desc, pro.nro_comprobante desc
            
            ```
    }
    columnMapping {
        return: ID
        display: NRO_COMPROBANTE
    }

    column CANTIDAD (
        heading {
            heading: Cantidad
        }
        layout {
            sequence: 80
        }
        source {
            dataType: number
        }
    )

    column COD_PROVEEDOR (
        heading {
            heading: Cod Proveedor
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column FEC_COMPROBANTE (
        heading {
            heading: Fec Comprobante
        }
        layout {
            sequence: 50
        }
        source {
            dataType: date
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

