lov lv-articulos-cotiza-ocp (
    name: LV_ARTICULOS_COTIZA_OCP
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 
                   pc.tip_comprobante,
                   pc.nro_comprobante, 
                   ca.nro_item,
                   ar.cod_articulo,
                   ca.cantidad_aprobada,
                   nvl(ca.nro_occ,'Sin OCC') nro_occ,
                   ca.observacion,
                   ar.cod_origen_art,
                   ca.id 
            from cmw_cotiza_articulos CA 
            join stw_articulos        AR on ca.id_articulo = ar.id
            join vtw_pedidos_cabecera PC on ca.id_pedido   = pc.id
            left join cmw_pedidos_detalle CPD on cpd.id_cotiza_art = ca.id and nvl(cpd.cantidad,0) = nvl(ca.cantidad_aprobada,0)
            
            where ca.id_articulo = :ID_ARTICULO
              and (cpd.id_cotiza_art is null or nvl(ca.cantidad_aprobada,0) > nvl(cpd.cantidad,0))
              and nvl(ca.cantidad_aprobada, 0) - nvl(ca.cant_anulada, 0) > 0
              and nvl(ca.cantidad_aprobada, 0) - nvl(ca.cant_anulada, 0) - nvl(ca.cantidad_entregada, 0) > 0
              and nvl(ca.cantidad_aprobada, 0) - nvl(ca.cant_remision, 0) > 0
              and :TIP_COMPROBANTE = 'PED'
            union all
            select 
                   pc.tip_comprobante,
                   pc.nro_comprobante, 
                   ca.nro_item,
                   ar.cod_articulo,
                   ca.cantidad_aprobada,
                   nvl(ca.nro_occ,'Sin OCC'),
                   ca.observacion,
                   ar.cod_origen_art,
                   ca.id
            from cmw_cotiza_articulos CA 
            join stw_articulos        AR on ca.id_articulo = ar.id
            join vtw_pedidos_cabecera PC on ca.id_pedido   = pc.id
            where  ca.id_pedido in (
                  select id_pedido
                    from cmw_pedidos_detalle
                   where id_pedido_cab = :P7_ID
              )
            union all
            select 
                   ae.tip_comprobante,
                   ae.nro_licitacion,
                   ae.nro_item,
                   ae.cod_articulo,
                   ae.cant_aprobada,
                   ae.nro_occ,
                   '' observacion,
                   ae.cod_fabricante,
                   ae.id_aprobacion
              from lcwv_articulos_a_entregar ae
            left join cmw_pedidos_detalle cpd on ae.id_aprobacion = cpd.id_aprobacion_lic
             where (cpd.id_aprobacion_lic is null or nvl(ae.cant_aprobada,0) > nvl(cpd.cantidad,0))
              and ae.cant_real > 0
              and ae.cant_real - nvl(ae.cant_entregada, 0) > 0
              and ae.id_articulo = :ID_ARTICULO
              and :TIP_COMPROBANTE = 'LIC'
            ```
    }
    columnMapping {
        return: ID
        display: NRO_COMPROBANTE
    }

    column CANTIDAD_APROBADA (
        heading {
            heading: <p>Cant. Aprobada</p>
        }
        layout {
            sequence: 70
        }
        source {
            dataType: number
        }
    )

    column COD_ARTICULO (
        heading {
            heading: <p>Cod. Articulo</p>
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column COD_ORIGEN_ART (
        heading {
            heading: <p>Cod. Fabricante</p>
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column ID (
        show: false
