lov lv-despachos (
    name: LV_DESPACHOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DC.NRO_DESPACHO,
                 'EMB - A - '||EM.NRO_EMBARQUE AS EMBARQUE,
                 '('||PV.COD_PROVEEDOR||')'||PE.NOMBRE AS PROV_EXTERIOR
            FROM CMW_DESPACHOS_CABECERA DC,
                 CMW_DESPACHOS_DETALLE  DET,
                 CMW_EMBARQUES          EM,
                 CMW_PROFORMAS_CABECERA PR,
                 CMW_PROVEEDORES        PV,
                 BSW_PERSONAS           PE
            WHERE DC.ID_EMPRESA = :P0_ID_EMPRESA
              AND DC.ID_EMPRESA = DET.ID_EMPRESA
              AND DC.ID = DET.ID_DESPACHO_CAB
              AND DET.ID_EMPRESA = EM.ID_EMPRESA
              AND DET.ID_EMBARQUE = EM.ID
              AND EM.ID_EMPRESA = PR.ID_EMPRESA
              AND EM.ID_PROFORMA = PR.ID
              AND PR.ID_PROVEEDOR = PV.ID
              AND PV.ID_PERSONA = PE.ID
            /*SELECT DC.NRO_DESPACHO 
            FROM CMW_DESPACHOS_CABECERA DC
            WHERE DC.ID_EMPRESA = :P0_ID_EMPRESA*/
            ```
    }
    columnMapping {
        return: NRO_DESPACHO
        display: NRO_DESPACHO
        defaultSort: NRO_DESPACHO
    }

    column EMBARQUE (
        heading {
            heading: Embarque
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column NRO_DESPACHO (
        heading {
            heading: Nro. Despacho
        }
        layout {
            sequence: 20
        }
        source {
            dataType: number
        }
    )

    column PROV_EXTERIOR (
        heading {
            heading: Prov Exterior
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

