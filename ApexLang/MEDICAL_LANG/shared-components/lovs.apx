lov lv-proveedores (
    name: LV_PROVEEDORES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ltrim(p.nombre) nombre, v.cod_proveedor, PC.NOMBRE_CUENTA, NVL(P.RUC, P.NRO_CI) AS DOCUMENTO, V.ID
             from bsw_personas p, cmw_proveedores v
             left join  COW_PLAN_CUENTAS PC on pc.id = v.id_cuenta_CONTABLE
             where v.id_persona = p.ID 
             and nvl(estado,'A') = 'A'
             --AND PC.COD_CUENTA = V.COD_CUENTA_CONTABLE
             order by ltrim(p.nombre) asc
            ```
