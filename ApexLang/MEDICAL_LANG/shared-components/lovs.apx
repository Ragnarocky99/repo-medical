    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT C.ID,
                   C.COD_CONCEPTO_COMP,
                   C.DESCRIPCION AS CONCEPTO,
                   P.COD_CUENTA,
                   P.NOMBRE_CUENTA
            
            FROM CPW_CONCEPTOS_COMPRAS C, COW_PLAN_CUENTAS P
            WHERE C.ID_CUENTA = P.ID
            ORDER BY regexp_replace(
                        regexp_replace(
                          regexp_replace(
                            P.COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                            ),
                          '(^|\.)(\d{2})','\1 0\2'
                        ),
                        '(^|\.)(\d)','\1 00\2'
                      );
            ```
    }
    columnMapping {
        return: ID
        display: COD_CONCEPTO_COMP
    }

    column COD_CONCEPTO_COMP (
        heading {
            heading: Cod Concepto Comp
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column COD_CUENTA (
        heading {
            heading: Cod Cuenta
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column CONCEPTO (
        heading {
            heading: Concepto
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

