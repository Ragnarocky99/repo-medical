lov lv-cuentas-contables (
    name: LV_CUENTAS_CONTABLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NOMBRE_CUENTA||'('||COD_CUENTA||')',ID FROM COW_PLAN_CUENTAS
            WHERE ID_EMPRESA=:P0_COD_EMPRESA
            ORDER BY regexp_replace(
                        regexp_replace(
                          regexp_replace(
                            COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                            ),
                          '(^|\.)(\d{2})','\1 0\2'
                        ),
                        '(^|\.)(\d)','\1 00\2'
                      );
            ```
    }
