lov bsw-tipos-comprobantes-tip-comprobante (
    name: BSW_TIPOS_COMPROBANTES.TIP_COMPROBANTE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select TC.TIP_COMPROBANTE, TC.DESCRIPCION, M.DESCRIPCION || ' ('||COD_MODULO||')' as MODULO
            from BSW_TIPOS_COMPROBANTES TC, BSW_MODULOS M
            where TC.ID_MODULO = M.ID
