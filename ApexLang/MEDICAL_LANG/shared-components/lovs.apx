lov lv-cp-cuotas (
    name: LV_CP_CUOTAS_238
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CO.REFERENCIA,CO.TIP_COMPROBANTE,CO.SER_COMPROBANTE,CU.NUM_CUOTA,CU.TOT_CUOTA,CU.TOT_SALDO,CO.NRO_COMPROBANTE,CO.ID,UPPER(MO.SIGLAS),
            'CM' AS TIPO,CU.ID AS ID_CUOTA
            FROM
            CPW_CUOTAS CU,
            CMW_PROVEEDORES PR,
            BSW_PERSONAS PE,
            BSW_MONEDAS MO,
            CMW_COMPRAS_CABECERA CO
            WHERE
            CU.ID_COMPROBANTE_CM=CO.ID
            AND CU.ID_PROVEEDOR=PR.ID
            AND PR.ID_PERSONA=PE.ID
            AND CU.ID_MONEDA=MO.ID
            AND CU.ID_EMPRESA=:P0_ID_EMPRESA
            AND  cU.tot_saldo <> 0 
            AND (CU.ID_PROVEEDOR = :P238_ID_PROVEEDOR OR :P238_ID_PROVEEDOR IS NULL)
            AND (CU.TIP_COMPROBANTE IN ('SAP', 'DIV') AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'S' OR CU.TIP_COMPROBANTE  NOT IN ('SAP', 'DIV'))
            AND (PR.IND_PERMITIR_VISUALIZAR = 'N' AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'S' OR PR.IND_PERMITIR_VISUALIZAR = 'S')
            UNION ALL
            SELECT CO.REFERENCIA,CO.TIP_COMPROBANTE,CO.SER_COMPROBANTE,CU.NUM_CUOTA,CU.TOT_CUOTA,CU.TOT_SALDO,CO.NUM_COMPROBANTE,CO.ID,UPPER(MO.SIGLAS),
            'CP',CU.ID AS ID_CUOTA
            FROM
            CPW_CUOTAS CU,
            CMW_PROVEEDORES PR,
            BSW_PERSONAS PE,
            BSW_MONEDAS MO,
            CPW_COMPROBANTES_CABECERA CO
            WHERE
            CU.ID_COMPROBANTE=CO.ID
            AND CU.ID_PROVEEDOR=PR.ID
            AND PR.ID_PERSONA=PE.ID
            AND CU.ID_MONEDA=MO.ID
            AND CU.ID_EMPRESA=:P0_ID_EMPRESA
            AND  cU.tot_saldo <> 0 
            AND (CU.ID_PROVEEDOR = :P238_ID_PROVEEDOR OR :P238_ID_PROVEEDOR IS NULL)
            AND (CU.TIP_COMPROBANTE IN ('SAP', 'DIV') AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'S' OR CU.TIP_COMPROBANTE  NOT IN ('SAP', 'DIV'))
            AND (PR.IND_PERMITIR_VISUALIZAR = 'N' AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'S' OR PR.IND_PERMITIR_VISUALIZAR = 'S')
            ORDER BY TIP_COMPROBANTE,SER_COMPROBANTE,NRO_COMPROBANTE,NUM_CUOTA
            ```
    }
    columnMapping {
        return: ID_CUOTA
        display: NRO_COMPROBANTE
    }

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column ID_CUOTA (
        show: false
        heading {
            heading: Id Cuota
        }
        layout {
            sequence: 110
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column NRO_COMPROBANTE (
        heading {
            heading: <p>Numero</p>
        }
        layout {
            sequence: 40
        }
        source {
            dataType: number
        }
    )

    column NUM_CUOTA (
