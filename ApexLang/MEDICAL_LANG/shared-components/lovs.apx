lov lv-cmw-pedido (
    name: LV_CMW_PEDIDO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select PC.ID,
                   pc.tip_comprobante, 
                   pc.ser_comprobante, 
                   pc.nro_comprobante, 
                   pc.fec_comprobante, 
                   pc.id_proveedor,
                   pc.referencia As Referencia, 
                   sum(nvl(pd.cantidad,0) - nvl(pd.cantidad_confirmada,0)) cantidad 
            from cmw_pedidos_cabecera pc, 
                 cmw_pedidos_detalle  pd, 
                 cmw_proveedores      pr
            where  nvl(pc.anulado,'N') = 'N' 
              and pc.tip_comprobante = 'PED' 
              and pc.ser_comprobante = 'A' 
              and pc.id=pd.id_pedido_cab 
              and nvl(pd.cantidad,0) - nvl(pd.cantidad_confirmada,0) > 0 
                        --  AND TIPO='IMP'
            
              and pr.id_empresa   =  pc.id_empresA
              and pr.id =   pc.id_proveedor
            
            group by PC.ID,
                     pc.tip_comprobante, 
                     pc.ser_comprobante, 
                     pc.nro_comprobante, 
                     pc.fec_comprobante,  
                     pc.id_proveedor,
                     pc.referencia     
            
            having sum(nvl(pd.cantidad,0)-nvl(pd.cantidad_confirmada,0)) > 0 
            
            union all 
            
            select  EC.ID,'EMB', 'A', ec.nro_embarque, ec.fec_embarque, 
                   NULL , to_char(ec.id_proforma), sum(ed.cantidad) as cantidad 
            from cmw_embarques ec, cmw_embarques_det ed
            where nvl(ec.anulado,'N') <> 'S' 
             -- and ed.cod_empresa = ec.cod_empresa
             and ed.id_embarque=ec.id
             -- and ed.nro_embarque = ec.nro_embarque
              and nvl(ed.cantidad, 0) > nvl(ed.cantidad_confirmada, 0)
             -- and nvl(:parameter.p_ind_compra_local, 'X') = 'N'
                           
            group by EC.ID,'EMB', 'A', ec.nro_embarque, ec.fec_embarque, to_char(ec.id_proforma)
            ```
    }
    columnMapping {
        return: ID
        display: TIP_COMPROBANTE
        defaultSort: TIP_COMPROBANTE
    }
)

