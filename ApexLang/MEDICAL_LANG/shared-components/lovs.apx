lov lv-solicitudes-envio (
    name: LV_SOLICITUDES_ENVIO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT C.SER_ENVIO,
                   C.NRO_ENVIO,
                   C.ID_EMPRESA,
                   C.ID AS ID_SOLICITUD,
                   S1.DESCRIPCION AS SUCURSAL_SALIDA,
                   C.ID_SUCURSAL,
                   C.ID_SUCURSAL_ENT,
                   S2.DESCRIPCION AS SUCURSAL_ENTRADA,
                   C.SER_ENVIO || '-' || C.NRO_ENVIO AS DISPLAY
              FROM STW_NOTAS_ENVIO_CAB_SOL C,BSW_SUCURSALES S1,BSW_SUCURSALES S2 
             WHERE C.ID_SUCURSAL=S1.ID
               AND C.ID_SUCURSAL_ENT=S2.ID
