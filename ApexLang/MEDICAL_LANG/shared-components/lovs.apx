lov lv-pedidos-imp (
    name: LV_PEDIDOS_IMP
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select  pc.ser_comprobante, pc.nro_comprobante, to_char( pc.fec_comprobante, 'DD/MM/YYYY' ) fec_comprobante,
             sum(nvl(pd.cantidad,0)-nvl(pd.cantidad_confirmada,0)) cantidad,pe.nombre,PC.ID,pr.id as id_proveedor,pc.id_condicion_compra,pc.id_moneda,PC.TIP_COMPROBANTE,PC.TOT_COMPROBANTE
              from cmw_pedidos_cabecera pc, 
                   cmw_pedidos_detalle pd,
                   cmw_proveedores pr,
                   bsw_personas pe 
             where pc.id_empresa = :P0_ID_EMPRESA 
               and pc.id_sucursal = :P330_ID_SUCURSAL 
            
               and pc.id_proveedor = :P330_ID_PROVEEDOR 
            
               and pc.id=pd.id_pedido_cab
               --and nvl(pd.cantidad,0)-nvl(pd.cantidad_confirmada,0) >0 
               and nvl(pc.anulado,'N') = 'N' 
               AND OBTENER_ESTADO_OCP(PC.ID) = 'PENDIENTE'
               AND PC.TIPO='IMP' 
                   and pc.id_proveedor=pr.id
                   and pr.id_persona=pe.id
                   AND   PD.CANTIDAD != NVL(PD.CANTIDAD_ANULADA,0)
                   AND   (PD.ID_ARTICULO,PD.ID,PD.CANTIDAD) NOT IN (SELECT D1.ID_ARTICULO,
                                                           D1.ID_OCP_DET, D1.CANTIDAD
                                                      FROM CMW_PROFORMAS_CABECERA C1,
                                                           CMW_PROFORMAS_DETALLE  D1
                                                     WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                                       AND C1.ID = D1.ID_PROFORMA_CABECERA
                                                       AND D1.ID_OCP = PC.ID)
                   --AND PC.ESTADO='P'
                   group by pc.referencia, pc.ser_comprobante, pc.nro_comprobante, pc.fec_comprobante,PC.ID,pe.nombre,pr.id,pc.id_condicion_compra,pc.ID_MONEDA,PC.TIP_COMPROBANTE,PC.TOT_COMPROBANTE
              having sum(nvl(pd.cantidad,0)-nvl(pd.cantidad_confirmada,0)) > 0
            ```
    }
    columnMapping {
        return: ID
        display: NRO_COMPROBANTE
    }

    column CANTIDAD (
        heading {
            heading: CANTIDAD
        }
        layout {
            sequence: 5
        }
        source {
            dataType: number
        }
    )

    column FEC_COMPROBANTE (
        heading {
            heading: FECHA
        }
        layout {
            sequence: 4
        }
        source {
            dataType: varchar2
        }
    )

    column ID (
        show: false
        layout {
            sequence: 8
        }
        source {
            dataType: number
        }
    )

    column ID_CONDICION_COMPRA (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
    )

    column ID_MONEDA (
        show: false
        layout {
            sequence: 11
        }
        source {
            dataType: number
        }
    )

    column ID_PROVEEDOR (
        show: false
        layout {
