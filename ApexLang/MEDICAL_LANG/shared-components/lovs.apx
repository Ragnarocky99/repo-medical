lov lv-familias-articulos (
    name: LV_FAMILIAS_ARTICULOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT fa.descripcion||' ('||fa.cod_familia||')' AS d,
                   fa.id AS r
            FROM stw_familia fa
            WHERE fa.id_empresa = :P0_ID_EMPRESA
              AND (
                    -- fanea de la sucursal actual
                    fa.id_sucursal = :P0_ID_SUCURSAL
                    or
                    -- fanea sin sucursal, solo si no existen en la sucursal actual
                    (fa.id_sucursal IS NULL AND :P0_ID_SUCURSAL NOT IN (
                        SELECT id_sucursal
                          FROM stw_familia fa1
                         WHERE fa1.id_sucursal IS NOT NULL
                    ))
            
                    or fa.cod_familia = w_busca_parametro('ST', 'COD_FAMILIA_DEF')
                  )
            
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

