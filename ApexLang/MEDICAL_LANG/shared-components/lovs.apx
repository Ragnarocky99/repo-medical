lov lv-comprobante-cabecera (
    name: LV_COMPROBANTE_CABECERA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT V.TIP_COMPROBANTE AS TIPO , V.SER_COMPROBANTE AS SERIE , LPAD(V.NRO_COMPROBANTE,7,'0') AS NUMERO,
                   V.ID
            FROM VTW_COMPROBANTES_CABECERA V
            WHERE NOT EXISTS (SELECT 1
                              FROM RPW_REPARTO_DETALLE D
                              WHERE D.ID_COMPROBANTE_CABECERA = V.ID)
            --AND V.FEC_COMPROBANTE BETWEEN SYSDATE - 3 AND SYSDATE
            AND V.ID_EMPRESA = :P0_ID_EMPRESA
            
            ORDER BY V.SER_COMPROBANTE, V.NRO_COMPROBANTE DESC;
            ```
    }
    columnMapping {
        return: ID
        display: TIPO
    }

