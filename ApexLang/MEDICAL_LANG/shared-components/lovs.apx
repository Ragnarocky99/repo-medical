    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NRO_HABILITACION,
                   ID_SUCURSAL,
                   ID_CAJA,
                   SALDO_INICIAL,
                   COD_USUARIO_AUD,
                   FEC_HABILITACION,
                   HORA_HABILITACION
