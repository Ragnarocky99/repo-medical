lov lv-notas-de-credito-p (
    name: LV_NOTAS_DE_CREDITO_P807
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 
                      VC.ID,
                      VC.FEC_COMPROBANTE,
                      VC.TIP_COMPROBANTE,
                      VC.SER_COMPROBANTE,
                      VC.NRO_COMPROBANTE,
                      VC.NOM_CLIENTE,
                      VC.TIP_COMPROBANTE||' '||VC.SER_COMPROBANTE||'-'||LPAD(VC.NRO_COMPROBANTE, 7, '0') DISPLAY
                 FROM VTW_COMPROBANTES_CABECERA VC
            LEFT JOIN VTW_COMPROBANTES_CABECERA_SOL DEV ON VC.ID = DEV.ID_NCR_REF
                WHERE VC.TIP_COMPROBANTE = 'NCR'
                  AND DEV.ID IS NULL
                  AND VC.ID_COMPROBANTE_REF = :P807_ID_FACTURA_REF
            ORDER BY VC.ID DESC
            ```
    }
    columnMapping {
        return: ID
        display: DISPLAY
    }

    column DISPLAY (
        show: false
        heading {
            heading: Display
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column FEC_COMPROBANTE (
        heading {
            heading: <p>Fecha</p>
        }
        layout {
            sequence: 20
        }
        source {
            dataType: date
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column NOM_CLIENTE (
        heading {
            heading: <p>Cliente</p>
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

    column NRO_COMPROBANTE (
        heading {
            heading: <p>Nro. Comprobante</p>
        }
        layout {
            sequence: 50
        }
        source {
            dataType: number
        }
    )

