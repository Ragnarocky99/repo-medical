lov lv-transporte (
    name: LV_TRANSPORTE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ltrim(p.nombre) nombre, v.cod_proveedor,V.ID 
            from bsw_personas p, cmw_proveedores v,BSW_SECTORES_ECON r
            where v.ID_empresa =:P0_ID_EMPRESA
            and v.id_persona = p.id
            and nvl(v.estado,'A') = 'A' 
            and v.id_SECTOR=r.id(+)
            and R.COD_SECTOR = W_BUSCA_PARAMETRO('CM','RUBRO_TRANSPORTISTA') order by 1
            
            
            ```
    }
    columnMapping {
        return: ID
        display: NOMBRE
    }

    column COD_PROVEEDOR (
        heading {
            heading: Cod Proveedor
        }
        layout {
