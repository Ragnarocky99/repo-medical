lov lv-articulos-nota-resguardo (
    name: LV_ARTICULOS_NOTA_RESGUARDO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select a.descripcion,
                   a.cod_articulo,
                   a.id,
                   a.marca,
                   a.presentacion,
                   a."UNIDAD DE MEDIDA",
                   a."COD FABRICANTE",
                   ar.sinonimo,
                   ar.cod_quimico,
                   case 
                    when sum(a.cantidad_existente) < 0
                      then 0
                    else SUM(a.cantidad_existente)
                    end as cantidad_disponible
            from lv_articulos_pedido3 a
            JOIN stw_articulos ar on ar.id = a.id
            where --(a.id_suc = :P0_ID_SUCURSAL or :APP_PAGE_ID = 763) -- En Cotizar Oferta deben ver de todas las sucursales
               a.id != W_BUSCA_PARAMETRO('VT', 'ID_ART_SERVICIO') AND
               NVL(AR.ESTADO, 'S') = 'S' AND
               a.id_suc = :P793_ID_SUCURSAL
            group by   a.descripcion,
                       a.cod_articulo,
                       a.id,
                       a.marca,
                       a.presentacion,
                       a."UNIDAD DE MEDIDA",
                       a."COD FABRICANTE",
                       ar.sinonimo,
                       ar.cod_quimico
            having SUM(a.cantidad_existente) > 0
            ```
    }
    columnMapping {
        return: ID
        display: DESCRIPCION
        defaultSort: CANTIDAD_DISPONIBLE
        sortDirection: descNullsLast
    }

    column CANTIDAD_DISPONIBLE (
        heading {
            heading: <p>Cant. Disponible</p>
        }
