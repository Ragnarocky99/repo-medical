lov solicitudes-pendientes-reparto-lv (
    name: SOLICITUDES_PENDIENTES_REPARTO_LV
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DECODE(PE.ID,CL.ID_PERSONA,PE.NOMBRE,'-') AS CLIENTE,
                   DECODE(PE.ID,PR.ID_PERSONA,PE.NOMBRE,'-') AS PROVEEDOR,
                   SC.FECHA_ENTREGA_SUG,
                   SC.CANTIDAD_CAJAS,
                   SC.ID NRO_SOLICITUD,
                   SC.DIRECCION_ENVIO,
                   MR.DESCRIPCION AS MOTIVO_REPARTO,
                   SC.FECHA_SOLICITUD,
                   SC.OBSERVACION,
                   DECODE(PE.ID,CL.ID_PERSONA,'CLIE: '||PE.NOMBRE ||' SOLICITUD '||SC.ID,
                                PR.ID_PERSONA,'PROV: '||PE.NOMBRE ||' SOLICITUD '||SC.ID,
                                                        PE.NOMBRE ||' SOLICITUD '||SC.ID) AS DATOS
            FROM RPW_SOLICITUD_REPARTO_CAB SC
            LEFT JOIN CCW_CLIENTES         CL ON CL.ID = SC.ID_CLIENTE
            LEFT JOIN CMW_PROVEEDORES      PR ON PR.ID = SC.ID_PROVEEDOR
            LEFT JOIN BSW_PERSONAS              PE ON PE.ID = NVL(CL.ID_PERSONA, PR.ID_PERSONA)
            LEFT JOIN RPW_MOTIVOS_REPARTO       MR ON MR.ID = SC.ID_MOTIVO_REPARTO
            WHERE NVL(SC.ESTADO,'PE') != 'CA'
            AND EXISTS (SELECT 1
            FROM RPW_SOLICITUD_REPARTO_DET SD     
            WHERE SD.ID_SOLICITUD_REP_CAB = SC.ID    
              AND NVL(SD.IND_CANCELADO,'N') != 'S'
              AND NVL(SD.ESTADO,'XY') != 'EN'
              -- QUE EXISTA UN DETALLE NO ENVIADO O NO CANCELADO.
              AND NOT EXISTS (
                  SELECT 1 
                  FROM RPW_REPARTO_DETALLE RD 
                  JOIN RPW_REPARTO_CABECERA RC ON RC.ID = RD.ID_REPARTO_CABECERA
                  WHERE RD.ID_SOLICITUD_DET = SD.ID
                    AND NVL(RC.ESTADO,'N') = 'N' --QUE NO EXISTA EN UN REPARTO PENDIENTE A RENDIR
              )
            )
            
             AND EXISTS (
                 SELECT 1
                 FROM RPW_SOLICITUD_REPARTO_DET RDD   
                 WHERE RDD.ID_SOLICITUD_REP_CAB = SC.ID
             )
            ```
    }
    columnMapping {
        return: NRO_SOLICITUD
        display: DATOS
        defaultSort: NRO_SOLICITUD
    }

    column CANTIDAD_CAJAS (
        heading {
            heading: Cantidad Cajas
        }
        layout {
            sequence: 50
        }
        source {
            dataType: number
        }
    )

    column CLIENTE (
        heading {
            heading: Cliente
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column DATOS (
        heading {
            heading: Datos
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column DIRECCION_ENVIO (
        heading {
            heading: Direccion Envio
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

    column FECHA_ENTREGA_SUG (
        heading {
            heading: Fecha Entrega Sug
        }
        layout {
            sequence: 40
        }
        source {
            dataType: date
        }
    )

    column FECHA_SOLICITUD (
        heading {
            heading: Fecha Solicitud
        }
        layout {
            sequence: 80
        }
        source {
            dataType: date
        }
    )

    column MOTIVO_REPARTO (
        heading {
            heading: Motivo Reparto
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column NRO_SOLICITUD (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column OBSERVACION (
        heading {
            heading: Observacion
        }
        layout {
            sequence: 90
        }
        source {
            dataType: varchar2
        }
    )

    column PROVEEDOR (
        heading {
            heading: Proveedor
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

)

