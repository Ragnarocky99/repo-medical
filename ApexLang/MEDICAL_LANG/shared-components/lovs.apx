lov lv-grupos-art (
    name: LV_GRUPOS_ART
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT ga.descripcion||'('||ga.cod_grupo_art||')' AS d,
                   ga.id AS r
            FROM stw_grupos_art ga
            WHERE ga.id_empresa = :P0_ID_EMPRESA
              AND (
                    -- ganea de la sucursal actual
                    ga.id_sucursal = :P0_ID_SUCURSAL
                    or
                    -- ganea sin sucursal, solo si no existen en la sucursal actual
                    (ga.id_sucursal IS NULL AND :P0_ID_SUCURSAL NOT IN (
                        SELECT id_sucursal
                          FROM stw_grupos_art ga1
                         WHERE ga1.id_sucursal IS NOT NULL
                    ))
            
                    or ga.cod_grupo_art = w_busca_parametro('ST', 'COD_GRUPO_ART_DEF')
                  )
            
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

