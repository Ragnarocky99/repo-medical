lov lv-articulos-pedido (
    name: LV_ARTICULOS_PEDIDO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            with bloqueos as (
                select b.id_articulo, /*sum(b.cant_bloqueo)*/sum(b.cant_reservada) cant_bloqueo
                  from stwv_articulos_bloqueo b
                 where b.cant_bloqueo > 0
                group by b.id_articulo
            )
            select ar.descripcion,
                   ar.cod_articulo,
                   ar.id,
                   ma.descripcion marca,
                   en.descripcion presentacion,
                   um.abreviatura "UNIDAD DE MEDIDA",
                   ar.cod_origen_art "COD FABRICANTE",
                   ar.sinonimo,
                   ar.cod_quimico,
                   sum(a.cant_dispon) - nvl(bo.cant_bloqueo, 0) cantidad_disponible
            from stw_existencia_art  a
            JOIN stw_articulos       ar on ar.id = a.id_articulo
            join stw_marcas          ma on ma.id = ar.id_marca
            join stw_envases         en on en.id = ar.id_envase
            join stw_unidades_medida um on um.id = ar.id_unidad_medida
            join bsw_sucursales      su on su.id = a.id_sucursal
            left join bloqueos       bo on ar.id = bo.id_articulo
            where --(a.id_suc = :P0_ID_SUCURSAL or :APP_PAGE_ID = 763) -- En Cotizar Oferta deben ver de todas las sucursales
               a.id != W_BUSCA_PARAMETRO('VT', 'ID_ART_SERVICIO') AND
               NVL(AR.ESTADO, 'S') = 'S' and
               a.cant_dispon >= 0 and
               nvl(su.ind_deposito_vencidos, 'N') = 'N'
            group by   ar.descripcion,
                       ar.cod_articulo,
                       ar.id,
                       ma.descripcion,
                       en.descripcion,
                       um.abreviatura,
                       ar.cod_origen_art,
                       ar.sinonimo,
                       ar.cod_quimico,
                       bo.cant_bloqueo
            ```
    }
    columnMapping {
        return: ID
        display: DESCRIPCION
        defaultSort: CANTIDAD_DISPONIBLE
        sortDirection: descNullsLast
    }

    column CANTIDAD_DISPONIBLE (
        heading {
            heading: <p>Saldo Reserva</p>
        }
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
