lov lv-comprobantes (
    name: LV_COMPROBANTES_705
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CP.ID, C.TIPO_COMPROBANTE, 
            C.SER_COMPROBANTE, C.NRO_COMPROBANTE,C.SALDO_CUOTA, C.NRO_CUOTA , C.ID_CLIENTE, M.DESCRIPCION, M.TIPO_CAMBIO, C.ID ID_SALDO
            FROM CCW_SALDOS C, VTW_COMPROBANTES_CABECERA CP, /*VTW_COMPROBANTES_DETALLE CD,*/BSW_MONEDAS M, CCW_CONDICIONES_VENTAS CV
            WHERE C.SALDO_CUOTA > 0
            AND C.ID_COMPROBANTE = CP.ID
            ----AND CP.ID = CD.ID_COMPROBANTE_CABECERA  ---SE COMENTA TABLA DETALLE HACE QUE APAREZCAN DUPLICADOS POR CADA COMP
            AND C.ID_CLIENTE = :P791_ID_CLIENTE
            AND M.ID = C.ID_MONEDA_CUOTA
            AND C.ID_EMPRESA = :P0_ID_EMPRESA
            AND CP.ID_CONDICION_VENTA = CV.ID
            AND NVL(CV.PLAZO, 0) != 0
            --AND CP.ID_PROVEEDOR = NVL(:P290_PROVEEDOR_PARAM,0)
            --AND CP.ID_MONEDA =  NVL(:P290_MONEDA_PARAM,0)
