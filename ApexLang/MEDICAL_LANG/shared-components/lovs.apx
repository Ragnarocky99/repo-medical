lov lv-articulos-envio-codart (
    name: LV_ARTICULOS_ENVIO_CODART
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT A.DESCRIPCION,
                   to_number(A.COD_ARTICULO) as COD_ARTICULO,
                   A.ID,
            
                   NVL(B.ID, 0) AS ID_BARRA,
                   M.DESCRIPCION AS MARCA,
                   E.DESCRIPCION AS PRESENTACION,
                   U.ABREVIATURA AS "UNIDAD DE MEDIDA",
                   A.COD_ORIGEN_ART AS "COD FABRICANTE",
                   
                   A.SINONIMO,
                   
                  SUM(NVL(EX.CANT_DISPON,  0)) as Stock,
                  obtener_cantidad_existente(A.ID,:P0_ID_SUCURSAL,'S') AS "CANTIDAD DISPONIBLE",
                  LO.NRO_LOTE,
                  LO.ID ID_LOTE
            
            
              FROM STW_ARTICULOS A,
                   STW_BARRAS B, 
                   STW_EXISTENCIA_ART EX,
                   STW_MARCAS M,
                   STW_ENVASES E,
                   STW_UNIDADES_MEDIDA U,
                   STW_LOTES LO
                   
             WHERE A.ID_EMPRESA = :P0_COD_EMPRESA
               AND NVL(A.ESTADO, 'N') = 'S'
               AND A.ID = B.ID_ARTICULO(+)
               AND A.ID = EX.ID_ARTICULO
               AND EX.ID_SUCURSAL = :P0_ID_SUCURSAL
               AND EX.ID_LOTE = LO.ID
               AND LO.ID_ARTICULO = A.ID
               AND A.ID_MARCA = M.ID(+)
               AND A.ID_ENVASE = E.ID(+)
               AND A.ID_UNIDAD_MEDIDA = U.ID(+)
            
             GROUP BY A.DESCRIPCION,
                      to_number(A.COD_ARTICULO),
                      A.ID,
                      NVL(B.ID, 0),
                       M.DESCRIPCION,
                       E.DESCRIPCION,
                       U.ABREVIATURA,
                       A.COD_ORIGEN_ART,
                       A.SINONIMO,
                       obtener_cantidad_existente(A.ID,:P0_ID_SUCURSAL,'S'),
                       LO.NRO_LOTE,
                       LO.ID
             HAVING SUM(NVL(EX.CANT_DISPON,  0)) > 0     
             order by to_number(a.cod_articulo) asc
            ```
    }
    columnMapping {
        return: COD_ARTICULO
    }
)

