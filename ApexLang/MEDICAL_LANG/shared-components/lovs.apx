lov lv-recibos (
    name: LV_RECIBOS_75
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select c.ser_recibo,c.nro_recibo,p.nombre,c.fec_recibo,
            upper(M.siglas) as moneda , c.tip_cambio,C.ID,
            nvl( tot_recibo,0) monto 
            from ccW_recibos c, BSW_monedas m,ccw_clientes cl,bsw_personas p
            where c.ID_empresa = :P0_COD_EMPRESA
             and c.ID_mov_caj is null 
             and ( c.estado is null or c.estado <> 'C') 
             and ( c.estado is null or c.estado <> 'A' ) 
             and nvl(c.anulado,'N') <> 'S'
            and c.ID_moneda = m.ID 
            and c.id_cliente=cl.id
            and cl.id_persona=p.id
            order by c.ser_recibo, c.nro_recibo
            ```
    }
    columnMapping {
        return: ID
        display: NRO_RECIBO
    }

