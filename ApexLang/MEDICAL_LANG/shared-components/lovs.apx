lov lv-manzana (
    name: LV_MANZANA_572
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT  
                   '( Manzana '||L.ID_MANZANA||' )' ||' ' ||FR.DESCRIPCION DESCRIPCION,
                   FR.COD_FRACCION FRACCION,
                   L.ID_MANZANA,  
                   L.ID ID_LOTE,
                   --L.ID_CLIENTE,
                   FR.ID ID_FRACCION
                 FROM LTW_FRACCIONES FR, 
                      LTW_LOTES L
                 WHERE L.ID_FRACCION = FR.ID
                 ORDER BY 1,2,3,4
            ```
    }
    columnMapping {
        return: ID_MANZANA
        display: DESCRIPCION
    }
)

