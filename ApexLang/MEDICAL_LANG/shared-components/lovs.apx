lov lv-cuentas-contables-monedas (
    name: LV_CUENTAS_CONTABLES_MONEDAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT PC.NOMBRE_CUENTA||'('||PC.COD_CUENTA||')'|| ' (' || MN.DESCRIPCION ||')' AS CUENTA,
                   PC.COD_CUENTA,
                   PC.NOMBRE_CUENTA,
                   MN.DESCRIPCION AS MONEDA,
                   PC.ID 
            FROM COW_PLAN_CUENTAS PC
            LEFT JOIN BSW_MONEDAS MN ON PC.ID_MONEDA = MN.ID
            WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND PC.ASENTABLE = 'S'    
            ORDER BY regexp_replace(
                        regexp_replace(
                          regexp_replace(
                            COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                            ),
                          '(^|\.)(\d{2})','\1 0\2'
                        ),
                        '(^|\.)(\d)','\1 00\2'
                      );
            ```
    }
    columnMapping {
        return: ID
        display: CUENTA
    }

