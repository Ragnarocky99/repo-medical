                   CA.FEC_VENCIMIENTO,
                   CA.MONTO_CUOTA TOT_CUOTA,
                   CA.SALDO_CUOTA TOT_SALDO,
                   CA.ID_CUOTA ID
            FROM LTW_SALDOS CA
            WHERE NVL(CA.SALDO_CUOTA, 0) > 0
              AND CA.ID_CONTRATO = :ID_CONTRATO_LOTE
            
              
            ORDER BY CA.ID_CONTRATO,
                     CA.NRO_CUOTA ASC
            ;
            ```
    }
    columnMapping {
        return: ID
        display: NRO_CUOTA
    }

    column FEC_VENCIMIENTO (
        heading {
            heading: Vencimiento
        }
        layout {
            sequence: 40
        }
        source {
            dataType: date
        }
        appearance {
            formatMask: DD/MM/YYYY
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column ID_CONTRATO (
        show: false
        heading {
            heading: Id Contrato
        }
        layout {
            sequence: 20
        }
        source {
            dataType: number
        }
        advanced {
