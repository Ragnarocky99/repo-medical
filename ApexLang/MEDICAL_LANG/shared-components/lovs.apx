    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT A.NRO_HABILITACION, A.FEC_HABILITACION, U.COD_USUARIO, C.DESCRIPCION
            FROM CCW_HABILITACIONES A
