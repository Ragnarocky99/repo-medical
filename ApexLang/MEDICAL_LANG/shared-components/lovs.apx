lov lv-personas-in-usuarios (
    name: LV_PERSONAS_IN_USUARIOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT P.NOMBRE||' ('||P.COD_PERSONA||') ' || '(' || NVL(P.RUC,P.NRO_CI) || ')' AS PERSONA,
                   P.ID
            FROM BSW_PERSONAS P
            WHERE EXISTS (SELECT 1
                          FROM BSW_USUARIOS U
                          WHERE U.ID_PERSONA = P.ID)
            
            ```
    }
    columnMapping {
        return: ID
        display: PERSONA
    }
)

lov lv-personas-juridicas (
    name: LV_PERSONAS_JURIDICAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select pj.id,
                   ltrim(pj.nombre) nom_per_juridica, 
                   pj.cod_persona,
                   cb.nro_cuenta, 
                   cb.referencia, 
                   '('||mo.cod_moneda||')'||mo.descripcion desc_moneda, 
                   mo.tipo_cambio_dia cambio,
                   mo.id as id_moneda
            from ccw_cuentas_bancarias cb, 
                 bsw_personas pj, 
                 bsw_monedas mo 
                 
            where cb.id_empresa = :P0_ID_EMPRESA
              and cb.id_per_juridica = pj.id
              and nvl(cb.activo, 'N') <> 'N' 
              and cb.id_moneda = mo.id
              and pj.es_fisica = 'N'
              
            order by cb.id_moneda, ltrim(pj.nombre), cb.nro_cuenta
            ```
    }
    columnMapping {
