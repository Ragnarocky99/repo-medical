lov lv-cuentas-nro (
    name: LV_CUENTAS_NRO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ltrim(pj.nombre) nom_per_juridica, 
                   pj.cod_persona, 
                   cb.nro_cuenta, 
                   cb.referencia, 
                   '('||mo.cod_moneda||')'||mo.descripcion desc_moneda, 
                   mo.tipo_cambio_dia cambio,
                   cb.id_per_juridica,
                   cb.id_cuenta
                   
            from ccw_cuentas_bancarias cb, 
                 bsw_personas pj, 
                 bsw_monedas mo 
                 
            where cb.id_empresa = :P0_ID_EMPRESA
              and cb.id_per_juridica = pj.id
              and nvl(cb.activo, 'N') <> 'N' 
              and cb.id_moneda = mo.id
              and pj.es_fisica = 'N'
              
            order by cb.id_moneda, ltrim(pj.nombre), cb.nro_cuenta
            ```
    }
    columnMapping {
        return: NRO_CUENTA
        display: NRO_CUENTA
    }

