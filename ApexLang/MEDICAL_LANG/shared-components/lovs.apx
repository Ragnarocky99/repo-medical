lov lv-cajeros (
    name: LV_CAJEROS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CA.COD_CAJA, 
                   CA.DESCRIPCION, 
                   PE.NOMBRE AS CAJERO,
                   US.COD_USUARIO AS USUARIO,
                   CA.ID
            FROM CCW_CAJAS CA, 
                 BSW_USUARIOS US, 
                 BSW_PERSONAS PE
            WHERE CA.ID_EMPRESA = :P0_ID_EMPRESA
              AND CA.ID_USUARIO_ASIG = US.ID
              AND US.ID_PERSONA = PE.ID
              AND US.COD_USUARIO = :APP_USER--TRAE_ID_USUARIO(:P0_ID_EMPRESA,:APP_USER)
            ORDER BY TO_NUMBER(CA.COD_CAJA)
            ```
    }
    columnMapping {
        return: ID
        display: COD_CAJA
        defaultSort: COD_CAJA
    }

