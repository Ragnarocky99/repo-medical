lov lv-cliente-contrato-lt (
    name: LV_CLIENTE_CONTRATO_LT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CL.COD_CLIENTE,
                   PE.NOMBRE,
                   PE.RUC,
                   PE.NRO_CI,
                   PE.DIRECCION,
                   CL.ID
                   
            FROM LTW_CLIENTES_CONTRATOS CC,
                 CCW_CLIENTES CL,
                 BSW_PERSONAS PE,
                 LTW_CONTRATOS C
                 
                 
            WHERE CC.ID_EMPRESA = 121
              AND C.ID = CC.ID_CONTRATO
              AND CC.ID_CLIENTE = CL.ID
