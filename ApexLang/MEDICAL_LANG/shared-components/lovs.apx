lov lv-orden-pago (
    name: LV_ORDEN_PAGO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT  o.ser_orden_pago, o.num_orden_pago, e.nombre AS PROVEEDOR,
                    o.fec_emision, m.descripcion, o.suma_total AS TOT_ORDEN_PAGO,
                    O.ID 
              FROM cpw_cabecera_orden_pago o,
                   bsw_monedas             m ,
                   cmw_proveedores         p,
                   bsw_personas            e 
             where o.id_proveedor  = p.id 
               and o.id_moneda     = m.id 
               and e.id            = p.id_persona
               and o.id_proveedor  =:P238_ID_PROVEEDOR
               and nvl(o.estado,'X') != 'A'
               AND NVL(o.autorizado,'N') = 'S'
               and o.id not in  (select nvl(id_orden_pago,0) from cpw_cabecera_cajas);
            ```
    }
    columnMapping {
        return: ID
        display: NUM_ORDEN_PAGO
        defaultSort: NUM_ORDEN_PAGO
    }

