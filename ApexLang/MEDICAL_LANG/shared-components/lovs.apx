lov lv-comprobantes-ref-cp (
    name: LV_COMPROBANTES_REF_CP
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT C.TIP_COMPROBANTE,
            C.ID,
            C.SER_COMPROBANTE,  
            --C.NRO_COMPROBANTE,
            C.REFERENCIA,
            E.NOMBRE,
            D.DESCRIPCION AS DESC_CONDICION,
            C.TOT_COMPROBANTE,
            M.DESCRIPCION AS DESC_MONEDA,
            C.TIP_CAMBIO 
            FROM 
            CPW_COMPROBANTES_CABECERA C,
            ---CMW_COMPRAS_CABECERA C,
            CMW_PROVEEDORES P,
            CMW_CONDICIONES_COMPRAS D,
            BSW_MONEDAS M,
            BSW_PERSONAS E
            
            WHERE c.id_empresa =  p.id_empresa
            and C.ID_PROVEEDOR=P.ID 
            and c.id_condicion_compra = d.id(+)
            AND C.ID_MONEDA=M.ID 
            AND E.ID=P.ID_PERSONA
            --AND (ID_PROVEEDOR=:P268_ID_PROVEEDOR)
            AND (C.TIP_COMPROBANTE IN ('CO', 'FCR','CRE'))
            
            
            
            
            
            
            ```
    }
    columnMapping {
        return: REFERENCIA
        display: REFERENCIA
