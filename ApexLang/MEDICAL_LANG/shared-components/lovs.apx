lov lv-clientes-saldos (
    name: LV_CLIENTES_SALDOS_75
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select c.nro_comprobante,
                   c.id,
                   c.ser_comprobante, 
                   c.fec_comprobante, 
                   tot_comprobante, 
                   c.id_moneda siglas, 
                   c.tip_cambio, 
                   c.id_condicion_venta, 
                   cv.descripcion, 
                   cv.nro_cuotas, 
                   c.tip_comprobante,
                   c.nom_cliente 
              from vtw_comprobantes_cabecera c, 
                   bsw_monedas m, 
                   ccw_condiciones_ventas cv,
                   ccw_saldos s 
             where c.id_empresa         = :P0_COD_EMPRESA and 
                   (tip_comprobante       = :TIP_COMPROBANTE or
                   :TIP_COMPROBANTE IS NULL) and
                   c.ser_comprobante     <> ' ' and 
                   c.nro_comprobante     > 0 and 
                   c.nro_mov_caj         is null and 
                   nvl( c.estado,' ' )   <> 'A' and 
                   c.id_moneda          = m.id and 
                   c.id_empresa         = cv.id_empresa and 
                   c.id_condicion_venta = cv.id and 
                   /*nvl( cv.nro_cuotas, 0 ) = 0 and */
                   (c.id_cliente        = :P75_ID_CLIENTE or 
                   :P75_ID_CLIENTE is null) and
                   c.id_empresa     = s.id_empresa and
                   c.tip_comprobante = s.tipo_comprobante and
                   c.ser_comprobante = s.ser_comprobante and
                   c.nro_comprobante = s.nro_comprobante and
                   s.saldo_cuota     <> 0 
                   and c.id_condicion_venta=W_BUSCA_PARAMETRO('CC','CONDICION_CONTADO')
            order by fec_comprobante, nro_comprobante
            ```
    }
    columnMapping {
        return: ID
        display: NRO_COMPROBANTE
    }

    column DESCRIPCION (
        heading {
            heading: Descripcion
        }
        layout {
            sequence: 7
        }
        source {
            dataType: varchar2
        }
    )

    column FEC_COMPROBANTE (
