lov lv-tip-comprobantes-cp (
    name: LV_TIP_COMPROBANTES_CP
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT C.TIP_COMPROBANTE, 
                   C.DESCRIPCION,
                   DECODE(C.LIBRO_IVA,'S', 'Sí', 'No') IMPRIME_IVA,
                   NVL(C.LIBRO_IVA, 'N') LIBRO_IVA
            FROM BSW_TIPOS_COMPROBANTES C
            WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
              AND C.ID_MODULO = TRAE_MODULO_ID('CP')
              AND C.ESTADO = 'S'
              AND (C.TIP_COMPROBANTE IN ('PTM', 'SAP', 'DIV') AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'S' OR C.TIP_COMPROBANTE  NOT IN ('PTM', 'SAP', 'DIV'))
            ORDER BY C.TIP_COMPROBANTE  
            
            ```
    }
    columnMapping {
        return: TIP_COMPROBANTE
        display: TIP_COMPROBANTE
    }

    column DESCRIPCION (
        heading {
            heading: Descripción
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column IMPRIME_IVA (
        heading {
            heading: Imprime IVA
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column LIBRO_IVA (
        show: false
        heading {
            heading: Libro Iva
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column TIP_COMPROBANTE (
        heading {
            heading: Tip. Comp.
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

