lov lv-articulos-pedido-sin-estandar (
    name: LV_ARTICULOS_PEDIDO_SIN_ESTANDAR
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT * FROM (
                SELECT
                    DISTINCT A.DESCRIPCION,
                    A.COD_ARTICULO,
                    A.ID,
                    B.COD_BARRA,
                    NVL(B.ID, 0) AS ID_BARRA,
                    M.DESCRIPCION AS MARCA,
                    E.DESCRIPCION AS PRESENTACION,
                    U.ABREVIATURA AS "UNIDAD DE MEDIDA",
                    A.COD_ORIGEN_ART AS "COD FABRICANTE",
                    SUM(NVL(EX.CANT_DISPON, 0)) AS "CANTIDAD DISPONIBLE",
                    A.SINONIMO
                FROM STW_ARTICULOS A
                LEFT JOIN STW_BARRAS B ON B.ID_ARTICULO(+) = A.ID
                LEFT JOIN STW_EXISTENCIA_ART EX ON A.ID = EX.ID_ARTICULO
                LEFT JOIN STW_MARCAS M ON M.ID = A.ID_MARCA
                LEFT JOIN STW_ENVASES E ON E.ID = A.ID_ENVASE
                LEFT JOIN STW_UNIDADES_MEDIDA U ON U.ID = A.ID_UNIDAD_MEDIDA
                WHERE A.ID_EMPRESA = 121
                AND NVL(A.ESTADO, 'N') = 'S'
                AND A.COD_ARTICULO <> 1 -- Exclude rows where COD_ARTICULO is 1
                
              GROUP BY  A.DESCRIPCION,
                        A.COD_ARTICULO,
                        A.ID,
                        B.COD_BARRA,
                        NVL(B.ID, 0),
                        M.DESCRIPCION,
                        E.DESCRIPCION,
                        U.ABREVIATURA,
                        A.COD_ORIGEN_ART,
                        A.SINONIMO
            
                ORDER BY A.COD_ARTICULO
            );
            ```
    }
    columnMapping {
        return: ID
        display: DESCRIPCION
        defaultSort: COD_ARTICULO
    }

    column "CANTIDAD DISPONIBLE" (
        heading {
            heading: Cantidad Disponible
        }
        layout {
            sequence: 80
        }
        source {
            dataType: number
        }
    )

