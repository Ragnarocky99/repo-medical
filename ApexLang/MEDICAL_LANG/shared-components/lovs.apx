lov lista-comprobantes (
    name: LISTA_COMPROBANTES_161
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
                select c.tip_comprobante, c.ser_comprobante, c.nro_comprobante, c.fec_comprobante, p.nombre,c.id 
                
                  from vTW_comprobantes_cabecera c, vtW_comprobantes_detalle d, BSW_personas p, ccW_clientes cc, BSW_tipos_comprobantes tc 
                  
                 where c.ID_empresa = :P0_COD_EMPRESA
                 
                   and ( c.ID_cliente     = :P161_ID_CLIENTE) 
                   and ( c.ser_comprobante =:P161_SER_COMPROBANTE_REF or :P161_SER_COMPROBANTE_REF is null ) 
                   AND C.ID=D.ID_COMPROBANTE_CABECERA
                   and c.id_empresa       = tc.id_empresa and c.tip_comprobante = tc.tip_comprobante  
                   and ( c.estado is null or c.estado <> 'A') 
                   and c.id_empresa       = cc.id_empresa 
                   and c.id_cliente       = cc.id
                   and cc.id_persona      = p.ID
                   and nvl(c.tip_comprobante, 'XXX') <> 'NCR'
                   and c.id_sucursal = :P0_ID_SUCURSAL
                   --AND C.ID NOT IN (SELECT ID_COMPROBANTE_REF FROM VTW_COMPROBANTES_CABECERA WHERE TIP_COMPROBANTE=W_BUSCA_PARAMETRO('VT','TIPO_NOTACRE'))
                   --and 0 < (select saldo_cuota from ccw_saldos where id_comprobante = c.id)
                   
              group by c.tip_comprobante, c.ser_comprobante, c.nro_comprobante, 
                       c.fec_comprobante, p.nombre, c.ID_cliente,c.id 
            ```
    }
    columnMapping {
        return: ID
        display: NRO_COMPROBANTE
    }

    column FEC_COMPROBANTE (
        heading {
            heading: Fec Comprobante
        }
        layout {
            sequence: 50
        }
        source {
            dataType: date
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column NRO_COMPROBANTE (
        heading {
            heading: Nro Comprobante
        }
        layout {
            sequence: 20
        }
        source {
            dataType: number
        }
    )

    column SER_COMPROBANTE (
        heading {
            heading: Ser Comprobante
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column TIP_COMPROBANTE (
        heading {
            heading: Tip Comprobante
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

)

