lov lv-contratos-factura-lt (
    name: LV_CONTRATOS_FACTURA_LT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CT.FEC_COMPROBANTE,
                   CT.TIP_COMPROBANTE,
                   CT.SER_COMPROBANTE,
                   CT.NRO_COMPROBANTE,
                   CT.CANT_CUOTAS,
                   CT.TOT_COMPROBANTE,
                   SUM(CU.TOT_SALDO) TOT_SALDO,
                   CT.TIP_COMPROBANTE || '-' || CT.SER_COMPROBANTE || '-' || CT.NRO_COMPROBANTE AS COMPROBANTE,
                   CT.ID
                   
            FROM LTW_CONTRATOS CT,
                 LTW_CLIENTES_CONTRATOS CC,
                 LTW_CUOTAS CU
                 
            WHERE CC.ID_CONTRATO    = CT.ID
              AND CU.ID_CONTRATO    = CT.ID
              AND CU.TOT_SALDO      > 0   -- CORREGIR
              AND CT.ID_EMPRESA     = :P0_ID_EMPRESA
              AND CC.ID_CLIENTE     = :P589_ID_CLIENTE
              
            GROUP BY CT.FEC_COMPROBANTE,
                     CT.TIP_COMPROBANTE,
                     CT.SER_COMPROBANTE,
                     CT.NRO_COMPROBANTE,
                     CT.CANT_CUOTAS,
                     CT.TOT_COMPROBANTE,
                     CT.TIP_COMPROBANTE || '-' || CT.SER_COMPROBANTE || '-' || CT.NRO_COMPROBANTE,
                     CT.ID
                     
            ORDER BY CT.FEC_COMPROBANTE ASC, CT.NRO_COMPROBANTE ASC
            ;
            ```
    }
    columnMapping {
        return: ID
        display: COMPROBANTE
    }

    column CANT_CUOTAS (
        heading {
            heading: Cant. de Cuotas
        }
        layout {
            sequence: 70
