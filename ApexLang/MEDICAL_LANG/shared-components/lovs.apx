lov lv-lotes-disponibles (
    name: LV_LOTES_DISPONIBLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT L.NRO_LOTE,L.ID 
              FROM STW_LOTES L,
                   STW_EXISTENCIA_ART E
            WHERE E.ID_EMPRESA  = L.ID_EMPRESA
              AND E.ID_ARTICULO = L.ID_ARTICULO
              AND E.ID_LOTE     = L.ID
              AND L.ID_ARTICULO = :ID_ARTICULO
              AND E.ID_SUCURSAL = :P0_ID_SUCURSAL
              AND E.CANT_DISPON > 0
            ```
    }
    columnMapping {
        return: ID
        display: NRO_LOTE
        defaultSort: NRO_LOTE
    }
)

