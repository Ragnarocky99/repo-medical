lov lv-rubros-articulos (
    name: LV_RUBROS_ARTICULOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT RU.DESCRIPCION||'('||RU.COD_RUBRO||')' D,
                   RU.ID R,
                   NVL(RU.ESTADO,'X') ESTADO
            FROM STW_RUBRO RU
            WHERE RU.ID_EMPRESA = :P0_ID_EMPRESA
              AND NVL(RU.ESTADO,'X') = 'A'
              AND (
                    -- Rubros de la sucursal actual
                    RU.ID_SUCURSAL = :P0_ID_SUCURSAL
                    OR
                    -- Rubros sin sucursal, solo si no existen en la sucursal actual
                    (RU.ID_SUCURSAL IS NULL AND :P0_ID_SUCURSAL NOT IN (
                        SELECT ID_SUCURSAL
                          FROM STW_RUBRO RU1
                         WHERE RU1.ID_SUCURSAL IS NOT NULL
                    ))
                  )
            
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

