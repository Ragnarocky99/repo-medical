lov lv-empleados-vacaciones (
    name: LV_EMPLEADOS_VACACIONES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT EM.COD_EMPLEADO,
                   PE.NOMBRE,
                   DECODE(EM.FEC_INGRESO,NULL,'-',EM.FEC_INGRESO) AS FEC_INGRESO,
                   CASE
                     WHEN (EXTRACT(YEAR FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(YEAR FROM EM.FEC_INGRESO)) IS NULL THEN
                       '0 años'
                     WHEN (EXTRACT(YEAR FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(YEAR FROM EM.FEC_INGRESO)) = '1' THEN
                       (EXTRACT(YEAR FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(YEAR FROM EM.FEC_INGRESO)) || ' año'
                     WHEN (EXTRACT(YEAR FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(YEAR FROM EM.FEC_INGRESO)) > '1' THEN
                       (EXTRACT(YEAR FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(YEAR FROM EM.FEC_INGRESO)) || ' años'
                     ELSE
                       ABS(EXTRACT(YEAR FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(YEAR FROM EM.FEC_INGRESO))||' años'
                   END ANIO,
            --        DECODE(EM.FEC_INGRESO,NULL,'0',
            --                 (TO_DATE(SYSDATE,'MM') - TO_DATE(EM.FEC_INGRESO,'MM')||' meses')) MESES,
                   CASE
                     WHEN (EXTRACT(MONTH FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(MONTH FROM EM.FEC_INGRESO)) IS NULL THEN
                       '0 meses'
                     WHEN (EXTRACT(MONTH FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(MONTH FROM EM.FEC_INGRESO)) = '1' THEN
                       (EXTRACT(MONTH FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(MONTH FROM EM.FEC_INGRESO)) || ' mes'
                     WHEN (EXTRACT(MONTH FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(MONTH FROM EM.FEC_INGRESO)) > 1 THEN
                       (EXTRACT(MONTH FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(MONTH FROM EM.FEC_INGRESO)) || ' meses'
                     ELSE
                       ABS(EXTRACT(MONTH FROM NVL(EM.FEC_SALIDA,SYSDATE)) - EXTRACT(MONTH FROM EM.FEC_INGRESO))||' meses'
                   END MESES,
                   EM.ID
                   
            FROM RHW_EMPLEADOS EM, 
                 BSW_PERSONAS PE
                 
            WHERE EM.ID_EMPRESA  = :P0_ID_EMPRESA
              AND EM.ID_PERSONA  = PE.ID
              AND EM.FEC_SALIDA IS NULL
            
            ORDER BY TO_NUMBER(EM.COD_EMPLEADO) ASC
            
            ```
    }
    columnMapping {
        return: ID
        display: COD_EMPLEADO
    }

    column ANIO (
        heading {
            heading: Anio
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column COD_EMPLEADO (
        heading {
            heading: Cod Empleado
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column FEC_INGRESO (
        heading {
            heading: Fec Ingreso
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column ID (
        show: false
        layout {
            sequence: 60
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column MESES (
        heading {
            heading: Meses
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column NOMBRE (
        heading {
            heading: Nombre
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

