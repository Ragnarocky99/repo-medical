lov lv-cuentas-p (
    name: LV_CUENTAS_P315
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CB.ID,
                   CB.REFERENCIA, 
                   CB.NRO_CUENTA, 
                   P.NOMB_FANTASIA, 
                   P.COD_PERSONA, 
                   M.DESCRIPCION AS Moneda, 
                   TP.DESCRIPCION AS TIPO_CUENTA
                   
            FROM CCW_CUENTAS_BANCARIAS CB, 
                 BSW_PERSONAS P, 
                 BSW_MONEDAS M, 
                 CCW_TIPOS_CUENTAS TP
            
            WHERE CB.ID_PER_JURIDICA = P.ID 
              AND TP.ID = CB.ID_TIP_CUENTA 
              AND CB.ID_MONEDA = M.ID
              and CB.ACTIVO = 'S'
            
            ORDER BY CB.NRO_CUENTA
            ```
