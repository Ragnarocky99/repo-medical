lov lv-subtipos-trans-cobros (
    name: LV_SUBTIPOS_TRANS_COBROS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select s.id, s.subtipo_trans || ' - ' || s.descripcion
            from bsw_subtipos_trans s
            where s.id_modulo = trae_id_modulo('CC')
              and s.id_tipo_trans = trae_id_tipos_trans(:P0_ID_EMPRESA,trae_id_modulo('CC'),w_busca_parametro('CC', 'TIPO_TRANS_CC'))
            order by to_number(s.subtipo_trans) asc
              
              
            ```
    }
    columnMapping {
        return: ID
        display: S.SUBTIPO_TRANS||'-'||S.DESCRIPCION
    }

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column S.SUBTIPO_TRANS||'-'||S.DESCRIPCION (
        heading {
            heading: S.Subtipo Trans||'-'||S.Descripcion
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

