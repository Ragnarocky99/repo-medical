lov lv-soportes (
    name: LV_SOPORTES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT NVL(PS.NOMB_FANTASIA, PS.NOMBRE) SOPORTE,
                   PS.ID
              FROM CCW_CLIENTES   CL
              JOIN FVW_VENDEDORES VE ON VE.ID = CL.ID_VENDEDOR
              JOIN BSW_PERSONAS   PS ON PS.ID = CL.ID_SOPORTE
             WHERE (VE.ID = :P469_COD_VENDEDOR OR :P469_COD_VENDEDOR IS NULL)
            ```
    }
    columnMapping {
        return: ID
        display: SOPORTE
        defaultSort: SOPORTE
    }
)

