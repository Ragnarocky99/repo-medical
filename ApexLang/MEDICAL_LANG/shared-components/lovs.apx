lov lv-proveedores-2 (
    name: LV_PROVEEDORES_372
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT v.cod_proveedor, p.ruc||' '||LTRIM(p.nombre) AS nombre, v.ID
            FROM bsw_personas p
            JOIN cmw_proveedores v ON v.id_persona = p.ID 
            JOIN CPW_COMPROBANTES_CABECERA c ON c.ID_PROVEEDOR_REF = v.id
            WHERE NVL(estado, 'A') = 'A'
            GROUP BY v.cod_proveedor, p.ruc||' '||LTRIM(p.nombre), v.ID;
            
            ```
    }
