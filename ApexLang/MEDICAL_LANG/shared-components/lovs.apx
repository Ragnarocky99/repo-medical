lov lv-ubicacion-articulo-ent-p (
    name: LV_UBICACION_ARTICULO_ENT_P84
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT ES.DESCRIPCION ESTANTE,
                   FI.DESCRIPCION FILA,
                   ES.PISO,
                   UA.CANTIDAD,
                   ES.DESCRIPCION||' '||FI.DESCRIPCION||' - '||ES.PISO DISPLAY,
                   UA.ID
              FROM STW_UBIC_ARTICULOS UA
              JOIN STW_ESTANTES       ES ON ES.ID = UA.ID_ESTANTE
              JOIN STW_FILAS          FI ON FI.ID = UA.ID_FILA
             WHERE UA.ID_ARTICULO = :ID_ARTICULO
               AND UA.ID_LOTE     = :ID_LOTE
               AND UA.ID_SUCURSAL = :P84_ID_SUCURSAL_ENT
            ```
    }
    columnMapping {
        return: ID
        display: DISPLAY
    }

    column CANTIDAD (
        heading {
            heading: <p>Cantidad</p>
        }
        layout {
            sequence: 60
        }
        source {
            dataType: number
        }
    )

    column DISPLAY (
        show: false
        heading {
            heading: Display
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

