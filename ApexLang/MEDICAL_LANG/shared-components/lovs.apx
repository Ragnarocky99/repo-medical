lov lv-fracciones-2 (
    name: LV_FRACCIONES_572
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT  
                   FR.DESCRIPCION,
                   FR.COD_FRACCION,
                   L.ID_MANZANA, 
                   L.ID_LOTE,
                   L.ID_CLIENTE,
                   FR.ID
                 FROM LTW_LOTES_A_RECUPERAR L,
                 LTW_FRACCIONES FR
                 WHERE L.ID_EMPRESA = FR.ID_EMPRESA
                 AND L.ID_SUCURSAL = FR.ID_SUCURSAL
                 AND L.ID_FRACCION = FR.ID
                 AND L.ESTADO = 'A'
                 ORDER BY 1,2,3,4
            ```
