lov lv-articulos (
    name: LV_ARTICULOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT A.DESCRIPCION, TO_NUMBER(A.COD_ARTICULO) COD_ARTICULO, A.ID, B.COD_BARRA, NVL(B.ID,0) AS ID_BARRA,
                            E.DESCRIPCION PRESENTACION, U.ABREVIATURA UNIDAD_MEDIDA, A.COD_QUIMICO,
                            A.COD_ORIGEN_ART COD_FABRICANTE FROM 
            STW_ARTICULOS A, STW_BARRAS B, STW_ENVASES E, STW_UNIDADES_MEDIDA U
