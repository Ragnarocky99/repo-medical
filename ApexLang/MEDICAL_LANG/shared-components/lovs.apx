lov lv-embarques-despachos (
    name: LV_EMBARQUES_DESPACHOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select pc.nro_comprobante referencia,
                   em.nro_embarque, 
                   em.fec_embarque, 
                   pu.cod_puerto, 
                   pu.descripcion desc_puerto, 
                   pe.nro_comprobante,
                   ps.nombre || ' (' || p.cod_proveedor|| ')' proveedor,
                   EM.ID
              from cmw_embarques em, 
                   cmw_puertos pu, 
                   cmw_proformas_cabecera pe,
                   cmw_proveedores p,
                   cmw_pedidos_cabecera pc,
                   bsw_personas ps
             where em.ID_empresa = :P0_ID_EMPRESA
               --and (select d.nro_referencia from cmw_despachos_detalle d where d.nro_referencia = em.nro_embarque)is null
               --and (select d.id_embarque from cmw_despachos_detalle d where d.id_embarque = em.id)is null
               and em.id_puerto       = pu.id 
               and em.id_empresa      = pe.id_empresa 
               and pe.id_proveedor    = p.id
               and pe.tip_comprobante  = 'PRO' 
               and nvl(pe.anulado,'N') = 'N' 
               and em.id_empresa      = pe.id_empresa
               and em.id_proforma=pe.id
               and pe.referencia=pc.id
               and p.id_persona=ps.id
             order by 2 desc, 1 desc
            ```
    }
    columnMapping {
        return: ID
        display: NRO_EMBARQUE
    }

    column COD_PUERTO (
        heading {
            heading: Cod Puerto
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column DESC_PUERTO (
        heading {
            heading: Desc Puerto
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

