lov lv-vendedores-pag (
    name: LV_VENDEDORES_PAG675
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT Z.ID, Z.COD_VENDEDOR, P.NOMBRE
            FROM FVW_VENDEDORES Z, 
                 BSW_PERSONAS P
            WHERE P.ID= Z.ID_PERSONA
              AND EXISTS (SELECT 1
                          FROM BSW_ZONAS_GEOGRAFICAS C
                          WHERE Z.ID_ZONA = C.ID
                            AND C.ID      = :P675_ID_ZONA OR :P675_ID_ZONA IS NULL)
            and Z.ID_EMPRESA = :P0_ID_EMPRESA
            ```
    }
    columnMapping {
        return: ID
        display: NOMBRE
    }
)

