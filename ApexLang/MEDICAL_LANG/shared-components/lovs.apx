lov rhw-liquid (
    name: RHW_LIQUID
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct l.fec_liquid,l.nro_liquid, l.ser_liquid, l.tip_liquid, l.mes mes, l.anio anio 
              from rhw_cabecera_liq l 
             where l.id_empresa = :P0_ID_EMPRESA
               and l.ser_liquid  = 'X'
              order by l.fec_liquid desc
            ```
    }
