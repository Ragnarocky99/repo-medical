lov lv-compras (
    name: LV_COMPRAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CM.ID,
                   --CD.ID AS ID_DET_REF,
                   C.TIP_COMPROBANTE, 
                   C.SER_COMPROBANTE, 
                   C.NRO_COMPROBANTE, 
                   CM.REFERENCIA, 
                   CD.ID_IVA,
                   I.DESCRIPCION AS IVA, 
                   SUM(CD.MONTO_TOTAL) MONTO_TOTAL
                   
            FROM CPW_CUOTAS C, 
                 CMW_COMPRAS_CABECERA CM, 
                 CMW_COMPRAS_DETALLE CD,
                 STW_IVA I,
                 BSW_TIPOS_COMPROBANTES TCB
                 
            WHERE C.TOT_SALDO > 0
              AND CM.TIP_COMPROBANTE = TCB.TIP_COMPROBANTE
              AND C.ID_COMPROBANTE_CM = CM.ID
              AND CM.TIP_COMPROBANTE != 'NCT'
              AND NVL(TCB.LIBRO_IVA,'N') = 'S'
              AND CM.ID = CD.ID_COMPRAS_CAB
              AND CD.ID_IVA = I.ID
              AND CM.ID_PROVEEDOR = NVL(:P290_PROVEEDOR_PARAM,0)
              AND CM.ID_MONEDA = NVL(:P290_MONEDA_PARAM,0)
              AND :PLV_MODULO = 'CM'
              
            GROUP BY 
                  CM.ID, 
                  C.TIP_COMPROBANTE, 
                  C.SER_COMPROBANTE, 
                  C.NRO_COMPROBANTE, 
                  CM.REFERENCIA, 
                  CD.ID_IVA,
                  I.DESCRIPCION/*,
                  CD.ID*/
            
            UNION ALL
            
            SELECT CP.ID,
                   --DP.ID AS ID_DET_REF,
                   C.TIP_COMPROBANTE, 
                   C.SER_COMPROBANTE, 
                   C.NRO_COMPROBANTE, 
                   CP.REFERENCIA, 
                   DP.ID_IVA, 
                   V.DESCRIPCION AS IVA, 
                   SUM(DP.MONTO_TOTAL) MONTO_TOTAL
                   
            FROM CPW_CUOTAS C, 
                 CPW_COMPROBANTES_CABECERA CP, 
                 CPW_COMPROBANTES_DETALLE DP,
                 STW_IVA V,
                 BSW_TIPOS_COMPROBANTES TC
                 
            WHERE C.TOT_SALDO > 0
              AND CP.TIP_COMPROBANTE = TC.TIP_COMPROBANTE
              AND CP.ID = C.ID_COMPROBANTE
              AND CP.TIP_COMPROBANTE != 'NCT'
              AND NVL(TC.LIBRO_IVA,'N') = 'S'
              AND CP.ID = DP.ID_COMPROBANTE
              AND DP.ID_IVA = V.ID(+)
              AND CP.ID_PROVEEDOR = NVL(:P290_PROVEEDOR_PARAM,0)
              AND CP.ID_MONEDA = NVL(:P290_MONEDA_PARAM,0)
              AND :PLV_MODULO = 'CP'
              
            GROUP BY
                  CP.ID, 
                  C.TIP_COMPROBANTE, 
                  C.SER_COMPROBANTE, 
                  C.NRO_COMPROBANTE, 
                  CP.REFERENCIA, 
                  DP.ID_IVA, 
                  V.DESCRIPCION/*,
                  DP.ID*/
            ```
    }
    columnMapping {
        return: ID
        display: TIP_COMPROBANTE
    }

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column ID_IVA (
        show: false
        layout {
            sequence: 70
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

