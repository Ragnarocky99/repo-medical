        }
    )

)

lov rhw-motivos-conceptos (
    name: RHW_MOTIVOS_CONCEPTOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select m.id,m.descripcion ||' - ('|| m.cod_motivo||')' motivo,
            m.deducir AS DESCONTAR,
            c.descripcion AS DESC_CONCEPTO,
            c.cod_concepto 
             from RHW_motivos m, rhw_conceptos c
            WHERE m.id_empresa = c.id_empresa(+)
            and m.id_concepto = c.id (+)
            ORDER BY ID
            ```
    }
    columnMapping {
