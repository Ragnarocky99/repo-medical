lov lv-comprobantes-det (
    name: LV_COMPROBANTES_DET_791
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT CP.ID, C.TIPO_COMPROBANTE, C.TIPO_COMPROBANTE||'-'||C.SER_COMPROBANTE||'-'|| LPAD(C.NRO_COMPROBANTE,7,'0') AS COMPROBANTE, SALDO_CUOTA AS SALDO_CUOTA_C,
            C.SER_COMPROBANTE, C.NRO_COMPROBANTE,C.SALDO_CUOTA, C.NRO_CUOTA , C.ID_CLIENTE,M.TIPO_CAMBIO, M.COD_MONEDA, M.DESCRIPCION, M.ID AS ID_MONEDA, C.ID ID_SALDO
            FROM CCW_SALDOS C, VTW_COMPROBANTES_CABECERA CP, BSW_MONEDAS M, CCW_CONDICIONES_VENTAS CV
            WHERE C.SALDO_CUOTA < 0
            AND C.ID_COMPROBANTE = CP.ID
            ---AND CP.ID = CD.ID_COMPROBANTE_CABECERA  ---SE COMENTA, TABLA DETALLA HACE QUE DUPLIQUE REGISTROS
            AND C.ID_CLIENTE = :P791_ID_CLIENTE
            AND M.ID = C.ID_MONEDA_CUOTA
            AND C.ID_EMPRESA = :P0_ID_EMPRESA
            AND CP.ID_CONDICION_VENTA = CV.ID
            AND NVL(CV.PLAZO, 0) != 0
            /*UNION ALL
            SELECT AC.ID, C.TIPO_COMPROBANTE, AC.TIP_COMPROBANTE||'-'||AC.SER_COMPROBANTE||'-'|| LPAD(AC.NRO_COMPROBANTE,7,'0') AS COMPROBANTE, SALDO_CUOTA AS SALDO_CUOTA_C,
            C.SER_COMPROBANTE, C.NRO_COMPROBANTE,C.SALDO_CUOTA, C.NRO_CUOTA , C.ID_CLIENTE,M.TIPO_CAMBIO, M.COD_MONEDA, M.DESCRIPCION, M.ID AS ID_MONEDA, C.ID ID_SALDO
            FROM CCW_SALDOS C, BSW_MONEDAS M, CCW_ANTICIPOS_CLIENTES_CAB AC
            WHERE C.SALDO_CUOTA < 0
            AND C.ID_ANTICIPO    = AC.ID
            ---AND CP.ID = CD.ID_COMPROBANTE_CABECERA  ---SE COMENTA, TABLA DETALLA HACE QUE DUPLIQUE REGISTROS
            AND C.ID_CLIENTE = :P791_ID_CLIENTE
            AND M.ID = C.ID_MONEDA_CUOTA
            AND C.ID_EMPRESA = :P0_ID_EMPRESA*/
            ```
    }
