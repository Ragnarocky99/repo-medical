lov lv-temporada-articulos (
    name: LV_TEMPORADA_ARTICULOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT T.COD_TEMPORADA || ' - ' ||T.DESCRIPCION AS DESCRIPCION,
                   T.ESTADO,
                   T.ID
            FROM STW_TEMPORADA T
            WHERE NVL(T.ESTADO,'N') = 'S'
              AND T.ID_EMPRESA = :P0_ID_EMPRESA
            ORDER BY TO_NUMBER(T.COD_TEMPORADA)
            ```
    }
    columnMapping {
        return: ID
        display: DESCRIPCION
    }

    column DESCRIPCION (
        heading {
            heading: Descripción
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

