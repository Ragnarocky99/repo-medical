lov lv-formulas (
    name: LV_FORMULAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select f.comentario|| ' (' || F.COD_FORMULA || ')' comentario, f.id, a.cod_articulo, a.descripcion, f.cantidad, f.se_informa 
            from stw_articulos a, pdw_formula_cab f 
            where f.id_empresa = :P0_ID_empresa 
            and f.id_empresa = a.id_empresa 
            and nvl( f.estado, 'N' ) = 'S' 
            and f.id_articulo = a.id 
            order by f.comentario
            ```
    }
    columnMapping {
        return: ID
        display: COMENTARIO
    }

    column CANTIDAD (
        heading {
            heading: Cantidad
        }
        layout {
            sequence: 50
        }
        source {
            dataType: number
        }
    )

    column COD_ARTICULO (
        heading {
            heading: Artículo
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column COMENTARIO (
        heading {
            heading: Comentario
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column DESCRIPCION (
        heading {
            heading: Descripción
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column SE_INFORMA (
        heading {
            heading: Se Informa
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

)

