lov ccw-saldos-saldos (
    name: CCW_SALDOS.SALDOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT S.TIPO_COMPROBANTE, 
                   S.SER_COMPROBANTE, 
                   S.NRO_COMPROBANTE, 
                   S.FEC_VENCIMIENTO, 
                   S.MONTO_CUOTA, 
                   S.SALDO_CUOTA,
                   M.DESCRIPCION||' ('||M.COD_MONEDA||')' as MONEDA, 
                   S.SALDO_CUOTA - NVL(S.REC_PENDIENTES, 0) as SALDO,
                   S.ID
            FROM CCW_SALDOS S, 
                 BSW_MONEDAS M
            WHERE S.SALDO_CUOTA - NVL(S.REC_PENDIENTES, 0)  != 0
                    AND S.ID_MONEDA_CUOTA = M.ID
                    AND S.ID_EMPRESA = :P0_COD_EMPRESA
                    AND S.ID_CLIENTE = :ID_CLIENTE
            
            /*
            SELECT ID, TIPO_COMPROBANTE, SER_COMPROBANTE, NRO_COMPROBANTE, ID_MONEDA_CUOTA, FEC_VENCIMIENTO, MONTO_CUOTA, SALDO_CUOTA, ID_COMPROBANTE
            FROM CCW_SALDOS S
            WHERE S.SALDO_CUOTA != 0
                AND S.ID_CLIENTE = :ID_CLIENTE
            */
            ```
    }
    columnMapping {
        return: ID
        display: MONTO_CUOTA
        oracleTextIndex: MONTO_CUOTA
    }

    column FEC_VENCIMIENTO (
        heading {
            heading: Vencimiento
        }
        layout {
            sequence: 50
        }
        source {
            dataType: date
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
