dataLoadDefinition extracto_bancario (
    name: EXTRACTO_BANCARIO
    target {
        type: collection
        name: EXTRACTO_BANCARIO_COL
        loadingMethod: replace
    }
    dataProfile {
        name: EXTRACTO_BANCARIO
        format: xlsx
    }
    advanced {
        encoding: utf-8
        defaultXlsxSheetName: sheet1.xml
    }

    dataProfileColumn c (
        columnName: C001
        source {
            sequence: 1
            dataType: varchar2
        }
        parsing {
            selector: COMPROBANTE
        }
    )

    dataProfileColumn c-2 (
        columnName: C002
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            selector: DEBE
        }
    )

    dataProfileColumn c-3 (
        columnName: C003
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            selector: HABER
        }
    )

)

