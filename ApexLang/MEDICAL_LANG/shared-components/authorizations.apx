authorization derechos-de-administración (
    name: Derechos de administración
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return true;
    }
    error {
        errorMessage: Privilegios insuficientes. El usuario no es administrador.
    }
)

