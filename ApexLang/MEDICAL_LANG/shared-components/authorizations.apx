authorization derecho-pagina (
    name: DERECHO_PAGINA2
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            SELECT PAGINA_ID FROM (BSW_ACCESO_POR_GRUPOS_APEX A),(BSW_USUARIOS C),(BSW_GRUPOS_USUARIOS U),(BSW_FORMAS_PAGINAS P) WHERE
            upper(C.COD_USUARIO)=upper(:APP_USER) AND A.ID_GRUPO=U.ID  AND P.PAGE_NO=(:APP_PAGE_ID) AND A.PAGINA_ID=P.NAV_ID
            AND C.ID_GRUPO=A.ID_GRUPO
            ```
    }
)

