authorization derecho-parametro (
    name: DERECHO_PARAMETRO
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            SELECT NULL FROM BSW_PERMISOS_FORMAS P,BSW_USUARIOS U WHERE
            P.ID_USUARIO=U.ID AND COD_USUARIO=:APP_USER AND 
            P.ID_FORMA=:APP_PAGE_ID AND PARAMETRO IN (SELECT ITEM_NAME FROM APEX_APPLICATION_PAGE_ITEMS WHERE PAGE_ID=:APP_PAGE_ID
            AND APPLICATION_ID=:APP_ID) AND NVL(P.IND_PERMISO,'N')='S'
            ```
    }
    advanced {
        evaluationType: perComponent
    }
)

authorization derechos-actualizar (
    name: DERECHOS_ACTUALIZAR1
    type: existsSqlQuery
    settings {
        sqlQuery:
            ```sql
            SELECT PUEDE_ACTUALIZAR FROM (BSW_ACCESO_POR_GRUPOS_APEX A),(BSW_USUARIOS C),(BSW_GRUPOS_USUARIOS U),(BSW_FORMAS_PAGINAS P) WHERE
            upper(C.COD_USUARIO)=upper(:APP_USER) AND A.ID_GRUPO=U.ID AND A.PUEDE_ACTUALIZAR='S'  AND P.PAGE_NO=(:APP_PAGE_ID) AND A.PAGINA_ID=P.NAV_ID
            AND C.ID_GRUPO=A.ID_GRUPO
            ```
    }
)

