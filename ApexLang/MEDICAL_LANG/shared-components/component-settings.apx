componentSetting (
    type: dynamicAction
    name: showAiAssistant
)

componentSetting (
    type: dynamicAction
    name: plugin/fosNotifications
    settings {
        options: [
            escapeHtml
            newestOnTop
            performClientSideSubstitutions
            dismissOnNotificationClickTap
            dismissOnCloseButtonClick
            autodismissSuccessNotifications
            autodismissInfoNotifications
            autodismissWarningNotifications
            autodismissErrorNotifications
            preventDuplicates
        ]
    }
)

componentSetting (
    type: dynamicAction
    name: plugin/apexSpotlightSearch
    settings {
        searchPlaceholderText: Buscador
        moreCharactersText: Por favor ingresa un caracter
        noMatchFoundText: No se encontró nada
        1MatchFoundText: 1 Resultado Encontrado
        multipleMatchesFoundText: Varios resultados
        inPageSearchText: Buscar en Pagina Actual
        searchHistoryDeleteText: Limpiar Historial de Busqueda
    }
)

