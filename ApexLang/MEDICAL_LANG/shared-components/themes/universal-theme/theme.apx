theme universal-theme (
    name: Universal Theme
    themeNumber: 42
    version: 23.2
    style {
        currentThemeStyle: @vita-verde-2
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @standard
        navigationBarList: @navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @top-navigation-menu
        navigationMenuListSide: @side-navigation-menu
        loginPage: @login
        errorPage: @login
        printerFriendlyPage: @standard
        breadcrumb: @breadcrumb
        button: @text
        defaultLabel: @optional-floating
        optionalLabel: @optional-floating
        requiredLabel: @required-floating
        list: @links-list
        region: @standard
        classicReport: @standard
    }
    regionDefaults {
        breadcrumbs: @title-bar
        charts: @standard
        forms: @standard
        lists: @standard
        reports: @standard
        wizards: @standard
        interactiveReports: @interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @blank-with-attributes
        dialogButtonRegion: @buttons-container
        dialogPage: @modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/23.2/
        identifier: UNIVERSAL_THEME
    }
    subscription {
        master: @/8842/universal-theme
    }

    style modo-oscuro (
        name: Modo Oscuro
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Dark.less
            outputCssFileUrl: #THEME_DB_FILES#77195432438234677.css
            jsonConfig: "{\"classes\":[],\"vars\":{},\"customCSS\":\"tr:nth-child(even) {\\n    background-color: #646262;\\n}\\nbody {   font-family: \\\"Arial\\\", serif; }\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
        }
    )

    style redwood-light (
        name: Redwood Light
        css {
            fileUrls: [
                #APEX_FILES#libraries/oracle-fonts/oraclesans-apex#MIN#.css?v=#APEX_VERSION#
                #THEME_FILES#css/Redwood#MIN#.css?v=#APEX_VERSION#
            ]
        }
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_FILES#less/theme/Redwood-Theme.less
            outputCssFileUrl: #THEME_FILES#css/Redwood-Theme#MIN#.css?v=#APEX_VERSION#
        }
        advanced {
            endUserCanPick: true
        }
        subscription {
            master: @redwood-light
        }
    )

    style redwood-light-2 (
        name: Redwood Light 2
        css {
            fileUrls: [
                #APEX_FILES#libraries/oracle-fonts/oraclesans-apex#MIN#.css?v=#APEX_VERSION#
                #THEME_FILES#css/Redwood#MIN#.css?v=#APEX_VERSION#
            ]
            cssClasses: rw-mode-nav--dark rw-pillar--teal rw-layout--edge-to-edge rw-mode-header--dark rw-mode-body--dark rw-mode-body-header--light
        }
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Redwood-Theme.less
            outputCssFileUrl: #THEME_DB_FILES#10917461816852489.css
            jsonConfig: "{\"classes\":[\"rw-layout--fixed t-PageBody--scrollTitle\",\"rw-mode-nav--dark\",\"rw-pillar--teal\",\"rw-layout--fixed t-PageBody--scrollTitle\",\"rw-layout--fixed t-PageBody--scrollTitle\",\"rw-layout--fixed t-PageBody--scrollTitle\",\"rw-layout--edge-to-edge\",\"rw-mode-header--dark\",\"rw-mode-body--dark\",\"rw-mode-body-header--light\"],\"vars\":{},\"customCSS\":\".rw-mode-header--dark {\\n    --ut-header-background-color:#96cb78;\\n    --ut-header-text-color:#fff;\\n    --ut-header-box-shadow:0 .5rem 2rem -10px rgba(0, 0, 0, .3);\\n}\\n\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
        }
    )

    style vita (
        name: Vita
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita.less
            outputCssFileUrl: #THEME_FILES#css/Vita#MIN#.css?v=#APEX_VERSION#
        }
        advanced {
            endUserCanPick: true
            accessibilityTested: true
        }
        subscription {
            master: @vita
        }
    )

    style vita-2 (
        name: Vita (2)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_FILES#49404974318731582.css
            jsonConfig: "{\"classes\":[],\"vars\":{},\"customCSS\":\"tr:nth-child(even) {\\n    background-color: #f2f2f2;\\n}\\nbody {   font-family:  Roboto, Arial, sans-serif; }\\n\\n\\n.comprobante{\\n  pointer-events: none;\\n  color: #000000;\\n  background-color: #e0e0e0;\\n  box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);\\n  border-style:solid;\\n  border-color: #a8a8a8;\\n}\\n\\n.asientolink{\\n  color: #0000ff;\\n  background-color: #e0e0e0;\\n  box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);\\n  border-style:solid;\\n  border-color: #a8a8a8;\\n}\\n\\n.no-pointer-g{\\n    pointer-events : none;\\n}\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
            accessibilityTested: true
        }
    )

    style vita-dark (
        name: Vita - Dark
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Dark.less
            outputCssFileUrl: #THEME_FILES#css/Vita-Dark#MIN#.css?v=#APEX_VERSION#
        }
        advanced {
            endUserCanPick: true
        }
        subscription {
            master: @vita-dark
        }
    )

    style vita-red (
        name: Vita - Red
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Red.less
            outputCssFileUrl: #THEME_FILES#css/Vita-Red#MIN#.css?v=#APEX_VERSION#
        }
        advanced {
            endUserCanPick: true
        }
        subscription {
            master: @vita-red
        }
    )

    style vita-slate (
        name: Vita - Slate
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Slate.less
            outputCssFileUrl: #THEME_FILES#css/Vita-Slate#MIN#.css?v=#APEX_VERSION#
        }
        advanced {
            endUserCanPick: true
        }
        subscription {
            master: @vita-slate
        }
    )

    style vita-verde (
        name: Vita (Verde 2)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_FILES#10923313438878970.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Nav-Accent-BG\":\"#056ac8\",\"@g_Nav-Accent-FG\":\"#ffffff\",\"@g_Nav-Badge-BG\":\"#dcdbe4\",\"@g_Nav-Badge-FG\":\"#ffffff\",\"@g_NavBarMenu-BG\":\"#e81c1c\",\"@g_NavBarMenu-FG\":\"#262626\",\"@g_Nav-BG\":\"#000000\",\"@g_Nav-FG\":\"#ffffff\",\"@g_Nav_Style\":\"dark\",\"@g_Header-BG\":\"#59b974\",\"@g_Header-FG\":\"#ffffff\",\"@l_Button-Hot-BG\":\"#15cd40\",\"@l_Button-Hot-Text\":\"#ffffff\"},\"customCSS\":\"\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
            accessibilityTested: true
        }
    )

    style vita-verde-2 (
        name: Vita (Verde)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_FILES#77693284439184081.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Header-BG\":\"#133561\",\"@g_Header-FG\":\"#f9f9f8\",\"@l_Button-Hot-BG\":\"#3f46bb\",\"@l_Button-Hot-Text\":\"#ffffff\",\"@g_Nav-Accent-BG\":\"#3f46bb\",\"@g_Nav-Accent-FG\":\"#ffffff\",\"@g_Nav-Badge-BG\":\"#3f46bb\",\"@g_Nav-Badge-FG\":\"#ffffff\",\"@g_NavBarMenu-Active-BG\":\"#3f46bb\",\"@g_NavBarMenu-Active-FG\":\"#ffffff\",\"@g_Region-Header-BG\":\"#f8f8f8\",\"@g_Region-Header-FG\":\"#000000\",\"@g_Region-BG\":\"#ffffff\",\"@g_Region-FG\":\"#262626\",\"@irrBg\":\"#ffffff\",\"@g_Color-Palette-1\":\"#000000\",\"@g_Color-Palette-1-FG\":\"#ffffff\",\"@g_Link-Base\":\"#3f46bb\",\"@g_Focus\":\"#3f46bb\"},\"customCSS\":\"tr:nth-child(even) {\\n    background-color: #f2f2f2;\\n}\\nbody {   font-family:  Roboto, Arial, sans-serif; }\\n\\n\\n.comprobante{\\n  pointer-events: none;\\n  color: #000000;\\n  background-color: #e0e0e0;\\n  box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);\\n  border-style:solid;\\n  border-color: #a8a8a8;\\n}\\n\\n.asientolink{\\n  color: #0000ff;\\n  background-color: #e0e0e0;\\n  box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);\\n  border-style:solid;\\n  border-color: #a8a8a8;\\n}\\n\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
            accessibilityTested: true
        }
    )

)

