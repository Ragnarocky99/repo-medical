customAttribute attribute_01 (
    apexlangName: plSqlCode
    attribute: 1
    name: PL/SQL Code
    type: plsqlCode
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText:
            ```
            <p>Specify an execution only PL/SQL anonymous block, that is executed on the server.</p>
            <p>You can reference other page or application items from within your application using bind syntax (for example <code>:P1_MY_ITEM</code>). Any items referenced also need to be included in <strong>Page Items to Submit</strong>.</p>
            <p>Reference CLOB value using <strong>apex_application.g_clob_01</strong>.</p>
            ```
    }
    examples {
        examples:
            ```
            <pre>
            begin
                setCommission(:P1_SAL, :P1_JOB);
            end;
            </pre>
            <p>In this example, you need to enter <code>P1_SAL,P1_JOB</code> in <strong>Page Items to Submit</strong>.</p>
            <h3>Notifications</h3>
            <p>You can override the success notification using the following global variables:</p>
            <pre>
            apex_application.g_x01 := 'My custom message';
            apex_application.g_x02 := 'My custom title'; -- optional
            apex_application.g_x03 := 'warning';         -- optional (success, info, warning, error)
            </pre>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: itemsToSubmit
    attribute: 2
    name: Items to Submit
    type: pageItems
    appearance {
        sequence: 20
    }
    help {
        helpText:
            ```
            <p>Enter the uppercase page items submitted to the server, and therefore, available for use within your <strong>PL/SQL Code</strong>.</p>
            <p>You can type in the item name or pick from the list of available items.
            If you pick from the list and there is already text entered then a comma is placed at the end of the existing text, followed by the item name returned from the list.</p>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: itemsToReturn
    attribute: 3
    name: Items to Return
    type: pageItems
    appearance {
        sequence: 30
    }
    help {
        helpText:
            ```
            <p>Enter the uppercase page items set when the call to the server returns, based on their current value in session state. If your <strong>PL/SQL Code</strong> sets one or more page item values in session state you need to define those items in this attribute.</p>
            <p>You can type in the item name or pick from the list of available items.
            If you pick from the list and there is already text entered then a comma is placed at the end of the existing text, followed by the item name returned from the list.</p>
            ```
    }
    examples {
        examples:
            ```
            <pre>
                apex_util.set_session_state('P1_MY_ITEM', 'New Value');
            </pre>
            </p>
            <p>In this example, enter <code>P1_MY_ITEM</code> in this attribute in order for 'New Value' to be displayed in that item on your page.</p>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: successMessage
    attribute: 4
    name: Success Message
    appearance {
        sequence: 40
    }
    builder {
        translatable: true
    }
    help {
        helpText:
            ```
            <p>Provide a success message which will be displayed as a green alert if the execution is completed successfully.</p>
            <p>This message can be dynamically overridden in the PL/SQL Code block by assigning the new value to the apex_application.g_x01 global variable.</p>
            <pre>apex_application.g_x01 := 'New Success Message';</pre>
            <p>If no success message is provided, the notification will not be shown.</p>
            ```
    }
    examples {
        examples:
            ```
            <h3>Notifications</h3>
            <p>You can override the success notification using the following global variables:</p>
            <pre>
            apex_application.g_x01 := 'My custom message';
            apex_application.g_x02 := 'My custom title'; -- optional
            apex_application.g_x03 := 'warning';         -- optional (success, info, warning, error)
            </pre>
            ```
    }
)

customAttribute attribute_05 (
    apexlangName: errorMessage
    attribute: 5
    name: Error Message
    appearance {
        sequence: 50
    }
    builder {
        translatable: true
    }
    default {
        value: #SQLERRM#
    }
    help {
        helpText:
            ```
            <p>Provide an error message which will be displayed as a warning notification if the execution is completed unsuccessfully.</p>
            <p>This message can be dynamically overridden in the PL/SQL Code block by assigning the new value to the <code>apex_application.g_x02</code> global variable.</p>
            <pre>apex_application.g_x02 := 'New Error Message';</pre>
            <p>If no error message is provided, none will be shown.</p>
            <p>You can also use the #SQLCODE#, #SQLERRM# and #SQLERRM_TEXT# substitution strings for more detailed error information.</p>
            <p>By default the error message will be displayed in the top right corner as a notification. If you wish to display it as an alert, tick the Show "Error as Alert" checkbox.</p>
            ```
    }
)

customAttribute attribute_06 (
    apexlangName: submitClob
    attribute: 6
    name: Submit CLOB
    type: selectList
    componentLov {
        nullText: No
    }
    appearance {
        sequence: 60
    }
    help {
        helpText: <p>Values submitted to the server in APEX page items can have a maximum length of 4000 characters. If you need to submit values larger than that, specify here the source, and the value will be made available to you via the <code>apex_application.g_clob_01</code> global variable in your PL/SQL code block. From there, you can modify the value, store it in a table or collection, etc.</p>
    }

    entry fromFunctionDefinedInJavascriptInitializ (
        sequence: 30
        display: From Function Defined in "Javascript Initialization Code"
        return: javascriptinit
        help {
            helpText:
                ```
                <p>You can define a function in the "Javascript Initialization Code" attribute named "submitClob" that returns your value e.g.</p>
                <pre>
                function(options) {
                   options.submitClob = function() { return getMyClobValue(); }
                   return options;
                }
                </pre>
                ```
        }
    )

    entry fromJavascriptVariable (
        sequence: 20
        display: From JavaScript Variable
        return: javascriptvariable
        help {
            helpText: CLOB will be read from a javascript variable. <strong>The variable must be accessible on the window object.</strong><br>
        }
    )

    entry fromPageItem (
        sequence: 10
        display: From Page Item
        return: pageitem
        help {
            helpText: CLOB will be read from a page item<br>
        }
    )

)

customAttribute attribute_07 (
    apexlangName: submitFrom
    attribute: 7
    name: Submit From
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: =
        value: pageitem
    }
    help {
        helpText: <p>Specify the page item whose value will be loaded into the <code>apex_application.g_clob_01</code> global variable.</p>
    }
)

customAttribute attribute_08 (
    apexlangName: submitFrom2
    attribute: 8
    name: Submit From
    validation {
        required: true
    }
    appearance {
        sequence: 80
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: =
        value: javascriptvariable
    }
    help {
        helpText:
            ```
            <p>Specify the name of the JavaScript variable to be loaded into the <code>apex_application.g_clob_01</code> global variable.</p>
            <p>If the variable is a JSON, it will be stringified.</p>
            <p>You do not have to prefix the variable with <code>window.</code></p>
            ```
    }
    examples {
        examples: <pre>nameSpace.largeString</pre>
    }
)

customAttribute attribute_09 (
    apexlangName: returnClob
    attribute: 9
    name: Return CLOB
    type: selectList
    componentLov {
        nullText: No
    }
    appearance {
        sequence: 90
    }
    help {
        helpText: <p>If you set this option to anything other that "No", any content found in <code>apex_application.g_clob_01</code> at the end of the PL/SQL execution will be loaded in the specified destination.</p>
    }

    entry intoFunctionDefinedInJavascriptInitializ (
        sequence: 40
        display: Into Function Defined in "Javascript Initialization Code" as JSON
        return: javascriptinitasjson
        help {
            helpText:
                ```
                <p>You can define a function in the "Javascript Initialization Code" attribute named "clobCallback" that takes the result and passes it in as the first argument of your Javascript function e.g.</p>
                <pre>
                function(options) {
                   options.clobCallback = function(result) {
                      if (result.status) {
                         doSomeAction(result.value);
                      } else {
                         doSomeOtherAction(result.value)
                      }
                   }
                   return options;
                }
                </pre>
                ```
        }
    )

    entry intoJavascriptVariable (
        sequence: 20
        display: Into JavaScript Variable
        return: javascriptvariable
        help {
            helpText: Store CLOB in a javascript variable<br>
        }
    )

    entry intoJavascriptVariableAsJson (
        sequence: 30
        display: Into JavaScript Variable as JSON
        return: javascriptvariablejson
        help {
            helpText: Store CLOB in a javascript variable, but have the CLOB parsed as JSON first, so javascript variable will hold an object, not a string.<br>
        }
    )

    entry intoPageItem (
        sequence: 10
        display: Into Page Item
        return: pageitem
        help {
            helpText: Receive CLOB and store in a page item<br>
        }
    )

)

customAttribute attribute_10 (
    apexlangName: returnInto
    attribute: 10
    name: Return Into
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: pageitem
    }
    help {
        helpText: <p>Specify a page item into which the value of <code>apex_application.g_clob_01</code> will be loaded.</p>
    }
)

customAttribute attribute_11 (
    apexlangName: returnInto2
    attribute: 11
    name: Return Into
    validation {
        required: true
    }
    appearance {
        sequence: 110
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: inList
        list: [
            javascriptvariable
            javascriptvariablejson
        ]
    }
    help {
        helpText:
            ```
            <p>Specify the JavaScript variable into which the value of <code>apex_application.g_clob_01</code> will be loaded.</p>
            <p>If you chose <b>Into JavaScript Variable</b> the value will simply be loaded as a string.</p>
            <p>If you chose <b>Into JavaScript Variable as JSON</b> the value will be first parsed as JSON, then assigned to the variable.</p>
            <p>Note that you can specify any variable, even a nested one. If it doesn't exist, it will be created.</p>
            ```
    }
    examples {
        examples:
            ```
            <p><b>PL/SQL Code</b></p>
            <pre>
            apex_json.initialize_clob_output;
            apex_json.open_array;
            
            for employee in (select * from emp)
            loop
                apex_json.open_object;
                apex_json.write('empno', employee.empno);
                apex_json.write('empname', employee.empname);
                apex_json.close_object;
            end loop;
            
            apex_json.close_array;
            apex_application.g_clob_01 := apex_json.get_clob_output;
            apex_json.free_output;
            </pre>
            <p><b>Return CLOB</b></p>
            <pre>Into JavaScript Variable as JSON</pre>
            <p><b>Return Into</b></p>
            <pre>myApp.employees</pre>
            
            <p>You can then reference this object in any JavaScript context on the page, usually in subsequent Execute Javascript dynamic actions.</p>
            ```
    }
)

customAttribute attribute_15 (
    apexlangName: extraOptions
    attribute: 15
    name: Extra Options
    type: checkboxes
    appearance {
        sequence: 150
    }
    default {
        value: escape-message
    }
    help {
        helpText: Fine control on behavior of the plug-in.<br>
    }

    entry advancedResultIsJson (
        sequence: 100
        display: "[Advanced] Result is JSON"
        return: jsonResult
        help {
            helpText:
                ```
                <p>You can return a JSON object as the response giving you the ability to perform the following:</p>
                <ol>
                <li>Success Message</li>
                <li>Error Message</li>
                <li>Add errors to page items</li>
                <li>Hide/Show Page Items & Regions & Buttons</li>
                <li>Disable/Enable Buttons</li>
                <li>Set Items/Regions Read Only</li>
                <li>Return page item values</li>
                <li>Refresh Regions and Page (LOV) Items</li>
                <li>Trigger Events</li>
                <li>Add/Remove CSS Classes</li>
                <li>Set Focus</li>
                </ol>
                <h3>Example JSON Structure</h3>
                <pre>
                {
                   "success": true,
                   "message": "",
                   "clearErrors": true,
                   "successMessage": "",
                   "errorMessage": "",
                   "itemErrors": {
                      "P1_ITEM": "Example error message",
                      "P1_ITEM2": "Other example message"
                   },
                   "hide": [{
                         "type": "item",
                         "name": "P1_ITEM1"
                      },
                      {
                         "type": "region",
                         "name": "IG_REPORT1"
                      },
                      {
                         "type": "button",
                         "name": "BTN1"
                      },
                      {
                         "type": "column",
                         "region": "",
                         "name": "COLUMN1"
                      }
                   ],
                   "show": [{
                         "type": "item",
                         "name": "P1_ITEM1"
                      },
                      {
                         "type": "regon",
                         "name": "IG_REPORT1"
                      }
                   ],
                   "readOnly": [{
                         "type": "item",
                         "name": "P1_ITEM1"
                      },
                      {
                         "type": "region",
                         "name": "IG_REPORT1"
                      }
                   ],
                   "setValues": [{
                      "type": "item",
                      "name": "P1_ITEM1",
                      "value": "New Value"
                   }],
                   "refresh": [{
                      "type": "item",
                      "name": "P1_LOV1"
                   }, {
                      "type": "region",
                      "name": "IG_REPORT1"
                   }],
                   "events": [{
                      "selector": "body",
                      "name": "my-custom-event1",
                      "data": {}
                   }, {
                      "selector": "body",
                      "name": "my-custom-event2",
                      "data": {}
                   }]
                }
                </pre>
                ```
        }
    )

    entry escapeSpecialCharactersInMessages (
        sequence: 130
        display: Escape Special Characters in Messages
        return: escape-message
        help {
            helpText: <p>Enable this option to escape any HTML tags in the success or error message. This should remain turned on by default to avoid any possibility of a cross-site-scripting attack. If however you do need to display HTML in a notification, you can turn this setting off, but escape individual page items via the <code>&P1_ITEM!HTML.</code> syntax.</p>
        }
    )

    entry replaceMessageSubstitutionsClientSide (
        sequence: 120
        display: Replace Message Substitutions Client-side
        return: client-substitutions
        help {
            helpText:
                ```
                <p>By default, item substitutions in success and error messages will be performed server-side, with session-state values, right after the processing has finished in the AJAX call.</p>
                <p>This option enables you to override this, and perform the substitutions on the client, after the AJAX response has arrived, but before the notification is shown.</p>
                
                <p>Server-side substitutions are usually the desired method, as they are sure to use the latest session-state values, but can also replace application items, which the client does not have access to. Client-side substitutions are desired when substituting for an item whose value exists on the client, but has not yet propagated to session-state.</p>
                ```
        }
    )

    entry showErrorAsAlert (
        sequence: 20
        display: Show Error as Alert
        return: showErrorAsAlert
        help {
            helpText: <p>By default, errors will be shown via <code>apex.message.showErrors</code> as opposed to <code>apex.message.alert</code>. If you wish to use the classic alert, tick this checkbox.</p>
        }
    )

    entry showSpinnerOnRegion (
        sequence: 50
        display: Show Spinner on Region
        return: spinnerPosition
        help {
            helpText: <p>Check this option to only show the spinner on a particular region. If you do not check this option then it will be shown at the page level. If you have also checked the "Show Spinner Overlay Mask" it will only mask the region you have defined in the "Affected Elements".</p>
        }
    )

    entry showSpinnerProcessingIcon (
        sequence: 30
        display: Show Spinner/Processing Icon
        return: showSpinner
        help {
            helpText: <p>Check this option if you want to have a Spinner/Processing Icon to be displayed while waiting the execution to complete.</p>
        }
    )

    entry showSpinnerWithModalOverlayMask (
        sequence: 40
        display: Show Spinner with Modal Overlay Mask
        return: showSpinnerOverlay
        help {
            helpText:
                ```
                <p>Shows the spinner with a modal overlay stopping the user from interacting with the content behind the overlay mask.</p>
                <p><strong>Note:</strong> this setting has no effect if you do not check "Show Spinner"</p>
                ```
        }
    )

    entry suppressChangeEvent (
        sequence: 10
        display: Suppress Change Event
        return: suppressChangeEvent
        help {
            helpText:
                ```
                <p>Specify whether the change event is suppressed on the items specified
                 in Page Items to Return. This prevents subsequent Change based Dynamic 
                Actions from firing, for these items.</p>
                ```
        }
    )

)

