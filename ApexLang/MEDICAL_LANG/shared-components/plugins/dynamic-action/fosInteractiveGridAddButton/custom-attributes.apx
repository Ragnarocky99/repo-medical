customAttribute attribute_01 (
    apexlangName: addButtonTo
    attribute: 1
    name: Add Button To
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: toolbar-actions4
    }
    help {
        helpText: <p>The element to which the button should be added.</p>
    }

    entry menuActions (
        sequence: 80
        display: Menu - Actions
        return: menu-actions
        help {
            helpText: <p>The Actions menu in the Interactive Grid toolbar</p>
        }
    )

    entry menuRowActions (
        sequence: 90
        display: Menu - Row Actions
        return: menu-row-actions
        help {
            helpText: <p>The Row Actions menu. The Interactive Grid must have an Actions Menu column defined.</p>
        }
    )

    entry menuSelectionActions (
        sequence: 100
        display: Menu - Selection Actions
        return: menu-selection-actions
        help {
            helpText: <p>The Selection Actions menu. The Interactive Grid must have an Actions Menu column defined.</p>
        }
    )

    entry toolbarActionsMenuGroup (
        sequence: 40
        display: Toolbar - Actions Menu Group
        return: toolbar-actions1
        help {
            helpText: <p>Actions Menu Group</p>
        }
    )

    entry toolbarAddRowGroup (
        sequence: 60
        display: Toolbar - Add Row Group
        return: toolbar-actions3
        help {
            helpText: <p>Add Row Group</p>
        }
    )

    entry toolbarEditSaveGroup (
        sequence: 50
        display: Toolbar - Edit & Save Group
        return: toolbar-actions2
        help {
            helpText: <p>Edit & Save Group</p>
        }
    )

    entry toolbarResetGroup (
        sequence: 70
        display: Toolbar - Reset Group
        return: toolbar-actions4
        help {
            helpText: <p>Reset Group</p>
        }
    )

    entry toolbarSavedReportsGroup (
        sequence: 20
        display: Toolbar - Saved Reports Group
        return: toolbar-reports
        help {
            helpText: <p>Saved Reports Group</p>
        }
    )

    entry toolbarSearchBoxGroup (
        sequence: 10
        display: Toolbar - Search Box Group
        return: toolbar-search
        help {
            helpText: <p>Search Box Group</p>
        }
    )

    entry toolbarViewSwitchGroup (
        sequence: 30
        display: Toolbar - View Switch Group
        return: toolbar-views
        help {
            helpText: <p>View Switch Group</p>
        }
    )

)

customAttribute attribute_02 (
    apexlangName: alignment
    attribute: 2
    name: Alignment
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: last
    }
    help {
        helpText: <p>Choose how to align the button.</p>
    }

    entry custom (
        sequence: 30
        display: Custom
        return: custom
        help {
            helpText: <p>At a specific index</p>
        }
    )

    entry first (
        sequence: 10
        display: First
        return: first
        help {
            helpText: <p>First in the list</p>
        }
    )

    entry last (
        sequence: 20
        display: Last
        return: last
        help {
            helpText: <p>Last in the list</p>
        }
    )

)

customAttribute attribute_03 (
    apexlangName: addAtIndex
    attribute: 3
    name: Add at Index
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: =
        value: custom
    }
    help {
        helpText:
            ```
            <p>The index at which the button should be added.</p>
            <p>This is a 0 based index, which means that 0 corresponds to the first item in the list, 1 to the second, and so on.</p>
            <p>When adding a button to a popup menu, separators have to be kept in mind, as they also count to the list entries.</p>
            <p>For example, in the list [button, separator, button], adding a newButton at index 2 will result in [button, separator, newButton, button].</p>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: separator
    attribute: 4
    name: Separator
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: none
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: inList
        list: [
            menu-row-actions
            menu-selection-actions
            menu-actions
        ]
    }
    help {
        helpText:
            ```
            <p>Choose whether to add a separator, a horizontal delimiter, together with the button.</p>
            <p>Note that a separator will not be added if there already exists a separator in that place.</p>
            <p>Similarly, separators will not be added if they are the first or last item in the list.</p>
            ```
    }

    entry after (
        sequence: 30
        display: After
        return: after
        help {
            helpText: <p>Add a separator below the button</p>
        }
    )

    entry before (
        sequence: 20
        display: Before
        return: before
        help {
            helpText: <p>Add a separator above the button</p>
        }
    )

    entry beforeAfter (
        sequence: 40
        display: Before & After
        return: before,after
        help {
            helpText: <p>Add a separator both above and below the button</p>
        }
    )

    entry none (
        sequence: 10
        display: None
        return: none
        help {
            helpText: <p>Do not add a separator</p>
        }
    )

)

customAttribute attribute_05 (
    apexlangName: label
    attribute: 5
    name: Label
    appearance {
        sequence: 50
    }
    builder {
        translatable: true
    }
    help {
        helpText: <p>The label of the button.</p>
    }
)

customAttribute attribute_06 (
    apexlangName: icon
    attribute: 6
    name: Icon
    type: icon
    appearance {
        sequence: 60
    }
    help {
        helpText: <p>The icon of the button.</p>
    }
)

customAttribute attribute_07 (
    apexlangName: actionName
    attribute: 7
    name: Action Name
    appearance {
        sequence: 70
    }
    help {
        helpText:
            ```
            <p>This attribute is <b>optional</b>.</p>
            
            <p>If you wish for the button to trigger a built-in function of the Interactive Grid, such as saving changes or opening the downloads dialog, pass its corresponding "Action Name". You can find a list of all options under: <a href="https://apex.oracle.com/jsapi" target="_blank">https://apex.oracle.com/jsapi</a> > Widgets > interactiveGrid > Actions. <b>Then set the "On Click" attribute to "Do Nothing - Action is handled externally"</b></p>
            
            <p>If you wish to later control the button (disable, hide, change label, etc) pass a unique identifier here. You can then use it to get a reference to the action via the <code>apex.actions</code> namespace.</p>
            ```
    }
    examples {
        examples:
            ```
            <ul>
            <li><code>row-add-row</code> - Insert a row straight after the current row</li>
            <li><code>row-duplicate</code> - Duplicate the current row</li>	
            <li><code>row-delete</code> - Delete the current row</li>
            <li><code>row-refresh</code> - Refresh the current row</li>
            <li><code>row-revert</code> - Revert the current row to its original state when the Interactive Grid region was refreshed</li>
            <li><code>edit</code> - Toggle the current edit mode</li>
            <li><code>refresh</code> - Refresh the Interactive Grid region</li>
            <li><code>save</code> - Save the current data changes. Note: Interactive Grid must be editable</li>
            <li><code>show-download-dialog</code> - Show the download dialog</li>
            <li><code>my-custom-action</code> - the name/id of your own custom action</li>
            </ul>
            ```
    }
)

customAttribute attribute_08 (
    apexlangName: conditionColumn
    attribute: 8
    name: Condition Column
    appearance {
        sequence: 80
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: menu-row-actions
    }
    help {
        helpText: <p>The button can be hidden or be displayed as disabled on a row-by-row basis. This functionality can be acieved by providing the name of the column that holds this information. If the value of this column is <code>hidden</code>, the button will not show. If it's <code>disabled</code>, it will show but be displayed as disabled. If the value is anything else, the button will appear normally.</p>
    }
)

customAttribute attribute_09 (
    apexlangName: onClick
    attribute: 9
    name: On Click
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    default {
        value: execute-javascript-code
    }
    help {
        helpText: <p>Defines the type of action that will be performed on click of the button.</p>
    }

    entry doNothingActionIsHandledExternally (
        sequence: 10
        display: Do nothing - Action is handled externally
        return: do-nothing
        help {
            helpText: <p>Choose this option if the action is already defined and handled by the Interactive Grid</p>
        }
    )

    entry executeJavascriptCode (
        sequence: 30
        display: Execute JavaScript Code
        return: execute-javascript-code
        help {
            helpText: <p>Execute JavaScript code. The code will be executed with a different context (<code>this</code>) depending on the type of button configured.</p>
        }
    )

    entry returnPrimaryKeySIntoItem (
        sequence: 20
        display: Return Primary Key(s) into Item
        return: return-pks-into-item
        help {
            helpText:
                ```
                <p>This option is only valid if the button location is in the Row Actions Menu or the Row Selection Menu.</p>
                <p>On button click, the primary key(s) of the selected row(s) will be stringified and populated into a page item. One can then listen on change of that item, and proceed from there.</p>
                <h4>A note on the form of the primary key</h4>
                <p>If the Interactive Grid has exactly 1 primary key column the values will be an Array of ID's returned in JSON encoded string ["7839","7698"].</p>
                <p>If the Interactive Grid has more than 1 primary key column the values will be a multi-dimensional Array of ID's returned in JSON encoded string , e.g <code>[["7839","KING"],["7698","BLAKE"]]</code>. You can convert this string back to JSON either in JavaScript via <code>JSON.parse</code> or in PL/SQL via <code>APEX_JSON.PARSE</code>.</p>
                ```
        }
    )

    entry triggerEvent (
        sequence: 40
        display: Trigger Event
        return: trigger-event
        help {
            helpText:
                ```
                <p>Triggers a custom event on the Interactive Grid element.</p>
                <p>The event will be triggered with an object of extra parameters. Consult the JavaScript Code attribute help text for more information.</p>
                ```
        }
    )

)

customAttribute attribute_10 (
    apexlangName: pageItem
    attribute: 10
    name: Page Item
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: return-pks-into-item
    }
    help {
        helpText: <p>The Page Item to be populated with the values of the primary key(s) of the affected row(s).</p>
    }
)

customAttribute attribute_11 (
    apexlangName: javascriptCode
    attribute: 11
    name: JavaScript Code
    type: javaScriptCode
    validation {
        required: true
    }
    appearance {
        sequence: 110
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: execute-javascript-code
    }
    help {
        helpText:
            ```
            <p>The JavaScript Code to be executed on button click. Depending on the button location, the code will have access to different attributes.</p>
            <p>Buttons in any location will have access to:</p>
            <ul>
            <li><code>this.data.event</code> - Browser event that caused the action to be invoked</li>
            <li><code>this.data.focusElement</code> - The element that had focus when the action was invoked</li>
            <li><code>this.data.region</code> - Interactive Grid region object</li>
            <li><code>this.data.model</code> - Model object of the current view</li>
            <li><code>this.data.actionsContext</code> - The actionsContext object of the current view</li>
            </ul>
            <br>
            <p>Additionally for Row Action buttons:</p>
            <ul>
            <li><code>this.data.record</code> - The record for which the action was invoked</li>
            </ul>
            <br>
            <p>Additionally for Selection Action buttons:</p>
            <ul>
            <li><code>this.data.selectedRecords</code> - An array of the selected records</li>
            </ul>
            ```
    }
)

customAttribute attribute_12 (
    apexlangName: eventName
    attribute: 12
    name: Event Name
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    dependingOn {
        attribute: @attribute_09/component
        conditionType: =
        value: trigger-event
    }
    help {
        helpText: <p>The name of the event to be triggered on the Interactive Grid.</p>
    }
)

customAttribute attribute_15 (
    apexlangName: extraOptions
    attribute: 15
    name: Extra Options
    type: checkboxes
    appearance {
        sequence: 150
    }
    help {
        helpText: <p>Extra button options. Note that some of these only apply to toolbar buttons.</p>
    }

    entry disableOnNoData (
        sequence: 20
        display: Disable On No Data
        return: disable-if-no-data
        help {
            helpText: Disable the button if the grid contains no data.
        }
    )

    entry disableOnNoSelection (
        sequence: 10
        display: Disable On No Selection
        return: disable-if-no-rows
        help {
            helpText: Disable the button if no rows are selected in the Interactive Grid.
        }
    )

    entry hideOnNoData (
        sequence: 40
        display: Hide On No Data
        return: hide-if-no-data
        help {
            helpText: Hide the button if the grid contains no data.
        }
    )

    entry hideOnNoSelection (
        sequence: 30
        display: Hide On No Selection
        return: hide-if-no-rows
        help {
            helpText: Hide the button if no rows are selected in the Interactive Grid.
        }
    )

    entry toolbarOnlyHot (
        sequence: 40
        display: "[Toolbar Only] Hot"
        return: is-hot
        help {
            helpText:
                ```
                <p>This option only applies to toolbar buttons.</p>
                <p>Choose if the button is styled "Hot", that is, if the button takes the primary color of the application.</p>
                ```
        }
    )

    entry toolbarOnlyIconOnly (
        sequence: 60
        display: "[Toolbar Only] Icon Only"
        return: icon-only
        help {
            helpText:
                ```
                <p>This option only applies to toolbar buttons.</p>
                <p>Toggle this option if you only want the button to have an icon and no label.</p>
                ```
        }
    )

    entry toolbarOnlyRightAlignedIcon (
        sequence: 50
        display: "[Toolbar Only] Right-aligned Icon"
        return: right-aligned-icon
        help {
            helpText:
                ```
                <p>This option only applies to toolbar buttons that have an icon defined.</p>
                <p>By default, toolbar button icons are left-aligned. Choose this option if you wish to right-align the icon.</p>
                ```
        }
    )

)

