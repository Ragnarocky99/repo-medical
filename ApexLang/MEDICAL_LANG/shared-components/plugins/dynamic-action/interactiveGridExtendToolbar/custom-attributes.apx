customAttribute attribute_01 (
    apexlangName: toolbarGroup
    attribute: 1
    name: Toolbar Group
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: actions2
    }
    help {
        helpText: Choose one of default IG toolbar groups. With this plugin you can add button to the start or end of the group.
    }

    entry 1SearchBoxGroup (
        sequence: 10
        display: 1. Search Box Group
        return: search
        advanced {
            quickPick: true
        }
    )

    entry 2SavedReportsGroup (
        sequence: 20
        display: 2. Saved Reports Group
        return: reports
        advanced {
            quickPick: true
        }
    )

    entry 3ViewSwitchGroup (
        sequence: 30
        display: 3. View Switch Group
        return: views
        advanced {
            quickPick: true
        }
    )

    entry 4ActionsMenuGroup (
        sequence: 40
        display: 4. Actions Menu Group
        return: actions1
        advanced {
            quickPick: true
        }
    )

    entry 5EditSaveGroup (
        sequence: 50
        display: 5. Edit & Save Group
        return: actions2
        advanced {
            quickPick: true
        }
    )

    entry 6AddRowGroup (
        sequence: 60
        display: 6. Add Row Group
        return: actions3
        advanced {
            quickPick: true
        }
    )

    entry 7ResetGroup (
        sequence: 70
        display: 7. Reset Group
        return: actions4
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_02 (
    apexlangName: groupPosition
    attribute: 2
    name: Group Position
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    builder {
        common: false
        showInWizard: false
    }
    default {
        value: L
    }
    help {
        helpText: Choose group position. Start or end of the toolbar group.
    }

    entry end (
        sequence: 20
        display: End
        return: L
    )

    entry start (
        sequence: 10
        display: Start
        return: F
    )

)

customAttribute attribute_03 (
    apexlangName: label
    attribute: 3
    name: Label
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    builder {
        translatable: true
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: =
        value: N
    }
    help {
        helpText: Label of a button. You can also use text messages defined in shared components.
    }
)

customAttribute attribute_04 (
    apexlangName: hot
    attribute: 4
    name: Hot
    type: yesNo
    appearance {
        sequence: 40
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText: Hot or not? :)
    }
)

customAttribute attribute_05 (
    apexlangName: icon
    attribute: 5
    name: Icon
    type: icon
    appearance {
        sequence: 50
    }
    help {
        helpText: Define APEX icon class for a button.
    }
    examples {
        examples: fa fa-user
    }
)

customAttribute attribute_06 (
    apexlangName: iconOnly
    attribute: 6
    name: Icon Only
    type: yesNo
    appearance {
        sequence: 25
    }
    help {
        helpText: Display only button with icon.
    }
)

customAttribute attribute_07 (
    apexlangName: iconPosition
    attribute: 7
    name: Icon Position
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    default {
        value: B
    }
    dependingOn {
        attribute: @attribute_05/component
        conditionType: isNotNull
    }
    help {
        helpText: Display position of an icon - before or after label.
    }

    entry afterLabel (
        sequence: 20
        display: After Label
        return: A
    )

    entry beforeLabel (
        sequence: 10
        display: Before Label
        return: B
    )

)

customAttribute attribute_08 (
    apexlangName: title
    attribute: 8
    name: Title
    appearance {
        sequence: 80
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText: HTML button title attribute. Shown on mouse hover.
    }
)

customAttribute attribute_09 (
    apexlangName: triggerAction
    attribute: 9
    name: Trigger Action
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    help {
        helpText:
            ```
            <h3>Trigger Default IG Action</h3>
            <p>
            You can trigger one of the default IG actions or a custom event.<br />
            To list all available IG actions use this in browser JS console:
            <pre>apex.region('emp').widget().interactiveGrid('getActions').list();</pre>
            <pre>
            Some examples:
            show-download-dialog
            show-sort-dialog
            show-filter-dialog
            </pre>
            Replace <i>emp</i> with Static ID of your IG region.
            </p>
            <p>
            <h3>Trigger Custom Action</h3>
            If action doesn't exists in default IG action list it will trigger a custom event Dynamic Action on Interactive Grid region defined in Affected Elements property. Name of custom event is defined with this property.<br />
            To handle it with Dynamic Action:<br />
            <ol>
              <li>Create Dynamic Action that triggers on event Custom</li>
              <li>In Custom Event property put the value of this attribute</li>
              <li>For Selection Type choose Region</li>
              <li>In Region property choose IG Region</li>
            </ol>
            <h4>Example</h4>
            <pre>
            Event: Custom
            Custom Event: my-custom-action
            Selection Type: Region
            Region: Emp
            </pre>
            </p>
            ```
    }
)

customAttribute attribute_10 (
    apexlangName: disabled
    attribute: 10
    name: Disabled
    type: yesNo
    appearance {
        sequence: 100
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText:
            ```
            Disable button on load. <br />
            This property can be used to disable default IG actions. To do this just set name of default IG action in Action property.
            ```
    }
)

customAttribute attribute_11 (
    apexlangName: hidden
    attribute: 11
    name: Hidden
    type: yesNo
    appearance {
        sequence: 110
    }
    builder {
        common: false
        showInWizard: false
    }
    help {
        helpText:
            ```
            Hide button on load. <br />
            This property can be used to hide default IG actions. To do this just set name of default IG action in Action property.
            ```
    }
)

