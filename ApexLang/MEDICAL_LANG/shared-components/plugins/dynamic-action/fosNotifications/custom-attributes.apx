customAttribute attribute_01 (
    apexlangName: position
    attribute: 1
    name: Position
    scope: app
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: top-right
    }
    help {
        helpText: <p>Select the default position you would like your notifications to be displayed at. You can override this setting if needed within the notification dynamic action.</p>
    }

    entry bottomCenter (
        sequence: 50
        display: Bottom Center
        return: bottom-center
        help {
            helpText: <p>The message is shown centered at the bottom of the browser window</p>
        }
    )

    entry bottomLeft (
        sequence: 60
        display: Bottom Left
        return: bottom-left
        help {
            helpText: <p>The message is shown in the bottom left corner of the browser window</p>
        }
    )

    entry bottomRight (
        sequence: 40
        display: Bottom Right
        return: bottom-right
        help {
            helpText: <p>The message is shown in the bottom right corner of the browser window</p>
        }
    )

    entry topCenter (
        sequence: 20
        display: Top Center
        return: top-center
        help {
            helpText: <p>The message is shown centered in the top of the browser window</p>
        }
    )

    entry topLeft (
        sequence: 30
        display: Top Left
        return: top-left
        help {
            helpText: <p>The message is shown in the top left corner of the browser window</p>
        }
        advanced {
            quickPick: true
        }
    )

    entry topRight (
        sequence: 10
        display: Top Right
        return: top-right
        help {
            helpText: <p>The message is shown in the top right corner of the browser window</p>
        }
        advanced {
            quickPick: true
        }
    )

)

customAttribute attribute_01 (
    apexlangName: action
    attribute: 1
    name: Action
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: success
    }
    help {
        helpText:
            ```
            <p>Select the type of action to execute. You can show a notification, whereby: each type has a specific default colour assigned e.g.</p>
            <ul>
            <li>Success -&gt; Green</li>
            <li>Info -&gt; Blue</li>
            <li>Warning -&gt; Orange</li>
            <li>Error -&gt; Red</li>
            </ul><div><b>Note:</b> these colours can be changed using the themeroller (extra setup required) or using CSS overrides. Please refer to the demo application for more details.</div>
            <p>You can also choose to clear all notifications, or convert the native APEX notifications to FOS notifications.</p>
            ```
    }

    entry clearAllNotifications (
        sequence: 50
        display: Clear All Notifications
        return: clear-all
        help {
            helpText: <p>Clear all notifications on the page, including error notifications associated with page items.</p>
        }
    )

    entry convertNativeApexNotifications (
        sequence: 60
        display: Convert Native APEX Notifications
        return: convert
        help {
            helpText:
                ```
                <p>Replace the native APEX notifications with their FOS counterparts. This allows notifications generated by APEX, or via the <code>apex.message</code> API to benefit from the same FOS Notifications enhancements such as autodismiss, click to dismiss, custom positions, etc.</p>
                <p>It is best to instantiate this plug-in with this option once, on the global page, on page load.</p>
                <p>This will convert all APEX notifications, application wide, to FOS notifications.</p>
                ```
        }
    )

    entry showError (
        sequence: 40
        display: Show Error
        return: error
        help {
            helpText: <p>Use this option in the case you want to indicate an error occurred e.g. you cannot delete a record. By default it will show a red message with an exclamation bade icon.</p><p><b>Note:</b>&nbsp;we have provided themeroller support for you to be able to change the background &amp; text colour of the message.</p>
        }
    )

    entry showInfo (
        sequence: 20
        display: Show Info
        return: info
        help {
            helpText: <p>Use this option in the case you want to show some sort of informational message e.g. giving the user an informational tip. By default it will show a blue message with an information comment bubble icon.</p><p><b>Note:</b> we have provided themeroller support for you to be able to change the background &amp; text colour of the message.</p>
        }
    )

    entry showSuccess (
        sequence: 10
        display: Show Success
        return: success
        help {
            helpText: <p>Use this option in the case you want to indicate something was successful e.g. record created. By default it will show a green message with a tick icon.</p><p><b>Note:</b>&nbsp;we have provided themeroller support for you to be able to change the background &amp; text colour of the message.<br></p>
        }
    )

    entry showWarning (
        sequence: 30
        display: Show Warning
        return: warning
        help {
            helpText: <p>Use this option in the case you want to indicate something the user shouldn't do e.g. navigate away when changes aren't saved. By default it will show an orange message with a warning triangle icon.</p><p><b>Note:</b>&nbsp;we have provided themeroller support for you to be able to change the background &amp; text colour of the message.</p>
        }
    )

)

customAttribute attribute_02 (
    apexlangName: iconSuccess
    attribute: 2
    name: Icon Success
    scope: app
    type: icon
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: fa-check-circle
    }
    help {
        helpText:
            ```
            <p>This setting defines the icon shown in the success notification. Please provide the font-apex icon CSS Class e.g. </p>
            <code>
            fa-check-circle
            </code>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: messageType
    attribute: 2
    name: Message Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: static
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: notInList
        list: [
            clear-all
            convert
        ]
    }
    help {
        helpText: <p>Select the message type. You can choose a static message that supports client side page item substitutions i.e. &amp;ITEM_NAME. or alternatively for full control you can derive both the title and message from a Javascript expression or Function.</p>
    }

    entry javascriptExpression (
        sequence: 20
        display: Javascript Expression
        return: javascript-expression
        help {
            helpText: You can define the title &amp; message using a Javascript expression e.g. if you wanted more programatic control for your notification contents e.g. including the current timestamp in the notification.
        }
    )

    entry javascriptFunction (
        sequence: 30
        display: Javascript Function
        return: javascript-function-body
        help {
            helpText: You can define the title &amp; message using a Javascript function e.g. if you wanted more programatic control for your notification contents e.g. including the current timestamp in the notification.
        }
    )

    entry staticText (
        sequence: 10
        display: Static Text
        return: static
        help {
            helpText: You can define notifications with static text with page item substitutions
        }
    )

)

customAttribute attribute_03 (
    apexlangName: iconInfo
    attribute: 3
    name: Icon Info
    scope: app
    type: icon
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: fa-info-circle
    }
    help {
        helpText:
            ```
            <p>This setting defines the icon shown in the info notification. Please provide the font-apex icon CSS Class e.g. </p>
            <code>
            fa-info-circle
            </code>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: title
    attribute: 3
    name: Title
    appearance {
        sequence: 30
    }
    builder {
        translatable: true
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: =
        value: static
    }
    help {
        helpText: <p>Enter the text you would like to display in the notification title. You can leave this setting blank if you do not want to include a title. You can use substitution strings in the title.&nbsp;</p><p><b>Note:</b> you have the ability in the "Extra Options" attribute to determine if these substitution occur at the time of page render (server-side) or at the time of execution in the browser (client-side)</p>
    }
)

customAttribute attribute_04 (
    apexlangName: iconWarning
    attribute: 4
    name: Icon Warning
    scope: app
    type: icon
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    default {
        value: fa-exclamation-triangle
    }
    help {
        helpText:
            ```
            <p>This setting defines the icon shown in the warning notification. Please provide the font-apex icon CSS Class e.g. </p>
            <code>
            fa-exclamation-triangle
            </code>
            ```
    }
)

customAttribute attribute_04 (
    apexlangName: message
    attribute: 4
    name: Message
    type: textarea
    appearance {
        sequence: 40
    }
    builder {
        translatable: true
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: =
        value: static
    }
    help {
        helpText: <p>The notification message you wish to display. You can use substitution strings in the message.&nbsp;</p><p><b>Note:</b>&nbsp;if you use a single substitution string for the message and when it is substituted it is blank/null then the notification will not be shown, even if you have a title defined. You could say that this is a method to make the notification conditional.</p><p>Also you have the ability in the "Extra Options" attribute to determine if these substitution occur at the time of page render (server-side) or at the time of execution in the browser (client-side)<br></p>
    }
)

customAttribute attribute_05 (
    apexlangName: iconError
    attribute: 5
    name: Icon Error
