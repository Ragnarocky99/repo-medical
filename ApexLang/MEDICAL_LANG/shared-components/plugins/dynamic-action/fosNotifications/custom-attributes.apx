    apexlangName: autodismissAfter
    attribute: 7
    name: Autodismiss After
    scope: app
    type: integer
    appearance {
        sequence: 110
    }
    builder {
        unit: seconds
    }
    help {
        helpText: <p>Enter the number of seconds to display the notification before it is automatically removed.</p>
    }
)

