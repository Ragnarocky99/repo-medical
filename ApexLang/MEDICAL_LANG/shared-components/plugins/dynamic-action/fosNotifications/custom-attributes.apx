)

customAttribute attribute_05 (
    apexlangName: title2
    attribute: 5
    name: Title
    type: javaScriptCode
    appearance {
        sequence: 50
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: !=
        value: static
    }
    help {
        helpText: <p>Enter the javascript expression/function that will return the notification title.</p>
    }
)

customAttribute attribute_06 (
    apexlangName: options
    attribute: 6
    name: Options
    scope: app
    type: checkboxes
    appearance {
        sequence: 60
    }
    default {
        value: escape-html:newest-on-top:client-side-substitutions:dismiss-on-click:dismiss-on-button
    }
    help {
        helpText: <p>Choose extra options/settings to apply to your notification</p>
    }

    entry autodismissErrorNotifications (
        sequence: 40
        display: Autodismiss Error Notifications
        return: autodismiss-error
        help {
            helpText: <p>Whether to autodismiss error notifications after a specific amount of time. Enabling this option will also add a visual timer below the notification. When the timer runs out, the notification is removed. If the user hovers over the notification, the timer will be stopped and removed. The user has to then manually dismiss the notification.</p>
        }
    )

    entry autodismissInfoNotifications (
        sequence: 20
        display: Autodismiss Info Notifications
        return: autodismiss-info
        help {
            helpText: <p>Whether to autodismiss info notifications after a specific amount of time. Enabling this option will also add a visual timer below the notification. When the timer runs out, the notification is removed. If the user hovers over the notification, the timer will be stopped and removed. The user has to then manually dismiss the notification.</p>
        }
    )

    entry autodismissSuccessNotifications (
        sequence: 10
        display: Autodismiss Success Notifications
        return: autodismiss-success
        help {
            helpText: <p>Whether to autodismiss success notifications after a specific amount of time. Enabling this option will also add a visual timer below the notification. When the timer runs out, the notification is removed. If the user hovers over the notification, the timer will be stopped and removed. The user has to then manually dismiss the notification.</p>
        }
    )

    entry autodismissWarningNotifications (
        sequence: 30
        display: Autodismiss Warning Notifications
        return: autodismiss-warning
        help {
            helpText: <p>Whether to autodismiss warning notifications after a specific amount of time. Enabling this option will also add a visual timer below the notification. When the timer runs out, the notification is removed. If the user hovers over the notification, the timer will be stopped and removed. The user has to then manually dismiss the notification.</p>
        }
    )

    entry dismissOnCloseButtonClick (
        sequence: 110
        display: Dismiss On Close Button Click
        return: dismiss-on-button
        help {
            helpText: <p>Whether to render an X button that dismisses the notification.</p>
        }
    )

    entry dismissOnNotificationClickTap (
        sequence: 100
        display: Dismiss On Notification Click/Tap
        return: dismiss-on-click
        help {
            helpText: <p>Whether the notification is dismissed on click or tap.</p>
        }
    )

    entry escapeHtml (
        sequence: 70
        display: Escape HTML
        return: escape-html
        help {
            helpText: <p>Check this option to escape any HTML in the text to ensure tighter security.</p>
        }
    )

    entry externalReplaceApexErrorsWithFosWarnings (
        sequence: 120
        display: "[External] Replace APEX Errors with FOS Warnings"
        return: show-errors-as-warnings
        help {
            helpText: This attribute is not yet in use
        }
    )

    entry newestOnTop (
        sequence: 80
        display: Newest On Top
        return: newest-on-top
        help {
            helpText: <p>Check this option to show all new messages at the top, when existing messages are still being displayed. If you leave this unchecked they will be shown at the bottom.</p>
        }
    )

    entry performClientSideSubstitutions (
        sequence: 90
        display: Perform Client-side Substitutions
        return: client-side-substitutions
        help {
            helpText: <p>Check this option to perform page item substitutions in the browser at the time of execution of the notification.</p><p><b>Note: </b>when using this setting the page items you reference in the title/message must be from this page or defined on page zero</p>
        }
    )

    entry preventDuplicates (
        sequence: 50
        display: Prevent Duplicates
        return: prevent-duplicates
        help {
            helpText: <p>Ensures the notification will not be shown if it has the same title and message as the previous notification.</p>
        }
    )

)

