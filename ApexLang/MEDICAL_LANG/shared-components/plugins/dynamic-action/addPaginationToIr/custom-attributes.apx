customAttribute attribute_01 (
    apexlangName: labelOfTotalNumbers
    attribute: 1
    name: Label of total numbers
    appearance {
        sequence: 10
    }
    default {
        value: Total number of rows:
    }
)

customAttribute attribute_02 (
    apexlangName: titleOfFirstPage
    attribute: 2
    name: Title of first page
    appearance {
        sequence: 20
    }
    default {
        value: First page
    }
)

customAttribute attribute_03 (
    apexlangName: titleOfLastPage
    attribute: 3
    name: Title of last page
    appearance {
        sequence: 30
    }
    default {
        value: Last page
    }
)

