customAttribute attribute_01 (
    apexlangName: action
    attribute: 1
    name: Action
    type: selectList
    appearance {
        sequence: 10
    }
    default {
        value: add-clear-item-button
    }
    help {
        helpText: <p>The action to be performed.</p>
    }

    entry addClearItemButtonS (
        sequence: 10
        display: Add Clear Item Button(s)
        return: add-clear-item-button
        help {
            helpText: <p>This action dynamically appends a "Clear Item" button with an "X" symbol to the items provided in the Page Item(s) attribute, or all Popup LOV instances if no items are provided. It is recommended to only use this plug-in once, on page load, on the global page, and leave the Page Item(s) attribute empty. This way, all Popup LOV-s, in the entire application will be affected, having only instantiated this plug-in once.</p>
        }
    )

    entry initializeApi (
        sequence: 20
        display: Initialize API
        return: initialize-api
        help {
            helpText:
                ```
                <p>This action initialized an API which can be used in JavaScript to have greater control over the Popup LOV. Run this action on page load and provide the affected Popup LOVs in the Page Item(s) attribute.</p>
                <p>You will then have access to the following function:</p>
                <pre>FOS.utils.popupLOV.item(itemName).setValueByReturn(newValue)</pre>
                <p>This function sets the value provided, but displays the associated display value. If the Popup LOV includes additional outputs, these will be set as well. You can use this function anywhere in a JavaScript context.</p>
                ```
        }
    )

)

customAttribute attribute_02 (
    apexlangName: pageItemS
    attribute: 2
    name: Page Item(s)
    type: pageItems
    appearance {
        sequence: 20
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: inList
        list: [
            add-clear-item-button
            initialize-api
        ]
    }
    help {
        helpText:
            ```
            <p>List of the affected Popup LOV items.<br>
            If the <strong>Action</strong> is set to <strong>Initialize API</strong>, then it <strong>must contain a value</strong>.
            </p>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: deleteIcon
    attribute: 3
    name: Delete Icon
    type: icon
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: fa-times
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: add-clear-item-button
    }
    help {
        helpText: The icon to be displayed in the <i>Clear Button</i>.
    }
)

