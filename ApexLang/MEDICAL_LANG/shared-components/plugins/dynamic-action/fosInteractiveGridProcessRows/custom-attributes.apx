customAttribute attribute_01 (
    apexlangName: action
    attribute: 1
    name: Action
    type: selectList
    appearance {
        sequence: 10
    }
    default {
        value: selection
    }
    help {
        helpText: <p>The type of action to perform.</p>
    }

    entry processFilteredRows (
        sequence: 20
        display: Process Filtered Rows
        return: filtered
        help {
            helpText:
                ```
                <p>Process all filtered rows.</p>
                <p>Note that this refers to all filtered rows, meaning also the ones which have perhaps not been loaded into the page yet, due to pagination.</p>
                ```
        }
    )

    entry processSelectedRows (
        sequence: 10
        display: Process Selected Rows
        return: selection
        help {
            helpText: <p>Process all rows which have been selected by the user</p>
        }
    )

)

customAttribute attribute_02 (
    apexlangName: plSqlCode
    attribute: 2
    name: PL/SQL Code
    type: plsqlCode
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    help {
        helpText: <p>The PL/SQL code block to execute for each row.</p>
    }
    examples {
        examples:
            ```
            <pre>update emp
               set sal = sal + 100
             where id = :ID;
            <pre>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: itemsToSubmit
    attribute: 3
    name: Items to Submit
    type: pageItems
    appearance {
        sequence: 30
    }
    help {
        helpText: <p>Enter the page items to be set into session state when the process is initiated.</p>
    }
)

customAttribute attribute_04 (
    apexlangName: itemsToReturn
    attribute: 4
    name: Items to Return
    type: pageItems
    appearance {
        sequence: 40
    }
    help {
        helpText: <p>Enter the page items to be returned from the server when the process is complete.</p>
    }
)

customAttribute attribute_05 (
    apexlangName: successMessage
    attribute: 5
    name: Success Message
    appearance {
        sequence: 50
    }
    help {
        helpText:
            ```
            <p>Provide a success message which will be displayed as a success notification if the execution is completed successfully.</p>
            <p>This message can be dynamically overridden in the PL/SQL Code block by assigning the new value to the apex_application.g_x01 global variable.</p>
            <p>If no success message is provided, the success notification will not be shown.</p>
            ```
    }
)

customAttribute attribute_06 (
    apexlangName: errorMessage
    attribute: 6
    name: Error Message
    appearance {
        sequence: 60
    }
    default {
        value: #SQLERRM#
    }
    help {
        helpText:
            ```
            <p>Provide an error message which will be displayed as an error notification if the execution raises an unhandled exception.</p>
            <p>This message can be dynamically overridden in the PL/SQL Code block by assigning a new error message to the apex_application.g_x02 global variable.</p>
            <p>If no error message is provided, the error notification will not be shown.</p>
            <p>You can also use the #SQLCODE#, #SQLERRM# and #SQLERRM_TEXT# substitution strings for more detailed error information.</p>
            ```
    }
)

customAttribute attribute_15 (
    apexlangName: extraOptions
    attribute: 15
    name: Extra Options
    type: checkboxes
    appearance {
        sequence: 150
    }
    default {
        value: escape-message
    }
    help {
        helpText: <p>Extra plug-in options.</p>
    }

    entry escapeSpecialCharactersInMessages (
        sequence: 40
        display: Escape Special Characters in Messages
        return: escape-message
        help {
            helpText: <p>Enable this option to escape any HTML tags in the success or error message. This should remain turned on by default to avoid any possibility of a cross-site-scripting attack. If however you do need to display HTML in a notification, you can turn this setting off, but escape individual page items via the <code>&P1_ITEM!HTML.</code> syntax.</p>
        }
    )

    entry refreshGridAfterProcessing (
        sequence: 20
        display: Refresh Grid After Processing
        return: refresh-grid
        help {
            helpText: <p>Refresh entire grid after processing.</p>
        }
    )

    entry refreshSelectionAfterProcessing (
        sequence: 10
        display: Refresh Selection After Processing
        return: refresh-selection
        help {
            helpText: <p>Refresh selected rows after processing.</p>
        }
    )

    entry removeSelectionAfterProcessing (
        sequence: 50
        display: Remove Selection After Processing
        return: remove-selection-after-process
        help {
            helpText: <p>Deselect every row in the Interactive Grid after the process successfully executed.</p>
        }
    )

    entry replaceMessageSubstitutionsClientSide (
        sequence: 30
        display: Replace Message Substitutions Client-side
        return: client-substitutions
        help {
            helpText:
                ```
                <p>By default, item substitutions in success and error messages will be performed server-side, with session-state values, right after the processing has finished in the AJAX call.</p>
                <p>This option enables you to override this, and perform the substitutions on the client, after the AJAX response has arrived, but before the notification is shown.</p>
                
                <p>Server-side substitutions are usually the desired method, as they are sure to use the latest session-state values, but can also replace application items, which the client does not have access to. Client-side substitutions are desired when substituting for an item whose value exists on the client, but has not yet propagated to session-state.</p>
                ```
        }
    )

)

