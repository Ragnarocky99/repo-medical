customAttribute attribute_14 (
    apexlangName: escapeSpecialCharacters
    attribute: 14
    name: Escape Special Characters
    type: yesNo
    appearance {
        sequence: 140
    }
    default {
        value: true
    }
    help {
        helpText: <p>To prevent Cross-Site Scripting (XSS) attacks, always set this attribute to <strong>Yes</strong>. If you need to render HTML tags stored in the page item or in the entries of a list of values, you can set this flag to No. In such cases, you should take additional precautions to ensure any user input to such fields are properly escaped when entered and before saving.</p>
    }
)

customAttribute attribute_15 (
    apexlangName: enableSearchHistory
    attribute: 15
    name: Enable Search History
    type: yesNo
    appearance {
        sequence: 135
    }
    help {
        helpText:
            ```
            <p>Enable search history to show a popover (on mouse hover of main search icon next to spotlight input field) which contains the last 20 search terms of the user.</p>
            <p>It uses browsers local storage to store the entered search terms.</p>
            ```
    }
)

