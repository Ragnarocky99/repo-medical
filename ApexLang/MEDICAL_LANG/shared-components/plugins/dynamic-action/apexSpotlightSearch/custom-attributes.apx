customAttribute attribute_01 (
    apexlangName: searchPlaceholderText
    attribute: 1
    name: Search Placeholder Text
    scope: app
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    builder {
        translatable: true
    }
    default {
        value: Search
    }
    help {
        helpText: <p>Text that is displayed in the spotlight search input field as an placeholder</p>
    }
)

customAttribute attribute_01 (
    apexlangName: enableKeyboardShortcuts
    attribute: 1
    name: Enable Keyboard Shortcuts
    type: yesNo
    appearance {
        sequence: 10
    }
    help {
        helpText: <p>Enables you to add custom keyboard shortcuts to open spotlight search</p>
    }
)

customAttribute attribute_02 (
    apexlangName: moreCharactersText
    attribute: 2
    name: More Characters Text
    scope: app
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    builder {
        translatable: true
    }
    default {
        value: Please enter at least two letters to search
    }
    help {
        helpText: <p>Text that is displayed when not enough characters are entered to activate search feature</p>
    }
)

customAttribute attribute_02 (
    apexlangName: keyboardShortcuts
    attribute: 2
    name: Keyboard Shortcuts
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: ctrl+k,command+k
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: Y
    }
    help {
        helpText:
            ```
            <p>You can specify multiple keyboard shortcuts, just separate the different shortcuts by a comma!</p>
            <p>In the background a JavaScript library called "Mousetrap" is handling all keyboard shortcut things, if you will learn more about possible shortcuts or want to read some docs, just visit their site: https://craig.is/killing/mice</p>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: noMatchFoundText
