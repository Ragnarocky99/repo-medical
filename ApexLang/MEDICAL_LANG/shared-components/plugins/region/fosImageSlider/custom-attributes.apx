customAttribute attribute_01 (
    apexlangName: sourceType
    attribute: 1
    name: Source Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: url
    }
    help {
        helpText: <p>Set the type of the image source column.</p>
    }

    entry blob (
        sequence: 20
        display: BLOB
        return: blob
        help {
            helpText: The images will be loaded from a BLOB column.
        }
    )

    entry url (
        sequence: 10
        display: URL
        return: url
        help {
            helpText: The images will be loaded using the provided URL.
        }
    )

)

customAttribute attribute_02 (
    apexlangName: primaryKey
    attribute: 2
    name: Primary Key
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    supports {
        dataTypes: [
            varchar2
            number
        ]
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: blob
    }
    help {
        helpText: <p>The column which stores the Primary Key values.</p>
    }
)

customAttribute attribute_03 (
    apexlangName: blobColumn
    attribute: 3
    name: BLOB Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    supports {
        dataTypes: blob
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: blob
    }
    help {
        helpText: <p>The column with the BLOB value.</p>
    }
)

customAttribute attribute_04 (
    apexlangName: mimeType
    attribute: 4
    name: MIME Type
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 40
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: blob
    }
    help {
        helpText: <p>The column which stores the MIME Type.</p>
    }
)

customAttribute attribute_05 (
    apexlangName: fileName
    attribute: 5
    name: File Name
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: blob
    }
    help {
        helpText: <p>The column which stores the filename.</p>
    }
)

customAttribute attribute_06 (
    apexlangName: urlColumn
    attribute: 6
    name: URL Column
    type: regionSqlQueryColumn
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: =
        value: url
    }
    help {
        helpText: The name of the column where the URL's of the images are stored.
    }
)

customAttribute attribute_07 (
    apexlangName: direction
    attribute: 7
    name: Direction
    type: selectList
    appearance {
        sequence: 70
    }
    default {
        value: horizontal
    }
    help {
        helpText: The direction of transition of the slides. The positions of the navigation buttons (if enabled) will be adjusted based on the direction.
    }

    entry horizontal (
        sequence: 10
        display: Horizontal
        return: horizontal
        help {
            helpText: The content can be scrolled sideways, to the left or to the right.
        }
    )

    entry vertical (
        sequence: 20
        display: Vertical
        return: vertical
        help {
            helpText: The content can be scrolled up or down.
        }
    )

)

customAttribute attribute_08 (
    apexlangName: imageSize
    attribute: 8
    name: Image Size
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 80
    }
    default {
        value: cover
    }
    help {
        helpText: Sets the size of the images.
    }

    entry contain (
        sequence: 20
        display: Contain
        return: contain
        help {
            helpText: Fits the complete image into the slide, preserving the aspect-ratio of the image. This may cause blank space next to or above and below the image.
        }
    )

    entry cover (
        sequence: 10
        display: Cover
        return: cover
        help {
            helpText: Stretches the image to fully fill all the available space of the slide, i.e. it won't leave any blank space. This setting may cause the images to be partially "cut-off" due to different aspect-ratios.
        }
    )

    entry custom (
        sequence: 30
        display: Custom
        return: custom
        help {
            helpText: The width of the image will be scaled to the provided percentage (height will be adjusted proportionally) and centered in the slide.
        }
    )

)

customAttribute attribute_09 (
    apexlangName: imageScale
    attribute: 9
    name: Image Scale
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    builder {
        unit: %
    }
    default {
        value: 100
    }
    dependingOn {
        attribute: @attribute_08/component
        conditionType: =
        value: custom
    }
    help {
        helpText: The width of the displayed images in percent relative to its container (slide). The height becomes 'auto'.
    }
)

customAttribute attribute_10 (
    apexlangName: options
    attribute: 10
    name: Options
    type: checkboxes
    appearance {
        sequence: 100
    }
    help {
        helpText: A list of options you can apply on the region.
    }

    entry autoplay (
        sequence: 20
        display: Autoplay
        return: autoplay
        help {
            helpText: Automatically changes slides in regular intervals.
        }
    )

    entry descriptionBox (
        sequence: 30
        display: Description Box
        return: description-box
        help {
            helpText: Displays a content box for each slide to display additional textual information.
        }
    )

    entry displayThumbnails (
        sequence: 60
        display: Display Thumbnails
        return: display-thumbnails
        help {
            helpText: Displays thumbnails of the images under the main slider.
        }
    )

    entry fullscreenSupport (
        sequence: 70
        display: Fullscreen Support
        return: fullscreen-support
        help {
            helpText: Shows a button in the corner of the slider which switches the slider to or off fullscreen mode.
        }
    )

    entry loop (
        sequence: 50
        display: Loop
        return: loop
        help {
            helpText: Loops the slides of the slider, i.e. after the last slide the first one transitions in and vice-versa.
        }
    )

    entry navigation (
        sequence: 40
        display: Navigation
        return: navigation
        help {
            helpText: Displays previous and next buttons on the sides (for horizontal) or on the top and bottom (for vertical) of the slider.
        }
    )

    entry navigationHideOnClick (
        sequence: 80
        display: Navigation Hide On Click
        return: navigation-hide-on-click
        help {
            helpText: Hides/shows the navigation buttons when clicking on the container.
        }
    )

    entry pagination (
        sequence: 10
        display: Pagination
        return: pagination
        help {
            helpText: Displays a clickable bullet for every slide at the bottom of the slider. The active slide's bullet is highlighted.
        }
    )

    entry paginationHideOnClick (
        sequence: 90
        display: Pagination Hide On Click
        return: pagination-hide-on-click
        help {
            helpText: Hides/shows the pagination when clicking on the container.
        }
    )

)

customAttribute attribute_11 (
    apexlangName: autoplayInterval
    attribute: 11
    name: Autoplay Interval
    type: number
    appearance {
        sequence: 110
    }
    builder {
        unit: second(s)
    }
    default {
        value: 10
    }
    dependingOn {
        attribute: @attribute_10/component
        conditionType: inList
        list: autoplay
    }
    help {
        helpText: The number of seconds between slide changes.
    }
)

customAttribute attribute_12 (
    apexlangName: imagesPerView
    attribute: 12
    name: Images per View
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    default {
        value: 1
    }
    help {
        helpText: The number of images displayed in the visible area (slides visible at the same time on slider's container).
    }
)

customAttribute attribute_13 (
    apexlangName: transition
    attribute: 13
    name: Transition
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 130
    }
    default {
        value: slide
    }
    dependingOn {
        attribute: @attribute_12/component
        conditionType: =
        value: 1
    }
    help {
        helpText:
            ```
            The transition animation of the slide changes.<br>
            <br>
            If you have 1 image per slide: <i>slide</i>, <i>flip</i>, <i>cube</i> and <i>coverflow</i> are supported.<br>
            If you have 2 or more images per slide: <i>slide</i> and <i>coverflow</i> are supported.
            ```
    }

    entry coverflow (
        sequence: 10
        display: Coverflow
        return: coverflow
        help {
            helpText: The transition of the slides happens with a <i>Coverflow</i> effect.
        }
    )

    entry cube (
        sequence: 20
        display: Cube
        return: cube
        help {
            helpText: The transition of the slides happens with a <i>Cube</i> effect.
        }
    )

    entry flip (
        sequence: 30
        display: Flip
        return: flip
        help {
            helpText: The transition of the slides happens with a <i>Flip</i> effect.
        }
    )

    entry slide (
        sequence: 40
        display: Slide
        return: slide
        help {
            helpText: The transition of the slides happens with a <i>Slide</i> effect.
        }
    )

)

customAttribute attribute_14 (
    apexlangName: transition2
    attribute: 14
    name: Transition
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 140
    }
    default {
        value: slide
    }
    dependingOn {
        attribute: @attribute_12/component
        conditionType: !=
        value: 1
    }
    help {
        helpText:
            ```
            The transition animation of the slide changes.<br>
            <br>
            If you have 1 image per slide: <i>slide</i>, <i>flip</i>, <i>cube</i> and <i>coverflow</i> are supported.<br>
            If you have 2 or more images per slide: <i>slide</i> and <i>coverflow</i> are supported.
            ```
    }

    entry coverflow (
        sequence: 20
        display: Coverflow
        return: coverflow
        help {
            helpText: The transition of the slides happens with a <i>Coverflow<i> effect.
        }
    )

    entry slide (
        sequence: 10
        display: Slide
        return: slide
        help {
            helpText: The transition of the slides happens with a <i>Slide<i> effect.
        }
    )

)

