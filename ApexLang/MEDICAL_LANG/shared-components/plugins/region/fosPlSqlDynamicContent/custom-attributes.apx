customAttribute attribute_01 (
    apexlangName: plSqlCode
    attribute: 1
    name: PL/SQL Code
    type: plsqlCode
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText:
            ```
            <p>Enter the PL/SQL code to generate the HTML output.</p>
            <p>You can reference other page or application items from within your application using bind syntax (for example <code>:P1_MY_ITEM</code>). Any items referenced also need to be included in <strong>Page Items to Submit</strong>.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: itemsToSubmit
    attribute: 2
    name: Items to Submit
    type: pageItems
    appearance {
        sequence: 20
    }
    help {
        helpText: <p>The page items submitted to the server during a refresh, and therefore, available for use within your PL/SQL Code.</p><p>You can type in the item name or pick from the list of available items. If you pick from the list and there is already text entered then a comma is placed at the end of the existing text, followed by the item name returned from the list.<br></p>
    }
)

customAttribute attribute_03 (
    apexlangName: itemsToReturn
    attribute: 3
    name: Items to Return
    type: pageItems
    appearance {
        sequence: 30
    }
    help {
        helpText: <p>The page items you wish to return to the client after the refresh process, with their current session state.</p><p>Enter the uppercase page items set you wish to return to the client after the refresh process, based on their current value in session state. If your <strong>PL/SQL Code</strong> sets one or more page item values in session state you need to define those items in this attribute.</p><p>You can type in the item name or pick from the list of available items. If you pick from the list and there is already text entered then a comma is placed at the end of the existing text, followed by the item name returned from the list.</p>
    }
)

customAttribute attribute_04 (
    apexlangName: suppressChangeEvent
    attribute: 4
    name: Suppress Change Event
    type: yesNo
    appearance {
        sequence: 40
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: isNotNull
    }
    help {
        helpText: <p>Specify whether the change event is suppressed on the items specified in <b>Page Items to Return</b>. This prevents subsequent Change based Dynamic Actions from firing, for these items.</p>
    }
)

customAttribute attribute_05 (
    apexlangName: showSpinner
    attribute: 5
    name: Show Spinner
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: N
    }
    help {
        helpText:
            ```
            <p>Show a spinner while the refresh request is taking place.</p>
            <p>Note that the spinner will not be shown if the request returns very quickly, in order to avoid flickering.</p>
            ```
    }

    entry no (
        sequence: 10
        display: No
        return: N
        help {
            helpText: <p>Do not show a spinner.</p>
        }
    )

    entry onPage (
        sequence: 40
        display: On Page
        return: ON_PAGE
        help {
            helpText: <p>Show a spinner centered on the whole page.</p>
        }
    )

    entry onPageWithOverlay (
        sequence: 50
        display: On Page with Overlay
        return: ON_PAGE_WITH_OVERLAY
        help {
            helpText: <p>Adds a translucent overlay on the whole page which prohibits mouse inputs, and shows a spinner on top of that overlay.</p>
        }
    )

    entry onRegion (
        sequence: 20
        display: On Region
        return: ON_REGION
        help {
            helpText: <p>Show the spinner on the region.</p>
        }
    )

    entry onRegionWithOverlay (
        sequence: 30
        display: On Region with Overlay
        return: ON_REGION_WITH_OVERLAY
        help {
            helpText: <p>Adds a translucent overlay on the region which prohibits mouse inputs, and shows a spinner on top of that overlay.</p>
        }
    )

)

customAttribute attribute_11 (
    apexlangName: lazyLoad
    attribute: 11
    name: Lazy Load
    type: yesNo
    appearance {
        sequence: 110
    }
    help {
        helpText: <p>Only load the region when it is visible to the user i.e. shown/expanded etc.</p>
    }
)

customAttribute attribute_12 (
    apexlangName: lazyRefresh
    attribute: 12
    name: Lazy Refresh
    type: yesNo
    appearance {
        sequence: 120
    }
    dependingOn {
        attribute: @attribute_11/component
        conditionType: =
        value: Y
    }
    help {
        helpText: <p>Enable this option to lazily refresh the region i.e. only when it is visible.</p>
    }
)

customAttribute attribute_14 (
    apexlangName: outputMethod
    attribute: 14
    name: Output Method
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 0
    }
    default {
        value: htp
    }
    help {
        helpText:
            ```
            <p>Choose the output method used in the code.</p>
            <p>The plug-in needs to know from where to fetch the content in case of a refresh.</p>
            <p>Please do not mix and match. Either use one or the other.</p>
            <p>If you also chose option "Sanitize Output", the method <code>apex_application.g_clob_01</code> is required.</p>
            ```
    }

    entry assignmentToApexApplicationGClob01 (
        sequence: 20
        display: Assignment to apex_application.g_clob_01
        return: clob
        help {
            helpText: <p>The content should be assigned to the global variable <code>APEX_APPLICATION.g_clob_01</code></p>
        }
    )

    entry directOutputViaHtpP (
        sequence: 10
        display: Direct output via htp.p
        return: htp
        help {
            helpText: <p>The HTP buffer via calls such as <code>htp.p</code></p>
        }
    )

)

customAttribute attribute_15 (
    apexlangName: extraOptions
    attribute: 15
    name: Extra Options
    type: checkboxes
    appearance {
        sequence: 150
    }
    default {
        value: substitute-values
    }
    help {
        helpText: Extra plug-in options.
    }

    entry sanitizeContent (
        sequence: 20
        display: Sanitize Content
        return: sanitize-content
        help {
            helpText:
                ```
                <p>Sanitize the content via the DOMPurify JavaScript library. This allows you to output valid HTML, while stripping away any possible Cross-Site-Scripting content.</p>
                <p>The sanitization happens on page load, as well as after each subsequent region refresh.</p>
                <p>The sanitization happens client-side which means you might notice a quick flash on page load, depending on the size of the region content.</p>
                ```
        }
        advanced {
            quickPick: true
        }
    )

    entry substituteValues (
        sequence: 10
        display: Substitute Values
        return: substitute-values
        help {
            helpText: <p>Uncheck this option to skip the substitution of page item values in the PLSQL Code</p>
        }
    )

)

