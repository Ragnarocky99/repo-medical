customAttribute attribute_01 (
    apexlangName: googleApiKey
    attribute: 1
    name: Google API Key
    scope: app
    appearance {
        sequence: 10
    }
    help {
        helpText: Optional. If you don't set this, you may get a "Google Maps API warning: NoApiKeys" warning in the console log. Refer: https://developers.google.com/maps/documentation/javascript/get-api-key#get-an-api-key
    }
)

customAttribute attribute_01 (
    apexlangName: initialMapPosition
    attribute: 1
    name: Initial Map Position
    validation {
        required: true
        maxLength: 100
    }
    appearance {
        sequence: 10
    }
    builder {
        unit: lat,long
    }
    default {
        value: 0,0
    }
    help {
        helpText: Set the latitude and longitude as a pair of numbers to be used to position the map on page load, if no pin coordinates have been provided by the page item.
    }
)

customAttribute attribute_02 (
    apexlangName: initialZoomLevel
    attribute: 2
    name: Initial Zoom Level
    type: integer
    validation {
        required: true
        maxLength: 2
    }
    appearance {
        sequence: 20
    }
    builder {
        unit: (0-23)
    }
    default {
        value: 1
    }
    help {
        helpText: Set the initial map zoom level on page load, to be used if the page item has no coordinates to show.
    }
)

customAttribute attribute_03 (
    apexlangName: minMapHeight
    attribute: 3
    name: Min. Map Height
    type: integer
    validation {
        required: true
        maxLength: 5
    }
    appearance {
        sequence: 30
    }
    builder {
        unit: pixels
    }
    default {
        value: 400
    }
    help {
        helpText: Set the desired height for the map region. Note: the map width will adjust to the maximum available space.
    }
)

customAttribute attribute_04 (
    apexlangName: synchronizeWithItem
    attribute: 4
    name: Synchronize with Item
    type: pageItem
    appearance {
        sequence: 40
    }
    help {
        helpText: Position of the marker will be retrieved from and stored in this item as a Lat,Long value.
    }
)

customAttribute attribute_05 (
    apexlangName: markerZoomLevel
    attribute: 5
    name: Marker Zoom Level
    type: integer
    appearance {
        sequence: 50
    }
    builder {
        unit: (0-23)
    }
    default {
        value: 16
    }
    help {
        helpText: If a marker is set or moved, zoom the map to this level. Leave blank to make the map not zoom when the marker is moved.
    }
)

customAttribute attribute_06 (
    apexlangName: markerIcon
    attribute: 6
    name: Marker Icon
    validation {
        maxLength: 4000
    }
    appearance {
        sequence: 60
    }
    help {
        helpText: URL to the icon to show for the marker. Leave blank for the default red Google pin.
    }
    examples {
        examples:
            ```
            http://maps.google.com/mapfiles/ms/icons/blue-dot.png
            http://maps.google.com/mapfiles/ms/icons/red-dot.png
            http://maps.google.com/mapfiles/ms/icons/purple-dot.png
            http://maps.google.com/mapfiles/ms/icons/yellow-dot.png
            http://maps.google.com/mapfiles/ms/icons/green-dot.png
            http://maps.google.com/mapfiles/ms/icons/ylw-pushpin.png
            http://maps.google.com/mapfiles/ms/icons/blue-pushpin.png
            http://maps.google.com/mapfiles/ms/icons/grn-pushpin.png
            http://maps.google.com/mapfiles/ms/icons/ltblu-pushpin.png
            http://maps.google.com/mapfiles/ms/icons/pink-pushpin.png
            http://maps.google.com/mapfiles/ms/icons/purple-pushpin.png
            http://maps.google.com/mapfiles/ms/icons/red-pushpin.png
            ```
    }
)

customAttribute attribute_07 (
    apexlangName: enableGoogleSignIn
    attribute: 7
    name: Enable Google Sign-In
    type: yesNo
    appearance {
        sequence: 70
    }
    help {
        helpText: Set to Yes to enable Google sign-in on the map. Only works if you set the Google API Key.
    }
)

customAttribute attribute_08 (
    apexlangName: geocodeItem
    attribute: 8
    name: Geocode Item
    type: pageItem
    appearance {
        sequence: 80
    }
    help {
        helpText: Set to a text item on the page. If the text item contains the name of a location or an address, a Google Maps Geocode search will be done and, if found, the map will be moved to that location and a pin shown. NOTE: requires a Google API key to be set at the application level.
    }
)

customAttribute attribute_09 (
    apexlangName: restrictToCountryCode
    attribute: 9
    name: Restrict to Country code
    validation {
        maxLength: 2
        textCase: uppercase
    }
    appearance {
        sequence: 90
    }
    builder {
        displayWidth: 10
    }
    dependingOn {
        attribute: @attribute_08/component
        conditionType: isNotNull
    }
    help {
        helpText: Leave blank to allow geocoding to find any place on earth. Set to country code (see https://developers.google.com/public-data/docs/canonical/countries_csv for valid values) to restrict geocoder to that country.
    }
    examples {
        examples: AU
    }
)

customAttribute attribute_10 (
    apexlangName: mapStyle
    attribute: 10
    name: Map Style
    type: textarea
    appearance {
        sequence: 100
    }
    help {
        helpText:
            ```
            You can generate map styles using this tool: http://gmaps-samples-v3.googlecode.com/svn/trunk/styledmaps/wizard/index.html
            <p>
            Another way is to copy one from a site like https://snazzymaps.com/
            ```
    }
    examples {
        examples:
            ```
            Here is an example, a light greyscale style map:
            <pre>
            [{"featureType":"water","elementType":"geometry","stylers":[{"color":"#e9e9e9"},{"lightness":17}]},{"featureType":"landscape","elementType":"geometry","stylers":[{"color":"#f5f5f5"},{"lightness":20}]},{"featureType":"road.highway","elementType":"geometry.fill","stylers":[{"color":"#ffffff"},{"lightness":17}]},{"featureType":"road.highway","elementType":"geometry.stroke","stylers":[{"color":"#ffffff"},{"lightness":29},{"weight":0.2}]},{"featureType":"road.arterial","elementType":"geometry","stylers":[{"color":"#ffffff"},{"lightness":18}]},{"featureType":"road.local","elementType":"geometry","stylers":[{"color":"#ffffff"},{"lightness":16}]},{"featureType":"poi","elementType":"geometry","stylers":[{"color":"#f5f5f5"},{"lightness":21}]},{"featureType":"poi.park","elementType":"geometry","stylers":[{"color":"#dedede"},{"lightness":21}]},{"elementType":"labels.text.stroke","stylers":[{"visibility":"on"},{"color":"#ffffff"},{"lightness":16}]},{"elementType":"labels.text.fill","stylers":[{"saturation":36},{"color":"#333333"},{"lightness":40}]},{"elementType":"labels.icon","stylers":[{"visibility":"off"}]},{"featureType":"transit","elementType":"geometry","stylers":[{"color":"#f2f2f2"},{"lightness":19}]},{"featureType":"administrative","elementType":"geometry.fill","stylers":[{"color":"#fefefe"},{"lightness":20}]},{"featureType":"administrative","elementType":"geometry.stroke","stylers":[{"color":"#fefefe"},{"lightness":17},{"weight":1.2}]}]
            </pre>
            <p>
            To hide the (clickable) POIs from the map, use this:
            <code>[{featureType:"poi",elementType:"labels",stylers:[{visibility:"off"}]}]</code>
            ```
    }
)

customAttribute attribute_11 (
    apexlangName: addressItem
    attribute: 11
    name: Address Item
    type: pageItem
    appearance {
        sequence: 110
    }
    help {
        helpText: Google API Key required. When the user clicks a point on the map, a Google Maps reverse geocode will be executed and the first result (usually the address) will be copied to the item you specify here.
    }
)

customAttribute attribute_12 (
    apexlangName: geolocate
    attribute: 12
    name: Geolocate
    type: yesNo
    appearance {
        sequence: 120
    }
    help {
        helpText: If Yes, on load the map will attempt to locate the user's position and pan&zoom to that location (it might prompt the user for permission first).
    }
)

customAttribute attribute_13 (
    apexlangName: zoomOnGeolocate
    attribute: 13
    name: Zoom on Geolocate
    type: integer
    validation {
        maxLength: 2
    }
    appearance {
        sequence: 130
    }
    builder {
        unit: (0-23)
        displayWidth: 2
    }
    default {
        value: 13
    }
    dependingOn {
        attribute: @attribute_12/component
        conditionType: =
        value: Y
    }
    help {
        helpText: If geolocation is successful, pan map and zoom to this level.
    }
)

customAttribute attribute_14 (
    apexlangName: readOnly
    attribute: 14
    name: Read-only
    type: plsqlExpressionReturningBoolean
    appearance {
        sequence: 140
    }
    builder {
        showInWizard: false
    }
    help {
        helpText: By default, this plugin allows the user to click the map to move the marker. To make the map "readonly" (i.e. disallow the user from moving the marker), set this to a PL/SQL expression that evaluates to TRUE.
    }
    examples {
        examples:
            ```
            <code>true</code>
            <p>
            <code>:P1_ITEM IS NOT NULL</code>
            ```
    }
)

