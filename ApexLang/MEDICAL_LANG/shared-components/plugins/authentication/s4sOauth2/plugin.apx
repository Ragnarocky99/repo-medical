plugin s4sOauth2 (
    name: S4S oAuth 2
    staticId: NL.S4S.OAUTH2
    type: authenticationScheme
    callbacks {
        apiInterface: function
        sessionSentryProcedureName: #OWNER#.s4sa_oauth_pck.auth_sentry
        authenticationProcedureName: #OWNER#.s4sa_oauth_pck.authenticate
    }
    advanced {
        substituteAttributeValues: true
    }
    information {
        version: 1.0
    }
)

