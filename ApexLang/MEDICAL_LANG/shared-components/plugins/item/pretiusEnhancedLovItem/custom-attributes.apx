customAttribute attribute_05 (
    apexlangName: generalSettings
    attribute: 5
    name: General Settings
    type: checkboxes
    appearance {
        sequence: 1
    }
    default {
        value: AUTOCOMPLETE:POPOUP_REPORT:MS
    }
    supports {
        components: [
            pageItems
            interactiveGridColumns
        ]
    }
    help {
        helpText:
            ```
            <p>
              This attribute allows you to define what funcionalities will be available to end-user.
            </p>
            ```
    }

    entry autocomplete (
        sequence: 10
        display: Autocomplete
        return: AUTOCOMPLETE
        help {
            helpText: When checked the end-user can perform autocomplete.
        }
    )

    entry multipleSelection (
        sequence: 30
        display: Multiple Selection
        return: MS
        help {
            helpText: When checked end-user can select multiple values in autocomplete and popup report. Otherwise end-user can select singular value.
        }
    )

    entry popupReport (
        sequence: 20
        display: Popup Report
        return: POPOUP_REPORT
        help {
            helpText: When checked the end-user can select values from popup report.
        }
    )

)

