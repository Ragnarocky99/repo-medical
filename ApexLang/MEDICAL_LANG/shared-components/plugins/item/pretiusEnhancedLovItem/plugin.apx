plugin pretiusEnhancedLovItem (
    name: Pretius Enhanced LOV item
    staticId: PL.OSTROWSKIBARTOSZ.APEX.ENHANCEDLOVITEM
    type: item
    component {
        standardAttributes: [
            visibleWidget
            standardFormElement
            sessionStateChangeable
            readOnlyAttr
            escapeSpecialCharsAttr
            quickPickAttrs
            sourceAttrs
            elementAttrs
            widthAttrs
            placeholderAttr
            iconAttr
            listOfValues
            lovDisplayNullAttrs
            cascadingLovAttrs
            joinLovforColumnDisplay
            filter
            link
        ]
    }
    callbacks {
        apiInterface: procedureWithLegacyAttributes
        renderProcedureName: #OWNER#.APEX_ENHANCED_LOV_ITEM.render
        metaDataProcedureName: #OWNER#.APEX_ENHANCED_LOV_ITEM.meta_data
        ajaxProcedureName: #OWNER#.APEX_ENHANCED_LOV_ITEM.ajax
    }
    advanced {
        substituteAttributeValues: true
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#enhancedLovItem.js
            #PLUGIN_FILES#mustache.js
        ]
    }
    information {
        version: 1.1.2
        aboutUrl: https://github.com/bostrowski/APEX-Enhanced-Lov-Item
        helpText:
            ```
            <p>
            APEX Enhanced LOV item is powerful combobox to select singular / multiple values in two modes: autocomplete and popup report. The plugin provides high customization possibilities through its attributes. 
            </p>
            <p>
              Author: Bartosz Ostrowski, Twitter: bostrowsk1, E-mail: ostrowski.bartosz@gmail.com
            </p>
            ```
    }

    standardAttributeConfig (
        name: hasLov
        validation {
            required: true
        }
        sqlQuery {
            minColumns: 2
        }
    )

)

