    }
)

customAttribute attribute_14 (
    apexlangName: itemsToDisableIfInvalid
    attribute: 14
    name: Items To Disable If Invalid
    type: pageItems
    validation {
        required: true
    }
    appearance {
        sequence: 140
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: disable-button-if-incorrect
    }
    help {
        helpText: Provide a list of page items if you want them to be disabled as long as all the rules are not completed.
    }
)

customAttribute attribute_15 (
    apexlangName: confirmationItem
    attribute: 15
    name: Confirmation Item
    type: pageItem
    appearance {
        sequence: 150
    }
    help {
        helpText: The user has to confirm the password in this item, i.e. add the very same value, otherwise an error message will be displayed.
    }
)

