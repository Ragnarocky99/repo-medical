customAttribute attribute_01 (
    apexlangName: peekSupport
    attribute: 1
    name: Peek Support
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: enabled-toggle
    }
    help {
        helpText: <p>The <i>Peek support</i> places a button next to password fields with the chosen icon, that when set to active will show your password in place of the asterisks allowing you to check or edit it.</p>
    }

    entry disabled (
        sequence: 10
        display: Disabled
        return: disabled
        help {
            helpText: The feature is disabled, there will be no button added to the item.
        }
    )

    entry enabledOnlyDuringClickPress (
        sequence: 30
        display: Enabled - Only during click/press
        return: enabled-click-press
        help {
            helpText: The password stays revealed only as long as the "Peek" button is pressed. In the moment of mouse-up, mouse-leave the value will be hidden.
        }
    )

    entry enabledToggle (
        sequence: 20
        display: Enabled - Toggle
        return: enabled-toggle
        help {
            helpText: The password display will change state on mouse click(/tap on touchscreen), eg. on the first click it is shown, on the next one it is hidden.
        }
    )

)

customAttribute attribute_02 (
    apexlangName: passwordRulesContainer
    attribute: 2
    name: Password Rules Container
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: collapsible
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: [
            require-min-length
            require-number
            require-spec-char
            require-capital-letter
        ]
    }
    help {
        helpText: <p>With the help of the <i>Rules Container</i> you're able to list the rules regarding the password strength, so your users will be clear with the criteria from the beginning, so they won't get any late, annoying error message. Plus, optionally you can provide a <i>Success Message</i> which will be displayed when all the rules are completed.</p>
    }

    entry collapsible (
        sequence: 30
        display: Collapsible
        return: collapsible
        help {
            helpText: A collapsible region which, in collapsed state, shows the first failed rule.
        }
    )

    entry external (
        sequence: 40
        display: External
        return: external
        help {
            helpText: If you'd rather display the list in another place, then just provide the ID of the region(/element) in the "JavaScript Initialization Code".
        }
    )

    entry hidden (
        sequence: 10
        display: Hidden
        return: hidden
        help {
            helpText: There will be no container displayed.
        }
    )

    entry static (
        sequence: 20
        display: Static
        return: static
        help {
            helpText: A static region containing the rules.
        }
    )

)

customAttribute attribute_03 (
    apexlangName: rulesCompletedMessage
    attribute: 3
    name: Rules Completed Message
    appearance {
        sequence: 30
    }
    default {
        value: Good to go
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: inList
        list: collapsible
    }
    help {
        helpText: The message which will be displayed when all the rules are completed.
    }
    examples {
        examples: You're good to go...
    }
)

customAttribute attribute_04 (
    apexlangName: options
    attribute: 4
    name: Options
    type: checkboxes
    appearance {
        sequence: 40
    }
    help {
        helpText: A list of options you can apply on the item.
    }

    entry disableItemSButtonSIfIncorrect (
        sequence: 90
        display: Disable Item(s)/Button(s) If Incorrect
        return: disable-button-if-incorrect
        help {
            helpText: Disable items/buttons as long as all the rules are not completed.
        }
    )

    entry enableInlineIcons (
        sequence: 100
        display: Enable Inline Icons
        return: enable-inline-icons
        help {
            helpText:
                ```
                Show an inline icon with the current state of the item.
                With this option you can easily set up a similar field to the one from the regular APEX login page.
                ```
        }
    )

    entry expectNewPassword (
        sequence: 110
        display: Expect New Password
        return: new-password
        help {
            helpText:
                ```
                <p>If this option is checked, the plug-in's <i>"autocomplete"</i> attribute will be set to <i>"new-password"</i>, i.e. it may be used by the browser both to avoid accidentally filling in an existing password and to offer assistance in creating a secure password.</p>
                
                <p>If it is unchecked, it'll be set to <i>"current-password"</i>.</p>
                ```
        }
    )

    entry isConfirmationItem (
        sequence: 120
        display: Is Confirmation Item
        return: is-confirmation-item
        help {
            helpText: This option <strong>must</strong> be set if the current plug-in instance is a "Confirmation Item" of an other <i>FOS - Advanced Password</i> plug-in.
        }
    )

    entry requireCapitalLetterS (
        sequence: 40
        display: Require Capital Letter(s)
        return: require-capital-letter
        help {
            helpText: The password must contain a capital letter.
        }
    )

    entry requireMinimumLength (
        sequence: 10
        display: Require Minimum Length
        return: require-min-length
        help {
            helpText: The password must have a minimum required length.
        }
    )

    entry requireNumberS (
        sequence: 20
        display: Require Number(s)
        return: require-number
        help {
            helpText: The password must contain a number.
        }
    )

    entry requireSpecialCharacterS (
        sequence: 30
        display: Require Special Character(s)
        return: require-spec-char
        help {
            helpText: The password must contain a special character.
        }
    )

    entry showCapsLockOn (
        sequence: 70
        display: Show Caps Lock On
        return: show-caps-lock-on
        help {
            helpText: Show an icon when the CapsLock is active.
        }
    )

    entry showErrorIfInvalid (
        sequence: 80
        display: Show Error If Invalid
        return: show-error-if-incorrect
        help {
            helpText: Display an error message after change when the provided value does not pass all the rules.
        }
    )

    entry showPasswordStrengthBar (
        sequence: 50
        display: Show Password Strength-bar
        return: show-pwd-strength-bar
        help {
            helpText: Display a bar under the input field which indicates the ratio of the completed-failed rules.
        }
    )

    entry stretchRulesContainer (
        sequence: 60
        display: Stretch Rules Container
        return: stretch-rules-container
        help {
            helpText:
                ```
                Only if the "Rules Container" is <i>Static</i> or <i>Collapsible</i>.
                The rules will be listed horizontally next to each other, in the full length of the item.
                ```
        }
    )

    entry submitWhenEnterPressed (
        sequence: 130
        display: Submit when Enter pressed
        return: submit-enter
        help {
            helpText: <p>Specify whether pressing the <em>Enter</em> key while in this field automatically submits the page.</p>
        }
    )

)

customAttribute attribute_05 (
    apexlangName: minimumLength
    attribute: 5
    name: Minimum Length
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 50
    }
    default {
        value: 7
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-min-length
    }
    help {
        helpText: Set the number of the minimum required characters.
    }
)

customAttribute attribute_06 (
    apexlangName: minimumLengthMessage
    attribute: 6
    name: Minimum Length Message
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    default {
        value: Must contain at least #MIN_LENGTH# characters.
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-min-length
    }
    help {
        helpText:
            ```
            The message which will be displayed in the "Rules Container" or as an error message.
            You can use #MIN_LENGTH# to reference to the value from the "Required Minimum Length" field.
            ```
    }
    examples {
        examples: Must contain at least #MIN_LENGTH# characters.
    }
)

customAttribute attribute_07 (
    apexlangName: requiredNumberOfDigits
    attribute: 7
    name: Required Number of Digits
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    default {
        value: 1
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-number
    }
    help {
        helpText: The minimum number of digits the password must contain.
    }
)

customAttribute attribute_08 (
    apexlangName: requiredDigitsMessage
    attribute: 8
    name: Required Digits Message
    validation {
        required: true
    }
    appearance {
        sequence: 80
    }
    default {
        value: At least #MIN_NUMS# digits.
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-number
    }
    help {
        helpText:
            ```
            The message which will be displayed in the "Rules Container" or as an error message.
            You can use the #MIN_NUMS# placeholder to reference to the value from the "Required Number of Digits" attribute.
            ```
    }
    examples {
        examples: Must contain at least #MIN_NUMS# digits.
    }
)

customAttribute attribute_09 (
    apexlangName: listOfRequiredSpecialCharacters
    attribute: 9
    name: List of Required Special Characters
    validation {
        required: true
    }
    appearance {
        sequence: 90
    }
    default {
        value: "?><,./|}[]~§@#$%"
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-spec-char
    }
    help {
        helpText: Write a list of characters that you'd like to be considered in the special category.
    }
)

customAttribute attribute_10 (
    apexlangName: numberOfRequiredSpecialCharacters
    attribute: 10
    name: Number of Required Special Characters
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    default {
        value: 2
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-spec-char
    }
    help {
        helpText: The number of the required special characters the password must contain.
    }
)

customAttribute attribute_11 (
    apexlangName: requireSpecialCharacterSMessage
    attribute: 11
    name: Require Special Character(s) Message
    appearance {
        sequence: 110
    }
    default {
        value: At least #MIN_SPEC_CHARS# from the list: #SPEC_CHARS_LIST#
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-spec-char
    }
    help {
        helpText:
            ```
            The message which will be displayed in the "Rules Container" or as an error message.
            You can use the #SPEC_CHARS_LIST# and the #MIN_SPEC_CHARS# placeholders to reference to the values from the "List of Special Character(s)" and the "Required number of Special Character(s)" attribute.
            ```
    }
    examples {
        examples: Must contain at least #MIN_SPEC_CHARS# from the list: #SPEC_CHARS_LIST#.
    }
)

customAttribute attribute_12 (
    apexlangName: requiredNumberOfCapitalLetterS
    attribute: 12
    name: Required number of Capital Letter(s)
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 120
    }
    default {
        value: 1
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-capital-letter
    }
    help {
        helpText: The required number of Capital Letters.
    }
)

customAttribute attribute_13 (
    apexlangName: requireCapitalLettersMessage
    attribute: 13
    name: Require Capital Letters Message
    validation {
        required: true
    }
    appearance {
        sequence: 130
    }
    default {
        value: Must contain at least #MIN_CAPS# capital letters
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: inList
        list: require-capital-letter
    }
    help {
        helpText:
            ```
            The message which will be displayed in the "Rules Container" or as an error message.
