page 551 (
    name: Generaciones masivas de facturas
    alias: CARGA-DE-GENERACIONES-MASIVAS-DE-FACTURAS
    title: Generaciones masivas de facturas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-generaciones-masivas-de-facturas (
        name: Carga de generaciones masivas de facturas
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       FEC_FACTURA,
                       MES,
                       ANIO,
                       IPC,
                       ID_CONDICION_VENTA,
                       ID_SECTOR,
                       TIP_CAMBIO,
                       FACTURADO,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       TIPO_CAMBIO_DIA,
                       OBSERVACION,
                       APLICA_DESC,
                       ID_EMPRESA
                  from ACW_AFACTURAR_CAB
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: ACW_AFACTURAR_DET
