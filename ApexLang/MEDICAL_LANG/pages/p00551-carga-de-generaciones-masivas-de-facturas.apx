    dynamicAction ultimo-numero (
        name: Ultimo Numero
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P551_SER_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        SELECT MAX(NRO_COMPROBANTE)+1
                        INTO :P551_NRO_FACTURA
                        FROM VTW_COMPROBANTES_CABECERA
                        WHERE ID_SERIE_COMP=:P551_SER_COMPROBANTE;
                    END;
                    ```
                itemsToSubmit: P551_SER_COMPROBANTE
                itemsToReturn: P551_NRO_FACTURA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process datos-a-factura (
        name: DATOS_A_FACTURA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  cursor datos is
                    SELECT C.ID,
                           C.TIP_COMPROBANTE,
                           C.SER_COMPROBANTE,
                           C.NRO_COMPROBANTE,
                           D.ID_ARTICULO,
                           D.ID_MONEDA,
                           D.MONTO_GASTO,
                           D.FEC_DESDE,
                           D.PORCENTAJE_GASTO,
                           D.TIPO_CAMBIO,
                           D.ID_MONEDA_FACTURACION,
                           C.ID_CLIENTE,
                           C.FEC_CONTRATO,
                           C.FEC_VENCIMIENTO,
                           C.PORC_SOBRE_VTAS,
                           C.CANT_MESES_AJUSTE,
                           C.PORC_AJUSTE,
                           C.TOTAL_SUP_LOCAL_COMP,
                           C.TOTAL_SUP_VIDRIERA_COMP,
                           C.INCLUIR_METRAJE,
                           C.INCLUYE_IPC,
                           C.ARRENDAMIENTO_DICIEMBRE,
                           O.ID_IVA,
                           D.DATO_ANTERIOR,
                           C.TIP_COMPROBANTE_REF,
                           C.SER_COMPROBANTE_REF,
                           C.NRO_COMPROBANTE_REF,
                           -- O.ORDEN,
                           NVL(M.DECIMALES, 0) DECIMALES,
                           D.CAMBIO,
                           c.ID_rubro,
                           TRAE_PORC_IVA(O.ID_IVA) AS PORC_IVA
                
                      FROM ACW_CONTRATOS_CAB C,
                           ACW_CONTRATOS_DET D,
                           STW_ARTICULOS     O,
                           BSW_MONEDAS       M
                     WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                       AND C.ID_SUCURSAL = :P0_ID_SUCURSAL
                          --  AND C.TIP_COMPROBANTE <> 'SOL'
                       AND (C.ID_CLIENTE = :P551_ID_CLIENTE OR :P551_ID_CLIENTE IS NULL)
                       AND D.FEC_DESDE <= TO_DATE(:P551_FEC_FACTURA,'DD/MM/YYYY')
                       AND NVL(C.ESTADO, 'I') = 'A'
                          
                          -------------------------------------------- Este comente porq el cliente puede tener mas de un contrato vigente
                          /*AND C.FEC_CONTRATO =
                              (SELECT MAX(FEC_CONTRATO)
                                 FROM AC_CONTRATOS_CAB
                                WHERE COD_EMPRESA = C.COD_EMPRESA
                                  AND COD_SUCURSAL = C.COD_SUCURSAL
                                  AND COD_CLIENTE = C.COD_CLIENTE AND NVL(ESTADO, 'I') = 'A')
                          */
                          
                       AND NOT EXISTS
                    
                     (SELECT 'SW'
                              FROM VTW_COMPROBANTES_CABECERA C1, VTW_COMPROBANTES_DETALLE D1
                             WHERE C1.ID_EMPRESA = C.ID_EMPRESA
                               AND C1.TIP_COMPROBANTE <> '#'
                               AND C1.SER_COMPROBANTE <> '#'
                               AND C1.ID_CLIENTE = C.ID_CLIENTE
                                  --   AND C1.MES = :B_CONTROL.MES
                                  --   AND C1.ANIO = :B_CONTROL.ANIO
                               AND NVL(C1.ESTADO, 'P') <> 'A'
                               AND C1.ID_EMPRESA = D1.ID_EMPRESA
                               AND C1.ID = D1.ID_COMPROBANTE_CABECERA
                            /*
                            AND C1.TIP_COMPROBANTE = D1.TIP_COMPROBANTE
                            AND C1.SER_COMPROBANTE = D1.SER_COMPROBANTE
                            AND C1.NRO_COMPROBANTE = D1.NRO_COMPROBANTE*/
                            AND INSTR(:P551_CONCEPTOS,
                            '*' || TO_CHAR(D1.ID_ARTICULO) || '*') > 0
                            )
                       AND C.ID_EMPRESA = D.ID_EMPRESA
                       AND C.ID_SUCURSAL = D.ID_SUCURSAL
                       AND C.ID = D.ID_CONTRATO_CAB
                          /*
                          AND C.TIP_COMPROBANTE = D.TIP_COMPROBANTE
                          AND C.SER_COMPROBANTE = D.SER_COMPROBANTE
                          AND C.NRO_COMPROBANTE = D.NRO_COMPROBANTE
                          */
                       AND D.ID_EMPRESA = O.ID_EMPRESA
                       AND D.ID_ARTICULO = O.ID
                       AND INSTR('*'||:P551_CONCEPTOS||'*', '*' || TO_CHAR(D.ID_ARTICULO) || '*') > 0
                       AND M.ID(+) = D.ID;
                
                  VPORC_IVA   VARCHAR2(3) := W_BUSCA_PARAMETRO('CM', 'CM_PORC_IVA_GASTO');
                  VTIP_CAMBIO NUMBER(9);
                  VMONTO      NUMBER(30, 12);
                  VMONTO_CUO  NUMBER(18, 2);
                  VPORC_CUO   NUMBER(18, 5);
                  VMONEDA_CUO VARCHAR2(5);
                  VMES        VARCHAR2(2); --CREADO EL 24/10/2007 
                  VANIO       VARCHAR2(4); --CREADO EL 24/10/2007
                  TMP_DETALLES CONSTANT VARCHAR2(20) := 'PRE_FACTURA';
                  VTOT_IVA      NUMBER(18, 2);
                  VTOT_GRAVADAS NUMBER(18, 2);
                  VTOT_EXENTAS  NUMBER(18, 2);
                  l_cursor SYS_REFCURSOR;
                  json_detalle CLOB;
                  VID_TIP_COMPROBANTE  VARCHAR2(10):=TRAE_ID_TIPO_COMPROBANTE(:P551_TIP_COMPROBANTE);
                
                begin
                  IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_DETALLES) THEN
                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_DETALLES);
                  END IF;
                  APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_DETALLES);
                  FOR D IN DATOS LOOP
                
                
                    /*:B_DETALLE.COD_EMPRESA     := :VARIABLES.COD_EMPRESA;
                    :B_DETALLE.COD_SUCURSAL    := :VARIABLES.COD_SUCURSAL;
                    --:B_DETALLE.MES             := :B_CONTROL.MES; --COMENTADO EL 24/10/2007
                    --:B_DETALLE.ANIO            := :B_CONTROL.ANIO;--COMENTADO EL 24/10/2007
                    :B_DETALLE.TIP_COMPROBANTE := D.TIP_COMPROBANTE;
                    :B_DETALLE.SER_COMPROBANTE := D.SER_COMPROBANTE;
                    :B_DETALLE.NRO_COMPROBANTE := D.NRO_COMPROBANTE;
                    :B_DETALLE.COD_CLIENTE     := D.COD_CLIENTE;
                    :B_DETALLE.COD_CONCEPTO    := D.COD_CONCEPTO;
                    :B_DETALLE.COD_MONEDA      := D.COD_MONEDA_FACTURACION;
                    -- VALORES DISCRIMINADOS POR FECHA*/
                  
                    BEGIN
                      SELECT MP.MONTO,
                             MP.PORCENTAJE,
                             MP.ID_MONEDA,
                             NVL(MP.MES, TO_CHAR(MP.FECHA_COBRO, 'MM')),
                             NVL(MP.ANIO, TO_CHAR(MP.FECHA_COBRO, 'YYYY'))
                        INTO VMONTO_CUO, VPORC_CUO, VMONEDA_CUO, VMES, VANIO
                        FROM ACW_CONTRATOS_MONTOS MP
                       WHERE MP.ID_EMPRESA = :P0_ID_EMPRESA
                         AND MP.ID_SUCURSAL = :P0_ID_SUCURSAL
                         AND MP.ID_ARTICULO = D.ID_ARTICULO
                         AND TO_CHAR(MP.FECHA_COBRO, 'MM/YYYY') =
                             :P551_MES || '/' || :P551_ANIO
                         AND MP.FECHA_COBRO =
                             (SELECT MIN(M.FECHA_COBRO)
                                FROM ACW_CONTRATOS_MONTOS M
                               WHERE M.ID_EMPRESA = :P0_ID_EMPRESA
                                 AND M.ID_SUCURSAL = :P0_ID_SUCURSAL
                                 AND M.ID_ARTICULO = D.ID_ARTICULO
                                 AND TO_CHAR(M.FECHA_COBRO, 'MM/YYYY') =
                                     :P551_MES || '/' || :P551_ANIO
                                 AND M.ID_CONTRATO_CAB = D.ID)
                         AND MP.ID_CONTRATO_CAB = D.ID;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        VMONTO_CUO  := NULL;
                        VPORC_CUO   := NULL;
                        VMONEDA_CUO := NULL;
                      WHEN OTHERS THEN
                        VMONTO_CUO  := NULL;
                        VPORC_CUO   := NULL;
                        VMONEDA_CUO := NULL;
                    END;
                  
                    --------------------AGREGADO EL 24/10/2007------------------------------
                  
                    ------------------------------------------------------------------------
                  
                    -- TIPO DE CAMBIO
                  
                    BEGIN
                      VTIP_CAMBIO := FTIPOS_CAMBIO(NVL(VMONEDA_CUO, D.ID_MONEDA),
                                                   :P551_FEC_FACTURA,
                                                   D.TIPO_CAMBIO,
                                                   D.CAMBIO);
                    EXCEPTION
                      WHEN OTHERS THEN
                        VTIP_CAMBIO := 1;
                    END;
                  
                    -- MONTO A FACTURAR 
                    IF D.ID_MONEDA_FACTURACION <> :P551_ID_MONEDA_BASE THEN
                      VMONTO := NVL(VMONTO_CUO, D.MONTO_GASTO);
                    ELSE
                      VMONTO := ROUND(NVL(VMONTO_CUO, D.MONTO_GASTO) * VTIP_CAMBIO, 0);
                    END IF;
                  
                    /*
                    -- SI INCLUYE IPC
                    IF D.COD_CONCEPTO = :VARIABLES.COD_AMI AND
                       D.COD_MONEDA = :VARIABLES.COD_MONEDA_BASE AND
                       NVL(D.INCLUYE_IPC, 'N') = 'S' THEN
                      VMONTO := ROUND((NVL(VMONTO, 0) * VTIP_CAMBIO) *
                                      ((NVL(:B_CONTROL.IPC, 0) / 100) + 1),
                                      0);
                      ----------------------------------------------------------- clausula especial por este mes de inicio cobro                
                      if :b_control.mes = '05' and :b_control.anio = '2012' then 
                        vmonto := ROUND(VMONTO/30*20,2);
                      end if;
                      :VARIABLES.MONTO_AMI := ROUND(VMONTO,2);
                    ELSIF D.COD_CONCEPTO = :VARIABLES.COD_AMI THEN
                      -- ARRENDAMIENTO MINIMO
                      IF NVL(VMONEDA_CUO, D.COD_MONEDA) = D.COD_MONEDA_FACTURACION THEN
                        VMONTO := ROUND(NVL(VMONTO_CUO, D.MONTO_GASTO), D.DECIMALES);
                      ELSE
                        VMONTO := ROUND(NVL(VMONTO_CUO, D.MONTO_GASTO) * VTIP_CAMBIO,
                                        D.DECIMALES);
                      END IF;
                      */
                  
                    /*
                            ----------------------------------------------------------- clausula especial por este mes de inicio cobro                
                      if :b_control.mes = '05' and :b_control.anio = '2012' then 
                        vmonto := ROUND(VMONTO/30*20,2);
                      end if;
                      :VARIABLES.MONTO_AMI := ROUND(VMONTO,2);
                    ELSIF D.COD_CONCEPTO = :VARIABLES.COD_FPM THEN
                      -- FONDO PROMOCION (ARRENDAMIENTO MINIMO)
                      IF NVL(VMONTO, 0) = 0 THEN
                        ---------------------------------------------------
                        ---AGREGUE PORC DEL DETALLE POR EL TEMA DEL 20% ---
                        ---06.07.2012 -------------------------------------
                        
                        VMONTO := FONDO_PROMOCION(D.COD_CLIENTE,
                                                  NVL(VPORC_CUO,D.PORCENTAJE_GASTO),
                                                  NVL(D.DATO_ANTERIOR, 'N'),
                                                  D.TIP_COMPROBANTE_REF,
                                                  D.SER_COMPROBANTE_REF,
                                                  D.NRO_COMPROBANTE_REF,
                                                  D.COD_MONEDA_FACTURACION);
                      END IF;*/
                    /*
                    ELSIF D.COD_CONCEPTO = :VARIABLES.COD_WEB THEN
                      -- PAGINA WEB
                      VMONTO := NVL(VMONTO, 0);
                    ELSIF D.COD_CONCEPTO = :VARIABLES.COD_APO THEN
                      -- ARRENDAMIENTO PORCENTUAL
                      VMONTO := 0;---ARRENDAMIENTO_PORC(D.COD_CLIENTE, NVL(VPORC_CUO,D.PORCENTAJE_GASTO), D.COD_MONEDA_FACTURACION, D.TIPO_CAMBIO);
                    ELSIF D.COD_CONCEPTO = :VARIABLES.COD_FPP THEN
                      -- FONDO PROMOCION PORCENTUAL
                      VMONTO := 0;--FONDO_PROMOCION_PORC(D.COD_CLIENTE,
                                          --           D.PORCENTAJE_GASTO,
                                          --           D.DATO_ANTERIOR,
                                            --         D.TIP_COMPROBANTE_REF,
                                          --           D.SER_COMPROBANTE_REF,
                                          --           D.NRO_COMPROBANTE_REF);
                    ELSIF D.COD_CONCEPTO = :VARIABLES.COD_GCO THEN
                      -- GASTOS COMUNES
                      IF NVL(VMONTO_CUO, 0) + NVL(D.MONTO_GASTO, 0) = 0 THEN
                          VMONTO := 0;--GASTOS_COMUNES(D.TOTAL_SUP_LOCAL_COMP,
                                          --         D.TOTAL_SUP_VIDRIERA_COMP,
                                              --     d.COD_RUBRO,
                                              --     D.COD_MONEDA_FACTURACION,
                                              --     d.tipo_cambio,
                                            --       d.cambio,
                                              --     d.porcentaje_gasto,
                                              --     d.tip_comprobante,
                                              --     d.ser_comprobante,
                                              --     d.nro_comprobante);
                      END IF;
                      
                    
                            ----------------------------------------------------------- clausula especial por este mes de inicio cobro                
                      if :b_control.mes = '05' and :b_control.anio = '2012' then 
                        vmonto := ROUND(VMONTO/30*20,2);
                      end if;
                    END IF;*/
                    --DICIEMBRE ARRENDAMIENTOM MINIMO 
                    /*IF D.COD_CONCEPTO = :VARIABLES.COD_AMI THEN
                    --IF D.COD_CONCEPTO = :VARIABLES.COD_ARD OR D.COD_CONCEPTO = :VARIABLES.COD_ARC THEN
                      -- ARRENDAMIENTO MINIMO
                      IF TO_NUMBER(NVL(:B_CONTROL.MES, '0')) = 12 AND
                         NVL(D.ARRENDAMIENTO_DICIEMBRE, 0) <> 0 THEN
                        VMONTO := VMONTO + ROUND((VMONTO * D.ARRENDAMIENTO_DICIEMBRE / 100),
                                                 D.DECIMALES);
                      END IF;
                    END IF;*/
                  
                    --CALCULOS IVA
                    --  IF D.COD_CONCEPTO = :VARIABLES.COD_GCO THEN
                    -- PARA GASTOS COMUNES TIENE VALOR EN AMBAS COLUMNAS
                    IF NVL(VMONTO_CUO, 0) + NVL(D.MONTO_GASTO, 0) = 0 THEN
                      /* para sh. sol y mplaza
                      VTOT_IVA    := ROUND((NVL(:VARIABLES.GASTOS_GRABADOS, 0) *
                                                       VMONTO *
                                                       NVL(D.IVA,
                                                            TO_NUMBER(NVL(VPORC_IVA, 0))) / 100),
                                                       D.DECIMALES);
                      VTOT_GRAVADAS := ROUND(NVL(:VARIABLES.GASTOS_GRABADOS, 0) *
                                                       VMONTO,
                                                       D.DECIMALES);
                      VTOT_EXENTAS  := ROUND(NVL(:VARIABLES.GASTOS_EXENTOS, 0) *
                                                       VMONTO,
                                                       D.DECIMALES);
                      */
                      -- para Sh sn lorenzo
                      VTOT_GRAVADAS := ROUND(NVL(VMONTO, 0) / 1.1, D.DECIMALES);
                      VTOT_IVA      := ROUND(NVL(VMONTO, 0) - NVL(VTOT_GRAVADAS, 0),
                                             D.DECIMALES);
                      VTOT_EXENTAS  := 0;
                    ELSE
                      /* para sh. sol y mplaza
                      VTOT_IVA    := ROUND(VMONTO *
                                                       NVL(D.IVA,
                                                           TO_NUMBER(NVL(VPORC_IVA, 0))) / 100,
                                                       D.DECIMALES);
                      VTOT_GRAVADAS := VMONTO;
                      VTOT_EXENTAS  := 0;*/
                    
                      -- para Sh sn lorenzo
                      VTOT_GRAVADAS := ROUND(NVL(VMONTO, 0) / 1.1, D.DECIMALES);
                      VTOT_IVA      := ROUND(NVL(VMONTO, 0) - NVL(VTOT_GRAVADAS, 0),
                                             D.DECIMALES);
                      VTOT_EXENTAS  := 0;
                    
                    END IF;
                    IF NVL(D.ID_IVA, 0) <> W_BUSCA_PARAMETRO('ST', 'COD_IVA_EXENTA') THEN
                      VTOT_IVA      := ROUND((NVL(VMONTO, 0) *
                                             NVL(D.PORC_IVA, TO_NUMBER(NVL(VPORC_IVA, 0))) / 100),
                                             D.DECIMALES);
                      VTOT_GRAVADAS := VMONTO;
                      VTOT_EXENTAS  := 0;
                    ELSE
                      VTOT_IVA      := 0;
                      VTOT_GRAVADAS := 0;
                      /*  IF D.COD_CONCEPTO = :VARIABLES.COD_APO THEN
                        -- ARRENDAMIENTO PORCENTUAL
                        VTOT_EXENTAS := VMONTO;
                      ELSE
                        VTOT_EXENTAS := VMONTO;
                      END IF;*/
                    END IF;
                    --  :B_DETALLE.TIP_CAMBIO := VTIP_CAMBIO;
                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => TMP_DETALLES,
                                               P_C001            => :P0_ID_EMPRESA,
                                               P_C002            => :P0_ID_SUCURSAL,
                                               P_C003            => D.TIP_COMPROBANTE,
                                               P_C004            => D.SER_COMPROBANTE,
                                               P_C005            => D.NRO_COMPROBANTE,
                                               P_C006            => D.ID_CLIENTE,
                                               P_C007            => D.ID_ARTICULO,
                                               P_C008            => D.ID_MONEDA_FACTURACION,
                                               P_C009            => VMES,
                                               P_C010            => VANIO,
                                               P_C011            => VTOT_GRAVADAS,
                                               P_C012            => VTOT_IVA,
                                               P_C013            => VTOT_EXENTAS,
                                               P_C014            => VTIP_CAMBIO,
                                               P_C015            => :P551_ID_CONDICION_VENTA,
                                               P_C016            => :P551_SER_COMPROBANTE,
                                               P_C017            => VID_TIP_COMPROBANTE,
                                               P_C018            => D.ID);
                  END LOOP;
                OPEN l_cursor FOR
                    SELECT C001 AS ID_EMPRESA,
                           C002 AS ID_SUCURSAL,
                           C003 AS TIP_COMPROBANTE,
                           C004 AS SER_COMPROBANTE,
                           C005 AS NRO_COMPROBAMTE,
                           C006 AS ID_CLIENTE     ,
                           C007 AS ID_ARTICULO    ,
                           C008 AS ID_MONEDA_FACTURACION,
                           C009 AS MES,
                           C010 AS ANIO,
                           C011 AS TOT_GRAVADAS,
                           C012 AS TOT_IVA,
                           C013 AS VTOT_EXENTAS,
                           C014 AS TIP_CAMBIO,
                           C015 AS ID_CONDICION_VENTA,
                           C016 AS ID_SER_COMPROB,
                           C017 AS VID_TIP_COMPROBANTE,
                           C018 AS ID_CONTRATO
                    FROM APEX_COLLECTIONS
                    WHERE COLLECTION_NAME=TMP_DETALLES;
                    
                
                  APEX_JSON.initialize_clob_output;
                
                  APEX_JSON.open_object;
                  APEX_JSON.write('DETALLE', l_cursor);
                  APEX_JSON.close_object;
                
                  JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                
                  :P551_JSON_DETALLES:=JSON_DETALLE;
                   
                
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage:
                ```
                Proceso ejecutado correctamente
                
                ```
        }
        advanced {
            executionMappingIdentifier: 86229215968411537
        }
        serverSideCondition {
            whenButtonPressed: @pre-factura
        }
    )

