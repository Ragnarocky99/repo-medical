    region detalle-2 (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT     
                            C001 AS ID_EMPRESA,
                           C002 AS ID_SUCURSAL,
                           C003 AS TIP_COMPROBANTE,
                           C004 AS SER_COMPROBANTE,
                           C005 AS NRO_COMPROBAMTE,
                           C006 AS ID_CLIENTE     ,
                           C007 AS ID_ARTICULO    ,
                           C008 AS ID_MONEDA_FACTURACION,
                           C009 AS MES,
                           C010 AS ANIO,
                           C011 AS TOT_GRAVADAS,
                           C012 AS TOT_IVA,
                           C013 AS VTOT_EXENTAS,
                           C014 AS TIP_CAMBIO,
                           C015 AS ID_CONDICION_VENTA,
                           C016 AS ID_SER_COMPROB,
                           C017 AS VID_TIP_COMPROBANTE,
                           C018 AS ID_CONTRATO
                    FROM APEX_COLLECTIONS
                    WHERE COLLECTION_NAME='PRE_FACTURA'
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
