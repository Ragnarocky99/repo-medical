            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reporte de Historicos Porc. Margen
        }

        savedReport 336843 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 5
            )

            displayColumn COD_ARTICULO (
                sequence: 2
