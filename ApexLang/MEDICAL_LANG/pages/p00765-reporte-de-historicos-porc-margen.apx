page 765 (
    name: Reporte de Historicos Porc. Margen
    alias: REPORTE-DE-HISTORICOS-PORC-MARGEN
    title: Reporte de Historicos Porc. Margen
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region reporte-de-historicos-porc-margen (
        name: Reporte de Historicos Porc. Margen
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PORC_MARGEN,
                       CANTIDAD,
                       ID_ARTICULO,
                       DESC_ARTICULO,
                       COD_ARTICULO,
                       TIPO,
                       TIPO_AJUSTE,
                       ID_RUBRO,
                       ID_MARCA,
                       ID_LINEA
                  from CMWV_PORC_MARGEN_HISTORICOS_REPORTE
                 where (ID_ARTICULO = :P765_ID_ARTICULO OR :P765_ID_ARTICULO IS NULL)
                   and (ID_RUBRO = :P765_ID_RUBRO OR :P765_ID_RUBRO IS NULL)
                   and (ID_MARCA = :P765_ID_MARCA OR :P765_ID_MARCA IS NULL)
                   and (ID_LINEA = :P765_ID_LINEA OR :P765_ID_LINEA IS NULL)
                FETCH FIRST :P765_LIMITE ROWS ONLY;
                ```
            pageItemsToSubmit: [
                P765_ID_ARTICULO
                P765_LIMITE
                P765_ID_RUBRO
                P765_ID_MARCA
                P765_ID_LINEA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 33681285010351364
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad Promedio
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_ARTICULO (
            type: link
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            link {
                target: {
                    page: 768
                    items: {
                        P768_ID_ARTICULO: #ID_ARTICULO#
                    }
                }
                linkText: #COD_ARTICULO#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESC_ARTICULO (
            type: plainText
