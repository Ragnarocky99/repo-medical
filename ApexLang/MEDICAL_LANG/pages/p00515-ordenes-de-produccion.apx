    dynamicAction set-ultimo-dia (
        name: set_ultimo_dia
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action set-fecha (
            name: set_fecha
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P515_FEC_HASTA := trae_ultimo_dia(to_char(sysdate, 'mm'),
                                                 to_CHar(sysdate, 'yyyy'))||'/'||to_char(sysdate, 'mm/yyyy');
                         
                    :P515_FEC_desde := '01/'||to_char(sysdate, 'mm/yyyy');
                    
                       
                    ```
                itemsToReturn: [
                    P515_FEC_HASTA
                    P515_FEC_DESDE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

