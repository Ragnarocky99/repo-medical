page 515 (
    name: Ordenes de Produccion
    alias: ORDENES-DE-PRODUCCION
    title: Ordenes de Produccion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ordenes-de-produccion (
        name: Ordenes de Produccion
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_PRODUCCION,
                       SER_PRODUCCION,
                       NRO_PRODUCCION,
                       ID_SUCURSAL,
                       FEC_PRODUCCION,
                       FEC_INICIO,
                       FEC_FINAL,
                       ID_FORMULA,
                       ID_ARTICULO,
                       ID_UNIDAD_MEDIDA,
                       CANT_A_PRODUCIR,
                       TIP_ORDEN_REF,
                       SER_ORDEN_REF,
                       NRO_ORDEN_REF,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ID_PER_COORDINACION,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       COMENTARIO,
                       ANULADO,
                       CASE ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END ANULADO_ICON,
                       ASIENTOS,
                       NIVEL_AUT,
                       ID_TURNO,
                       SE_INFORMA,
                       COSTO_UNITARIO_PROD,
                       TIPO,
                       CANT_INSUMO,
                       CANT_MERMA,
                       ID_UNIDAD_INSUMO,
                       ID_UNIDAD_MERMA
                  from PDW_PRODUCCION_CAB
                  where id_empresa = :p0_id_empresa
                    AND (ESTADO     = :P515_ESTADO OR :P515_ESTADO  = 'T')
                    and (id_turno   = :P515_TURNO or :P515_TURNO = 'Todos')
                    and (id_articulo = :P515_ARTICULO or :P515_ARTICULO is null)
                    and fec_produccion >= nvl(:P515_FEC_DESDE, to_date('01/'||to_char(sysdate,'mm/yyyy'))) 
                    and fec_produccion <= nvl(:P515_FEC_HASTA, to_date(trae_ultimo_dia(to_char(sysdate, 'mm'), to_char(sysdate, 'yyyy'))||'/'||to_char(sysdate, 'mm/yyyy')));
                
                ```
            pageItemsToSubmit: [
                P515_ESTADO
                P515_TURNO
                P515_ARTICULO
                P515_FEC_HASTA
                P515_FEC_DESDE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Produccion
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        pagination {
            type: page
            showTotalCount: false
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 80354864068225816
        }

