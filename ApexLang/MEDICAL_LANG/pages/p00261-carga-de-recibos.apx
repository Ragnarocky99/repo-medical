page 261 (
    name: Carga de Saldos
    alias: CARGA-DE-RECIBOS
    title: Cargo de Saldos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 600
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var id_saldos='';
            function updateColorCheckbox(e) {
            
                e.stopPropagation();
            
                var region = apex.region('Detalles');      // Static ID of the Interactive Grid
                var grid = region.call("getViews").grid;
                var model = grid.model;
                var totalRec = model.getTotalRecords();
                var  selectedRec = 0;
                var col_selected = model.getFieldKey("SELECCIONAR");      // Column Name
                
                model.forEach(function (record, index, id) {
                   var n_sal = (record[col_selected]);
                     if (!isNaN(n_sal) && n_sal == 1) {
                        selectedRec += 1;
                    }
                    
                });
            
            if (selectedRec == totalRec ){
             model.forEach(function (record, index, id) {
                        model.setValue(record, "SELECCIONAR", "S" + 1,true);
                       id_saldos=id_saldos+model.getValue(record,'ID')+',';
                    });
                
            }else{
                 model.forEach(function (record, index, id) {
                        model.setValue(record, "SELECCIONAR", "S",true);
                                   console.log(model.getValue(record,'ID'));
                                   id_saldos=id_saldos+model.getValue(record,'ID')+',';
            
                    });
                
            }
               
            }
            
            function marcarTodos(){
                try{
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_seleccionada = model.getFieldKey("SELECCIONAR");
                var v_total_cantidad     = 0;
                var bandera ='N'
                model.forEach(function(r, index, id) {
                        
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                 
                    if(r[v_seleccionada]=='N' || r[v_seleccionada]==null || r[v_seleccionada]==''){
                        bandera='S'
                       model.setValue(r,'SELECCIONAR','S');
                       
                    }
               if(r[v_seleccionada]=='S' && bandera=='N'){
                 
                       model.setValue(r,'SELECCIONAR','N');
                 
                    }    
                       
                    }
                    
                });
            }catch(e){
                
            }
            
            }
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region saldos (
        name: Saldos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.TIPO_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       case c.tipo_comprobante
                        when 'ADC' then null
                        else c.id_comprobante
                       end as ID_COMPROBANTE, -- LE PONGO NULO, POR LA FK DE VTW_COMP
                       --C.ID_COMPROBANTE,
                       C.ID_CLIENTE,
                       C.NRO_CUOTA,
                       C.FEC_VENCIMIENTO,
                       C.FEC_ACOBRAR,
                       C.MONTO_CUOTA,
                       C.ID_MONEDA_CUOTA,
                       M.DESCRIPCION,
                       C.SALDO_CUOTA - NVL(C.REC_PENDIENTES, 0) as SALDO,
                       C.REC_PENDIENTES,
                       C.FEC_ORIGEN,
                       C.ID_USUARIO,
                       C.FEC_CARGA,
                       C.COD_USUARIO_AUD,
                       C.ID_NOTAS_DEBCRED,
                       C.SALDO_ANTERIOR,
                       C.ID_RECIBO,
                       C.TIP_CAMBIO,
                       C.ID_EXTRACTO_INICIAL,
                       C.IND_MAQUINA,
                       C.NRO_VALOR,
                       C.SALDO_EXENTAS,
                       C.SALDO_GRAVADAS,
                       C.ID_COBRADOR,
                       C.IND_ALTO_RIESGO,
                       C.TIP_PAGARE,
                       C.MONTO_EXENTAS,
                       C.ID_PER_JURIDICA,
                       C.TIP_CAMBIO_US,
                       C.PORC_IVA,
                       C.TOT_IVA,
                       C.PORC_GRAVADAS,
                       C.MONTO_GRAVADAS,
                       C.FACTURA,
                       C.REFERENCIA,
                       C.COLUMNA,
                       C.ID_VENDEDOR,
                       C.ID_SECTOR,
                       C.ID_CORPORACION,
                       C.ID_ESTADO_FORMA,
                       C.ID_CONCEPTO,
                       C.POR_CORPORACION,
                       C.FEC_COBRO,
                       C.TIP_COMPR_ANT
                  from CCW_SALDOS C, /*VTW_COMPROBANTES_CABECERA CC, CCW_CONDICIONES_VENTAS CV,*/ BSW_MONEDAS M
                  WHERE C.ID_EMPRESA=:P0_ID_EMPRESA
                  AND C.ID_MONEDA_CUOTA = M.ID
                  AND (C.SALDO_CUOTA-NVL(C.REC_PENDIENTES,0)) <> 0
                  AND C.ID_CLIENTE = :P261_CLIENTE_PARAM
                  /*AND C.ID_COMPROBANTE = CC.ID
                  AND CC.id_condicion_venta = cv.id
                  AND (CV.PLAZO <> 0 OR CV.COD_CONDICION_VENTA = '9')*/ --PARA LOS SALDOS MIGRADOS 
                ```
        }
