    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @saldos
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 170
                items: {
                    P170_ID: &P261_ID_CABECERA.
                    P170_BANDERA_CARGAR: N
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button cargar (
        buttonName: CARGAR
        label: Cargar
        layout {
            sequence: 20
