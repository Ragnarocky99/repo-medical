    )

    button marcar-todo (
        buttonName: MARCAR_TODO
        label: Marcar Todo
        layout {
            sequence: 30
            region: @saldos
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--simple
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cargar-id (
        name: Cargar Id
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @saldos
            columns: SELECCIONAR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_collection_name CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => l_collection_name) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => l_collection_name);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => l_collection_name);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => l_collection_name,
                        p_c001 => :P261_ID_SALDOS
                         );
                    END;
                    ```
                itemsToSubmit: P261_ID_SALDOS
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if(id_saldos.length>1){
                        $s('P261_ID_SALDOS',id_saldos);
                        id_saldos='';
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    IF :SELECCIONAR = 'S' THEN
                    RETURN :P261_ID_SALDOS||:ID||',';
                    ELSE 
                    RETURN REPLACE (:P261_ID_SALDOS,:ID||',','');
                    END IF;
                    ```
                itemsToSubmit: [
                    ID
                    P261_ID_SALDOS
                    SELECCIONAR
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P261_ID_SALDOS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar (
        name: Inicializar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction marcar-todo (
        name: Marcar Todo
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @marcar-todo
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: marcarTodos();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

