page 128 (
    name: Carga de Condiciones de Compra
    alias: CARGA-DE-CONDICIONES-DE-COMPRA
    title: Carga de Condiciones de Compra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-condiciones-de-compra (
        name: Carga de Condiciones de Compra
        type: form
        source {
            location: localDatabase
            tableName: CMW_CONDICIONES_COMPRAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P128_COD_CONDICION_COMPRA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Condición Compra:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-condiciones-de-compra
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-condiciones-de-compra
            column: COD_CONDICION_COMPRA
            dataType: varchar2
        }
    )

    pageItem P128_COD_USUARIO_AUD (
