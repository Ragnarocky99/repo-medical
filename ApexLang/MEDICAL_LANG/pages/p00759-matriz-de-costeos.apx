    dynamicAction poner-datos-en-grilla (
        name: Poner Datos en Grilla
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @generar-rangos
        }

        action borrar-regi-det (
            name: BORRAR_REGI_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("MatrizD").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action generar-json (
            name: Generar JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      L_CURSOR        SYS_REFCURSOR;
                      JSON_DETALLE    CLOB;
                      VVALOR_MIN      NUMBER;
                      VVALOR_MAX      NUMBER;
                      VCANT_ITERACION NUMBER := FLOOR(:P759_VALOR_FINAL / :P759_INTERVALO);
                    BEGIN
                    
                        APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('RANGOS');
                    
                        FOR I IN 1..VCANT_ITERACION
                        LOOP
                            IF I = 1 THEN
                                VVALOR_MIN := :P759_VALOR_INICIAL;
                                VVALOR_MAX := :P759_VALOR_INICIAL + :P759_INTERVALO;
                            ELSE
                                VVALOR_MIN := VVALOR_MAX;
                                VVALOR_MAX := VVALOR_MAX + :P759_INTERVALO;
                            END IF;
                    
                            APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'RANGOS',
                                                       P_N001            => VVALOR_MIN,
                                                       P_N002            => VVALOR_MAX);
                        END LOOP;
                      
                        OPEN L_CURSOR FOR
                        SELECT  :P759_ID_MONEDA ID_MONEDA,
                                N001 VALOR_MIN,
                                N002 VALOR_MAX
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'RANGOS'
                        ORDER BY SEQ_ID DESC;
                    
                      APEX_JSON.INITIALIZE_CLOB_OUTPUT;
                      APEX_JSON.OPEN_OBJECT;
                      APEX_JSON.WRITE('DETALLE', L_CURSOR);
                      APEX_JSON.CLOSE_OBJECT;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P759_JSON_DETALLES:=JSON_DETALLE;
                    END;
                    ```
                itemsToSubmit: [
                    P759_VALOR_INICIAL
                    P759_VALOR_FINAL
                    P759_INTERVALO
                    P759_ID_MONEDA
                ]
                itemsToReturn: P759_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action insert-json-det (
            name: INSERT_JSON_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P759_JSON_DETALLES'));
                    
                    console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                        var grid = apex.region("MatrizD").call("getViews").grid;
                        //grid.view$.grid("option", "editable", true);
                        //editable true
                        grid.model.setOption("editable", true);
                        grid.setEditMode(true);
                    
                        for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                            //Con este codigo podemos insertar una nueva fila en el detalle de cuotas 
                    
                            var $widget = apex.region("MatrizD").widget();
                            var $grid   = $widget.interactiveGrid("getViews", "grid");
                            var $model  = $grid.model;
                                //$grid.setEditMode(true);
                    
                                //grid.model.setOption("editable", false);
                                //grid.setEditMode(false);
                                
                            //insert new record on a model
                            var newRecordId = $model.insertNewRecord();
                    
                            //continuation of above code
                            //get the new record
                    
                            var $newRecord = $model.getRecord(newRecordId);
                            orden=orden+1;
                            
                            $model.setValue($newRecord, "ID_MONEDA",(json_detalle.DETALLE[i].ID_MONEDA).toString());
                            $model.setValue($newRecord, "VALOR_MINIMO",(json_detalle.DETALLE[i].VALOR_MIN).toString().replace(/\./g,','));
                            $model.setValue($newRecord, "VALOR_MAXIMO",(json_detalle.DETALLE[i].VALOR_MAX).toString().replace(/\./g,','));
                            //$model.setValue($newRecord, "ID_PROVEEDOR",(json_detalle.DETALLE[i].ID_PROVEEDOR).toString()); //Alguien agregó esto, por eso daba error.
                        }
                        //grid.model.setOption("editable", false);
                        //grid.setEditMode(true);
                        
                    }
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

