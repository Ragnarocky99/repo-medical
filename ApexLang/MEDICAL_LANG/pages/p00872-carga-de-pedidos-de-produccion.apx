    dynamicAction setear-datos-de-la-ficha (
        name: Setear Datos de la Ficha
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P872_ID_FICHA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                      OPEN l_cursor for
                        SELECT A.ID AS ID_ARTICULO, A.DESCRIPCION, A.ID_TALLE, A.ID_COLOR
                        FROM PDW_FICHA_TECNICA FA
                        JOIN STW_ARTICULOS A ON A.ID_FICHA = FA.ID
                        JOIN STW_TALLES T ON T.ID = A.ID_TALLE
                        WHERE FA.ID = :P872_ID_FICHA
                          and (A.ID_COLOR = :P872_ID_COLOR OR :P872_ID_COLOR IS NULL)
                        ORDER BY TO_NUMBER(NVL(T.COD_TALLE,0));
                        
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P872_JSON_DETALLES:=JSON_DETALLE;
                      dbms_lock.sleep(0.1);
                    EXCEPTION 
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el detalle del pedido:'||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    P872_ID_FICHA
                    P872_ID_COLOR
                ]
                itemsToReturn: P872_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearData();
                    $model.clearChanges();
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code_1 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                      var T = $v("P872_JSON_DETALLES"), J, intento = 0, maxIntentos = 20;
                    
                      if(!T){ console.warn("P872_JSON_DETALLES vacío. No se carga nada."); return; }
                      try{ J = JSON.parse(T); }
                      catch(e){ console.error("JSON inválido:",e); apex.message.alert("El JSON de detalle no es válido."); return; }
                    
                      function txt(v){ return v===null||v===undefined?"":v.toString(); }
                      function tieneDatos(o){ return o && Object.keys(o).some(k => o[k]!==null && o[k]!==undefined && o[k]!=="" ); }
                      function setCol(model,rec,col,val){
                        if(val===null||val===undefined||val===""){ return; }
                        try{ model.setValue(rec,col,val.toString()); }
                        catch(e){ console.error("Error en columna:",col,"Valor:",val,e);
                          apex.message.alert("Error al cargar la columna "+col+". Verificá si está Read Only, Display Only o Query Only en el IG Detalles.");
                          throw e;
                        }
                      }
                    
                      function esperarIG(){
                        var ig$ = apex.region("Detalles").widget();
                        var grid = ig$.interactiveGrid("getCurrentView");
                        grid.setEditMode(true);
                        var model = grid.model;
                        console.log("Intento:",intento,"allowAdd:",model.allowAdd(),"canAdd:",model.check("canAdd"));
                        if(model.allowAdd() && model.check("canAdd")){ cargarDetalles(model,grid); return; }
                        intento++;
                        if(intento<maxIntentos){ setTimeout(esperarIG,300); return; }
                        apex.message.alert("El grid Detalles no permite agregar filas todavía. Revisá si el código se ejecuta antes del refresh del IG o si alguna configuración bloquea Add Row.");
                      }
                    
                      function cargarDetalles(model,grid){
                        try{
                          if(!J || !Array.isArray(J.DETALLE) || J.DETALLE.length===0){ console.log("No hay detalles para cargar."); return; }
                          var filas = J.DETALLE.filter(tieneDatos);
                          if(filas.length===0){ console.log("El JSON no tiene filas con datos."); return; }
                    
                          for(let i=0;i<filas.length;i++){
                            var d = filas[i];
                            if(!model.allowAdd() || !model.check("canAdd")){ throw new Error("El modelo dejó de permitir insertar en la línea "+(i+1)); }
                            var rec = model.getRecord(model.insertNewRecord());
                    
                            setCol(model,rec,"ID_ARTICULO",txt(d.ID_ARTICULO));
                            setCol(model,rec,"DESCRIPCION",txt(d.DESCRIPCION));
                            setCol(model,rec,"ID_TALLE",txt(d.ID_TALLE));
                          }
                    
                          console.log("Carga de detalles finalizada. Filas cargadas:",filas.length);
                    
                          // 🔹 refrescar la vista para que los Select List / Popup LOV muestren el display
                          setTimeout(function(){ grid.view$.grid("refresh"); },300);
                    
                        }catch(e){ console.error("Error cargando detalles:",e); }
                      }
                    
                      setTimeout(esperarIG,300);
                    })();
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action p872-id-proveedor (
            name: P872_ID_PROVEEDOR
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select id_proveedor
                      from pdw_ficha_tecnica
                     where id = :P872_ID_FICHA
                    ```
                itemsToSubmit: P872_ID_FICHA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P872_ID_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

