page 546 (
    name: Contratos
    alias: CONTRATOS
    title: Contratos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region contratos (
        name: Contratos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ID_CLIENTE,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       NRO_CONTRATO,
                       FEC_CONTRATO,
                       FEC_VENCIMIENTO,
                       PLAZO,
                       ID_MONEDA,
                       PORC_SOBRE_VTAS,
                       ID_GRUPO_LOCAL,
                       CANT_MESES_AJUSTE,
                       PORC_AJUSTE,
                       MODELO_CONTRATO,
                       TOTAL_SUP_LOCAL,
                       TOTAL_SUP_VIDRIERA,
                       INCLUIR_METRAJE,
                       OBSERVACION,
                       IMPRIMIR,
                       NOMB_ARCHIVO,
                       INCLUYE_IPC,
                       DESTINATARIO,
                       ID_PERSONA_REMITENTE,
                       REFERENCIA,
                       TOTAL_SUP_LOCAL_COMP,
                       TOTAL_SUP_VIDRIERA_COMP,
                       DESC_GRUPO_LOCAL,
                       ARRENDAMIENTO_DICIEMBRE,
                       TIP_COMPROBANTE_REF,
                       SER_COMPROBANTE_REF,
                       NRO_COMPROBANTE_REF,
                       JUSTIFICACION,
                       FECHA_ALTA,
                       AUTORIZA_GTE_GRAL,
                       AUTORIZA_GTE_COMERC,
                       FECHA_SOLICITUD,
                       ID_RUBRO,
                       ID_SUBRUBRO,
                       TOTAL_SUP_COMUN,
                       PORC_MULTA,
                       FEC_INICIO,
                       FEC_VENCIMIENTO_REAL,
                       INTERES_PUNITORIO,
                       INTERES_MORATORIO_USD,
                       INTERES_MORATORIO_GS,
                       NRO_PARTE,
                       COD_USUARIO_AUD,
                       CASE ESTADO
                       WHEN 'A' THEN 'Activo'
                       WHEN 'I' THEN 'Inactivo'
                       WHEN 'N' THEN 'EN NEGOCIACION'
                       WHEN 'J' THEN 'JUDICIAL' 
                       END AS ESTADO,
                       CASE TIPO_PLAZO
                       WHEN 'MM' THEN 'Mes(s)'
                       WHEN  'DD' THEN 'Dia(s)'
                       WHEN  'YYYY' THEN 'Años(s)'
                       END AS TIPO_PLAZO
                  from ACW_CONTRATOS_CAB
                  WHERE ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 547
                items: {
                    P547_ID: #ID#
                    P547_ID_EMPRESA: #ID_EMPRESA#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 85787530301638821
        }

