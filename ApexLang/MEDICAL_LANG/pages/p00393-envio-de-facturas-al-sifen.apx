    region grilla-envío-de-facturas-al-sifen (
        name: Grilla Envío de Facturas al SIFEN
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_VENDEDOR,
                       C.TIP_COMPROBANTE_REF,
                       C.SER_COMPROBANTE_REF,
                       C.NRO_COMPROBANTE_REF,
                       C.DESCUENTO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.TOT_COMPROBANTE,
                       C.ID_CLIENTE, 
                       DECODE(C.ESTADO,'A', 'S', 'N') ANULADO,
                       NVL(C.IND_ENVIADO_FE,'N') IND_ENVIADO,
                       'N' IND_SELECCIONADO,
                       NVL(C.IND_APROBADO_FE,'N') IND_APROBADO,
                       NVL(C.IND_RECHAZADO_FE,'N') IND_RECHAZADO_FE
                       FROM VTW_COMPROBANTES_CABECERA C,BSW_SERIES_COMPROB S
                       WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                       AND C.TIP_COMPROBANTE in ('FVE') 
                      -- and ( nvl( C.IND_ENVIADO_FE, 'N' ) = 'N' or nvl( C.ind_rechazado_fe, 'N' ) = 'S'  )
                       and trunc( c.fec_comprobante ) between nvl( :P393_FEC_DESDE, trunc( c.fec_comprobante ) ) and nvl( :P393_FEC_HASTA, trunc( c.fec_comprobante ) ) 
                       and c.nro_comprobante between nvl( :P393_NRO_DESDE, c.nro_comprobante ) and nvl( :P393_NRO_HASTA, c.nro_comprobante ) 
                       and (c.id_serie_comp = :P393_SER_COMPROBANTE OR :P393_SER_COMPROBANTE IS NULL)
                       AND c.id_serie_comp = s.id
                       and NVL(s.ind_fact_electronica,'N') = 'S'
                
                ```
            pageItemsToSubmit: [
                P393_AMBIENTE_SIFEN
                P393_SUCURSAL
                P393_SER_COMPROBANTE
                P393_FEC_DESDE
                P393_FEC_HASTA
                P393_NRO_DESDE
                P393_NRO_HASTA
            ]
        }
