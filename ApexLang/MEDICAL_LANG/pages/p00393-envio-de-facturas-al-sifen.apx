    process enviar-al-sifen (
        name: ENVIAR AL SIFEN
        type: executeCode
        editableRegion: @grilla-envío-de-facturas-al-sifen
        source {
            plsqlCode:
                ```plsql
                DECLARE
                VMENSAJE VARCHAR2(500);
                
                BEGIN
                IF NVL(:IND_SELECCIONADO,'N')='S' AND NVL(:IND_APROBADO,'X')<>'S' THEN 
                FEW_PROCESAR_UNICA_FACTURA(:ID_EMPRESA,:ID,:P393_AMBIENTE_SIFEN,VMENSAJE);
                END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 63349252929089564
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ENVIAR_SIFEN
        }
    )

    process envio-de-correo (
        name: Envio de Correo
        type: executeCode
        editableRegion: @grilla-envío-de-facturas-al-sifen
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VMENSAJE VARCHAR2(500);
                
                BEGIN
                    IF NVL(:IND_SELECCIONADO,'N')='S' AND NVL(:IND_APROBADO,'X')='S' THEN 
                        few_envia_correo(p_id_empresa => :ID_EMPRESA,
                                         p_ambiente_sifen => :P393_AMBIENTE_SIFEN,
                                         p_id_comprobante => :ID,
                                         p_enviar_correo => 'S',
                                         p_mensaje => VMENSAJE);
                    ELSIF NVL(:IND_SELECCIONADO,'N')='S' AND NVL(:IND_APROBADO,'X') = 'N' THEN 
                        RAISE_APPLICATION_ERROR(-20000,'La factura  '|| :SER_COMPROBANTE || '-' || LPAD(:NRO_COMPROBANTE, 7, 0) || 
                                                       ' seleccionada no está aprobada, por ende no se podrá enviar el correo.');
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Se ha enviado el correo.
        }
        advanced {
            executionMappingIdentifier: 63349660334089564
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ENVIAR_CORREO
        }
    )

)

