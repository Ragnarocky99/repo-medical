        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SER_TIMBRADO,ID FROM BSW_SERIES_COMPROB S
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                  AND ID_SUCURSAL=:P0_ID_SUCURSAL
                  AND NVL(IND_FACT_ELECTRONICA,'X')='S'
                  AND ID_TIP_COMP = TRAE_ID_TIPO_COMPROBANTE(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('VT','TIPO_COMPROBANTE_VENTA'));
                ```
            nullDisplayValue: --SIN SELECCIONAR---
