    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P393_FEC_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P393_FEC_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P393_FEC_HASTA,'/','');
                            conv_fecha := substr(:P393_FEC_HASTA,1,2)||'/'||
                                                      substr(:P393_FEC_HASTA,3,2)||'/'||
                                                      lpad(substr(:P393_FEC_HASTA,5,4),4,'0');
                    
                        :P393_FEC_HASTA := conv_fecha;
                            ELSIF (length(:P393_FEC_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P393_FEC_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P393_FEC_HASTA
                itemsToReturn: P393_FEC_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grilla-envío-de-facturas-al-sifen
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

