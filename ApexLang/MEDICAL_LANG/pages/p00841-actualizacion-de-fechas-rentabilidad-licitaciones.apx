    region rentabilidad-total (
        name: Rentabilidad Total
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT T.*
                  FROM (
                      SELECT ROWID,
                       (SELECT NRO_LICITACION FROM LCW_LICITACIONES_CAB WHERE ID = ID_LICITACION_CAB) NRO_LICITACION,
                       (SELECT NRO_ID_LICITACION FROM LCW_LICITACIONES_CAB WHERE ID = ID_LICITACION_CAB) NRO_ID_LICITACION,
                       (SELECT NRO_ITEM FROM LCW_LICITACIONES_DET WHERE ID = ID_LICITACION_DET) NRO_ITEM,
                       (SELECT NRO_LOTE FROM LCW_LICITACIONES_DET WHERE ID = ID_LICITACION_DET) NRO_LOTE,
                       FEC_ALTA,
                       ESTADO,
                       FEC_ESTADO,
                       FEC_ULT_ACTUALIZACION
                  FROM LCW_HISTORICO_RENTABILIDAD_TOTAL
                  ) T
                 WHERE (T.NRO_LICITACION = :P841_NRO_LICITACION OR :P841_NRO_LICITACION IS NULL)
                   AND (T.NRO_ITEM = :P841_NRO_ITEM OR :P841_NRO_ITEM IS NULL)
                   AND (T.FEC_ESTADO BETWEEN :P841_FEC_INI AND :P841_FEC_FIN OR :P841_FEC_INI IS NULL)
                ```
            pageItemsToSubmit: [
                P841_FEC_INI
                P841_FEC_FIN
                P841_NRO_LICITACION
                P841_NRO_ITEM
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        editAuthorization {
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 79177797725686106
        }

