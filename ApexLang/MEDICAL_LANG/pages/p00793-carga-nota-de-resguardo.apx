    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @detalles
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapBottom
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 792
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Guardar
        layout {
            sequence: 10
            region: @totales
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P793_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @totales
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Desea Eliminar el registro?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_USER = 'INV'
        }
    )

    button print (
        buttonName: PRINT
        label: Imprimir
        layout {
            sequence: 20
            region: @detalles
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
                t-Button--gapBottom
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @totales
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P793_ID
        }
    )

    dynamicAction abrir-lv-articulos (
        name: Abrir LV Articulos
        execution {
            sequence: 30
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_ARTICULO_lov_btn').click()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction acciones-al-iniciar (
        name: Acciones al iniciar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                        grid.model.setOption("editable", true);
                        grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction imprimir (
        name: Imprimir
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 793
                    items: {
                        P793_IND_IMPRIMIR: S
                        P793_ID: &P793_ID.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: P793_ID
                openTargetInNewWindow: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar-fila (
        name: Inicializar Fila
        execution {
            sequence: 90
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @devoluciones
        }

        action datos-de-la-linea (
            name: Datos de la Linea
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ED.ID_LICITACION_DET,
                           ED.ID_ARTICULO,
                           ED.ID_IVA,
                           ED.ID_LOTE,
                           ED.ID_UNIDAD_MEDIDA,
                           AR.COD_ARTICULO,
                           ED.DESC_ARTICULO,
                           ED.NRO_LOTE,
                           TRAE_COSTO_PROM(AR.ID_EMPRESA, AR.ID, SYSDATE) COSTO_C_IVA
                      FROM STW_ENTSAL_DET ED
                      JOIN STW_ARTICULOS  AR ON AR.ID = ED.ID_ARTICULO
                     WHERE ED.ID = :ID_ENTSAL_DET_REF
                    ```
                itemsToSubmit: ID_ENTSAL_DET_REF
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: [
                    ID_LICITACION_DET
                    ID_ARTICULO
                    ID_IVA
                    ID_LOTE
                    ID_UNIDAD_MEDIDA
                    COD_ARTICULO
                    DESC_ARTICULO
                    NRO_LOTE
                    COSTO_C_IVA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

