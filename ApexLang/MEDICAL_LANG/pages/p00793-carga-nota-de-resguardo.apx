    region nota-de-resguardo (
        name: Nota de Resguardo
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.ID,
                       EC.ID_EMPRESA,
                       EC.ID_SUCURSAL,
                       EC.ID_LICITACION_CAB,
                       EC.NUM_ENT_SAL,
                       EC.FEC_ENT_SAL,
                       EC.ID_MOTIVO_ENT_SAL,
                       EC.COD_USUARIO_AUD,
                       EC.TOT_COSTO,
                       EC.TOT_CANTIDAD,
                       EC.ID_CLIENTE,
                       EC.FEC_ALTA,
                       TIP_ENT_SAL,
                       ID_MONEDA
                  FROM STW_ENTSAL_CAB EC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

