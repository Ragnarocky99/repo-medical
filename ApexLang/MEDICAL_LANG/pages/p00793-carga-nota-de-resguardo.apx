page 793 (
    name: Carga Nota de Resguardo
    alias: CARGA-NOTA-DE-RESGUARDO
    title: Carga Nota de Resguardo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ED.ID,
                       ED.ID_ENTSAL_CAB,
                       ED.ID_EMPRESA,
                       ED.ID_SUCURSAL,
                       ID_LICITACION_DET,
                       ED.ID_ARTICULO,
                       ED.ID_IVA,
                       ED.ID_LOTE,
                       LD.COD_ARTICULO_CATALOGO,
                       LD.DESC_ARTICULO_CATALOGO,
                       AR.COD_ARTICULO,
                       ED.DESC_ARTICULO,
                       AR.ID_ENVASE,
                       ED.ID_UNIDAD_MEDIDA,
                       AR.ID_MARCA,
                       ED.NRO_LOTE,
                       ED.FEC_VENC,
                       ED.CANTIDAD,
                       ED.CANTIDAD_UB,
                       ED.COSTO_C_IVA,
                       ED.ID_ARTICULO ID_ARTICULO_H,
                       ED.ID_LOTE ID_LOTE_H
                  FROM STW_ENTSAL_DET       ED
                  JOIN LCW_LICITACIONES_DET LD ON LD.ID = ED.ID_LICITACION_DET
                  JOIN STW_ARTICULOS        AR ON AR.ID = ED.ID_ARTICULO
                 WHERE ED.ID_ENTSAL_CAB = :P793_ID
                   AND ED.ID_ENTSAL_DET_REF IS NULL
                ```
            pageItemsToSubmit: P793_ID
        }
        layout {
            sequence: 10
            parentRegion: @nota-de-resguardo
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 50331596189232631
        }

