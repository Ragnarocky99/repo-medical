        column ID_LOTE (
            type: popupLov
            heading {
                heading: <p>Nro. Lote</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT LO.NRO_LOTE, LO.ID
                      FROM STW_LOTES LO
                      JOIN STW_EXISTENCIA_ART EA ON
                           EA.ID_LOTE = LO.ID AND
                           EA.ID_SUCURSAL = :P793_ID_SUCURSAL
                     WHERE LO.ID_ARTICULO = :ID_ARTICULO
                       AND EA.CANT_DISPON > 0
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    ID_ARTICULO
                    P793_ID_SUCURSAL
                ]
                itemsToSubmit: [
                    ID_ARTICULO
                    P793_ID_SUCURSAL
                ]
            }
            layout {
                sequence: 100
                columnAlignment: center
