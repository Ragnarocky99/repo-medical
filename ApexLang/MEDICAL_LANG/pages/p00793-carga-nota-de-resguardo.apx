    region devolucion (
        name: Devolucion
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.ID,
                       EC.ID_EMPRESA,
                       EC.ID_SUCURSAL,
                       EC.NUM_ENT_SAL,
                       EC.FEC_ENT_SAL,
                       EC.ID_MOTIVO_ENT_SAL,
                       EC.COD_USUARIO_AUD,
                       EC.ID_CLIENTE,
                       EC.FEC_ALTA,
                       EC.TIP_ENT_SAL,
                       EC.ID_MONEDA,
                       EC.ID_ENTSAL_REF
                  FROM STW_ENTSAL_CAB EC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region devoluciones (
        name: Devoluciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ED.ID,
                       ED.ID_ENTSAL_CAB,
                       ED.ID_EMPRESA,
                       ED.ID_SUCURSAL,
                       ED.ID_LICITACION_DET,
                       ED.ID_ARTICULO,
                       ED.ID_IVA,
                       ED.ID_LOTE,
                       AR.COD_ARTICULO,
                       ED.DESC_ARTICULO,
                       ED.ID_UNIDAD_MEDIDA,
                       ED.NRO_LOTE,
                       ED.CANTIDAD,
                       ED.COSTO_C_IVA,
                       ED.ID_ENTSAL_DET_REF,
                       ED.COD_USUARIO_AUD,
                       ED.FEC_ALTA
                  FROM STW_ENTSAL_DET       ED
                  JOIN STW_ARTICULOS        AR ON AR.ID = ED.ID_ARTICULO
                ```
        }
        layout {
            sequence: 10
            parentRegion: @devolucion
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        masterDetail {
            masterRegion: @detalles
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
