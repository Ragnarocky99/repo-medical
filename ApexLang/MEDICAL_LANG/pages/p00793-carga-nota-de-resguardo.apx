            sqlQuery:
                ```sql
                SELECT NVL(MAX(NUM_ENT_SAL), 0) + 1
                  FROM STW_ENTSAL_CAB
                 WHERE TIP_ENT_SAL = W_BUSCA_PARAMETRO('LC', 'TIP_COMPROBANTE_NOTA_RESGUARDO')
                   AND ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P793_ID
        }
    )

    process actualiza-totales (
        name: Actualiza Totales
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE STW_ENTSAL_CAB
                   SET TOT_CANTIDAD = (SELECT SUM(ED.CANTIDAD) FROM STW_ENTSAL_DET ED WHERE ED.ID_ENTSAL_CAB = :P793_ID),
                       TOT_COSTO    = (SELECT SUM(ED.COSTO_C_IVA) FROM STW_ENTSAL_DET ED WHERE ED.ID_ENTSAL_CAB = :P793_ID)
                 WHERE ID = :P793_ID;
                
                UPDATE STW_ENTSAL_CAB
                   SET TOT_CANTIDAD = (SELECT SUM(ED.CANTIDAD) FROM STW_ENTSAL_DET ED WHERE ED.ID_ENTSAL_CAB = :P793_ID_1),
                       TOT_COSTO    = (SELECT SUM(ED.COSTO_C_IVA) FROM STW_ENTSAL_DET ED WHERE ED.ID_ENTSAL_CAB = :P793_ID_1)
                 WHERE ID = :P793_ID_1;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 50627520353219618
        }
    )

