            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID,
                       DESCRIPCION,
                       COD_CONCEPTO_FLUJO,
                       ID_EMPRESA,
                       '<span class="fa fa-plus-circle-o" aria-hidden="true"></span>' AGREGAR_DETALLE
                  FROM COW_CONCEPTOS_FLUJO_EFECTIVO
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
