    dynamicAction actualizar-reportes (
        name: Actualizar Reportes
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @conceptos-de-flujo-efectivo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @conceptos-flujo-detalle
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar-grila (
        name: Inicializar Grila
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("CFE").call("getViews").grid;
                    grid.model.setOption("editable", true);
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction inicializar-grilla-cfd (
        name: Inicializar Grilla CFD
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @conceptos-flujo-detalle-master
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: i = apex.region("CFD").widget().interactiveGrid("getViews", "grid").model.getTotalRecords();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action orden (
            name: ORDEN
            action: setValue
            settings {
                type: jsExpression
                jsExpression: i
            }
            affectedElements {
                selectionType: columns
                columns: ORDEN
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: ORDEN
            }
        )

    )

    dynamicAction inicializar-grilla-cfe (
