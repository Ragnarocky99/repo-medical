    pageItem P774_ID_CHOFER (
        type: popupLov
        label {
            label: <P>Chofer: &ensp;</P>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-choferes
        }
        layout {
            sequence: 70
            region: @datos
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 50
        }
        advanced {
            customAttributes: TABINDEX="7"
        }
        source {
            formRegion: @/remisiones
            column: ID_CHOFER
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression:
                ```plsql
                TRAE_ID_CHOFER(P_ID_EMPRESA => :P0_ID_EMPRESA,
                               P_COD_CHOFER => W_BUSCA_PARAMETRO('RP', 'COD_CHOFER_DEF'))
                ```
