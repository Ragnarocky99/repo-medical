    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @datos
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button talonario (
        buttonName: Talonario
        label: Talonario
        layout {
            sequence: 20
            region: @datos
            slot: change
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--simple
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-number-0-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @talonario
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P774_ID_SERIE_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction agregar-botones (
        name: Agregar Botones
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action plugin-hr-bilog-extendigtoolbar (
            action: plugin/interactiveGridExtendToolbar
            settings {
                label: Generar Remision
                hot: true
                icon: fa-dot-circle-o
                triggerAction: gen_remision
            }
            affectedElements {
                selectionType: region
                region: @remisiones-pendientes
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P774_ID_CLIENTE
                P774_NRO_OCC
                P774_NRO_ID_LICITACION
