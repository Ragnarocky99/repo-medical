    validation no-superar-cantidad-pendiente (
        name: No superar cantidad pendiente
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @remisiones-pendientes
            plsqlExpression: TO_NUMBER(:CANT_A_REMISIONAR) <= TO_NUMBER(:CANTIDAD_A_ENTREGAR)
        }
        error {
            errorMessage: La cantidad a remisionar no puede superar a la cantidad pendiente
            associatedColumn: CANT_A_REMISIONAR
        }
    )

    process remisiones-pendientes-save-interactive-grid-data (
        name: Remisiones Pendientes - Save Interactive Grid Data
        type: executeCode
        editableRegion: @remisiones-pendientes
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    CASE :APEX$ROW_STATUS
                    WHEN 'C' THEN
                        NULL;
                    WHEN 'U' THEN
                        IF :CANT_A_REMISIONAR IS NOT NULL THEN
                            UPDATE LCW_OFERTAS_APROBACIONES
                               SET CANT_A_ENTREGAR = :CANT_A_REMISIONAR
                             WHERE ID = :ID;
                        END IF;
                
                        UPDATE LCW_LICITACIONES_DET
                           SET AGRUPACION_REMISION = :AGRUPACION_REMISION
                      WHERE ID = :ID_LICITACION_DET;
                    WHEN 'D' THEN
                        NULL;
                    END CASE;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 39981087645259444
        }
    )

)

