page 774 (
    name: Generacion de Remisiones - Catalogo
    alias: GENERACION-DE-REMISIONES-CATALOGO
    title: Generacion de Remisiones - Catalogo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region datos (
        name: Datos
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region remisiones-pendientes (
        name: Remisiones Pendientes
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: LCWV_REMISIONES_CATALOGO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P774_ID_CLIENTE OR :P774_ID_CLIENTE IS NULL) AND
                (NRO_OCC = :P774_NRO_OCC OR :P774_NRO_OCC IS NULL) AND
                (NRO_ID_LICITACION = :P774_NRO_ID_LICITACION OR :P774_NRO_ID_LICITACION IS NULL) AND
                ID_SUCURSAL = :P0_ID_SUCURSAL
                ```
            pageItemsToSubmit: [
                P774_ID_CLIENTE
                P774_NRO_OCC
                P774_NRO_ID_LICITACION
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 39978900249259423
        }

