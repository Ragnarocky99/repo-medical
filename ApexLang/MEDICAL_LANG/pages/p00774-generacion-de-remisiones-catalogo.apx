    dynamicAction generar-remision (
        name: Generar remision
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: gen_remision
            selectionType: region
            region: @remisiones-pendientes
        }

        action native-alert (
            action: alert
            settings {
                message: &P774_MENSAJE_PROCEDIMIENTO.
                style: information
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                componentType: item
                item: P774_MENSAJE_PROCEDIMIENTO
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P774_IDS := NULL;
                    :P774_MENSAJE_PROCEDIMIENTO := NULL;
                    ```
                itemsToReturn: [
                    P774_IDS
                    P774_MENSAJE_PROCEDIMIENTO
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: :P774_IDS  := SUBSTR(:P774_IDS, 1, LENGTH(:P774_IDS) - 1);
                itemsToSubmit: P774_IDS
                itemsToReturn: P774_IDS
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        STWP_GENERA_REMISION_CATALOGO(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                                      P_ID_SERIE => :P774_ID_SERIE,
                                                      P_ID_CHOFER => :P774_ID_CHOFER,
                                                      --P_ID_CIUDAD_ENVIO => :P774_ID_CIUDAD_ENV,
                                                      P_IDS => :P774_IDS,
                                                      P_MENSAJE => :P774_MENSAJE_PROCEDIMIENTO,
                                                      P_ID_REMISION => :P774_IDS);
                    EXCEPTION
                        WHEN OTHERS THEN
                            :P774_MENSAJE_PROCEDIMIENTO := SQLERRM;
                    END;
                    ```
                itemsToSubmit: [
                    P774_IDS
                    P774_ID_SERIE
                    P774_ID_CHOFER
                    P774_ID_CIUDAD_ENV
                ]
                itemsToReturn: P774_MENSAJE_PROCEDIMIENTO
                showProcessing: true
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @remisiones-pendientes
            }
            execution {
                sequence: 110
                fireOnInit: false
            }
        )

        action plugin-com-fos-interactive-grid-process-rows (
            action: plugin/fosInteractiveGridProcessRows
            settings {
                action: processSelectedRows
                plSqlCode: :P774_IDS := NVL(:P774_IDS, '')||:ID||':';
                itemsToSubmit: [
                    ID
                    CANT_A_REMISIONAR
                ]
                itemsToReturn: P774_IDS
                errorMessage: #SQLERRM#
                extraOptions: refreshSelectionAfterProcessing
            }
            affectedElements {
                selectionType: region
                region: @remisiones-pendientes
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
