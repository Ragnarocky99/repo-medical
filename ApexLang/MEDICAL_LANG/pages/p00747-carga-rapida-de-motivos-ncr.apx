page 747 (
    name: Carga rapida de Motivos NCR
    alias: CARGA-RAPIDA-DE-MOTIVOS-NCR
    title: Carga rapida de Motivos NCR
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region motivos-ncr (
        name: Motivos NCR
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: VTW_MOTIVOS_NCR
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 25648733868927682
        }

        savedReport 256492 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @COD_MOTIVO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESC_MOTIVO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID_CUENTA
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @IND_AFECTA_STOCK
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_MOTIVO (
            type: textField
            heading {
                heading: <p>Cod. Motivo</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
                maxLength: 5
            }
            source {
                databaseColumn: COD_MOTIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
            }
            default {
                type: expression
                plsqlExpression: :APP_USER
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DESC_MOTIVO (
            type: textField
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 80
            }
            source {
                databaseColumn: DESC_MOTIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_CUENTA (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ID_CUENTA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IND_AFECTA_STOCK (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IND_AFECTA_STOCK
                dataType: varchar2
            }
            default {
                type: static
                staticValue: S
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Motivos NCR
        }
    )

    process carga-rapida-de-motivos-ncr-save-interactive-grid-data (
        name: Carga rapida de Motivos NCR - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @motivos-ncr
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25658469233927687
        }
    )

)

