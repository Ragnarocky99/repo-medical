page 291 (
    name: Grupos de Contacto
    alias: GRUPOS-DE-CONTACTO
    title: Grupos de Contacto
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region grupos-de-contacto (
        name: Grupos de Contacto
        type: interactiveReport
        source {
            location: restSource
            restSource: @Grupos_de_Contactos
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 294
                items: {
                    P294_ID: #ID#
                    P294_NOMBRE: #NAME#
                }
            }
            linkIcon: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            linkAttributes: style="width:10px"
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 67262649562343779
        }

        column ID (
            type: plainText
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Nombre
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grupos de Contacto
        }

        savedReport 672639 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ID (
                sequence: 1
            )

            displayColumn NAME (
                sequence: 2
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @grupos-de-contacto
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 294
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refrescar (
        name: "Refrescar "
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @grupos-de-contacto
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grupos-de-contacto
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @crear
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grupos-de-contacto
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

