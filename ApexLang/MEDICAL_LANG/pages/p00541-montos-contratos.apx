    button generate (
        buttonName: GENERATE
        label: Generar Fechas
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-right
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction generar-fecha (
        name: Generar Fecha
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @generate
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      cont_mes number(5) := 0; --contador de meses
                      dia_cont number(2) := 0; --contador de dias
                      tip_plazo varchar2(5):=:P541_TIP_PLAZO;
                    
                      monto number(18, 2) := 0;
                    
                      --inicializar las variables para generar los registros
                      fec_inicial date := TO_DATE(:P541_fec_desde, 'DD/MM/YYYY'); ---:b_cabecera.fec_inicio; ----fec_contrato;
                      fec_final   date := TO_DATE(:P541_fec_vencimiento, 'DD/MM/YYYY');
                      --dia_cobro       number := concepto_dia_cobro(P541_CONCEPTO);
                      vplazo number(2) := :P541_PLAZO;
                      vorden number(10) := 0;
                    
                      decimales number(1) := moneda_decimales(:P541_ID_MONEDA); --utilizado para el redondeo de los montos generados
                      tmp_montos CONSTANT VARCHAR2(8) := 'MONTOS';
                      l_cursor SYS_REFCURSOR;
                      vcuota number(5) := 0 ;
                      vmonto_total number(18,2):=nvl(REPLACE(:P541_monto_gasto, '.', ''), 0);
                      vmonto_cuota number(18,2):=0;
                      vimporte number(18,2):=0;
                      v_total_cuotas number(5):=0;
                    begin
                    
                    vmonto_cuota:=ROUND(vmonto_total/vplazo,decimales);
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_MONTOS) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_MONTOS);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_MONTOS);
                    
                    
                      LOOP
                        -- que no exeda a la fecha de finalizacion del contrato
                        dia_cont := to_number(to_char(fec_inicial, 'DD'));
                        --  if (dia_cont = dia_cobro) then 
                        cont_mes := cont_mes + 1;
                        vorden   := vorden + 1;
                      
                        if ((cont_mes mod :P541_cant_meses_ajuste) = 0 and :P541_concepto = '6') then
                          monto := round(monto + (round(monto * nvl(:P541_porc_ajuste, 0) / 100,
                                                        decimales)),
                                         decimales);
                        end if;
                      
                        if (fec_inicial + 1 < fec_final) then
                    
                    
                              vcuota:=nvl(vcuota,0)+1;
                    
                           IF vcuota = vplazo THEN
                                vimporte := round( vmonto_total / vplazo, decimales );
                                monto := vmonto_total - ( vimporte * ( vplazo - 1 ) );
                              ELSE
                                IF TO_NUMBER(vmonto_total) > ( TO_NUMBER(vmonto_cuota) * ( TO_NUMBER(v_total_cuotas) + 1 ) ) THEN
                                  monto := vmonto_cuota;
                                ELSE
                                  monto := vmonto_total - (vmonto_cuota * (v_total_cuotas));
                                END IF;
                              END IF;
                              
                        
                          APEX_COLLECTION.ADD_MEMBER(p_collection_name => TMP_MONTOS,
                                                     p_c001            => vorden,
                                                     p_c002            => fec_inicial,
                                                     p_c003            => NVL(:P541_PORCENTAJE_GASTO,0),
                                                     p_c004            => monto, 
                                                     p_c005            => :P541_ID_MONEDA_FACTURACION,
                                                     p_c006            =>TO_CHAR(fec_inicial,'mm'),
                                                     p_c007           => TO_CHAR(fec_inicial,'yyyy')
                                                     );
                        end if;
                        --  end if;
                    
                    	  if    tip_plazo =  'DD' then 
                    	  	FEC_INICIAL := fec_INICIAL+1;
                    	  elsif tip_plazo =  'MM' then
                    	  	FEC_INICIAL:= add_months(FEC_INICIAL,1);
                    	  elsif tip_plazo =  'YYYY' then
                    	  	FEC_INICIAL:= add_months(FEC_INICIAL,1);
                          END IF;
                    
                    
                    v_total_cuotas:=v_total_cuotas+1;
                    
                       -- fec_inicial := fec_inicial + 1;
                        if (fec_inicial > fec_final) or cont_mes = nvl(vplazo, 0) then
                          EXIT;
                        end if;
                      END LOOP;
                    
                      ----mensaje('mmm '||vcont||' '||vplazo);
                    
                    OPEN l_cursor FOR
                        SELECT C001 AS "ORDEN",
                              C002 AS "FEC_INICIAL",
                              C003 AS "PORCENTAJE",
                              C004 AS "MONTO",
                              C005 AS "ID_MONEDA" ,
                              C006 AS "MES",
                              C007 AS "ANIO" 
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME=TMP_MONTOS
                        ORDER BY TO_NUMBER(ORDEN) DESC;
                    
                        APEX_JSON.initialize_clob_output;
                        APEX_JSON.open_object;
                        APEX_JSON.WRITE('DETALLE',l_cursor);
                        APEX_JSON.close_object;
                    
                      :P541_JSON := APEX_JSON.GET_CLOB_OUTPUT;
                      EXCEPTION
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000,'Error al generar las fechas: '||sqlerrm);
                    end;
                    
                    ```
                itemsToSubmit: [
                    P541_CONCEPTO
                    P541_ID_SUCURSAL
                    P541_FEC_CONTRATO
                    P541_FEC_VENCIMIENTO
                    P541_MONTO_GASTO
                    P541_FEC_DESDE
                    P541_PLAZO
                    P541_ID_MONEDA
                    P541_CANT_MESES_AJUSTE
                    P541_PORC_AJUSTE
                    P541_ID_MONEDA_FACTURACION
                    P541_PORCENTAJE_GASTO
                ]
                itemsToReturn: P541_JSON
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P541_JSON'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de montos
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    orden=orden+1;
                    $model.setValue($newRecord, "NRO_ORDEN",(json_detalle.DETALLE[i].ORDEN).toString());
                    $model.setValue($newRecord, "FECHA_COBRO",(json_detalle.DETALLE[i].FEC_INICIAL).toString());
                    $model.setValue($newRecord, "PORCENTAJE",(json_detalle.DETALLE[i].PORCENTAJE).toString());
                    $model.setValue($newRecord, "MONTO",(json_detalle.DETALLE[i].MONTO).toString());
                    $model.setValue($newRecord, "ID_MONEDA",(json_detalle.DETALLE[i].ID_MONEDA).toString());
                    $model.setValue($newRecord, "ANIO",(json_detalle.DETALLE[i].ANIO).toString());
                    $model.setValue($newRecord, "MES",(json_detalle.DETALLE[i].MES).toString());
                    
                    
                    
                    
                    
                    
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @contratos-montos
            columns: FECHA_COBRO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if TO_DATE(:FECHA_COBRO,'DD/MM/YYYY') 
                    < TO_DATE(:P541_fec_contrato,'DD/MM/YYYY') or TO_DATE(:FECHA_COBRO,'DD/MM/YYYY')
                     >  TO_DATE(:P541_FEC_VENCIMIENTO,'DD/MM/YYYY')
                    	then 
                    	RAISE_APPLICATION_ERROR
                        (-20000,'Error La fecha de cobro debe estar dentro del rango fecha contrato - vencimiento');
                    end if;
                    ```
                itemsToSubmit: [
                    FECHA_COBRO
                    P541_FEC_CONTRATO
                    P541_FEC_VENCIMIENTO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process cargar-datos-de-contrato (
        name: Cargar Datos de Contrato
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                
                
                
                
                SELECT D.MONTO_GASTO,D.FEC_DESDE,C.PLAZO,D.ID_MONEDA,C.CANT_MESES_AJUSTE,C.PORC_AJUSTE,D.ID_MONEDA_FACTURACION,D.PORCENTAJE_GASTO,TIPO_PLAZO
                INTO :P541_MONTO_GASTO,:P541_FEC_DESDE,:P541_PLAZO,:P541_ID_MONEDA,:P541_CANT_MESES_AJUSTE,:P541_PORC_AJUSTE,:P541_ID_MONEDA_FACTURACION,:P541_PORCENTAJE_GASTO,:P541_TIP_PLAZO 
                FROM ACW_CONTRATOS_CAB C , ACW_CONTRATOS_DET D
                WHERE C.ID=D.ID_CONTRATO_CAB
                AND D.ID=:P541_ID_CONTRATO_DET;
                
                
                
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 86227995957411524
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: SELECT COUNT(*) FROM ACW_CONTRATOS_MONTOS WHERE ID_CONTRATO_DET=:P541_ID_CONTRATO_DET
        }
    )

    process contratos-montos-save-interactive-grid-data (
        name: Contratos Montos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @contratos-montos
        execution {
            sequence: 20
