        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 850
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var orden=0;
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:12.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;}
            .ocultar{
            display: none;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region contratos-montos (
        name: Contratos Montos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ID_ARTICULO,
                       FECHA_COBRO,
                       PORCENTAJE,
                       MONTO,
                       ID_MONEDA,
                       ID_CONTRATO_DET,
                       FACTURADO,
                       MES,
                       ANIO,
                       NRO_ORDEN,
                       ID_CONTRATO_CAB
                  from ACW_CONTRATOS_MONTOS
                 where ID_EMPRESA=:P0_ID_EMPRESA
                AND ID_CONTRATO_DET=:P541_ID_CONTRATO_DET
                ```
            pageItemsToSubmit: P541_ID_CONTRATO_DET
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 83585337680382449
        }

