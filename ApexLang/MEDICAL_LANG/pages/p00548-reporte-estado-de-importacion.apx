page 548 (
    name: Reporte Estado de Importacion
    alias: REPORTE-ESTADO-DE-IMPORTACION
    title: Reporte Estado de Importacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads: document.getElementById("P548_CONCEP_DESC").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @filtros
            slot: regionBody
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noBorder
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region importacion (
        name: Importacion
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.*
                FROM CMWV_IMPORTACION_ESTADO C
                WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (C.ID_CONCEPTO = :P548_ID_CONCEPTO OR :P548_ID_CONCEPTO IS NULL)
                  AND (C.ID_PROVEEDOR = :P548_ID_PROVEEDOR OR :P548_ID_PROVEEDOR IS NULL)
                  AND (C.FEC_EMBARQUE BETWEEN :P548_FEC_INI AND :P548_FEC_FIN OR (:P548_FEC_INI IS NULL OR :P548_FEC_FIN IS NULL))
                ```
            pageItemsToSubmit: [
                P548_ID_CONCEPTO
                P0_ID_EMPRESA
                P548_FEC_INI
                P548_FEC_FIN
                P548_ID_PROVEEDOR
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 154420098082927521
        }

