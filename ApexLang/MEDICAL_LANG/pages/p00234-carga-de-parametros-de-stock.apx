page 234 (
    name: Carga de Parametros  de Stock
    alias: CARGA-DE-PARAMETROS-DE-STOCK
    title: Carga de Parametros  de Stock
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-parametros-de-stock (
        name: Carga de Parametros  de Stock
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ID_RUBRO,
                       ID_IVA,
                       ID_CUENTA_STOCK,
                       ID_CUENTA_COSTO_CO,
                       ID_CUENTA_COSTO_CR,
                       ID_CUENTA_VENTA_CO,
                       ID_CUENTA_VENTA_CR,
                       ID_CUENTA_NOTCRE_CO,
                       ID_CUENTA_NOTCRE_CR,
                       ID_CUENTA_COSTO,
                       ID_CUENTA_VENTA,
                       ID_CUENTA_VENTA_OBS,
                       ID_CUENTA_COSTO_OBS,
                       ID_CUENTA_FONDO_OBS,
                       ID_CUENTA_STOCK_OBS,
                       COD_USUARIO_AUD,
                       IND_NOTA_CREDITO,
                       ID_MOTIVO_NCR,
                       ID_CUENTA_IVA,
                       ID_GRUPO
                  from COW_PARAM_CONTABLES_ST
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P234_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 30
            region: @carga-de-parametros-de-stock
            slot: regionBody
        }
        source {
            formRegion: @carga-de-parametros-de-stock
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
    )

    pageItem P234_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-parametros-de-stock
            slot: regionBody
        }
        source {
            formRegion: @carga-de-parametros-de-stock
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

