    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 20
            region: @series-de-comprobantes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 144
                clearCache: 144
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button limpiar (
        buttonName: lIMPIAR
        label: Limpiar
        layout {
            sequence: 10
            region: @series-de-comprobantes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-eraser
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @series-de-comprobantes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @series-de-comprobantes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P143_NRO_TIMBRADO
                P143_ID_MODULO
                P143_TIP_COMPROBANTE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @series-de-comprobantes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar (
        name: LIMPIAR
        type: clearSessionState
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 7709694783460805
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17351830375440490
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

