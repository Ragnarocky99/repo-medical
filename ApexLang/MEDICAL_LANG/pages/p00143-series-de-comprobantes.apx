page 143 (
    name: Series de Comprobantes
    alias: SERIES-DE-COMPROBANTES
    title: Series de Comprobantes - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region series-de-comprobantes (
        name: Series de Comprobantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  SC.ID,
                        SC.ID_EMPRESA,
                        SC.TIP_COMPROBANTE,
                        TC.DESCRIPCION as DESCRIPCION_TIP_COMPROBANTE,
                        M.COD_MODULO,
                        SC.SER_COMPROBANTE,
                        SC.SER_ARTICULO,
                        SC.NUM_INICIAL,
                        SC.NUM_FINAL,
                        SC.TIP_IMPUESTO,
                        SC.SER_TIMBRADO,
                        SC.NRO_TIMBRADO,
                        SC.FEC_VIGENCIA,
                        SC.FEC_INICIO,
                        SC.FEC_VENCIMIENTO,
                        SC.IND_MOV_CAJA,
                        CASE IND_MOV_CAJA
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_MOV_CAJA_ICON,
                        SC.IND_AUTO_IMPRESION,
                        CASE IND_AUTO_IMPRESION
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_AUTO_IMPRESION_ICON,
                        SC.IND_EXENTO,
                        CASE IND_EXENTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_EXENTO_ICON,
                        SC.IND_AUTO_IMPRESION_TICKET,
                        CASE IND_AUTO_IMPRESION_TICKET
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_AUTO_IMPRESION_TICKET_ICON,
                        SC.IND_ACTIVO,
                        CASE IND_ACTIVO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_ACTIVO_ICON,
                        SC.IND_FACT_ELECTRONICA,
                        CASE IND_FACT_ELECTRONICA
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_FACT_ELECTRONICA_ICON,
                        SC.ID_SUCURSAL,
                        SC.TERMINAL,
                        SC.COD_USUARIO_AUD
                from    BSW_SERIES_COMPROB SC, BSW_TIPOS_COMPROBANTES TC, BSW_MODULOS M
                where   SC.TIP_COMPROBANTE = TC.TIP_COMPROBANTE
                    and TC.ID_MODULO = M.ID
                    and SC.ID_TIP_COMP(+) = TC.ID
                    AND (SC.NRO_TIMBRADO=:P143_NRO_TIMBRADO OR :P143_NRO_TIMBRADO IS NULL)
                    AND (M.ID=:P143_ID_MODULO OR :P143_ID_MODULO IS NULL)
                    AND (SC.ID_TIP_COMP=:P143_TIP_COMPROBANTE OR :P143_TIP_COMPROBANTE IS NULL)
                ```
            pageItemsToSubmit: [
                P143_NRO_TIMBRADO
                P143_ID_MODULO
                P143_TIP_COMPROBANTE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 144
                items: {
                    P144_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchField: false
        }
        advanced {
            savedReportMappingIdentifier: 15590874340943351
        }

