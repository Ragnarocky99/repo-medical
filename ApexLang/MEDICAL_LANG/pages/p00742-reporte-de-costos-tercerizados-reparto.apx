    dynamicAction imprimir (
        name: Imprimir
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 748
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: [
                    P742_FEC_INI_PLANILLA
                    P742_FEC_FIN_PLANILLA
                    P742_NRO_PLANILLA
                    P742_ID_CLIENTE
                    P742_ID_PROVEEDOR
                    P742_NRO_SOLICITUD
                    P742_ID_REPARTIDOR
                ]
                openTargetInNewWindow: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-de-costos-tercerizados-reparto
            }
            execution {
