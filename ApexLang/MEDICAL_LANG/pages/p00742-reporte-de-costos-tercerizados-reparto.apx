    region reporte-de-costos-tercerizados-reparto (
        name: Reporte de Costos Tercerizados - Reparto
        type: interactiveReport
        source {
            location: localDatabase
            tableName: RPWV_COSTOS_TERCERIZADO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FEC_PLANILLA BETWEEN :P742_FEC_INI_PLANILLA AND :P742_FEC_FIN_PLANILLA AND
                (NRO_PLANILLA = :P742_NRO_PLANILLA OR :P742_NRO_PLANILLA IS NULL) AND
                (NRO_SOLICITUD = :P742_NRO_SOLICITUD OR :P742_NRO_SOLICITUD IS NULL) AND
                (ID_REPARTIDOR = :P742_ID_REPARTIDOR OR :P742_ID_REPARTIDOR IS NULL) AND
                (ID_CLIENTE = :P742_ID_CLIENTE OR :P742_ID_CLIENTE IS NULL) AND
                (ID_PROVEEDOR = :P742_ID_PROVEEDOR OR :P742_ID_PROVEEDOR IS NULL)
                ```
            orderByClause: FEC_PLANILLA DESC
            pageItemsToSubmit: [
                P742_FEC_INI_PLANILLA
                P742_FEC_FIN_PLANILLA
                P742_NRO_PLANILLA
                P742_ID_CLIENTE
                P742_ID_PROVEEDOR
                P742_NRO_SOLICITUD
                P742_ID_REPARTIDOR
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 24549521591739853
        }

