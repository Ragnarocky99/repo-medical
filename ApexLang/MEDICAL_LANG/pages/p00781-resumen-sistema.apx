    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-sistema
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

