    region resumen-sistema (
        name: Resumen Sistema
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID_EMPRESA,
                       SUCURSAL,
                       FEC_LICITACION,
                       NRO_LICITACION,
                       NRO_ID_LICITACION,
                       NRO_ITEM,
                       NRO_LOTE,
                       COD_ARTICULO_CATALOGO,
                       DESC_ARTICULO_CATALOGO,
                       PRESENTACION_CATALOGO,
                       UNIDAD_MEDIDA_CATALOGO,
                       COD_FABRICANTE,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       PRESENTACION,
                       UNIDAD_MEDIDA,
                       MARCA,
                       COD_CLIENTE,
                       CLIENTE,
                       COTIZA_UNITARIO,
                       MONTO_TOTAL_APROBADO,
                       NRO_OCC,
                       FEC_OCC,
                       FEC_PLAZO,
                       CANT_APROBADA,
                       CANT_ANULADA,
                       CANT_REAL,
                       CANT_ENTREGADA,
                       CANT_PEND_A_ENTREGAR,
                       ESTADO_OCC,
                       ESTADO_VINCULACION,
                       ID_CLIENTE,
                       ID_OFERTA,
                       ID_ARTICULO,
                       ID_LICITACION_CAB,
                       ID_SUCURSAL,
                       CANT_RESERVADA,
                       STOCK,
                       PLAZO_ENTREGA,
                       COSTO_UNITARIO,
                       ID_PROVEEDOR,
                       COMENTARIO_COMPRAS,
                       IND_NO_MOSTRAR,
                       OBS_GESTION_OCP,
                       DISPONIBILIDAD,
                       TIP_COMPROBANTE,
                       ID_UNIDAD_MEDIDA,
                       ID_ENVASE,
                       ID_MARCA,
                       ID_GRUPO_ART,
                       ID_RUBRO,
                       ID_CONDICION_COMPRA,
                       ID_TIPO_ENTREGA,
                       IND_CONTROLADO,
                       PRECIO_UNITARIO,
                       PRECIO_TOTAL,
                       MARGEN_TOTAL,
                       NRO_DIAS,
                       ID_VENDEDOR,
                       ID_MONEDA_PRESUPUESTO,
                       TIP_CAMBIO_PRESUPUESTO,
                       ID_PERSONA_VENDEDOR,
                       ID_SOPORTE,
                       SOPORTE,
                       ES_PELIGROSO,
                       PORC_MARGEN,
                       FEC_ALTA,
                       STOCK_TOTAL - NVL((SELECT SUM(B.CANT_BLOQUEO)
                                      FROM STWV_ARTICULOS_BLOQUEO B
                                     WHERE B.ID_ARTICULO = RS.ID_ARTICULO
                                       AND B.CANT_BLOQUEO > 0), 0) DISPONIBILIDAD_TOTAL,
                       RS.CANT_DEVUELTA
                  FROM LCWV_RESUMEN_SISTEMA RS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P781_ID_CLIENTE OR :P781_ID_CLIENTE IS NULL) AND
                (NRO_OCC = :P781_NRO_OCC OR :P781_NRO_OCC IS NULL) AND
                (NRO_ID_LICITACION = :P781_NRO_ID_LICITACION OR :P781_NRO_ID_LICITACION IS NULL) AND
                FEC_LICITACION BETWEEN :P781_FEC_INI AND :P781_FEC_FIN AND
                (ID_ARTICULO = :P781_ID_ARTICULO OR :P781_ID_ARTICULO IS NULL) AND
                (NRO_ITEM = :P781_NRO_ITEM OR :P781_NRO_ITEM IS NULL) AND
                (ESTADO_OCC = :P781_ESTADO_OCC OR :P781_ESTADO_OCC IS NULL) AND
                (ESTADO_VINCULACION = :P781_ESTADO_VINCULACION OR :P781_ESTADO_VINCULACION IS NULL) AND
                (NRO_LICITACION = :P781_NRO_LICITACION OR :P781_NRO_LICITACION IS NULL)
                ```
            pageItemsToSubmit: [
                P781_FEC_INI
                P781_FEC_FIN
                P781_ID_CLIENTE
                P781_NRO_LICITACION
                P781_NRO_OCC
                P781_ID_ARTICULO
                P781_NRO_ITEM
                P781_ESTADO_OCC
                P781_ESTADO_VINCULACION
                P781_NRO_ID_LICITACION
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 82823154213191310
        }

