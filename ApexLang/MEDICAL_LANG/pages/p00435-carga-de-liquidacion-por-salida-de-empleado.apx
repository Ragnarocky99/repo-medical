    region carga-de-liquidacion-por-salida-de-empleado (
        name: Carga de Liquidacion por Salida de Empleado
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID, C.SER_LIQUID, C.NRO_LIQUID, C.FEC_LIQUID, C.ID_EMPRESA,
                C.MONTO, C.MES, C.ANIO, C.ID_EMPLEADO, C.ID_MOTIVO_SALIDA, C.SUELDO_BASE, C.DIAS,
                C.SUELDO_FINAL, C.SUELDO_PROMEDIO, C.TIP_LIQUID, C.COD_USUARIO_AUD
                FROM RHW_CABECERA_LIQ C 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT D.ID_CAB_LIQUID, D.ID_EMPRESA, D.ID, D.ID_CONCEPTO, 
                       D.TIPO, D.CANTIDAD, 
                       D.MONTO, 
                       D.OBSERVACION, D.ID_EMPLEADO, D.MONTO AS MONTO_COPIA,
                       D.NRO_ORDEN, D.COD_USUARIO_AUD 
                FROM RHW_DETALLE_LIQ D
                WHERE D.ID_CAB_LIQUID=:P435_ID;
                ```
            pageItemsToSubmit: P435_ID
        }
        layout {
            sequence: 10
            parentRegion: @carga-de-liquidacion-por-salida-de-empleado
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
