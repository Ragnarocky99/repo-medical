page 435 (
    name: Carga de Liquidacion por Salida de Empleado
    alias: CARGA-DE-LIQUIDACION-POR-SALIDA-DE-EMPLEADO
    title: Carga de Liquidacion por Salida de Empleado
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_monto_detalle    = model.getFieldKey("MONTO_COPIA");
                //var v_cambio       = $v("P235_TIPO_CAMBIO");
                var v_monto_total     = 0;
              
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
            
                          
                        v_monto_total     = v_monto_total     + parseFloat(r[v_monto_detalle].replace(/\./g,''));
                       
                    }
                    
                    
                });
            
                //v_cambio_debe = ( v_mon_debe * parseFloat(v_cambio.replace(/\./g,'')) );
                //v_cambio_haber = ( v_mon_haber * parseFloat(v_cambio.replace(/\./g,'')));
            
                 $s('P435_TOTAL',v_monto_total.toString().replace('.', ''));
            
                 //console.log('cambio es '+ v_cambio_debe + " | " + v_cambio_haber);
            
            }
            ```
        executeWhenPageLoads: document.getElementById("P435_TOTAL").readOnly = true;
    }
