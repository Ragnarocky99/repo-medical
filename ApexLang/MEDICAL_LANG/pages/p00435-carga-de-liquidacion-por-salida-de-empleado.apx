    process detalle-save-interactive-grid-data-copy (
        name: Detalle - Save Interactive Grid Data_copy
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalle
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                                insert into RHW_DETALLE_LIQ(D.ID_CAB_LIQUID, D.ID, D.ID_CONCEPTO, D.TIPO, D.CANTIDAD, D.MONTO, D.OBSERVACION,
                D.COD_USUARIO_AUD)
                		        values (:P435_ID, )
                WHEN 'U' then 
                   
                                update 
                                    set 
                 where   ID_DIARIO_CAB = :P235_ID
                                    and d.ID = :ID;
                             
                when 'D' then
                                delete COW_DIARIO_DETALLES_PROV d     
                                WHERE d.ID_DIARIO_CAB = :P235_ID
                                           and d.ID = :ID;  
                    end case;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 37489212024953737
        }
        serverSideCondition {
            type: never
        }
    )

