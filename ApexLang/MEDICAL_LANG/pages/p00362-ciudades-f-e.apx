page 362 (
    name: Ciudades F.E.
    alias: CIUDADES-F-E
    title: Ciudades F.E.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ciudades-f-e (
        name: Ciudades F.E.
        type: interactiveReport
        source {
            location: localDatabase
            tableName: FEW_CIUDADES
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 371
                items: {
                    P371_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 22630944355079437
        }

        column COD_CIUDAD (
            type: plainText
            heading {
                heading: Código Ciudad
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column COD_DEPARTAMENTO (
            type: plainTextBasedOnLov
            heading {
                heading: Departamento
                alignment: center
            }
            lov {
                lov: @lv-depto-fe
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_DISTRITO (
            type: plainTextBasedOnLov
            heading {
                heading: Distrito
                alignment: center
            }
            lov {
                lov: @lv-distritos-fe
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_PAIS (
            type: plainTextBasedOnLov
            heading {
                heading: País
                alignment: center
            }
            lov {
                lov: @lv-paises-fe
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Ciudades F.E.
        }

        savedReport 226494 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CIUDAD (
                sequence: 1
            )

            displayColumn COD_DEPARTAMENTO (
                sequence: 4
            )

            displayColumn COD_DISTRITO (
                sequence: 5
            )

            displayColumn COD_PAIS (
                sequence: 3
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            sort (
                column: COD_CIUDAD
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @ciudades-f-e
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 371
                clearCache: 371
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ciudades-f-e
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ciudades-f-e
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

