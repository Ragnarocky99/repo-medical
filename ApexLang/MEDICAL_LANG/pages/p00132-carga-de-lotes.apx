page 132 (
    name: Carga de Lotes
    alias: CARGA-DE-LOTES
    title: Carga de Lotes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-lotes (
        name: Carga de Lotes
        type: form
        source {
            location: localDatabase
            tableName: STW_LOTES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P132_CANTIDAD (
        type: numberField
        label {
            label: <p>Cantidad:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-lotes
            column: CANTIDAD
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_COSTO_PROM_NUE (
        type: numberField
        label {
            label: <p>Costo Prom Nue:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-lotes
            column: COSTO_PROM_NUE
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_COSTO_REF (
        type: hidden
        layout {
            sequence: 180
            region: @carga-de-lotes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-lotes
            column: COSTO_REF
            dataType: number
        }
    )

    pageItem P132_FEC_VENCIMIENTO (
        type: datePicker
        label {
            label: <p>Fecha Vencimiento:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 70
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-lotes
            column: FEC_VENCIMIENTO
            dataType: date
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_ID (
        type: hidden
        layout {
            sequence: 160
            region: @carga-de-lotes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-lotes
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: STW_LOTE_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P132_ID_ARTICULO (
        type: popupLov
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Artículo:</a>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-articulos
        }
        layout {
            sequence: 30
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_ARTICULO
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_ID_COMPRA_CAB (
        type: hidden
        layout {
            sequence: 190
            region: @carga-de-lotes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_COMPRA_CAB
            dataType: number
        }
    )

    pageItem P132_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 170
            region: @carga-de-lotes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P132_ID_ENTSAL_CAB (
        type: hidden
        layout {
            sequence: 210
            region: @carga-de-lotes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_ENTSAL_CAB
            dataType: number
        }
    )

    pageItem P132_ID_INVENTARIO_CAB (
        type: hidden
        layout {
            sequence: 200
            region: @carga-de-lotes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_INVENTARIO_CAB
            dataType: number
        }
    )

    pageItem P132_ID_IVA (
        type: popupLov
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">IVA:</a>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-iva
        }
        layout {
            sequence: 60
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_IVA
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_ID_UNIDAD_MEDIDA (
        type: popupLov
        label {
            label: <p>Unidad Medida:</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-unidades-medida
        }
        layout {
            sequence: 110
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-lotes
            column: ID_UNIDAD_MEDIDA
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_NRO_LOTE (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Nro. Lote:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @carga-de-lotes
            column: NRO_LOTE
            dataType: varchar2
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    pageItem P132_PORC_COMISION (
        type: numberField
        label {
            label: <p>Porcentaje Comisión:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 100
            region: @carga-de-lotes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-lotes
            column: PORC_COMISION
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'MODIFICA_LOTES') != 'S'
        }
    )

    button articulo (
        buttonName: ARTICULO
        label: Articulo
        layout {
            sequence: 40
            region: @carga-de-lotes
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 130
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P132_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P132_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P132_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button unidad-medida (
        buttonName: UNIDAD_MEDIDA
        label: Unidad Medida
        layout {
            sequence: 120
            region: @carga-de-lotes
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @articulo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P132_ID_ARTICULO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @unidad-medida
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P132_ID_UNIDAD_MEDIDA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 24229940251813268
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-lotes (
        name: Initialize form Carga de Lotes
        type: formInitialization
        formRegion: @carga-de-lotes
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 24229161648813268
        }
    )

    process process-form-carga-de-lotes (
        name: Process form Carga de Lotes
        type: formAutoRowProcessing
        formRegion: @carga-de-lotes
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24229562414813268
        }
    )

)

