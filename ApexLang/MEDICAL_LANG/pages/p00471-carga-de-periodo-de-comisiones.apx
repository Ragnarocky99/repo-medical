page 471 (
    name: Carga de Periodo de comisiones
    alias: CARGA-DE-PERIODO-DE-COMISIONES
    title: Carga de Periodo de comisiones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P471_NUM_PERIODO").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-periodo-de-comisiones (
        name: Carga de periodo de comisiones
        type: form
        source {
            location: localDatabase
            tableName: FVW_PERIODOS_COMISION
        }
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P471_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P471_ESTADO (
        type: textField
        label {
            label: <p>Estado</p>
            alignment: left
        }
        settings {
            textCase: upper
        }
        layout {
            sequence: 40
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: ESTADO
            dataType: varchar2
        }
    )

    pageItem P471_FEC_ESTADO (
        type: datePicker
        label {
            label: <p>Fecha Estado</p>
            alignment: left
        }
        layout {
            sequence: 80
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: FEC_ESTADO
            dataType: date
        }
    )

    pageItem P471_FEC_FINAL (
        type: datePicker
        label {
            label: <p>Fecha Final</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: FEC_FINAL
            dataType: date
        }
    )

    pageItem P471_FEC_INICIAL (
        type: datePicker
        label {
            label: <p>Fecha Inicial</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: FEC_INICIAL
            dataType: date
        }
    )

    pageItem P471_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P471_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: P0_ID_EMPRESA
        }
    )

    pageItem P471_NUM_PERIODO (
        type: numberField
        label {
            label: <p>Numero Periodo</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-periodo-de-comisiones
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-periodo-de-comisiones
            column: NUM_PERIODO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P471_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: [
                t-Button--danger
                borrar
            ]
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P471_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P471_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p471-num-periodo (
        itemName: P471_NUM_PERIODO
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(p.num_periodo)), 0)+1
                from fvw_periodos_comision p
                WHERE p.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P471_NUM_PERIODO
        }
    )

    process close-dialog (
        name: Close dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 58827090023689636
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-periodo-de-comisiones (
        name: Initialize form Carga de Periodo de comisiones
        type: formInitialization
        formRegion: @carga-de-periodo-de-comisiones
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 58825222154689618
        }
    )

    process process-form-periodo-de-comision (
        name: Process form  periodo de comision
        type: formAutoRowProcessing
        formRegion: @carga-de-periodo-de-comisiones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 58826973916689635
        }
    )

)

