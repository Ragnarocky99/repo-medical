page 225 (
    name: Motivos de Entrada y Salida
    alias: MOTIVOS-DE-ENTRADA-Y-SALIDA
    title: Motivos de Entrada y Salida
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region motivos-de-entrada-y-salida (
        name: Motivos de Entrada y Salida
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_MOTIVO_ENT_SAL,
                       IND_ENT_SAL,
                       DESCRIPCION,
                       ABREVIATURA,
                       COD_USUARIO_AUD,
                       ID_EMPRESA,
                       ACTIVO,
                       CASE ACTIVO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON,
                       IND_COSTO,
                       CASE IND_COSTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END IND_COSTO_ICON,
                       ID_CUENTA AS COD_CUENTA
                  from STW_MOTIVO_ENT_SAL
                  WHERE id_empresa = :P0_ID_EMPRESA
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 226
                items: {
                    P226_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 33658437279785307
        }

        column ABREVIATURA (
            type: plainText
            heading {
                heading: Abreviatura
            }
            layout {
                sequence: 53
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 73
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ACTIVO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        column ACTIVO_ICON (
            type: plainText
            heading {
                heading: Activo Icon
                alignment: center
            }
            layout {
                sequence: 133
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        column COD_CUENTA (
            type: plainTextBasedOnLov
            heading {
                heading: Cod Cuenta
                alignment: end
            }
            lov {
                lov: @lv-cuentas-contables-asentable
            }
            layout {
                sequence: 153
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AB
            }
        )

        column COD_MOTIVO_ENT_SAL (
            type: plainText
            heading {
                heading: Cód. Motivo
            }
            layout {
                sequence: 23
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 113
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 43
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 103
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 123
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: V
            }
        )

        column IND_COSTO (
            type: plainText
            heading {
                heading: Ind. Costo
                alignment: center
            }
            layout {
                sequence: 83
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#IND_COSTO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        column IND_COSTO_ICON (
            type: plainText
            heading {
                heading: Ind Costo Icon
                alignment: center
            }
            layout {
                sequence: 143
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AA
            }
        )

        column IND_ENT_SAL (
            type: plainTextBasedOnLov
            heading {
                heading: Entrada o Salida
            }
            lov {
                lov: @stw-motivos-ent-sal
            }
            layout {
                sequence: 33
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Motivos de Entrada y Salida
        }

        savedReport 336801 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ABREVIATURA (
                sequence: 4
            )

            displayColumn ACTIVO (
                sequence: 5
            )

            displayColumn COD_MOTIVO_ENT_SAL (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn IND_COSTO (
                sequence: 6
            )

            displayColumn IND_ENT_SAL (
                sequence: 2
            )

            sort (
                column: COD_MOTIVO_ENT_SAL
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @motivos-de-entrada-y-salida
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 226
                clearCache: 226
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @motivos-de-entrada-y-salida
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @motivos-de-entrada-y-salida
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

