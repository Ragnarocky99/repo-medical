    region lista-nota-de-entrega (
        name: Lista Nota de Entrega
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.ID,
                       EC.ID_EMPRESA,
                       EC.ID_SUCURSAL,
                       EC.NUM_ENT_SAL,
                       EC.FEC_ENT_SAL,
                       EC.ID_MOTIVO_ENT_SAL,
                       EC.COD_USUARIO_AUD,
                       EC.TIP_REFERENCIA,
                       EC.SER_REFERENCIA,
                       EC.NUM_REFERENCIA,
                       EC.ESTADO,
                       EC.TOT_COSTO,
                       EC.TOT_CANTIDAD,
                       EC.ID_CLIENTE,
                       EC.FEC_ALTA,
                       EC.SER_ENT_SAL,
                       EC.ASIENTOS,
                       EC.TIP_ENT_SAL,
                       EC.ID_LICITACION_CAB,
                       EC.ID_ASIENTO_PROV,
                       EC.ASIENTOS_NTE,
                       EC.ID_ASIENTO_NTE_PROV,
                       LC.NRO_ID_LICITACION,
                       DE.ID ID_DEVOLUCION
                  FROM STW_ENTSAL_CAB EC
                LEFT JOIN STW_ENTSAL_CAB DE ON EC.ID = DE.ID_ENTSAL_REF
                  JOIN LCW_LICITACIONES_CAB LC ON LC.ID = EC.ID_LICITACION_CAB
                 WHERE EC.TIP_ENT_SAL = W_BUSCA_PARAMETRO('LC', 'TIP_COMPROBANTE_NOTA_ENTREGA')
                   AND EC.ID_EMPRESA = :P0_ID_EMPRESA
                   AND EC.FEC_ENT_SAL BETWEEN :P784_FEC_INI AND :P784_FEC_FIN
                   AND (EC.ID_CLIENTE = :P784_ID_CLIENTE OR :P784_ID_CLIENTE IS NULL)
                   AND (EC.NUM_REFERENCIA = :P784_NRO_LICITACION OR :P784_NRO_LICITACION IS NULL)
                   AND (EC.NUM_ENT_SAL = :P784_NUM_ENT_SAL OR :P784_NUM_ENT_SAL IS NULL)
                ORDER BY EC.FEC_ENT_SAL DESC, EC.NUM_ENT_SAL DESC
                ```
            pageItemsToSubmit: [
                P784_FEC_INI
                P784_FEC_FIN
                P784_ID_CLIENTE
                P784_NRO_LICITACION
                P784_NRO_ID_LICITACION
                P784_NUM_ENT_SAL
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 786
