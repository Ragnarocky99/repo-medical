    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click (
        name: Click
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: items
            items: P537_CONTRATO
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 547
                    items: {
                        P547_ID_EMPRESA: &P537_ID_EMPRESA.
                        P547_ID: &P537_ID_CONTRATO.
                    }
                }
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction habilitar-deshabilitar (
        name: Habilitar/Deshabilitar
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P537_IND_PROPIO
        }
        clientSideCondition {
            type: item=value
            item: P537_IND_PROPIO
            value: N
        }
        serverSideCondition {
            type: never
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P537_ID_PER_PROP
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P537_ID_PER_PROP
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: NULL
            }
            affectedElements {
                selectionType: items
                items: P537_ID_PER_PROP
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

