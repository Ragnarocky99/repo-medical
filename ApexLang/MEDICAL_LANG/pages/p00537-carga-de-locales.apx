    computation p537-cod-local (
        itemName: P537_COD_LOCAL
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_LOCAL)),0)+1
                FROM ACW_LOCALES
                WHERE ID_EMPRESA=:P0_ID_EMPRESA;
                
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P537_ID
        }
    )

    computation p537-contrato (
        itemName: P537_CONTRATO
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_nro_contrato VARCHAR2(30);
                begin
                SELECT C.NRO_CONTRATO
                INTO   :P537_CONTRATO
                 FROM ACW_CONTRATOS_LOCALES L,ACW_CONTRATOS_CAB C
                WHERE ID_LOCAL=8
                AND L.ID_CONTRATO_CAB=C.ID
                AND L.ID_EMPRESA=C.ID_EMPRESA;
                RETURN :P537_CONTRATO;
                EXCEPTION
                    WHEN OTHERS THEN
                       RETURN NULL;
                end;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P537_ID
        }
    )

    computation p537-id-contrato (
        itemName: P537_ID_CONTRATO
        execution {
            sequence: 30
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_id_contrato number(10);
                begin
                SELECT C.ID
                INTO   v_id_contrato
                 FROM ACW_CONTRATOS_LOCALES L,ACW_CONTRATOS_CAB C
                WHERE ID_LOCAL=8
                AND L.ID_CONTRATO_CAB=C.ID
                AND L.ID_EMPRESA=C.ID_EMPRESA;
                RETURN v_id_contrato;
                EXCEPTION
                    WHEN OTHERS THEN
                       RETURN NULL;
                end;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P537_ID
        }
    )

