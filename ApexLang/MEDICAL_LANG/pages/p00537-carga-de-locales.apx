page 537 (
    name: Carga de Locales
    alias: CARGA-DE-LOCALES
    title: Carga de Locales
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        width: 1650
        height: 550
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:12.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;}
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-locales (
        name: Carga de Locales
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_LOCAL,
                       DESCRIPCION,
                       SUPERFICIE_MT2,
                       ID_SECTOR,
                       COD_NIVEL,
                       CTA_CTE_CTRAL,
                       NIR_ANDE,
                       CTA_CTE_ESSAP,
                       ID_CLIENTE,
                       IND_PROPIO,
                       ID_CATEGORIA,
                       ESTADO,
                       NRO_LOCAL,
                       COD_USUARIO_AUD,
                       FEC_ALTA,
                       NRO_PADRON,
                       OBSERVACION,
                       ID_SUCURSAL,
                       ID_PER_PROP,
                       VIDRIERA_MT2,
                       AREAS_COMUNES_MT2,
                       TIPO_LOCAL,
                       NRO_NIR_ANDE,
                       NRO_MED_ANDE,
                       ORDEN,
                       DIRECCION,
                       DESCRIPCION_MAP,
                       COORDENADAS,
                       IND_PRORRATEAR_EXPENSA,
                       INDEMNIZACION,
                       ALQUILER,
                       ID_COBRADOR,
                       GARANTIA,
                       COMISION
                
                  from ACW_LOCALES
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region cuentas (
        name: Cuentas
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @carga-de-locales
            slot: subRegions
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-expanded
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            customAttributes: style="grid-row: span 2;"
        }
    )

    region datos-generales (
        name: Datos Generales
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @carga-de-locales
            slot: subRegions
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
                t-Form--stretchInputs
                margin-top-none
            ]
        }
    )

    region imagenes (
        name: Imagenes
        type: form
        source {
            location: localDatabase
            tableName: ACW_IMG_LOCALES
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
                margin-top-lg
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P537_ID
        }
    )

    region imagenes-grilla (
        name: Imagenes Grilla
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT "ID",
                       "FILENAME",
                       "MIMETYPE",
                          /*'<Img src="/i/IMAGENES_APEX/'
                       || ID_LOCAL||'-'||ID
                       || '.jpg" alt="Smiley face" height="40" width="40">'
                          AS img,*/
                          descripcion,
                          ID_LOCAL||'-'||ID  AS IMAGE,
                          ID_EMPRESA,
                          ID_LOCAL
                  FROM ACW_IMG_LOCALES
                  WHERE ID_LOCAL=:P537_ID
                ```
            pageItemsToSubmit: P537_ID
        }
        layout {
            sequence: 10
            parentRegion: @imagenes
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
                margin-left-lg
                margin-right-lg
            ]
        }
        advanced {
            htmlDomId: IMG
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 85532607920686109
        }

        savedReport 855518 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IMAGE
                layout {
                    width: 203
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

            displayColumn (
                column: @URL
                layout {
                    show: false
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_SELECTOR
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @ID
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @FILENAME
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @MIMETYPE
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    width: 709
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ID_LOCAL
                layout {
                    sequence: 10
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 10
            }
            source {
                type: none
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: <p>Descripción</p>
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column FILENAME (
            type: textarea
            heading {
                heading: Filename
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: FILENAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ID (
            type: numberField
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: :P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_LOCAL (
            type: hidden
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ID_LOCAL
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IMAGE (
            type: link
            heading {
                heading: <p>Imagen</p>
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            link {
                target: {
                    page: 1000
                    items: {
                        P1000_ID: &ID.
                        P1000_ID_LOCAL: &ID_LOCAL.
                    }
                }
                linkText: <img src="/i/IMAGENES_APEX/&IMAGE..jpg" height="65" width="65" alt="Sin Imagen" >
            }
            source {
                databaseColumn: IMAGE
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            advanced {
                htmlDomId: IMAGEN
            }
        )

        column MIMETYPE (
            type: textarea
            heading {
                heading: Mimetype
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: MIMETYPE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column URL (
            type: textField
            heading {
                heading: Url
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 102
            }
            source {
                type: none
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Imagenes Grilla
        }
    )

