        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P782_ID_CLIENTE
                P782_NRO_ID_LICITACION
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pendientes-de-cotizacion-licitacion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pendientes-de-cotizacion-licitacion
            }
