    region pendientes-de-cotizacion-licitacion (
        name: Pendientes de Cotizacion - Licitacion
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LCWV_PENDIENTE_COTIZACION
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P782_ID_CLIENTE OR :P782_ID_CLIENTE IS NULL) AND
                (NRO_ID_LICITACION = :P782_NRO_ID_LICITACION OR :P782_NRO_ID_LICITACION IS NULL) AND
                FEC_LICITACION BETWEEN :P782_FEC_INI AND :P782_FEC_FIN
                ```
            pageItemsToSubmit: [
                P782_FEC_INI
                P782_FEC_FIN
                P782_ID_CLIENTE
                P782_NRO_ID_LICITACION
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 43363627883023639
        }

