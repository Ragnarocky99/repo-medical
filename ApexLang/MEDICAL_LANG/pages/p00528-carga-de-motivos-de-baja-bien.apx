page 528 (
    name: Carga de Motivos de Baja Bien
    alias: CARGA-DE-MOTIVOS-DE-BAJA-BIEN
    title: Carga de Motivos de Baja Bien
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 214px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: left;
                border-width: thin;
                border-color: #afa9a9;
            }
            canvas#image-preview{  
            text-align: center;  
            margin-left: 100px;  
            margin-top: 30px;  
            border: 1px solid black; 
             width: 240px !important;
            }
            
            td[headers="Mostrar"] img {   width: 74px; } 
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-motivos-de-baja-bien (
        name: Carga de Motivos de Baja Bien
        type: form
        source {
            location: localDatabase
            tableName: COW_MOTIVOS_BAJAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P528_COD_MOTIVO_BAJA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Motivo:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-motivos-de-baja-bien
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-motivos-de-baja-bien
            column: COD_MOTIVO_BAJA
            dataType: varchar2
        }
    )

    pageItem P528_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 50
            region: @carga-de-motivos-de-baja-bien
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-de-baja-bien
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression:
                ```plsql
                :APP_USER
                
                ```
        }
    )

    pageItem P528_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-motivos-de-baja-bien
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 8
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-motivos-de-baja-bien
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P528_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-motivos-de-baja-bien
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-de-baja-bien
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: COW_MOTIVO_BAJA_SEQ_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P528_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-motivos-de-baja-bien
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-de-baja-bien
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression:
                ```plsql
                :P0_ID_EMPRESA
                
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P528_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P528_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P528_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 82743549277389420
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-motivos-de-baja-bien (
        name: Initialize form Carga de Motivos de Baja Bien
        type: formInitialization
        formRegion: @carga-de-motivos-de-baja-bien
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 82742777994389420
        }
    )

    process process-form-carga-de-motivos-de-baja-bien (
        name: Process form Carga de Motivos de Baja Bien
        type: formAutoRowProcessing
        formRegion: @carga-de-motivos-de-baja-bien
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 82743121708389420
        }
    )

)

