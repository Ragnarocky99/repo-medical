page 766 (
    name: Editor de Articulos
    alias: EDITOR-DE-ARTICULOS
    title: Editor de Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region editor-de-articulos (
        name: Editor de Articulos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                    select ID,
                           COD_ARTICULO,
                           DESCRIPCION,
                           ID_MARCA,
                           ID_RUBRO,
                           ID_FAMILIA,
                           ID_LINEA,
                           ID_ENVASE,
                           ID_IVA,
                           ID_UNIDAD_MEDIDA,
                           ID_MONEDA_COSTO,
                           COD_ORIGEN_ART,
                           ID_EMPRESA,
                           ESTADO,
                           ID_MONEDA_BASE,
                           COD_QUIMICO,
                           IND_PELIGROSO,
                           IND_CONTROLADO,
                           SINONIMO,
                           CANT_MAX_CONTROLADO,
                           CANT_MAX,
                           STOCK_MINIMO,
                           IND_PRECIO_FIJO,
                           ID_GRUPO_ART,
                           IND_DIMABEL,
                           IND_BIOLOGICO,
                           IND_SOLO_MAR,
                           IND_SOLO_AEREO,
                           (SELECT LISTAGG(DISTINCT C001, CHR(13))
                             FROM APEX_COLLECTIONS CO
                            WHERE COLLECTION_NAME = 'ARTICULOS'
                              AND N001 = ART.ID) GRUPO_SUGERIDO,
                           COD_USUARIO_AUD,
                           FEC_ALTA,
                           COD_USUARIO_MOD,
                           FEC_MODIFICACION
                      from STW_ARTICULOS ART
                     where ID_EMPRESA = :P0_ID_EMPRESA
                       and (COD_ARTICULO = :P766_COD_ARTICULO OR :P766_COD_ARTICULO IS NULL)
                       and (ID_RUBRO = :P766_ID_RUBRO OR :P766_ID_RUBRO IS NULL)
                       and (ID_MARCA = :P766_ID_MARCA OR :P766_ID_MARCA IS NULL)
                       and (ID_FAMILIA = :P766_ID_FAMILIA OR :P766_ID_FAMILIA IS NULL)
                       and (ID_LINEA = :P766_ID_LINEA OR :P766_ID_LINEA IS NULL)
                       and (:P766_ID_GRUPO_ART_SUG IN (SELECT C001
                                                         FROM APEX_COLLECTIONS CO
                                                        WHERE CO.COLLECTION_NAME = 'ARTICULOS'
                                                          AND CO.N001 = ART.ID) OR :P766_ID_GRUPO_ART_SUG IS NULL)
                ```
            pageItemsToSubmit: [
                P766_COD_ARTICULO
                P766_ID_RUBRO
                P766_ID_MARCA
                P766_ID_FAMILIA
                P766_ID_LINEA
                P766_ID_GRUPO_ART_SUG
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        editAuthorization {
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 34248059487775081
        }

