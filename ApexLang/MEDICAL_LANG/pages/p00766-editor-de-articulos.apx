    dynamicAction refrescar-editor-de-articulos (
        name: Refrescar Editor de Articulos
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @editor-de-articulos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction sugerir-grupos (
        name: Sugerir Grupos
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    -- Verificar si pertenece a un grupo
                    DECLARE
                        VIND_RECOMENDAR VARCHAR2(1) := 'N';
                    BEGIN
                        APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('ARTICULOS');
                        FOR I IN (
                            SELECT ART.ID ID_ARTICULO,
                                   ART.DESCRIPCION,
                                   ART.DESCRIPCION_INGLES,
                                   ART.SINONIMO
                              FROM STW_ARTICULOS ART
                        )
                        LOOP
                            FOR J IN (
                                SELECT APEX_STRING.SPLIT(T.DESCRIPCION, ' ') PALABRAS_CLAVES,
                                       T.ID_GRUPO_ART,
                                       G.DESCRIPCION DESC_GRUPO
                                FROM STW_SINONIMOS_ALERTAS T
                                JOIN STW_GRUPOS_ART        G ON G.ID = T.ID_GRUPO_ART
                            )
                            LOOP
                                VIND_RECOMENDAR := 'S';
                                FOR K IN 1..J.PALABRAS_CLAVES.COUNT()
                                LOOP
                                    IF (INSTR(UPPER(I.DESCRIPCION), UPPER(J.PALABRAS_CLAVES(K))) = 0 OR
                                        INSTR(UPPER(I.DESCRIPCION_INGLES), UPPER(J.PALABRAS_CLAVES(K))) = 0 OR
                                        INSTR(UPPER(I.SINONIMO), UPPER(J.PALABRAS_CLAVES(K))) = 0 ) THEN
                                        VIND_RECOMENDAR := 'N';
                                        EXIT;
                                    END IF; 
                                END LOOP;
                    
                                IF VIND_RECOMENDAR = 'S' THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS',
                                                               P_N001            => I.ID_ARTICULO,
                                                               P_C001            => J.DESC_GRUPO);
                                END IF;
                            END LOOP;
                        END LOOP;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                            NULL;
                        END;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

