        when {
            selectionType: items
            items: [
                P766_COD_ARTICULO
                P766_ID_RUBRO
                P766_ID_MARCA
                P766_ID_FAMILIA
                P766_ID_LINEA
                P766_ID_GRUPO_ART_SUG
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @editor-de-articulos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

