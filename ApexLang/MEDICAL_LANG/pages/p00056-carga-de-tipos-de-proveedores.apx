page 56 (
    name: Carga de Tipos de Proveedores
    alias: CARGA-DE-TIPOS-DE-PROVEEDORES
    title: Carga de Tipos de Proveedores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .mostrar{
                background-color:#eeeeee;
                width: 229px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tipos-de-proveedores (
        name: Carga de Tipos de Proveedores
        type: form
        source {
            location: localDatabase
            tableName: CMW_CLASE_PROVEEDORES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P56_ACTIVO (
        type: switch
        label {
            label: <p>Activo:</p>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: SI
            offValue: N
            offLabel: NO
        }
        layout {
            sequence: 80
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: ACTIVO
            dataType: varchar2
        }
    )

    pageItem P56_COD_CLASE (
        type: displayOnly
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Clase:</a>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: COD_CLASE
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT MAX(TO_NUMBER(A.COD_CLASE))+1
                from CMW_CLASE_PROVEEDORES A
                WHERE A.ID_EMPRESA = :P0_COD_EMPRESA;
                ```
        }
    )

    pageItem P56_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 30
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P56_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P56_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: CMW_CLASE_PROVEEDORES_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P56_ID_CUENTA_CONTABLE (
        type: textField
        label {
            label: <p>Cuenta Contable:</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: ID_CUENTA_CONTABLE
            dataType: number
        }
    )

    pageItem P56_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-tipos-de-proveedores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-proveedores
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P56_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P56_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 10418886115985109
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tipos-de-proveedores (
        name: Initialize form Carga de Tipos de Proveedores
        type: formInitialization
        formRegion: @carga-de-tipos-de-proveedores
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10418092453985109
        }
    )

    process process-form-carga-de-tipos-de-proveedores (
        name: Process form Carga de Tipos de Proveedores
        type: formAutoRowProcessing
        formRegion: @carga-de-tipos-de-proveedores
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10418458189985109
        }
    )

)

