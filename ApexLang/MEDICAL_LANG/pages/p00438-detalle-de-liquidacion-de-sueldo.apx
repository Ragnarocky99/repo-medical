    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cant_debe    = model.getFieldKey("DEBE_COPIA");
                var v_cant_haber   = model.getFieldKey("HABER_COPIA");
                var v_mon_debe     = 0;
                var v_mon_haber    = 0;
                var v_cambio_haber = 0;
                var v_cambio_debe  = 0;
              
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
            
                          
                        v_mon_debe     = v_mon_debe     + parseFloat(r[v_cant_debe].replace(/\./g,''));
                        v_mon_haber    = v_mon_haber    + parseFloat(r[v_cant_haber].replace(/\./g,''));
                       
                    }
                    
                    
                });
            
                //v_cambio_debe = ( v_mon_debe * parseFloat(v_cambio.replace(/\./g,'')) );
                //v_cambio_haber = ( v_mon_haber * parseFloat(v_cambio.replace(/\./g,'')));
            
                 $s('P443_TOT_DEBE',v_mon_debe.toString().replace('.', ''));
                 $s('P443_TOT_HABER',v_mon_haber.toString().replace('.', ''));
            
                 //console.log('cambio es '+ v_cambio_debe + " | " + v_cambio_haber);
            
            }
            
            
            function calcDiferencia() {
                var v_tot_debe, v_tot_haber, v_mon_dif;
                
                v_tot_debe = parseFloat($v("P443_TOT_DEBE").replace(/\./g,''));
                
                v_tot_haber = parseFloat($v("P443_TOT_HABER").replace(/\./g,'')); 
                
                v_mon_dif = ( v_tot_debe - v_tot_haber ) * 1;  
            
                //valida si es negativo
                if( v_mon_dif < 0 ){
            
                    v_mon_dif = v_mon_dif * -1;  
            
                }
                
                $s("P443_DIFERENCIA", parseInt(v_mon_dif));
            
            }
            
            
            /*function validarDifNegativo(num){
                if(num<0){
                    return (num * (-1));
            
                }
                
                return num;
            }*/
            
            // PRUEBA
            /*function calcCambio(){
                var v_final_haber, v_final_debe, v_final_dif;
                var v_cambio_moneda, v_cambio_haber, v_cambio_debe, v_cambio_dif
            
                v_cambio_moneda = parseFloat($v("P235_TIPO_CAMBIO").replace(/\./g,'')); 
                v_cambio_haber  = parseFloat($v("P235_TOT_HABER").replace(/\./g,'')); 
                v_cambio_debe   = parseFloat($v("P235_TOT_DEBE").replace(/\./g,''));
                v_cambio_dif    = parseFloat($v("P235_DIFERENCIA").replace(/\./g,''));
            
            
            
                v_final_debe    = v_cambio_debe  * v_cambio_moneda;
                v_final_haber   = v_cambio_haber * v_cambio_moneda;
                v_final_dif     = v_cambio_dif   * v_cambio_moneda;
            
                $s("P235_TOT_DEBE", parseInt(v_final_debe));
                $s("P235_TOT_HABER", parseInt(v_final_haber));
                $s("P235_DIFERENCIA", parseInt(v_final_dif));
            
                console.log("valores: " + v_final_debe + v_final_haber + "diferencia:" + v_final_dif)
            }*/
            ```
        executeWhenPageLoads:
            ```javascript-browser
            //Script para evitar que se pueda escribir en los campos de Tot. Haber y deber.
            document.getElementById("P443_TOT_DEBE").readOnly = true;
            document.getElementById("P443_TOT_HABER").readOnly = true;
            document.getElementById("P443_DIFERENCIA").readOnly = true;
            
            ```
