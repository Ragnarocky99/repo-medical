    button volver (
        buttonName: VOLVER
        label: Volver
        layout {
            sequence: 10
            region: @new
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo-arrow
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P438_ID
        }
    )

    dynamicAction calc-diferencia (
        name: CALC_DIFERENCIA
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P438_TOT_HABER
                P438_TOT_DEBE
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calcDiferencia();
            }
            affectedElements {
                selectionType: items
                items: P438_DIFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar (
        name: INICIALIZAR
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P438_ID IS NOT NULL THEN
                RETURN TRUE;
                ELSE
                RETURN FALSE;
                END IF;
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    //grid.view$.grid("option", "editable", true);
                    //editable true
                    grid.model.setOption("editable", true);
                    grid.setEditMode(true);
                    //editable false
                    //grid.model.setOption("editable", false);
                    grid.setEditMode(false);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setear-beneficios (
        name: SETEAR_BENEFICIOS
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: BENEFICIOS
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-deducciones (
        name: SETEAR_DEDUCCIONES
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: DEDUCCIONES
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-valor (
        name: SETEAR_VALOR
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: [
                    P438_TOT_HABER
                    P438_TOT_DEBE
                    P438_DIFERENCIA
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p438-tot-haber (
        itemName: P438_TOT_HABER
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT SUM(DECODE(TIPO,'H',MONTO,0)) FROM RHW_DETALLE_LIQ D WHERE
                D.ID_CAB_LIQUID=:P414_ID;
                ```
        }
    )

    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 44329192128163837
        }
    )

    process initialize-form-detalle-de-liquidación (
        name: Initialize form Detalle de Liquidación
        type: formInitialization
        formRegion: @detalle-de-liquidación
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44314724132163825
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 433
            }
        }
    )

)

