        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Resumen de Orden de Compra
        }

        savedReport 302097 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD_APROBADA (
                sequence: 11
            )

            displayColumn CANTIDAD_ENTREGADA (
                sequence: 17
            )

            displayColumn CANTIDAD_PENDIENTE (
                sequence: 18
            )

            displayColumn CANT_ANULADA (
                sequence: 20
            )

            displayColumn CANT_REMISION (
                sequence: 21
            )

            displayColumn COD_ARTICULO (
                sequence: 3
            )

            displayColumn COD_ORIGEN_ART (
                sequence: 4
            )

            displayColumn DESC_ARTICULO (
                sequence: 5
            )

            displayColumn FECHA_PLAZO (
                sequence: 16
            )

            displayColumn FEC_OCC (
                sequence: 15
            )

            displayColumn ID_CLIENTE (
                sequence: 10
            )

            displayColumn ID_ENVASE (
                sequence: 6
            )

            displayColumn ID_MARCA (
                sequence: 8
            )

            displayColumn ID_TIPO_ENTREGA (
                sequence: 9
            )

            displayColumn ID_UNIDAD_MEDIDA (
                sequence: 7
            )

            displayColumn NRO_ITEM (
                sequence: 2
            )

            displayColumn NRO_OCC (
                sequence: 14
            )

            displayColumn NRO_PEDIDO (
                sequence: 1
            )

            displayColumn NUEVOESTADO (
                sequence: 19
            )

            displayColumn PRECIO_TOTAL (
                sequence: 13
            )

            displayColumn PRECIO_UNITARIO (
                sequence: 12
            )

            sort (
                column: NRO_PEDIDO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: PRECIO_TOTAL
            )

        )

    )

    region resumen-occ (
        name: Resumen OCC
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P634_ARTICULO (
        type: textField
        label {
            label: <P>Articulo: </P>
            alignment: left
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P634_BANDERA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P634_COD_FABRICANTE (
        type: textField
        label {
            label: <P>Cod Fabricante</P>
            alignment: left
        }
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P634_DECIMALES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P634_ESTADO (
        type: selectList
        label {
            label: <p>Estado</p>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pendiente;PE,Entregado;EN,Anulado;AN,Remision;RE
        }
        layout {
            sequence: 140
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P634_FEC_OCC_DESDE (
        type: datePicker
        label {
            label: <p><b style="color:red;">*</b>Fecha Desde: </p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/'||TO_CHAR(SYSDATE,'MM/YYYY') FROM DUAL;
        }
    )

    pageItem P634_FEC_OCC_HASTA (
        type: datePicker
        label {
            label: <p><b style="color:red;">*</b>Fecha Hasta: </p>
            alignment: left
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
    )

    pageItem P634_ID (
        type: hidden
        layout {
            sequence: 70
            slot: body
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P634_ID_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            popupWidth: 800
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P634_ID_PEDIDO (
        type: hidden
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P634_MON_COSTO_COPIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: body
        }
    )

    pageItem P634_NRO_OCC (
        type: textField
        label {
            label: <P>Nro Orden Compra: </P>
            alignment: left
        }
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P634_NRO_PEDIDO (
        type: textField
        label {
            label: <p>Nro Pedido</p>
            alignment: left
        }
        layout {
            sequence: 150
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P634_PROVEEDOR (
        type: hidden
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction alerta (
        name: Alerta
        execution {
            sequence: 160
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-alert (
            action: alert
            settings {
                title: Aviso, se está trabajando en esta página
                message: Se está añadiendo un(a) validación/proceso/cambio a la página, lo que puede provocar errores si está usando la página.
                style: information
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cambio-desc-articulo (
        name: Cambio_Desc_Articulo
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P634_ARTICULO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ID_ARTICULO
                    from STWV_ARTICULOS
                    where DESC_ARTICULO = :P634_ARTICULO
                    ```
            }
            affectedElements {
                selectionType: items
                items: P634_ARTICULO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 140
        }
        when {
            selectionType: items
            items: [
                P634_ID_CLIENTE
                P634_FEC_OCC_DESDE
                P634_FEC_OCC_HASTA
                P634_NRO_OCC
                P634_ARTICULO
                P634_PROVEEDOR
                P634_COD_FABRICANTE
                P634_ESTADO
                P634_NRO_PEDIDO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-de-orden-de-compra
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

