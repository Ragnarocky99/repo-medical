    region resumen-de-orden-de-compra (
        name: Resumen de Orden de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    C.ID AS C_ID,
                    C.ID_EMPRESA,
                    C.ID_SUCURSAL,
                    C.ID_ARTICULO,
                    C.ID_PROVEEDOR,
                    C.ID_MONEDA,
                    C.PRECIO,
                    C.PRECIO * C.CANTIDAD AS mon_costo,
                    C.PRECIO AS mon_costo_copia,
                    C.APROBADO,
                    C.TIPO_IVA,
                    C.PORCENTAJE_DESCUENTO,
                    C.CANTIDAD,
                    C.COD_ARTICULO_REF,
                    C.NRO_ITEM,
                    C.SALDO,
                    C.OBSERVACION,
                    C.COTIZA,
                    C.COD_USUARIO_APRO,
                    C.CAMBIO,
                    C.ID_CONDICION_COMPRA,
                    C.IND_GENERA_OC,
                    C.IND_ORDEN,
                    A.ID_ENVASE,
                    A.ID_UNIDAD_MEDIDA,
                    A.ID_MARCA,
                    A.COD_ARTICULO,
                    A.DESCRIPCION AS DESC_ARTICULO,
                    C.ID_PEDIDO,
                    C.ID_TIPO_ENTREGA,
                    C.IND_ENVIO,
                    C.PORC_MARGEN,
                    C.MARGEN_UNITARIO,
                    C.MARGEN_TOTAL,
                    '' AS espacio,
                    C.PRECIO_UNITARIO,
                    C.PRECIO_TOTAL,
                    P.ID AS P_ID,
                    P.ID_CLIENTE,
                    P.FEC_COMPROBANTE,
                    A.DESCRIPCION as Descripcion,
                    C.CANTIDAD_APROBADA,
                    C.NRO_OCC,
                    C.FEC_OCC,
                    '' AS Aprobar,
                    C.CANTIDAD_OCP,
                    NVL(C.CANT_ANULADA,0) CANT_ANULADA,
                    ---C.ESTADO,
                    /*CASE c.Estado
                        WHEN 'CO' THEN 'Cotizado'
                        WHEN 'PE' THEN 'Pendiente'
                        WHEN 'PA' THEN 'Parcial'
                        WHEN 'EN' THEN 'Enviado'
                        WHEN 'AN' THEN 'Anulado'
                        ELSE c.Estado
                    END AS NuevoEstado,*/
                    /*CASE obtener_estado_pedido_occ_bkp(id_pedido, id_articulo, :P0_ID_EMPRESA,c.id)
                        WHEN 'AN' THEN 'Anulado'
                        WHEN 'EN' THEN 'Entregado'
                        WHEN 'PE' THEN 'Pendiente'
                        WHEN 'RE' THEN 'Remision'
                    END AS NuevoEstado,*/
                    /*CASE
                        WHEN P.fec_comprobante > TO_DATE('22/01/2024', 'DD/MM/YYYY') THEN
                            obtener_estado_pedido_occ_bkp(id_pedido, id_articulo, :P0_ID_EMPRESA, c.id)
                        ELSE*/
                            CASE
                                WHEN c.cantidad_aprobada = 0 then 'Pendiente'
                                WHEN c.cant_anulada = c.cantidad_aprobada THEN 'Anulado'
                                WHEN (c.cantidad_aprobada = c.cantidad_entregada+nvl(c.cant_anulada,0)) and (c.cantidad_entregada > 0) and (c.cantidad_aprobada > 0) THEN 'Entregado'
                                WHEN C.CANTIDAD_APROBADA = nvl((SELECT SUM(D1.CANTIDAD)
                                                                  FROM STW_ENTSAL_CAB C1,
                                                                       STW_ENTSAL_DET D1
                                                                 WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                                                   AND C1.ID = D1.ID_ENTSAL_CAB
                                                                   AND NVL(C1.ESTADO,'N') != 'A'
                                                                   AND D1.ID_ARTICULO = C.ID_ARTICULO
                                                                   AND D1.ID_PEDIDO_DETALLE = C.ID_PEDIDO_DET),0)
                                THEN 'Remisionado'
                                ELSE 'Pendiente'
                            --END
                    END AS NuevoEstado,
                    case 
                    obtener_estado_articulo_occ(c.cant_anulada,
                                                 c.cantidad_aprobada,
                                                 c.cantidad_entregada,
                                                 nvl((SELECT SUM(D1.CANTIDAD)
                                                                  FROM STW_ENTSAL_CAB C1,
                                                                       STW_ENTSAL_DET D1
                                                                 WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                                                   AND C1.ID = D1.ID_ENTSAL_CAB
                                                                   AND NVL(C1.ESTADO,'N') != 'A'
                                                                   AND D1.ID_ARTICULO = C.ID_ARTICULO
                                                                   AND D1.ID_PEDIDO_DETALLE = C.ID_PEDIDO_DET),0),
                                                 c.id,a.id, p.id, :P0_ID_EMPRESA      
                    ) 
                    WHEN 'AN' THEN 'Anulado'
                        WHEN 'EN' THEN 'Entregado'
                        WHEN 'PE' THEN 'Pendiente'
                        WHEN 'RE' THEN 'Remision'
                    end as estado2,
                    
                
                            
                    A.COD_ORIGEN_ART,
                    A.ID_GRUPO_ART,
                    T.NRO_DIAS NRO_DIAS,
                    C.FEC_OCC + T.NRO_DIAS AS FECHA_PLAZO,
                    P.NRO_COMPROBANTE AS NRO_PEDIDO,
                    case 
                    when c.cantidad_entregada > c.cantidad_aprobada then c.cantidad_aprobada
                    else c.cantidad_entregada
                    end as CANTIDAD_ENTREGADA,
                    --obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA,c.id)-NVL(C.CANT_ANULADA,0) as CANTIDAD_PENDIENTE,
                    case 
                        when c.cantidad_entregada = c.cantidad_aprobada and P.fec_comprobante<=to_date('22/01/2024') then 0
                        /*else obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA,c.id)-NVL(C.CANT_ANULADA,0)*/
                        --when nvl(C.cantidad_aprobada,0) - nvl(c.cantidad_entregada,0)-nvl(c.cant_anulada,0) < 0 then 0
                        --else nvl(C.cantidad_aprobada,0) - nvl(c.cantidad_entregada,0)-nvl(c.cant_anulada,0) --Modificado para simplicidad. 
                        else obtener_cantidad_pendiente(c.id_pedido,c.id_articulo,:P0_ID_EMPRESA,c.id)
                    end as cantidad_pendiente,
                   nvl((SELECT SUM(D1.CANTIDAD)
                      FROM STW_ENTSAL_CAB C1,
                           STW_ENTSAL_DET D1
                     WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                       AND C1.ID = D1.ID_ENTSAL_CAB
                       AND NVL(C1.ESTADO,'N') != 'A'
                       AND D1.ID_ARTICULO = C.ID_ARTICULO
                       AND D1.ID_PEDIDO_DETALLE = C.ID_PEDIDO_DET
                       AND C1.ESTADO <> 'A'),0) CANT_REMISION,
                       c.CANT_REMISION AS CANTIDAD_REMISIONADA,
                
                       P.id as Ped_Id,
                       A.id as Art_Id,
                       C.Id as Cot_Id
                
                
                FROM CMW_COTIZA_ARTICULOS C
                LEFT JOIN STW_ARTICULOS A ON A.ID = C.ID_ARTICULO AND A.ID_EMPRESA = C.ID_EMPRESA
                LEFT JOIN VTW_PEDIDOS_CABECERA P ON P.ID = C.ID_PEDIDO AND P.ID_EMPRESA = C.ID_EMPRESA
                LEFT JOIN CMW_TIPO_ENTREGA T ON T.ID = NVL(C.ID_TIPO_ENTREGA,40) AND T.ID_EMPRESA = NVL(C.ID_EMPRESA,/*:P0_ID_EMPRESA*/121)
                WHERE (C.NRO_OCC IS NOT NULL AND C.NRO_OCC <> '0')
                
                
                AND (P.ID_CLIENTE = :P634_ID_CLIENTE OR :P634_ID_CLIENTE IS NULL)
                AND (C.FEC_OCC BETWEEN :P634_FEC_OCC_DESDE AND :P634_FEC_OCC_HASTA)
                AND (C.NRO_OCC = :P634_NRO_OCC OR :P634_NRO_OCC IS NULL)
                --AND  (LOWER(A.DESCRIPCION) LIKE '%'|| LOWER(:P634_ARTICULO)  ||'%' OR :P634_ARTICULO IS NULL)
                AND (A.COD_ARTICULO = :P634_ARTICULO or :P634_ARTICULO is null)
                AND (A.COD_ORIGEN_ART = :P634_COD_FABRICANTE or :P634_COD_FABRICANTE is null)
                AND (P.NRO_COMPROBANTE = :P634_NRO_PEDIDO OR :P634_NRO_PEDIDO IS NULL)
                AND (obtener_estado_articulo_occ(c.cant_anulada,
                                                 c.cantidad_aprobada,
                                                 c.cantidad_entregada,
                                                 nvl((SELECT SUM(D1.CANTIDAD)
                                                                  FROM STW_ENTSAL_CAB C1,
                                                                       STW_ENTSAL_DET D1
                                                                 WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                                                   AND C1.ID = D1.ID_ENTSAL_CAB
                                                                   AND NVL(C1.ESTADO,'N') != 'A'
                                                                   AND D1.ID_ARTICULO = C.ID_ARTICULO
                                                                   AND D1.ID_PEDIDO_DETALLE = C.ID_PEDIDO_DET),0),
                                                 c.id,a.id, p.id, :P0_ID_EMPRESA                                                          
                
                    ) = :P634_ESTADO or :P634_ESTADO is null)
                ```
            pageItemsToSubmit: [
                P634_ID_CLIENTE
                P634_FEC_OCC_HASTA
                P634_FEC_OCC_DESDE
                P634_NRO_OCC
                P634_ARTICULO
                P634_PROVEEDOR
                P634_COD_FABRICANTE
                P634_ESTADO
                P634_NRO_PEDIDO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
