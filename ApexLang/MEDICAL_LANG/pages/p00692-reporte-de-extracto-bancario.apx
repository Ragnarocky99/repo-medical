page 692 (
    name: Reporte de Extracto Bancario
    alias: REPORTE-DE-EXTRACTO-BANCARIO
    title: Reporte de Extracto Bancario
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region reporte-de-extracto-bancario (
        name: Reporte de Extracto Bancario
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COD_BANCO,
                       ID,
                       NRO_CUENTA,
                       ORDEN,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       FEC_COMPROBANTE,
                       FEC_EMISION,
                       FEC_VENCIMIENTO,
                       BENEFICIARIO,
                       BANCO,
                       COD_MONEDA,
                       DESCRIPCION,
                       TOT_DEBITO,
                       TOT_CREDITO,
                       ANULADO,
                       REFERENCIA,
                       DETALLE,
                       DECIMALES,
                       SALDO_ANTERIOR,
                       ID_EMPRESA,
                       ID_PER_JURIDICA,
                       ORD,
                       CUENTA_PRINCIPAL,
                       CUENTA_SECUNDARIA,
                       FEC_CONCILIACION,
                       IND_CONCILIADO,
                       FILA,
                       NRO_PLANILLA_FF,
                       CASE NVL(IND_CONCILIADO,'N')
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS CONCILIADO_ICON
                  from CHVW_EXTRACTO_BANCARIO
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 24736423951903393
        }

