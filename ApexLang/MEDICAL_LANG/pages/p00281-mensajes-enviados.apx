page 281 (
    name: Mensajes Enviados
    alias: MENSAJES-ENVIADOS
    title: Mensajes Enviados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mensajes-recibidos (
        name: Mensajes Recibidos
        type: interactiveReport
        source {
            location: restSource
            restSource: @Mensajes_Recibios
        }
        localPostProcessing {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       API,
                       CASE STATUS
                        WHEN 'sent' THEN 'fa fa-check u-success-text'
                        else   'fa fa-remove u-danger-text'
                       END AS  ESTADO_ICONO,
                       ACCOUNT,
                       CREATED,
                       MESSAGE,
                       RECIPIENT,
                       ATTACHMENT,
                       CASE STATUS 
                       WHEN 'sent' then 'Enviado'
                       else  'Pendiente'
                       end as ESTADO
                  from #APEX$SOURCE_DATA#
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 66649595883234520
        }

        column ACCOUNT (
            type: plainText
            heading {
                heading: Cuenta
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column API (
            type: hidden
            heading {
                heading: Api
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ATTACHMENT (
            type: hidden
            heading {
                heading: Adjunto
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREATED (
            type: plainText
            heading {
                heading: Creado
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICONO#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ESTADO_ICONO (
            type: hidden
            heading {
                heading: Estado Icono
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column MESSAGE (
            type: plainText
            heading {
                heading: Mensaje
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column RECIPIENT (
            type: plainText
            heading {
                heading: Recipiente
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Mensajes Recibidos
        }

        savedReport 666767 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNT (
                sequence: 3
            )

            displayColumn API (
                sequence: 2
            )

            displayColumn ATTACHMENT (
                sequence: 7
            )

            displayColumn CREATED (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn MESSAGE (
                sequence: 5
            )

            displayColumn RECIPIENT (
                sequence: 6
            )

        )

        parameter (
            name: @limit
            value {
                type: staticValue
                staticValue: 100
            }
        )

    )

)

