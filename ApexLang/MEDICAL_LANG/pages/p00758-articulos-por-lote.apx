page 758 (
    name: Articulos por Lote
    alias: ARTICULOS-POR-LOTE
    title: Articulos por Lote
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region articulos-por-lote (
        name: Articulos Por Lote
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                     E.ID,
                     E.ID_EMPRESA,
                     AR.COD_ARTICULO,
                     E.ID_SUCURSAL,
                     LO.NRO_LOTE,
                     AR.ID AS ID_ARTICULO, 
                     NVL(E.CANT_DISPON,  0) AS CANT_DISPON,
                     LO.FEC_VENCIMIENTO,
                     E.NRO_ESTANTE,
                     E.NRO_FILA
                FROM STW_EXISTENCIA_ART E
                JOIN STW_ARTICULOS AR
                  ON AR.ID = E.ID_ARTICULO
                JOIN STW_LOTES LO
                  ON LO.ID = E.ID_LOTE
                JOIN BSW_SUCURSALES SU
                  ON SU.ID = E.ID_SUCURSAL
                WHERE E.ID_EMPRESA = :P0_ID_EMPRESA
                  AND NVL(E.CANT_DISPON,  0) != 0
                  AND E.ID_ARTICULO = :P758_ID_ARTICULO
                  AND NVL(SU.IND_DEPOSITO_VENCIDOS, 'N') = 'N'
                ```
            pageItemsToSubmit: P758_ID_ARTICULO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 31149321353904901
        }

        column CANT_DISPON (
            type: plainText
            heading {
                heading: Cantidad
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FEC_VENCIMIENTO (
            type: plainText
            heading {
                heading: Vencimiento
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_ARTICULO (
            type: hidden
            heading {
                heading: Id Articulo
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NRO_ESTANTE (
            type: plainText
            heading {
                heading: Nro. Estante
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column NRO_FILA (
            type: plainText
            heading {
                heading: Nro. Fila
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column NRO_LOTE (
            type: plainText
            heading {
                heading: Nro. Lote
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Articulos Por Lote
        }

        savedReport 311592 (
            visibility: primaryDefault
            view {
