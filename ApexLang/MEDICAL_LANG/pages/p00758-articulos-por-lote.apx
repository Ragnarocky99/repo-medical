            displayColumn FEC_VENCIMIENTO (
                sequence: 7
            )

            displayColumn ID_SUCURSAL (
                sequence: 2
            )

            displayColumn NRO_ESTANTE (
                sequence: 4
            )

            displayColumn NRO_FILA (
                sequence: 5
            )

            displayColumn NRO_LOTE (
                sequence: 3
            )

        )

    )

    pageItem P758_ID_ARTICULO (
        type: hidden
        layout {
            sequence: 10
            region: @articulos-por-lote
            slot: regionBody
        }
    )

)

