                heading: Indemnización
                alignment: center
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#INDEMNIZACION_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column INDEMNIZACION_ICON (
            type: plainText
            heading {
                heading: Indemnizacion Icon
                alignment: center
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column PREAVISO (
            type: plainText
            heading {
                heading: Preaviso
                alignment: center
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#PREAVISO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column PREAVISO_ICON (
            type: plainText
            heading {
                heading: Preaviso Icon
                alignment: center
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column VAC_CAUSADA (
            type: plainText
            heading {
                heading: Vac. Causadas
                alignment: center
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#VAC_CAUSADA_ICON#"></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column VAC_CAUSADA_ICON (
            type: plainText
            heading {
                heading: Vac Causada Icon
                alignment: center
            }
            layout {
                sequence: 170
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column VAC_PROPORCIONALES (
            type: plainText
            heading {
                heading: Vac. Proporcionales
                alignment: center
            }
            layout {
                sequence: 110
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#VAC_PROPORCIONALES_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column VAC_PROPORCIONALES_ICON (
            type: plainText
            heading {
                heading: Vac Proporcionales Icon
                alignment: center
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Motivos de Salida de la Empresa
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 103632 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_MOTIVO_SALIDA (
                sequence: 1
            )

            displayColumn DCTO_PREAVISO (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn INDEMNIZACION (
                sequence: 3
            )

            displayColumn PREAVISO (
                sequence: 4
            )

            displayColumn VAC_CAUSADA (
                sequence: 6
            )

            displayColumn VAC_PROPORCIONALES (
                sequence: 7
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @motivos-de-salida-de-la-empresa
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 303
                items: {
                    P303_ID: &P303_ID.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction when-dialog-closes (
        name: When dialog closes
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @motivos-de-salida-de-la-empresa
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @motivos-de-salida-de-la-empresa
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

