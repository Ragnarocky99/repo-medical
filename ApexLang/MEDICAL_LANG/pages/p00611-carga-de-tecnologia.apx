page 611 (
    name: Carga de Tecnologia
    alias: CARGA-DE-TECNOLOGIA
    title: Carga de Tecnologia
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P611_COD_TECNOLOGIA").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tecnologia (
        name: Carga de Tecnologia
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_TECNOLOGIA,
                       DESCRIPCION,
                       ABREVIATURA,
                       ESTADO,
                       ID_EMPRESA,
                       COD_USUARIO_AUD,
                       IND_REPLICA
                  from STW_TECNOLOGIA
                  where id_empresa = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P611_ABREVIATURA (
        type: textField
        label {
            label: <P>Abreviatura: </P>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @carga-de-tecnologia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @carga-de-tecnologia
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P611_COD_TECNOLOGIA (
        type: textField
        label {
            label: <P>Código: </P>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-tecnologia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-tecnologia
            column: COD_TECNOLOGIA
            dataType: varchar2
        }
    )

    pageItem P611_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-tecnologia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tecnologia
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P611_DESCRIPCION (
        type: textField
        label {
            label: <P>Descripcion: </P>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-tecnologia
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-tecnologia
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P611_ESTADO (
        type: radioGroup
        label {
            label: <P>Estado: </P>
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Activo;A,Inactivo;I
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @carga-de-tecnologia
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tecnologia
            column: ESTADO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: A
        }
    )

    pageItem P611_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tecnologia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tecnologia
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P611_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-tecnologia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tecnologia
            column: ID_EMPRESA
            dataType: number
            primaryKey: true
        }
        default {
            type: item
            item: P0_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P611_IND_REPLICA (
        type: switch
        label {
            label: <P>Replica: </P>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: Si
            offValue: N
            offLabel: No
        }
        layout {
            sequence: 80
            region: @carga-de-tecnologia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tecnologia
            column: IND_REPLICA
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P611_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P611_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P611_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p611-cod-tecnologia (
        itemName: P611_COD_TECNOLOGIA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(T.COD_TECNOLOGIA)), 0)+1
                from STW_TECNOLOGIA T
                WHERE T.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 10977647630533137
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tecnologia (
        name: Initialize form Carga de Tecnologia
        type: formInitialization
        formRegion: @carga-de-tecnologia
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10976867713533137
        }
    )

    process process-form-carga-de-tecnologia (
        name: Process form Carga de Tecnologia
        type: formAutoRowProcessing
        formRegion: @carga-de-tecnologia
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10977231873533137
        }
    )

)

