            }
            sorting {
                sortable: false
            }
        )

    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P693_ID', p_values => "ID") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P693_ID,'0') = "ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("NRO_LICITACION", 1, 50)||( case when length("NRO_LICITACION") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("NRO_OFERTA", 1, 50)||( case when length("NRO_OFERTA") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "LCW_OFERTAS_CAB" x
                where (:P693_SEARCH is null
                        or upper(x."NRO_LICITACION") like '%'||upper(:P693_SEARCH)||'%'
                        or upper(x."NRO_OFERTA") like '%'||upper(:P693_SEARCH)||'%'
                    )
                order by "NRO_LICITACION"
                ```
            pageItemsToSubmit: P693_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">No data found.</div>
        }

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ICON_CLASS
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: ICON_COLOR_CLASS
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: ID
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: LINK
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: LINK_ATTR
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: LINK_CLASS
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: LIST_BADGE
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 7
