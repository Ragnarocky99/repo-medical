    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 697
                clearCache: 697
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

