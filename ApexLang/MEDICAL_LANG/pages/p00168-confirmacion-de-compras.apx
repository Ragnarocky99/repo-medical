page 168 (
    name: Confirmacion de Compras
    alias: CONFIRMACION-DE-COMPRAS
    title: Confirmacion de Compras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noBorder
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region facturas-de-compras (
        name: Facturas de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_PROVEEDOR,
                       C.TOT_COMPROBANTE,
                       C.TOT_EXENTAS,
                       C.TOT_IVA,
                       C.DESCUENTO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.ID_USUARIO,
                       C.FEC_ALTA,
                       C.REFERENCIA,
                       C.ID_PROVEEDOR_REF,
                       C.NOM_PROVEEDOR,
                       C.RUC,
                       C.TOT_AJUSTE,
                       C.COD_USUARIO_AUD,
                       C.ID_EMBARQUE,
                       C.ID_PEDIDO,
                       C.IND_COBRO_TARJETA,
                       C.IND_CAJA_CHICA,
                       C.NRO_TIMBRADO,
                       REPLACE(REPLACE(ASIENTOS,'*'),'compras') ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'compras'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTO_ID,
                       C.NRO_COMPROBANTE_PROV,
                       C.ID_CENTRO_COSTO,
                       C.FEC_VENC_TIMBRADO,
                       C.ID_CENTRO_COSTO AS NOMBRE_CENTRO,
                       C.ID_SUCURSAL AS NOMBRE_SUCURSAL,
                       C.ID_PROVEEDOR AS NOMBRE_PROVEEDOR,
                       C.ID_PROVEEDOR AS RUC_PROVEEDOR,
                       sys.dbms_lob.getlength(C.FOTO_COMPROBANTE),
                       'VER FACTURA',
                       NULL AS NUM_ORDEN_PAGO,
                       ---TRAE_NUM_ORDEN_PAGO(C.ID) AS NUM_ORDEN_PAGO,
                       ID_NUM_ORDEN_PAGO(C.ID_EMPRESA,C.ID,C.TIP_COMPROBANTE) AS ID_NUM_ORDEN_PAGO,
                       ID_MOV_CAJ_CP(C.ID_EMPRESA,C.ID) AS ID_MOV_CAJ_CP,
                       TRAE_NRO_MOV_CAJ(C.ID_EMPRESA,C.ID) AS NRO_MOV_CAJA,
                       TRAE_SALDO_CM(C.ID_EMPRESA,C.ID) AS SALDO_CM
                
                  from CMW_COMPRAS_CABECERA C
                  WHERE C.ID_EMPRESA=:P0_COD_EMPRESA
                      AND (C.ID_PROVEEDOR=:P168_ID_PROVEEDOR OR :P168_ID_PROVEEDOR IS NULL)
                      AND (C.ID_SUCURSAL=:P168_ID_SUCURSAL OR :P168_ID_SUCURSAL IS NULL)
                      AND (C.ID_CENTRO_COSTO=:P168_ID_CENTRO_COSTO OR :P168_ID_CENTRO_COSTO IS NULL)
                      AND (C.FEC_COMPROBANTE BETWEEN :P168_FEC_COMPROBANTE_DESDE AND :P168_FEC_COMPROBANTE_HASTA OR (:P168_FEC_COMPROBANTE_DESDE IS NULL AND :P168_FEC_COMPROBANTE_HASTA IS NULL ))
                      AND (C.FEC_ALTA BETWEEN :P168_FEC_CARGA_DESDE AND :P168_FEC_CARGA_HASTA OR (:P168_FEC_CARGA_DESDE IS NULL AND :P168_FEC_CARGA_HASTA IS NULL))
                      AND (C.ESTADO=:P168_ESTADO OR :P168_ESTADO IS NULL)
                      AND (C.REFERENCIA like '%'||:P168_REFERENCIA ||'%' OR :P168_REFERENCIA IS NULL)
                      AND (C.COD_USUARIO_AUD = :P168_USU_CARGA OR :P168_USU_CARGA IS NULL)
                  ORDER BY FEC_COMPROBANTE DESC
                ```
            pageItemsToSubmit: [
                P168_ID_PROVEEDOR
                P168_ID_SUCURSAL
                P168_ID_CENTRO_COSTO
                P168_FEC_COMPROBANTE_DESDE
                P168_FEC_COMPROBANTE_HASTA
                P168_FEC_CARGA_DESDE
                P168_FEC_CARGA_HASTA
                P168_ESTADO
                P168_USU_CARGA
                P168_REFERENCIA
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 155
                items: {
                    P155_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 31926134380617249
        }

