    dynamicAction refresh-grid (
        name: Refresh Grid
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @buscar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @facturas-de-compras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar-pantalla (
        name: LImpiar Pantalla
        type: clearSessionState
