    dynamicAction cargar-datos-del-proveedor (
        name: Cargar Datos del Proveedor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P168_ID_PROVEEDOR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT P.NOMBRE,P.RUC 
                    INTO :P168_NOM_PROVEEDOR,:P168_RUC
                    FROM
                    BSW_PERSONAS P,CMW_PROVEEDORES V
                    WHERE P.ID=V.ID_PERSONA
                    AND V.ID_EMPRESA=:P0_COD_EMPRESA
                    AND V.ID=:P168_ID_PROVEEDOR;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    RAISE_APPLICATION_ERROR(-20000,'No se pudo cargar los datos del proveedor');
                    null;
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de proveedores y persona'||sqlerrm);
                    NULL;
                    END;
                    ```
                itemsToSubmit: P168_ID_PROVEEDOR
                itemsToReturn: [
                    P168_NOM_PROVEEDOR
                    P168_RUC
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P168_FEC_CARGA_DESDE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P168_FEC_CARGA_DESDE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P168_FEC_CARGA_DESDE,'/','');
                            conv_fecha := substr(:P168_FEC_CARGA_DESDE,1,2)||'/'||
                                                      substr(:P168_FEC_CARGA_DESDE,3,2)||'/'||
                                                      lpad(substr(:P168_FEC_CARGA_DESDE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P168_FEC_CARGA_DESDE := conv_fecha;
                            ELSIF (length(:P168_FEC_CARGA_DESDE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P168_FEC_CARGA_DESDE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P168_FEC_CARGA_DESDE
                itemsToReturn: P168_FEC_CARGA_DESDE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

