        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region estado-de-cuenta-de-cliente (
        name: Estado de Cuenta de Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select V.ID_EMPRESA,
                       V.ID_SUCURSAL,
                       V.NRO_CUOTA,
                       V.ID_CLIENTE,
                       V.FEC_ORIGEN,
                       V.FEC_ACOBRAR,
                       V.FEC_VENCIMIENTO,
                       V.TIP_CAMBIO,
                       V.ID_MONEDA,
                       --V.MONTO_CUOTA,
                       V.ID_IVA,
                       V.SALDO_CUOTA,
                       V.SALDO_INTERES,
                       V.ID_USUARIO,
                       V.REC_PENDIENTES,
                       V.NOMBRE,
                       V.SUB_TIPO_TRANS,
                       V.DESC_SUBTIPO_TRANS,
                       V.ID_FRACCION,
                       V.ID_MANZANA,
                       V.ID_LOTE,
                       V.SALDO_MORA,
                       V.IND_INTERES,
                       V.ID_GASTO,
                       V.IND_EXONERADO,
                       V.ID_VENDEDOR,
                       V.ORDEN,
                       V.FEC_ULT_PAGO,
                       V.RUC,
                       V.ID_CONTRATO,
                       V.ID_CUOTA,
                       V.NRO_COMPROBANTE,
                
                       decode(v.sub_tipo_trans,1,decode(nvl(v.saldo_cuota,0),0,0,g.precio),10,decode(nvl(v.saldo_cuota,0),0,0,g.precio),0) gasto_operativo,
                       decode(v.saldo_cuota,0,0,v.monto_cuota) monto_cuota, 
                
                    CF_desc_fraccion(v.id_empresa,v.id_fraccion) desc_fraccion,
                    CF_desc_cliente(v.id_empresa,v.id_contrato) desc_cliente,
                    CF_Cant_cuotas(v.id_empresa , v.id_contrato) Cant_cuotas,
                    CF_desc_vendedor(v.id_empresa, v.id_vendedor) desc_vendedor,
                    CF_dias_atraso(v.sub_tipo_trans, v.fec_vencimiento) dias_atraso,
                    CF_empresa(v.id_empresa) empresa,
                    CF_fec_pago(v.id_empresa, v.id_cliente) fec_pago,
                    CF_usuario usuario,
                    CF_Busca_interes(v.ind_interes, v.id_empresa, v.id_contrato, id_cuota, v.nro_cuota, v.saldo_cuota, v.fec_vencimiento, v.saldo_mora, v.id_lote, v.saldo_interes) Busca_interes,
                    monto_dias_de_atras(v.id_empresa, v.id_contrato, v.saldo_cuota, v.id_fraccion) monto_dias_de_atras,
                    CP_CUOTA_PAG(v.id_empresa, v.id_contrato, v.saldo_cuota) CUOTA_PAG,
                    CP_CUO_ATRAS (v.id_empresa, v.id_contrato, v.fec_vencimiento, v.saldo_cuota) CUO_ATRAS
                
                
                  from ltwv_saldos v,
                       ltw_gasto_lote g
                
                
                 where v.id_empresa = g.id_empresa(+)
                   and v.id_gasto   = g.id_gasto(+)
                   and v.id_empresa        = :P0_ID_EMPRESA
                   AND (v.id_contrato   = :P600_CONTRATO_NRO OR :P600_CONTRATO_NRO IS NULL)
                   and (v.id_fraccion    = :P600_FRACCION OR :P600_FRACCION IS NULL)
                   and (v.id_manzana     = :P600_MANZANA OR :P600_MANZANA IS NULL)
                   and (v.id_lote        = :P600_LOTE OR :P600_LOTE IS NULL)
                   and (v.id_cliente = :P600_CLIENTE OR :P600_CLIENTE IS NULL)
                   and (v.fec_vencimiento <= :P600_FECHA_HASTA )
                
                 order by v.fec_vencimiento, v.nro_cuota
                ```
            pageItemsToSubmit: [
                P600_CLIENTE
                P600_CONTRATO_NRO
                P600_FECHA_HASTA
                P600_FRACCION
                P600_MANZANA
                P600_LOTE
                P0_ID_EMPRESA
            ]
        }
        layout {
            sequence: 10
            parentRegion: @filtro
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12293982990079104
        }

