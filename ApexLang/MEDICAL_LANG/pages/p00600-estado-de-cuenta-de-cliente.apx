            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P600_FECHA_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P600_FECHA_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P600_FECHA_HASTA,'/','');
                            conv_fecha := substr(:P600_FECHA_HASTA,1,2)||'/'||
                                                      substr(:P600_FECHA_HASTA,3,2)||'/'||
                                                      lpad(substr(:P600_FECHA_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P600_FECHA_HASTA := conv_fecha;
                            ELSIF (length(:P600_FECHA_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P600_FECHA_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P600_FECHA_HASTA
                itemsToReturn: P600_FECHA_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: REFRESCAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @estado-de-cuenta-de-cliente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: REFRESH
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P600_CLIENTE
                P600_CONTRATO_NRO
                P600_FECHA_HASTA
                P600_FRACCION
                P600_MANZANA
                P600_LOTE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @estado-de-cuenta-de-cliente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar (
        name: Limpiar
        type: clearSessionState
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14017447862561423
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    branch (
        name: Go to page 601
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 601
                items: {
                    P600_CLIENTE: &P600_CLIENTE.
                    P600_CONTRATO_NRO: &P600_CONTRATO_NRO.
                    P600_FECHA_HASTA: &P600_FECHA_HASTA.
                    P600_FRACCION: &P600_FRACCION.
                    P600_MANZANA: &P600_MANZANA.
                    P600_LOTE: &P600_LOTE.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

