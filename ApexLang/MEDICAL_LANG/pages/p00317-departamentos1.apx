page 317 (
    name: Departamentos
    alias: DEPARTAMENTOS1
    title: Departamentos - RR.HH.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region departamentos (
        name: Departamentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_DEPARTAMENTO,
                       DESCRIPCION,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       COD_USUARIO_AUD,
                       ABREVIATURA,
                       ACTIVO,
                       CASE ACTIVO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON       
                  from RHW_DEPARTAMENTOS
                  where ID_EMPRESA=:P0_ID_EMPRESA
                  AND ID_SUCURSAL=:P0_ID_SUCURSAL
                  order by ID ASC;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 324
                items: {
                    P324_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12138402067596247
        }

        column ABREVIATURA (
            type: plainText
            heading {
                heading: Abreviatura
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ACTIVO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ACTIVO_ICON (
            type: plainText
            heading {
                heading: Activo Icon
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column COD_DEPARTAMENTO (
            type: plainText
            heading {
                heading: Código Departamento
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Código Usuario Aud.
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Departamentos
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 125425 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ABREVIATURA (
                sequence: 4
            )

            displayColumn ACTIVO (
                sequence: 6
            )

            displayColumn COD_DEPARTAMENTO (
                sequence: 2
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ID_SUCURSAL (
                sequence: 1
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @departamentos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 324
                items: {
                    P324_ID: &P324_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction when-dialog-closed (
        name: When dialog closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @departamentos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @departamentos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

