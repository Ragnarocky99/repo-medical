page 832 (
    name: Sub Categoria Flujo de Caja
    alias: SUB-CATEGORIA-FLUJO-DE-CAJA
    title: Sub Categoria Flujo de Caja
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var i = 0;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sub-categoria-flujo-de-caja (
        name: Sub Categoria Flujo de Caja
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: FCW_SUBTIP_DENOMINACIONES_CAB
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
            orderByClause: TO_NUMBER(COD_SUBTIP_DENOMINACION) DESC
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Cabecera
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 71807861298377476
        }

        savedReport 718083 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ID_TIP_DENOMINACION
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @COD_SUBTIP_DENOMINACION
                layout {
                    width: 134.656
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ACTIVO
                layout {
                    sequence: 7
                }
            )

        )

        column ACTIVO (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ACTIVO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: A
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_SUBTIP_DENOMINACION (
            type: textField
            heading {
                heading: <p>Codigo</p>
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                maxLength: 15
            }
            source {
                databaseColumn: COD_SUBTIP_DENOMINACION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRIPCION (
            type: textarea
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 300
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_TIP_DENOMINACION (
            type: popupLov
            heading {
                heading: <p>Categoria</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-categoria-flujo-caja
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_TIP_DENOMINACION
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Sub Categoria Flujo de Caja
        }
    )

    dynamicAction inicializar-grilla (
        name: Inicializar Grilla
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @sub-categoria-flujo-de-caja
        }

        action cod-subtip-denominacion (
            name: COD_SUBTIP_DENOMINACION
            action: setValue
            settings {
                type: jsExpression
                jsExpression: i
            }
            affectedElements {
                selectionType: columns
                columns: COD_SUBTIP_DENOMINACION
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: COD_SUBTIP_DENOMINACION
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: i = apex.region("Cabecera").widget().interactiveGrid("getViews", "grid").model.getTotalRecords();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process sub-categoria-flujo-de-caja-save-interactive-grid-data (
        name: Sub Categoria Flujo de Caja - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @sub-categoria-flujo-de-caja
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 71817266482377485
        }
    )

)

