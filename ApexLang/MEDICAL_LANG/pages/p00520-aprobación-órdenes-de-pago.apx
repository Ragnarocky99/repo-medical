page 520 (
    name: Aprobación Órdenes de Pago
    alias: APROBACIÓN-ÓRDENES-DE-PAGO
    title: Aprobación Órdenes de Pago
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            .solo-mostrar{
                background-color:#eeeeee;
                width: 121px;
                height: 23px;
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .cambio{
                    vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            .timbrado{
                background-color:#eeeeee;
                width: 100px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            .a-GV-rowLabel{display:none;}
            
            .Numeros{
                font-weight: bold;
            }
            .Numeros1{
                font-weight: bold;
                background-color: #f4f9f2;
            }
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ordenes-de-pago (
        name: Ordenes de Pago
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       SER_ORDEN_PAGO,
                       NUM_ORDEN_PAGO,
                       FEC_EMISION,
                       FEC_VENCIMIENTO,
                       ID_USUARIO_AUTORIZ,
                       AUTORIZADO,
                       ESTADO,
                       RETENIDO,
                       COD_USUARIO_AUD,
                       PORC_RET_IVA,
                       TOT_RET_IVA,
                       IND_PAGO_ADELANTADO,
                       GRAVADAS,
                       IVA,
                       ID_MOV_CAJ,
                       ID_PROVEEDOR,
                       FEC_AUTORIZADO,
                       IND_CAJA_CHICA,
                       ID_CUENTA_BANCARIA,
                       ID_CONSIGNACION,
                       ID_MONEDA,
                       ID_SUCURSAL,
                       TIP_CAMBIO,
                       NRO_PLANILLA,
                       ID_CENTRO_COSTO,
                       SUMA_TOTAL,
                       (SELECT LISTAGG(DISTINCT(SP.COMENTARIO), '/') FROM CPWV_SOLICITUD_PAGO SP WHERE SP.ID_ORDEN_PAGO = ID) COMENTARIO,
                       COD_USUARIO_AUTORIZA
                  from CPW_CABECERA_ORDEN_PAGO
                  WHERE ID_EMPRESA=:P0_ID_EMPRESA
                  --AND (AUTORIZADO=:P520_IND_AUTORIZADO OR :P520_IND_AUTORIZADO IS NULL) modificado pq cuando N no traía los null
                  AND ( nvl(autorizado,'N') = :P520_IND_AUTORIZADO or :P520_IND_AUTORIZADO is NULL)
                  AND (ID_PROVEEDOR = :P520_PROVEEDOR OR :P520_PROVEEDOR IS NULL)
                  AND (NVL(ID_CENTRO_COSTO,0) = :P520_CENTRO_COSTO OR :P520_CENTRO_COSTO IS NULL)
                  AND (NVL(ESTADO,'P') <> 'A')
                ```
            pageItemsToSubmit: [
                P520_IND_AUTORIZADO
                P520_PROVEEDOR
                P520_CENTRO_COSTO
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
