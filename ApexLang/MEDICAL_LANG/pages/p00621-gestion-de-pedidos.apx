    region detalles-de-pedido (
        name: Detalles de Pedido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    D.ID,
                    D.ID_EMPRESA,
                    D.ID_PEDIDO_CABECERA,
                    D.ID_ARTICULO,
                    D.ID_UNIDAD_MEDIDA,
                    D.DESC_ARTICULO,
                    D.DESC_ARTICULO_STD,
                    D.NUM_ORDEN,
                    D.STOCK,
                    ---CASE TRAE_ESTADO_PEDIDO(ID_EMPRESA,ID_PEDIDO_CABECERA,ID_ARTICULO) 
                    CASE TRAE_ESTADO_PEDIDO_X_DET(ID_EMPRESA,ID_PEDIDO_CABECERA,D.ID,ID_ARTICULO) ---POR ARTICULO
                       WHEN 'EN' THEN 'ENVIADO'
                       WHEN 'CP' THEN 'COMPRAS'
                       WHEN 'CO' THEN 'COTIZAR'
                       WHEN 'SF' THEN 'SIN DEFINIR'
                       END AS ESTADO_PEDIDO,
                
                    CASE
                        WHEN D.CANTIDAD <= D.STOCK THEN D.STOCK
                        ELSE ROUND((D.CANTIDAD - D.STOCK) * -1)
                    END AS cantidad_solicitada,
                
                   (SELECT SUM(CANTIDAD) FROM CMW_COTIZA_ARTICULOS WHERE ID_PEDIDO = D.ID_PEDIDO_CABECERA AND ID_ARTICULO = D.ID_ARTICULO AND ID_PEDIDO_DET = D.Id) AS Presupuestado,
                
                   ---(SELECT NVL(SUM(CANTIDAD), 0) FROM CMW_COTIZA_ARTICULOS WHERE ID_PEDIDO = D.ID_PEDIDO_CABECERA AND ID_ARTICULO = D.ID_ARTICULO) AS Presupuestado,
                    ''vacio,
                    (SELECT COD_ORIGEN_ART FROM STW_ARTICULOS WHERE ID = D.ID_ARTICULO) COD_ORIGEN_ART,
                    (SELECT NVL(IND_CONTROLADO, 'N') FROM STW_ARTICULOS WHERE ID = D.ID_ARTICULO) IND_CONTROLADO,
                    'PED' TIP_COMPROBANTE
                
                FROM
                    VTW_PEDIDOS_DETALLE D
                UNION ALL
                SELECT O.ID,
                       O.ID_EMPRESA,
                       O.ID_LICITACION_CAB,
                       O.ID_ARTICULO,
                       O.ID_UNIDAD_MEDIDA,
                       AR.DESCRIPCION,
                       O.DESC_ARTICULO,
                       LD.NRO_ITEM,
                       OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO    => O.ID_ARTICULO,
                                                  P_ID_SUCURSAL    => NULL,
                                                  P_IND_DISPONIBLE => 'N'),
                       LCWF_TRAE_ESTADO_CONVOCATORIA_DET(LD.ID),
                       CASE
                        WHEN O.CANTIDAD <= OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO    => O.ID_ARTICULO,
                                                                      P_ID_SUCURSAL    => NULL,
                                                                      P_IND_DISPONIBLE => 'N') THEN O.CANTIDAD
                        ELSE ROUND((O.CANTIDAD - OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO    => O.ID_ARTICULO,
                                                                            P_ID_SUCURSAL    => NULL,
                                                                            P_IND_DISPONIBLE => 'N')) * -1)
                       END CANTIDAD_SOLICITADA,
                       O.CANTIDAD,
                       '',
                       AR.COD_ORIGEN_ART,
                       NVL(AR.IND_CONTROLADO, 'N'),
                       'LIC'
                  FROM LCW_OFERTAS O
                  JOIN STW_ARTICULOS AR ON AR.ID = O.ID_ARTICULO
                  JOIN LCW_LICITACIONES_DET LD ON LD.ID = O.ID_LICITACION_DET
                  JOIN LCW_LICITACIONES_CAB LC ON LC.ID = O.ID_LICITACION_CAB
                 WHERE O.IND_GESTION = 'S'
                   AND O.IND_COTIZAR = 'N'
                
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @lista-de-pedidos
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11617694720559056
        }

