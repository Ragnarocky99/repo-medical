    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CMWV_GESTION_PEDIDO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                  AND (NRO_COMPROBANTE = :P621_NRO_PEDIDO OR :P621_NRO_PEDIDO IS NULL)
                  AND (ID_CLIENTE = :P621_CLIENTE OR :P621_CLIENTE IS NULL)
                  AND (ID_SUCURSAL = :P621_SUCURSAL OR :P621_SUCURSAL IS NULL)
                  AND (ESTADO_ = :P621_ESTADO OR :P621_ESTADO IS NULL)
                  AND (FEC_COMPROBANTE BETWEEN :P621_FECHA_DESDE AND :P621_FECHA_HASTA)
                  AND (COD_USUARIO_DESPACHANDO = :P621_DESPACHADO_POR OR :P621_DESPACHADO_POR IS NULL )
                  AND (ID_USUARIO = :P621_CARGADO_POR OR :P621_CARGADO_POR IS NULL )
                ```
            pageItemsToSubmit: [
                P621_CLIENTE
                P621_ESTADO
                P621_TIPO
                P621_SUCURSAL
                P621_FECHA_DESDE
                P621_FECHA_HASTA
                P621_NRO_PEDIDO
                P621_DESPACHADO_POR
                P621_CARGADO_POR
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
