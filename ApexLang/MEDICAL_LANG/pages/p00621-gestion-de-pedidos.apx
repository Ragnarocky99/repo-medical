    dynamicAction setear-usuario-despachando (
        name: Setear Usuario Despachando
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @lista-de-pedidos
            columns: COD_USUARIO_DESPACHANDO
        }

        action usuario-despachando (
            name: USUARIO_DESPACHANDO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT P.NOMBRE
                      FROM BSW_USUARIOS U
                      JOIN BSW_PERSONAS P ON P.ID = U.ID_PERSONA
                     WHERE U.ID = :COD_USUARIO_DESPACHANDO
                    ```
                itemsToSubmit: COD_USUARIO_DESPACHANDO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: USUARIO_DESPACHANDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process detalles-de-pedido-save-interactive-grid-data (
        name: Detalles de Pedido - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles-de-pedido
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 11658951537559067
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process lista-de-pedidos-save-interactive-grid-data (
        name: Lista de Pedidos - Save Interactive Grid Data
        type: executeCode
        editableRegion: @lista-de-pedidos
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VCOD_USUARIO BSW_USUARIOS.COD_USUARIO%TYPE;
                BEGIN
                    CASE :APEX$ROW_STATUS
                    WHEN 'C' THEN
                        NULL;
                    WHEN 'U' THEN
                        IF :TIP_COMPROBANTE = 'PED' THEN
                            UPDATE VTW_PEDIDOS_CABECERA
                               SET COD_USUARIO_DESPACHANDO  = :COD_USUARIO_DESPACHANDO
                             WHERE ID  = :ID;
                        END IF;
                
                        IF :TIP_COMPROBANTE = 'LIC' THEN
                            IF :COD_USUARIO_DESPACHANDO IS NULL THEN
                                VCOD_USUARIO := NULL;
                            ELSE
                                VCOD_USUARIO := :APP_USER;
                            END IF;
                
                            UPDATE LCW_LICITACIONES_CAB
                               SET COD_USUARIO_DESPACHANDO = VCOD_USUARIO
                             WHERE ID = :ID;
                        END IF;
                        
                    WHEN 'D' THEN
                        NULL;
                    END CASE;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 11616921732558820
        }
    )

)

