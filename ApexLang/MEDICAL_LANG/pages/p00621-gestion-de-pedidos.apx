            type: page
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11550666345558796
        }

