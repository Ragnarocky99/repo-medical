            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reporte de Gestion de Reservas
        }

        savedReport 888643 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANT_BLOQUEO (
                sequence: 8
            )

            displayColumn COD_ARTICULO (
                sequence: 1
            )

            displayColumn COD_FABRICANTE (
                sequence: 2
            )

            displayColumn DESC_ARTICULO (
                sequence: 6
