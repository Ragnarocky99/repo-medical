page 845 (
    name: Reporte de Gestion de Reservas
    alias: REPORTE-DE-GESTION-DE-RESERVAS
    title: Reporte de Gestion de Reservas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region reporte-de-gestion-de-reservas (
        name: Reporte de Gestion de Reservas
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CMWV_GESTION_RESERVAS
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 88859449469973757
        }

        column CANT_BLOQUEO (
            type: link
            heading {
                heading: Cant. Bloqueo
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            link {
                target: {
                    page: 646
                    items: {
                        P646_ID: #ID_ARTICULO#
                    }
                }
                linkText: #CANT_BLOQUEO#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column CANT_RESERVA (
            type: plainText
            heading {
                heading: Cant. Reserva
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_FABRICANTE (
            type: plainText
            heading {
                heading: Cod. Fabricante
                alignment: center
            }
            layout {
                sequence: 18
