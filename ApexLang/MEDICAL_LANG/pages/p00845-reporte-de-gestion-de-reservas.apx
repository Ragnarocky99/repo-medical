                sort {
                    sequence: 2
                }
            )

        )

    )

    dynamicAction acciones-al-cargar-pagina (
        name: Acciones al cargar pagina
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @reporte-de-gestion-de-reservas
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-de-gestion-de-reservas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

