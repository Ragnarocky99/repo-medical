            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column ID_ARTICULO (
            type: hidden
            heading {
                heading: Id Articulo
            }
            layout {
                sequence: 58
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_EMPRESA (
            type: hidden
