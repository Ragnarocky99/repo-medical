    region remisiones (
        name: Remisiones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID_REMISION,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.FEC_COMPROBANTE,
                       C.NOMBRE_CLIENTE,
                       C.SUCURSAL_SALIDA,
                       C.SUCURSAL_ENTRADA,
                       NVL(C.ESTADO,'N') ESTADO,
                       NVL(C.IND_ENVIADO_FE,'N')  IND_ENVIADO_FE,
                       NVL(C.IND_APROBADO_FE,'N') IND_APROBADO_FE,
                       NVL(C.IND_RECHAZADO_FE,'N') IND_RECHAZADO_FE
                  from FEWV_REMISION_CAB C
                 WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                   AND C.ID_SERIE_COMP = :P821_SER_COMPROBANTE
                   AND (C.FEC_COMPROBANTE BETWEEN :P821_FEC_DESDE AND :P821_FEC_HASTA)
                   AND (C.NRO_COMPROBANTE BETWEEN NVL(:P821_NRO_DESDE, C.NRO_COMPROBANTE) AND NVL(:P821_NRO_HASTA,C.NRO_COMPROBANTE))
                
                ```
            pageItemsToSubmit: [
                P821_FEC_DESDE
                P821_FEC_HASTA
                P821_NRO_DESDE
                P821_NRO_HASTA
                P821_SER_COMPROBANTE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 148322042491672386
        }

