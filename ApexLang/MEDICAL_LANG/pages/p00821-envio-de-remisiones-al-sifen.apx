    dynamicAction convertir-fech-hasta (
        name: CONVERTIR_FECH_HASTA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P821_FEC_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                        v_año NUMBER;
                    
                    begin
                    SELECT EXTRACT(YEAR FROM SYSDATE) INTO v_año FROM DUAL;
                    
                        if (length(:P821_FEC_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P821_FEC_HASTA,'/','');
                            conv_fecha := substr(:P821_FEC_HASTA,1,2)||'/'||
                                                      substr(:P821_FEC_HASTA,3,2)||'/'||
                                                      lpad(substr(:P821_FEC_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P821_FEC_HASTA := conv_fecha;
                            ELSIF (length(:P821_FEC_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P821_FEC_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                    
                            ELSIF (length(:P821_FEC_HASTA) = 4) THEN
                                conv_fecha := replace(:P821_FEC_HASTA,'/','');
                                conv_fecha := substr(:P821_FEC_HASTA,1,2)||'/'||
                                                      substr(:P821_FEC_HASTA,3,2) ||'/'|| v_año;
                                :P821_FEC_HASTA := conv_fecha;
                    
                            ELSIF (length(:P821_FEC_HASTA) = 5) THEN
                                conv_fecha := :P821_FEC_HASTA ||'/'|| v_año;
                                :P821_FEC_HASTA := conv_fecha;
                        end if;
                    end;
                    ```
                itemsToSubmit: P821_FEC_HASTA
                itemsToReturn: P821_FEC_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh (
            name: REFRESH
            action: refresh
            affectedElements {
                selectionType: region
                region: @remisiones
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction convertir-fecha (
        name: CONVERTIR_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P821_FEC_DESDE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                        v_año NUMBER;
                    
                    begin
                    SELECT EXTRACT(YEAR FROM SYSDATE) INTO v_año FROM DUAL;
                    
                        if (length(:P821_FEC_DESDE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P821_FEC_DESDE,'/','');
                            conv_fecha := substr(:P821_FEC_DESDE,1,2)||'/'||
                                                      substr(:P821_FEC_DESDE,3,2)||'/'||
                                                      lpad(substr(:P821_FEC_DESDE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P821_FEC_DESDE := conv_fecha;
                            ELSIF (length(:P821_FEC_DESDE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P821_FEC_DESDE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                    
                            ELSIF (length(:P821_FEC_DESDE) = 4) THEN
                                conv_fecha := replace(:P821_FEC_DESDE,'/','');
                                conv_fecha := substr(:P821_FEC_DESDE,1,2)||'/'||
                                                      substr(:P821_FEC_DESDE,3,2) ||'/'|| v_año;
                                :P821_FEC_DESDE := conv_fecha;
                    
                            ELSIF (length(:P821_FEC_DESDE) = 5) THEN
                                conv_fecha := :P821_FEC_DESDE ||'/'|| v_año;
                                :P821_FEC_DESDE := conv_fecha;
                        end if;
                    end;
                    ```
                itemsToSubmit: P821_FEC_DESDE
                itemsToReturn: P821_FEC_DESDE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh (
            name: REFRESH
            action: refresh
            affectedElements {
                selectionType: region
                region: @remisiones
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

