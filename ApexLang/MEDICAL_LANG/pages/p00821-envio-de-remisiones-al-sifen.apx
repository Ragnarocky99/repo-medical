    process enviar-al-sifen (
        name: ENVIAR_AL_SIFEN
        type: executeCode
        editableRegion: @remisiones
        source {
            plsqlCode:
                ```plsql
                DECLARE
                VMENSAJE     VARCHAR2(500);
                VKM_ESTIMADO STW_ENTSAL_CAB.KM_ESTIMADO%TYPE;
