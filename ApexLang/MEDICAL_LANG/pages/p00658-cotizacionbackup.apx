    region cotizacion-de-compras (
        name: cotizacion de compras
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_ARTICULO,
                       C.ID_PROVEEDOR,
                       C.ID_MONEDA,
                       c.PRECIO_RECARGO PRECIO,
                       c.PRECIO_RECARGO*c.cantidad AS mon_costo,
                       C.PRECIO AS mon_costo_copia,
                       C.APROBADO,
                       C.TIPO_IVA,
                       C.PORCENTAJE_DESCUENTO,
                       C.CANTIDAD,
                       C.CANTIDAD AS CANTIDAD_COPIA,
                       C.COD_ARTICULO_REF,
                       C.NRO_ITEM,
                       C.SALDO,
                       C.OBSERVACION,
                       C.COTIZA,
                       C.COD_USUARIO_APRO,
                       C.CAMBIO,
                       C.ID_CONDICION_VENTAS,
                       C.IND_GENERA_OC,
                       C.IND_ORDEN,
                       A.ID_ENVASE,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MARCA,
                       A.COD_ARTICULO,
                       ---A.DESCRIPCION AS DESC_ARTICULO,
                       ---D.DESC_ARTICULO AS DESC_ARTICULO,
                       CASE WHEN  C.ID_ARTICULO != W_BUSCA_PARAMETRO('ST','ID_ART_ESTANDAR')
                       THEN A.DESCRIPCION
                       ELSE NVL(D.DESC_ARTICULO,A.DESCRIPCION) 
                       END AS DESC_ARTICULO,
                       C.ID_PEDIDO,
                       C.ID_TIPO_ENTREGA,
                       C.IND_ENVIO,
                       round(DECODE(C.PORC_MARGEN, NULL, 0, PORC_MARGEN)) AS PORC_MARGEN,
                       round(nvl(C.MARGEN_UNITARIO,0)) MARGEN_UNITARIO,
                       round(nvl(C.MARGEN_TOTAL,0)) MARGEN_TOTAL,
                       ''espacio,
                
                       C.ID_MONEDA_PRECIO,
                       C.TIP_CAMBIO_MONEDA_PRECIO,
                
                       round(nvl(C.PRECIO_UNITARIO,0),mo.decimales) PRECIO_UNITARIO,
                       round(nvl(C.PRECIO_TOTAL,0),mo.decimales) PRECIO_TOTAL,
                       round(nvl(C.CANTIDAD_APROBADA,0),mo.decimales)CANTIDAD_APROBADA,
                       C.NRO_OCC,
                       C.FEC_OCC,
                       ---''Aprobar,
                
                       CASE 
                        WHEN (CANTIDAD_APROBADA >0 )THEN 'S'
                        WHEN CANTIDAD_APROBADA IS NULL THEN 'N'
                        ELSE 'N'
                    END AS Aprobar,
                    nvl(C.PRECIO_TOTAL,0) as PRECIO_TOTAL_COPIA,
                    nvl(C.CANTIDAD_APROBADA,0) AS CANTIDAD_APROBADA_COPIA,
                    C.IND_ANULADO,
                    C.COD_USARIO_ANU,
                    C.FEC_ANULACION,
                    C.CANT_ANULADA,
                    C.COMENTARIO_ANULACION,
                    C.COD_USUARIO_APROB,
                    C.FEC_APROB,
                    C.COMENTARIO_APROB,
                    A.COD_ORIGEN_ART,
                    A.ID_RUBRO,
                    A.ID_GRUPO_ART,
                    A.ESTADO,
                   /* CASE
                        WHEN (PF.PRECIO_FIJO_CIVA IS NULL) THEN 0
                        WHEN (PF.PRECIO_FIJO_CIVA IS NOT NULL) THEN PF.PRECIO_FIJO_CIVA
                        ELSE 0
                    END AS PRECIO_FIJO_CIVA*/
                    NVL(CF_PRECIO_VENTA_ANTFORMULA(C.ID_EMPRESA,43,SYSDATE,C.ID_ARTICULO),0) PRECIO_FIJO_CIVA
                    --PF.PRECIO_FIJO_CIVA
                    ---,
                    ----SUM(NVL(E.CANT_DISPON,  0)) - SUM(NVL(AB.CANT_BLOQUEO,0)) AS DISPONIBILIDAD--,
                    ---DECODE (C.ID_ARTICULO,726,'X','UD') as EDITABLE
                    /*,
                     CASE 
                        WHEN A.IND_PELIGROSO = 'S' THEN 
                             C.PRECIO + (C.PRECIO * PV.POR_RECARGO_PELIGRO / 100)
                        ELSE 
                             C.PRECIO + (C.PRECIO * PV.POR_RECARGO_NORMAL / 100)
                    END AS PRECIO_CON_RECARGO*/
                FROM 
                    CMW_COTIZA_ARTICULOS C,
                    BSW_MONEDAS MO,
                    STW_ARTICULOS A,
                    VTW_PEDIDOS_DETALLE D,
                    STW_EXISTENCIA_ART E,
                    CMW_PROVEEDORES PRO
                
                WHERE 
                    C.ID_EMPRESA = :P0_ID_EMPRESA
                    -- AND C.ID = :P658_ID
                    --AND C.ID_PEDIDO = :P658_ID_PEDIDO
                    AND C.ID_PEDIDO = :P658_ID_PEDIDO_2
                    AND C.IND_CLIENTE = 'S'
                    AND A.ID         = C.ID_ARTICULO 
                    AND A.ID_EMPRESA = C.ID_EMPRESA
                    AND D.ID = C.ID_PEDIDO_DET 
                   -- AND D.ID_EMPRESA = C.ID_EMPRESA
                    AND C.ID_ARTICULO = E.ID_ARTICULO(+) 
                   -- AND C.ID_EMPRESA = E.ID_EMPRESA
                    AND C.ID_MONEDA_PRECIO = MO.ID(+)
                    AND PRO.ID = C.ID_PROVEEDOR
                group by C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_ARTICULO,
                       C.ID_PROVEEDOR,
                       C.ID_MONEDA,
                       c.PRECIO_RECARGO,
                       c.PRECIO_RECARGO,
                       C.PRECIO,
                       C.APROBADO,
                       C.TIPO_IVA,
                       C.PORCENTAJE_DESCUENTO,
                       C.CANTIDAD,
                       C.COD_ARTICULO_REF,
                       C.NRO_ITEM,
                       C.SALDO,
                       C.OBSERVACION,
                       C.COTIZA,
                       C.COD_USUARIO_APRO,
                       C.CAMBIO,
                       C.ID_CONDICION_VENTAS,
                       C.IND_GENERA_OC,
                       C.IND_ORDEN,
                       A.ID_ENVASE,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MARCA,
                       A.COD_ARTICULO,
                       D.DESC_ARTICULO,
                       A.DESCRIPCION,
                       C.ID_PEDIDO,
                       C.ID_TIPO_ENTREGA,
                       C.IND_ENVIO,
                       C.PORC_MARGEN,
                       C.MARGEN_UNITARIO,
                       C.MARGEN_TOTAL,
                       C.ID_MONEDA_PRECIO,
                       C.TIP_CAMBIO_MONEDA_PRECIO,
                       C.PRECIO_UNITARIO,
                       C.PRECIO_TOTAL,
                       C.CANTIDAD_APROBADA,
                       C.NRO_OCC,
                       C.FEC_OCC,
                       C.PRECIO_TOTAL,
                       C.CANTIDAD_APROBADA,
                       C.IND_ANULADO,
                       C.COD_USARIO_ANU,
                       C.FEC_ANULACION,
                       C.CANT_ANULADA,
                       C.COMENTARIO_ANULACION,
                       A.COD_ORIGEN_ART,
                       A.ID_RUBRO,
                       A.ID_GRUPO_ART,
                       C.COD_USUARIO_APROB,
                       C.FEC_APROB,
                       C.COMENTARIO_APROB,
                       A.ESTADO,
                       MO.DECIMALES
                ```
