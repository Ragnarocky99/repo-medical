    dynamicAction cambiar-montos (
        name: Cambiar Montos
        execution {
            sequence: 80
            type: debounce
            time: 1
        }
        when {
            selectionType: columns
            interactiveGrid: @cotizacion-de-compras
            columns: [
                CANTIDAD
                PORC_MARGEN
                CANTIDAD_APROBADA
                ID_MONEDA
                CAMBIO
                ID_MONEDA_PRECIO
                TIP_CAMBIO_MONEDA_PRECIO
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        V_CANT_APRO NUMBER(15);
                        V_CANT_AUX  NUMBER(18,3);
                        V_DECIMALES NUMBER := 0;
                    BEGIN
                        BEGIN
                          SELECT DECIMALES 
                            INTO V_DECIMALES
                          FROM BSW_MONEDAS MO 
                          WHERE MO.ID = :ID_MONEDA_PRECIO;
                        EXCEPTION
                          WHEN OTHERS THEN
                            V_DECIMALES := 0;
                        END;
                        IF :CANTIDAD IS NULL THEN 
                        :CANTIDAD:=1;
                        END IF;
                    
                        IF :PRECIO IS NULL THEN
                        :PRECIO:=0;
                        END IF;
                    
                    
                        IF :PORC_MARGEN IS NULL THEN
                        :PORC_MARGEN:=0;
                        END IF;
                    
                        IF :MARGEN_UNITARIO IS NULL THEN
                        :MARGEN_UNITARIO:=0;
                        END IF;
                    
                        IF :CANTIDAD_APROBADA = 0 THEN
                            V_CANT_APRO := 0;
                        ELSE
                            V_CANT_APRO := :CANTIDAD_APROBADA; 
                        END IF;
                        --AGREGADO 22/01/2024
                        IF NVL(:CANTIDAD_APROBADA,0) > 0 THEN
                           V_CANT_AUX := :CANTIDAD_APROBADA;
                        ELSE 
                           V_CANT_AUX := :CANTIDAD;  
                        END IF;
                            
                    
                        :MON_COSTO       := :CANTIDAD*(replace(:PRECIO,'.',''));
                        :MARGEN_UNITARIO := ((replace(:PRECIO,'.',''))/ 100)*(:PORC_MARGEN);
                        :MARGEN_TOTAL    := (((replace(:PRECIO,'.',''))/ 100)*(:PORC_MARGEN)*(V_CANT_AUX/*NVL(V_CANT_APRO,:CANTIDAD*/));
                    
                        IF :ID_MONEDA = nvl(:ID_MONEDA_PRECIO,:id_moneda) THEN
                          :PRECIO_UNITARIO := ROUND(((replace(:PRECIO,'.',''))+((replace(:PRECIO,'.',''))/ 100)*(:PORC_MARGEN)),V_DECIMALES);
                          :PRECIO_TOTAL    := ROUND(((replace(:PRECIO_UNITARIO,'.',''))*(V_CANT_AUX)),V_DECIMALES);
                        ELSE
                          :PRECIO_UNITARIO := ROUND(((replace(:PRECIO,'.',''))+((replace(:PRECIO,'.',''))/ 100)*(:PORC_MARGEN))*replace(:CAMBIO,'.','')/replace(:TIP_CAMBIO_MONEDA_PRECIO,'.',''),V_DECIMALES);
                          :PRECIO_TOTAL    := ROUND(((replace(:PRECIO_UNITARIO,'.',''))*(V_CANT_AUX)),V_DECIMALES);
                        END IF;
                       
                    END;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO
                    PORC_MARGEN
                    MARGEN_UNITARIO
                    CANTIDAD_APROBADA
                    ID_MONEDA_PRECIO
                    TIP_CAMBIO_MONEDA_PRECIO
                    CAMBIO
                    ID_MONEDA
                ]
                itemsToReturn: [
                    MON_COSTO
                    MARGEN_UNITARIO
                    MARGEN_TOTAL
                    PRECIO_UNITARIO
                    PRECIO_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotal();
            }
            execution {
                sequence: 160
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: APROBAR
                value: S
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :PRECIO_TOTAL
                itemsToSubmit: PRECIO_TOTAL
            }
            affectedElements {
                selectionType: columns
                columns: PRECIO_TOTAL_COPIA
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD_APROBADA
                itemsToSubmit: CANTIDAD_APROBADA
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_APROBADA_COPIA
            }
            execution {
                sequence: 70
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_COPIA
            }
            execution {
                sequence: 110
            }
        )

    )

