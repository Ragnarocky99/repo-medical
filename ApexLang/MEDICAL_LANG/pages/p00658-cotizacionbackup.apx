    dynamicAction setear-cambio-precio (
        name: Setear_cambio_precio
        execution {
            sequence: 210
        }
        when {
            selectionType: columns
            interactiveGrid: @cotizacion-de-compras
            columns: ID_MONEDA_PRECIO
        }

        action cambio (
            name: cambio2
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                      IF NVL(:ID_MONEDA,32) = NVL(:ID_MONEDA_PRECIO,32) THEN
                        RETURN :CAMBIO;
                      ELSE
                        RETURN FTIPOS_CAMBIO(:ID_MONEDA_PRECIO,SYSDATE,'C','V');
                      END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                       RAISE_APPLICATION_ERROR(-20000,'Error al encontrar el CambioPrecio de la moneda');
                    END;
                    ```
                itemsToSubmit: [
                    ID_MONEDA_PRECIO
                    ID_MONEDA
                    CAMBIO
                ]
            }
            affectedElements {
                selectionType: columns
                columns: TIP_CAMBIO_MONEDA_PRECIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

