    process cotizacion-de-compras-save-interactive-grid-data (
        name: cotizacion de compras - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @cotizacion-de-compras
        target {
            targetType: tableView
            tableName: CMW_COTIZA_ARTICULOS
        }
        lockRow {
            preventLostUpdates: false
            lockRow: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 68829935836667342
        }
    )

    process guardar-estado-vtw-pedidos (
        name: Guardar estado vtw_pedidos
        type: interactiveGridAutoRowProcessing
        editableRegion: @cotizacion-de-compras
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                BEGIN -- It runs row by row for interactive grid
                    IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                        
                        RETURN;
                    ELSIF :APEX$ROW_STATUS = 'C' THEN -- CREATE
                        IF :IND_ENVIO = 'S' THEN
                            UPDATE VTW_PEDIDOS_CABECERA
                            SET ESTADO = 'EN'
                            WHERE ID = :ID_PEDIDO;
                        END IF;
                        RETURN;
                    ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                        IF :IND_ENVIO = 'S' THEN
                            UPDATE VTW_PEDIDOS_CABECERA
                            SET ESTADO = 'EN'
                            WHERE ID = :ID_PEDIDO;
                        END IF;
                        RETURN;
                    END IF;
                END;
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 68830342296667342
        }
        serverSideCondition {
            type: never
        }
    )

    process setear-estado-pedido (
        name: Setear estado pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_estado        inv.vtw_pedidos_cabecera.estado%type;
                    v_ind_enviado   inv.cmw_cotiza_articulos.ind_envio%type;
                    v_id_pedido     inv.vtw_pedidos_cabecera.id%type;
                begin
                    select  p.id, p.estado
                    into    v_id_pedido, v_estado
                    from    vtw_pedidos_cabecera p
                    where   p.nro_comprobante = :P658_ID_PEDIDO;
                
                    raise_application_error(-20000, v_id_pedido||' '||v_estado);
                    select  c.ind_envio
                    into    v_ind_enviado
                    from    cmw_cotiza_articulos c
                    where   c.id_pedido = v_id_pedido;
                
                    if v_ind_enviado = 'S' and v_estado = 'PA' then
                        update  vtw_pedidos_cabecera
                        set     estado = 'EN'
                        where   id = v_id_pedido;
                    end if;
                
                    if v_ind_enviado = 'N' and v_estado = 'EN' then
                        update  vtw_pedidos_cabecera
                        set     estado = 'PA'
                        where   id = v_id_pedido;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 68836896068667354
        }
        serverSideCondition {
            type: never
        }
    )

)

