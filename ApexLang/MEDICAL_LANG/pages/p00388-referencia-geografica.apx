page 388 (
    name: Referencias Geograficas
    alias: REFERENCIA-GEOGRAFICA
    title: Referencias Geograficas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region referencia-geografica (
        name: Referencia Geografica
        type: interactiveReport
        source {
            location: localDatabase
            tableName: FEW_REFERENCIA_GEOGRAFICA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 389
                items: {
                    P389_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 22369588588993184
        }

        column COD_CIUDAD (
            type: plainText
            heading {
                heading: Cod Ciudad
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COD_DEPARTAMENTO (
            type: plainText
            heading {
                heading: Cod Departamento
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_DISTRITO (
            type: plainText
            heading {
                heading: Cod Distrito
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column COD_PAIS (
            type: plainText
            heading {
                heading: Cod Pais
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESC_CIUDAD (
            type: plainText
            heading {
                heading: Desc Ciudad
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESC_DEPARTAMENTO (
            type: plainText
            heading {
                heading: Desc Departamento
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESC_DISTRITO (
            type: plainText
            heading {
                heading: Desc Distrito
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESC_PAIS (
            type: plainText
            heading {
                heading: Desc Pais
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Referencia Geografica
        }

        savedReport 223763 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CIUDAD (
                sequence: 8
            )

            displayColumn COD_DEPARTAMENTO (
                sequence: 4
            )

            displayColumn COD_DISTRITO (
                sequence: 6
            )

            displayColumn COD_PAIS (
                sequence: 2
            )

            displayColumn DESC_CIUDAD (
                sequence: 9
            )

            displayColumn DESC_DEPARTAMENTO (
                sequence: 5
            )

            displayColumn DESC_DISTRITO (
                sequence: 7
            )

            displayColumn DESC_PAIS (
                sequence: 3
            )

            displayColumn ID (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @referencia-geografica
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 389
                clearCache: 389
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @referencia-geografica
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @referencia-geografica
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

