page 349 (
    name: Embarque
    alias: EMBARQUE
    title: Embarque
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region embarque (
        name: Embarque
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select E.ID,
                       E.ID_EMPRESA,
                       E.NRO_EMBARQUE,
                       E.FEC_EMBARQUE,
                       E.ID_PUERTO,
                       E.DESCRIPCION,
                       E.VERIFICADORA,
                       E.TRANSPORTE,
                       E.ID_VIA,
                       E.FEC_PROB_LLEGADA,
                       E.ESTADO,
                       E.ANULADO,
                       E.COD_USUARIO_AUD,
                       P.NRO_COMPROBANTE AS PROFORMA,
                           CASE E.ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS ICONO_ANULADO,
                       'RUTA',
                       ID_PROVEEDOR_ORIGEN
                  from CMW_EMBARQUES E,CMW_PROFORMAS_CABECERA P
                 where E.ID_EMPRESA=:P0_ID_EMPRESA
                   and E.FEC_EMBARQUE between :P349_FEC_INI and :P349_FEC_FIN
                   and (E.ID_PROVEEDOR_ORIGEN = :P349_ID_PROVEEDOR_ORIGEN or :P349_ID_PROVEEDOR_ORIGEN is null)
                   and (E.NRO_EMBARQUE = :P349_NRO_EMBARQUE or :P349_NRO_EMBARQUE is null)
                 AND E.ID_PROFORMA=P.ID(+)
                 ORDER BY FEC_EMBARQUE DESC, NRO_EMBARQUE DESC
                ```
            pageItemsToSubmit: [
                P349_FEC_INI
                P349_FEC_FIN
                P349_ID_PROVEEDOR_ORIGEN
                P349_NRO_EMBARQUE
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 345
                items: {
                    P345_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 18011337158006693
        }

        column 'RUTA' (
            type: link
            heading {
                heading: Ruta
                alignment: center
            }
            layout {
                sequence: 184
            }
            link {
                target: {
                    page: 421
                    items: {
                        P421_ID: #ID#
                    }
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column ANULADO (
            type: plainText
            heading {
                heading: Anulado
            }
            layout {
                sequence: 94
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ICONO_ANULADO#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Usuario Auditor
            }
            layout {
                sequence: 104
