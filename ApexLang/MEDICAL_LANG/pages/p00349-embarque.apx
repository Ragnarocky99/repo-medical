                &P0_DESC_EMPRESA.
                Embarque
                ```
        }
        pageFooter {
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 180182 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn 'RUTA' (
                sequence: 11
