    validation validar-total (
        name: VALIDAR_TOTAL
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF REPLACE(:P580_MON_COSTO, '.', '') IS NULL OR REPLACE(:P580_MON_COSTO, '.', '') = 0 THEN
                RETURN FALSE;
                ELSE
                RETURN TRUE; 
                END IF;
                ```
        }
        error {
            errorMessage: "No se pueden cargar compras vacias. "
            displayLocation: onErrorPage
            associatedItem: @P580_MON_COSTO
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,UPDATE
        }
    )

    computation p580-nro-comprobante (
        itemName: P580_NRO_COMPROBANTE
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_num_comp_cp  COW_MOV_BIENES_CAB.NRO_COMPROBANTE%TYPE;
                BEGIN
                    IF :P580_NRO_COMPROBANTE IS  NULL THEN 
                    BEGIN
                        SELECT to_number(MAX(nvl(C.NRO_COMPROBANTE,0)))+1
                          INTO v_num_comp_cp
                        FROM COW_MOV_BIENES_CAB C
                        WHERE TIP_COMPROBANTE = :P580_TIP_COMPROBANTE
                          AND SER_COMPROBANTE = :P580_SER_COMPROBANTE
                          AND ID_EMPRESA = :P0_ID_EMPRESA;
                        EXCEPTION
                        WHEN NO_DATA_FOUND THEN 
                        raise_application_error(-20000,'No se ha encontrado comprobantes creados con '||:P580_TIP_COMPROBANTE||' '||:P580_SER_COMPROBANTE);
                    END;
                        IF v_num_comp_cp is null then
                            
                            v_num_comp_cp:=1;
                        END IF;
                    END IF;
                    RETURN v_num_comp_cp;
                    exception
                        WHEN NO_DATA_FOUND THEN
                            v_num_comp_cp:=1;
                            return v_num_comp_cp;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000,'Error al generar el nro. de comprobante'||sqlerrm);
                            v_num_comp_cp:=1;
                            return v_num_comp_cp;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P580_ID
        }
    )

