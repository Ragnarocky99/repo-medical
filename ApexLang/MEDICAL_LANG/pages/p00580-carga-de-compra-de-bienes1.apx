    dynamicAction calc-tot (
        name: CALC_TOT
        execution {
            sequence: 50
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: MON_COSTO
        }

        action calcular-totales (
            name: Calcular Totales
            action: executeJsCode
            settings {
                jsCode: calculaTotalBienes();
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MON_COSTO
                itemsToSubmit: MON_COSTO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: MON_COSTO_COPIA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-monto (
        name: CALCULAR_MONTO
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: CANTIDAD
        }
        comments {
            comments: Aqui se va calculando el total correspondiente (Monto total)
        }

        action monto-total (
            name: Monto Total
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :CANTIDAD IS NOT NULL AND :COSTO_UNITARIO IS NOT NULL THEN
                        :MON_COSTO := ROUND(replace(:CANTIDAD, '.', '') * replace(:COSTO_UNITARIO, '.', ''));
                    --:MONTO_TOTAL_C_IVA:=:CANTIDAD * :PRECIO_UNITARIO_C_IVA;
                    END IF;
                    ```
                itemsToSubmit: [
                    COSTO_UNITARIO
                    CANTIDAD
                ]
                itemsToReturn: [
                    MON_COSTO
                    COSTO_UNITARIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction carga-datos-costo-unitario (
        name: Carga Datos Costo Unitario
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: ID_BIEN
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_monto_unitario  COW_BIENES_USO.MON_COSTO%TYPE;
                    BEGIN
                        select ltrim(B.MON_COSTO) MON_COSTO
                           INTO v_monto_unitario
                        from COW_BIENES_USO B
                        where B.id = :ID_BIEN
                          and B.id_empresa = :P0_ID_EMPRESA;
                        RETURN v_monto_unitario;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN 
                            return null;
                        when others then
                            raise_application_error(-20000,'Error en la tabla de bienes'||sqlerrm);
                            return null;
                    END;
                    ```
                itemsToSubmit: [
                    ID_BIEN
                    P0_ID_EMPRESA
                ]
            }
            affectedElements {
                selectionType: columns
                columns: COSTO_UNITARIO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: P580_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P580_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P580_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P580_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P580_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P580_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P580_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P580_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P580_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P580_FEC_COMPROBANTE
                itemsToReturn: P580_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-ref-fact (
        name: CONVERT_REF_FACT
        execution {
            sequence: 110
        }
        when {
            selectionType: items
            items: P580_REFERENCIA
        }

        action convert-fact-nro (
            name: CONVERT_FACT_NRO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fact varchar2(20);
                    
                    begin
                        if :P580_TIP_COMPROBANTE is not null then
                            if (length(:P580_REFERENCIA) > 6 and length(:P580_REFERENCIA) < 14) 
                                /*and :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                                conv_fact := replace(:P580_REFERENCIA,'-','');
                                conv_fact := substr(:P580_REFERENCIA,1,3)||'-'||
                                                          substr(:P580_REFERENCIA,4,3)||'-'||
                                                          lpad(substr(:P580_REFERENCIA,7,7),7,'0');
                    
                                /*if ( ( SUBSTR(conv_fact,4,1) != '-' or  SUBSTR(conv_fact, 8,1) != '-' )  and (nvl(:P392_IVA_INCLUIDO,'N') = 'S'  or
                                    :P392_TIP_COMPROBANTE IN ('RTI'))  AND :P392_TIP_COMPROBANTE != 'IDE')  then
                    
                                    raise_application_error(-20000,'El nro. de factura debe tener el siguiente formato 999-999-9999999');
                    
                                end if;*/
                                
                            else
                                raise_application_error(-20000,'Cargar el nro. de factura solo con números');
                            end if;
                        end if;
                        :P580_REFERENCIA := conv_fact;
                    
                        
                    end;
                    ```
                itemsToSubmit: [
                    P580_REFERENCIA
                    P580_TIP_COMPROBANTE
                ]
                itemsToReturn: P580_REFERENCIA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

