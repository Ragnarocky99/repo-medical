    region carga-de-compra-de-bienes (
        name: Carga de Compra de Bienes
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_TIP_COMP,
                       ID_SER_COMP,
                       FEC_COMPROBANTE,
                       MON_COSTO,
                       ID_SUCURSAL,
                       ID_CENTRO,
                       ID_DEPARTAMENTO,
                       ID_SECCION,
                       ID_RESPONSABLE,
                       ID_EMPRESA,
                       REFERENCIA,
                       ID
                from COW_MOV_BIENES_CAB
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  d.id_bien,
                        d.id_movbien_cab,
                        d.descripcion,  
                        b.mon_costo as costo_unitario,
                        d.cantidad, 
                        d.mon_costo,
                        d.mon_costo as mon_costo_copia,
                        d.mon_costo_ext,
                        d.tip_comprobante, 
                        d.ser_comprobante, 
                        d.nro_comprobante,
                        d.id_empresa,  
                        d.id
                from cow_mov_bienes_det d, 
                     cow_bienes_uso b
                where d.id_movbien_cab = :P580_ID 
                  AND D.ID_BIEN = B.ID
                ```
            pageItemsToSubmit: P580_ID
        }
        layout {
            sequence: 210
            parentRegion: @carga-de-compra-de-bienes
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-sm
            ]
        }
        advanced {
            htmlDomId: Detalle
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
            addButtonLabel: Añadir
        }
        enableUsersTo {
            flashback: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 96330880071470720
        }

