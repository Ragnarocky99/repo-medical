page 580 (
    name: Carga de Compra de Bienes
    alias: CARGA-DE-COMPRA-DE-BIENES1
    title: Carga de Compra de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            // Funcion  para calcular los totales de la factura cada vez que se ingresa un detalle 
            function calculaTotalBienes(){
                var model= apex.region("Detalle").widget().interactiveGrid("getCurrentView").model;
                var v_monto   = model.getFieldKey("MON_COSTO_COPIA");
                var v_total     = 0;
                model.forEach(function(r, index, id) {
                   
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                         let numeroTotal=r[v_monto].replace(/\./g,'');
            
                        v_total      = v_total  + parseFloat(numeroTotal.replace(',','.'));
                        
                    }
                    
                });
            
                $s('P580_MON_COSTO',  v_total.toString().replace(/\./g,','));
            }
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            //CABECERA
            document.getElementById("P580_TIP_COMPROBANTE").readOnly = true;
            document.getElementById("P580_SER_COMPROBANTE").readOnly = true;
            
            document.getElementById("P580_MON_COSTO").readOnly = true;
            
            ```
    }
