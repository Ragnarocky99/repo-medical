page 736 (
    name: Informe de Re-Cotizacion
    alias: INFORME-DE-RE-COTIZACION
    title: Informe de Re-Cotizacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region informe-de-re-cotizacion (
        name: Informe de Re-Cotizacion
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CMWV_HISTORIAL_RE_COTIZACION
            whereClause:
                ```sql
                (COD_USUARIO = :P736_COD_USUARIO OR :P736_COD_USUARIO IS NULL) AND
                (FECHA BETWEEN :P736_FECHA_INI AND :P736_FECHA_FIN OR :P736_FECHA_INI IS NULL OR :P736_FECHA_FIN IS NULL) AND
                FECHA > '20/08/2025'
                ```
            orderByClause: FECHA DESC
            pageItemsToSubmit: [
                P736_FECHA_INI
                P736_FECHA_FIN
                P736_COD_USUARIO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 20444265023134001
        }

