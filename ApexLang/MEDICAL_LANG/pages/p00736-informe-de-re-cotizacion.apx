    pageItem P736_COD_USUARIO (
        type: popupLov
        label {
            label: <p>Usuario:&ensp;</p>
            alignment: left
        }
        settings {
            manualEntry: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cod_usuario d, cod_usuario r
                from   bsw_usuarios
                ```
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P736_FECHA_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Fecha Fin
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P736_FECHA_INI (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Fecha Inicio
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    button refrescar (
        buttonName: REFRESCAR
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction agregar-paginacion (
        name: Agregar paginacion
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @informe-de-re-cotizacion
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P736_COD_USUARIO
        }
    )

    dynamicAction refresca (
        name: Refresca
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       v_sql VARCHAR2(200);
                    BEGIN
                       -- Construct the anonymous PL/SQL block as a string
                       v_sql := 'BEGIN DBMS_MVIEW.REFRESH(''CMWMV_HISTORIAL_RE_COTIZACION''); END;';
                    
                       -- Execute the PL/SQL block
                       EXECUTE IMMEDIATE v_sql;
                    
                    EXCEPTION
                       WHEN OTHERS THEN
                          RAISE_APPLICATION_ERROR(-20000, 'Error refreshing materialized view: ' || SQLERRM);
                    END;
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @informe-de-re-cotizacion
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

)

