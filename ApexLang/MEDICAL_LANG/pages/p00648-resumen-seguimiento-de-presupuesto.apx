            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: FILTROS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region seguimiento-presupuesto (
        name: Seguimiento Presupuesto
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLWV_SEGUIMIENTO_PRESUPUESTO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (FEC_OCC BETWEEN :P648_FEC_OCC_DESDE AND :P648_FEC_OCC_HASTA OR (:P648_FEC_OCC_DESDE IS NULL AND :P648_FEC_OCC_HASTA IS NULL)) AND
                (FEC_PROX_EVENTO BETWEEN :P648_FEC_EVENTO_INI AND :P648_FEC_EVENTO_FIN OR (:P648_FEC_EVENTO_INI IS NULL AND :P648_FEC_EVENTO_FIN IS NULL)) AND
                (NRO_OCC = :P648_NRO_OCC OR :P648_NRO_OCC IS NULL) AND
                (ESTADO_OCC = :P648_ESTADO_OCC OR :P648_ESTADO_OCC IS NULL) AND
                (ID_CLIENTE = :P648_CLIENTE OR :P648_CLIENTE IS NULL) AND
                (ID_VENDEDOR = :P648_VENDEDOR OR :P648_VENDEDOR IS NULL) AND
                (NIVEL_CLIENTE = :P648_NIVEL_CLIENTE OR :P648_NIVEL_CLIENTE IS NULL) AND
                (ID_PROVEEDOR = :P648_COD_PROVEEDOR OR :P648_COD_PROVEEDOR IS NULL) AND
                (ID_SOPORTE = :P648_ID_SOPORTE OR :P648_ID_SOPORTE IS NULL) AND
                (NRO_OCP = :P648_NRO_OCP OR :P648_NRO_OCP IS NULL) AND
                (ESTADO_OCP = :P648_ESTADO_OCP OR :P648_ESTADO_OCP IS NULL) AND
                (NRO_COMPROBANTE = :P648_NRO_PEDIDO OR :P648_NRO_PEDIDO IS NULL) AND
                (ID_RESPONSABLE = :P648_RESPONSABLE OR :P648_RESPONSABLE IS NULL) AND
                (ID_ARTICULO = :P648_ID_ARTICULO OR :P648_ID_ARTICULO IS NULL) AND
                (ID_DEFINICION MEMBER OF APEX_STRING.SPLIT_NUMBERS(:P648_DEFINICION, ':') OR :P648_DEFINICION IS NULL) AND
                (RN = 1 OR RN IS NULL)
                
                ```
            pageItemsToSubmit: [
                P648_FEC_OCC_DESDE
                P648_FEC_OCC_HASTA
                P648_NRO_OCC
                P648_ESTADO_OCC
                P648_FEC_EVENTO_INI
                P648_FEC_EVENTO_FIN
                P648_CLIENTE
                P648_VENDEDOR
                P648_NIVEL_CLIENTE
                P648_COD_PROVEEDOR
                P648_ID_SOPORTE
                P648_NRO_OCP
                P648_ESTADO_OCP
                P648_NRO_PEDIDO
                P648_RESPONSABLE
                P648_DEFINICION
                P648_ID_ARTICULO
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 107776583068845106
        }

