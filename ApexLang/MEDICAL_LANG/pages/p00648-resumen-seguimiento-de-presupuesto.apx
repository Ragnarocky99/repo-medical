page 648 (
    name: Resumen Seguimiento de Presupuesto
    alias: RESUMEN-SEGUIMIENTO-DE-PRESUPUESTO
    title: Resumen Seguimiento de Presupuesto
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
