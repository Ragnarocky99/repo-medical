    dynamicAction agregar-paginacion (
        name: Agregar paginacion
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @seguimiento-presupuesto
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 110
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @seguimiento-presupuesto
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-todoo (
        name: setear todoo
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P648_TODOS
        }
        clientSideCondition {
            type: item=value
            item: P648_TODOS
            value: S
        }
        serverSideCondition {
            type: never
        }

        action p648-limite (
            name: P648_LIMITE
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select count(*) from CMWV_SEGUIMIENTO_PRESUPUESTO
            }
            affectedElements {
                selectionType: items
                items: P648_LIMITE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process crear-coleccion (
        name: Crear Coleccion
        type: executeCode
        source {
            plsqlCode: APEX_COLLECTION.create_or_truncate_collection('COL_SEGUIMIENTO_PRESUPUESTO');
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 109021818251857545
        }
        serverSideCondition {
            type: request=Value
            value: SEGUI
        }
    )

    branch (
        name: Go To Page 638
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 638
                items: {
                    P638_IND_VARIOS: S
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: SEGUI
        }
    )

)

