                  background-color:#fffc75!important;
              color: black!important;
              font-weight: bold;
            }
            .u-green-text {
                color: green !important;
            }
            // color amarillo
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
