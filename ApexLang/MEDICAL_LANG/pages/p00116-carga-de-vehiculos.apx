page 116 (
    name: Carga de Vehiculos
    alias: CARGA-DE-VEHICULOS
    title: Carga de Vehiculos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 171px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-vehiculos (
        name: Carga de Vehiculos
        type: form
        source {
            location: localDatabase
            tableName: RPW_VEHICULOS
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P116_ANIO (
        type: textField
        label {
            label: <p>Año:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 4
        }
        source {
            formRegion: @carga-de-vehiculos
            column: ANIO
            dataType: varchar2
        }
    )

    pageItem P116_CAPACIDAD_MAX (
        type: numberField
        label {
            label: <p>Capacidad Máx. (kg):</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 100
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-vehiculos
            column: CAPACIDAD_MAX
            dataType: number
        }
    )

    pageItem P116_CHAPA (
        type: textField
        label {
            label: <p>Chapa:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 7
        }
        source {
            formRegion: @carga-de-vehiculos
            column: CHAPA
            dataType: varchar2
        }
    )

    pageItem P116_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 140
            region: @carga-de-vehiculos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-vehiculos
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P116_COD_VEHICULO (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Vehículo:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-vehiculos
            column: COD_VEHICULO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(COD_VEHICULO)), 0) + 1 FROM RPW_VEHICULOS WHERE ID_EMPRESA=:P0_ID_EMPRESA;
        }
    )

    pageItem P116_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @carga-de-vehiculos
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P116_ID (
        type: hidden
        layout {
            sequence: 120
            region: @carga-de-vehiculos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-vehiculos
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_ID_CHOFER (
        type: popupLov
        label {
            label: <p>Chofer:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-choferes
        }
        layout {
            sequence: 110
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-vehiculos
            column: ID_CHOFER
            dataType: number
        }
    )

    pageItem P116_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 130
            region: @carga-de-vehiculos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-vehiculos
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    pageItem P116_MARCA (
        type: textField
        label {
            label: <p>Marca:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @carga-de-vehiculos
            column: MARCA
            dataType: varchar2
        }
    )

    pageItem P116_MODELO (
        type: textField
        label {
            label: <p>Modelo:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @carga-de-vehiculos
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @carga-de-vehiculos
            column: MODELO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P116_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P116_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P116_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 14401922437836943
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-vehículos (
        name: Initialize form Carga de Vehículos
        type: formInitialization
        formRegion: @carga-de-vehiculos
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14401188446836942
        }
    )

    process process-form-carga-de-vehículos (
        name: Process form Carga de Vehículos
        type: formAutoRowProcessing
        formRegion: @carga-de-vehiculos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14401553380836942
        }
    )

)

