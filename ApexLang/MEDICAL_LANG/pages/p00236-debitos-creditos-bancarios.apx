page 236 (
    name: Debitos Creditos Bancarios
    alias: DEBITOS-CREDITOS-BANCARIOS
    title: Debitos Creditos Bancarios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P236_CONCEPTO").readOnly = true;
            document.getElementById("P236_COD_USUARIO_AUD").readOnly = true;
            document.getElementById("P236_TIP_CAMBIO").readOnly = true;
            document.getElementById("P236_FEC_MODIF").readOnly = true;
            document.getElementById("P236_SER_COMPROBANTE").readOnly = true;
            document.getElementById("P236_NRO_COMPROBANTE").readOnly = true;
            document.getElementById("P236_TIP_COMPROBANTE").readOnly = true;
            document.getElementById("P236_ASIENTOS").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 161px;
                height: 25px;
                  pointer-events: none;
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: left;
                border-width: thin;
                border-color: #afa9a9;
                appearance: none;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            .totales{
                text-align: center;
                font-size: large;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region debitos-y-creditos-bancarios (
        name: Debitos y Creditos Bancarios
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       REFERENCIA,
                       FEC_COMPROBANTE,
                       ID_SUCURSAL,
                       ID_PER_JURIDICA,
                       ID_CUENTA,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ID_TIPO_TRANS,
                       ID_SUB_TIPO_TRANS,
                       CONCEPTO,
                       IMPORTE,
                       COD_USUARIO_AUD,
                       IND_GENERA_ASIENTO,
                       ASIENTOS,
                       NRO_CUENTA_ENT,
                       TIENE_DETALLE,
                       ID_CUENTA_CONT,
                       ID_CUENTA_ENT,
                       ID_PER_JURIDICA_ENT,
                       ID_MONEDA_ENT,
                       TIP_CAMBIO_ENT,
                       NRO_OPERACION_BANCO,
                       FEC_ALTA,
                       FEC_MODIF,
                       IND_IMPORTACION,
                       ID_PROVEEDOR,
                       ID_USUARIO_ALTA,
                       ID_USUARIO_MODIF,
                       FEC_BANCO,
                       ID_CENTRO_COSTO,
                       NRO_PLANILLA_FF,
                       NRO_PLANILLA_ENT,
                       REF_COMPROBANTE,
                       NRO_DOCUMENTO,
                       ID_CONCEPTO_COMPRA
                  from CCW_DEBCRED_BANCARIOS
                  WHERE ID_EMPRESA = :P0_COD_EMPRESA
                  AND ID_SUCURSAL = :P0_COD_SUCURSAL
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

