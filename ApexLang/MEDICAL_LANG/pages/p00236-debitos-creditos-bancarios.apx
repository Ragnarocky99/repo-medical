            plsqlExpression: trae_id_tipos_trans(:P0_ID_EMPRESA,trae_id_modulo('CC'),w_busca_parametro('CC','TIPO_DEBCRE_BAN'))
        }
        serverSideCondition {
            type: never
        }
    )

    computation p236-nro-comprobante (
        itemName: P236_NRO_COMPROBANTE
        execution {
            sequence: 30
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_nro_comprobante CCW_DEBCRED_BANCARIOS.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P236_NRO_COMPROBANTE IS  NULL THEN
                SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                INTO v_nro_comprobante
                FROM
                CCW_DEBCRED_BANCARIOS 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P236_SER_COMPROBANTE=SER_COMPROBANTE
                AND :P236_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P236_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
        serverSideCondition {
            type: never
        }
    )

