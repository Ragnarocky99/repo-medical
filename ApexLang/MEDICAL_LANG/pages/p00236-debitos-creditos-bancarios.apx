    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 110
        }
        when {
            event: click
            selectionType: items
            items: P236_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P236_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P236_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P236_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P236_ASIENTOS_ID
                    P236_URL
                ]
                itemsToReturn: P236_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P236_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-cuenta (
        name: Cargar Datos Cuenta
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P236_ID_CUENTA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select C.ID from bsw_monedas c, ccw_cuentas_bancarias b
                    where c.id = b.id_moneda and b.ID = :P236_ID_CUENTA
                    ```
                itemsToSubmit: P236_ID_CUENTA
            }
            affectedElements {
                selectionType: items
                items: P236_ID_MONEDA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select B.ID_PER_JURIDICA from bsw_PERSONAS c, ccw_cuentas_bancarias b
                    where c.id = b.id_PER_JURIDICA and b.ID = :P236_ID_CUENTA
                    ```
                itemsToSubmit: P236_ID_CUENTA
            }
            affectedElements {
                selectionType: items
                items: P236_ID_PER_JURIDICA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select cb.referencia from CCW_CUENTAS_BANCARIAS CB
                    where cb.id = :P236_ID_CUENTA
                    ```
                itemsToSubmit: P236_ID_CUENTA
            }
            affectedElements {
                selectionType: items
                items: P236_DESCRIPCION
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: P236_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P236_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P236_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P236_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P236_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P236_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P236_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P236_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P236_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CH','ID_MODULO_CH'),:P236_FEC_COMPROBANTE);
                    end;
                    ```
                itemsToSubmit: P236_FEC_COMPROBANTE
                itemsToReturn: P236_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

