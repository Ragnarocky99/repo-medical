    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('CC','ID_MODULO_CC'),:P161_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P236_FEC_COMPROBANTE
        }
    )

    computation p236-asientos-id (
        itemName: P236_ASIENTOS_ID
        execution {
            sequence: 50
        }
        computation {
            sqlQuery:
                ```sql
                select id 
                from cow_diario_cabeceras_prov
                where num_asiento  = :P236_ASIENTOS
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P236_FEC_COMPROBANTE);
                ```
        }
