page 858 (
    name: Porcentaje de Ocupaciones
    alias: PORCENTAJE-DE-OCUPACIONES
    title: Porcentaje de Ocupaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var i = 0;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region porcentaje-de-ocupaciones (
        name: Porcentaje de Ocupaciones
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: STW_PORC_OCUPACION_ESTANTE
            orderByClause: COD_PORC_OCUPACION
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 106509294034795828
        }

        savedReport 1065097 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @COD_PORC_OCUPACION
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @PORC_OCUPACION
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @COLOR
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @FEC_ALTA
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_PORC_OCUPACION (
            type: numberField
            heading {
                heading: <p>Codigo</p>
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: COD_PORC_OCUPACION
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column COLOR (
            type: colorPicker
            heading {
                heading: <p>Color</p>
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: COLOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column FEC_ALTA (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: FEC_ALTA
                dataType: date
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column PORC_OCUPACION (
            type: numberField
            heading {
                heading: <p>% Ocupacion</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: PORC_OCUPACION
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Porcentaje de Ocupaciones
        }
    )

    dynamicAction inicializar-fila (
        name: Inicializar Fila
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @porcentaje-de-ocupaciones
        }

        action cod-porc-ocupacion (
            name: COD_PORC_OCUPACION
            action: setValue
            settings {
                type: jsExpression
                jsExpression: i
            }
            affectedElements {
                selectionType: columns
                columns: COD_PORC_OCUPACION
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: COD_PORC_OCUPACION
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: i = apex.region("Detalles").widget().interactiveGrid("getViews", "grid").model.getTotalRecords();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process porcentaje-de-ocupaciones-save-interactive-grid-data (
        name: Porcentaje de Ocupaciones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @porcentaje-de-ocupaciones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 106516526729795840
        }
    )

)

