    region diferencia (
        name: Diferencia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SUM(H.MONTO_SISTEMA-H.MONTO_REAL) AS DIFERENCIA,
                H.ID_SUB_TIPO_TRANS,H.DESCRIPCION,H.ID_HABILITACION FROM 
                
                (SELECT F.ID_SUB_TIPO_TRANS, 
                SU.DESCRIPCION,
                SUM(F.MONTO) MONTO_SISTEMA,
                0 AS MONTO_REAL ,
                'S' AS TIPO,
                HA.ID AS ID_HABILITACION
                FROM CCW_MOVIMIENTOS_CAJAS C,
                CCW_FORMAS_COBROS F,
                BSW_SUBTIPOS_TRANS SU,
                CCW_HABILITACIONES HA
                WHERE C.ID_EMPRESA=:P0_ID_EMPRESA
                --AND C.ID_CAJA=45
                --WHERE C.ID_EMPRESA=F.ID_EMPRESA
                --AND 
                AND C.ID=F.ID_MOV_CAJ
                --AND SU.ID_EMPRESA=F.ID_EMPRESA
                AND SU.ID_TIPO_TRANS=F.ID_TRANS
                AND SU.ID=F.ID_SUB_TIPO_TRANS
                AND HA.ID=C.ID_HABILITACION
                AND HA.ID_CAJA=C.ID_CAJA
                --AND HA.ID=705
                GROUP BY HA.ID,F.ID_SUB_TIPO_TRANS, SU.DESCRIPCION
                
                
                
                
                UNION ALL
                
                SELECT  HD.ID_SUBTIPO_TRANS,
                S.DESCRIPCION,
                0 AS MONTO_SISTEMA,
                SUM(HD.MONTO_REAL),
                'R' AS TIPO,
                HA.ID AS ID_HABILITACION
                FROM 
                CCW_HABILITACIONES HA ,
                CCW_HABILITACIONES_DETALLE HD,
                BSW_SUBTIPOS_TRANS S
                WHERE HD.ID_HABILITACION=HA.ID
                AND HD.ID_SUBTIPO_TRANS=S.ID
                AND HA.ID_EMPRESA=:P0_ID_EMPRESA
                --AND HA.ID=705
                GROUP BY HA.ID,HD.ID_SUBTIPO_TRANS,S.DESCRIPCION) H
                GROUP BY H.ID_HABILITACION,H.ID_SUB_TIPO_TRANS,H.DESCRIPCION 
                
                
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
