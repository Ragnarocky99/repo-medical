    region arqueo-de-cajas (
        name: Arqueo de Cajas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CAJ.ID,
                       CAJ.ID_EMPRESA,
                       CAJ.ID_SUCURSAL,
                       CAJ.COD_CAJA,
                       CAJ.FEC_ALTA,
                       CAJ.ALTA_POR,
                       CAJ.ESTADO,
                       CASE
                       WHEN CAJ.ESTADO ='S' THEN 'fa fa-check u-success-text'
                       WHEN CAJ.ESTADO ='N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       CAJ.COD_USUARIO_AUD,
                       CAJ.CIERRA_SIN_PENDIENTES,
                       CAJ.DESCRIPCION,
                       CAJ.ID_USUARIO_ASIG,
                       P.NOMBRE
                  from CCW_CAJAS CAJ, BSW_USUARIOS U, BSW_PERSONAS P
                    where CAJ.ID_EMPRESA = :P0_COD_EMPRESA
                    and CAJ.ID_SUCURSAL= :P0_ID_SUCURSAL
                    and   CAJ.ID_USUARIO_ASIG = U.ID
                    and   U.ID_PERSONA = P.ID
                    AND CAJ.ESTADO='S'
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 189731769804592693
        }

