page 525 (
    name: Carga de Tipo de Locales
    alias: CARGA-DE-TIPO-DE-LOCALES
    title: Carga de Tipo de Locales
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tipo-de-locales (
        name: Carga de Tipo de Locales
        type: form
        source {
            location: localDatabase
            tableName: ACW_TIPO_LOCALES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P525_COD_TIP_LOCAL (
        type: textField
        label {
            label: <p>Cod. Tipo: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-tipo-de-locales
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 5
        }
        advanced {
            cssClasses: comprobante
        }
        source {
            formRegion: @carga-de-tipo-de-locales
            column: COD_TIP_LOCAL
            dataType: varchar2
        }
    )

    pageItem P525_COD_USUARIO_AUD (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @carga-de-tipo-de-locales
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipo-de-locales
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P525_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-tipo-de-locales
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-tipo-de-locales
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P525_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipo-de-locales
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipo-de-locales
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P525_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-tipo-de-locales
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipo-de-locales
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P525_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P525_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P525_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p525-cod-tip-local (
        itemName: P525_COD_TIP_LOCAL
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                   declare
                   v_numero number;
                   
                   begin
                   if :P525_COD_TIP_LOCAL is null then
                      select nvl( max( TO_NUMBER(COD_TIP_LOCAL) ), 0 ) + 1
                         into v_numero
                         from ACW_TIPO_LOCALES
                         where ID_EMPRESA = :P0_ID_EMPRESA ;
                       RETURN v_numero;
                      end if; 
                      RETURN :P525_COD_TIP_LOCAL;
                   exception
                      when no_data_found then
                        :P525_COD_TIP_LOCAL  := 1 ;
                        RETURN :P525_COD_TIP_LOCAL;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Tipo de Locales' || sqlerrm ) ;
                   end ;
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 84322302162793075
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tipo-de-locales (
        name: Initialize form Carga de Tipo de Locales
        type: formInitialization
        formRegion: @carga-de-tipo-de-locales
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 84321537230793075
        }
    )

    process process-form-carga-de-tipo-de-locales (
        name: Process form Carga de Tipo de Locales
        type: formAutoRowProcessing
        formRegion: @carga-de-tipo-de-locales
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 84321933240793075
        }
    )

)

