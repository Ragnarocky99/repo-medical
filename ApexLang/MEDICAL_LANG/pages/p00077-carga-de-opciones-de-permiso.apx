page 77 (
    name: Carga de Opciones de Permiso
    alias: CARGA-DE-OPCIONES-DE-PERMISO
    title: Carga de Opciones de Permiso
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-opciones-de-permiso (
        name: Carga de Opciones de Permiso
        type: form
        source {
            location: localDatabase
            tableName: BSW_PERMISOS_OPCIONES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P77_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-opciones-de-permiso
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 400
        }
        source {
            formRegion: @carga-de-opciones-de-permiso
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P77_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-opciones-de-permiso
            slot: regionBody
        }
        source {
            formRegion: @carga-de-opciones-de-permiso
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P77_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-opciones-de-permiso
            slot: regionBody
        }
        source {
            formRegion: @carga-de-opciones-de-permiso
            column: ID_EMPRESA
            dataType: number
            primaryKey: true
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P77_ID_PAGINA (
        type: popupLov
        label {
            label: <p>Página: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-paginas
        }
        layout {
            sequence: 60
            region: @carga-de-opciones-de-permiso
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-opciones-de-permiso
            column: ID_PAGINA
            dataType: number
        }
    )

    pageItem P77_PARAMETRO (
        type: textField
        label {
            label: <p>Parámetro: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-opciones-de-permiso
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @carga-de-opciones-de-permiso
            column: PARAMETRO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P77_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P77_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P77_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 56124250338667623
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-opciones-de-permiso (
        name: Initialize form Carga de Opciones de Permiso
        type: formInitialization
        formRegion: @carga-de-opciones-de-permiso
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 56123412988667623
        }
    )

    process process-form-carga-de-opciones-de-permiso (
        name: Process form Carga de Opciones de Permiso
        type: formAutoRowProcessing
        formRegion: @carga-de-opciones-de-permiso
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 56123881659667623
        }
    )

)

