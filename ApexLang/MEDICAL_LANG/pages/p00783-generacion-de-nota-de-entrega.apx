            location: localDatabase
            tableName: LCWV_ARTICULOS_A_ENTREGAR
            whereClause:
                ```sql
                ID_LICITACION_CAB = :P783_ID AND
                CANT_A_ENTREGAR > 0 AND
                STOCK_SUCURSAL - CANT_A_ENTREGAR >= 0
                ```
