    dynamicAction acciones-al-cargar-pagina (
        name: Acciones al cargar pagina
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action boton-generar-nota-entrega (
            name: Boton Generar Nota Entrega
            action: plugin/interactiveGridExtendToolbar
            settings {
                label: Generar
                hot: true
                icon: fa-dynamic-content
                triggerAction: gen_ne
            }
            affectedElements {
                selectionType: region
                region: @articulos-a-entregar
            }
            execution {
                sequence: 40
            }
        )

        action native-alert (
            action: alert
            settings {
                message: La licitacion nro. &P783_NRO_LICITACION. no esta autorizada
                style: warning
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                      FROM LCW_LICITACIONES_CAB
                     WHERE (NVL(IND_AUTORIZA_STOCK, 'N') = 'N' OR NVL(IND_AUTORIZA_CTACTE, 'N') = 'N')
                       AND ID = :P783_ID
                    ```
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                      FROM LCW_LICITACIONES_CAB
                     WHERE (NVL(IND_AUTORIZA_STOCK, 'N') = 'N' OR NVL(IND_AUTORIZA_CTACTE, 'N') = 'N')
                       AND ID = :P783_ID
                    ```
            }
        )

    )

    dynamicAction generar-nota-de-entrega (
        name: Generar Nota de Entrega
        execution {
            sequence: 20
        }
        when {
            event: custom
            customEvent: gen_ne
            selectionType: region
            region: @articulos-a-entregar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GENERAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process creamos-coleccion (
        name: Creamos coleccion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('COL_NOTA_ENTREGA');
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 44485253574481665
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GENERAR
        }
    )

    process genera-nota-entrega (
        name: Genera Nota Entrega
        type: invokeApi
        invoke {
            package: PKGW_LICITACIONES
            procedureOrFunction: LCW_GENERA_NOTA_ENTREGA
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 44478550453473202
        }

        parameter p_id_empresa (
            parameter {
                dataType: number
            }
            value {
                type: item
                item: P0_ID_EMPRESA
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process guardamos-datos (
        name: Guardamos datos
        type: executeCode
        editableRegion: @articulos-a-entregar
        source {
            plsqlCode:
                ```plsql
                BEGIN
                     IF :SELECCIONAR = 'S' THEN
                
                         APEX_COLLECTION.ADD_MEMBER(
                                p_collection_name   => 'COL_NOTA_ENTREGA',
                                P_N001              => :ID_APROBACION);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 44485617419483035
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GENERAR
        }
    )

    process initialize-form-generacion-de-nota-de-entrega (
        name: Initialize form Generacion de Nota de Entrega
        type: formInitialization
        formRegion: @lcw-licitaciones-cab
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44202953378818311
        }
    )

)

