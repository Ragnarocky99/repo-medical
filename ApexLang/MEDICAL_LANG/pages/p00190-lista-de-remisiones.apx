    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction acciones-al-cargar-la-pagina (
        name: Acciones al Cargar la pagina
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @lista-de-remisiones
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-remisiones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 237
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 237
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

