    )

    region lista-de-remisiones (
        name: Lista de Remisiones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT A.ID,
                       A.TIP_ENT_SAL, 
                       A.FEC_ENT_SAL, 
                       A.SER_ENT_SAL, 
                       A.NUM_ENT_SAL, 
                       A.COD_CHAPA, 
                       A.ID_CHOFER, 
                       CH.DESCRIPCION,
                       NVL(A.ID_SUCURSAL_ENV,DECODE(A.ID_SUCURSAL_ENV,NULL, NULL)) SUC_ENVIO,
                       A.ID_CUIDAD_ENV CIUDAD_ENVIO,
                       A.ID_MOTIVO_ENT_SAL,
                       A.Dir_Sal,
                       P.NOMBRE as Cliente,
                       PD.Nro_Comprobante,
                       A.NRO_OCC,
                       estado_remision(A.id) as Estado,
                        TO_NUMBER(REPLACE(REPLACE(A.ASIENTOS,'*'),'dep')) ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(A.ASIENTOS,'*'),'dep'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(A.FEC_ENT_SAL)
                          AND D.ID_EMPRESA  = A.ID_EMPRESA) ASIENTO_ID,
                        LC.NRO_ID_LICITACION
                FROM STW_ENTSAL_CAB      A
                LEFT JOIN BSW_CHOFERES  CH ON CH.ID = A.ID_CHOFER
                LEFT JOIN CCW_CLIENTES   C ON  C.ID = A.ID_CLIENTE
                LEFT JOIN BSW_PERSONAS   P ON  P.ID = C.ID_PERSONA
                LEFT JOIN VTW_PEDIDOS_CABECERA PD ON PD.ID = A.ID_PEDIDO
                LEFT JOIN LCW_LICITACIONES_CAB LC ON LC.ID = A.ID_LICITACION_CAB
                     
                     
                WHERE A.ID_EMPRESA = :P0_ID_EMPRESA
                  AND A.FEC_ENT_SAL BETWEEN :P190_FEC_INI AND :P190_FEC_FIN
                  AND A.TIP_ENT_SAL = 'REM'
                  AND (A.NUM_ENT_SAL = :P190_NRO_REMISION OR :P190_NRO_REMISION IS NULL)
                  AND (A.NRO_OCC = :P190_NRO_OCC OR :P190_NRO_OCC IS NULL)
                  AND (LC.NRO_ID_LICITACION = :P190_NRO_ID_LICITACION OR :P190_NRO_ID_LICITACION IS NULL)
                  AND (A.ID_CLIENTE = :P190_ID_CLIENTE OR :P190_ID_CLIENTE IS NULL)
                ORDER BY FEC_ENT_SAL DESC, NUM_ENT_SAL DESC
                ```
            pageItemsToSubmit: [
                P190_SOLICITUDES
                P190_NRO_REMISION
                P190_FEC_INI
                P190_FEC_FIN
                P190_NRO_OCC
                P190_NRO_ID_LICITACION
                P190_ID_CLIENTE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 245
                items: {
                    P245_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
