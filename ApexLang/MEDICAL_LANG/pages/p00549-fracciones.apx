page 549 (
    name: Fracciones
    alias: FRACCIONES
    title: Fracciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region fracciones (
        name: Fracciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_FRACCION,
                       DESCRIPCION,
                       ID_CIUDAD,
                       ID_BARRIO,
                       PRECIO,
                       ID_CLIENTE,
                       ESTADO,
                       FEC_ALTA,
                       DIRECCION
                  from LTW_FRACCIONES
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 552
                items: {
                    P552_ID: \#ID#\
                    P552_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 89862673071064148
        }

        column COD_FRACCION (
            type: plainText
            heading {
                heading: Fraccion
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BL
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DIRECCION (
            type: plainText
            heading {
                heading: Direccion
                alignment: center
            }
            layout {
                sequence: 470
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AT
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column FEC_ALTA (
            type: plainText
            heading {
                heading: Fecha Alta
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_BARRIO (
            type: plainTextBasedOnLov
            heading {
                heading: Barrio
                alignment: center
            }
            lov {
                lov: @lv-barrios
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_CIUDAD (
            type: plainTextBasedOnLov
            heading {
                heading: Ciudad
                alignment: center
            }
            lov {
                lov: @lv-ciudades
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID_CLIENTE (
            type: plainTextBasedOnLov
            heading {
                heading: Cliente
                alignment: center
            }
            lov {
                lov: @lv-clientes
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PRECIO (
            type: plainText
            heading {
                heading: Precio
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Fracciones
        }

        savedReport 898904 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPCION (
                sequence: 1
            )

            displayColumn DIRECCION (
                sequence: 7
            )

            displayColumn ESTADO (
                sequence: 8
            )

            displayColumn FEC_ALTA (
                sequence: 6
            )

            displayColumn ID_BARRIO (
                sequence: 3
            )

            displayColumn ID_CIUDAD (
                sequence: 2
            )

            displayColumn ID_CLIENTE (
                sequence: 5
            )

            displayColumn PRECIO (
                sequence: 4
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @fracciones
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 552
                clearCache: 552
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

