page 359 (
    name: Carga de Departamentos F.E.
    alias: CARGA-DE-DEPARTAMENTOS_FE
    title: Carga de Departamentos F.E.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 228px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-departamentos (
        name: Carga de Departamentos
        type: form
        source {
            location: localDatabase
            tableName: FEW_DEPARTAMENTOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P359_COD_DEPARTAMENTO (
        type: textField
        label {
            label: <p>Código Departamento: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-departamentos
            column: COD_DEPARTAMENTO
            dataType: varchar2
        }
    )

    pageItem P359_COD_PAIS (
        type: popupLov
        label {
            label: <p>País: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-paises-fe
        }
        layout {
            sequence: 50
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-departamentos
            column: COD_PAIS
            dataType: varchar2
        }
    )

    pageItem P359_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
        source {
            formRegion: @carga-de-departamentos
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P359_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-departamentos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-departamentos
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P359_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P359_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P359_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction deshabilitar (
        name: Deshabilitar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P359_COD_DEPARTAMENTO
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P359_ID
            }
        )

    )

    computation p359-cod-departamento (
        itemName: P359_COD_DEPARTAMENTO
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P359_COD_DEPARTAMENTO is null then
                      select nvl( max( TO_NUMBER(COD_DEPARTAMENTO) ), 0 ) + 1
                        into v_numero
                        from FEW_DEPARTAMENTOS;
                       RETURN v_numero;
                      end if; 
                      RETURN :P359_COD_DEPARTAMENTO;
                   exception
                      when no_data_found then
                        :P359_COD_DEPARTAMENTO  := 1 ;
                        RETURN :P359_COD_DEPARTAMENTO;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Departamentos' || sqlerrm ) ;
                   end ;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P359_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 21694129596481368
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-departamentos (
        name: Initialize form Carga de Departamentos
        type: formInitialization
        formRegion: @carga-de-departamentos
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21693358617481368
        }
    )

    process process-form-carga-de-departamentos (
        name: Process form Carga de Departamentos
        type: formAutoRowProcessing
        formRegion: @carga-de-departamentos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21693718444481368
        }
    )

)

