page 295 (
    name: Empleados
    alias: EMPLEADOS
    title: Empleados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline: "td[headers=\"Foto\"] img { width: 20%; } "
