        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Historico de Precios - Competencia
        }

        savedReport 730798 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_ARTICULO (
                sequence: 2
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 12
            )

            displayColumn DESC_ARTICULO (
                sequence: 3
            )

            displayColumn FEC_ALTA (
                sequence: 13
