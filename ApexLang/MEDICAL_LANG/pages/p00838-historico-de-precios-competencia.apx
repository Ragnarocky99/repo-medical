page 838 (
    name: Historico de Precios - Competencia
    alias: HISTORICO-DE-PRECIOS-COMPETENCIA
    title: Historico de Precios - Competencia
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region historico-de-precios-competencia (
        name: Historico de Precios - Competencia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT HPC.ID,
                       HPC.ID_EMPRESA,
                       HPC.ID_PROVEEDOR,
                       HPC.PRECIO_VENTA,
                       HPC.IND_ACTIVO,
                       HPC.FEC_ALTA,
                       ART.COD_ARTICULO,
                       ART.DESCRIPCION DESC_ARTICULO,
                       ART.ID_GRUPO_ART,
                       ART.ID_ENVASE,
                       ART.ID_UNIDAD_MEDIDA,
                       ART.ID_MARCA,
                       HPC.COD_USUARIO_AUD,
                       CASE
                        WHEN HPC.IND_ACTIVO = 'S' THEN 'fa fa-check u-success-text'
                        ELSE 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON,
                       HPC.ID_MONEDA,
                       HPC.TIP_CAMBIO
                  FROM CMW_HIST_PRECIO_COMPETENCIA HPC
                  JOIN STW_ARTICULOS               ART ON ART.ID = HPC.ID_ARTICULO
                 WHERE HPC.ID_EMPRESA = :P0_ID_EMPRESA
                ORDER BY ID DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 840
                items: {
                    P840_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 73076384705872157
        }

        column ACTIVO_ICON (
            type: hidden
            heading {
                heading: Activo Icon
            }
            layout {
                sequence: 37
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 47
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 27
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESC_ARTICULO (
            type: plainText
