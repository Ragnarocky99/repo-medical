        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @historico-de-precios-competencia
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 840
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refrescar-reporte-dcr (
        name: Refrescar Reporte - DCR
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @historico-de-precios-competencia
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

