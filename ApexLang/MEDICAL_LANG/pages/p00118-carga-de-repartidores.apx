page 118 (
    name: Carga de Repartidores
    alias: CARGA-DE-REPARTIDORES
    title: Carga de Repartidores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads: document.getElementById("P118_NOMBRE_PERSONA").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 171px;
                height: 23px;
              
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-repartidores (
        name: Carga de Repartidores
        type: form
        source {
            location: localDatabase
            tableName: RPW_REPARTIDORES
            whereClause: ID_EMPRESA=:P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P118_ACTIVO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 80
            region: @carga-de-repartidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-repartidores
            column: ACTIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: A
        }
    )

    pageItem P118_COD_REPARTIDOR (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Repartidor:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-repartidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-repartidores
            column: COD_REPARTIDOR
            dataType: varchar2
        }
    )

    pageItem P118_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 130
            region: @carga-de-repartidores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-repartidores
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P118_FEC_INGRESO (
        type: datePicker
        label {
            label: <p>Fecha Ingreso:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 40
            region: @carga-de-repartidores
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-repartidores
            column: FEC_INGRESO
            dataType: date
        }
    )

    pageItem P118_ID (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-repartidores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-repartidores
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: RPW_REPARTIDORES_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P118_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 120
            region: @carga-de-repartidores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-repartidores
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    pageItem P118_ID_PERSONA (
        type: popupLov
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Persona:</a>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            additionalOutputs: NOMBRE:P118_NOMBRE_PERSONA
        }
        lov {
            type: sharedComponent
            lov: @bsw-personas-cod-persona
        }
        layout {
            sequence: 50
            region: @carga-de-repartidores
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-repartidores
            column: ID_PERSONA
            dataType: number
        }
    )

    pageItem P118_ID_USUARIO (
        type: popupLov
        label {
            label: <p>Usuario Repartidor</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-usuarios
        }
        layout {
            sequence: 140
            region: @carga-de-repartidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-repartidores
            column: ID_USUARIO
            dataType: number
        }
    )

    pageItem P118_IND_AYUDANTE (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-repartidores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-repartidores
            column: IND_AYUDANTE
            dataType: varchar2
        }
    )

    pageItem P118_NOMBRE_PERSONA (
        type: textField
        label {
            label: <p>Nombre Persona:</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @carga-de-repartidores
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        advanced {
            cssClasses: cambio
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT P.NOMBRE     
                FROM BSW_PERSONAS P    
                WHERE :P118_ID_PERSONA = P.ID
                ```
        }
    )

    pageItem P118_REGISTRO (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-repartidores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-repartidores
            column: REGISTRO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P118_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P118_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button persona (
        buttonName: PERSONA
        label: Persona
        layout {
            sequence: 60
            region: @carga-de-repartidores
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P118_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @persona
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P118_ID_PERSONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p118-cod-repartidor (
        itemName: P118_COD_REPARTIDOR
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P118_COD_REPARTIDOR is null then
                      select nvl(max(to_number(COD_REPARTIDOR)), 0) + 1
                         into v_numero
                         from RPW_REPARTIDORES;
                       RETURN v_numero;
                      end if; 
                      RETURN :P118_COD_REPARTIDOR;
                   exception
                      when no_data_found then
                        :P118_COD_REPARTIDOR  := 1 ;
                        RETURN :P118_COD_REPARTIDOR;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Repartidores' || sqlerrm ) ;
                   end ;
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 14509263532214546
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-repartidores (
        name: Initialize form Carga de Repartidores
        type: formInitialization
        formRegion: @carga-de-repartidores
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14508469725214546
        }
    )

    process process-form-carga-de-repartidores (
        name: Process form Carga de Repartidores
        type: formAutoRowProcessing
        formRegion: @carga-de-repartidores
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14508822842214546
        }
    )

)

