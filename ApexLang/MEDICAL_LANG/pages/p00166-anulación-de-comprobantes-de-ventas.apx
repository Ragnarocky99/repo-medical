        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Anulación de Comprobantes de Venta
        }

        savedReport 196915 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ESTADO (
                sequence: 9
            )

            displayColumn FEC_ANULACION (
                sequence: 11
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 7
            )

            displayColumn ID_USUARIO_ANU (
                sequence: 10
            )

            displayColumn ID_VENDEDOR (
                sequence: 6
            )

            displayColumn NOM_CLIENTE (
                sequence: 5
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 3
            )

            displayColumn NRO_TIMBRADO (
                sequence: 4
            )

            displayColumn SER_COMPROBANTE (
                sequence: 2
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 1
            )

            displayColumn TOT_COMPROBANTE (
                sequence: 8
            )

            sort (
                column: FEC_COMPROBANTE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: ReporteAnulacion
        }
    )

    pageItem P166_ANULADO (
        type: checkbox
        label {
            label: <p>Anulado </p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: A
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        sessionState {
            storage: request
        }
    )

    pageItem P166_CLIENTE (
        type: popupLov
        label {
            label: <p> Cliente: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 700
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        sessionState {
            storage: request
        }
    )

    pageItem P166_COND_VENTA (
        type: popupLov
        label {
            label: <p>Condición de Venta: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            popupWidth: 700
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-condiciones-venta
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        sessionState {
            storage: request
        }
    )

    pageItem P166_FEC_FIN (
        type: datePicker
        label {
            label: <p><b style="color:red;">*</b>Fec. Final: </p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
        sessionState {
            storage: request
        }
    )

    pageItem P166_FEC_INI (
        type: datePicker
        label {
            label: <p><b style="color:red;">*</b>Fec. Inicial: </p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/'||TO_CHAR(SYSDATE,'MM/YYYY') FROM DUAL;
        }
        sessionState {
            storage: request
        }
    )

