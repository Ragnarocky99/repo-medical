    region anulación-de-comprobantes-de-venta-2 (
        name: Anulación de Comprobantes de Venta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_VENDEDOR,
                       C.TIP_COMPROBANTE_REF,
                       C.SER_COMPROBANTE_REF,
                       C.NRO_COMPROBANTE_REF,
                       C.ID_CONDICION_VENTA,
                       C.ID_LISTA_PRECIO,
                       C.DESCUENTO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.TOT_COMPROBANTE,
                       C.TOT_GRAVADAS,
                       C.TOT_EXENTAS,
                       C.TOT_IVA,
                       C.ID_MOV_CAJ,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.ID_USUARIO,
                       C.FEC_ALTA,
                       C.DESCUENTO_DET,
                       C.TOT_DESCUENTO_DET,
                       C.CAMBIO_DOLAR,
                       C.CAMBIO_MONEDA_PRECIO,
                       C.NOM_CLIENTE,
                       C.ESTADO_REPARO,
                       C.ESTADO_REPARTO,
                       C.TOT_IVA_SIN_REDONDEO,
                       C.TIP_CAMBIO_COMPRA,
                       C.COMENTARIO,
                       C.GRU_COMPROBANTE,
                       C.ID_PERSONA,
                       C.ACTUALIZADO_POR,
                       C.IMPRESION_AUTORIZADA,
                       C.AUTORIZADO_POR,
                       C.IMPRESO,
                       C.RUC_CLIENTE,
                       C.IND_PAGARE,
                       C.ID_COBRADOR_PAG,
                       C.ID_USUARIO_PAG,
                       C.DIAS_AUT_PAGARE,
                       C.FEC_AUT_PAGARE,
                       C.IND_REFACTURAR,
                       C.ID_MOTIVO_ANU,
                       C.ID_SECTOR_VEN,
                       C.IMPRIME_IVA,
                       C.NRO_AUTORIZ_FACT,
                       C.COD_USUARIO_AUD,
                       C.TIENE_REMISION,
                       C.NRO_MOV_CAJ,
                       C.ID_DESPACHO_CAB,
                       C.ID_CLIENTE,
                       C.ID_PEDIDO_REF,
                       C.ID_COMPROBANTE_REF,
                       C.IND_IMPRIMIR_COMENTARIO,
                       C.SERIE,
                       C.NRO_TIMBRADO,
                       C.ID_MOTIVO_NCR,
                       C.LOTE,
                       C.NRO_GARANTIA,
                       C.ID_USUARIO_ANU,
                       C.TOT_COMPROBANTE_REAL,
                       C.DESC_RES_347,
                       C.CHAPA,
                       C.ASIENTOS_COSTOS,
                       C.ID_TALONARIO,
                       C.IND_MAQUINA,
                       C.DIRECCION,
                       C.TELEFONO,
                       C.ID_CENTRO,
                       C.OBS_ANULACION,
                       C.ID_CANAL_VENTA,
                       C.ID_TIPO_ENTREGA,
                       C.ID_SUCURSAL_CENTRAL,
                       C.IND_ENTREGA_INICIAL,
                       C.ID_MEDIO_PAGO,
                       C.ID_CORPORACION,
                       C.ID_CONCEPTO_COMP,
                       C.IND_PAGARE_IMPRESO,
                       C.TRANSAC_PRONET,
                       C.ID_SOLICITUD_CRE,
                       C.NRO_TRANS_PM,
                       C.NRO_PAGO_EXPRESS,
                       C.ID_ANTERIOR,
                       C.ENTREGA_INICIAL,
                       C.ID_LISTA_BODA_CAB,
                       C.IND_REEMBOLSO_AUTORIZADO,
                       C.ID_USUARIO_REEMB_AUTORIZA,
                       C.FEC_REEMBOLSO_AUTORIZADO,
                       C.ID_DEPOSITO_RESGUARDO,
                       C.TIP_COMPROBANTE_ANT,
                       C.CONTACTO_NOMBRE,
                       C.CONTACTO_TELEFONO,
                       C.DIREC_ENTREGA,
                       C.LATITUD,
                       C.LONGITUD,
                       C.ID_ZONA,
                       C.FEC_HORA_COMPROBANTE,
                       CASE (SELECT CC_ESTADO_COBRO(C.ID) FROM DUAL)
                       WHEN 'COBRADO' THEN 'green'
                       WHEN 'PENDIENTE' THEN 'red'
                       WHEN 'COBRO PARCIAL' THEN '#e3e01e'
                       end as THE_COLOR,
                            CASE ESTADO
                       WHEN 'A' THEN 'fa-check-circle u-danger-text'
                       WHEN NULL THEN ''
                       END AS ANULADO,
                       TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'dep')) ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'dep'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTO_ID,
                       C.FEC_ANULACION
                  from VTW_COMPROBANTES_CABECERA C
                  join bsw_series_comprob s on s.id = c.id_serie_comp
                  where c.ID_EMPRESA = :P0_COD_EMPRESA
                 AND C.TIP_COMPROBANTE= :P166_TIP_COMPROBANTE
                  and   c.ID_SUCURSAL = :P0_COD_SUCURSAL
                  /*    AND C.ID NOT IN (SELECT NVL(ID_COMPROBANTE_REF,0) 
                                 FROM VTW_COMPROBANTES_CABECERA 
                                 WHERE TIP_COMPROBANTE=W_BUSCA_PARAMETRO('VT','TIPO_NOTACRE'))
                  AND NVL(C.ID_MODULO, TRAE_ID_MODULO('VT')) = TRAE_ID_MODULO('VT')*/
                  AND (C.SER_COMPROBANTE = :P166_SER_COMPROBANTE OR :P166_SER_COMPROBANTE IS NULL)
                  AND (C.NRO_COMPROBANTE = :P166_NRO_COMPROBANTE OR :P166_NRO_COMPROBANTE IS NULL) 
                  
                  AND (C.FEC_COMPROBANTE BETWEEN :P166_FEC_INI AND :P166_FEC_FIN)
                  AND (C.ID_CLIENTE = :P166_CLIENTE OR :P166_CLIENTE IS NULL) 
                  AND (C.RUC_CLIENTE = :P166_RUC_CLIENTE OR :P166_RUC_CLIENTE IS NULL) 
                  AND (C.ID_CONDICION_VENTA = :P166_COND_VENTA OR :P166_COND_VENTA IS NULL) 
                  AND (C.ESTADO = :P166_ANULADO OR :P166_ANULADO IS NULL)
                  and nvl(s.ind_fact_electronica, 'N') = 'N'
                    order by fec_comprobante desc,nro_comprobante desc
                ```
            pageItemsToSubmit: [
                P166_TIP_COMPROBANTE
                P166_SER_COMPROBANTE
                P166_NRO_COMPROBANTE
                P166_FEC_INI
                P166_FEC_FIN
                P166_CLIENTE
                P166_RUC_CLIENTE
                P166_COND_VENTA
                P166_ANULADO
            ]
        }
        layout {
            sequence: 20
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
        }
        advanced {
            htmlDomId: ReporteAnulacion2
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 167
                items: {
