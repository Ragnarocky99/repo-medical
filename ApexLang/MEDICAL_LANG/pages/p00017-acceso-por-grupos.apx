page 17 (
    name: Acceso por Grupos
    alias: ACCESO-POR-GRUPOS
    title: Acceso por Grupos - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region acceso-por-grupos (
        name: Acceso por Grupos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  A.ID_ACCESO,
                       A.ID_GRUPO,
                       F.NAV_NAME,
                       A.PERMISO,
                       A.ID_MODULO,
                       CASE PUEDE_INSERTAR
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       INSERTAR,
                       CASE PUEDE_ACTUALIZAR
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       ACTUALIZAR,
                        CASE PUEDE_BORRAR
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       BORRAR,
                          CASE PUEDE_CONSULTAR
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       CONSULTAR
                
                  from BSW_ACCESO_POR_GRUPOS_APEX A,BSW_FORMAS_PAGINAS F WHERE
                   A.PAGINA_ID=F.NAV_ID AND F.PAGE_NO IS NOT NULL AND (ID_GRUPO=:P17_GRUPOS OR :P17_GRUPOS IS NULL) AND
                   (PAGINA_ID=:P17_PAGINA OR :P17_PAGINA IS NULL) AND
                   (A.ID_MODULO=:P17_MODULO OR :P17_MODULO IS NULL)
                   ORDER BY ID_GRUPO ASC,ID_MODULO ASC
                ```
            pageItemsToSubmit: [
                P17_GRUPOS
                P17_MODULO
                P17_PAGINA
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 18
                items: {
                    P18_ID_ACCESO: \#ID_ACCESO#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 6649528715165304
        }

        column ACTUALIZAR (
            type: plainText
            heading {
                heading: Actualizar
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #ACTUALIZAR#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column BORRAR (
            type: plainText
            heading {
                heading: Borrar
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #BORRAR#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CONSULTAR (
            type: plainText
            heading {
                heading: Consultar
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #CONSULTAR#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_ACCESO (
            type: hidden
            heading {
                heading: Id Acceso
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_GRUPO (
            type: plainTextBasedOnLov
            heading {
                heading: Grupo
                alignment: center
            }
            lov {
                lov: @lv-grupos-usuarios
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column ID_MODULO (
            type: plainTextBasedOnLov
            heading {
                heading: Modulo
                alignment: center
            }
            lov {
                lov: @lv-modulos
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column INSERTAR (
            type: plainText
            heading {
                heading: Insertar
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon"> <span class="fa #INSERTAR#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
                    
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column NAV_NAME (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column PERMISO (
            type: hidden
            heading {
                heading: Permiso
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                ACCESO POR GRUPOS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 66543 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTUALIZAR (
                sequence: 5
            )

            displayColumn BORRAR (
                sequence: 6
            )

            displayColumn CONSULTAR (
                sequence: 7
            )

            displayColumn ID_GRUPO (
                sequence: 3
            )

            displayColumn ID_MODULO (
                sequence: 2
            )

            displayColumn INSERTAR (
                sequence: 4
            )

            displayColumn NAV_NAME (
                sequence: 1
            )

            sort (
                column: COD_GRUPO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: COD_MODULO
                sort {
                    sequence: 2
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P17_GRUPOS (
        type: popupLov
        label {
            label: <p>Grupos: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-grupos-usuarios
            displayExtraValues: false
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    pageItem P17_MODULO (
        type: popupLov
        label {
            label: <p>Módulo: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-modulos
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    pageItem P17_PAGINA (
        type: popupLov
        label {
            label: <p>Página: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT P.NAV_NAME||'('||p.page_no||')',P.NAV_ID FROM BSW_ACCESO_POR_GRUPOS_APEX A,
                BSW_FORMAS_PAGINAS P WHERE P.NAV_ID=A.PAGINA_iD AND P.PAGE_NO IS NOT NULL AND
                (A.ID_MODULO=:P17_MODULO OR :P17_MODULO IS NULL)
                
                ```
            nullDisplayValue: --SIN SELECCIONAR--
        }
        cascadingLov {
            parentItems: P17_MODULO
            itemsToSubmit: P17_MODULO
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @acceso-por-grupos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 18
                clearCache: 18
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @acceso-por-grupos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acceso-por-grupos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P17_MODULO
                P17_GRUPOS
                P17_PAGINA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acceso-por-grupos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17261151096092628
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

