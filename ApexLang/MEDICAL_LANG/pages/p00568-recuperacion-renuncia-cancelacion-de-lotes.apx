page 568 (
    name: Recuperacion/Renuncia/Cancelacion de Lotes
    alias: RECUPERACION-RENUNCIA-CANCELACION-DE-LOTES
    title: Recuperacion/Renuncia/Cancelacion de Lotes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region recuperacion-renuncia-cancelacion-de-lotes (
        name: Recuperacion/Renuncia/Cancelacion de Lotes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       NRO_RECUPERACION,
                       FEC_COMPROBANTE,
                       ID_CLIENTE,
                       TIP_RECUPERO,
                       CUOTAS_PAGADAS,
                       CUOTAS_ATRASADAS,
                       ID_FRACCION,
                       ID_MANZANA,
                       ID_LOTE,
                       ID_CONTRATO,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       ID,
                       NRO_COMPROBANTE,
                       ID_EMPRESA
                  from LTW_RECUPERACION_LOTES
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 572
                items: {
                    P572_ID: \#ID#\
                    P572_TIP_COMPROBANTE: \#TIP_COMPROBANTE#\
                    P572_SER_COMPROBANTE: \#SER_COMPROBANTE#\
                    P572_NRO_COMPROBANTE: \#NRO_COMPROBANTE#\
                    P572_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 93481321737523409
        }

