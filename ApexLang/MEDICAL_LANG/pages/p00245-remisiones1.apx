    pageItem P245_ID_SUCURSAL_ENV (
        type: popupLov
        label {
            label: <p>Suc.Envio: &ensp;</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION||'('||COD_SUCURSAL||')',ID
                FROM BSW_SUCURSALES
                WHERE ID_EMPRESA = :P0_COD_EMPRESA 
                --AND ID!=:P0_COD_SUCURSAL
                ```
            nullDisplayValue: --SIN SELECCIONAR--
        }
