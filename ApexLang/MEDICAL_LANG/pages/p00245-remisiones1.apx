page 245 (
    name: Remisiones
    alias: REMISIONES1
    title: Remisiones
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            // Funcion  para calcular los totales del detalle  
            function recalculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_costo   = model.getFieldKey("TOTAL_COSTO");
                var v_cantidad       = model.getFieldKey("CANTIDAD_OCULTO");
                var v_total_costos     = 0;
                var v_total_cantidad =0;
            
            
                
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                         
                          
                        v_total_costos      = v_total_costos     + parseFloat(r[v_costo].replace(/\./g,''));
                        v_total_cantidad  = v_total_cantidad + parseFloat(r[v_cantidad].replace(/\./g,''));
                       
                    }
                    
                });
                   
            
            
                 if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                $s('P245_TOTAL_COSTOS',  v_total_costos.toString().replace('.', ''));
                $s('P245_TOTAL_CANTIDAD',v_total_cantidad);
            
            
            
            }
            
            
            
            
            
            
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P245_TOTAL_CANTIDAD").readOnly = true;
            document.getElementById("P245_TOTAL_COSTOS").readOnly = true;
            document.getElementById("P245_ASIENTOS").readOnly = true;
            document.getElementById("P245_NRO_TIMBRADO").readOnly = true;
            document.getElementById("P245_COD_MARCA").readOnly = true;
            ```
    }
