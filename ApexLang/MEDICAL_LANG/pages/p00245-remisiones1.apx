    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 220
        }
        when {
            selectionType: items
            items: P245_FEC_ENT_SAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P245_FEC_ENT_SAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P245_FEC_ENT_SAL,'/','');
                            conv_fecha := substr(:P245_FEC_ENT_SAL,1,2)||'/'||
                                                      substr(:P245_FEC_ENT_SAL,3,2)||'/'||
                                                      lpad(substr(:P245_FEC_ENT_SAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P245_FEC_ENT_SAL := conv_fecha;
                            ELSIF (length(:P245_FEC_ENT_SAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P245_FEC_ENT_SAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('ST','ID_MODULO_ST'),:P245_FEC_ENT_SAL);
                    end;
                    ```
                itemsToSubmit: P245_FEC_ENT_SAL
                itemsToReturn: P245_FEC_ENT_SAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

