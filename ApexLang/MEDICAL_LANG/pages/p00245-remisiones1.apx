    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 90
        }
        when {
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P245_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cambiar-montos (
        name: Cambiar Montos
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: [
                CANTIDAD
                COSTO_C_IVA
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :CANTIDAD IS NULL THEN 
                    :CANTIDAD:=1;
                    END IF;
                    
                    IF :COSTO_C_IVA IS NULL THEN
                    :COSTO_C_IVA:=0;
                    END IF;
                    
                    
                    :TOTAL_COSTO:=:CANTIDAD*replace(:COSTO_C_IVA,'.','');
                    
                    
                    
                    
                    
                    
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    COSTO_C_IVA
                ]
                itemsToReturn: TOTAL_COSTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    recalculaTotales();
                    
                    
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P245_TOTAL_CANTIDAD
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: items
                items: P245_TOTALES
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_OCULTO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

