        }
    )

    computation p245-num-ent-sal (
        itemName: P245_NUM_ENT_SAL
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                   declare
                   v_numero number;
                   
                   begin
                   if :P245_NUM_ENT_SAL is null then
                      select nvl( max( num_ent_sal ), 0 ) + 1
                         into v_numero
                         from stW_entsal_cab
                         where ID_EMPRESA  = :P0_COD_EMPRESA
                           and TIP_ENT_SAL = :P245_TIP_ENT_SAL
                           and SER_ENT_SAL = :P245_SER_ENT_SAL;
                       RETURN v_numero;
                      end if; 
                      RETURN v_numero;
                   exception
                      when no_data_found then
                        v_numero  := 1 ;
                        RETURN v_numero;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de entrada/salida de artículos (cabecera)' || sqlerrm ) ;
                   end ;
                
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P245_NUM_ENT_SAL
        }
    )

    computation p245-ser-ent-sal (
        itemName: P245_SER_ENT_SAL
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_ser varchar2(7);
                V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                select SER_COMPROBANTE
                INTO v_ser
                 from BSW_SERIES_COMPROB t 
                 WHERE
                ID_EMPRESA=:P0_COD_EMPRESA AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                AND TERMINAL=V_IP_MAQUINA
                AND TIP_COMPROBANTE=W_BUSCA_PARAMETRO(NULL,'TIPO_COMPROBANTE_VENTA')
                AND IND_ACTIVO='S';
                RETURN v_ser;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                return null;
                WHEN OTHERS THEN
                 RETURN null; 
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P245_ID
        }
    )

    computation p245-ser-timbrado (
        itemName: P245_SER_TIMBRADO
        execution {
            sequence: 80
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  VSER_TIMBRADO bsw_series_comprob.ser_timbrado%type;
                  V_IP_MAQUINA  VARCHAR2(200);
                BEGIN
                  IF :P245_ID_SERIE_COMP IS NULL THEN
                        SELECT owa_util.get_cgi_env('REMOTE_ADDR') INTO V_IP_MAQUINA FROM DUAL;
                        select SER_TIMBRADO
                        INTO VSER_TIMBRADO
                        from BSW_SERIES_COMPROB t
                        WHERE ID_EMPRESA = :P0_COD_EMPRESA
                        AND ID_SUCURSAL = :P0_COD_SUCURSAL
                        AND TIP_COMPROBANTE = W_BUSCA_PARAMETRO('ST', 'TIPO_REMISION')
                        AND IND_ACTIVO = 'S'
                        AND T.TERMINAL = V_IP_MAQUINA;
                  ELSIF :P245_ID_SERIE_COMP IS NOT NULL THEN
                        SELECT SER_TIMBRADO
                        INTO VSER_TIMBRADO
                        FROM BSW_SERIES_COMPROB
                        WHERE ID = :P245_ID_SERIE_COMP;
                  END IF;
                  RETURN VSER_TIMBRADO;
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    return null;
                  WHEN OTHERS THEN
                    RETURN null;
                END;
                
                ```
        }
        serverSideCondition {
            type: never
        }
    )

