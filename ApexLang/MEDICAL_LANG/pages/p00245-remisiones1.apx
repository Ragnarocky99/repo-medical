            }
            affectedElements {
                selectionType: items
                items: P245_CI_CHOFER
            }
            execution {
                sequence: 10
            }
        )

        action p245-cod-chapa (
            name: P245_COD_CHAPA
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT CHAPA
                    FROM RPW_VEHICULOS
                    WHERE ID_EMPRESA=:P0_ID_EMPRESA
                    AND ID_CHOFER= :P245_ID_CHOFER
                    ORDER BY ID DESC
                    FETCH FIRST 1 ROW ONLY
                    ```
                itemsToSubmit: P245_ID_CHOFER
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P245_COD_CHAPA
            }
