    dynamicAction cargar-datos-de-articulo (
        name: Cargar datos de articulo
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: ID_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT NRO_LOTE,ID
                    INTO :NRO_LOTE,:ID_LOTE
                    FROM STW_LOTES
                    WHERE ID_ARTICULO=:ID_ARTICULO
                    and rownum=1;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: [
                    ID_LOTE
                    NRO_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT COD_ARTICULO 
                    into :cod_articulo
                    FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:ID_ARTICULO;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: COD_ARTICULO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    grid.gotoCell(array[0][0],'COD_ARTICULO');
                    
                    
                    
                    ```
            }
            affectedElements {
                selectionType: region
                region: @entsal-det
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P245_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: 1
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT STW_RECUPERA_COSTO(:P0_COD_EMPRESA,:ID_ARTICULO,W_BUSCA_PARAMETRO('BS','COD_MONEDA_GS'),TO_DATE(SYSDATE,'DD/MM/YYYY'))FROM DUAL;
                    
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: COSTO_C_IVA
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value-4 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_id_unidad_medida number(18);
                    begin
                    SELECT ID_UNIDAD_MEDIDA 
                    INTO V_ID_UNIDAD_MEDIDA
                    FROM 
                    STW_ARTICULOS 
                    WHERE ID=:ID_ARTICULO;
                    RETURN V_ID_UNIDAD_MEDIDA;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    end;
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_UNIDAD_MEDIDA
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-5 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_id_iva number(18);
                    begin
                    select id_iva 
                    into v_id_iva
                    from stw_articulos
                    where id=:id_articulo;
                    return v_id_iva;
                    end;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    NULL;
                    WHEN OTHERS THEN 
                    NULL;
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_IVA
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-del-cliente (
        name: Cargar Datos Del Cliente
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P245_ID_CLIENTE
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P245_ID_SUCURSAL_ENV
            }
            execution {
                sequence: 40
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P245_ID_CLIENTE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P245_ID_SUCURSAL_ENV
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P245_ID_CLIENTE
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DIRECCION
                    FROM BSW_PERSONAS P,CCW_CLIENTES C
                    WHERE P.ID=C.ID_PERSONA
                    AND C.ID=:P245_ID_CLIENTE
                    ```
                itemsToSubmit: P245_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P245_DIR_ENV
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT telefono
                    FROM BSW_PERSONAS P,CCW_CLIENTES C
                    WHERE C.ID=:P245_ID_CLIENTE
                    AND P.ID=C.ID_PERSONA
                    ```
                itemsToSubmit: P245_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P245_TELEFONO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT CASE 
                    WHEN P.RUC IS NOT NULL THEN P.RUC 
                    WHEN P.RUC IS NULL THEN TO_CHAR(P.NRO_CI)
                    WHEN P.RUC IS NULL AND P.NRO_CI IS NULL THEN NULL
                    END 
                    AS DOCUMENTO
                    FROM BSW_PERSONAS P,CCW_CLIENTES C
                    WHERE P.ID=C.ID_PERSONA
                    AND C.ID=:P245_ID_CLIENTE
                    ```
                itemsToSubmit: P245_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P245_RUC_CLIENTE
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

