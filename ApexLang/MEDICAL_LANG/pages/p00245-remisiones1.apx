    pageItem P245_ESTADO (
        type: checkbox
        label {
            label: <P>Anular</P>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: A
            uncheckedValue: N
        }
        layout {
            sequence: 90
            region: @remisiones
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 2
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: TABINDEX="8"
        }
        source {
            formRegion: @remisiones
            column: ESTADO
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P245_ID
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM VTW_COMPROBANTES_CABECERA VC
                  JOIN VTW_COMPROBANTES_DETALLE  VD ON VC.ID = VD.ID_COMPROBANTE_CABECERA
                 WHERE VD.ID_REMISION = :P245_ID
                   AND NVL(VC.ESTADO, 'P') != 'A'
                   AND VD.ID_REMISION_DET IN (SELECT ED.ID
                                                FROM STW_ENTSAL_DET ED
                                               WHERE ED.ID_ENTSAL_CAB = :P245_ID)
                GROUP BY VD.ID_REMISION
                HAVING SUM(NVL(VD.CANTIDAD, 0) * DECODE(VC.TIP_COMPROBANTE, 'NCR', -1, 1)) > 0
                ```
        }
    )

