    dynamicAction abrir-lista-de-valores (
        name: Abrir lista de valores
        execution {
            sequence: 80
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: COD_ARTICULO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_ART_lov_btn').click();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P245_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 180
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P245_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P245_LV_TALONARIOS_lov_btn").click();
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    vnro_ini  NUMBER(8);
                    V_IP_MAQUINA VARCHAR(200);
                    
                    BEGIN
                    
                    
                      
                    
                    SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                    
                        select count(*)
                          into vnro_ini
                          from BSW_series_comprob s
                         where S.ID_EMPRESA   = :P0_ID_EMPRESA
                           and S.TIP_COMPROBANTE = W_BUSCA_PARAMETRO('ST', 'TIPO_REMISION')
                           and S.ID_SUCURSAL  = :P0_ID_SUCURSAL
                           and nvl( S.IND_ACTIVO, 'S' ) <> 'N'
                           and S.TERMINAL = V_IP_MAQUINA;
                        -- and t.cod_empresa   = s.cod_empresa
                        -- and t.tip_talonario = s.tip_comprobante
                        -- and t.serie         = s.ser_comprobante;
                        -- and nvl(s.terminal,vterminal) = vterminal ;
                    --     and s.terminal      = vterminal ;
                    
                        IF nvl( vnro_ini, 0 ) > 1 THEN
                            RETURN TRUE;
                        END IF;
                    
                      END;
                    ```
            }
        )

    )

