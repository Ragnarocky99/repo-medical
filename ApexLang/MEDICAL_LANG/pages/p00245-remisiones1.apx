                virtualKeyboard: text
            }
            layout {
                sequence: 270
                columnAlignment: end
            }
            appearance {
                cssClasses: is-readonly
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: TOTAL_COSTO
                dataType: number
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: ENTSAL_DET
        }
    )

    region remisiones (
        name: Remisiones
        type: form
        source {
            location: localDatabase
            tableName: STW_ENTSAL_CAB
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
