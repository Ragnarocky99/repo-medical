    process entsal-det-save-interactive-grid-data (
        name: ENTSAL_DET - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @entsal-det
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                             
                             
                
                             
                                insert into STW_ENTSAL_DET
                                (ID_EMPRESA,ID_SUCURSAL,ID_ENTSAL_CAB,ID_ARTICULO,CANTIDAD,ID_UNIDAD_MEDIDA,NRO_LOTE,ID_LOTE,COSTO_C_IVA,NRO_ORDEN,
                                COD_USUARIO_AUD,OBSERVACION,DESC_ARTICULO,ID_IVA,TOTAL_COSTO,ID_CENTRO_COSTO, ID_BARRA)
                                values(:P0_COD_EMPRESA,:P245_ID_SUCURSAL,:P245_ID,:ID_ARTICULO,:CANTIDAD,:ID_UNIDAD_MEDIDA,:NRO_LOTE,:ID_LOTE,REPLACE(:COSTO_C_IVA,'.',''),:NRO_ORDEN,
                                :COD_USUARIO_AUD,:OBSERVACION,:DESC_ARTICULO,:ID_IVA,REPLACE(:TOTAL_COSTO,'.',''),:ID_CENTRO_COSTO, :ID_BARRA);
                            
                            WHEN 'U' then  
                               
                               UPDATE STW_ENTSAL_DET 
                               SET ID_ARTICULO=:ID_ARTICULO,
                               CANTIDAD=:CANTIDAD,
                               ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                               NRO_LOTE=:NRO_LOTE,
                               ID_LOTE=:ID_LOTE,
                               COSTO_C_IVA=replace(:COSTO_C_IVA,'.',''),
                               NRO_ORDEN=:NRO_ORDEN,
                               OBSERVACION=:OBSERVACION,
                               DESC_ARTICULO=:DESC_ARTICULO,
                               ID_IVA=:ID_IVA,
                               TOTAL_COSTO=replace(:TOTAL_COSTO,'.',''),
                               ID_CENTRO_COSTO=:ID_CENTRO_COSTO,
                               ID_BARRA = :ID_BARRA
                               WHERE ID=:ID  AND
                               ID_ENTSAL_CAB=:P245_ID;
                
                           when 'D' then
                               delete from stw_entsal_det
                               where ID = :ID 
                               and ID_ENTSAL_CAB=:P245_ID;
                
                              
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 56173320313157779
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process envio (
        name: ENVIO
        type: executeCode
        executionChain: @procesar-comprobante-electronico
        source {
            plsqlCode:
                ```plsql
                --SI ES FACTURA ELECTRONICA INTENTARA ENVIAR AL SIFEN SI HAY ALGUN ERROR SE IGNORA 
                
                declare
                    vind_fact_electronica varchar2(1);
                    vind_auto             varchar2(1);
                    vmensaje              varchar2(300);
                    vAmbienteSIFEN        VARCHAR2(30);
                
                begin
                
                
                    SELECT NVL(IND_FACT_ELECTRONICA,'X'), NVL(IND_AUTOMATICO_FE, 'N')
                    INTO  vind_fact_electronica, vind_auto
                    FROM BSW_SERIES_COMPROB
                    WHERE ID=:P135_ID_SERIE_COMP;
                
                    vAmbienteSIFEN := PKGFE.PARAMETRO(:P0_ID_EMPRESA, 'AMBIENTE_SIFEN');
                
                    IF VIND_FACT_ELECTRONICA = 'S' AND vind_auto = 'S' THEN
                
                        FEW_PROCESAR_UNICA_REMISION(:P0_ID_EMPRESA,:P245_ID,vAmbienteSIFEN,vmensaje);
                
                    END IF;
                
                
                EXCEPTION
                    WHEN OTHERS THEN
                      NULL;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 66816422880599540
        }
    )

