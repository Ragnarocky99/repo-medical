    computation p245-id-motivo-ent-sal (
        itemName: P245_ID_MOTIVO_ENT_SAL
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v_motivo number(10);
                
                begin
                IF :P245_ID_CLIENTE IS NOT NULL THEN 
                SELECT ID 
                into v_motivo
                FROM STW_MOTIVO_ENT_SAL
                WHERE ID_EMPRESA=:P0_COD_EMPRESA 
                AND COD_MOTIVO_ENT_SAL=W_BUSCA_PARAMETRO('ST','REM_TRAS_CLI');
                return v_motivo;
                else    
                SELECT ID   
                INTO v_motivo 
                FROM STW_MOTIVO_ENT_SAL
                WHERE ID_EMPRESA=:P0_COD_EMPRESA 
                AND COD_MOTIVO_ENT_SAL=W_BUSCA_PARAMETRO('ST','REM_TRAS_DEP');
                return v_motivo;
                end if; 
                exception 
                when no_data_found  then
                raise_application_error(-20000,'No se encontro el motivo de traslado');
                when others then
                raise_application_error(-20000,'Error en la tabla de motivos de entrada/salida'||sqlerrm);
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Proceso para determinar el motivo de la remisión "
        }
    )

    computation p245-id-serie-comp (
        itemName: P245_ID_SERIE_COMP
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  VID_SERIE        number(10);
                  V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                  SELECT owa_util.get_cgi_env('REMOTE_ADDR') INTO V_IP_MAQUINA FROM DUAL;
                  select ID
                    INTO VID_SERIE
                    from BSW_SERIES_COMPROB t
                   WHERE ID_EMPRESA = :P0_COD_EMPRESA
                     AND ID_SUCURSAL = :P0_COD_SUCURSAL
                     AND TIP_COMPROBANTE = W_BUSCA_PARAMETRO('ST', 'TIPO_REMISION')
                     AND IND_ACTIVO = 'S'
                     AND T.TERMINAL = V_IP_MAQUINA;
                  RETURN VID_SERIE;
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    return null;
                  WHEN OTHERS THEN
                    RETURN null;
                END;
                
                ```
        }
        serverSideCondition {
            type: never
        }
    )

