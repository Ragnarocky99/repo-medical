                selectionType: columns
                columns: NRO_LOTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation controla-stock (
        name: controla_stock
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @entsal-det
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vcantidad number;
                BEGIN
                
                    /*IF NVL(:P245_PERMISO_FACTURA_NEGATIVO,'N') = 'S'or NVL(:IND_MUEVE_STOCK,'S') = 'N' THEN
                      RETURN TRUE;
                    END IF;*/
                    if :id_articulo is not null and :id_lote is not null then
                      begin
                        select sum(cant_dispon)
                          into vcantidad
                        from stw_existencia_art 
                        where id_empresa = :P0_ID_EMPRESA
                          and id_sucursal = :P0_ID_SUCURSAL
                          and id_articulo = :id_articulo
                          and id_lote = :id_lote;
                      exception
                        when no_data_found then
                          vcantidad := 0;
                        when others then
                          vcantidad := 0;
                          raise_application_error(-20000,'Error al buscar existencia '||sqlerrm);
                      end;
                      if nvl(vcantidad,0) < nvl(:cantidad,0) then
                        return FALSE;
                      else
                        return TRUE;
                      end if;
                    else
                      return TRUE;
                    end if;
                end;
                ```
        }
        error {
            errorMessage: #COLUMN_HEADER# cantidad super al stock.
            associatedColumn: CANTIDAD
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-cantidad-en-lote (
        name: Validar cantidad en lote
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @entsal-det
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from stw_existencia_art EX
                  join stw_articulos      ar on ar.id = EX.id_articulo
                 where EX.Id_Articulo = :ID_ARTICULO
                   and EX.id_lote = :ID_LOTE
                   and EX.Id_Sucursal = :P0_ID_SUCURSAL
                   and (:CANTIDAD <= EX.Cant_Dispon or nvl(ar.ind_maneja_stock, 'S') = 'N')
                ```
        }
        error {
            errorMessage: La cantidad solicitada es mayor que la cantidad disponible en el lote seleccionado en su sucursal.
            associatedColumn: CANTIDAD
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation validar-fec (
        name: Validar Fec
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P245_FEC_ENT_SAL) 
                       into vmensaje
                    from dual;
                    return TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha fuera de rango
        }
    )

    validation validar-lineas (
        name: Validar Lineas
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P245_CANTIDAD_DET<=:P245_LINEAS
        }
        error {
            errorMessage: "El comprobante no puede tener mas de &P245_LINEAS. lineas ! "
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-numero-en-rango (
        name: Validar numero en rango
        execution {
            sequence: 30
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM bsw_series_comprob S
                WHERE S.ID = :P245_ID_SERIE_COMP
                AND :P245_NUM_ENT_SAL BETWEEN S.num_inicial AND S.num_final;
                ```
        }
        error {
            errorMessage: Error, el número no está en el rango de la serie seleccionada.
            associatedItem: @P245_NUM_ENT_SAL
        }
    )

    computation p245-fec-fin-param (
        itemName: P245_FEC_FIN_PARAM
        execution {
            sequence: 50
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_fec date;
                
                BEGIN
                  select T.FEC_VENCIMIENTO
                    INTO v_fec
                    from BSW_SERIES_COMPROB t
                   WHERE T.ID_EMPRESA = :P0_COD_EMPRESA
                     AND T.ID_SUCURSAL = :P0_COD_SUCURSAL
                     AND TIP_COMPROBANTE = W_BUSCA_PARAMETRO(NULL, 'TIPO_REMISION');
                  RETURN v_fec;
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    return null;
                  WHEN OTHERS THEN
                    RETURN null;
                END;
                
                ```
        }
    )

