        column ID_LOTE (
            type: popupLov
            heading {
                heading: <p>Lote</p>
                alignment: center
            }
            settings {
                displayAs: modalDialog
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT LO.NRO_LOTE, LO.ID
                     FROM  STW_LOTES          LO
                     JOIN  STW_MOTIVO_ENT_SAL ME ON ME.ID = :P245_ID_MOTIVO_ENT_SAL
                     JOIN  STW_EXISTENCIA_ART EA ON EA.ID_LOTE = LO.ID AND EA.ID_ARTICULO = :ID_ARTICULO AND EA.ID_SUCURSAL = :P245_ID_SUCURSAL
                    WHERE LO.ID_ARTICULO = :ID_ARTICULO
                      AND ME.IND_ENT_SAL = 'S'
                      AND EA.CANT_DISPON > 0
                    UNION ALL
                    SELECT LO.NRO_LOTE, LO.ID
                     FROM  STW_LOTES          LO
                     JOIN  STW_MOTIVO_ENT_SAL ME ON ME.ID = :P245_ID_MOTIVO_ENT_SAL
                    WHERE LO.ID_ARTICULO = :ID_ARTICULO
                      AND ME.IND_ENT_SAL = 'E'
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    ID_ARTICULO
                    P245_ID_SUCURSAL.P245_ID_MOTIVO_ENT_SAL
                ]
                itemsToSubmit: [
                    ID_ARTICULO
                    P245_ID_SUCURSAL
                    P245_ID_MOTIVO_ENT_SAL
                ]
            }
            layout {
                sequence: 170
                columnAlignment: center
            }
            source {
                databaseColumn: ID_LOTE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
            advanced {
                htmlDomId: ID_LOTE
            }
