    dynamicAction setear-datos-fac (
        name: Setear datos FAC
        execution {
            sequence: 190
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_FACTURA_VT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    select fac.tip_comprobante||'-'||fac.ser_comprobante||'-'||fac.nro_comprobante, fac.id_cliente, nvl(per.direccion,'No especificada')
                    into :NRO_COMPROBANTE, :ID_CLIENTE, :DIRECCION_ENVIO
                    from vtw_comprobantes_cabecera fac
                    join ccw_clientes              cli on cli.id = fac.id_cliente
                    join bsw_personas              per on per.id = cli.id_persona
                    where fac.id = :ID_FACTURA_VT;
                    end;
                    ```
                itemsToSubmit: ID_FACTURA_VT
                itemsToReturn: [
                    NRO_COMPROBANTE
                    ID_CLIENTE
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

