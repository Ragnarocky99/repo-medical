    computation p725-nro-planilla (
        itemName: P725_NRO_PLANILLA
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vNroPlanilla  INV.RPW_REPARTO_CABECERA.NRO_PLANILLA%TYPE;
                
                BEGIN
                    BEGIN
                        SELECT NVL(MAX(TO_NUMBER(P.NRO_PLANILLA)),0) + 1
                          INTO vNroPlanilla
                        FROM RPW_REPARTO_CABECERA P
                        WHERE P.ID_EMPRESA = :P0_ID_EMPRESA;
                    EXCEPTION
                        WHEN OTHERS THEN
                            vNroPlanilla := 1;
                    END;
                
                    RETURN vNroPlanilla;
                
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P725_ID
        }
    )

    process cargar-ruteo (
        name: Cargar Ruteo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare vnro number(10); vcli number(10); vpro number(10); vnum number(10);
                begin
                   vnro := nvl(:P725_NRO_SOLICITUD,-1);
                   vcli := nvl(:P725_ID_CLIENTE,-1);
                   vpro := nvl(:P725_ID_PROVEEDOR,-1);
                   
                   select decode(vnro,-1,1,0) + decode(vcli,-1,0,1) + decode(vpro,-1,0,1)
                     into vnum
                     from dual;
                
                   if vnum != 1 then
                     raise_application_error(-20000,'Solo debe elegir o nro solicitud o cliente o proveedor');
                    end if;
                
                    begin 
                      if :P725_ID_CLIENTE is not null then
                          update rpw_reparto_detalle d
                             set d.orden_ruteo = :P725_NRO_RUTEO
                           where d.id_reparto_cabecera = :P725_ID
                             and :P725_NRO_RUTEO is not null
                             and exists (
                                 select 1
                                 from rpw_solicitud_reparto_det sd 
                                 join rpw_solicitud_reparto_cab sc on sc.id = sd.id_solicitud_rep_cab   
                                 where sd.id = d.id_solicitud_det
                                   and sc.id_cliente = :P725_ID_CLIENTE             );
                       end if;
                
                      if :P725_ID_PROVEEDOR is not null then
                          update rpw_reparto_detalle d
                             set d.orden_ruteo = :P725_NRO_RUTEO
                           where d.id_reparto_cabecera = :P725_ID
                             and :P725_NRO_RUTEO is not null
                              and exists (
                                 select 1
                                 from rpw_solicitud_reparto_det sd 
                                 join rpw_solicitud_reparto_cab sc on sc.id = sd.id_solicitud_rep_cab   
                                 where sd.id = d.id_solicitud_det
                                   and sc.id_proveedor = :P725_ID_PROVEEDOR
                             );
                       end if;
                
                      if :P725_NRO_SOLICITUD is not null then
                          update rpw_reparto_detalle d
                             set d.orden_ruteo = :P725_NRO_RUTEO
                           where d.id_reparto_cabecera = :P725_ID
                             and :P725_NRO_RUTEO is not null
                             and exists (
                                 select 1
                                 from rpw_solicitud_reparto_det sd 
                                 join rpw_solicitud_reparto_cab sc on sc.id = sd.id_solicitud_rep_cab   
                                 where sd.id = d.id_solicitud_det
                                   and sc.id = :P725_NRO_SOLICITUD
                             );
                       end if;      
                    exception 
                      when others then 
                       raise_application_error(-20000,'Error al actualizar nro ruteo. '||sqlerrm);
                    end;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 69968438216301729
        }
        serverSideCondition {
            whenButtonPressed: @cargarruteo
            type: never
        }
    )

    process cargar-ruteo-proc (
        name: Cargar Ruteo PROC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  RPW_CARGA_NRO_RUTEO(P_NRO_SOLICITUD => :P725_NRO_SOLICITUD,
                                      P_ID_CLIENTE => :P725_ID_CLIENTE,
                                      P_ID_PROVEEDOR => :P725_ID_PROVEEDOR,
                                      P_NRO_RUTEO => :P725_NRO_RUTEO,
                                      P_ID_REPARTO => :P725_ID);
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 69968697474301731
        }
        serverSideCondition {
            whenButtonPressed: @cargarruteo
        }
    )

