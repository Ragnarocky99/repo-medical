    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare vtotal number(10);
                begin
                
                 select sum(d.id_empresa)
                   into vtotal
                   from rpw_reparto_detalle d 
                   where d.id_reparto_cabecera = :P725_ID;
                  
                  update rpw_reparto_cabecera c    
                     set c.ID_PLANILLA_INGRESO = vtotal
                   where c.id = :P725_ID;
                 
                 exception 
                   when others then 
                    raise_application_error(-20000,sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 64915283017069930
        }
        serverSideCondition {
            whenButtonPressed: @guardar
            type: never
        }
    )

