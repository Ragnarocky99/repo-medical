    pageItem P725_NRO_PLANILLA (
        type: numberField
        label {
            label: <p>Número: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-planilla-de-reparto
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            cssClasses: no-pointer
            width: 30
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: comprobante
            customAttributes: tabindex="-1"
        }
        source {
            formRegion: @carga-de-planilla-de-reparto
            column: NRO_PLANILLA
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vNroPlanilla  INV.RPW_REPARTO_CABECERA.NRO_PLANILLA%TYPE;
                
                BEGIN
                    BEGIN
                        SELECT NVL(MAX(TO_NUMBER(P.NRO_PLANILLA)),0) + 1
                          INTO vNroPlanilla
                        FROM RPW_REPARTO_CABECERA P
                        WHERE P.ID_EMPRESA = :P0_ID_EMPRESA;
                    EXCEPTION
                        WHEN OTHERS THEN
                            vNroPlanilla := 1;
                    END;
                
                    RETURN vNroPlanilla;
                
                END;
                ```
        }
    )

