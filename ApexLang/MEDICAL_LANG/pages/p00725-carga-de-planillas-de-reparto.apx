        formAutoComplete: false
    }

    region carga-de-planilla-de-reparto (
        name: Carga de Planilla de Reparto
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  ID,
                        ID_EMPRESA,
                        NRO_PLANILLA,
                        FEC_PLANILLA,
                        ID_REPARTIDOR,
                        ID_VEHICULO,
                        ID_SUCURSAL,
                        ESTADO,
                        ID_USUARIO,
                        ID_ZONA,
                        FEC_VENCIMIENTO,
                        COD_USUARIO_AUD,
                        ID_PLANILLA_INGRESO,
                        ID_SUCURSAL_CENTRAL,
                        ID_REPARTIDOR_AYUDANTE,
                        HORA_SALIDA,
                        HORA_VUELTA,
                        KM_INICIAL,
                        KM_FINAL,
                        ID_VENDEDOR,
                        OBSERVACION,
                        COD_USU_ESTADO,
                        ESTADO_FEC,
                        ID_MOTIVO_REPARTO,
                        CANTIDAD_CAJAS
                FROM RPW_REPARTO_CABECERA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region carga-orden-nro-ruteo (
        name: Carga Orden Nro Ruteo
        type: staticContent
        layout {
            sequence: 240
            parentRegion: @carga-de-planilla-de-reparto
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  A.ID,
                        A.ID_EMPRESA,
                        A.ID_SUCURSAL,
                        A.ID_REPARTO_CABECERA,
                        --B.NOM_CLIENTE,
                        A.ESTADO,
                        --B.ID_MONEDA,
                        0 TOT_COMPROBANTE,
                        0 TOT_COMPROBANTE_COPIA,
                        A.COD_USUARIO_AUD,
                        A.NRO_PLANILLA,
                        A.TIP_COMPROBANTE,
                        A.ID_FACTURA_VT,
                        A.ID_REMISION,
                        A.ID_RECIBO,
                        A.IND_ENTREGADO,
                        A.HORA_ENTREGA,
                        A.FIRMADO_POR,
                        A.COMENTARIO,
                        A.NRO_COMPROBANTE,
                        --COALESCE(TO_CHAR(FC.ID_CLIENTE),TO_CHAR(RC.ID_CLIENTE),TO_CHAR(CC.ID_CLIENTE)) AS ID_CLIENTE,
                        SC.ID_CLIENTE,
                        --A.IND_DOCUMENTO,
                        --A.IND_STOCK,
                        A.ID_FACTURA_CM,
                        A.ID_OCP,
                        A.ID_NOTA_ENVIO,
                        --A.DIRECCION_ENVIO,
                        SC.DIRECCION_ENVIO,
                        A.COD_USUARIO_ENTREGA,
                        --NVL(FA.ID_PROVEEDOR,OC.ID_PROVEEDOR) ID_PROVEEDOR
                        SC.ID_PROVEEDOR,
                        SC.ID AS NRO_SOLICITUD,
                        SC.ID_MOTIVO_REPARTO,
                        A.ORDEN_RUTEO,
                        SC.COMENTARIO COMENTARIO_SOLICITUD
                FROM RPW_REPARTO_DETALLE A
                JOIN RPW_SOLICITUD_REPARTO_DET SD ON SD.ID = A.ID_SOLICITUD_DET
                JOIN RPW_SOLICITUD_REPARTO_CAB SC ON SC.ID = SD.ID_SOLICITUD_REP_CAB
                LEFT JOIN VTW_COMPROBANTES_CABECERA FC ON FC.ID = A.ID_FACTURA_VT
                LEFT JOIN STW_ENTSAL_CAB            RC ON RC.ID = A.ID_REMISION
                LEFT JOIN CCW_RECIBOS               CC ON CC.ID = A.ID_RECIBO
                LEFT JOIN CMW_COMPRAS_CABECERA      FA ON FA.ID = A.ID_FACTURA_CM
                LEFT JOIN CMW_PEDIDOS_CABECERA      OC ON OC.ID = A.ID_OCP
                WHERE A.ID_REPARTO_CABECERA = :P725_ID
                ```
            pageItemsToSubmit: [
                P725_ID
                P725_ID_VENDEDOR
            ]
        }
        layout {
            sequence: 260
            parentRegion: @carga-de-planilla-de-reparto
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
