    pageItem P725_ID_CLIENTE (
        type: selectList
        label {
            label: <p>Cliente</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pe.nombre||'('||cl.cod_cliente||')', sc.id_cliente
                from rpw_solicitud_reparto_cab sc
                join rpw_solicitud_reparto_det sd on sd.id_solicitud_rep_cab = sc.id 
                join ccw_clientes              cl on cl.id = sc.id_cliente 
                join bsw_personas              pe on pe.id = cl.id_persona
                join rpw_reparto_detalle       rd on rd.id_solicitud_det = sd.id     
                where rd.id_reparto_cabecera = :P725_ID
                ```
            nullDisplayValue: -- Sin Seleccionar --
        }
        layout {
            sequence: 240
            region: @carga-orden-nro-ruteo
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

