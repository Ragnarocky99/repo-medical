page 620 (
    name: Reporte de Presupuesto Anual
    alias: REPORTE-DE-PRESUPUESTO-ANUAL
    title: Reporte de Presupuesto Anual
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region reporte-de-presupuesto-anual (
        name: Reporte de Presupuesto Anual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.ID,
                       P.ID_EMPRESA,
                       P.ID_EJERCICIO,
                       C.COD_CENTRO||' - '||C.DESCRIPCION AS CENTRO,
                       P.ID_CENTRO,
                       P.ID_CUENTA,
                       P.PRE_ENERO,
                       P.PRE_FEBRERO,
                       P.PRE_MARZO,
                       P.PRE_ABRIL,
                       P.PRE_MAYO,
                       P.PRE_JUNIO,
                       P.PRE_JULIO,
                       P.PRE_AGOSTO,
                       P.PRE_SEPTIEMBRE,
                       P.PRE_OCTUBRE,
                       P.PRE_NOVIEMBRE,
                       P.PRE_DICIEMBRE
                  from COW_PRESUPUESTO_ANUAL P, cow_centro_costos c--, COW_EJERCICIOS T
                  WHERE P.ID_EMPRESA = :P0_ID_EMPRESA
                  AND P.ID_CENTRO = C.ID
                  --AND P.ID_EJERCICIO = T.ID
                  AND (ID_EJERCICIO = :P620_EJERCICIOS OR :P620_EJERCICIOS   IS NULL)
                  AND (ID_CENTRO = :P620_CENTRO OR :P620_CENTRO IS NULL)
                  AND (ID_CUENTA = :P620_CUENTA OR :P620_CUENTA IS NULL)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 8117060220516617
        }

        column CENTRO (
            type: plainText
            heading {
                heading: Centro
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: plainText
