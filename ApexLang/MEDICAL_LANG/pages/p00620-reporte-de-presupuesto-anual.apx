        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 100
            region: @filtros
