        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-eraser
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process limpiar (
        name: Limpiar
        type: clearSessionState
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 7712068503460829
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    branch (
        name: Go To Page 622
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 622
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
