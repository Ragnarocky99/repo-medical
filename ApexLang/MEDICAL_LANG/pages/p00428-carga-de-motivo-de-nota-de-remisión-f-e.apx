page 428 (
    name: Carga de Motivo de Nota de Remisión F.E
    alias: CARGA-DE-MOTIVO-DE-NOTA-DE-REMISIÓN-F-E
    title: Carga de Motivo de Nota de Remisión F.E
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P428_COD_MOTIVO").readOnly = true;
            
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-motivo-de-nota-de-remisión-facturacion-electronica (
        name: "Carga de Motivo de Nota de remisión Facturacion electronica  "
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_MOTIVO,
                       DESCRIPCION
                  from FEW_MOTIVOS_NRE
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P428_COD_MOTIVO (
        type: textField
        label {
            label: <p>Cod Motivo: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
            column: COD_MOTIVO
            dataType: varchar2
        }
    )

    pageItem P428_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: </p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P428_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P428_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P428_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P428_ID
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p428-cod-motivo (
        itemName: P428_COD_MOTIVO
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: select  nvl( max(cod_motivo ), 0 ) + 1 from FEW_MOTIVOS_NRE
        }
        serverSideCondition {
            type: itemIsNull
            item: P428_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 23567898852800224
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-motivo-de-nota-de-remisión-f-e (
        name: Initialize form Carga de Motivo de Nota de Remisión F.E
        type: formInitialization
        formRegion: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 23567165398800217
        }
    )

    process newprocess-form-carga-de-motivo-nota-remision-facturacion-electronica (
        name: NewProcess form Carga de Motivo Nota Remision Facturacion electronica
        type: formAutoRowProcessing
        formRegion: @carga-de-motivo-de-nota-de-remisión-facturacion-electronica
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23567760617800223
        }
    )

)

