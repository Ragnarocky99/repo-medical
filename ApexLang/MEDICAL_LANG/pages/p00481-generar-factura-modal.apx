        action native-alert (
            action: alert
            settings {
                message: Factura Generada con Exito
                style: success
                icon: fa-check
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            serverSideCondition {
                type: item=value
                item: P481_IND_GENERADO
                value: S
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 120
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_mensaje varchar2(400);
                    v_nro_comprobante_sal number(10);
                    v_id_comprobante_sal number(10);
                    VIND_MOV_CAJ         varchar2(1);
                    begin
                    
                    if :P481_ESTADO='P' THEN 
                    /*
                    raise_application_error(
                            -20001,
                            'Error generating invoice. ' ||
                            'Empresa ID: ' || TO_CHAR(:P0_ID_EMPRESA) || ', ' ||
                            'Sucursal ID: ' || TO_CHAR(:P481_ID_SUCURSAL) || ', ' ||
                            'Serie Comprobante: ' || :P481_SER_COMPROBANTE || ', ' ||
                            'Numero Comprobante: ' || TO_CHAR(:P481_NRO_COMPROBANTE) || ', ' ||
                            'Cliente ID: ' || TO_CHAR(:P481_ID_CLIENTE) || ', ' ||
                            'Tipo Ref: ' || TO_CHAR(:P481_TIP_COMPROBANTE_REF) || ', ' ||
                            'Serie Ref: ' || :P481_SER_COMPROBANTE_REF || ', ' ||
                            'Numero Ref: ' || TO_CHAR(:P481_NRO_COMPROBANTE_REF) || ', ' ||
                            'Mensaje: ' || v_mensaje || ', ' ||
                            'Serie ID: ' || TO_CHAR(:P481_ID_SERIE) || ', ' ||
                            'Pedido ID: ' || TO_CHAR(:P481_ID_PEDIDO) || ', ' ||
                            'Usuario: ' || :APP_USER || ', ' ||
                            'Numero OCC: ' || TO_CHAR(v('P_NRO_OCC_GEN')) || ', ' ||
                            'Numero Comprobante Salida: ' || TO_CHAR(v_nro_comprobante_sal) || ', ' ||
                            'ID Comprobante Salida: ' || TO_CHAR(v_id_comprobante_sal)
                          );*/
                    genera_factura(p_id_empresa=>:P0_ID_EMPRESA,
                                   p_id_sucursal=>:P481_ID_SUCURSAL,
                                   p_ser_comprobante=>:P481_SER_COMPROBANTE,
                                   p_nro_comprobante=>:P481_NRO_COMPROBANTE,
                                   p_id_cliente=>:P481_ID_CLIENTE,
                                   p_tip_ref=>:P481_TIP_COMPROBANTE_REF, --TIPO , SERIE Y NUMERO DEL PEDIDO
                                   p_ser_ref=>:P481_SER_COMPROBANTE_REF,
                                   p_nro_ref=>:P481_NRO_COMPROBANTE_REF,
                                   p_mensaje=> v_mensaje,
                                   p_id_serie_comprob=>:P481_ID_SERIE,  -- ID DE LA SERIE DE COMPROBANTE 
                                   p_id_pedido=>:P481_ID_PEDIDO,
                                   p_usuario=>:APP_USER,
                                   p_nro_occ=>:P481_NRO_OCC,
                                   p_nro_comprobante_sal=>v_nro_comprobante_sal,
                                   p_id_comprobante_sal=>v_id_comprobante_sal
                                   );
                      --v_id_comprobante_sal := :P481_ID_COMPROBANTE_SAL;
                     BEGIN
                          SELECT NVL(IND_MOV_CAJA,'N')
                          INTO   VIND_MOV_CAJ
                          FROM   BSW_SERIES_COMPROB
                          WHERE ID=:P481_ID_SERIE
                          AND ID_EMPRESA=:P0_ID_EMPRESA;
                          EXCEPTION
                          WHEN OTHERS THEN
                          VIND_MOV_CAJ:='N';
                      END;
                    
                                   IF v_id_comprobante_sal is not null then
                                   :P481_ID_COMPROBANTE_SAL:=v_id_comprobante_sal;
                                   :P481_IND_GENERADO:='S';
                                   :P481_ESTADO:='F';
                                   END IF;
                                   IF :P481_ID_CONDICION_VENTA=W_BUSCA_PARAMETRO('CC','CONDICION_CONTADO') and v_id_comprobante_sal 
                                   is not null AND VIND_MOV_CAJ='S' THEN 
                                   :P481_IND_MOVCAJ:='S';
                                   END IF;
                                --   apex_application.g_print_success_message := 'La liquidación ya ha sido cerrada.' ;
                    else
                    RAISE_APPLICATION_ERROR(-20000,'El Pedido ya esta facturado '|| :P481_ESTADO||SQLERRM);
                    END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                    ROLLBACK;
                    RAISE_APPLICATION_ERROR(-20000,'Error al realizar la generacion de factura'||sqlerrm);
                    end;
                    ```
                itemsToSubmit: [
                    P481_ESTADO
                    P481_ID_PEDIDO
                    P481_ID_SERIE
                    P481_ID_CONDICION_VENTA
                    P481_SER_COMPROBANTE
                    P481_ID_CONDICION_VENTA
                    P481_NRO_OCC
                ]
                itemsToReturn: [
                    P481_IND_GENERADO
                    P481_ESTADO
                    P481_IND_MOVCAJ
                    P481_ID_COMPROBANTE_SAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
                stopExecutionOnError: false
            }
        )

