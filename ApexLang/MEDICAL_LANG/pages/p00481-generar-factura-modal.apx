page 481 (
    name: Selecciona una opcion
    alias: GENERAR-FACTURA-MODAL
    title: Selecciona una Opcion
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region items-a-facturar (
        name: Items a Facturar
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       CO.C_ID ID,
                       CO.DESC_ARTICULO,
                       CO.COD_ARTICULO,
                       CO.ID_ENVASE,
                       CO.ID_UNIDAD_MEDIDA,
                       CO.ID_MARCA,
                       CO.CANTIDAD_APROBADA,
                       CO.CANTIDAD_A_ENTREGAR,
                       CO.STOCK_SUCURSAL STOCK,
                       CO.CANT_RESERVADA,
                       'S' SELECCIONAR
                       
                  FROM CMWV_COTIZACIONES CO
                 WHERE CO.ID_EMPRESA   = :P0_ID_EMPRESA
                   AND CO.ID_ARTICULO != 813
                   AND CO.NRO_OCC = :P485_NRO_OCC
                   AND CO.CANTIDAD_PENDIENTE_OCC > 0
                   AND CO.ID_PEDIDO NOT IN (14100, 13860, 14781, 14460, 14768, 14801, 15970, 16010, 17320, 17313, 17314, 17319, 18973, 17315, 17316,24672,16490,17351)
                   AND CO.CANTIDAD_A_ENTREGAR > 0
                   AND EXISTS (
                    SELECT 1 
                      FROM VTW_PEDIDOS_CABECERA PED
                     WHERE PED.ID                       = CO.ID_PEDIDO
                       AND NVL(PED.AUTORIZA_STOCK,'X')  = 'S'
                       AND NVL(PED.AUTORIZA_CTACTE,'X') = 'S'
                       AND PED.ID_CLIENTE               = :P481_ID_CLIENTE
                   )
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ItemsFac
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 45569725591596608
        }

