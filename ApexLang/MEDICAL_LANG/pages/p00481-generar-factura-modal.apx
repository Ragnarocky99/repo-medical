    dynamicAction cargar-datos-en-coleccion (
        name: Cargar datos en coleccion
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR ARTICULOS IS
                          SELECT CO.C_ID ID       
                          FROM CMWV_COTIZACIONES CO
                         WHERE CO.ID_EMPRESA   = :P0_ID_EMPRESA
                           AND CO.ID_ARTICULO != 813
                           AND CO.NRO_OCC = :P485_NRO_OCC
                           AND CO.CANTIDAD_PENDIENTE_OCC > 0
                           AND CO.ID_PEDIDO NOT IN (14100, 13860, 14781, 14460, 14768, 14801, 15970, 16010, 17320, 17313, 17314, 17319, 18973, 17315, 17316,24672,16490,17351)
                           AND CO.CANTIDAD_A_ENTREGAR > 0
                           AND EXISTS (
                            SELECT 1 
                              FROM VTW_PEDIDOS_CABECERA PED
                             WHERE PED.ID                       = CO.ID_PEDIDO
                               AND NVL(PED.AUTORIZA_STOCK,'X')  = 'S'
                               AND NVL(PED.AUTORIZA_CTACTE,'X') = 'S'
                               AND PED.ID_CLIENTE               = :P481_ID_CLIENTE
                           );
                    BEGIN
                        APEX_COLLECTION.create_or_truncate_collection('COL_COTIZACIONES');
                    
                        FOR B IN ARTICULOS
                        LOOP
                            APEX_COLLECTION.add_member(
                                p_collection_name => 'COL_COTIZACIONES',
                                p_n001            => B.ID
                            );
                        END LOOP;
                    END;
                    ```
                itemsToSubmit: P481_ID_PEDIDO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cargar-serie (
        name: Cargar Serie
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    nombre varchar2(255):=WWV_FLOW.G_INSTANCE;
                    vnro_occ  exception;
                    BEGIN
                    Select c001,c002
                    into :P481_ID_SERIE,:P481_SER_COMPROBANTE
                    From APEX_COLLECTIONS
                    Where COLLECTION_NAME = nombre
                    AND SEQ_ID = 1;
                    --APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => nombre);
                    IF V('P_NRO_OCC_GEN') IS NULL THEN
                       RAISE VNRO_OCC;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    :P481_IND_ERROR:='S';
                    :P481_MENSAJE_ERR:='No se ha elegido ningun talonario!!';
                    WHEN VNRO_OCC THEN
                    :P481_IND_ERROR:='S';
                    :P481_MENSAJE_ERR:='No se cargo el nro de occ';
                    WHEN OTHERS THEN
                    :P481_IND_ERROR:='S';
                    :P481_MENSAJE_ERR:='Error al cargar el talonario '||sqlerrm;
                    END;
                    ```
                itemsToSubmit: P481_IND_ERROR
                itemsToReturn: [
                    P481_ID_SERIE
                    P481_SER_COMPROBANTE
                    P481_IND_ERROR
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                stopExecutionOnError: false
            }
        )

    )

