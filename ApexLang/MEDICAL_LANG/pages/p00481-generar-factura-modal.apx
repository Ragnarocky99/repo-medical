    process actualizar-coleccion (
        name: Actualizar Coleccion
        type: executeCode
        editableRegion: @items-a-facturar
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSEQ_ID NUMBER;
                BEGIN
                    BEGIN
                        SELECT SEQ_ID
                          INTO VSEQ_ID
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'COL_COTIZACIONES'
                           AND N001 = :ID;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VSEQ_ID := NULL;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    
                    IF :SELECCIONAR = 'N' THEN
                        APEX_COLLECTION.DELETE_MEMBER(P_COLLECTION_NAME => 'COL_COTIZACIONES',
                                                      P_SEQ             => VSEQ_ID);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 46269390071171931
        }
        serverSideCondition {
            whenButtonPressed: @factura
        }
    )

    process creamos-coleccion (
        name: Creamos coleccion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('COL_COTIZACIONES');
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 46212777799596771
        }
        serverSideCondition {
            whenButtonPressed: @factura
            type: never
        }
    )

    process facturar (
        name: Facturar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VMENSAJE             VARCHAR2(4000);
                    VNRO_COMPROBANTE_SAL VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                
                BEGIN
                    -- SELECT COUNT(*)
                    --   INTO VNRO_COMPROBANTE_SAL
                    --   FROM APEX_COLLECTIONS
                    --  WHERE COLLECTION_NAME = 'COL_COTIZACIONES';
                
                    -- RAISE_APPLICATION_ERROR(-20000, VNRO_COMPROBANTE_SAL);
                    IF :P481_ESTADO = 'P' THEN 
                        GENERA_FACTURA(P_ID_EMPRESA=>:P0_ID_EMPRESA,
                                       P_ID_SUCURSAL=>:P481_ID_SUCURSAL,
                                       P_SER_COMPROBANTE=>:P481_SER_COMPROBANTE,
                                       P_NRO_COMPROBANTE=>:P481_NRO_COMPROBANTE,
                                       P_ID_CLIENTE=>:P481_ID_CLIENTE,
                                       P_TIP_REF=>:P481_TIP_COMPROBANTE_REF, --TIPO , SERIE Y NUMERO DEL PEDIDO
                                       P_SER_REF=>:P481_SER_COMPROBANTE_REF,
                                       P_NRO_REF=>:P481_NRO_COMPROBANTE_REF,
                                       P_MENSAJE=> VMENSAJE,
                                       P_ID_SERIE_COMPROB=>:P481_ID_SERIE,  -- ID DE LA SERIE DE COMPROBANTE 
                                       P_ID_PEDIDO=>:P481_ID_PEDIDO,
                                       P_USUARIO=>:APP_USER,
                                       P_NRO_OCC=>:P481_NRO_OCC,
                                       P_NRO_COMPROBANTE_SAL=>VNRO_COMPROBANTE_SAL,
                                       P_ID_COMPROBANTE_SAL=>:P481_ID_COMPROBANTE_SAL
                                       );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
