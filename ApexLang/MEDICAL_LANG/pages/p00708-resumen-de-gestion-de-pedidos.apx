    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CCWV_RESUMEN_GESTION_PEDIDOS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                AND (ID_MARCA = :P708_MARCA OR :P708_MARCA IS NULL)
                AND (UPPER(DESC_ARTICULO) LIKE '%'||UPPER(:P708_DESC_ART)||'%' OR :P708_DESC_ART IS NULL)
                AND (COD_ARTICULO = :P708_COD_ARTICULO OR :P708_COD_ARTICULO IS NULL)
                AND (UPPER(COD_ORIGEN_ART) = :P708_COD_FABRICANTE OR :P708_COD_FABRICANTE IS NULL)
                AND (ID_PROVEEDOR = :P708_PROVEEDOR OR :P708_PROVEEDOR IS NULL)
                AND (NRO_COMPROBANTE = :P708_NRO_PEDIDO OR :P708_NRO_PEDIDO IS NULL)
                AND (FEC_COMPROBANTE BETWEEN :P708_FECHA_DESDE AND :P708_FECHA_HASTA)
                AND (COD_USUARIO_DESPACHANDO = :P708_DESPACHADO_POR OR :P708_DESPACHADO_POR IS NULL )
                ```
            pageItemsToSubmit: [
                P708_NRO_PEDIDO
                P708_FECHA_DESDE
                P708_FECHA_HASTA
                P708_DESPACHADO_POR
                P708_MARCA
                P708_DESC_ART
                P708_COD_ARTICULO
                P708_COD_FABRICANTE
                P708_PROVEEDOR
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 52726122994515028
        }

