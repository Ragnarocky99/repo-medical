page 708 (
    name: Resumen de Gestion de Pedidos
    alias: RESUMEN-DE-GESTION-DE-PEDIDOS
    title: Resumen de Gestion de Pedidos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            .anulado {
                color: red;
            }
            .presupuestado {
                color: orangered;
            }
            .cotizado{
                color: green;
            }
            .confirmado {
                color: #3f46bb;
            }
            .EnDeposito{
                color: brown;
            }
            .EntregadoCliente{
                color: aqua;
            }
            .OrdenCompra{
                color: yellowgreen;
            }
            .EnProceso{
                color: yellow;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
