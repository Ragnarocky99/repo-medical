    dynamicAction validar-serie (
        name: Validar Serie
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P616_SER_ENVIO
        }
        serverSideCondition {
            type: never
        }

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró la serie
                style: warning
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P616_BANDERA
                value: 0
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera number:=0;
                    BEGIN 
                    IF :P616_SER_ENVIO IS NOT NULL THEN
                        SELECT NVL((SELECT 1 FROM BSW_SERIES_COMPROB WHERE ID_EMPRESA = :P0_COD_EMPRESA AND
                      --  TIP_COMPROBANTE = 'ENV' AND
                        SER_COMPROBANTE = :P616_SER_ENVIO),0) 
                        AS BANDERA 
                        INTO vbandera
                        FROM DUAL;
                        :P616_BANDERA := VBANDERA;        
                    end if;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(-20000,'No se encontro la serie'||:P616_BANDERA);
                    END;
                    ```
                itemsToSubmit: P616_SER_ENVIO
                itemsToReturn: P616_BANDERA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

