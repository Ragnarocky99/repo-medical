    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("CANTIDAD_COPIA");
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                         
                          
                        v_total_cantidad      = v_total_cantidad     + parseFloat(r[v_cantidad].replace(/\./g,''));
                       
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                 $s('P616_TOTALES',v_total_cantidad);
            }
            
            function updateColorCheckbox(e) {
            
                e.stopPropagation();
            
                var region = apex.region('Detalles');      // Static ID of the Interactive Grid
                var grid = region.call("getViews").grid;
                var model = grid.model;
                var totalRec = model.getTotalRecords();
                var  selectedRec = 0;
                var col_selected = model.getFieldKey("IND_RECEPCION");      // Column Name
                
                model.forEach(function (record, index, id) {
                   var n_sal = (record[col_selected]);
                     if (!isNaN(n_sal) && n_sal == 1) {
                        selectedRec += 1;
                    }
                    
                });
            
            if (selectedRec == totalRec ){
             model.forEach(function (record, index, id) {
                        model.setValue(record, "IND_RECEPCION", "S" + 1);
                    });
                
            }else{
                 model.forEach(function (record, index, id) {
                        model.setValue(record, "IND_RECEPCION", "S");
                    });
                
            }
            }
            
            function marcarTodos(){
                try{
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_seleccionada = model.getFieldKey("IND_RECEPCION");
                var v_total_cantidad     = 0;
                var bandera ='N'
                model.forEach(function(r, index, id) {
                        
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                 
                    if(r[v_seleccionada]=='N' || r[v_seleccionada]==null || r[v_seleccionada]==''){
                        bandera='S'
                       model.setValue(r,'IND_RECEPCION','S');
                       
                    }
               if(r[v_seleccionada]=='S' && bandera=='N'){
                 
                       model.setValue(r,'IND_RECEPCION','N');
                 
                    }    
                       
                    }
                    
                });
            }catch(e){
                
            }
            
            }
            
            
            ```
        executeWhenPageLoads: document.getElementById("P616_TOTALES").readOnly = true;
    }
