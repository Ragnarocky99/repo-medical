    process nota-de-envios-det-save-interactive-grid-data (
        name: Nota de Envios Det - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @nota-de-envios-det
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                                insert into STW_NOTAS_ENVIO_DET_SOL
                                (ID_EMPRESA,
                                TIP_ENVIO,
                                ID_NRO_ENVIO_CAB,
                                ID_ARTICULO, 
                                DESC_ARTICULO,
                                CANTIDAD, 
                                ID_UNIDAD_MEDIDA, 
                                NRO_LOTE, 
                                ID_LOTE, 
                                IND_RECEPCION,
                                SER_ENVIO, 
                                ID_BARRA)
                                values(:P0_COD_EMPRESA, 
                                :P616_TIP_ENVIO, 
                                :P616_ID, 
                                ----:ID_NRO_ENVIO_CAB,
                                :ID_ARTICULO, 
                                :DESC_ARTICULO, 
                                :CANTIDAD, 
                                :ID_UNIDAD_MEDIDA,
                                :NRO_LOTE, 
                                :ID_LOTE, 
                                :IND_RECEPCION, 
                                :P616_SER_ENVIO, 
                                :ID_BARRA);
                            
                            WHEN 'U' then 
                   
                                update STW_NOTAS_ENVIO_DET_SOL  d
                                    set D.ID_ARTICULO = :ID_ARTICULO,
                                        D.CANTIDAD       = :CANTIDAD,
                                        D.ID_UNIDAD_MEDIDA     = :ID_UNIDAD_MEDIDA,
                                        D.NRO_LOTE        = :NRO_LOTE,
                                        D.IND_RECEPCION       = :IND_RECEPCION,
                                        D.ID_BARRA = :ID_BARRA
                                             
                                where   ID_NRO_ENVIO_CAB = :P616_ID
                                  and   d.id = :id;
                
                             
                            when 'D' then
                                delete STW_NOTAS_ENVIO_DET_SOL d     
                                WHERE d.ID_NRO_ENVIO_CAB = :P616_ID
                                  and d.id = :id;  
                    end case;
                    
                         EXCEPTION
                when no_data_found then
                RAISE_APPLICATION_ERROR(-20998,'ERROR: al insertar'|| SQLERRM );
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20995,'ERROR: al insertar AA'|| SQLERRM);
                              
                
                END;
                
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Operación correcta
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 10283572811561518
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE,DELETE
        }
    )

