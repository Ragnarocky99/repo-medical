    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 70
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @nota-de-envios-det
            columns: COD_ARTICULO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_ART_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction after-dialog-close (
        name: AFTER_DIALOG_CLOSE
        execution {
            sequence: 80
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @nota-de-envios-det
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: columns
                columns: ID_ARTICULO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @nota-de-envios-det
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P616_BANDERA2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-totales (
        name: Calcular Totales
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @nota-de-envios-det
            columns: CANTIDAD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :cantidad <= 0 then
                    :cantidad := null;
                    RAISE_APPLICATION_ERROR(-20000, 'La cantidad no debe ser menor o igual a 0');
                    end if;
                    ```
                itemsToSubmit: CANTIDAD
                itemsToReturn: CANTIDAD
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: P616_TOTALES
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :cantidad
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_COPIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P616_TOTALES
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: CANTIDAD
            }
        )

    )

    dynamicAction cargar-datos-de-articulos (
        name: Cargar Datos de Articulos
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @nota-de-envios-det
            columns: ID_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT NRO_LOTE,ID
                    INTO :NRO_LOTE,:ID_LOTE
                    FROM STW_LOTES
                    WHERE ID_ARTICULO=:ID_ARTICULO
                    and rownum=1;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: [
                    NRO_LOTE
                    ID_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    grid.gotoCell(array[0][14],'COD_ARTICULO');
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: 1
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_id_unidad_medida number(18);
                    begin
                    SELECT ID_UNIDAD_MEDIDA 
                    INTO V_ID_UNIDAD_MEDIDA
                    FROM 
                    STW_ARTICULOS 
                    WHERE ID=:ID_ARTICULO;
                    RETURN V_ID_UNIDAD_MEDIDA;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    end;
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_UNIDAD_MEDIDA
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

