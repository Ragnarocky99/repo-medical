    region nota-de-envios-det (
        name: Nota de Envios Det
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.TIP_ENVIO,
                       D.ID_NRO_ENVIO_CAB,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.CANTIDAD AS CANTIDAD_COPIA,
                       D.IND_RECEPCION,
                       D.SER_ENVIO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.ID_LOTE,
                       D.CANT_FAC,
                       D.DESC_ARTICULO,
                       D.ID_BARRA
                  from STW_NOTAS_ENVIO_DET_SOL D, STW_ARTICULOS A
                 where D.id_nro_envio_cab=:P616_ID
                 AND A.ID = D.ID_ARTICULO
                
                ```
            pageItemsToSubmit: P616_ID
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--labelsAbove
            ]
        }
