    validation validar-fec (
        name: Validar Fec
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                 v_mensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P616_FECHA) 
                       into v_mensaje
                    from dual;
                    return TRUE;
                  exception
                    when no_data_found then
                      v_mensaje := null;
                    when others then
                      v_mensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha fuera de rango
            associatedItem: @P616_FECHA
        }
    )

    computation p616-nro-envio (
        itemName: P616_NRO_ENVIO
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_nro_envio STW_NOTAS_ENVIO_CAB_SOL.NRO_ENVIO%TYPE;
                BEGIN
                IF :P616_NRO_ENVIO IS  NULL THEN
                SELECT NVL(MAX(NRO_ENVIO),0)+1
                INTO v_nro_envio
                FROM
                STW_NOTAS_ENVIO_CAB_SOL 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P616_SER_ENVIO=SER_ENVIO;
                RETURN V_NRO_ENVIO;
                END IF;
                 RETURN :P616_NRO_ENVIO;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_ENVIO:=1;
                RETURN V_NRO_ENVIO;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
    )

