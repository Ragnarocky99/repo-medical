page 865 (
    name: Operaciones
    alias: OPERACIONES
    title: Operaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region operaciones (
        name: Operaciones
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PDW_PROCESOS
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
            orderByClause: COD_PROCESO DESC
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 14659288081029996
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @COD_PROCESO
                layout {
                    width: 124.5
                    sequence: 4
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_PROCESO (
            type: numberField
            heading {
                heading: <p>Cod. Proceso</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                cssClasses: is-readonly
            }
            source {
                databaseColumn: COD_PROCESO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DESCRIPCION (
            type: textarea
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 150
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    process operaciones-save-interactive-grid-data (
        name: Operaciones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @operaciones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14665948639030004
        }
    )

)

