    dynamicAction id-condición-venta (
        name: ID_CONDICIÓN_VENTA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P567_ID_CONDICION_VENTA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    	select  nro_cuotas
                    	  from ccw_condiciones_ventas
                    	 where id_empresa = :P0_ID_EMPRESA
                    	and id = :P567_ID_CONDICION_VENTA
                    ```
                itemsToSubmit: P567_ID_CONDICION_VENTA
            }
            affectedElements {
                selectionType: items
                items: P567_NRO_CUOTAS
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction precio (
        name: Precio
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @lotes-det
            columns: TOT_MONTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: dbms_lock.sleep(0.5);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

