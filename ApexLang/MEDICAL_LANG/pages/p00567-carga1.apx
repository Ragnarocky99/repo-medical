    process guardar-img-en-directorio (
        name: Guardar IMG en Directorio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  l_file UTL_FILE.file_type;
                  l_blob BLOB;
                  l_buffer RAW(32767);
                  l_amount BINARY_INTEGER := 32767;
                  l_pos INTEGER := 1;
                  l_filename varchar2(300);
                  l_mimetype varchar2(300);
                BEGIN
                  -- Retrieve the BLOB image data from the page item
                  SELECT blob_content,filename,mime_type
                   into l_blob, l_filename,l_mimetype
                                   FROM apex_application_temp_files
                                  WHERE name = :P567_IMAGEN;
                  -- Open the file for writing to the directory
                  l_file := UTL_FILE.fopen('IMAGENES_LOTES', :P567_ID||'-'||:P567_ID_1||'.jpg', 'wb', 32767);
                
                  -- Loop through the BLOB data and write it to the file in chunks
                  WHILE l_amount >= 32767 LOOP
                    DBMS_LOB.read(l_blob, l_amount, l_pos, l_buffer);
                    UTL_FILE.put_raw(l_file, l_buffer, TRUE);
                    l_pos := l_pos + l_amount;
                  END LOOP;
                
                  -- Close the file
                  UTL_FILE.fclose(l_file);
                
                  -- Insert a record into the file table with the file details
                
                
                
                
                END;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 94353448887275012
        }
        serverSideCondition {
            whenButtonPressed: @create-img
        }
    )

