    pageItem P567_COD_LOTE (
        type: textField
        label {
            label: <p>Lote: </p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-lotes
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 3
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @lotes
            column: COD_LOTE
            dataType: number
        }
        default {
            type: sqlQueryMultipleValues
            sqlQueryMultipleValues:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(L.COD_LOTE)), 0)+1
                from LTW_LOTES L
                WHERE L.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

