    region imagenes (
        name: Imagenes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  SELECT ID,
                       MIMETYPE,
                       FILENAME,
                          DESCRIPCION,
                          ID_LOTE||'-'||ID  AS IMAGE,
                          ID_EMPRESA,
                          NRO_FOTO,
                          ID_LOTE
                          --ROWNUM AS ORDEN
                  FROM LTW_LOTES_FOTOS
                  WHERE ID_LOTE=:P567_ID
                ```
            pageItemsToSubmit: P567_ID
        }
