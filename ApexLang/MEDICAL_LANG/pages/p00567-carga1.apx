    dynamicAction tot-cuota (
        name: Tot cuota
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @lotes-det
            columns: TOT_CUOTA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: " (NVL(NVL(:CUOTA_HASTA,0) - NVL(:CUOTA_DESDE,0),0)+1) * NVL(REPLACE(:TOT_CUOTA,'.',''),0)"
                itemsToSubmit: [
                    TOT_CUOTA
                    CUOTA_DESDE
                    CUOTA_HASTA
                ]
            }
            affectedElements {
                selectionType: columns
                columns: TOT_MONTO
            }
            execution {
                sequence: 10
            }
        )

    )

