    region existencia (
        name: Existencia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    E.ID_EMPRESA,
                    A.COD_ARTICULO,
                    A.DESCRIPCION,
                    --E.ID_SUCURSAL,
                    SU.ID_SUCURSAL_CENTRAL ID_SUCURSAL,
                    A.ID,
                    SUM(NVL(E.CANT_DISPON,  0)) AS CANT_DISPON,
                    obtener_cantidad_bloqueo(A.id, SU.id_sucursal_CENTRAL, 'S') AS CANT_BLOQUEO,
                    SUM(NVL(E.CANT_DISPON,  0)) - obtener_cantidad_bloqueo(A.id, SU.id_sucursal_CENTRAL, 'S') AS DISPONIBILIDAD,
                    A.Cod_Origen_Art as Cod_Fabricante,
                    A.Descripcion as Desc_Art,
                    ENV.Descripcion as Desc_Env,
                    UNI.Descripcion as Unidad_Medida,
                    MAR.Descripcion as Marca,
                    DECODE(SU.ID_SUCURSAL_CENTRAL, 690, 0, NVL(CANTIDAD_EN_OCP_PENDIENTE(E.ID_ARTICULO), 0)) CANT_PEND_OCP,
                    SUM(NVL(E.CANT_DISPON,  0)) - NVL((SELECT SUM(NVL(B.CANT_RESERVADA, 0))
                                                       FROM STWV_ARTICULOS_BLOQUEO B
                                                      WHERE B.ID_ARTICULO = A.ID
                                                        AND B.ID_SUCURSAL = SU.ID_SUCURSAL_CENTRAL
                                                        AND B.CANT_BLOQUEO > 0), 0) RESERVA_DISPONIBLE
                   
                FROM STW_EXISTENCIA_ART E
                JOIN STW_ARTICULOS A ON E.ID_ARTICULO = A.ID
                LEFT JOIN stw_envases ENV ON A.Id_Envase = ENV.ID
                LEFT JOIN stw_unidades_medida UNI ON A.Id_Unidad_Medida = UNI.ID
                LEFT JOIN stw_marcas MAR ON A.Id_Marca = MAR.Id
                LEFT JOIN BSW_SUCURSALES SU ON E.ID_SUCURSAL = SU.ID
                
                WHERE E.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (A.ID = :P425_ARTICULOS OR :P425_ARTICULOS IS NULL AND :P425_DESC_ART IS NOT NULL)
                   AND (E.ID_SUCURSAL = :P425_SUCURSAL OR :P425_SUCURSAL IS NULL)
                   and (A.id_marca = :P425_ID_MARCA or :P425_ID_MARCA is null)
                   and (a.cod_origen_art like :P425_COD_FABRICANTE||'%' or :P425_COD_FABRICANTE is null)
                   and (upper(a.descripcion) like '%'||:P425_DESC_ART||'%' or :P425_DESC_ART is null)
                   and NVL(SU.IND_DEPOSITO_VENCIDOS, 'N') != 'S'
                
                GROUP BY 
                    E.ID_EMPRESA,
                    A.COD_ARTICULO,
                    A.DESCRIPCION,
                    SU.ID_SUCURSAL_CENTRAL,---E.ID_SUCURSAL,
                    A.ID,
                    A.Cod_Origen_Art,
                    A.Descripcion,
                    ENV.Descripcion,
                    UNI.Descripcion,
                    MAR.Descripcion,
                    NVL(CANTIDAD_EN_OCP_PENDIENTE(E.ID_ARTICULO), 0)
                
                /*SELECT 
                    E.ID_EMPRESA,
                    A.COD_ATICULO,
                    A.DESCRIPCION,
                    E.ID_SUCURSAL,
                    A.ID,
                    SUM(NVL(E.CANT_DISPON,  0)) AS CANT_DISPON,
                    ---SUM(NVL(AB.CANT_BLOQUEO,0)) AS CANT_BLOQUEO,
                    obtener_cantidad_bloqueo(A.id,e.id_sucursal,'S') AS CANT_BLOQUEO,
                    --SUM(NVL(E.CANT_DISPON,  0)) - SUM(NVL(AB.CANT_BLOQUEO,0)) AS DISPONIBILIDAD
                    SUM(NVL(E.CANT_DISPON,  0)) - obtener_cantidad_bloqueo(A.id,e.id_sucursal,'S') AS DISPONIBILIDAD
                   
                FROM STW_EXISTENCIA_AT E,
                     STW_ATICULOS A ,
                     STWV_ATICULOS_BLOQUEO AB
                WHERE E.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (A.ID = :P425_ATICULOS OR :P425_ATICULOS IS NULL)
                   AND (E.ID_SUCURSAL = :P425_SUCURSAL OR :P425_SUCURSAL IS NULL)
                   AND E.ID_ATICULO = A.ID
                   AND E.ID_ATICULO = AB.ID_ATICULO(+)
                   AND E.ID_SUCURSAL = AB.ID_SUCURSAL(+)
                   
                GROUP BY 
                    E.ID_EMPRESA,
                    A.COD_ATICULO,
                    A.DESCRIPCION,
                    E.ID_SUCURSAL,
                    ---AB.CANT_BLOQUEO,
                    A.ID
                */
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P425_SUCURSAL
                P425_ARTICULOS
                P425_DESC_ART
            ]
        }
