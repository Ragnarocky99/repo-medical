    process detalle-por-lote-save-interactive-grid-data (
        name: Detalle por Lote - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalle-por-lote
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11500755280128929
        }
    )

    branch (
        name: Go To Page 495
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 495
                items: {
                    P495_ARTICULO: &P425_ARTICULOS.
                    P495_SUCURSAL: &P425_SUCURSAL.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

