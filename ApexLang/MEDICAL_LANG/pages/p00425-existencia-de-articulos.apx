    region detalle-por-lote (
        name: Detalle por Lote
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    E.ID,
                    --e.id_lote,
                    E.ID_EMPRESA,
                    AR.COD_ARTICULO,
                    E.ID_SUCURSAL,
                    LO.NRO_LOTE,
                    AR.ID ID_ARTICULO, 
                    /*SUM(*/NVL(E.CANT_DISPON,  0)/*)*/ AS CANT_DISPON,
                   LO.FEC_VENCIMIENTO,
                   E.NRO_ESTANTE,
                   E.NRO_FILA
                FROM STW_EXISTENCIA_ART E,
                     STW_ARTICULOS AR ,
                     STW_LOTES LO,
                     BSW_SUCURSALES SU
                WHERE E.ID_EMPRESA = :P0_ID_EMPRESA
                   AND E.ID_ARTICULO = AR.ID
                   AND E.ID_LOTE = LO.ID---(+)
                   AND NVL(E.CANT_DISPON,  0) != 0
                   AND E.ID_ARTICULO = :P425_ARTICULOS
                   AND SU.ID = E.ID_SUCURSAL
                   AND NVL(SU.IND_DEPOSITO_VENCIDOS, 'N') != 'S'
                ```
            pageItemsToSubmit: [
                P425_SUCURSAL
                P425_ARTICULOS
            ]
        }
        layout {
            sequence: 10
            parentRegion: @artículo-por-lote
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
