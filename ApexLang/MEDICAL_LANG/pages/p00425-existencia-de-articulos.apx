            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @botones
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inventario (
        buttonName: Inventario
        label: Reporte para Inventario
        layout {
            sequence: 10
            region: @botones
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 637
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refrescar (
        buttonName: REFRESCAR
        label: Refrescar
