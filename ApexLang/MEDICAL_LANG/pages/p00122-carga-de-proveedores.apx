    computation p122-cod-cuenta-contable (
        itemName: P122_COD_CUENTA_CONTABLE
        execution {
            sequence: 20
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT COD_CUENTA FROM COW_PLAN_CUENTAS 
                WHERE ID=:P122_ID_CUENTA_CONTABLE
                ```
        }
    )

    computation p122-cod-proveedor (
        itemName: P122_COD_PROVEEDOR
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(to_number(COD_PROVEEDOR)),0)+1 FROM CMW_PROVEEDORES WHERE
                ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P122_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
