page 122 (
    name: Carga de Proveedores
    alias: CARGA-DE-PROVEEDORES
    title: Carga de Proveedores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        maxWidth: 1100
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /*var textField = apex.item("P122_POR_RECARGO_PELIGRO");
            
            textField.widget().on("keyup", function(event) {
                var inputValue = textField.getValue();
                var regex = /^\d+(\.\d{1,2})?%?$/;
            
                if (!regex.test(inputValue)) {
                    textField.setInvalid();
                } else {
                    textField.setValid();
                }
            });*/
            
            function setInputFilter(textbox, inputFilter) {
              ["input", "keydown", "keyup", "mousedown", "mouseup", "select", "contextmenu", "drop"].forEach(function(event) {
                textbox.addEventListener(event, function() {
                  if (inputFilter(this.value)) {
                    this.oldValue = this.value;
                    this.oldSelectionStart = this.selectionStart;
                    this.oldSelectionEnd = this.selectionEnd;
                  } else if (this.hasOwnProperty("oldValue")) {
                    this.value = this.oldValue;
                    this.setSelectionRange(this.oldSelectionStart, this.oldSelectionEnd);
                  } else {
                    this.value = "";
                  }
                });
              });
            }
            ```
        executeWhenPageLoads: document.getElementById("P122_COD_PROVEEDOR").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-proveedores (
        name: Carga de Proveedores
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_PROVEEDOR,
                       ID_PERSONA,
                       PLAZO,
                       ESTADO,
                       ID_MONEDA,
                       EXENTO,
                       COD_CUENTA_CONTABLE,
                       DIRECTO,
                       CASUAL,
                       ID_CUENTA,
                       ID_SECTOR,
                       COD_USUARIO_AUD,
                       ID_CONDICION_COMPRA,
                       IND_RET_IVA,
                       ID_CUENTA_CONTABLE,
                       CUENTAS_BANCARIAS,
                       ID_PER_JURIDICA,
                       NRO_CUENTA,
                       COD_PROVEEDOR_REF,
                       IND_REPLICA,
                       ID_BENEFICIARIO,
                       ID_REPRESENTANTE_LEGAL,
                       ID_CLASE_PROVEEDOR,
                       IND_EXTERIOR,
                       CONST_NO_RETEN,
                       FEC_FIN_RETEN,
                       REF_CONST_NO_RETEN,
                       ID_TIPO_ENTREGA,
                       ID_TIPO_ENTREGA_PELIGROSO,
                       LIMITE_CREDITO,
                       TIPO_CAMBIO,
                       IND_PERMITIR_VISUALIZAR
                  from CMW_PROVEEDORES
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

