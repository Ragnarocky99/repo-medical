            region: @carga-de-proveedores
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @carga-de-proveedores
            column: COD_PROVEEDOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select max(to_number(nvl(cod_proveedor,0))) + 1
                from cmw_proveedores
                ```
        }
    )

