page 462 (
    name: Carga de Planilla de Vacaciones
    alias: CARGA-DE-PLANILLA-DE-VACACIONES
    title: Carga de Planilla de Vacaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 78%
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P462_DESC_EMPLEADO").readOnly = true;
            document.getElementById("P462_DIAS_UTILIZADOS").readOnly = true;
            //document.getElementById("P462_ANTIG_ANIO").readOnly = true;
            //document.getElementById("P462_DIAS_PERIODO_ANTERIOR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: BOTONES
        type: staticContent
        layout {
            sequence: 170
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region carga-de-planilla-de-vacaciones (
        name: Carga de Planilla de Vacaciones
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT VC.ID,
                       VC.ID_EMPRESA,
                       VC.ID_EMPLEADO,
                       VC.DESC_EMPLEADO,
                       VC.PERIODO,
                       VC.FEC_INICIAL,
                       VC.FEC_FINAL,
                       VC.DIAS,
                       VC.FEC_REINTEGRO,
                       VC.FEC_NOTIFICACION,
                       VC.OBSERVACION,
                       VC.DIAS_DISPONIBLES,
                       VC.DIAS_UTILIZADOS,
                       VC.DIAS_ACUMULADOS,
                       VC.MONTO_LEGAL,
                       VC.ID_USUARIO,
                       VC.ID_USUARIO_MOD,
                       VC.FEC_MODIF,
                       VC.IND_PAGO_ANTICIPADO,
                       VC.MONTO,
                       VC.FEC_PAGO,
                       VC.IND_UTILIZADO,
                       VC.COD_USUARIO_AUD,
                       VC.ID_SUCURSAL
                
                FROM RHW_VACACIONES VC
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region dias-vacaciones (
        name: DIAS VACACIONES
        type: staticContent
        layout {
            sequence: 110
            parentRegion: @carga-de-planilla-de-vacaciones
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
