    dynamicAction validar-dias (
        name: VALIDAR_DIAS
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: [
                P462_ID_EMPLEADO
                P462_PERIODO
            ]
        }

        action acumulados (
            name: ACUMULADOS
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    	vdias               number(8);
                    	vcant               number(8);
                    	vperiodo_ant_aux    varchar2(8);
                    	vperiodo_ant        varchar2(8);--date :=  add_months(:RHW_VACACIONES.fec_inicial, -12) ;	
                    	vdias_ant           number(8);
                        vdias_disp          number(8);
                    
                    BEGIN
                        IF :P462_PERIODO IS NOT NULL AND :P462_ID_EMPLEADO IS NOT NULL THEN
                        	if :P462_ANTIG_ANIO > 1 then
                        		    begin
                            			select to_char(to_number(substr(:P462_PERIODO,1,4) )-1)
                            			  into vperiodo_ant_aux	
                            			from dual;	 
                        			    vperiodo_ant	:= vperiodo_ant_aux||'/'||to_char(to_number(vperiodo_ant_aux)+1);
                        			 --		mensaje('Periodo anterior '||vperiodo_ant);
                        			exception
                        			 	when others then
                        			 		null;
                        			end;
                        			begin 
                        	  	        select  sum(nvl(v.dias_acumulados,0)) -  sum(nvl(v.dias_utilizados,0))
                        	  	            into vdias_ant
                        				from RHW_VACACIONES v
                        				where v.ID_EMPRESA 	= :P0_ID_EMPRESA
                        				  and v.ID_EMPLEADO = :P462_ID_EMPLEADO
                        				  and v.PERIODO		= vperiodo_ant--:RHW_VACACIONES.periodo--to_char(vperiodo_ant, 'yyyy')||'/'||to_char(:RHW_VACACIONES.fec_inicial, 'yyyy')
                        				  ;
                        			exception
                        			  	when no_data_found then
                            			  	RAISE_APPLICATION_ERROR(-20000, 'Error al consultar las vacaciones ant');
                            			  	vdias_ant := 0;
                        			  	when others then
                        			  	    RAISE_APPLICATION_ERROR(-20000, 'Error al consultar las vacaciones ant. '||sqlerrm);
                        			end;
                        	else			
                        		vdias_ant := 0;
                        	end if;
                        	 
                        	begin 
                        		select  sum(nvl(v.dias_acumulados,0)) -  sum(nvl(v.dias_utilizados,0))
                        	  	  into vdias
                        	    from RHW_VACACIONES v
                        	    where v.ID_EMPRESA 	= :P0_ID_EMPRESA
                        		  and v.ID_EMPLEADO	= :P462_ID_EMPLEADO
                        		  and v.periodo		= :P462_PERIODO;-- to_char(vperiodo_ant, 'yyyy')||'/'||to_char(:RHW_VACACIONES.fec_inicial, 'yyyy');
                        	exception
                        	  	when no_data_found then
                        	        RAISE_APPLICATION_ERROR(-20000,'Error al consultar las vacaciones');
                        	  --	 vdias := 0;
                        	  	    vdias	:= null;
                        	  	when others then
                        	  	    RAISE_APPLICATION_ERROR(-20000,'Error al consultar las vacaciones'||sqlerrm);
                        	  	    vdias	:= null;
                        	end;
                        	  
                        	  if nvl(vdias,0) != 0 then
                        	  	vdias_ant	:= 0;
                        	  end if;
                        	  
                        	if vdias is null then
                        	    if :P462_ANTIG_ANIO < 6 then
                        	    	vcant := 12;
                        	    elsif :P462_ANTIG_ANIO between 6 and 9 then
                        		    vcant := 18;
                        		    elsif :P462_ANTIG_ANIO > 9 then
                        			    vcant := 30;
                        		    end if;
                        	end if;
                            if :P462_DIAS_UTILIZADOS = 0 or :P462_DIAS_UTILIZADOS is null then
                                SELECT SUM(NVL(V.DIAS_DISPONIBLES,0))
                                  INTO vdias_disp
                                FROM RHW_VACACIONES V
                                WHERE V.PERIODO = :P462_PERIODO
                                  AND V.ID_EMPLEADO = :P462_ID_EMPLEADO
                                  AND V.ID_EMPRESA = :P0_ID_EMPRESA;
                                  :P462_DIAS_DISPONIBLES := vdias_disp;
                            end if;
                        	  :P462_DIAS_PERIODO_ANTERIOR := nvl(vdias_ant,0);
                        	  :P462_DIAS_ACUMULADOS := nvl(vdias_ant, 0) + nvl(vcant,0 ) + nvl(vdias,0);
                    
                        ELSE
                            NULL;
                        END IF;
                    end;
                    ```
                itemsToSubmit: [
                    P462_ANTIG_ANIO
                    P0_ID_EMPRESA
                    P462_PERIODO
                    P462_ID_EMPLEADO
                ]
                itemsToReturn: [
                    P462_DIAS_ACUMULADOS
                    P462_DIAS_PERIODO_ANTERIOR
                    P462_DIAS_DISPONIBLES
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action disponibles (
            name: DISPONIBLES
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare vdias number;
                    begin
                    
                    			vdias :=  :rh_vacaciones.dias_acumulados -  :rh_vacaciones.dias_utilizados;
                    			if vdias < 0 then
                    				mensaje('Los dias utilizados no pueden ser mayores a los acumulados por el empleado');
                    				raise form_trigger_failure;
                    			end if;
                    			
                    				:rh_vacaciones.dias_disponibles := vdias;
                    end;
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction validar-fec-fin (
        name: VALIDAR_FEC_FIN
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @calcular
        }
        clientSideCondition {
            type: itemIsNull
            item: P462_FEC_FINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      dias  number(8):= 0;
                      cantidad number(8):=0;
                      ES_FERIADO VARCHAR2(1);
                    begin
                      dias := TO_DATE(:P462_FEC_FINAL,'DD/MM/YYYY') - TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY') + 1;
                      :P462_DIAS_UTILIZADOS := 0;---
                      for i in 1..dias LOOP   -- CONTABILIZA LUNES A VIERNES
                       if rtrim(ltrim(to_char(TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY')+nvl(cantidad,0),'DAY'))) NOT IN ('DOMINGO','SÁBADO') THEN
                       BEGIN
                        SELECT 'S'
                          INTO ES_FERIADO
                        FROM FERIADOS
                        WHERE FERIADO = TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY') + nvl(cantidad,0);
                       EXCEPTION
                        WHEN OTHERS THEN
                         ES_FERIADO := 'N';
                       END;
                       IF NVL(ES_FERIADO,'N') = 'N' THEN
                        :P462_DIAS_UTILIZADOS := NVL(:P462_DIAS_UTILIZADOS,0) + 1;
                        :P462_DIAS  := :P462_DIAS_UTILIZADOS;
                        
                       END IF;
                       END IF;
                       Cantidad := nvl(cantidad,0) + 1;
                    END LOOP;
                    if :P462_FEC_INICIAL is not null then
                      declare
                              vsueldo number(20);
                              vdia    varchar2(1) ;
                              vlunes  varchar2(1) ;
                              vexiste varchar2(1) ;
                              vfrec   varchar2(1) ;
                              vunimonto varchar2(1);
                      begin
                          select to_char( TO_DATE('03/01/2000','dd/mm/yyyy'),'D') into vlunes from dual;
                          select to_char( TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY'),'D') into vdia from dual ;
                          vexiste := 'S' ;
                          if vdia = vlunes then
                              begin
                               select 'S' into vexiste
                                 from feriados where feriado = :P462_FEC_INICIAL ;
                              exception
                                  when others then vexiste := 'N';
                              end ;
                              if vexiste = 'S' then
                                  RAISE_APPLICATION_ERROR(-20000,'El dia  ' || TO_CHAR(:P462_FEC_INICIAL,'DD/MM/YYYY') || ' es feriado.' ) ;
                              end if ;  
                              vexiste := 'S';
                          else  
                             vexiste := 'N';
                             if vdia = to_char(to_number(vlunes)+1) then
                                begin
                                  select 'S' into vexiste
                                    from feriados where feriado = TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY') - 1;
                                exception
                                    when others then vexiste := 'N' ;
                                end ;
                             end if ;   
                          end if ;   
                          if vexiste = 'N' then 
                            RAISE_APPLICATION_ERROR(-20000, 'Las vacaciones deben iniciar el lunes ') ;
                          end if ;   
                          :P462_FEC_REINTEGRO    := calcular_fecha_final(TO_DATE(:P462_FEC_FINAL,'DD/MM/YYYY') + 1,1);    
                          begin
                            select 'S' into vexiste
                              from feriados where feriado = :P462_FEC_NOTIFICACION ;
                          exception
                             when others then vexiste := 'N' ;
                          end ; 
                          if vexiste = 'S' then
                             :P462_FEC_NOTIFICACION := TO_DATE(:P462_FEC_NOTIFICACION,'DD/MM/YYYY') + 1 ;
                          end if ;   
                          begin
                            select E.SUELDO_FINAL,T.COD_TIP_EMPLEADO
                                      into vsueldo, vfrec
                                    from RHW_EMPLEADOS E, RHW_TIPO_EMPLEADO T
                                    where E.ID_EMPRESA = :P0_ID_EMPRESA
                                      and E.ID = :P462_ID_EMPLEADO
                                      and T.ID = E.ID_TIP_EMPLEADO;
                          exception
                               when others then
                                    RAISE_APPLICATION_ERROR(-20000,'Error en la  Tabla de Personas. ');
                          end;
                          begin
                               select unidad_monto
                                  into vunimonto
                                  from RHW_EMPLEADOS
                               where ID_EMPRESA = :P0_ID_EMPRESA
                                     and ID = :P462_ID_EMPLEADO
                                     and ACTIVO ='A';
                          exception
                               when others then
                                    null;--RAISE_APPLICATION_ERROR(-20000,'No tiene sueldo definido \\FEC_FIN. ');
                          end;
                          if vfrec in ('S','J','O') then
                            if vunimonto = 'H' then
                              :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) * w_busca_parametro('RH','RH_CANT_HORAS')) * :P462_DIAS_UTILIZADOS);
                            else          
                             :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) / w_busca_parametro('RH','RH_JORNAL_MES')) * :P462_DIAS_UTILIZADOS);
                            end if;
                          else
                             :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) / 30) * :P462_DIAS_UTILIZADOS);        
                          end if;
                      end;
                    end if;
                    END;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P462_FEC_FINAL
                    P462_FEC_INICIAL
                    P462_DIAS_UTILIZADOS
                    P462_FEC_NOTIFICACION
                    P462_ID_EMPLEADO
                ]
                itemsToReturn: [
                    P462_FEC_REINTEGRO
                    P462_DIAS_UTILIZADOS
                    P462_FEC_NOTIFICACION
                    P462_MONTO_LEGAL
                    P462_DIAS
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction validar-fec-fin-2 (
        name: VALIDAR_FEC_FIN_2
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P462_DIAS
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      dias  number(8):= 0;
                      cantidad number(8):=0;
                      ES_FERIADO VARCHAR2(1);
                    begin
                      dias := TO_DATE(:P462_FEC_FINAL,'DD/MM/YYYY') - TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY') + 1;
                      :P462_DIAS_UTILIZADOS := 0;---
                      for i in 1..dias LOOP   -- CONTABILIZA LUNES A VIERNES
                       if rtrim(ltrim(to_char(TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY')+nvl(cantidad,0),'DAY'))) NOT IN ('DOMINGO','SÁBADO') THEN
                       BEGIN
                        SELECT 'S'
                          INTO ES_FERIADO
                        FROM BSW_FERIADOS
                        WHERE FERIADO = TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY') + nvl(cantidad,0);
                       EXCEPTION
                        WHEN OTHERS THEN
                         ES_FERIADO := 'N';
                       END;
                       IF NVL(ES_FERIADO,'N') = 'N' THEN
                        :P462_DIAS_UTILIZADOS := NVL(:P462_DIAS_UTILIZADOS,0) + 1;
                        :P462_DIAS  := :P462_DIAS_UTILIZADOS;
                        
                       END IF;
                       END IF;
                       Cantidad := nvl(cantidad,0) + 1;
                    END LOOP;
                    if :P462_FEC_INICIAL is not null then
                      declare
                              vsueldo number(20);
                              vdia    varchar2(1) ;
                              vlunes  varchar2(1) ;
                              vexiste varchar2(1) ;
                              vfrec   varchar2(1) ;
                              vunimonto varchar2(1);
                      begin
                          select to_char( TO_DATE('03/01/2000','dd/mm/yyyy'),'D') into vlunes from dual;
                          select to_char( TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY'),'D') into vdia from dual ;
                          vexiste := 'S' ;
                          if vdia = vlunes then
                              begin
                               select 'S' into vexiste
                                 from bsw_feriados where feriado = :P462_FEC_INICIAL ;
                              exception
                                  when others then vexiste := 'N';
                              end ;
                              if vexiste = 'S' then
                                  RAISE_APPLICATION_ERROR(-20000,'El dia  ' || TO_CHAR(:P462_FEC_INICIAL,'DD/MM/YYYY') || ' es feriado.' ) ;
                              end if ;  
                              vexiste := 'S';
                          else  
                             vexiste := 'N';
                             if vdia = to_char(to_number(vlunes)+1) then
                                begin
                                  select 'S' into vexiste
                                    from bsw_feriados where feriado = TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY') - 1;
                                exception
                                    when others then vexiste := 'N' ;
                                end ;
                             end if ;   
                          end if ;   
                          if vexiste = 'N' then 
                            RAISE_APPLICATION_ERROR(-20000, 'Las vacaciones deben iniciar el lunes ') ;
                          end if ;   
                          :P462_FEC_REINTEGRO    := calcular_fecha_final(TO_DATE(:P462_FEC_FINAL,'DD/MM/YYYY') + 1,1);    
                          begin
                            select 'S' into vexiste
                              from bsw_feriados where feriado = :P462_FEC_NOTIFICACION ;
                          exception
                             when others then vexiste := 'N' ;
                          end ; 
                          if vexiste = 'S' then
                             :P462_FEC_NOTIFICACION := TO_DATE(:P462_FEC_NOTIFICACION,'DD/MM/YYYY') + 1 ;
                          end if ;   
                          begin
                            select E.SUELDO_FINAL,T.COD_TIP_EMPLEADO
                                      into vsueldo, vfrec
                                    from RHW_EMPLEADOS E, RHW_TIPO_EMPLEADO T
                                    where E.ID_EMPRESA = :P0_ID_EMPRESA
                                      and E.ID = :P462_ID_EMPLEADO
                                      and T.ID = E.ID_TIP_EMPLEADO;
                          exception
                               when others then
                                    RAISE_APPLICATION_ERROR(-20000,'Error en la  Tabla de Personas. ');
                          end;
                          begin
                               select unidad_monto
                                  into vunimonto
                                  from RHW_SALARIOS 
                               where ID_EMPRESA = :P0_ID_EMPRESA
                                     and ID_EMPLEADO = :P462_ID_EMPLEADO
                                     and es_actual='A';
                          exception
                               when others then
                                    RAISE_APPLICATION_ERROR(-20000,'Error en la  Tabla de Sueldos. ');
                          end;
                          if vfrec in ('S','J','O') then
                            if vunimonto = 'H' then
                              :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) * w_busca_parametro('RH','RH_CANT_HORAS')) * :P462_DIAS_UTILIZADOS);
                            else          
                             :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) / w_busca_parametro('RH','RH_JORNAL_MES')) * :P462_DIAS_UTILIZADOS);
                            end if;
                          else
                             :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) / 30) * :P462_DIAS_UTILIZADOS);        
                          end if;
                      end;
                    end if;
                    END;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P462_FEC_FINAL
                    P462_FEC_INICIAL
                    P462_DIAS_UTILIZADOS
                    P462_FEC_NOTIFICACION
                    P462_ID_EMPLEADO
                ]
                itemsToReturn: [
                    P462_FEC_REINTEGRO
                    P462_DIAS_UTILIZADOS
                    P462_FEC_NOTIFICACION
                    P462_MONTO_LEGAL
                    P462_DIAS
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction validar-fec-ini (
        name: VALIDAR_FEC_INI
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @calcular
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        vsueldo        number(20);
                        vdia           varchar2(1);
                        vlunes         varchar2(1);
                        vexiste        varchar2(1);
                        vfrec          varchar2(1);
                        vunimonto      varchar2(1);
                        vreintegro_var date;
                        vfecini        date := TO_DATE(:P462_FEC_INICIAL,'DD/MM/YYYY');
                        vfecfin        date := TO_DATE(:P462_FEC_FINAL,'DD/MM/YYYY');
                        vfecnotif      date := TO_DATE(:P462_FEC_NOTIFICACION,'DD/MM/YYYY');
                    begin
                        select to_char( to_date('03/01/2000','dd/mm/yyyy'),'D') into vlunes from dual;
                        select to_char( vfecini,'D') into vdia from dual;
                        :P462_DIAS := 0;
                        vexiste := 'S' ;
                        if vdia = vlunes then
                            begin
                           select 'S' into vexiste
                             from feriados where feriado = vfecini ;
                          exception
                              when others then vexiste := 'N' ;
                          end ;
                          if vexiste = 'S' then
                              RAISE_APPLICATION_ERROR(-20000, 'El dia  ' || to_char( vfecini,'DD/MM/YYYY') || ' es feriado.' );
                          end if ;  
                            vexiste := 'S' ;
                        else  
                         vexiste := 'N' ;
                           if vdia = to_char(to_number(vlunes)+1) then
                            begin
                                select 'S' into vexiste
                                  from feriados where to_char(feriado) = vfecini - 1;
                              exception
                                  when others then vexiste := 'N' ;
                              end;
                           end if;   
                        end if;   
                        if vexiste = 'N' then 
                        raise_application_error(-20000, 'Las vacaciones deben iniciar el lunes ') ;
                        end if;
                        IF :P462_FEC_FINAL IS NULL THEN
                            :P462_FEC_FINAL        := calcular_fecha_final(vfecini,:P462_DIAS_ACUMULADOS);
                              vreintegro_var         := TO_DATE(:P462_FEC_FINAL,'DD/MM/YYYY') + 1;
                            :P462_FEC_REINTEGRO    := calcular_fecha_final(vreintegro_var,1);  
                            :P462_FEC_NOTIFICACION := vfecini - 15 ;
                             IF  upper(RTRIM(LTRIM(TO_CHAR(vfecnotif, 'day')))) = 'DOMINGO' THEN
                              :P462_FEC_NOTIFICACION := vfecnotif - 2;
                             END IF;
                             IF  upper(RTRIM(LTRIM(TO_CHAR(vfecnotif, 'day')))) = 'SABADO' THEN
                              :P462_FEC_NOTIFICACION := vfecnotif - 1;
                             END IF;
                         DECLARE
                          EXISTE VARCHAR2(1);
                         BEGIN
                          SELECT 'S'
                             INTO EXISTE
                          FROM FERIADOS
                          WHERE  FERIADO = vfecnotif;
                          EXCEPTION
                            WHEN OTHERS THEN
                                EXISTE := 'N';
                          IF EXISTE = 'S' THEN
                              :P462_FEC_NOTIFICACION := vfecnotif - 1;
                          END IF;
                          END;
                        END IF;     
                        begin
                          select 'S' into vexiste from feriados where feriado = vfecnotif;
                        exception
                           when others then vexiste := 'N' ;
                        end ; 
                        if vexiste = 'S' then
                           :P462_FEC_NOTIFICACION := vfecnotif + 1;
                        end if ;   
                        begin
                             select E.SUELDO_FINAL,T.COD_TIP_EMPLEADO into vsueldo, vfrec
                             from RHW_EMPLEADOS E, RHW_TIPO_EMPLEADO T
                             where E.ID_EMPRESA = :P0_ID_EMPRESA
                                  and E.ID = :P462_ID_EMPLEADO
                                  and T.ID = E.ID_TIP_EMPLEADO;
                        exception
                             when others then
                                  RAISE_APPLICATION_ERROR(-20000,'Error en la  Tabla de Empleados. ');
                        end;
                          begin
                             select UNIDAD_MONTO
                              into vunimonto
                              from RHW_EMPLEADOS 
                           where ID_EMPRESA = :P0_ID_EMPRESA
                                 and ID = :P462_ID_EMPLEADO
                                 and ACTIVO = 'A';
                        exception
                             when others then
                                  null;--RAISE_APPLICATION_ERROR(-20000,'No tiene sueldo definido \\INI. ');
                        end;
                        if vfrec in ('S','J','O') then
                          if vunimonto = 'H' then
                            :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) * w_busca_parametro('RH','RH_CANT_HORAS')) * :P462_DIAS_UTILIZADOS);
                          else          
                           :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) / w_busca_parametro('RH','RH_JORNAL_MES')) * :P462_DIAS_UTILIZADOS);
                          end if;
                        else
                           :P462_MONTO_LEGAL := round (( nvl(vsueldo, 0) / 30) * :P462_DIAS_UTILIZADOS);        
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P462_FEC_INICIAL
                    P462_FEC_FINAL
                    P462_DIAS_ACUMULADOS
                    P462_FEC_REINTEGRO
                    P462_FEC_NOTIFICACION
                    P462_ID_EMPLEADO
                    P462_DIAS_UTILIZADOS
                ]
                itemsToReturn: [
                    P462_FEC_REINTEGRO
                    P462_FEC_NOTIFICACION
                    P462_FEC_FINAL
                    P462_MONTO_LEGAL
                    P462_DIAS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P462_FEC_INICIAL
            }
            comments {
                comments: Campo minado de fechas. Cuidao ahí.
            }
        )

    )

    computation p462-desc-empleado (
        itemName: P462_DESC_EMPLEADO
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT PE.NOMBRE
                FROM BSW_PERSONAS PE, RHW_EMPLEADOS EM
                WHERE EM.ID = :P462_ID_EMPLEADO
                  AND EM.ID_PERSONA = PE.ID
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P462_ID
        }
    )

