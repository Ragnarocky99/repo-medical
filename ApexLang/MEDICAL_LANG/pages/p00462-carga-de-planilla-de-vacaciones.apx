    dynamicAction autocompleta-fec-fin (
        name: AUTOCOMPLETA_FEC_FIN
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P462_FEC_FINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P462_FEC_FINAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P462_FEC_FINAL,'/','');
                            conv_fecha := substr(:P462_FEC_FINAL,1,2)||'/'||
                                                      substr(:P462_FEC_FINAL,3,2)||'/'||
                                                      lpad(substr(:P462_FEC_FINAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P462_FEC_FINAL := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P462_FEC_FINAL := conv_fecha;
                            ELSIF (length(:P462_FEC_FINAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P462_FEC_FINAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P462_FEC_FINAL
                itemsToReturn: P462_FEC_FINAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

