            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="#ACTIVO_ICON#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
