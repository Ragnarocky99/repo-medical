page 101 (
    name: Cuentas Bancarias
    alias: CUENTAS-BANCARIAS
    title: Cuentas Bancarias
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cuentas-bancarias (
        name: Cuentas Bancarias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CB.ID,
                       CB.ID_EMPRESA,
                       CB.ID_PER_JURIDICA,
                       CB.NRO_CUENTA,
                       CB.ID_TIP_CUENTA,
                       CB.ID_MONEDA,
                       CB.ACTIVO,
                       CASE
                       WHEN CB.ACTIVO ='S' THEN 'fa fa-check u-success-text'
                       WHEN CB.ACTIVO ='N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON,
                       CB.REFERENCIA,
                       CB.NRO_IMPRESION,
                       CB.NRO_CUENTA_REL,
                       CB.ID_CUENTA,
                       CB.ID_CUENTA_DIF,
                       CB.COD_USUARIO_AUD,
                       CB.ID_PLANTILLA,
                       CB.IND_CAJA_INTERNA,
                       CB.LIMITE_CAJA_CH,
                       CB.ID_CUENTA_PAS,
                       CB.ID_SUCURSAL,
                       CB.COD_EMPRESA_OSIRIS,
                       CB.ID_CAJA,
                       CB.ID_BANCO_REF,
                       CB.COD_TIP_CUENTA,
                       CB.FEC_SALDO_INI,
                       SUC.COD_SUCURSAL,
                       P.COD_PERSONA,
                       P.NOMBRE,
                       MON.COD_MONEDA,
                       CASE
                       WHEN CB.IND_AFECTA_FLUJO ='S' THEN 'fa fa-check u-success-text'
                       WHEN CB.IND_AFECTA_FLUJO ='N' THEN 'fa fa-remove u-danger-text'
                       END FLUJO_ICON,
                       IND_AFECTA_FLUJO
                       
                  from CCW_CUENTAS_BANCARIAS CB, BSW_PERSONAS P, BSW_SUCURSALES SUC, 
                       BSW_MONEDAS MON
                       
                 where CB.ID_EMPRESA = :P0_COD_EMPRESA
                   and CB.ID_SUCURSAL = SUC.ID (+)
                   and CB.ID_PER_JURIDICA = P.ID (+)
                   and CB.ID_MONEDA = MON.ID (+)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 102
                items: {
                    P102_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 13338404193539078
        }

