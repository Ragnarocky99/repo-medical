    computation p274-m-cod-cuenta-fin (
        itemName: P274_M_COD_CUENTA_FIN
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NOMBRE_CUENTA FROM COW_PLAN_CUENTAS
                WHERE COD_CUENTA = :P274_MAYOR_COD_CUENTA_INI
                ```
        }
    )

    computation p274-mayor-saldo-anterior (
        itemName: P274_MAYOR_SALDO_ANTERIOR
        execution {
            sequence: 20
            point: beforeHeader
        }
        computation {
            sqlQuery:
                ```sql
                SELECT 
                
                    NVL(SUM(CASE PC.TIPO_CUENTA
                             WHEN 'A' THEN NVL(DD.MON_DEBE,0)    -   NVL(DD.MON_HABER,0)
                             WHEN 'H' THEN NVL(DD.MON_HABER,0)   -   NVL(DD.MON_DEBE,0)
                             WHEN 'P' THEN NVL(DD.MON_HABER,0)   -   NVL(DD.MON_DEBE,0)
                             WHEN 'D' THEN NVL(DD.MON_DEBE,0)    -   NVL(DD.MON_HABER,0)
                            END),0) SALDO_ANT
                    
                       
                from cow_diario_detalles_prov dd, 
                     cow_plan_cuentas         pc, 
                     cow_ejercicios           ej, 
                     bsw_empresas             emp
                       
                       
                where emp.id                 =  :P0_COD_EMPRESA
                        and ej.cod_ejercicio =  :P0_COD_EJERCICIO
                        and dd.id_empresa    =  emp.id
                        and dd.id_ejercicio  =  ej.id
                        and pc.cod_cuenta    =  :P250_MAYOR_COD_CUENTA_INI
                        and dd.id_plan_cuenta=  pc.id
                        and dd.fec_asiento   < :P250_MAYOR_FEC_INI
                        --and dd.id            <=  dd.id
                
                
                ```
        }
    )

    branch (
        name: Go To Page 285
