            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P274_MAYOR_FEC_INI").readOnly = true;
            document.getElementById("P274_MAYOR_FEC_FIN").readOnly = true;
            document.getElementById("P274_MAYOR_COD_CUENTA_INI").readOnly = true;
            document.getElementById("P274_M_COD_CUENTA_FIN").readOnly = true;
            document.getElementById("P274_MAYOR_SALDO_ANTERIOR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            .readonly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
