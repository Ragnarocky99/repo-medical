page 668 (
    name: Resumen de Notas de Envío
    alias: RESUMEN-DE-NOTAS-DE-ENVÍO
    title: Resumen de Notas de Envío
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region resumen-de-notas-de-envío (
        name: Resumen de Notas de Envío
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.TIP_ENVIO,
                       D.ID_NRO_ENVIO_CAB,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.CANTIDAD AS CANTIDAD_COPIA,
                       D.IND_RECEPCION,
                       case D.IND_RECEPCION
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END as FUE_RECEPCIONADO,
                       D.SER_ENVIO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.ID_LOTE,
                       D.CANT_FAC,
                       D.DESC_ARTICULO,
                       D.ID_BARRA,
                       A.Cod_Origen_Art as Cod_Fabricante,
                       (select M.Descripcion from stw_marcas M where A.Id_Marca = M.Id) as Marca,
                       E.Descripcion as Presentacion,
                       L.Fec_Vencimiento,
                       C.ID_SUCURSAL,
                       C.ID_SUCURSAL_ENT,
                       C.NRO_ENVIO,
                       L.Nro_lote as num_lote,
                       c.fecha
                  from STW_NOTAS_ENVIO_DET D,
                       STW_ARTICULOS A,
                        STW_ENVASES E,
                         STW_LOTES L,
                       stw_notas_envio_cab C
                 where D.id_nro_envio_cab=c.id
                 AND A.ID = D.ID_ARTICULO
                 and A.Id_Envase = E.ID
                 and D.ID_LOTE = L.ID
                order by C.nro_envio
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 87783057648790570
        }

