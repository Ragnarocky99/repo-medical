page 831 (
    name: Anulacion de Cheques Emitidos
    alias: ANULACION-DE-CHEQUES-EMITIDOS
    title: Anulacion de Cheques Emitidos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cheques (
        name: Cheques
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT VC.ID_SUB_TIPO_TRANS,
                       VC.ID_BANCO,
                       VC.SER_VALOR,
                       VC.NUM_VALOR,
                       VC.FEC_EMISION,
                       VC.FEC_VENCIMIENTO,
                       VC.BENEFICIARIO,
                       VC.ID_MONEDA_PAGO,
                       VC.TIP_CAMBIO,
                       VC.TOT_VALOR,
                       VC.IMPORTE_CAMBIO,
                       VC.ANULADO,
                       VC.ID_TALON_CHE,
                       VC.ID,
                       VC.ID_EMPRESA
                  FROM CPW_VALORES_CAJAS      VC
                  JOIN BSW_SUBTIPOS_TRANS     ST ON ST.ID = VC.ID_SUB_TIPO_TRANS
                  JOIN CCW_TALONARIOS_CHEQUES TC ON TC.ID = VC.ID_TALON_CHE
                 WHERE ST.TIP_DOCUMENTO = 'CHE'
                   AND TRUNC(VC.FEC_VENCIMIENTO) BETWEEN :P831_FEC_INI AND :P831_FEC_FIN
                   --AND VC.ID_CAB_CAJAS IS NULL
                  -- AND VC.ID_DEBCRED IS NULL
                ```
            pageItemsToSubmit: [
                P831_FEC_INI
                P831_FEC_FIN
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 75901554655744221
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID_SUB_TIPO_TRANS
                layout {
                    width: 116
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_BANCO
                layout {
                    width: 173
                    sequence: 4
                }
            )

            displayColumn (
                column: @SER_VALOR
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @NUM_VALOR
                layout {
                    width: 87.75
                    sequence: 6
                }
            )

            displayColumn (
                column: @FEC_EMISION
                layout {
                    width: 87.75
                    sequence: 7
                }
            )

            displayColumn (
                column: @FEC_VENCIMIENTO
                layout {
                    width: 93.1875
                    sequence: 8
                }
            )

            displayColumn (
                column: @BENEFICIARIO
                layout {
                    width: 154.75
                    sequence: 9
                }
            )

            displayColumn (
                column: @ID_MONEDA_PAGO
                layout {
                    width: 111.75
                    sequence: 10
                }
            )

            displayColumn (
                column: @TIP_CAMBIO
                layout {
                    width: 59.6953
                    sequence: 11
                }
            )

            displayColumn (
                column: @TOT_VALOR
                layout {
                    width: 133.6953
                    sequence: 12
                }
            )

            displayColumn (
                column: @IMPORTE_CAMBIO
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @ID_TALON_CHE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ANULADO
                layout {
                    width: 61
                    sequence: 13
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 16
                }
            )

            filter (
                column: @NUM_VALOR
                operator: contains
                value: 622498
                advanced {
                    enabled: false
                }
            )

        )

        column ANULADO (
            type: checkbox
            heading {
                heading: <p>Anulado</p>
                alignment: center
            }
            settings {
                useDefaults: false
                checkedValue: S
                uncheckedValue: N
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            source {
                databaseColumn: ANULADO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: S
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        column BENEFICIARIO (
            type: textarea
            heading {
                heading: <p>Beneficiario</p>
                alignment: center
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
                maxLength: 70
            }
            source {
                databaseColumn: BENEFICIARIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column FEC_EMISION (
            type: datePicker
            heading {
                heading: <p>Emision</p>
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: FEC_EMISION
                dataType: date
            }
        )

        column FEC_VENCIMIENTO (
            type: datePicker
            heading {
                heading: <p>Vencimiento</p>
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: FEC_VENCIMIENTO
                dataType: date
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 160
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_BANCO (
            type: selectList
            heading {
                heading: <p>Banco</p>
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lv-bancos
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_BANCO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            advanced {
                htmlDomId: ID_BANCO
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 170
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_MONEDA_PAGO (
            type: popupLov
            heading {
                heading: <p>Moneda</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-monedas
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                databaseColumn: ID_MONEDA_PAGO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_SUB_TIPO_TRANS (
            type: selectList
            heading {
                heading: <p>Subtipo</p>
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ST.DESCRIPCION, ST.ID
                      FROM BSW_SUBTIPOS_TRANS ST
                      JOIN BSW_TIPOS_TRANS    TT ON TT.ID = ST.ID_TIPO_TRANS
                     WHERE TIP_DOCUMENTO = 'CHE'
                       AND TT.TIPO_TRANS = W_BUSCA_PARAMETRO('CP', 'COD_TRAN_PA')
                    ```
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_SUB_TIPO_TRANS
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_TALON_CHE (
            type: popupLov
            heading {
                heading: <p>Serie</p>
                alignment: center
            }
            settings {
                displayAs: modalDialog
                additionalOutputs: SER_COMPROBANTE:SER_VALOR,ID_BANCO:ID_BANCO
            }
            lov {
                type: sharedComponent
                lov: @lv-talonarios-cheque-todos
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_TALON_CHE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IMPORTE_CAMBIO (
            type: hidden
            layout {
                sequence: 130
            }
            source {
                databaseColumn: IMPORTE_CAMBIO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NUM_VALOR (
            type: textField
            heading {
                heading: <p>Numero</p>
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: NUM_VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column SER_VALOR (
            type: textField
            heading {
                heading: Ser Valor
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 7
            }
            source {
                databaseColumn: SER_VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            advanced {
                htmlDomId: SER_VALOR
            }
        )

        column TIP_CAMBIO (
            type: numberField
            heading {
                heading: <p>Cambio</p>
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                databaseColumn: TIP_CAMBIO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TOT_VALOR (
            type: numberField
            heading {
                heading: <p>Total Valor</p>
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: TOT_VALOR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheques
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @cheques
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    pageItem P831_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P831_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo Vencimiento:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    button refrescar (
        buttonName: REFRESCAR
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction busca-cambio (
        name: Busca Cambio
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @cheques
            columns: ID_MONEDA_PAGO
        }

        action tip-cambio (
            name: TIP_CAMBIO
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    FTIPOS_CAMBIO(P_COD_MONEDA => :ID_MONEDA_PAGO,
                                  P_FECHA      => :FEC_EMISION,
                                  P_TIPO       => 'N',
                                  P_CAMBIO     => 'V')
                    ```
                itemsToSubmit: [
                    ID_MONEDA_PAGO
                    FEC_EMISION
                ]
            }
            affectedElements {
                selectionType: columns
                columns: TIP_CAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cheques
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @cheques
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM CPW_VALORES_CAJAS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                   AND ID_TALON_CHE = :ID_TALON_CHE
                   AND NUM_VALOR = :NUM_VALOR
                   AND ID != NVL(:ID, 0)
                ```
        }
        error {
            errorMessage: Ya existe el numero de cheque
            associatedColumn: NUM_VALOR
        }
    )

    process cheques-save-interactive-grid-data (
        name: Cheques - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @cheques
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 75903093352744236
        }
    )

    process valores-por-defecto (
        name: Valores por Defecto
        type: executeCode
        editableRegion: @cheques
        source {
            plsqlCode: :IMPORTE_CAMBIO := REPLACE(:TOT_VALOR, '.', '');
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 75903942255744245
        }
    )

)

