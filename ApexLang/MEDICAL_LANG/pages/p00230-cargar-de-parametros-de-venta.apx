        source {
            formRegion: @cargar-de-parametros-de-venta
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P230_ID_SECTOR (
        type: popupLov
        label {
            label: <p>Sector:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-sector-ventas
            nullDisplayValue: -- SIN SELECCIONAR --
        }
        layout {
            sequence: 30
            region: @cargar-de-parametros-de-venta
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @cargar-de-parametros-de-venta
            column: ID_SECTOR
            dataType: number
        }
    )

    pageItem P230_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Suc.:</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
        }
        layout {
            sequence: 50
            region: @cargar-de-parametros-de-venta
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 8
            columnSpan: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @cargar-de-parametros-de-venta
            column: ID_SUCURSAL
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P230_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P230_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P230_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button sector (
        buttonName: SECTOR
        label: Sector
        layout {
            sequence: 40
            region: @cargar-de-parametros-de-venta
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 42
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @sector
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P230_ID_SECTOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 46604402052291537
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-cargar-de-parametros-de-venta (
        name: Initialize form Cargar de Parametros de Venta
        type: formInitialization
        formRegion: @cargar-de-parametros-de-venta
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 46603606177291537
        }
    )

    process process-form-cargar-de-parametros-de-venta (
        name: Process form Cargar de Parametros de Venta
        type: formAutoRowProcessing
        formRegion: @cargar-de-parametros-de-venta
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 46604074477291537
        }
    )

)

