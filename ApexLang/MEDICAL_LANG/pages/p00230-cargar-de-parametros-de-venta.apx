page 230 (
    name: Cargar de Parametros de Venta
    alias: CARGAR-DE-PARAMETROS-DE-VENTA
    title: Cargar de Parametros de Venta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cargar-de-parametros-de-venta (
        name: Cargar de Parametros de Venta
        type: form
        source {
            location: localDatabase
            tableName: COW_PARAM_CONTABLES_VT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P230_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 170
            region: @cargar-de-parametros-de-venta
            slot: regionBody
        }
        source {
            formRegion: @cargar-de-parametros-de-venta
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P230_ID (
        type: hidden
        layout {
            sequence: 10
            region: @cargar-de-parametros-de-venta
            slot: regionBody
        }
        source {
            formRegion: @cargar-de-parametros-de-venta
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P230_ID_COMPROBANTE (
        type: hidden
        layout {
            sequence: 130
            region: @cargar-de-parametros-de-venta
            slot: regionBody
        }
        source {
            formRegion: @cargar-de-parametros-de-venta
            column: ID_COMPROBANTE
            dataType: number
        }
    )

    pageItem P230_ID_CONCEPTO_COMP (
        type: hidden
        layout {
            sequence: 180
            region: @cargar-de-parametros-de-venta
            slot: regionBody
        }
        source {
            formRegion: @cargar-de-parametros-de-venta
            column: ID_CONCEPTO_COMP
            dataType: number
        }
    )

    pageItem P230_ID_CUENTA_CRE (
