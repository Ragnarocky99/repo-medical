    dynamicAction json-detalle-onchange (
        name: JSON_DETALLE_ONCHANGE
        execution {
            sequence: 300
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: INTERES
        }

        action json (
            name: JSON
            action: plugin/getIgData
            settings {
                igRegionStaticId: Detalles
                itemToHoldData: P589_JSON_CUOTA
                includeColumns: ID_CUOTA_JSON,SALDO_JSON,NUM_ORDEN
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action lee-json (
            name: LEE_JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vJson     clob;
                        vBandera  number(1); /*valor de bandera 1 indica que calcula interés*/
                        vBanderaB number(1); /*representa el último valor de la bandera en caso que haya error*/
                        vActCuota number(10);
                    
                    BEGIN
                        vBanderaB := :P589_BANDERA_CUOTA;
                        vJson := :P589_JSON_CUOTA;
                        IF :P589_BANDERA_CUOTA <> 2 THEN
                            VALIDA_JSON_CUOTAS(p_json          => vJson,
                                               p_cuota_act     => vActCuota,
                                               p_bandera_cuota => vBandera);
                    
                            :P589_CUOTA_ACT := vActCuota;
                            
                            IF vBanderaB <> vBandera THEN
                                :P589_BANDERA_CUOTA := vBandera;
                            ELSE
                                :P589_BANDERA_CUOTA := vBanderaB;
                            END IF;
                        END IF;
                                    
                    END;
                    
                    ```
                itemsToSubmit: [
                    P589_JSON_CUOTA
                    P589_BANDERA_CUOTA
                ]
                itemsToReturn: [
                    P589_BANDERA_CUOTA
                    P589_CUOTA_ACT
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

