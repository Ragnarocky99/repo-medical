    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('VT','ID_MODULO_VT'),:P589_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha fuera de rango
            associatedItem: @P589_FEC_COMPROBANTE
        }
    )

    validation validar-lineas (
        name: Validar Lineas
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: :P589_CANTIDAD_DET<=:P589_LINEAS
        }
        error {
            errorMessage: El comprobante solo puede contener &P589_LINEAS. lineas !
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

