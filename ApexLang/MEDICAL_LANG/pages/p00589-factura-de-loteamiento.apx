    dynamicAction descuento-por-detalle (
        name: Descuento por Detalle
        execution {
            sequence: 90
            eventScope: dynamic
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detalles
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF :PORC_DESCUENTO IS NOT NULL AND NVL(:PORC_DESCUENTO,0)<>0 THEN 
                    :P589_DESCUENTO_V:=REPLACE(NVL(:PRECIO_UNITARIO_C_IVA,0),'.','')-REPLACE(NVL(:DESCUENTO_C_IVA,0),'.','');
                    ELSE 
                    :P589_DESCUENTO_V:='';
                    END IF;
                    EXCEPTION 
                    WHEN OTHERS THEN
                    NULL;
                    END;
                    ```
                itemsToSubmit: [
                    DESCUENTO_C_IVA
                    PORC_IVA
                    PRECIO_UNITARIO_C_IVA
                    PORC_DESCUENTO
                ]
                itemsToReturn: P589_DESCUENTO_V
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

