    computation p589-iva (
        itemName: P589_IVA_5
        execution {
            sequence: 80
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_COMPROBANTES_DETALLE
                    WHERE :P589_ID=ID_COMPROBANTE_CABECERA;
                    item_detalle VTW_COMPROBANTES_DETALLE%rowtype;
                    v_total_iva_5    VTW_COMPROBANTES_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P589_ID
        }
    )

    computation p589-iva-2 (
        itemName: P589_IVA_10
        execution {
            sequence: 90
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_COMPROBANTES_DETALLE
                    WHERE :P589_ID=ID_COMPROBANTE_CABECERA;
                    item_detalle VTW_COMPROBANTES_DETALLE%rowtype;
                    v_total_iva_10    VTW_COMPROBANTES_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_iva_10:=v_total_iva_10+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_10;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P589_ID
        }
    )

    computation p589-nro-comprobante (
        itemName: P589_NRO_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                    vNroComprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                    IF :P589_NRO_COMPROBANTE IS  NULL THEN
                        SELECT NVL(MAX(C.NRO_COMPROBANTE),0)+1
                           INTO vNroComprobante
                        FROM VTW_COMPROBANTES_CABECERA C
                        WHERE C.ID_EMPRESA      = :P0_COD_EMPRESA
                          AND C.SER_COMPROBANTE = :P589_SER_COMPROBANTE
                          AND C.TIP_COMPROBANTE = :P589_TIP_COMPROBANTE;
                        RETURN vNroComprobante;
                    END IF;
                EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                        vNroComprobante:=1;
                        RETURN vNroComprobante;
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
        comments {
