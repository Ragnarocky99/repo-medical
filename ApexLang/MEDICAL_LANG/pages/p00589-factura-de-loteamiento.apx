    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 110
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                        SELECT A.ID
                           INTO :ID_ARTICULO
                        FROM STW_ARTICULOS A
                        LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                        WHERE (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) 
                          AND A.ID_EMPRESA=:P0_COD_EMPRESA
                          AND ROWNUM=1
                          AND NVL(A.ESTADO,'N') = 'S'
                          AND NVL(A.IND_MANEJA_STOCK,'N') = 'N'
                          AND NVL(A.IND_MANEJA_LOTE,'N')  = 'N'
                          AND NVL(A.IND_INSUMO,'N')       = 'N'
                          AND NVL(A.IND_ALQUILERES,'N')   = 'S';
                        --AND NVL(A.IND_MODIFICA_PRECIO,'N') = 'N';
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.cod_articulo
                    INTO :cod_articulo
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: COD_ARTICULO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P589_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-montos (
        name: CALCULAR_MONTOS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
                PORC_DESCUENTO
            ]
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: PRECIO_UNITARIO_C_IVA
        }
        comments {
            comments: Aqui se van calculando los totales correspondientes  (Monto total con iva , monto total , total iva ,descuentos)
        }

        action descuento-c-iva (
            name: DESCUENTO_C_IVA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :PORC_DESCUENTO IS NULL THEN
                    :PORC_DESCUENTO:=0 ;
                    END IF;
                    
                    :DESCUENTO_C_IVA:=ROUND(REPLACE(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_DESCUENTO/100),NVL(:P589_DECIMALES,0));
                    
                    ```
                itemsToSubmit: [
                    PORC_DESCUENTO
                    PRECIO_UNITARIO_C_IVA
                    P589_DECIMALES
                ]
                itemsToReturn: DESCUENTO_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action gravadas-detalle (
            name: GRAVADAS DETALLE
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        pGravada    number(19,3);
                        pExenta     number(19,3);
                        pPrecio     number(19,3);
                        pTotalIva   number(19,3);
                        pModalidad  varchar2(20);
                    
                    BEGIN
                        
                        pPrecio     := REPLACE(:PRECIO_UNITARIO_C_IVA,'.','');
                        pTotalIVa   := REPLACE(:TOTAL_IVA,'.','');
                        pModalidad  := 'L';
                    
                        VTW_CALCULA_IVA_GRAVADAS(P_ID_EMPRESA    => :P0_ID_EMPRESA,
                                                 P_ID_IVA        => :ID_IVA,
                                                 P_MONTO         => pPrecio,
                                                 P_MONEDA        => :P589_ID_MONEDA,
                                                 P_IVA           => pTotalIVa,
                                                 P_GRAVADA       => pGravada,
                                                 P_EXENTA        => pExenta,
                                                 P_MODALIDAD     => pModalidad);
                    
                        pGravada    := ROUND(pGravada);
                        :MON_EXENTA := ROUND(pExenta);
                        :TOTAL_IVA  := pTotalIva;
                    
                        IF :ID_IVA = TRAE_ID_IVA('2') THEN
                    
                            :MON_GRAVADA_5  := pGravada;
                            :MON_GRAVADA_10 := 0;
                    
                        ELSE IF :ID_IVA = TRAE_ID_IVA('1') THEN
                    
                                :MON_GRAVADA_5  := 0;
                                :MON_GRAVADA_10 := pGravada; 
                    
                             ELSE
                    
                                :MON_GRAVADA_5  := 0;
                                :MON_GRAVADA_10 := 0; 
                    
                             END IF;
                    
                        END IF;
                    
                    END;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    ID_IVA
                    PRECIO_UNITARIO_C_IVA
                    P589_ID_MONEDA
                    MON_EXENTA
                    MON_GRAVADA_5
                    MON_GRAVADA_10
                    TOTAL_IVA
                ]
                itemsToReturn: [
                    MON_GRAVADA_5
                    MON_GRAVADA_10
                    MON_EXENTA
                    TOTAL_IVA
                ]
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action monto-total (
            name: MONTO_TOTAL
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if REPLACE(:MONTO_TOTAL,'.','') is null  then
                       :MONTO_TOTAL:= 0;
                    end if;
                    
                    :MONTO_TOTAL := round((replace(:MONTO_TOTAL_C_IVA, '.', '') - replace(:TOTAL_IVA, '.', '')),NVL(:P589_DECIMALES,0));
                    ```
                itemsToSubmit: [
                    MONTO_TOTAL_C_IVA
                    TOTAL_IVA
                    P589_DECIMALES
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action monto-total-c-iva (
            name: MONTO_TOTAL_C_IVA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vMontoTotalIva      number(19,3); --Monto total con IVA
                        vMontoTotal         number(19,3); --Monto total sin IVA
                        vMontoDescIva       number(19,3); --Monto descuento con iVA
                        vTotalIva           number(19,3);
                    BEGIN
                        vTotalIva := REPLACE(:TOTAL_IVA,'.','');
                    
                        if :CANTIDAD is null then
                             :CANTIDAD := 1;
                        end if;
                    
                        if :PRECIO_UNITARIO_C_IVA is null THEN
                            :PRECIO_UNITARIO_C_IVA    := 0;
                            :TOTAL_IVA := 0;
                        END IF;
                    
                        
                        IF :DESCUENTO_C_IVA IS NULL THEN
                            :DESCUENTO_C_IVA:=0;
                        end if;
                    
                        
                        vMontoTotalIva := (ROUND(replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)),NVL(:P589_DECIMALES,0))) + REPLACE(:INTERES,'.','');
                        
                        IF :DESCUENTO_C_IVA IS NOT NULL AND :DESCUENTO_C_IVA!=0 THEN 
                            vMontoDescIva := (ROUND(replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0),NVL(:P589_DECIMALES,0))) + REPLACE(:INTERES,'.','');
                            :P589_DESCUENTO_V := vMontoDescIva;
                        END IF;
                    
                        :MONTO_TOTAL_C_IVA := vMontoTotalIva;
                    
                        vMontoTotal := round((vMontoTotalIva - vTotalIva),NVL(:P589_DECIMALES,0));
                    
                        :MONTO_TOTAL := vMontoTotal;
                    
                    END;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    CANTIDAD
                    DESCUENTO_C_IVA
                    P589_DECIMALES
                    INTERES
                ]
                itemsToReturn: [
                    MONTO_TOTAL_C_IVA
                    P589_DESCUENTO_V
                    MONTO_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action precio-unitario (
            name: PRECIO_UNITARIO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_precio_unitario number;
                    begin
                    IF :PRECIO_UNITARIO IS NULL THEN
                    :PRECIO_UNITARIO:=0;
                    END IF;
                    
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_IVA/(100+:PORC_IVA)),NVL(:P589_DECIMALES,0));
                     :PRECIO_UNITARIO:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,NVL(:P589_DECIMALES,0));
                     end;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    P589_DECIMALES
                ]
                itemsToReturn: PRECIO_UNITARIO
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action total-comp (
            name: TOTAL_COMP
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
        )

        action total-iva (
            name: TOTAL_IVA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /*if :PRECIO_UNITARIO_C_IVA is null  then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    if :TOTAL_IVA is null then
                       :TOTAL_IVA := 0;
