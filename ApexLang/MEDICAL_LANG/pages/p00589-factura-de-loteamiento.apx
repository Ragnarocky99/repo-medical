        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /*if :PRECIO_UNITARIO_C_IVA is null then
                         :PRECIO_UNITARIO_C_IVA :=0;
                    end if;*/
                    /*if :IVA IS NULL THEN
                        :IVA:=0;
                    END IF;*/
                    
                    
                    BEGIN 
                    
                        :CANTIDAD:=1;
                    
                        BEGIN
                    
                            SELECT ID_UNIDAD_MEDIDA
                                INTO :ID_UNIDAD_MEDIDA
                            FROM STW_ARTICULOS
                            WHERE ID =:ID_ARTICULO;
                    
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                RAISE_APPLICATION_ERROR(-20000,'Error al buscar la unidad de medida del articulo');
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos'||sqlerrm);
                        END;
                    
                    /*
                    BEGIN
                        :PRECIO_UNITARIO_C_IVA := CF_PRECIO_VENTA_ANTFORMULA(:P0_ID_EMPRESA,:P589_ID_LISTA_PRECIO,:P589_FEC_COMPROBANTE,:ID_ARTICULO);
                        EXCEPTION WHEN OTHERS THEN
                            NULL;
                    END;
                    */
                    
                    EXCEPTION
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar los datos del articulo'||sqlerrm);
                    
                    END;
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P589_ID_LISTA_PRECIO
                    P589_FEC_COMPROBANTE
                ]
                itemsToReturn: [
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      v_maneja_lote varchar(1);
                    BEGIN
                    
                      IF NVL(:P589_IND_EXENTO, 'N') = 'N' THEN
                        SELECT NVL(IND_MANEJA_LOTE, 'X')
                          into v_maneja_lote
                          from stw_articulos
                         where id = :id_articulo;
                      
                        SELECT L.ID_IVA, I.PORC_IVA_VENTA
                          INTO :ID_IVA, :PORC_IVA
                          FROM STW_ARTICULOS L, STW_IVA I
                         WHERE L.ID = :ID_ARTICULO
                           AND L.ID_IVA = I.ID
                         GROUP BY L.ID, L.ID_IVA, I.PORC_IVA_VENTA;
                      ELSE
                    
                        SELECT I.ID, I.PORC_IVA_VENTA
                          INTO :ID_IVA, :PORC_IVA
                          FROM STW_IVA I
                         WHERE COD_IVA = W_BUSCA_PARAMETRO('ST', 'COD_IVA_EXENTA');
                      END IF;
                    
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                    
                        SELECT I.ID, I.PORC_IVA_VENTA
                          INTO :ID_IVA, :PORC_IVA
                          FROM STW_IVA I, STW_ARTICULOS A
                         WHERE A.ID_EMPRESA = :P0_COD_EMPRESA
                           AND A.ID = :ID_ARTICULO
                           AND A.ID_IVA = I.ID;
                    
                    END;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P589_IND_EXENTO
                ]
                itemsToReturn: [
                    ID_IVA
                    PORC_IVA
                ]
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                    v_precio_unitario number(18,3);
                    v_porc_iva  number(10);
                    
                    
                    
                    
                    BEGIN
                        /*IF NVL(:P589_IND_EXENTO,'N')='S' THEN 
                            SELECT  I.PORC_IVA_VENTA 
                                INTO  v_porc_iva
                            FROM STW_IVA I,STW_ARTICULOS  A
                            WHERE A.ID_EMPRESA=:P0_COD_EMPRESA 
                              AND A.ID=:ID_ARTICULO 
                              AND A.ID_IVA=I.ID;
                            v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(v_porc_iva/(100+v_porc_iva)),NVL(:P589_DECIMALES,0));
                            :PRECIO_UNITARIO_C_IVA:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,NVL(:P589_DECIMALES,0));
                        END IF;
                    EXCEPTION WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000,'Error al traer el precio unitario');*/
                        null;
                    END;
                        
                    
                    ```
                itemsToSubmit: [
                    P589_DECIMALES
                    PRECIO_UNITARIO_C_IVA
                    ID_ARTICULO
                    P589_IND_EXENTO
                ]
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

