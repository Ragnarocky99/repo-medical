    computation p589-subtotal (
        itemName: P589_SUBTOTAL
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_cabecera IS SELECT * FROM VTW_COMPROBANTES_CABECERA
                    WHERE :P589_ID=ID;
                    item_cabecera VTW_COMPROBANTES_CABECERA%rowtype;
                    v_subtotal   VTW_COMPROBANTES_CABECERA.TOT_COMPROBANTE%TYPE:=0;
                BEGIN
                  OPEN cursor_CABECERA;
                  LOOP
                    FETCH cursor_cabecera INTO item_cabecera;
                    EXIT WHEN cursor_cabecera%NOTFOUND;
                    v_subtotal:=nvl(item_cabecera.tot_comprobante,0)-nvl(item_cabecera.tot_iva,0);
                  END LOOP;
                  CLOSE cursor_cabecera;
                  RETURN v_subtotal;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P589_ID
        }
    )

    computation p589-tot-gravadas (
        itemName: P589_TOT_GRAVADAS
        execution {
            sequence: 40
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: NVL(REPLACE(:P589_TOT_GRAVADAS_10,'.',''),0)+NVL(REPLACE(:P589_TOT_GRAVADAS_5,'.',''),0)
        }
        comments {
            comments: "Metodo para calcular las gravadas de la factura "
        }
    )

    computation p589-tot-gravadas-2 (
        itemName: P589_TOT_GRAVADAS_10
        execution {
            sequence: 50
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_COMPROBANTES_DETALLE
                    WHERE :P589_ID=ID_COMPROBANTE_CABECERA;
                    item_detalle VTW_COMPROBANTES_DETALLE%rowtype;
                    v_total_gravadas_10    VTW_COMPROBANTES_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_gravadas_10:=v_total_gravadas_10+item_detalle.monto_total;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_gravadas_10;
                  EXCEPTION WHEN 
                  OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P589_ID
        }
    )

