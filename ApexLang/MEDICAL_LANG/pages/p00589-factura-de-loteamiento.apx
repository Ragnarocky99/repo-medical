    dynamicAction cargar-datos-caja (
        name: Cargar Datos Caja
        execution {
            sequence: 280
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                     Select H.NRO_HABILITACION,C.COD_CAJA
                     INTO :P589_NRO_HABILITACION,:P589_COD_CAJA
                         from ccw_habilitaciones H,CCW_CAJAS C
                        where H.id_empresa = :p0_cod_empresa
                          and H.id_sucursal = :P0_COD_SUCURSAL
                          AND H.ID_CAJA=C.ID
                          AND H.ID_EMPRESA=C.ID_EMPRESA
                          and upper(id_usuario) = (SELECT ID FROM BSW_USUARIOS WHERE COD_USUARIO=UPPER(:APP_USER) AND 
                          ID_EMPRESA=:P0_COD_EMPRESA)
                          and fec_cierre IS NULL;
                          EXCEPTION WHEN OTHERS THEN
                          NULL;
                    end;
                    ```
                itemsToReturn: [
                    P589_NRO_HABILITACION
                    P589_COD_CAJA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cargar-datos-de-cliente (
        name: Cargar Datos de Cliente
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P589_ID_CLIENTE
        }
        comments {
            comments: "Al cargar el cliente se cargan todos sus datos correspondientes en el la cabecera de la factura "
        }

        action condicion-venta (
            name: Condicion Venta
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(ID_CONDICION_VENTA, TRAE_ID_CONDICION_VEN(:P0_ID_EMPRESA, 
                                                                         W_BUSCA_PARAMETRO('LT','COD_CONDICION_VEN_DEF')))
                    FROM CCW_CLIENTES
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:P589_ID_CLIENTE;
                    ```
                itemsToSubmit: P589_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P589_ID_CONDICION_VENTA
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            serverSideCondition {
                type: itemIsNull
                item: P589_ID
            }
            comments {
                comments: Setea la condición de venta del cliente
            }
        )

        action direccion (
            name: DIRECCION
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DIRECCION
