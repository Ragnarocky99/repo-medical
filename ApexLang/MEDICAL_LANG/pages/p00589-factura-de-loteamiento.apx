    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_COMPROBANTE_CABECERA,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.CANTIDAD_REFERENCIA,
                       D.PRECIO_UNITARIO,
                       D.PRECIO_LISTA,
                       D.DESCUENTO,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.COSTO_PROMEDIO,
                       D.COSTO_PROMEDIO_REF,
                       D.COSTO_CON,
                       D.NUM_ORDEN,
                       D.ID_MECANICO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.PORC_DESCUENTO,
                       D.IVA,
                       D.ID_PEDIDO_DETALLE,
                       D.ID_COMPROBANTE_DETALLE_REF,
                       D.PORC_DESC_ESP,
                       D.MONTO_DESC_ESPECIAL,
                       D.ID_LOTE,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PRECIO_UNITARIO_C_IVA AS SALDO_JSON,
                       D.PRECIO_LISTA_C_IVA,
                       D.MONTO_TOTAL_C_IVA,
                       D.MONTO_TOTAL_C_IVA MONTO_TOTAL_C_IVA_COPIA,
                       D.DESCUENTO_C_IVA,
                       D.IND_MUEVE_STOCK,
                       D.CANTIDAD_ENTREGADA,
                       D.CANTIDAD_REMISIONADA,
                       D.ID_PROMO_CAB_GRUPO,
                       D.ID_IVA,
                       D.PORC_GRAVADA,
                       D.IND_PROMO,
                       D.CANTIDAD_RESGUARDADA,
                       D.DESC_ARTICULO,
                       D.ID_BARRA,
                       --Columnas para loteamiento
                       D.ID_CONTRATO_LOTE,
                       D.ID_CONTRATO_LOTE AS ID_CONTRATO_LOTE_CONSULTA, --Creado para consultar con LOV especial
                       D.ID_CUOTA_LOTE,
                       D.ID_CUOTA_LOTE AS ID_CUOTA_LOTE_CONSULTA,  --Creado para consultar con LOV especial
                       D.ID_CUOTA_LOTE AS ID_CUOTA_JSON,  --Creado para devolver valor al JSON del detalle
                       D.MON_GRAVADA_5,
                       D.MON_GRAVADA_10,
                       D.MON_EXENTA,
                       D.INTERES
                FROM VTW_COMPROBANTES_DETALLE D,STW_ARTICULOS A
                WHERE ID_COMPROBANTE_CABECERA=:P589_ID 
                  AND D.ID_ARTICULO=A.ID
                ```
            pageItemsToSubmit: P589_ID
        }
