    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 60
            region: @botones
            slot: regionBody
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: "Seguro que quiere borrar el registro ? "
            style: warning
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P589_ID IS NOT NULL AND :P589_ID_MOV_CAJ IS NULL THEN 
                RETURN TRUE;
                ELSE 
                RETURN FALSE; 
                END IF;
                ```
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button movcaja (
        buttonName: MovCaja
        label: Caja
        layout {
            sequence: 40
            region: @factura-de-loteamiento
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-money
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_ID_CLIENTE: &P589_ID_CLIENTE.
                    P75_ID_MONEDA: &P589_ID_MONEDA.
                    P75_ID_COMPROBANTE: &P589_ID.
                    P75_ID: &P589_ID_MOV_CAJ.
                    P75_SER_COMPROBANTE: &P589_SER_COMPROBANTE.
                    P75_TIP_COMPROBANTE: &P589_TIP_COMPROBANTE.
                    P75_IMPORTE: &P589_TOT_COMPROBANTE.
                    P75_MONEDA: &P589_ID_MONEDA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_id_comprobante  BSW_SERIES_COMPROBANTES.ID%TYPE;
                v_ind_caja  varchar2(1);
                BEGIN
                SELECT ID
                INTO v_id_comprobante
                 FROM 
                BSW_SERIES_COMPROB
                WHERE 
                SER_COMPROBANTE=:P589_SER_COMPROBANTE
                AND TIP_COMPROBANTE=:P589_TIP_COMPROBANTE; 
                
                SELECT IND_MOV_CAJA
                INTO v_ind_caja
                FROM BSW_SERIES_COMPROB
                WHERE ID=V_ID_COMPROBANTE;
                
                if v_ind_caja='S' AND :P589_ID IS NOT NULL  AND :P589_ID_CONDICION_VENTA=W_BUSCA_PARAMETRO('CC','CONDICION_CONTADO') THEN
                RETURN TRUE;
                ELSE 
                RETURN FALSE;
                END IF;
                EXCEPTION 
                WHEN OTHERS THEN
                NULL;
                END;
                ```
        }
    )

