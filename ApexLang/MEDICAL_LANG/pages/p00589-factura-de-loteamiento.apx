                       V.ID_SERIE_COMP_REF,
                       V.SER_TIMBRADO,
                       V.COD_CAJA,
                       V.NRO_HABILITACION,
                       V.ID_MODULO
                       
                FROM VTW_COMPROBANTES_CABECERA V
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            htmlDomId: Contenedor
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

