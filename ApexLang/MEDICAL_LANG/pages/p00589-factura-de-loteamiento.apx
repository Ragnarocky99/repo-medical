    region factura-de-loteamiento (
        name: Factura de Loteamiento
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT V.ID,
                       V.ID_EMPRESA,
                       V.TIP_COMPROBANTE,
                       V.SER_COMPROBANTE,
                       V.NRO_COMPROBANTE,
                       V.ID_SUCURSAL,
                       V.FEC_COMPROBANTE,
                       V.ID_VENDEDOR,
                       V.TIP_COMPROBANTE_REF,
                       V.SER_COMPROBANTE_REF,
                       V.NRO_COMPROBANTE_REF,
                       V.ID_CONDICION_VENTA,
                       V.ID_LISTA_PRECIO,
                       V.DESCUENTO,
                       V.ID_MONEDA,
                       V.TIP_CAMBIO,
                       V.TOT_COMPROBANTE,
                       V.TOT_GRAVADAS,
                       V.TOT_EXENTAS,
                       V.TOT_IVA,
                       V.ID_MOV_CAJ,
                       V.ESTADO,
                       V.FEC_ESTADO,
                       V.ID_USUARIO,
                       V.FEC_ALTA,
                       V.DESCUENTO_DET,
                       V.TOT_DESCUENTO_DET,
                       V.CAMBIO_DOLAR,
                       V.CAMBIO_MONEDA_PRECIO,
                       V.NOM_CLIENTE,
                       V.ESTADO_REPARO,
                       V.ESTADO_REPARTO,
                       V.TOT_IVA_SIN_REDONDEO,
                       V.TIP_CAMBIO_COMPRA,
                       V.COMENTARIO,
                       V.GRU_COMPROBANTE,
                       V.ID_PERSONA,
                       V.ACTUALIZADO_POR,
                       V.IMPRESION_AUTORIZADA,
                       V.AUTORIZADO_POR,
                       V.IMPRESO,
                       V.RUC_CLIENTE,
                       V.IND_PAGARE,
                       V.ID_COBRADOR_PAG,
                       V.ID_USUARIO_PAG,
                       V.DIAS_AUT_PAGARE,
                       V.FEC_AUT_PAGARE,
                       V.IND_REFACTURAR,
                       V.ID_MOTIVO_ANU,
                       V.ID_SECTOR_VEN,
                       V.IMPRIME_IVA,
                       V.NRO_AUTORIZ_FACT,
                       V.COD_USUARIO_AUD,
                       V.TIENE_REMISION,
                       V.NRO_MOV_CAJ,
                       V.ID_DESPACHO_CAB,
                       V.ID_CLIENTE,
                       V.ID_PEDIDO_REF,
                       V.ID_COMPROBANTE_REF,
                       V.IND_IMPRIMIR_COMENTARIO,
                       V.SERIE,
                       V.NRO_TIMBRADO,
                       V.ID_MOTIVO_NCR,
                       V.LOTE,
                       V.NRO_GARANTIA,
                       V.ID_USUARIO_ANU,
