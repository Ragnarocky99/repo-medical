    dynamicAction set-datos-cuotas (
        name: SET_DATOS_CUOTAS
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_CUOTA_LOTE
        }

        action calcula-interes (
            name: CALCULA INTERES
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vMontoInteres   NUMBER(19,3);
                        vSaldoCuota     LTW_CUOTAS.TOT_SALDO%TYPE;
                        vNroCuota       LTW_CUOTAS.NRO_CUOTA%TYPE;
                        vIdLote         LTW_CUOTAS.ID_LOTE%TYPE;
                        vTipComprobante LTW_CONTRATOS.TIP_COMPROBANTE%TYPE;
                        vSerComprobante LTW_CONTRATOS.SER_COMPROBANTE%TYPE;
                        vNroComprobante LTW_CONTRATOS.NRO_COMPROBANTE%TYPE;
                    
                    BEGIN
                        vMontoInteres := 0;
                        
                        IF :ID_CUOTA_LOTE IS NOT NULL THEN
                        
                            BEGIN
                                SELECT LC.TOT_SALDO, LC.ID_LOTE
                                   INTO vSaldoCuota, vIdLote
                                FROM LTW_CUOTAS LC
                                WHERE LC.ID = :ID_CUOTA_LOTE;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'No se ha podido recuperar datos de la cuota.');
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error al validar el saldo de la cuota.');
                            END;
                    
                            BEGIN
                                SELECT CT.TIP_COMPROBANTE, CT.SER_COMPROBANTE, CT.NRO_COMPROBANTE
                                   INTO vTipComprobante, vSerComprobante, vNroComprobante
                                FROM LTW_CONTRATOS CT
                                WHERE CT.ID = :ID_CONTRATO_LOTE;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    NULL;
                                WHEN OTHERS THEN
                                    NULL;
                            END;            
                            vMontoInteres := calcula_interes_cuota_cobro(p_id_empresa       => :P0_ID_EMPRESA,
                                                                         p_id_contrato      => :ID_CONTRATO_LOTE,
                                                                         p_id_cuota         => :ID_CUOTA_LOTE,
                                                                         p_tip_comprobante  => vTipComprobante,
                                                                         p_ser_comprobante  => vSerComprobante,
                                                                         p_nro_comprobante  => vNroComprobante,
                                                                         p_nro_cuota        => NULL,
                                                                         p_saldo_cuota      => vSaldoCuota,
                                                                         p_fec_recibo       => :P589_FEC_COMPROBANTE,
                                                                         p_fecha_venc       => :FEC_VENC,
                                                                         p_saldo_mora       => 0,
                                                                         p_id_lote          => vIdLote);
                            :INTERES := vMontoInteres;
                    
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    ID_CONTRATO_LOTE
                    ID_CUOTA_LOTE
                    FEC_VENC
                    P589_FEC_COMPROBANTE
                ]
                itemsToReturn: INTERES
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

