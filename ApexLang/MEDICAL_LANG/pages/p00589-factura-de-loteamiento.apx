    computation p589-nro-timbrado (
        itemName: P589_NRO_TIMBRADO
        execution {
            sequence: 30
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_ser varchar2(9);
                V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                select NRO_TIMBRADO
                INTO v_ser
                 from BSW_SERIES_COMPROB t 
                 WHERE ID_EMPRESA=:P0_COD_EMPRESA 
                AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                AND TIP_COMPROBANTE=w_BUSCA_PARAMETRO('VT','TIPO_COMPROBANTE_VENTA')
                AND IND_ACTIVO='S'
                AND T.TERMINAL = V_IP_MAQUINA;
                RETURN v_ser;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                return null;
                WHEN OTHERS THEN
                 RETURN null; 
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P589_ID
        }
    )

