                       V.NRO_TRANS_PM,
                       V.NRO_PAGO_EXPRESS,
                       V.ID_ANTERIOR,
                       V.ENTREGA_INICIAL,
                       V.ID_LISTA_BODA_CAB,
                       V.IND_REEMBOLSO_AUTORIZADO,
                       V.ID_USUARIO_REEMB_AUTORIZA,
                       V.FEC_REEMBOLSO_AUTORIZADO,
                       V.ID_DEPOSITO_RESGUARDO,
