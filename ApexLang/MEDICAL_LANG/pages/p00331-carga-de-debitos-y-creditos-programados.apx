                    $model.setValue($newRecord, "SALDO_CUOTA",(json_detalle.DETALLE[i].SALDO_CUOTA).toString());
                    
                    
                    
                    
                    
                    
                    
                    }
                    
                    }
                    
                    
                    
                    
