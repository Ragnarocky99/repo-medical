    region detalle-de-débitos-y-créditos-programados (
        name: Detalle de Débitos y Créditos programados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_CABECERA,
                       NRO_PROGRAMA,
                       NRO_CUOTA,
                       FEC_VENCIMIENTO,
                       MONTO_CUOTA,
                       MONTO_CUOTA as MONTO_COPIA,
                       SALDO_CUOTA,
                       SALDO_CUOTA AS SALDO_COPIA,
                       ID_SUCURSAL,
                       COD_USUARIO_AUD
                  from RHW_DEBCRED_PROG_DET
                 where id_empresa = :P0_ID_EMPRESA
                 AND ID_CABECERA = :P331_ID
                 --AND NRO_CUOTA = :NRO_CUOTAS
                 --AND NRO_PROGRAMA = :NRO_PROGRAMA
                
                ```
            pageItemsToSubmit: P331_ID
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: Detalles
