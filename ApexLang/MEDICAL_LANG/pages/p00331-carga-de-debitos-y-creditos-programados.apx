    dynamicAction decimal-moneda (
        name: DECIMAL MONEDA
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P331_ID_MONEDA
        }

        action decimal (
            name: DECIMAL
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DECIMALES FROM 
                    BSW_MONEDAS WHERE
                    ID=:P331_ID_MONEDA
                    ```
                itemsToSubmit: P331_ID_MONEDA
            }
            affectedElements {
                selectionType: items
                items: P331_DECIMAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction insertar-cuotas (
        name: Insertar Cuotas
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @generar-cuota
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --NO TOCAR
                    IF :P331_TIP_DEBCRED = 'C' THEN
                      IF nvl( :P331_MONTO_TOTAL, 0 ) > 0 AND
                         nvl( :P331_MONTO_CUOTA, 0 ) > 0 AND
                         :P331_FEC_INICIO IS NOT NULL THEN
                        DECLARE
                          TMP_CUOTAS CONSTANT VARCHAR2(255) :='CUOTAS';    
                    
                          vcuota       NUMBER(5);
                          vvencimiento DATE;
                          vmonto       NUMBER(18,3);
                          vimporte     NUMBER(18,3);
                          vmonto_ant NUMBER(18,3);
                          vprocesar varchar(1);
                          vloop number(18);
                        BEGIN
                          IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_CUOTAS) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_CUOTAS);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_CUOTAS);
                          vcuota := 0 ;
                          :P331_TOTAL_DETALLE := 0;  
                          :P331_TOTAL_CUOTAS  := 0;  
                          :P331_TOTAL_SALDO := 0;  
                          vprocesar := 'S' ;
                    
                    		 LOOP
                    
                            IF TO_NUMBER(:P331_MONTO_TOTAL) > TO_NUMBER(:P331_TOTAL_DETALLE) THEN
                              IF :P331_TIPO_CUOTA = 'M' THEN
                                vvencimiento := add_months(:P331_FEC_INI_CUO,vcuota); 
                              ELSIF :P331_TIPO_CUOTA = 'Q' THEN
                                if vvencimiento is null then
                              	  vvencimiento := :P331_FEC_INI_CUO;
                                else
                              	  if to_char(vvencimiento,'dd') = '15' then
                              	    vvencimiento := last_day(vvencimiento);
                              	  else
                              		  vvencimiento := to_date('15'||to_char(add_months(vvencimiento,1),'mm/yyyy'),'dd/mm/yyyy');
                              	  end if;
                                end if;
                              END IF;
                    
                              vcuota := nvl( vcuota, 0 ) + 1;
                    
                              IF vcuota = :P331_NRO_CUOTAS THEN
                                vimporte := round( :P331_MONTO_TOTAL / :P331_NRO_CUOTAS, :P331_DECIMAL );
                                vmonto := :P331_MONTO_TOTAL - ( vimporte * ( :P331_NRO_CUOTAS - 1 ) );
                              ELSE
                                IF TO_NUMBER(:P331_MONTO_TOTAL) > ( TO_NUMBER(:P331_MONTO_CUOTA) * ( TO_NUMBER(:P331_TOTAL_CUOTAS) + 1 ) ) THEN
                                  vmonto := :P331_MONTO_CUOTA;
                                ELSE
                                  vmonto := :P331_MONTO_TOTAL - (:P331_MONTO_CUOTA * (:P331_TOTAL_CUOTAS));
                                END IF;
                              END IF;
                                 
                                -- RAISE_APPLICATION_ERROR(-20000,VMONTO);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_CUOTAS,
                        p_c001 => vcuota,
                        p_c002 => vvencimiento,
                        p_c003 => vmonto,
                        p_c004 => vmonto
                        
                         );
                         :P331_TOTAL_DETALLE := nvl(:P331_TOTAL_DETALLE,0) + vmonto;
                        -- :vamonto_ant      := nvl(:P331_MONTO_CUOTA,0);
                         :P331_TOTAL_SALDO := nvl(:P331_TOTAL_SALDO,0) + vmonto;
                         :P331_TOTAL_CUOTAS := nvl(:P331_TOTAL_CUOTAS,0) + 1;
                    
                    
                             
                            ELSE
                              EXIT;
                            END IF;
                          END LOOP;
                          
                          vprocesar := 'N';
                        END;
                      ELSE
                        --mensaje_ex('Para ejecutar el proceso debe cargar los datos de Montos y Fechas.',2);
                    
                        RAISE_APPLICATION_ERROR(-20999,'ERROR: Para ejecutar el proceso debe cargar los datos de Montos y Fechas'||:P331_MONTO_CUOTA||'-'||:P331_MONTO_TOTAL||'-'||:P331_FEC_INICIO);
                    
                      END IF;
                    END IF;
                    
                    
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                      Select  C001 AS NRO_CUOTA,
                    --REPLACE(c002,'\','A') AS VENCIMIENTO,
                      C002 AS VENCIMIENTO,
                      c003 AS MONTO_CUOTA,
                      C004 AS SALDO_CUOTA
                    From APEX_COLLECTIONS
                    Where COLLECTION_NAME = 'CUOTAS'
                    --ORDER BY TO_NUMBER(NRO_CUOTA) ASC
                    order by 1 desc
                      ;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P331_JSON_DETALLES:=JSON_DETALLE;
                    
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    P331_TIP_DEBCRED
                    P331_MONTO_TOTAL
                    P331_NRO_CUOTAS
                    P331_FEC_INICIO
                    P331_TOTAL_DETALLE
                    P331_TOTAL_SALDO
                    P331_FEC_INI_CUO
                    P331_TIPO_CUOTA
                    P331_DECIMAL
                    P331_MONTO_CUOTA
                ]
                itemsToReturn: [
                    P331_PRUEBA
                    P331_TOTAL_DETALLE
                    P331_TOTAL_SALDO
                    P331_JSON_DETALLES
                ]
                showProcessing: true
            }
