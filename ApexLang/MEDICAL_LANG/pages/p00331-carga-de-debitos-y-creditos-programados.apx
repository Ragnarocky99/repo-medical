        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    declare 
                    desc_empleado VARCHAR (200);
                    desc_concepto VARCHAR (200);
                    
                    
                    BEGIN
                     select ltrim( rtrim( pe.nombre ) )
                        into desc_empleado
                        from rhw_empleados em ,BSW_personas pe
                       where EM.ID_empresa = :P0_ID_EMPRESA
                        and EM.ID = :P331_ID_EMPLEADO;
                    EXCEPTION
                      when others then
                        desc_empleado := NULL;
                    END;
                    DECLARE
                    desc_concepto VARCHAR(200);
                    BEGIN
                      select descripcion
                        into desc_concepto
                        from rhw_conceptos
                       where ID = :P331_ID_CONCEPTO;
                    EXCEPTION
                      when others then
                        desc_concepto := NULL;
                    END;
                    
                    DECLARE 
                    procesar VARCHAR(200);
                    total_detalle VARCHAR(500);
                    total_saldo VARCHAR(1000);
                    total_cuotas VARCHAR(100);
                    --IF nvl(procesar, 'N' ) = 'N' THEN
                      BEGIN
                    
                        Select sum( monto_cuota ), sum( saldo_cuota ), count(*)
                          into total_detalle, total_saldo, total_cuotas
                          from rhw_debcred_prog_det
                         where ID_empresa = :P0_ID_EMPRESA
                           and nro_programa = :P331_NRO_PROGRAMA;
                      EXCEPTION
                        when others then
                          total_detalle := 0;
                          total_saldo := 0;
                          total_cuotas := 0;
                      END;
                    --END IF;
                    
                    --      *********** que me traiga decimales
                    DECLARE 
                     desc_moneda VARCHAR(500);
                     decimales VARCHAR(100);
                    BEGIN
                      select descripcion, nvl( decimales, 0 )
                        into desc_moneda, decimales
                        from bsw_monedas
                       where cod_moneda = cod_moneda;
                    EXCEPTION
                      when others then
                        desc_moneda := NULL;
                        decimales := 0;
                    END;
                    DECLARE
                    fec_ini_cuo DATE;
                    total_detalle VARCHAR(100);
                    BEGIN
                      select fec_vencimiento
                        into fec_ini_cuo
                        from RHw_DEBCRED_PROG_DET det
                       where det.ID_empresa  = :P0_ID_EMPRESA
                         and det.nro_programa = :P331_NRO_PROGRAMA
                         and det.nro_cuota    = 1;
                    EXCEPTION
                      when others then
                        fec_ini_cuo := NULL;
                    END;
                    
                    
                    
                    /*
                    BEGIN
                      select descripcion
                        into :b_cabecera.desc_moneda
                        from monedas
                       where cod_moneda = :b_cabecera.cod_moneda ;
                    EXCEPTION
                      when others then
                        :b_cabecera.desc_moneda := null;
                    END;
                    */
                    
                    :nro_cuotas := :total_cuotas;
                    --:formato;
                    ```
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-execute-plsql-code-2 (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    IF nvl(:total_detalle, 0 ) <> nvl( :total_saldo, 0 ) THEN
                      RAISE_APPLICATION_ERROR(20999,'No se puede borrar el registro, porque posee cuotas canceladas.');
                    
                      --mensaje_ex('No se puede borrar el registro, porque posee cuotas canceladas.',2);
                      --raise form_trigger_failure;
                    ELSE
                      delete from RHW_DEBCRED_PROG_DET
                    where id= :P331_ID
                    AND ID_EMPRESA = :P0_ID_EMPRESA
                    AND NRO_PROGRAMA = :P331_NRO_PROGRAMA;
                    END IF;
                    
                    ```
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-execute-plsql-code-3 (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    if nvl(:procesar,'N') = 'N' then 
                       :total_detalle := nvl(:total_detalle,0) - nvl(:monto_cuota,0) ;
                       :total_saldo := nvl(:total_detalle,0) - nvl(:saldo_cuota,0) ;
                       :total_cuotas := nvl(:total_cuotas,0) - 1 ;
                    end if ;
                    ```
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

