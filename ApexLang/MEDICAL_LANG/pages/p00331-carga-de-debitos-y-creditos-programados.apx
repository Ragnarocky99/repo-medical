                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var vcuota =0;     
                    var vvencimiento =0;
                    var vmonto = 0;      
                    var vimporte = 0;
                    var procesar = 'S'; 
                    
                    
                    // Calcular Monto total y Monto cuota
                    function calculaTotales(){
                        var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                        var v_total_monto    = model.getFieldKey(":P331_TOTAL_MONTO");
                        var v_total_saldo   = model.getFieldKey(":P331_TOTAL_SALDO");
                        var v_monto_total    = 0;
                        var v_nro_cuota    = model.getFieldKey(":P331_NRO_CUOTAS");
                        var v_tip_cuota = model.getFieldKey(":P331_TIPO_CUOTA")
                        var fec_ini_cuo = 0;
                        var monto_cuota = 0;
                        var total_cuotas = model.getFieldKey(":P331_TOTAL_CUOTAS");
                        
                      
                    
                        model.forEach(function(r, index, id) {
                            var meta = model.getRecordMetadata(id);
                            if ((meta.field !=undefined) && (!meta.deleted)){
                               for (1 in v_nro_cuota){
                                  if (v_tip_cuota == 'M'){
                                 vvencimiento = Date.getMonth(fec_ini_cuo,vcuota);
                                  }
                               } 
                            }else if (v_tip_cuota =='Q'){
                                vvencimiento = null;
                                vvencimiento = fec_ini_cuo;
                            }else if (String.fromCharCode(vvencimiento,'dd') =='15'){
                                vvencimiento = getLastDayOfMonth(vvencimiento);
                            }else {
                                vvencimiento = date.parse('15' + toString(Date.getMonth(vvencimiento,1),'mm/yyyy'),'dd/mmm/yyyy');
                            }  
                            vcuota = $nvl(vcuota,0)+1;
                            if (vcuota = v_nro_cuota){
                               vimporte = Math.round(v_monto_total / v_nro_cuota);
                               vmonto = v_monto_total - (vimporte * (v_nro_cuota - 1 ));
                            }else if (v_monto_total > (monto_cuota * (total_cuotas + 1 ))){
                                  vmonto = v_monto_total - (monto_cuota * (total_cuotas));
                            }
                            if (vcuota > 1){
                               
                            }
                    
                        });
                    
                        
                        // $s('P235_TOT_DEBE',v_mon_debe.toString().replace('.', ''));
                        // $s('P235_TOT_HABER',v_mon_haber.toString().replace('.', ''));
                    
                    
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var vcuota = 0;
                    var vvencimiento =0;
                    var vmonto =0;
                    var vimporte =0;
                    
                    for 1 in :P331_NRO_CUOTAS
                    LOOP
                    IF :P331_TIPO_CUOTA = 'M' THEN 
                    vvencimiento = getMonth(:P331_FEC_INI_CUO,vcuota);
                    else if :P331_TIPO_CUOTA = 'Q' THEN 
                    if vvencimiento is null then
                              	  vvencimiento = :P331_FEC_INI_CUO;
                    else
                              	  if to_char(vvencimiento,'dd') = '15' then
                              	    vvencimiento = last_day(vvencimiento);
                              	  else
                              		  vvencimiento = to_date('15'||to_char(getMonth(vvencimiento,1),'mm/yyyy'),'dd/mm/yyyy');
                              	  end if;
                                end if;
                              END IF;
                    
                    vcuota = nvl( vcuota, 0 ) + 1;
                    
                              IF vcuota = :P331_NRO_CUOTAS THEN
                                vimporte = round( :P331_MONTO_TOTAL / :P331_NRO_CUOTAS, :decimales );
                                vmonto = :P331_MONTO_TOTAL - ( vimporte * ( :P331_NRO_CUOTAS - 1 ) );
                              ELSE
                                IF :P331_MONTO_TOTAL > ( :P331_MONTO_CUOTA * ( :b_cabecera.total_cuotas + 1 ) ) THEN
                                  vmonto := :b_cabecera.monto_cuota;
                                ELSE
                                  vmonto := :b_cabecera.monto_total - (:b_cabecera.monto_cuota * (:b_cabecera.total_cuotas));
                                END IF;
                              END IF;
                    
                              IF vcuota > 1 THEN
                                next_record;
                              END IF;
                    
                              :b_detalle.nro_cuota   := vcuota;
                              :b_detalle.fec_vencimiento := vvencimiento;
                              :b_detalle.monto_cuota := vmonto;
                              :b_detalle.saldo_cuota := vmonto;
                              :b_cabecera.total_detalle := nvl(:b_cabecera.total_detalle,0) + vmonto;
                              :b_cabecera.total_saldo   := nvl(:b_cabecera.total_saldo,0) + vmonto;
                              :variables.monto_ant      := nvl(:b_detalle.monto_cuota,0);
                              :b_cabecera.total_cuotas  := nvl(:b_cabecera.total_cuotas,0) + 1;
                              synchronize;
                            ELSE
                              EXIT;
                            END IF;
                          END LOOP;
                    
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

