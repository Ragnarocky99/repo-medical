    dynamicAction calcular-cuotas (
        name: Calcular Cuotas
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P331_NRO_CUOTAS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     if :P331_MONTO_TOTAL is not null then
                      if nvl(:P331_NRO_CUOTAS,0) > 0 then
                      :P331_MONTO_CUOTA := round( :P331_MONTO_TOTAL / :P331_NRO_CUOTAS, :P331_DECIMAL);
                      -- :P331_MONTO_CUOTA := round(REPLACE(:P331_MONTO_TOTAL,'.','') / REPLACE(:P331_NRO_CUOTAS,'.',''), :P331_DECIMAL);
                    
                      end if ;
                     end if ;
                    -- Calcular Cuotas 
                    
                    
                    --REPLACE(:P331_MONTO_TOTAL,'.','')
                    --REPLACE(:P331_NRO_CUOTAS,'.','')
                    ```
                itemsToSubmit: [
                    P331_MONTO_TOTAL
                    P331_NRO_CUOTAS
                    P331_DECIMAL
                ]
                itemsToReturn: P331_MONTO_CUOTA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

