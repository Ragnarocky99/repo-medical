page 331 (
    name: Carga de Debitos y Creditos Programados
    alias: CARGA-DE-DEBITOS-Y-CREDITOS-PROGRAMADOS
    title: Carga de Debitos y Creditos Programados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            
            function calculaTotales(){
                //var model= apex.region("Totales").element().;
            var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad1 = model.getFieldKey("MONTO_CUOTA");
              var v_cantidad2 = model.getFieldKey("SALDO_CUOTA");
            
            
            
            
                var v_TOTAL_DETALLE = model.getFieldKey(":P331_TOTAL_DETALLE");
                var v_TOTAL_SALDO = model.getFieldKey(":P331_TOTAL_SALDO");
                var v_total_det  = 0;
                var v_TOTAL_DETALLE  = 0;
                var v_TOTAL_SALDO = 0;
                var v_total_sal = 0;
                
                model.forEach(function(r, index, id) {
            
                var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                       // v_total_det= SumBy(v_TOTAL_DETALLE + parseFloat(r[v_cantidad1].replace(/\./g,'')));
                      //  v_total_sal= SumBy(v_TOTAL_SALDO + parseFloat(r[v_cantidad2].replace(/\./g,'')));
            
                        v_total_det     = v_total_det    + parseFloat(r[v_cantidad1].replace(/\./g,''));
                        v_total_sal      = v_total_sal     + parseFloat(r[v_cantidad2].replace(/\./g,''));
            
                       
                    }
                            
                });
            
                if(isNaN(v_total_sal)){
                     v_total_sal=1;
                 }
                 if(isNaN(v_total_det)){
                     v_total_det=1;
                 }
                $s('P331_TOTAL_DETALLE',v_total_det);
                $s('P331_TOTAL_SALDO',v_total_sal);
            
                 
                //console.log('cambio es '+ v_cambio_debe + " | " + v_cambio_haber);
            
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P331_NRO_PROGRAMA").readOnly = true;
            document.getElementById("P331_FECHA_ALTA").readOnly = true;
            document.getElementById("P331_COD_USUARIO_ALTA").readOnly = true;
            
            
            ```
    }
