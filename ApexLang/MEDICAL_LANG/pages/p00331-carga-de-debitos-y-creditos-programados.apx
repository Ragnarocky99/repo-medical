    process detalle-de-débitos-y-créditos-programados-save-interactive-grid-data (
        name: Detalle de Débitos y Créditos programados - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalle-de-débitos-y-créditos-programados
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                                insert into RHW_DEBCRED_PROG_DET
                                (ID_EMPRESA, ID_CABECERA, NRO_PROGRAMA, NRO_CUOTA, FEC_VENCIMIENTO,
                                 MONTO_CUOTA,SALDO_CUOTA,ID_SUCURSAL,COD_USUARIO_AUD)
                                VALUES(:P0_ID_EMPRESA,:P331_ID,:P331_NRO_PROGRAMA,:NRO_CUOTA,:FEC_VENCIMIENTO,
                                REPLACE(:MONTO_CUOTA,'.',''),REPLACE(:SALDO_CUOTA,'.',''),:ID_SUCURSAL,:COD_USUARIO_AUD);
                
                            WHEN 'U' then 
                   
                                update RHW_DEBCRED_PROG_DET 
                                    set --ID        = :ID,
                                        ---ID_PLANILLA      = :P322_ID,
                                        NRO_PROGRAMA      = :P331_NRO_PROGRAMA,
                                        NRO_CUOTA         = :P331_NRO_CUOTAS,
                                        FEC_VENCIMIENTO      = :FEC_VENCIMIENTO,
                                        MONTO_CUOTA  = REPLACE(:MONTO_CUOTA,'.',''),
                                        SALDO_CUOTA      = REPLACE(:SALDO_CUOTA,'.',''),
                                        ID_SUCURSAL       = :ID_SUCURSAL,
                                        COD_USUARIO_AUD     = :COD_USUARIO_AUD    
                
                                    where  ID_CABECERA = :P331_ID
                                    AND ID = :ID;
                                  -- and ID_CABECERA = :P331_ID; 
                
                                     when 'D' then
                                delete RHW_DEBCRED_PROG_DET     
                                  where  ID_CABECERA = :ID_CABECERA
                                    AND ID = :ID;
                
                    end case;
                
                    EXCEPTION
                when no_data_found then
                RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar al detalle'||:id_CABECERA);
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 17446456797119628
        }
        comments {
            comments: Proceso para guardar, actualizar, eliminar los detalles de debitos y creditos programados
        }
    )

