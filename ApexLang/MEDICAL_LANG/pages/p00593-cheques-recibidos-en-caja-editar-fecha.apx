    region cheques-recibidos-en-caja-editar-fecha (
        name: Cheques recibidos en caja editar fecha
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       ID_PER_JURIDICA,
                       NRO_VALOR,
                       FEC_EMISION,
                       FEC_VENCIMIENTO,
                       MONTO_VALOR,
                       ID_CLIENTE,
                       ESTADO_VALOR,
                       ID_PERSONA,
                       NRO_CUOTA,
                       OBSERVACION,
                       NRO_CUENTA
                  
                           
                  from CCW_VALORES
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

