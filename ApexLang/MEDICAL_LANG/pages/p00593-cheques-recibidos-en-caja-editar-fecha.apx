    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            document.getElementById("P593_ESTADO_VALOR").readOnly = true;
            document.getElementById("P593_FEC_EMISION").readOnly = true;
            //document.getElementById("P593_ID_CLIENTE").readOnly = true;
            document.getElementById("P593_ID_PER_JURIDICA").readOnly = true;
            document.getElementById("P593_MONTO_VALOR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;}
