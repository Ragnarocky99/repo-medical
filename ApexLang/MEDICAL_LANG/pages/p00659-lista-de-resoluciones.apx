            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region lista-de-resoluciones (
        name: Lista de Resoluciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NRO_ORDEN,
                       NRO_RESOLUCION,
                       FEC_RESOLUCION,
                       NRO_LICITACION,
                       NRO_POLIZA,
                       FEC_POLIZA_INI,
                       FEC_POLIZA_FIN,
                       TOT_RESOLUCION,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       DECIMALES,
                       COD_USUARIO,
                       FEC_ALTA,
                       ANULADO,
                       FEC_ANULACION,
                       COD_USU_ANU,
                       ID_CLIENTE,
                       NRO_ORDEN_OF,
                       NRO_OFERTA_OF,
                       FEC_FIRMA,
                       FEC_NOTIFICACION,
                       NRO_OFERTA,
                       CASE
                       WHEN ANULADO ='S' THEN 'fa fa-check u-success-text'
                       WHEN ANULADO ='N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON
                    from LCW_RESOLUCIONES_CAB
                
                  where (ID_CLIENTE = :P659_ID_CLIENTE or :P659_ID_CLIENTE IS NULL)
                  and   (NRO_OFERTA = :P659_NRO_OFERTA or :P659_NRO_OFERTA IS NULL)
                  and   (FEC_RESOLUCION BETWEEN :P659_FEC_DESDE and :P659_FEC_HASTA)
                ```
            pageItemsToSubmit: [
                P659_ID_CLIENTE
                P659_NRO_OFERTA
                P659_FEC_DESDE
                P659_FEC_HASTA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 661
                items: {
                    P661_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 74642815600313165
        }

