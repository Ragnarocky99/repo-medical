    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @lista-de-resoluciones
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 661
                clearCache: 661
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P659_ID_CLIENTE
                P659_NRO_OFERTA
                P659_FEC_HASTA
                P659_FEC_DESDE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-resoluciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

