page 188 (
    name: Carga de Choferes
    alias: CARGA-DE-CHOFERES
    title: Carga de Choferes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            a{
            font-size:18px;
             color:#FF0000;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-choferes (
        name: Carga de Choferes
        type: form
        source {
            location: localDatabase
            tableName: BSW_CHOFERES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                margin-top-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P188_COD_CHOFER (
        type: textField
        label {
            label: <p>C.I. Chofer:<a>*</a></p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-choferes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @carga-de-choferes
            column: COD_CHOFER
            dataType: varchar2
        }
    )

    pageItem P188_COD_USU_ALT (
        type: displayOnly
        label {
            label: <p>Usuario:</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-choferes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-choferes
            column: COD_USU_ALT
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P188_DESCRIPCION (
        type: textField
        label {
            label: <p>Nombre:</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-choferes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-choferes
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P188_FEC_ALT (
        type: datePicker
        label {
            label: <p>Fec Actualización:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 40
            region: @carga-de-choferes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD
            width: 30
        }
        source {
            formRegion: @carga-de-choferes
            column: FEC_ALT
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: SYSDATE
        }
    )

    pageItem P188_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-choferes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-choferes
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P188_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-choferes
            slot: regionBody
        }
        source {
            formRegion: @carga-de-choferes
            column: ID_EMPRESA
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P188_OBSERVACION (
        type: textarea
        label {
            label: <p>Observación:</p>
            alignment: left
        }
        layout {
            sequence: 80
            region: @carga-de-choferes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                margin-top-none
            ]
            width: 60
            height: 5
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-choferes
            column: OBSERVACION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P188_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P188_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P188_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 43678115447146439
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-choferes (
        name: Initialize form Carga de Choferes
        type: formInitialization
        formRegion: @carga-de-choferes
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 43677347423146439
        }
    )

    process process-form-carga-de-choferes (
        name: Process form Carga de Choferes
        type: formAutoRowProcessing
        formRegion: @carga-de-choferes
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 43677725116146439
        }
    )

)

