        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Tipos de Bienes
        }

        savedReport 633064 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_TIPO_BIEN (
                sequence: 1
            )

            displayColumn ID (
                sequence: 11
            )

            displayColumn ID_CENTRO (
                sequence: 3
            )

            displayColumn ID_CENTRO_DEP (
                sequence: 7
            )

            displayColumn ID_CENTRO_DEP_ACUM (
                sequence: 9
            )

            displayColumn ID_CENTRO_REVAL (
                sequence: 5
            )

            displayColumn ID_CUENTA (
                sequence: 2
            )

            displayColumn ID_CUENTA_DEP (
                sequence: 6
            )

            displayColumn ID_CUENTA_DEP_ACUM (
                sequence: 8
            )

            displayColumn ID_CUENTA_REVAL (
                sequence: 4
            )

            displayColumn VIDA_UTIL (
