            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column PORC_VALOR_RESIDUAL (
            type: plainText
            heading {
                heading: <p>% Valor Residual: </p>
                alignment: center
            }
            layout {
