page 479 (
    name: Tipos de Bienes
    alias: TIPOS-DE-BIENES
    title: Tipos de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tipos-de-bienes (
        name: Tipos de Bienes
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tipos-de-bienes-2 (
        name: Tipos de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT COD_TIPO_BIEN, 
                       ID_CUENTA, 
                       ID_CENTRO, 
                       ID_CUENTA_REVAL, 
                       ID_CENTRO_REVAL, 
                       ID_CUENTA_DEP, 
                       ID_CENTRO_DEP, 
                       ID_CUENTA_DEP_ACUM, 
                       ID_CENTRO_DEP_ACUM, 
                       VIDA_UTIL,
                       PORC_VALOR_RESIDUAL,
                       ID
                FROM COW_TIPOS_BIENES;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 480
                items: {
                    P480_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 63191829583293520
        }

        column COD_TIPO_BIEN (
            type: plainText
            heading {
                heading: <p>Código Tipo: </p>
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 110
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID_CENTRO (
            type: plainTextBasedOnLov
            heading {
                heading: <p>Código Centro: </p>
                alignment: center
            }
            lov {
                lov: @lv-centro-costo
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_CENTRO_DEP (
