    dynamicAction setear-montos (
        name: Setear Montos
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
                IVA
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vprecio_unitario cmw_pedidos_detalle_cp.precio_unitario_c_iva%type;
                      vcantidad        cmw_pedidos_detalle_cp.cantidad%type;
                      vtotal           cmw_pedidos_detalle_cp.monto_total_c_iva%type;
                      vdecimales       bsw_monedas.decimales%type;
                    begin
                      vprecio_unitario   := replace(:precio_unitario_c_iva, '.', '');
                      vcantidad          := :cantidad;
                      vtotal             := vprecio_unitario * vcantidad;
                      vdecimales         := moneda_decimales(:P854_ID_MONEDA);
                    
                      :monto_total       := round(vtotal / (1 + :IVA / 100), vdecimales);
                      :total_iva         := vtotal - :monto_total;
                      :monto_total_c_iva := vtotal;
                    end;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    P854_ID_MONEDA
                    IVA
                ]
                itemsToReturn: [
                    MONTO_TOTAL
                    TOTAL_IVA
                    MONTO_TOTAL_C_IVA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

