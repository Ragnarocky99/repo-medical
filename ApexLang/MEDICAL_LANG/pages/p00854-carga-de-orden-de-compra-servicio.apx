    region generacion-cuotas (
        name: Generacion Cuotas
        type: staticContent
        layout {
            sequence: 210
            parentRegion: @carga-de-orden-de-compra-servicio
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM CMW_PEDIDOS_DETALLE_CP
                 WHERE ID_PEDIDO_CAB = :P854_ID
                ```
        }
    )

    region generacion-cuotas-2 (
        name: Generacion Cuotas
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @generacion-cuotas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM CMW_PEDIDOS_DETALLE_CP
                 WHERE ID_PEDIDO_CAB = :P854_ID
                ```
        }
    )

    region generacion-factura (
        name: Generacion Factura
        type: staticContent
        layout {
            sequence: 220
            parentRegion: @carga-de-orden-de-compra-servicio
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: gen_factura
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM CMW_CUOTAS_PED
                 WHERE ID_PEDIDO_CAB = :P854_ID
                HAVING SUM(TOT_SALDO) != 0
                ```
        }
    )

    region seleccionar-conceptos (
        name: Seleccionar Conceptos
