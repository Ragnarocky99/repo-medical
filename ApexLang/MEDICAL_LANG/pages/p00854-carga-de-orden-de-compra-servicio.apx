    dynamicAction valida-referencia (
        name: Valida Referencia
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P854_REFERENCIA_FAC
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fact varchar2(20);
                    
                    begin
                        if :P854_TIP_COMPROBANTE_FAC is not null AND :P854_TIP_COMPROBANTE_FAC <> 'FEX' then
                            if (length(:P854_REFERENCIA_FAC) > 6 and length(:P854_REFERENCIA_FAC) < 14) 
                                and (nvl(:P854_IVA_INCLUIDO_FAC,'N') = 'S' or :P854_TIP_COMPROBANTE_FAC IN  ('RTI'))  then
                    
                                conv_fact := replace(:P854_REFERENCIA_FAC,'-','');
                                conv_fact := substr(:P854_REFERENCIA_FAC,1,3)||'-'||
                                                          substr(:P854_REFERENCIA_FAC,4,3)||'-'||
                                                          lpad(substr(:P854_REFERENCIA_FAC,7,7),7,'0');
                    
                                if ( ( SUBSTR(conv_fact,4,1) != '-' or  SUBSTR(conv_fact, 8,1) != '-' )  and (nvl(:P854_IVA_INCLUIDO_FAC,'N') = 'S'  or
                                    :P854_TIP_COMPROBANTE_FAC IN ('RTI'))  AND :P854_TIP_COMPROBANTE_FAC != 'IDE' AND :P854_TIP_COMPROBANTE_FAC != 'DES' )   then
                    
                                    raise_application_error(-20000,'El nro. de factura debe tener el siguiente formato 999-999-9999999');
                    
                                end if;
                            
                            elsif NVL(:P854_IVA_INCLUIDO_FAC,'N') = 'N' OR :P854_TIP_COMPROBANTE_FAC = 'IDE' OR :P854_TIP_COMPROBANTE_FAC = 'DES' THEN
                    
                                conv_fact := :P854_REFERENCIA_FAC;
                    
                            else
                                raise_application_error(-20000,'Cargar el nro. de factura solo con números');
                            end if;
                    
                        elsif :P854_TIP_COMPROBANTE_FAC = 'FEX' THEN
                    
                            conv_fact := :P854_REFERENCIA_FAC;
                            
                        else
                            raise_application_error(-20000,'Completar el tipo de comprobante para continuar con el nro. factura.');
                        end if;
                        :P854_REFERENCIA_FAC := conv_fact;
                    end;
                    ```
                itemsToSubmit: [
                    P854_REFERENCIA_FAC
                    P854_IVA_INCLUIDO_FAC
                ]
                itemsToReturn: P854_REFERENCIA_FAC
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

