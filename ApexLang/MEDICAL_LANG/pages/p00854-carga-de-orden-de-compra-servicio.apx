    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var i = 0;
            function recalculaImporte(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_importe   = model.getFieldKey("MONTO_TOTAL_C_IVA");
                var v_iva       = model.getFieldKey("TOTAL_IVA");
                var v_porc_iva = model.getFieldKey("IVA");
                var v_total_s_iva=model.getFieldKey('MONTO_TOTAL');
                var v_descuento = model.getFieldKey('DESCUENTO');
                var v_descuento_c_iva=model.getFieldKey('DESCUENTO_C_IVA');
                var vanulado = model.getFieldKey("ANULADO");
                var v_total_descuento =0;
                var v_total     = 0;
                var v_total_iva = 0;
                var v_total_gravadas_10=0;
                var v_total_gravadas_5=0;
                var v_total_exentas=0;
                var v_subtotal=0;
                var v_iva_10=0;
                var v_iva_5=0;
            
            
            
            
            
                model.forEach(function(r, index, id) {
            
                   if (v_iva =="") {
                        v_iva = 0;
                    }    
                   
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                         // Si el registro está anulado (ANULADO == "S") no se considera para los totales
                         if (r[vanulado] && String(r[vanulado]).toUpperCase() === "S") {
                             return; // continúa al siguiente registro
                         }
                         
                         if (parseInt(r[v_porc_iva])==10) {
                             let numeroIva10 = r[v_iva].replace(/\./g,'');
            
                             let numeroGravadas10=r[v_total_s_iva].replace(/\./g,'');
            
                               v_total_gravadas_10=v_total_gravadas_10+parseFloat(numeroGravadas10.replace(',','.'));
            
                               //v_iva_10=v_iva_10+parseFloat(r[v_iva].replace(/\./g,''));
                               v_iva_10=v_iva_10+parseFloat(numeroIva10.replace(',','.'));
            
                               
                         }else if(parseInt(r[v_porc_iva])==5){
                             let numeroIva5=r[v_iva].replace(/\./g,'');
            
                             let numeroGravadas5=r[v_total_s_iva].replace(/\./g,'');
            
                            v_total_gravadas_5=v_total_gravadas_5+parseFloat(numeroGravadas5.replace(',','.'));
            
                            v_iva_5=v_iva_5+parseFloat(numeroIva5.replace(',','.'));
                         }else{
                             let numeroExentas=r[v_total_s_iva].replace(/\./g,'')
                            v_total_exentas=v_total_exentas+parseFloat(numeroExentas.replace(',','.'));
                         }
            
                         let numeroTotal=r[v_importe].replace(/\./g,'');
                         let numeroTotalIVA=r[v_iva].replace(/\./g,'');
            
                        v_total      = v_total     + parseFloat(numeroTotal.replace(',','.'));
                        v_total_iva  = v_total_iva + parseFloat(numeroTotalIVA.replace(',','.'));
                        v_total_descuento=v_total_descuento+(parseFloat(r[v_descuento_c_iva].replace(/\./g,'')))-(parseFloat(r[v_descuento_c_iva].replace(/\./g,'')))*
                        (parseFloat(r[v_porc_iva].replace(/\./g,'')))/(100+parseFloat(r[v_porc_iva].replace(/\./g,'')))
                        
                    }
                    
                });
                  v_subtotal=v_total-v_total_iva;
                  v_total_descuento = 0;
            
                  console.log(v_total_gravadas_10.toString().replace(/\./g,','))
            
                $s('P854_TOT_COMPROBANTE',  v_total.toString().replace(/\./g,','));
                $s('P854_SUBTOTAL',  (v_total_gravadas_10 + v_total_gravadas_5).toString().replace(/\./g,','));
                $s('P854_TOT_GRAVADAS_5',  v_total_gravadas_5.toString().replace(/\./g,','));
                $s('P854_TOT_GRAVADAS_10',  v_total_gravadas_10.toString().replace(/\./g,','));
                $s('P854_TOT_EXENTAS',  v_total_exentas.toString().replace(/\./g,','));
                $s('P854_TOT_IVA',  v_total_iva.toString().replace(/\./g,','));
                $s('P854_IVA_10',  v_iva_10.toString().replace(/\./g,','));
                $s('P854_IVA_5',  v_iva_5.toString().replace(/\./g,','));
                $s('P854_DESCUENTO_V',Math.round(parseFloat(v_total_descuento)));
                
            }
            
            function calculaTotCuotas(){
                var model= apex.region("Cuotas").widget().interactiveGrid("getCurrentView").model;
                var cant_registros = model.getTotalRecords();
            
                var v_cuota = model.getFieldKey("TOT_CUOTA") || 0;
                
                var v_totcuota  = 0;
            
                var v_saldo = model.getFieldKey("TOT_SALDO") || 0;
                
                var v_totsaldo  = 0;
                
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                        let vcl_cuota = r[v_cuota].replace(/\./g,'');
                        let vcl_saldo = r[v_saldo].replace(/\./g,'');
            
                        v_totcuota = v_totcuota  + parseFloat(vcl_cuota.replace(',','.'));
                        v_totsaldo = v_totsaldo  + parseFloat(vcl_saldo.replace(',','.'));
            
                        console.log("----detalle  total de saldo n. " + cant_registros + ": " + vcl_saldo + " cuota: " + vcl_cuota);
            /*
                            vtotal   := nvl( vtotal, 0 ) + nvl( vtot_cuota, 0 );
                            vdias    := vdias + :P392_INTERVALO_CUOTA;
            
                            IF nvl( vindice, 0 ) = nvl( :P392_CANT_CUOTAS, 1 ) THEN
                                IF nvl( vtotal, 0 ) < nvl( REPLACE(:P392_TOT_COMPROBANTE,'.',''), 0 ) THEN
                                    vtotal := round( nvl( REPLACE(:P392_TOT_COMPROBANTE,'.',''), 0 ) - nvl( vtotal, 0 ), :P392_DECIMALES );
                                    vtot_cuota := vtot_cuota + vtotal;
                                END IF;
                            END IF;
            */
            
                    }
                    
                    console.log("total saldo: " + v_totsaldo + ", total cuota: " + v_totcuota);
                });
            
                $s('P854_TOT_CUOTA',v_totcuota.toString().replace(/\./g,','));
                //$s('P392_CTOT_SALDO',v_totsaldo.toString().replace(/\./g,','));
            
            }
            
            function sumarSeleccionados() {
              var total = 0;
            
              // Obtener el grid y su modelo
              var $grid = apex.region("Detalles").widget().interactiveGrid("getViews", "grid");
              var model = $grid.model;
            
              // Recorrer los registros seleccionados
              var selectedRecords = $grid.getSelectedRecords();
              selectedRecords.forEach(function(record) {
                let valor = model.getValue(record, "MONTO_TOTAL_C_IVA"); // nombre de tu columna
                let monto = parseFloat(valor.replace(/\./g,''));
                if (!isNaN(monto)) {
                  total += monto;
                }
              });
            
              // Mostrar el total en un item de página
              $s("P854_TOT_CUOTA", total);
            }
            
            ```
