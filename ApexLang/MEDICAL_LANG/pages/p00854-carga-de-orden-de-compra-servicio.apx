    dynamicAction generar-cuota-accion (
        name: GENERAR_CUOTA_ACCION
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @generar-cuota
        }

        action borrar-regi-det (
            name: BORRAR_REGI_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Cuotas").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action borrar-regi-det-2 (
            name: BORRAR_REGI_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Cuotas").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action calc-totales-cuotas (
            name: CALC_TOTALES_CUOTAS
            action: executeJsCode
            settings {
                jsCode: calculaTotCuotas();
            }
            execution {
                sequence: 80
            }
            serverSideCondition {
                type: never
            }
        )

        action generar-json (
            name: GENERAR_JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P854_TOT_CUOTA IS NOT NULL THEN
                      
                            DECLARE
                              TMP_CUOTAS_CP_PRO CONSTANT VARCHAR2(255) :='CUOTAS_PED';
                              
                              vdias      NUMBER(18) := 0;
                              vindice    NUMBER(13);
                              vtot_cuota NUMBER(20,3);
                              vtotal     NUMBER(20,3);
                              vfec_venc  DATE;
                              vdia_sem   VARCHAR2(12);
                              v1er_reg   VARCHAR2(11) := 'S';
                              vperiodo   VARCHAR2(5);
                              vTotParcial      number(18,3);
                              v_id_prove NUMBER(10)   := :P854_ID_PROVEEDOR;
                              vdecimales bsw_monedas.decimales%type := moneda_decimales(:P854_ID_MONEDA);
                              
                            BEGIN
                          
                                vfec_venc := TO_DATE(:P854_FEC_COMPROBANTE, 'DD/MM/YYYY') + :P854_DIAS_CUOTA;
                                vtot_cuota := round( nvl( REPLACE(:P854_TOT_CUOTA,'.',''), 0 ) /
                                               nvl( :P854_CANT_CUOTAS, 1 ), vdecimales);
                                
                                IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_CUOTAS_CP_PRO) THEN
                                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_CUOTAS_CP_PRO);
                                END IF;
                    
                                APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_CUOTAS_CP_PRO);
                                --:P854_CTOT_SALDO := 0;  
                               -- :P854_CTOT_CUOTA := 0;  
                    
                                FOR vindice IN 1..:P854_CANT_CUOTAS LOOP
                               
                                    IF NVL(:P854_INTERVALO_CUOTA,0) = 30 THEN
                                       vfec_venc := add_months(TO_DATE(:P854_FEC_COMPROBANTE, 'DD/MM/YYYY'), vindice );
                                    ELSE
                                       vfec_venc := vfec_venc + :P854_INTERVALO_CUOTA;
                                    END IF;
                    
                                    vperiodo := :P854_INTERVALO_CUOTA;
                                    vdia_sem := TO_CHAR( TO_DATE( vfec_venc ),'DAY' );
                                    vtotal   := nvl( vtotal, 0 ) + nvl( vtot_cuota, 0 );
                                    vdias    := vdias + :P854_INTERVALO_CUOTA;
                    
                                    IF nvl( vindice, 0 ) = nvl( :P854_CANT_CUOTAS, 1 ) THEN
                                    --    IF nvl( vtotal, 0 ) < nvl( REPLACE(:P854_TOT_CUOTA,'.',''), 0 ) THEN
                                              vTotParcial :=  round((REPLACE(:P854_TOT_CUOTA,'.','')/:P854_CANT_CUOTAS),vdecimales);
                                              vtotal := round(REPLACE(:P854_TOT_CUOTA,'.','')-(vTotParcial * (:P854_CANT_CUOTAS-1)) ,vdecimales);
                                          vtot_cuota:=vtotal;
                                      --  END IF;
                                    END IF;
                    
                             
                                    APEX_COLLECTION.ADD_MEMBER(
                                        p_collection_name => TMP_CUOTAS_CP_PRO,
                                        p_c001 => vindice,      --num_cuota
                                        p_c002 => vperiodo,     --periodo
                                        p_c003 => vfec_venc,    --fec_venc
                                        p_c004 => vdia_sem,     --dias
                                        p_N001 => vtot_cuota,   --total_cuota
                                        p_N002 => vtot_cuota,   
                                        p_c007 => v_id_prove    
                                    );
                    
                                END LOOP;
                            END;
                        
                        --END IF;
                    ELSE
                        RAISE_APPLICATION_ERROR(-20000,'Para generar la cuota debe cargar el comprobante.');    
                    END IF;
                    
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                      
                        OPEN l_cursor FOR
                        SELECT  C001 AS NRO_CUOTA,
                                C002 AS PERIODO,
                                C003 AS VENCIMIENTO,
                                C004 AS DIAS,
                                N001 AS TOT_CUOTA,
                                N002 AS TOT_SALDO,
                                C007 AS ID_PROVEEDOR
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'CUOTAS_PED'
                        ORDER BY TO_NUMBER(C001) DESC;
                    
                      APEX_JSON.initialize_clob_output;
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P854_JSON_CUOTA:=JSON_DETALLE;
                    END;
                    ```
                itemsToSubmit: [
                    P854_CANT_CUOTAS
                    P854_DIAS_CUOTA
                    P854_JSON_CUOTA
                    P854_INTERVALO_CUOTA
                    P854_TIP_COMPROBANTE
                    P854_FEC_COMPROBANTE
                    P854_DECIMALES
                    P854_TIP_SALDO
                    P854_ID_MONEDA
                    P854_TOT_COMPROBANTE
                    P854_TOT_CUOTA
                ]
                itemsToReturn: P854_JSON_CUOTA
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action insert-json-det (
            name: INSERT_JSON_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P854_JSON_CUOTA'));
                    
                    console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                        var grid = apex.region("Cuotas").call("getViews").grid;
                        //grid.view$.grid("option", "editable", true);
                        //editable true
                        grid.model.setOption("editable", true);
                        grid.setEditMode(true);
                    
                        for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                            //Con este codigo podemos insertar una nueva fila en el detalle de cuotas 
                    
                            var $widget = apex.region("Cuotas").widget();
                            var $grid   = $widget.interactiveGrid("getViews", "grid");
                            var $model  = $grid.model;
                                //$grid.setEditMode(true);
                    
                                //grid.model.setOption("editable", false);
                                //grid.setEditMode(false);
                                
                            //insert new record on a model
                            var newRecordId = $model.insertNewRecord();
                    
                            //continuation of above code
                            //get the new record
                    
                            var $newRecord = $model.getRecord(newRecordId);
                            orden=orden+1;
                            
                            $model.setValue($newRecord, "NUM_CUOTA",(json_detalle.DETALLE[i].NRO_CUOTA).toString());
                            $model.setValue($newRecord, "PERIODO_DIAS",(json_detalle.DETALLE[i].PERIODO).toString());
                            $model.setValue($newRecord, "FEC_VENCIMIENTO",(json_detalle.DETALLE[i].VENCIMIENTO).toString());
                            //$model.setValue($newRecord, "DIAS",(json_detalle.DETALLE[i].DIAS).toString());
                            $model.setValue($newRecord, "TOT_CUOTA",(json_detalle.DETALLE[i].TOT_CUOTA).toString().replace(/\./g,','));
                            $model.setValue($newRecord, "TOT_SALDO",(json_detalle.DETALLE[i].TOT_SALDO).toString().replace(/\./g,','));
                            //$model.setValue($newRecord, "ID_PROVEEDOR",(json_detalle.DETALLE[i].ID_PROVEEDOR).toString()); //Alguien agregó esto, por eso daba error.
                        }
                        //grid.model.setOption("editable", false);
                        //grid.setEditMode(true);
                        
                    }
                    ```
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

