page 249 (
    name: Reporte Detalle Venta
    alias: REPORTE-DETALLE-VENTA1
    title: Reporte Detalle Venta
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                DECLARE
                vcName PK_JRXML2PDF_TYPES.tName;
                
                l_ReportList PK_JRXML2PDF_TYPES.tReportNameList;
                
                r_Params PK_JRXML2PDF_REPGEN.TPARAMETER;
                l_Params PK_JRXML2PDF_REPGEN.TPARAMLIST;
                
                bl BLOB;
                
                BEGIN
                
                
                vcName := 'Venta_detalle';
                
                
                r_Params.vcName := 'P_USER';
                r_Params.vcValue := :APP_USER;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_FECHA_INI';
                r_Params.vcValue := :P258_FECHA_INI;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_FECHA_FIN';
                r_Params.vcValue := :P258_FECHA_FIN;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_VEN';
                r_Params.vcValue := :P258_VENDEDOR;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_CLI';
                r_Params.vcValue := :P258_CLIENTE;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_ART';
                r_Params.vcValue := :P258_ARTICULO;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                
                
                l_ReportList(1) := vcName;
                
                
                
                bl := PK_JRXML2PDF_REPGEN.FK_RUN(i_lReports=>l_ReportList,
                i_lParams=>l_Params,
                i_bResetPageNumber=>false
                );
                
                PK_JRXML2PDF_REPGEN.PR_SHOW_REPORT(bl);
                APEX_APPLICATION.STOP_APEX_ENGINE;
                
                END;
                ```
        }
    )

)

