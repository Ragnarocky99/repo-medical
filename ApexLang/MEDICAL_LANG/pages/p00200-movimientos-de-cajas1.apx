page 200 (
    name: Movimientos de Cajas
    alias: MOVIMIENTOS-DE-CAJAS1
    title: Movimientos de Cajas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region movimientos-de-cajas (
        name: Movimientos de Cajas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NRO_MOV_CAJ,
                       ID_SUCURSAL,
                       FEC_MOV_CAJ,
                       ID_CAJA,
                       NRO_HABILITACION,
                       NUM_ASIENTO,
                       ANULADO,
                       FEC_ANULACION,
                       ID_USUARIO,
                       NUM_ASIENTO_ANUL,
                       TOT_NRO_MOV_CAJ,
                       ID_MONEDA,
                       TIPO_CAMBIO,
                       TIP_CAMBIO,
                       FEC_ALTA,
                       VUELTO,
                       ID_CORPORACION,
                       COD_USUARIO_AUD,
                       ID_CLIENTE,
                       ASIENTOS,
                       TRANSAC_PRONET,
                       ID_HABILITACION,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       IND_GEN_AUTO,
                       'ver detalle' as det_link
                  from CCW_MOVIMIENTOS_CAJAS
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 23156082514410770
        }

        savedReport 231565 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
