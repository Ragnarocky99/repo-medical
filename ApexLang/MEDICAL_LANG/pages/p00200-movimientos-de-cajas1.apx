        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Movimientos de Cajas
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @breadcrumb
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @movimientos-de-cajas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @movimientos-de-cajas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mov-caja-create (
        name: mov_caja_create
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

