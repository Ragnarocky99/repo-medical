        )

        column APEX$LINK (
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 201
                    items: {
                        P201_ID: \&ID.\
                    }
                    clearCache: 201
                    action: resetPagination
                }
                linkText: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            }
            source {
                type: none
            }
        )

        column ASIENTOS (
