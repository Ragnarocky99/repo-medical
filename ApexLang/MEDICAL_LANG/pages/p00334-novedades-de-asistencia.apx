            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @novedades-de-asistencia
            slot: rightOfInteractiveReportSearchBar
