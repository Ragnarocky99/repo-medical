page 334 (
    name: Novedades de Asistencia
    alias: NOVEDADES-DE-ASISTENCIA
    title: Novedades de Asistencia
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            td[headers="Foto"] img {   width: 74px; }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region novedades-de-asistencia (
        name: Novedades de Asistencia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_EMPLEADO,
                       FEC_INICIAL,
                       FEC_FINAL,
                       ID_MOTIVO,
                       COMENTARIO,
                       HORAS,
                       ID_SUCURSAL,
                       PERIODO,
                       IND_VACACIONES,
                       DIAS,
                       ID_CONCEPTO,
                       DESDE_HORA,
                       HASTA_HORA,
                       FEC_DEDUCCION,
                       ESTADO,
                       PROCESADO,
                       FEC_INSERT,
                       ID_USUARIO,
                       MONTO_DESCUENTO,
                       SER_LIQUID_AFECTO,
                       NRO_LIQUID_AFECTO,
                       COD_USUARIO_AUD,
                       DIRECCION_IP,
                       sys.dbms_lob.getlength(FOTO_COMPROBANTE),
                       DECODE(NVL(DESCUENTA, 'N'), 'N', 'No', 'S', 'Si') DESCUENTA,
                       ID_TIPO_NOVEDAD
                  from RHW_NOVEDADES
                 where ID_EMPRESA = :P0_ID_EMPRESA
                 and (id_motivo = :P334_MOTIVO or :P334_MOTIVO is null)
                 and (FEC_INICIAL >= :P334_FEC_INI or :P334_FEC_INI is null) 
                 and (FEC_FINAL <= :P334_FEC_FIN or :P334_FEC_FIN is null)
                 
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 335
                items: {
                    P335_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 13616264285243232
        }

