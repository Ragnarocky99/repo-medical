    pageItem P334_FEC_FIN (
        type: datePicker
        label {
            label: <p>Fecha Fin: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem P334_FEC_INI (
        type: datePicker
        label {
            label: <p>Fecha Inicio: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    pageItem P334_MOTIVO (
        type: popupLov
        label {
            label: <p>Motivo: &ensp;</p>
            alignment: left
