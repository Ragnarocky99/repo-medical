page 320 (
    name: Carga de Estados de Asistencia del Personal
    alias: CARGA-DE-ESTADOS-DE-ASISTENCIA-DEL-PERSONAL
    title: Carga de Estados de Asistencia del Personal
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P320_COD_ESTADO_ASI").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-estados-de-asistencia-del-personal (
        name: Carga de Estados de Asistencia del Personal
        type: form
        source {
            location: localDatabase
            tableName: RHW_ESTADOS_ASISTENCIAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P320_COD_ESTADO_ASI (
        type: textField
        label {
            label: <p>Cód. Estado Asist.:&ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: COD_ESTADO_ASI
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_ESTADO_ASI)), 0) + 1
                from RHW_ESTADOS_ASISTENCIAS A
                WHERE A.ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
    )

    pageItem P320_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P320_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P320_HORA (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: HORA
            dataType: date
        }
    )

    pageItem P320_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P320_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT E.ID FROM BSW_EMPRESAS E WHERE E.ID=:P0_ID_EMPRESA;
        }
    )

    pageItem P320_ID_SUCURSAL (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: ID_SUCURSAL
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_SUCURSAL
        }
    )

    pageItem P320_NRO_ORDEN (
        type: numberField
        label {
            label: <p>Nro. Orden: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: NRO_ORDEN
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT MAX(TO_NUMBER(A.NRO_ORDEN))+1
                from RHW_ESTADOS_ASISTENCIAS A
                WHERE A.ID_EMPRESA = :P0_COD_EMPRESA;
                ```
        }
    )

    pageItem P320_TIPO (
        type: popupLov
        label {
            label: <p>Tipo: &ensp;</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-tipos-estados-asistencia
        }
        layout {
            sequence: 70
            region: @carga-de-estados-de-asistencia-del-personal
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 1
        }
        source {
            formRegion: @carga-de-estados-de-asistencia-del-personal
            column: TIPO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P320_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P320_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P320_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 12201764191855243
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-estados-de-asistencia-del-personal (
        name: Initialize form Carga de Estados de Asistencia del Personal
        type: formInitialization
        formRegion: @carga-de-estados-de-asistencia-del-personal
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12200999656855242
        }
    )

    process process-form-carga-de-estados-de-asistencia-del-personal (
        name: Process form Carga de Estados de Asistencia del Personal
        type: formAutoRowProcessing
        formRegion: @carga-de-estados-de-asistencia-del-personal
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12201300541855242
        }
    )

)

