    button create (
        buttonName: CREATE
        label: Guardar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P808_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P808_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: [
                    P808_ID_TIPO_TAREA
                    P808_ID_EQUIPO
                    P808_ID_ESTADO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ocultar-items (
        name: Ocultar Items
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P808_ID
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P808_ID_ESTADO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setea-datos-usuario-fecha (
        name: Setea datos usuario/fecha
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P808_IND_FINALIZADO
        }
        serverSideCondition {
            type: never
        }

        action p808-fec-finalizado (
            name: P808_FEC_FINALIZADO
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: SYSDATE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P808_FEC_FINALIZADO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P808_IND_FINALIZADO
                value: S
            }
        )

        action p808-fec-finalizado-2 (
            name: P808_FEC_FINALIZADO
            action: setValue
            affectedElements {
                selectionType: items
                items: P808_FEC_FINALIZADO
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P808_IND_FINALIZADO
                value: N
            }
        )

        action p808-id-usuario-finaliza (
            name: P808_ID_USUARIO_FINALIZA
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER)
            }
            affectedElements {
                selectionType: items
                items: P808_ID_USUARIO_FINALIZA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P808_IND_FINALIZADO
                value: S
            }
        )

        action p808-id-usuario-finaliza-2 (
            name: P808_ID_USUARIO_FINALIZA
            action: setValue
            affectedElements {
                selectionType: items
                items: P808_ID_USUARIO_FINALIZA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P808_IND_FINALIZADO
                value: N
            }
        )

    )

    computation p808-nro-tarea (
        itemName: P808_NRO_TAREA
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(NRO_TAREA), 0) + 1
                  FROM CLW_GESTOR_TAREAS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P808_ID
        }
    )

