        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression:
                ```plsql
                :P808_IND_FINALIZADO = 'S' AND
                TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) NOT IN ('DIR', 'ADMIN')
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
