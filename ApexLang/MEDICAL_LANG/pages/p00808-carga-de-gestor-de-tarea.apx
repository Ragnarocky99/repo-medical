    region comentarios-2 (
        name: Comentarios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_GESTOR,
                       ID_INVOLUCRADO,
                       COMENTARIO,
                       ID_USUARIO_MOD,
                       FEC_MODIFICACION,
                       ID_MENCION,
                       CASE
                        WHEN TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) IN ('DIR', 'ADMIN') THEN 'UD'
                        WHEN TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) = :P808_ID_RESPONSABLE THEN 'UD'
                        WHEN ID_INVOLUCRADO = TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) THEN 'U'
                        ELSE ''
                       END ROW_OPERATION
                  from CLW_GESTOR_TAREAS_DET
                 where ID_GESTOR = :P808_ID
                ```
            pageItemsToSubmit: [
                P808_ID
                P808_ID_RESPONSABLE
            ]
        }
        layout {
            sequence: 10
            parentRegion: @comentarios
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            allowedRowOperationsColumn: ROW_OPERATION
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
