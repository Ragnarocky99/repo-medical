    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @locales
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 537
                clearCache: 537
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @locales
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @locales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

