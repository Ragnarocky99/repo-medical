page 536 (
    name: Locales
    alias: LOCALES
    title: Locales
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region locales (
        name: Locales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_LOCAL,
                       DESCRIPCION,
                       SUPERFICIE_MT2,
                       ID_SECTOR,
                       COD_NIVEL,
                       CTA_CTE_CTRAL,
                       NIR_ANDE,
                       CTA_CTE_ESSAP,
                       ID_CLIENTE,
                       IND_PROPIO,
                       ID_CATEGORIA,
                       CASE ESTADO
                       WHEN 'O' THEN 'Ocupado'
                       WHEN 'L' THEN 'Libre'
                       WHEN 'R' THEN 'Reparacion'
                       END ESTADO,
                       NRO_LOCAL,
                       COD_USUARIO_AUD,
                       FEC_ALTA,
                       NRO_PADRON,
                       OBSERVACION,
                       ID_SUCURSAL,
                       ID_PER_PROP,
                       VIDRIERA_MT2,
                       AREAS_COMUNES_MT2,
                       TIPO_LOCAL,
                       NRO_NIR_ANDE,
                       NRO_MED_ANDE,
                       ORDEN
                  from ACW_LOCALES
                  WHERE ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 537
                items: {
                    P537_ID: \#ID#\
                    P537_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 83071924055643142
        }

