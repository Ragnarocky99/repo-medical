page 534 (
    name: "Reporte de reparación de inmuebles "
    alias: CARGA-DE-REPARACIONES-INMUEBLES
    title: Reporte Reparaciones Inmuebles
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region reparaciones-de-inmuebles (
        name: Reparaciones de Inmuebles
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_CONTRATO,
                       FEC_OCURRENCIA,
                       NRO_COMPROBANTE,
                       TOT_COMPROBANTE,
                       ID_LOCAL,
                       ID_PROVEEDOR,
                       COD_USUARIO_AUD,
                       ID_REPARACION,
                       NRO_REPARACION
                  from ACW_REPARACIONES_INMUEBLES
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  AND (ID_LOCAL = :P534_LOCAL or :P534_LOCAL is null)
                  AND FEC_OCURRENCIA >=  :P534_FEC_DESDE
                  AND FEC_OCURRENCIA <=  :P534_FEC_HASTA
                  AND (ID_REPARACION = :P534_REPARACION or :P534_REPARACION is null)
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 84181183983882432
        }

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column FEC_OCURRENCIA (
            type: plainText
            heading {
                heading: Fecha Ocurrencia
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_CONTRATO (
            type: plainTextBasedOnLov
