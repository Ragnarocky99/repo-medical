            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reparaciones de Inmuebles
        }

        savedReport 843346 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_USUARIO_AUD (
                sequence: 9
            )

            displayColumn FEC_OCURRENCIA (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_CONTRATO (
                sequence: 3
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn ID_LOCAL (
                sequence: 7
            )

            displayColumn ID_PROVEEDOR (
                sequence: 8
            )

            displayColumn ID_REPARACION (
                sequence: 10
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 5
            )

            displayColumn TOT_COMPROBANTE (
                sequence: 6
            )

        )

    )

    pageItem P534_FEC_DESDE (
        type: datePicker
        label {
            label: <p>Fecha Desde: </p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    pageItem P534_FEC_HASTA (
        type: datePicker
        label {
            label: <p>Fecha hasta: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem P534_LOCAL (
        type: popupLov
        label {
            label: <p>Local: </p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-locales
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P534_REPARACION (
        type: popupLov
        label {
            label: <p>Reparación: </p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-reparaciones
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button ejecutar (
        buttonName: Ejecutar
        label: Ejecutar
        layout {
            sequence: 60
            region: @filtro
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: Imprimir
        label: Imprimir
        layout {
            sequence: 50
            region: @filtro
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P534_FEC_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P534_FEC_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P534_FEC_HASTA,'/','');
                            conv_fecha := substr(:P534_FEC_HASTA,1,2)||'/'||
                                                      substr(:P534_FEC_HASTA,3,2)||'/'||
                                                      lpad(substr(:P534_FEC_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P534_FEC_HASTA := conv_fecha;
                            ELSIF (length(:P534_FEC_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P534_FEC_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P534_FEC_HASTA
                itemsToReturn: P534_FEC_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P534_FEC_DESDE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P534_FEC_DESDE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P534_FEC_DESDE,'/','');
                            conv_fecha := substr(:P534_FEC_DESDE,1,2)||'/'||
                                                      substr(:P534_FEC_DESDE,3,2)||'/'||
                                                      lpad(substr(:P534_FEC_DESDE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P534_FEC_DESDE := conv_fecha;
                            ELSIF (length(:P534_FEC_DESDE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P534_FEC_DESDE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P534_FEC_DESDE
                itemsToReturn: P534_FEC_DESDE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 542
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 542
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

