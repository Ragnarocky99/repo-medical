        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro Comprobante
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column NRO_REPARACION (
            type: plainText
            heading {
                heading: Nro Reparacion
                alignment: center
            }
            layout {
                sequence: 110
