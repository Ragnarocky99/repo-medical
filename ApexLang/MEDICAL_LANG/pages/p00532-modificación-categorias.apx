page 532 (
    name: MODIFICACIÓN CATEGORIAS
    alias: MODIFICACIÓN-CATEGORIAS
    title: MODIFICACIÓN CATEGORIAS
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P532_COD_CATEGORIA").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region modificación-categorias (
        name: MODIFICACIÓN CATEGORIAS
        type: form
        source {
            location: localDatabase
            tableName: ACW_CATEGORIAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P532_COD_CATEGORIA (
        type: textField
        label {
            label: <p>Código: </p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @modificación-categorias
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @modificación-categorias
            column: COD_CATEGORIA
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(R.COD_CATEGORIA)), 0)+1 
                FROM ACW_CATEGORIAS R 
                WHERE R.ID_EMPRESA=:P0_ID_EMPRESA
                
                ```
        }
    )

    pageItem P532_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 50
            region: @modificación-categorias
            slot: regionBody
        }
        source {
            formRegion: @modificación-categorias
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
    )

    pageItem P532_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @modificación-categorias
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @modificación-categorias
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P532_ID (
        type: hidden
        layout {
            sequence: 10
            region: @modificación-categorias
            slot: regionBody
        }
        source {
            formRegion: @modificación-categorias
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P532_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @modificación-categorias
            slot: regionBody
        }
        source {
            formRegion: @modificación-categorias
            column: ID_EMPRESA
            dataType: number
            primaryKey: true
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P532_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P532_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 83372218148464195
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-modificación-categorias (
        name: Initialize form MODIFICACIÓN CATEGORIAS
        type: formInitialization
        formRegion: @modificación-categorias
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 83371468725464195
        }
    )

    process process-form-modificación-categorias (
        name: Process form MODIFICACIÓN CATEGORIAS
        type: formAutoRowProcessing
        formRegion: @modificación-categorias
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 83371847540464195
        }
    )

)

