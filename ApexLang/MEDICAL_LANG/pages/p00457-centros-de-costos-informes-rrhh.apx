page 457 (
    name: Centros de Costos Informes RR.HH.
    alias: CENTROS-DE-COSTOS-INFORMES-RRHH
    title: Centros de Costos Informe RR.HH.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region centros-de-costos-informes-rr-hh (
        name: Centros de Costos Informes RR.HH.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT RI.ID,
                       RI.ID_EMPRESA,
                       RI.COD_CENTRO_INFORME,
                       RI.DESCRIPCION,
                       RI.ID_SUCURSAL,
                       RI.ID_CENTRO_COSTO
                FROM RHW_CENTRO_COSTO_INFORMES RI
                WHERE RI.ID_EMPRESA = :P0_ID_EMPRESA
                ```
            pageItemsToSubmit: P0_ID_EMPRESA
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 458
                items: {
                    P458_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 54642681440712702
        }

        column COD_CENTRO_INFORME (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_CENTRO_COSTO (
            type: plainTextBasedOnLov
            heading {
                heading: Centro de Costo RR.HH.
                alignment: center
            }
            lov {
                lov: @lv-centro-pago-rh
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Centros de Costos Informes RR.HH.
        }

        savedReport 546710 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CENTRO_INFORME (
                sequence: 3
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_CENTRO_COSTO (
                sequence: 6
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn ID_SUCURSAL (
                sequence: 5
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @centros-de-costos-informes-rr-hh
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 458
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

)

