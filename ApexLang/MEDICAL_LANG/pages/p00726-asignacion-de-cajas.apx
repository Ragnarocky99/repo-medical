page 726 (
    name: Asignacion de Cajas
    alias: ASIGNACION-DE-CAJAS
    title: Asignacion de Cajas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        width: 1000
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            main::before {
            
              width: 0px;
            
            }
            
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            pp{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:30px;
                color:#03E80D;
                text-align: left;
                
            
            }
            
            
            
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asignacion-de-cajas (
        name: Asignacion de Cajas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT c.id,
                       c.id_cliente,
                       c.fecha_entrega_sug,
                       c.cantidad_cajas,
                       c.cod_usuario_aud,
                       c.fec_alta,
                       c.id_proveedor,
                       c.direccion_envio,
                       c.observacion,
                       c.fecha_solicitud,
                       c.estado,
                       c.id_motivo_reparto,
                       c.costo_tercerizado
                FROM RPW_SOLICITUD_REPARTO_CAB C
                WHERE C.ID IN (SELECT SD.ID_SOLICITUD_REP_CAB
                               FROM RPW_REPARTO_DETALLE RD, RPW_SOLICITUD_REPARTO_DET SD
                               WHERE RD.ID_SOLICITUD_DET = SD.ID
                                 AND RD.ID_REPARTO_CABECERA = :P726_ID_SOLICITUD)
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 71906900216129412
        }

        savedReport 719500 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @COSTO_TERCERIZADO
                layout {
                    width: 100.812
                    sequence: 6
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_CLIENTE
                layout {
                    width: 72
                    sequence: 4
                }
            )

            displayColumn (
                column: @FECHA_ENTREGA_SUG
                layout {
                    width: 104
                    sequence: 11
                }
            )

            displayColumn (
                column: @CANTIDAD_CAJAS
                layout {
                    width: 73
                    sequence: 5
                }
            )

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @FEC_ALTA
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ID_PROVEEDOR
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DIRECCION_ENVIO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @OBSERVACION
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @FECHA_SOLICITUD
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ESTADO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @ID_MOTIVO_REPARTO
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CANTIDAD_CAJAS (
            type: numberField
            heading {
                heading: <p>Cantidad Cajas</p>
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CANTIDAD_CAJAS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column COD_USUARIO_AUD (
            type: textField
            heading {
                heading: <p>Cod Usuario Aud</p>
            }
            layout {
                sequence: 70
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                valueRequired: true
                maxLength: 16
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column COSTO_TERCERIZADO (
            type: numberField
            heading {
                heading: <p>Costo Tercerizado</p>
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: COSTO_TERCERIZADO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DIRECCION_ENVIO (
            type: hidden
            layout {
                sequence: 100
            }
            source {
                databaseColumn: DIRECCION_ENVIO
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ESTADO (
            type: hidden
            layout {
                sequence: 130
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column FECHA_ENTREGA_SUG (
            type: datePicker
            heading {
                heading: <p>Fecha Entrega Sug</p>
            }
            layout {
                sequence: 50
            }
            appearance {
                cssClasses: is-readonly
            }
            source {
                databaseColumn: FECHA_ENTREGA_SUG
                dataType: date
                queryOnly: true
            }
        )

        column FECHA_SOLICITUD (
            type: datePicker
            heading {
                heading: <p>Fecha Solicitud</p>
            }
            layout {
                sequence: 120
            }
            appearance {
                cssClasses: is-readonly
            }
            source {
                databaseColumn: FECHA_SOLICITUD
                dataType: date
                queryOnly: true
            }
        )

        column FEC_ALTA (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: FEC_ALTA
                dataType: date
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_CLIENTE (
            type: popupLov
            heading {
                heading: <p>Cliente</p>
            }
            lov {
                type: sharedComponent
                lov: @lv-clientes
            }
            layout {
                sequence: 40
            }
            appearance {
                cssClasses: is-readonly
            }
            source {
                databaseColumn: ID_CLIENTE
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_MOTIVO_REPARTO (
            type: hidden
            layout {
                sequence: 140
            }
            source {
                databaseColumn: ID_MOTIVO_REPARTO
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_PROVEEDOR (
            type: popupLov
            heading {
                heading: <p>Proveedor</p>
            }
            lov {
                type: sharedComponent
                lov: @lv-proveedores
            }
            layout {
                sequence: 90
            }
            appearance {
                cssClasses: is-readonly
            }
            source {
                databaseColumn: ID_PROVEEDOR
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column OBSERVACION (
            type: textField
            heading {
                heading: <p>Observacion</p>
            }
            layout {
                sequence: 110
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: OBSERVACION
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Asignacion de Cajas
        }
    )

    pageItem P726_ID_SOLICITUD (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @asignacion-de-cajas
            slot: regionBody
        }
    )

    process asignacion-de-cajas-save-interactive-grid-data (
        name: Asignacion de Cajas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @asignacion-de-cajas
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 71908474175129427
        }
    )

    process setear-id (
        name: setear id
        type: executeCode
        source {
            plsqlCode: :ID := :P726_ID_SOLICITUD;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 71908767567129430
        }
    )

)

