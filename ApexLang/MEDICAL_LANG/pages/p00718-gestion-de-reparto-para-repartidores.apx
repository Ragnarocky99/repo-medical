    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @lista-de-planillas-de-reparto
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 725
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction paginacion-ir (
        name: PAGINACION IR
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total número de filas:
                titleOfFirstPage: Primera página
                titleOfLastPage: Última página
            }
            affectedElements {
                selectionType: region
                region: @lista-de-planillas-de-reparto
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P718_NRO_PLANILLA
                P718_FEC_DESDE
                P718_FEC_HASTA
                P718_VENDEDOR
                P718_UNIDAD
                P718_REPARTIDOR
                P718_ESTADO
                P718_ZONA
                P718_ARTICULO
                P718_ID_MOTIVO_REPARTO
                P718_ESTADO_RD
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-planillas-de-reparto
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action planilla-de-reparto (
            name: Planilla de Reparto
            action: refresh
            affectedElements {
                selectionType: region
                region: @planilla-de-reparto
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

