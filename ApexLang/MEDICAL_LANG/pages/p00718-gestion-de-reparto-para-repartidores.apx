    region lista-de-planillas-de-reparto (
        name: Lista de Planillas de Reparto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RC.ID,
                       RC.ID_EMPRESA,
                       RC.NRO_PLANILLA,
                       RC.FEC_PLANILLA,
                       RC.ID_REPARTIDOR,
                       RC.ID_VEHICULO,
                       RC.ID_SUCURSAL,
                       'RENDIDO',
                       /*Case RC.ESTADO
                       WHEN 'S' THEN
                        'Rendido'
                       ELSE
                        'Pendiente'*/
                       CASE nvl(rc.estado,'N')
                         WHEN 'N' then 'Pendiente a Rendir'
                         WHEN 'S' then 'Rendido'
                       END AS ESTADO,
                       RC.ID_USUARIO,
                       RC.ID_ZONA,
                       RC.FEC_VENCIMIENTO,
                       RC.COD_USUARIO_AUD,
                       RC.ID_PLANILLA_INGRESO,
                       RC.ID_SUCURSAL_CENTRAL,
                       RC.ID_REPARTIDOR_AYUDANTE,
                       RC.HORA_SALIDA,
                       RC.HORA_VUELTA,
                       RC.KM_INICIAL,
                       RC.KM_FINAL,
                       ID_VENDEDOR,
                       RC.OBSERVACION,
                       MR.DESCRIPCION AS MOTIVO_REPARTO,
                       'IMPRIMIR',
                       '<span class="fa fa-send" aria-hidden="true"></span>' IMPRI_LINK,
                       'ORDENAR',
                       '<span class="fa fa-send" aria-hidden="true"></span>' ORDEN_LINK
                  from RPW_REPARTO_CABECERA RC
                  left join RPW_MOTIVOS_REPARTO MR ON MR.ID = RC.ID_MOTIVO_REPARTO
                  WHERE RC.ID_EMPRESA = :P0_ID_EMPRESA
                    AND (RC.ID_REPARTIDOR = (SELECT R.ID FROM RPW_REPARTIDORES R
                                            WHERE R.ID_USUARIO = TRAE_ID_USUARIO(:P0_ID_EMPRESA,:APP_USER)) or :APP_USER ='INV')
                   --or 1=1 ??
                    AND RC.ID_SUCURSAL = :P0_COD_SUCURSAL
                    AND (:P718_NRO_PLANILLA = RC.NRO_PLANILLA OR :P718_NRO_PLANILLA IS NULL)
                    AND (:P718_VENDEDOR = RC.ID_VENDEDOR OR :P718_VENDEDOR IS NULL)
                    AND (:P718_REPARTIDOR = RC.ID_REPARTIDOR OR :P718_REPARTIDOR IS NULL)
                    AND (:P718_UNIDAD = RC.ID_VEHICULO OR :P718_UNIDAD IS NULL)
                    AND (:P718_ESTADO = RC.ESTADO OR :P718_ESTADO IS NULL)
                    AND (:P718_ZONA = RC.ID_ZONA OR :P718_ZONA IS NULL)
                    AND RC.FEC_PLANILLA BETWEEN :P718_FEC_DESDE AND :P718_FEC_HASTA
                    AND (:P718_ARTICULO IN (SELECT CD.ID_ARTICULO 
                                                     FROM VTW_COMPROBANTES_DETALLE CD, VTW_COMPROBANTES_CABECERA CC, RPW_REPARTO_DETALLE RD 
                                                    WHERE RD.ID_COMPROBANTE_CABECERA = CC.ID
                                                      AND CC.ID = CD.ID_COMPROBANTE_CABECERA
                                                      AND RD.ID_REPARTO_CABECERA = RC.ID)
                            OR :P718_ARTICULO IS NULL)
                    AND (RC.ID_MOTIVO_REPARTO = :P718_ID_MOTIVO_REPARTO OR :P718_ID_MOTIVO_REPARTO IS NULL)
                  ORDER BY RC.NRO_PLANILLA DESC
                    
                ```
            pageItemsToSubmit: [
                P718_NRO_PLANILLA
                P718_FEC_DESDE
                P718_FEC_HASTA
                P718_VENDEDOR
                P718_UNIDAD
                P718_REPARTIDOR
                P718_ESTADO
                P718_ZONA
                P718_ARTICULO
                P718_ID_MOTIVO_REPARTO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
