    region planilla-de-reparto (
        name: Planilla de Reparto
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  RC.ID,
                        RC.FEC_PLANILLA,
                        RC.NRO_PLANILLA,
                        UPPER(VE.MARCA)||' ('||VE.COD_VEHICULO||')'||DECODE(VE.CHAPA, NULL, NULL, ' - '||VE.CHAPA) VEHICULO,
                        CASE NVL(RC.ESTADO,'N')
                            WHEN 'N' THEN 'PENDIENTE A RENDIR'
                            WHEN 'S' THEN 'RENDIDO'
                        END AS ESTADO,
                        (SELECT LISTAGG(
                                    '<a href="f?p=' || :APP_ID || ':717:' || :APP_SESSION || '::NO::P717_ID:' || RD1.ID || '">' || RD1.ORDEN_RUTEO || ' ' || RD1.NRO_COMPROBANTE || ' - ' || NVL(NVL(PC.NOMB_FANTASIA, PC.NOMBRE), NVL(PP.NOMB_FANTASIA, PP.NOMBRE))||/* ' (' || DECODE(NVL(RD.ESTADO, 'PE'), 'EN', 'Entregado', 'PA', 'Parcial', 'RI', 'Rechazo Interno', 'RE', 'Rechazo Externo', 'NA', 'No Alcanzado', 'Pendiente') || ')' ||*/ '</a>', 
                                    '<br>'
                                ) WITHIN GROUP (ORDER BY RD1.ID, RD1.ORDEN_RUTEO)
                           FROM RPW_REPARTO_DETALLE RD1
                           JOIN RPW_SOLICITUD_REPARTO_DET SD1 ON SD1.ID = RD1.ID_SOLICITUD_DET
                           JOIN RPW_SOLICITUD_REPARTO_CAB SC1 ON SC1.ID = SD1.ID_SOLICITUD_REP_CAB
                           LEFT JOIN  CCW_CLIENTES         CL ON CL.ID = SC1.ID_CLIENTE
                           LEFT JOIN  CMW_PROVEEDORES      PR ON PR.ID = SC1.ID_PROVEEDOR
                           LEFT JOIN  BSW_PERSONAS         PC ON PC.ID = CL.ID_PERSONA
                           LEFT JOIN  BSW_PERSONAS         PP ON PP.ID = PR.ID_PERSONA
                          WHERE RD1.ID_REPARTO_CABECERA = RC.ID
                            AND (NVL(RD1.ESTADO, 'PE') = :P718_ESTADO_RD OR :P718_ESTADO_RD IS NULL)
                            AND ROWNUM <= 30) COMPROBANTES
                  FROM  RPW_REPARTO_CABECERA      RC
                  JOIN  RPW_VEHICULOS             VE ON VE.ID = RC.ID_VEHICULO
                  JOIN  RPW_REPARTO_DETALLE       RD ON RC.ID = RD.ID_REPARTO_CABECERA
                  JOIN  RPW_SOLICITUD_REPARTO_DET SD ON SD.ID = RD.ID_SOLICITUD_DET
                  JOIN  RPW_SOLICITUD_REPARTO_CAB SC ON SC.ID = SD.ID_SOLICITUD_REP_CAB
                  LEFT JOIN RPW_MOTIVOS_REPARTO   MR ON MR.ID = RC.ID_MOTIVO_REPARTO
                 -- LEFT JOIN  CCW_CLIENTES         CL ON CL.ID = SC.ID_CLIENTE
                 -- LEFT JOIN  CMW_PROVEEDORES      PR ON PR.ID = SC.ID_PROVEEDOR
                 -- LEFT JOIN  BSW_PERSONAS         PC ON PC.ID = CL.ID_PERSONA
                 -- LEFT JOIN  BSW_PERSONAS         PP ON PP.ID = PR.ID_PERSONA
                 WHERE RC.ID_EMPRESA  = :P0_ID_EMPRESA
                   AND RC.ID_SUCURSAL = :P0_ID_SUCURSAL
                   AND RC.ID_REPARTIDOR = (SELECT R.ID FROM RPW_REPARTIDORES R
                                            WHERE R.ID_USUARIO = TRAE_ID_USUARIO(:P0_ID_EMPRESA,:APP_USER)) 
                   AND (NVL(RC.ESTADO, 'N') = :P718_ESTADO OR :P718_ESTADO IS NULL)
                   AND (NVL(RD.ESTADO, 'PE') = :P718_ESTADO_RD OR :P718_ESTADO_RD IS NULL)
                   AND (:P718_NRO_PLANILLA = RC.NRO_PLANILLA OR :P718_NRO_PLANILLA IS NULL)
                   --AND RD.ID NOT IN (8228, 8227, 8226, 8225, 8224, 8221, 8222, 8223)
                GROUP BY RC.ID, RC.FEC_PLANILLA, RC.NRO_PLANILLA, VE.MARCA, VE.COD_VEHICULO, VE.CHAPA, RC.ESTADO
                ORDER BY RC.FEC_PLANILLA DESC, RC.NRO_PLANILLA
                ```
            pageItemsToSubmit: [
                P718_ESTADO
                P718_ESTADO_RD
                P718_NRO_PLANILLA
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleA
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <p>
                    Nro. Planilla &NRO_PLANILLA.
                </p>
                ```
        }
        subtitle {
            advancedFormatting: true
            htmlExpression: <h4 class="a-CardView-subTitle ">&FEC_PLANILLA.</h4>
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="a-CardView-mainContent ">
                    <b>Vehiculo:&ensp;</b>&VEHICULO. <br>
                    <b>Estado:&ensp;</b>&ESTADO.
                </div>
                ```
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression: &COMPROBANTES!RAW.
        }
    )

