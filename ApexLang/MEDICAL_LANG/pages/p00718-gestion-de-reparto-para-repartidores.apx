        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Fin
        }
        default {
            type: expression
            plsqlExpression: SYSDATE
        }
    )

    pageItem P718_ID_MOTIVO_REPARTO (
        type: selectList
        label {
            label: <p>Motivo Reparto</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descripcion, id
                from rpw_motivos_reparto
                ```
            nullDisplayValue: -- Sin Seleccionar --
        }
        layout {
            sequence: 110
            region: @filtros-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

