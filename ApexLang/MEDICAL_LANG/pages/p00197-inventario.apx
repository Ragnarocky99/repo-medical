page 197 (
    name: Inventario
    alias: INVENTARIO
    title: Inventario
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #BOTON{
                width: 50px;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region inventario (
        name: Inventario
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NUM_INVENT,
                       FEC_INI_INVENT,
                       FEC_FIN_INVENT,
                       ID_SUCURSAL,
                         CASE IND_CERRADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       ICONO_CERRADO,
                         CASE IND_CERRADO
                       WHEN 'S' THEN 1
                       WHEN 'N' THEN 2
                       END AS 
                       ORDEN,
                       CASE IND_CERRADO
                       WHEN 'S' THEN ''
                       WHEN 'N' THEN 'Realizar Conteo'
                       END AS BOTON,
                       COD_USUARIO_AUD,
                       FEC_ALTA,
                       ID_SUCURSAL_CENTRAL,
                       ind_cerrado
                  from STW_INVENT_CAB
                  where id_empresa=:p0_cod_empresa
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 183
                items: {
                    P183_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 40201824763385268
        }

        column BOTON (
            type: link
            heading {
                heading: Conteo
                alignment: center
            }
            layout {
                sequence: 69
            }
            link {
                target: {
                    page: 181
                }
                linkText: #BOTON#
                linkAttributes: "class=\"t-Button t-Button--hot\"  "
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: BOTON
                endUserAlias: P
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Usuario Auditor
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column FEC_ALTA (
