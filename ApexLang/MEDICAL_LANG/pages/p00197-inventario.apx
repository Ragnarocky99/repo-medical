            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
