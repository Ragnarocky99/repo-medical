        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Inventario
        }

        savedReport 402063 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOTON (
                sequence: 8
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn FEC_ALTA (
                sequence: 6
            )

            displayColumn FEC_FIN_INVENT (
                sequence: 4
            )

            displayColumn FEC_INI_INVENT (
                sequence: 3
            )

            displayColumn ID_SUCURSAL (
                sequence: 1
            )

            displayColumn IND_CERRADO (
                sequence: 7
            )

            displayColumn NUM_INVENT (
                sequence: 2
            )

            sort (
                column: NUM_INVENT
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @inventario
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 183
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button excel (
        buttonName: EXCEL
        label: Excel
        layout {
            sequence: 10
            region: @inventario
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 609
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

