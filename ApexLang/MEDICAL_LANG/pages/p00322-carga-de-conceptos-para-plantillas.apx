    computation p322-cod-planilla (
        itemName: P322_COD_PLANILLA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT MAX(COD_PLANILLA)+1 FROM RHW_PLANILLAS WHERE ID_EMPRESA = :P0_ID_EMPRESA
        }
        serverSideCondition {
            type: itemIsNull
            item: P322_ID
        }
    )

    process carga-de-detalle-conceptos-save-interactive-grid-data (
        name: Carga de detalle Conceptos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @carga-de-detalle-conceptos
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                                insert into RHW_PLAN_CONCEPTOS
                                (ID_PLANILLA, ID_CONCEPTO, TIP_COLUMNA, COD_USUARIO_AUD, ID_SUCURSAL, ID_EMPRESA, DIRECCION_IP)
                                VALUES(:P322_ID,:ID_CONCEPTO,:TIP_COLUMNA,:COD_USUARIO_AUD,:ID_SUCURSAL,:ID_EMPRESA,:DIRECCION_IP);
                
                            WHEN 'U' then 
                   
                                update RHW_PLAN_CONCEPTOS 
                                    set --ID        = :ID,
                                        ---ID_PLANILLA      = :P322_ID,
                                        ID_CONCEPTO      = :ID_CONCEPTO,
                                        TIP_COLUMNA      = :TIP_COLUMNA,
                                        COD_USUARIO_AUD  = :COD_USUARIO_AUD,
                                        ID_SUCURSAL      = :ID_SUCURSAL,
                                        ID_EMPRESA       = :ID_EMPRESA,
                                        DIRECCION_IP     = :DIRECCION_IP    
                
                                    where  ID = :ID
                                    and ID_planilla = :P322_ID; 
                
                                     when 'D' then
                                delete RHW_PLAN_CONCEPTOS     
                                WHERE ID = :ID
                                       and ID_PLANILLA = :P322_ID;  
                    end case;
                
                    EXCEPTION
                when no_data_found then
                RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar al detalle'||:id_planilla);
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 12749325595101838
        }
    )

    process eliminar-linea (
        name: ELIMINAR_LINEA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Borra todas las lineas de detalle, al borrarse la cabecera  */
                delete from RHW_PLAN_CONCEPTOS 
                where id= :P322_ID;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13615804746243228
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

