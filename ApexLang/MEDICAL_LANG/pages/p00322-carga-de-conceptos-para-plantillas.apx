    region carga-de-detalle-conceptos (
        name: Carga de detalle Conceptos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_PLANILLA,
                       ID_CONCEPTO,
                       TIP_COLUMNA,
                       COD_USUARIO_AUD,
                       ID_SUCURSAL,
                       ID_EMPRESA,
                       DIRECCION_IP
                  from RHW_PLAN_CONCEPTOS
                 where ID_EMPRESA = :P0_ID_EMPRESA
                    and id_planilla = :P322_ID
                ```
            pageItemsToSubmit: P322_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
