page 512 (
    name: Formula
    alias: FORMULA
    title: Formula
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region formula (
        name: Formula
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select F.ID,
                       F.ID_EMPRESA,
                       F.COD_FORMULA,
                       F.CANT_HORAS,
                       F.ID_ARTICULO,
                       F.CANTIDAD,
                       F.ESTADO,
                       CASE F.ESTADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END ESTADO_ICON,
                       F.ID_USUARIO,
                       F.FEC_ALTA,
                       F.COMENTARIO,
                       F.RECETA,
                       F.ID_UNIDAD_MEDIDA,
                       F.CANTIDAD_UB,
                       F.NIVEL_AUT,
                       F.ID_SUCURSAL_DESTINO,
                       F.FEC_MODIF,
                       F.ID_USUARIO_MODIF,
                       F.TIP_FORMULA,
                       F.SE_INFORMA,
                       F.VAR_REFINERIA,
                       F.VAR_PACKING,
                       F.VIDA_UTIL_MES,
                       F.OBSERVACION
                  from PDW_FORMULA_CAB F
                  WHERE F.ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 513
                items: {
                    P513_ID: \#ID#\
                    P513_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 70863546938014485
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column CANTIDAD_UB (
            type: hidden
            heading {
                heading: Cantidad Ub
            }
            layout {
                sequence: 13
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column CANT_HORAS (
            type: hidden
            heading {
                heading: Cant Horas
            }
            layout {
                sequence: 4
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_FORMULA (
            type: hidden
            heading {
                heading: Cod Formula
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMENTARIO (
            type: hidden
            heading {
                heading: Comentario
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ESTADO_ICON (
            type: hidden
            heading {
                heading: Estado Icon
            }
            layout {
                sequence: 33
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        column FEC_ALTA (
