        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Formula
        }

        savedReport 708766 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 2
            )

            displayColumn ESTADO (
                sequence: 11
            )

            displayColumn FEC_ALTA (
                sequence: 4
            )

            displayColumn FEC_MODIF (
                sequence: 8
            )

            displayColumn ID_ARTICULO (
                sequence: 1
            )

            displayColumn ID_SUCURSAL_DESTINO (
                sequence: 7
            )

            displayColumn ID_UNIDAD_MEDIDA (
                sequence: 6
            )

            displayColumn ID_USUARIO (
                sequence: 3
            )

            displayColumn RECETA (
                sequence: 5
            )

            displayColumn SE_INFORMA (
                sequence: 10
            )

            displayColumn TIP_FORMULA (
                sequence: 9
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @formula
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 513
                clearCache: 513
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @formula
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @formula
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

