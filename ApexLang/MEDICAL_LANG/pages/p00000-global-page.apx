page 0 (
    name: Página Global

    region variables-globales (
        name: Variables Globales
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P0_API_SECRET (
        type: textField
        label {
            label: Api Secret
            alignment: left
        }
        layout {
            sequence: 160
            region: @variables-globales
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: static
            staticValue: 941293760c0a5433a83292b9f8aade2e36d3916e
        }
    )

    pageItem P0_CASA_CAMBIO (
        type: textField
        label {
