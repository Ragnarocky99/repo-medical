page 297 (
    name: Centros de Pago
    alias: CENTROS-DE-PAGO
    title: Centros de Pago
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region centros-de-pago (
        name: Centros de Pago
        type: interactiveReport
        source {
            location: localDatabase
            tableName: RHW_CENTROS_PAGOS
            whereClause:
                ```sql
                ID_EMPRESA=:P0_ID_EMPRESA
                AND (ID_SUCURSAL=:P0_ID_SUCURSAL)
                ```
            orderByClause: ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 298
                items: {
                    P298_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 8450728672191539
        }

        column COD_CENTRO_PAGO (
            type: plainText
            heading {
                heading: Centro
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cod Usuario Aud
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DIRECCION (
            type: plainText
            heading {
                heading: Dirección
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column EMPRESA_PARA_ASIENTO (
            type: plainText
            heading {
                heading: Empresa Para Asiento
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID_BARRIO (
            type: plainTextBasedOnLov
            heading {
                heading: Barrio
                alignment: center
            }
            lov {
                lov: @lista-comprobantes
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Z
            }
        )

        column ID_CIUDAD (
            type: plainTextBasedOnLov
            heading {
                heading: Ciudad
                alignment: center
            }
            lov {
                lov: @lv-ciudades
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AA
            }
        )

        column ID_EMPRESA (
            type: plainText
            heading {
                heading: Id Empresa
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID_PAIS (
            type: plainTextBasedOnLov
            heading {
                heading: País
                alignment: center
            }
            lov {
                lov: @lv-paises
            }
            layout {
                sequence: 210
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AC
            }
        )

        column ID_PROVINCIA (
            type: plainTextBasedOnLov
            heading {
                heading: Departamento
                alignment: center
            }
            lov {
                lov: @lv-provincias
            }
            layout {
                sequence: 200
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AB
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column IND_PRINCIPAL (
            type: plainText
            heading {
                heading: Ind. Principal
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column NRO_PATRONAL (
            type: plainText
            heading {
                heading: Nro. Patronal I.P.S.
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REGISTRO (
            type: plainText
            heading {
                heading: Registro M.T.E.SS
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TELEFONO (
            type: plainText
            heading {
                heading: Teléfono
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Centros de Pago
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 91689 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CENTRO_PAGO (
                sequence: 2
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn DIRECCION (
                sequence: 6
            )

            displayColumn ID_BARRIO (
                sequence: 11
            )

            displayColumn ID_CIUDAD (
                sequence: 10
            )

            displayColumn ID_PAIS (
                sequence: 8
            )

            displayColumn ID_PROVINCIA (
                sequence: 9
            )

            displayColumn ID_SUCURSAL (
                sequence: 1
            )

            displayColumn NRO_PATRONAL (
                sequence: 4
            )

            displayColumn REGISTRO (
                sequence: 5
            )

            displayColumn TELEFONO (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: Create
        label: Crear
        layout {
            sequence: 10
            region: @centros-de-pago
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 298
                items: {
                    P298_ID: &P298_ID.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction after-closing-dialog (
        name: After closing dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @centros-de-pago
        }

        action refresh-table (
            name: Refresh table
            action: refresh
            affectedElements {
                selectionType: region
                region: @centros-de-pago
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

