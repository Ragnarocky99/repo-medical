page 773 (
    name: Indicadores Operativos
    alias: INDICADORES-OPERATIVOS
    title: Indicadores Operativos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region indicadores-operativos (
        name: Indicadores Operativos
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLW_HISTORICO_TAREAS_VENCIDAS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FEC_CARGA BETWEEN :P773_FEC_INICIO AND :P773_FEC_FIN AND
                (COD_USUARIO = :P773_COD_USUARIO OR :P773_COD_USUARIO IS NULL)
                ```
            pageItemsToSubmit: [
                P773_FEC_INICIO
                P773_FEC_FIN
                P773_COD_USUARIO
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 37085911586672457
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_USUARIO (
            type: plainText
            heading {
                heading: Usuario
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FEC_CARGA (
            type: plainText
            heading {
                heading: Fecha Alta
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            appearance {
                formatMask: dd/MM/yyyy HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Indicadores Operativos
        }

        savedReport 370890 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 3
            )

            displayColumn COD_USUARIO (
                sequence: 1
            )

            displayColumn FEC_CARGA (
                sequence: 4
            )

            displayColumn TIPO (
                sequence: 2
            )

            sort (
                column: FEC_CARGA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P773_COD_USUARIO (
        type: popupLov
        label {
            label: <p>Usuario:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NVL(P.NOMBRE, P.NOMB_FANTASIA) D, U.COD_USUARIO R
                  FROM BSW_USUARIOS U
                  JOIN BSW_PERSONAS P ON P.ID = U.ID_PERSONA
                ```
            nullDisplayValue: TODOS
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P773_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
    )

    pageItem P773_FEC_INICIO (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @indicadores-operativos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

