page 90 (
    name: Carga de Unidades de Medida
    alias: CARGA-DE-UNIDADES-DE-MEDIDA
    title: Carga de Unidades de Medida
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 171px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-unidades-de-medida (
        name: Carga de Unidades de Medida
        type: form
        source {
            location: localDatabase
            tableName: STW_UNIDADES_MEDIDA
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 3
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P90_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-unidades-de-medida
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P90_ACTIVO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: A
            uncheckedValue: I
        }
        layout {
            sequence: 90
            region: @carga-de-unidades-de-medida
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: ACTIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: A
        }
    )

    pageItem P90_COD_UNIDAD_MEDIDA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Código:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @carga-de-unidades-de-medida
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            cssClasses: [
                cambio
                mostrar
            ]
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: COD_UNIDAD_MEDIDA
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(COD_UNIDAD_MEDIDA)), 0) + 1 FROM STW_UNIDADES_MEDIDA;
        }
    )

    pageItem P90_COD_UNIDAD_MEDIDA_FE (
        type: textField
        label {
            label: <p>Cód. Unidad Medida FE:</p>
            alignment: left
        }
        layout {
            sequence: 80
            region: @carga-de-unidades-de-medida
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: COD_UNIDAD_MEDIDA_FE
            dataType: varchar2
        }
    )

    pageItem P90_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 60
            region: @carga-de-unidades-de-medida
            slot: regionBody
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P90_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
            textCase: upper
        }
        layout {
            sequence: 30
            region: @carga-de-unidades-de-medida
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P90_ID (
        type: hidden
        layout {
            sequence: 50
            region: @carga-de-unidades-de-medida
            slot: regionBody
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: STW_UNIDADES_MED_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P90_IND_DECIMAL (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-unidades-de-medida
            slot: regionBody
        }
        source {
            formRegion: @carga-de-unidades-de-medida
            column: IND_DECIMAL
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P90_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P90_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P90_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11244156096327925
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-unidades-de-medida (
        name: Initialize form Carga de Unidades de Medida
        type: formInitialization
        formRegion: @carga-de-unidades-de-medida
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11243361011327925
        }
    )

    process process-form-carga-de-unidades-de-medida (
        name: Process form Carga de Unidades de Medida
        type: formAutoRowProcessing
        formRegion: @carga-de-unidades-de-medida
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11243713249327925
        }
    )

)

