page 866 (
    name: Grupos de Articulos - Excel
    alias: GRUPOS-DE-ARTICULOS-EXCEL
    title: Grupos de Articulos - Excel
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region carga-excel (
        name: Carga Excel
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM STWV_GRUPO_ARTICULOS_EXCEL
                ```
        }
    )

    region grupo-articulo (
        name: Grupo Articulo
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: STWV_GRUPO_ARTICULOS_EXCEL
        }
        layout {
            sequence: 10
            parentRegion: @verificacion-de-datos
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 106608217732273335
        }

        savedReport 1077622 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @COD_GRUPO_ART
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @COD_QUIMICO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 4
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_GRUPO_ART (
            type: textField
            heading {
                heading: <p>Codigo</p>
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: COD_GRUPO_ART
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column COD_QUIMICO (
            type: textField
            heading {
                heading: <p>Cod. Quimico</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: COD_QUIMICO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grupo Articulo
        }
    )

    region selector (
        name: Selector
        type: regionDisplaySelector
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            includeShowAll: false
        }
    )

    region verificacion-de-datos (
        name: Verificacion de Datos
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM STWV_GRUPO_ARTICULOS_EXCEL
                ```
        }
    )

    pageItem P866_EXCEL (
        type: fileUpload
        label {
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
            fileTypes: .xlsx,.xls
        }
        layout {
            sequence: 10
            region: @carga-excel
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P866_MENSAJE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    button limpiar (
        buttonName: LIMPIAR
        label: Limpiar
        layout {
            sequence: 10
            region: @breadcrumb
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button load (
        buttonName: LOAD
        label: Cargar Excel
        layout {
            sequence: 20
            region: @verificacion-de-datos
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-download-alt
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Esta seguro de Subir los Cambios?
            style: information
        }
    )

    button save-excel (
        buttonName: SAVE_EXCEL
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @verificacion-de-datos
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button upload (
        buttonName: UPLOAD
        label: Subir
        layout {
            sequence: 10
            region: @carga-excel
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process carga-archivo (
        name: Carga Archivo
        type: invokeApi
        invoke {
            package: STWK_EXCEL_UTILS
            procedureOrFunction: CARGA_GRUPO_ARTICULOS
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 106607862411273331
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }

        parameter in_id_empresa (
            parameter {
                dataType: number
            }
            value {
                type: item
                item: P0_ID_EMPRESA
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter in_name (
            value {
                type: item
                item: P866_EXCEL
            }
            advanced {
                displaySequence: 20
            }
        )

    )

    process grupo-articulo-save-interactive-grid-data (
        name: Grupo Articulo - Save Interactive Grid Data
        type: executeCode
        editableRegion: @grupo-articulo
        source {
            plsqlCode:
                ```plsql
                stwk_excel_utils.dml_grupo_articulo_excel(in_id_empresa    => :P0_ID_EMPRESA,
                                                          in_row_status    => :APEX$ROW_STATUS,
                                                          in_seq_id        => :ID,
                                                          in_cod_grupo_art => :COD_GRUPO_ART,
                                                          in_descripcion   => :DESCRIPCION,
                                                          in_cod_quimico   => :COD_QUIMICO);
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 106608849442273341
        }
        serverSideCondition {
            whenButtonPressed: @save-excel
        }
    )

    process limpiar (
        name: Limpiar
        type: invokeApi
        invoke {
            package: STWK_EXCEL_UTILS
            procedureOrFunction: LIMPIAR_COLECCIONES
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 106609469183273347
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    process subir-excel (
        name: Subir Excel
        type: invokeApi
        invoke {
            package: STWK_EXCEL_UTILS
            procedureOrFunction: INSERTA_GRUPO_ARTICULOS
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: &P866_MENSAJE!RAW.
        }
        advanced {
            executionMappingIdentifier: 106609543655273348
        }
        serverSideCondition {
            whenButtonPressed: @load
        }

        parameter in_id_empresa (
            parameter {
                dataType: number
            }
            value {
                type: item
                item: P0_ID_EMPRESA
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter out_mensaje (
            parameter {
                direction: out
            }
            value {
                item: P866_MENSAJE
            }
            advanced {
                displaySequence: 20
            }
        )

    )

)

