page 695 (
    name: Carga de Licitación
    alias: CARGA-DE-LICITACIÓN
    title: Carga de Licitación
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Times", monospace;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            #verde{
                color: green;
            }
            #amarillo{
                color: yellow;
            }
            #rojo{
                color: red;
            }
            .mostrar{
                   background-color:#eeeeee;
                width: 85px;
                height: 24px;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: bold;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            .solo-mostrar{
                   background-color:#eeeeee;
                width: 171px;
                height: 24.5px;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
              text-align: center;
              height: 26px;
            }
            
            .borrar{
                width: 93px;
                background-color:#FF0000;
            }
            ```
    }
    readOnly {
        type: item=value
        item: P695_ESTADO_LLAMADO
        value: NA
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region adjudicacion (
        name: Adjudicacion
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @detalles-de-convocatoria
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region carga-de-convocatoria (
        name: Carga de Convocatoria
        type: form
        source {
            location: localDatabase
            tableName: LCW_LICITACIONES_CAB
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
            pageItemsToSubmit: P695_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalles-de-convocatoria (
        name: Detalles de Convocatoria
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select LD.ID,
                       LD.ID_LICITACION_CAB,
                       LD.NRO_ITEM,
                       LD.COD_ARTICULO_CATALOGO,
                       LD.DESC_ARTICULO_CATALOGO,
                       LD.PRECIO_UNITARIO_ESTIMADO,
                       LD.CANTIDAD,
                       LD.MONTO_TOTAL,
                       LD.ID_EMPRESA,     
                       LD.ID_UNIDAD_MEDIDA_CATALOGO,
                       LD.ID_PRESENTACION_CATALOGO,
                       LD.NRO_LOTE,
                       LD.CANT_MIN,
                       LD.CANT_MAX,
                       LD.ID_MONEDA,
                       LD.ID_UNIDAD_MEDIDA,
                       LD.MONTO_MINIMO,
                       '' COTIZAR_OFERTA,
                       (SELECT SUM(COTIZA_TOTAL)
                          FROM LCWV_RESUMEN_OFERTAS
                         WHERE ID_LICITACION_DET = LD.ID
                           AND IND_ENVIO = 'S'
                           AND IND_NO_APLICA_PRECIO = 'N') MONTO_TOTAL_COTIZADO,
                       LCWF_TRAE_ESTADO_CONVOCATORIA_DET(LD.ID) ESTADO,
                       (SELECT SUM(COTIZA_UNITARIO)
                          FROM LCWV_RESUMEN_OFERTAS
                         WHERE ID_LICITACION_DET = LD.ID
                           AND IND_ENVIO = 'S'
                           AND IND_NO_APLICA_PRECIO = 'N')  COTIZA_UNITARIO,
                       LD.ESPECIFICACION_TECNICA,
                       LD.IND_NO_PRESENTADO,
                       LD.FEC_ADJUDICACION,
                       LD.ID_TIPO_ENTREGA,
                       'N' SELECCION_ADJUDICACION
                  from LCW_LICITACIONES_DET LD
                 where ID_LICITACION_CAB = :P695_ID
                   and (NVL(LD.IND_NO_PRESENTADO, 'N') = :P695_IND_PRESENTADO OR :P695_IND_PRESENTADO IS NULL)
                ```
            pageItemsToSubmit: [
                P695_ID
                P695_IND_PRESENTADO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P695_ID
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    //calculaTotal();
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    //calculaTotal();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    //calculaTotal();
                            };
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    //calculaTotal();
                            };                
                
                        } ;      
                        return config;
                }
                ```
        }
