    dynamicAction seleccionar-filtrado (
        name: Seleccionar Filtrado
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @marcar-todo-adjudicacion
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try {
                        var model = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                        var v_seleccionada = model.getFieldKey("SELECCION_ADJUDICACION");
                        ///var v_total_cantidad = 0;
                        var bandera = 'N';
                        model.forEach(function(r, index, id) {
                            var meta = model.getRecordMetadata(id);
                    
                            console.log(meta.fields); // meta.fields undifined validation   --deprecated By RP
                            if ((meta != undefined) && (!meta.deleted)) {
                    
                                if (r[v_seleccionada] == 'N' || r[v_seleccionada] == null || r[v_seleccionada] == '') {
                                    bandera = 'S';
                                    model.setValue(r, 'SELECCION_ADJUDICACION', 'S');
                    
                                }
                                if (r[v_seleccionada] == 'S' && bandera == 'N') {
                                    model.setValue(r, 'SELECCION_ADJUDICACION', 'N');
                                }
                            }
                        });
                        
                        // Llamar a la función de devolución de llamada cuando se complete la operación
                        if (typeof callback === "function") {
                            callback();
                        }
                    } catch (e) {
                        console.error("Se produjo un error:", e);
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

