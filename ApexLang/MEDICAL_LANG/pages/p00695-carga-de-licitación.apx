    computation p695-total-dncp (
        itemName: P695_TOTAL_DNCP
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT TO_CHAR(SUM(NVL(MONTO_TOTAL, 0)), '999G999G999G999G990D00')
                  FROM LCW_LICITACIONES_DET
                 WHERE ID_LICITACION_CAB = :P695_ID
                ```
        }
    )

    process adjudicar (
        name: Adjudicar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR SELECCION IS
                          SELECT COL.N001 ID_LICITACION_DET,
                                 SYSDATE + TE.NRO_DIAS FEC_PLAZO,
                                 N003 CANTIDAD,
                                 D001 FEC_ADJUDICACION
                            FROM APEX_COLLECTIONS COL
                       LEFT JOIN CMW_TIPO_ENTREGA TE ON TE.ID = COL.N002
                          WHERE COLLECTION_NAME = 'COL_LICITACIONES_DET';
                BEGIN
                    FOR S IN SELECCION
                    LOOP
                        IF S.FEC_PLAZO IS NULL THEN
                            RAISE_APPLICATION_ERROR(-20000, 'El plazo de entrega no puede estar vacio');
                        END IF;
                
                        IF S.FEC_ADJUDICACION IS NULL THEN
                            RAISE_APPLICATION_ERROR(-20000, 'La fecha de Adjudicacion no puede estar vacio');
                        END IF;
                        
                        INSERT INTO LCW_OFERTAS_APROBACIONES(ID_EMPRESA, TIPO, CANTIDAD, COD_USUARIO_AUD, FEC_ALTA,
                                                             TIPO_ADJUDICACION, ID_LICITACION_DET, ID_LICITACION_CAB,
                                                             NRO_OCC, FEC_PLAZO, FEC_OCC)
                        VALUES(:P0_ID_EMPRESA, 'AP', S.CANTIDAD, :APP_USER, SYSDATE,
                               'C', S.ID_LICITACION_DET, :P695_ID,
                               :P695_NRO_ID_LICITACION, S.FEC_PLAZO, S.FEC_ADJUDICACION);
                    END LOOP;
                END;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Adjudicación con Éxito
        }
        advanced {
            executionMappingIdentifier: 56180805585460143
        }
        serverSideCondition {
            whenButtonPressed: @adjudicar
        }
    )

    process cargar-excel (
        name: Cargar Excel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VID_LICITACIONES_CAB       NUMBER(9) := :P695_ID;
                    VID_EMPRESA                NUMBER(9) := :P0_ID_EMPRESA;    
                    VNRO_ITEM                  NUMBER(9); 
                    VCOD_ARTICULO_CATALOGO     LCW_LICITACIONES_DET.COD_ARTICULO_CATALOGO%TYPE;
                    VDESC_ARTICULO_CATALOGO    LCW_LICITACIONES_DET.DESC_ARTICULO_CATALOGO%TYPE;
                    VDESC_ARTICULO_CONVOCANTE  LCW_LICITACIONES_DET.DESC_ARTICULO_CONVOCANTE%TYPE;
                    VPRECIO_UNITARIO_ESTIMADO  LCW_LICITACIONES_DET.PRECIO_UNITARIO_ESTIMADO%TYPE;
                    VCANTIDAD                  LCW_LICITACIONES_DET.CANTIDAD%TYPE;
                    VMONTO_TOTAL               LCW_LICITACIONES_DET.MONTO_TOTAL%TYPE;
                    VVOLUMEN                   LCW_LICITACIONES_DET.VOLUMEN%TYPE;
                    VID_EMPRESA                LCW_LICITACIONES_DET.ID_EMPRESA%TYPE;
                    VNRO_LOTE                  LCW_LICITACIONES_DET.NRO_LOTE%TYPE;
                    VID_UNIDAD_MEDIDA_CATALOGO LCW_LICITACIONES_DET.ID_UNIDAD_MEDIDA_CATALOGO%TYPE;
                    VID_PRESENTACION_CATALOGO  LCW_LICITACIONES_DET.ID_PRESENTACION_CATALOGO%TYPE;
                    VCANT_MIN                  LCW_LICITACIONES_DET.CANT_MIN%TYPE;
                    VCANT_MAX                  LCW_LICITACIONES_DET.CANT_MAX%TYPE;
                    VMONTO_MINIMO              LCW_LICITACIONES_DET.MONTO_MINIMO%TYPE;
                    VID_MONEDA                 LCW_LICITACIONES_DET.ID_MONEDA%TYPE;
                    VID_UNIDAD_MEDIDA          LCW_LICITACIONES_DET.ID_UNIDAD_MEDIDA%TYPE;
                    VNOMBRE_ARCHIVO            VARCHAR(100);
                    VBANDERA                   NUMBER(1);
                    VDATOS                     VARCHAR(100);
                    VCANT_APROBADA             LCW_OFERTAS_APROBACIONES.CANTIDAD%TYPE;
                BEGIN  
                    
                    -- Eliminamos Ofertas y Detalles
                    IF :P695_ARCHIVO_EXCEL IS NOT NULL THEN
                        DELETE LCW_OFERTAS
                         WHERE ID_LICITACION_CAB = :P695_ID;
                        DELETE LCW_LICITACIONES_DET
                         WHERE ID_LICITACION_CAB = :P695_ID;
                    END IF;
                     
                    VNOMBRE_ARCHIVO := :P695_ARCHIVO_EXCEL;
                
                    FOR R1 IN (SELECT *  
                                 FROM APEX_APPLICATION_TEMP_FILES F, 
                                      TABLE( APEX_DATA_PARSER.PARSE(
                                                P_CONTENT                     => F.BLOB_CONTENT,
                                                P_ADD_HEADERS_ROW             => 'N',
                                                P_FILE_NAME                   => F.FILENAME) 
                                            ) P
                                 WHERE F.NAME LIKE VNOMBRE_ARCHIVO AND P.LINE_NUMBER>1
                              )
                    LOOP 
                       
                
                        --IF NVL(R1.COL002,'NO_DATA') <> 'NO_DATA' THEN
                            BEGIN
                                VNRO_ITEM             := NVL(TO_NUMBER(REPLACE(R1.COL002, '.', ',')), 0);
                            EXCEPTION
                                WHEN VALUE_ERROR THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Se esperaba un valor numerico para la columna de nro de item (Columna B). Linea '||R1.LINE_NUMBER);
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado al obtener el nro de item (Columna B). Linea '||R1.LINE_NUMBER|| ' Error '||sqlerrm);
                            END;
                            
                            VCOD_ARTICULO_CATALOGO    := R1.COL003;
                            VDESC_ARTICULO_CATALOGO   := R1.COL004;
                            VDESC_ARTICULO_CONVOCANTE := R1.COL005;
                            
                            BEGIN
                                VPRECIO_UNITARIO_ESTIMADO := NVL(TO_NUMBER(REPLACE(R1.COL006, '.', ',')), 0);
                            EXCEPTION
                                WHEN VALUE_ERROR THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Se esperaba un valor numerico para la columna de precio unitario (Columna F). Linea '||R1.LINE_NUMBER);
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado al obtener el precio unitario (Columna F). Linea '||R1.LINE_NUMBER|| ' Error '||sqlerrm);
                            END;
                            
                            BEGIN
                                VCANT_MIN             := NVL(TO_NUMBER(REPLACE(R1.COL007, '.', ',')), 0);
                            EXCEPTION
                                WHEN VALUE_ERROR THEN
                                    VCANT_MIN := NULL;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error leyendo la cantidad minima del archivo. Linea '||R1.LINE_NUMBER||' Err '||SQLERRM);
                            END;
                            BEGIN
                                VCANTIDAD                 := ROUND(NVL(TO_NUMBER(REPLACE(R1.COL008, '.', ',')), 0));
                            EXCEPTION
                                WHEN VALUE_ERROR THEN
                                    VCANTIDAD  := 0;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error leyendo la columna cantidad del archivo. Linea '||R1.LINE_NUMBER||' Err '||SQLERRM);
                            END;
                            
                            BEGIN
                                VMONTO_MINIMO         := NVL(TO_NUMBER(REPLACE(R1.COL009, '.', ',')), 0);
                            EXCEPTION
                                WHEN VALUE_ERROR THEN
                                    VMONTO_MINIMO := NULL;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error leyendo el monto minimo del archivo. Linea '||R1.LINE_NUMBER);
                            END;
                            
                            BEGIN
                                VMONTO_TOTAL := NVL(TO_NUMBER(REPLACE(R1.COL010, '.', ',')), 0);
                            EXCEPTION
                                WHEN VALUE_ERROR THEN
                                    VMONTO_TOTAL := 0;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error leyendo el monto minimo del archivo. Linea '||R1.LINE_NUMBER);
                            END;
                            BEGIN
                                SELECT ID
                                  INTO VID_MONEDA
                                  FROM BSW_MONEDAS
                                 WHERE SIGLAS_DNCP = REPLACE(REPLACE(R1.COL011, ' ', ''), CHR(13), '');
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'No se encuentra la moneda en el sistema con sigla '||R1.COL011);
                                WHEN TOO_MANY_ROWS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Se encontro monedas con la misma sigla '||R1.COL011);
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado leyendo la moneda en la linea '||R1.LINE_NUMBER);
                            END;
                            --raise_application_error(-20000, 'hola');
                            VID_UNIDAD_MEDIDA_CATALOGO := BUSCA_UNI_MED(R1.COL013);
                            VID_UNIDAD_MEDIDA          := BUSCA_UNI_MED(R1.COL014);
                            VID_PRESENTACION_CATALOGO  := BUSCA_PRESENTACION(R1.COL015);
                            
                            --raise_application_error(-20000, 'lote '||r1.col025);
                            BEGIN
                               INSERT INTO LCW_LICITACIONES_DET(                              
                                  ID_LICITACION_CAB,
                                  NRO_ITEM,
                                  COD_ARTICULO_CATALOGO,
                                  DESC_ARTICULO_CATALOGO,
                                  DESC_ARTICULO_CONVOCANTE,
                                  PRECIO_UNITARIO_ESTIMADO,
                                  CANTIDAD,
                                  MONTO_TOTAL,
                                  ID_EMPRESA,
                                  ID_UNIDAD_MEDIDA_CATALOGO,
                                  ID_PRESENTACION_CATALOGO,
                                  CANT_MIN,
                                  ID_MONEDA,
                                  ID_UNIDAD_MEDIDA,
                                  ESPECIFICACION_TECNICA,
                                  NRO_LOTE,
                                  MONTO_MINIMO
                               ) VALUES (                              
                                  VID_LICITACIONES_CAB,
                                  VNRO_ITEM,
                                  VCOD_ARTICULO_CATALOGO,
                                  VDESC_ARTICULO_CATALOGO,
                                  VDESC_ARTICULO_CONVOCANTE,
                                  VPRECIO_UNITARIO_ESTIMADO,
                                  VCANTIDAD,
                                  VMONTO_TOTAL,
                                  :P0_ID_EMPRESA,
                                  VID_UNIDAD_MEDIDA_CATALOGO,
                                  VID_PRESENTACION_CATALOGO,
                                  VCANT_MIN,
                                  VID_MONEDA,
                                  VID_UNIDAD_MEDIDA,
                                  R1.COL024,
                                  R1.COL025,
                                  VMONTO_MINIMO
                               );
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    RAISE_APPLICATION_ERROR(-20999, 'ERROR: AL INSERTAR ' || SQLERRM);
                                WHEN OTHERS THEN 
                                    RAISE_APPLICATION_ERROR(-20994, 'Error al cargar el articulo: ' || R1.COL001 || 'Linea '||R1.LINE_NUMBER||' -.ERR: ' || SQLERRM);
                            END;
                
                        --END IF; 
                    END LOOP; 
                    APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := 'LICITACIÓN CARGADA CON ÉXITO';
                END;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 12777933567711024
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: EXCEL_CREATE,EXCEL_SAVE
        }
    )

