    computation p695-total-cotizado (
        itemName: P695_TOTAL_COTIZADO
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                SELECT TO_CHAR(SUM(PRECIO_TOTAL), '999G999G999G999G990D00')
                  FROM LCW_OFERTAS
                 WHERE ID_LICITACION_CAB = :P695_ID
                   AND IND_ENVIO = 'S'
                   AND IND_NO_APLICA_PRECIO = 'N'
                ```
        }
