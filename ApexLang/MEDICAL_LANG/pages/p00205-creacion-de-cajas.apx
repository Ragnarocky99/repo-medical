page 205 (
    name: Creacion de Cajas
    alias: CREACION-DE-CAJAS
    title: Creacion de Cajas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region creacion-de-cajas (
        name: Creacion de Cajas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CAJ.ID,
                       CAJ.ID_EMPRESA,
                       CAJ.ID_SUCURSAL,
                       CAJ.COD_CAJA,
                       CAJ.FEC_ALTA,
                       CAJ.ALTA_POR,
                       CAJ.ESTADO,
                       CASE
                       WHEN CAJ.ESTADO ='S' THEN 'fa fa-check u-success-text'
                       WHEN CAJ.ESTADO ='N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       CAJ.COD_USUARIO_AUD,
                       CAJ.CIERRA_SIN_PENDIENTES,
                       CAJ.DESCRIPCION,
                       CAJ.ID_USUARIO_ASIG,
                       P.NOMBRE
                  from CCW_CAJAS CAJ, BSW_USUARIOS U, BSW_PERSONAS P
                    where CAJ.ID_EMPRESA = :P0_COD_EMPRESA
                    and   CAJ.ID_USUARIO_ASIG = U.ID
                    and   U.ID_PERSONA = P.ID
                
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 206
                items: {
                    P206_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 24873645232282506
        }

        column ALTA_POR (
            type: plainText
            heading {
                heading: Alta Por
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CIERRA_SIN_PENDIENTES (
            type: hidden
            heading {
                heading: Cierra Sin Pendientes
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COD_CAJA (
            type: plainText
            heading {
                heading: Código Caja
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="#ESTADO_ICON#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ESTADO_ICON (
            type: hidden
            heading {
                heading: Estado Icon
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column FEC_ALTA (
            type: plainText
            heading {
                heading: Fecha Alta
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 120
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_SUCURSAL (
            type: hidden
            heading {
                heading: Id Sucursal
            }
            layout {
                sequence: 130
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID_USUARIO_ASIG (
            type: hidden
            heading {
                heading: Id Usuario Asig
            }
            layout {
                sequence: 150
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre Us. Asig.
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Creacion de Cajas
        }

        savedReport 248809 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ALTA_POR (
                sequence: 3
            )

            displayColumn COD_CAJA (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ESTADO (
                sequence: 6
            )

            displayColumn FEC_ALTA (
                sequence: 2
            )

            displayColumn NOMBRE (
                sequence: 5
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @creacion-de-cajas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 206
                clearCache: 206
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @creacion-de-cajas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @creacion-de-cajas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

