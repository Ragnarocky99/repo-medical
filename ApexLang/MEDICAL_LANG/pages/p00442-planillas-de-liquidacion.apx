page 442 (
    name: Planillas de Liquidacion
    alias: PLANILLAS-DE-LIQUIDACION
    title: Planillas de Liquidacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: buttons
        type: staticContent
        layout {
            sequence: 190
            parentRegion: @filtro
            slot: regionBody
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noUI
            ]
        }
    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P442_ANIO (
        type: textField
        label {
            alignment: left
        }
        layout {
            sequence: 140
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P442_CATEGORIA (
        type: popupLov
        label {
            label: <P>Categoria: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-tip-empleado
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 100
            region: @filtro
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_DEPARTAMENTO (
        type: popupLov
        label {
            label: <P>Departamento: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @rhw-departamentos-descripcion
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_EMPLEADO (
        type: popupLov
        label {
            label: <P>Empleado: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-empleados-pan-liq
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_ESTADO_IPS (
        type: popupLov
        label {
            label: <P>Estado Ips: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @rhw-estados-ips
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_MES (
        type: textField
        label {
            label: <p>Periodo Mes/Año: </p>
            alignment: left
        }
        layout {
            sequence: 130
            region: @filtro
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P442_NRO_LIQUIDACION (
        type: textField
        label {
            label: "<p>Nro : </p> "
            alignment: left
        }
        layout {
            sequence: 150
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 2
        }
    )

    pageItem P442_PLANILLA (
        type: popupLov
        label {
            label: <P>Planilla: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @rhw-planilla-liq
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_SECCION (
        type: popupLov
        label {
            label: <P>Sección: </P>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descripcion, cod_seccion 
                from rhw_secciones 
                where id_empresa = :P0_ID_empresa 
                and ID_sucursal = :P0_ID_sucursal 
                ---and ID_departamento =:P442_ID_DEPARTAMENTO
                order by descripcion
                ```
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_SER_LIQUIDACION (
        type: textField
        label {
            label: "<p>Serie: </p> "
            alignment: left
        }
        layout {
            sequence: 160
            region: @filtro
            slot: regionBody
            alignment: left
            column: 6
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 1
        }
    )

    pageItem P442_SUCURSAL (
        type: popupLov
        label {
            label: <P>Sucursal: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P442_TIPO (
        type: popupLov
        label {
            label: <P>Tipo: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @rhw-tip-liquid
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 110
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button btn-pla-desc (
        buttonName: BTN_PLA_DESC
        label: Planilla de descuento
        layout {
            sequence: 20
            region: @buttons
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button ejecutar (
        buttonName: EJECUTAR
        label: Planilla de Sueldo
        layout {
            sequence: 180
            region: @filtro
            slot: regionBody
            column: 6
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 451
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 451
                items: {
                    P451_ANIO: &P442_ANIO.
                    P451_MES: &P442_MES.
                    P451_CATEGORIA: &P442_CATEGORIA.
                    P451_DEPARTAMENTO: &P442_DEPARTAMENTO.
                    P451_ESTADO_IPS: &P442_ESTADO_IPS.
                    P451_NRO_LIQUIDACION: &P442_NRO_LIQUIDACION.
                    P451_PLANILLA: &P442_PLANILLA.
                    P451_SECCION: &P442_SECCION.
                    P451_SER_LIQUIDACION: &P442_SER_LIQUIDACION.
                    P451_SUCURSAL: &P442_SUCURSAL.
                    P451_TIPO: &P442_TIPO.
                    P451_EMPLEADO: &P442_EMPLEADO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @ejecutar
        }
    )

)

