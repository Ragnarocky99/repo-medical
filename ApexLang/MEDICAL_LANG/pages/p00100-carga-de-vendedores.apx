            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            cssClasses: cambio
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select NOMBRE
                from BSW_PERSONAS
                where ID = :P100_ID_PERSONA
                
                ```
        }
