    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P100_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button persona (
        buttonName: PERSONA
        label: Persona
        layout {
            sequence: 60
            region: @carga-de-vendedores
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button zona (
        buttonName: ZONA
        label: Zona
        layout {
            sequence: 40
            region: @carga-de-vendedores
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @persona
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P100_ID_PERSONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @zona
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P100_ID_ZONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p100-cod-vendedor (
        itemName: P100_COD_VENDEDOR
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P100_COD_VENDEDOR is null then
                      select nvl(max(to_number(COD_VENDEDOR)), 0) + 1
                         into v_numero
                         from FVW_VENDEDORES;
                       RETURN v_numero;
                      end if; 
                      RETURN :P100_COD_VENDEDOR;
                   exception
                      when no_data_found then
                        :P100_COD_VENDEDOR  := 1 ;
                        RETURN :P100_COD_VENDEDOR;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Vendedores' || sqlerrm ) ;
                   end ;
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 13176538810294078
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-vendedores (
        name: Initialize form Carga de Vendedores
        type: formInitialization
        formRegion: @carga-de-vendedores
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13175785872294078
        }
    )

    process process-form-carga-de-vendedores (
        name: Process form Carga de Vendedores
        type: formAutoRowProcessing
        formRegion: @carga-de-vendedores
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13176115776294078
        }
    )

)

