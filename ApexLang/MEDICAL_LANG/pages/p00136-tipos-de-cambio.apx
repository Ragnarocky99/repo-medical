page 136 (
    name: Tipos de Cambio
    alias: TIPOS-DE-CAMBIO
    title: Tipos de Cambio - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tipos-de-cambio (
        name: Tipos de Cambio
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TC.ID,
                       TC.ID_MONEDA,
                       TC.TIPO_CAMBIO,
                       TC.FEC_TIPO_CAMBIO,
                       TC.VAL_VENTA,
                       TC.VAL_COMPRA,
                       TC.ALTA_POR,
                       TC.FEC_ALTA,
                       TC.ACTUALIZADO_POR,
                       TC.FEC_ACTUALIZADO,
                       TC.COD_USUARIO_AUD,
                       MON.COD_MONEDA,
                       MON.DESCRIPCION DESC_MONEDA
                
                  from BSW_TIPOS_CAMBIO TC, BSW_MONEDAS MON
                  where TC.ID_MONEDA = MON.ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 137
                items: {
                    P137_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 16526416477364931
        }

        column ACTUALIZADO_POR (
            type: hidden
            heading {
                heading: Actualizado Por
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ALTA_POR (
            type: hidden
            heading {
                heading: Alta Por
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COD_MONEDA (
            type: plainText
            heading {
                heading: Cód. Moneda
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column DESC_MONEDA (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column FEC_ACTUALIZADO (
            type: hidden
            heading {
                heading: Fec Actualizado
            }
            layout {
                sequence: 130
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column FEC_ALTA (
            type: hidden
            heading {
                heading: Fec Alta
            }
            layout {
                sequence: 110
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column FEC_TIPO_CAMBIO (
            type: plainText
            heading {
                heading: Fecha
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_MONEDA (
            type: hidden
            heading {
                heading: Id Moneda
            }
            layout {
                sequence: 140
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column TIPO_CAMBIO (
            type: plainTextBasedOnLov
            heading {
                heading: "Tipo "
            }
            lov {
                lov: @p137-tipo-cambio
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column VAL_COMPRA (
            type: plainText
            heading {
                heading: Compra
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column VAL_VENTA (
            type: plainText
            heading {
                heading: Venta
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                TIPOS DE CAMBIO
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 165340 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_MONEDA (
                sequence: 1
            )

            displayColumn DESC_MONEDA (
                sequence: 2
            )

            displayColumn FEC_TIPO_CAMBIO (
                sequence: 4
            )

            displayColumn ID_MONEDA (
                sequence: 7
            )

            displayColumn TIPO_CAMBIO (
                sequence: 3
            )

            displayColumn VAL_COMPRA (
                sequence: 5
            )

            displayColumn VAL_VENTA (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @tipos-de-cambio
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 137
                clearCache: 137
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tipos-de-cambio
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tipos-de-cambio
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17355539266473450
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

