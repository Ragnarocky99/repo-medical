page 441 (
    name: Deshacer Proceso de Liquidacion
    alias: DESHACER-PROCESO-DE-LIQUIDACION
    title: Deshacer Proceso de Liquidacion
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 650
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;
            vertical-align: text-bottom;
            font-weight: lighter;
            font-size: 13px;
            text-align: left;
            border-width: thin;
            border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region deshacer-proceso-de-liquidación (
        name: Deshacer Proceso de Liquidación
        type: form
