        serverSideCondition {
            type: itemIsNull
            item: P441_ID
        }
    )

    dynamicAction focus (
        name: Focus
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P441_SER_LIQUID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-serie-y-nro-liquid (
        name: Set Serie y Nro Liquid
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Begin
                      Select distinct ser_liquid, nro_liquid, tip_liquid
                        into :P441_SER_LIQUID, :P441_NRO_LIQUID, :P441_TIP_LIQUID
                        from rhw_cabecera_liq
                       where ID_EMPRESA = :P0_ID_EMPRESA
                         and nro_liquid in(Select max(nro_liquid)
                                             from rhw_cabecera_liq
                                            where id_empresa = :P0_ID_EMPRESA);
                    Exception
                      When others then
                        null;
                    End;
                    ```
                itemsToSubmit: [
                    P441_SER_LIQUID
                    P441_NRO_LIQUID
                    P441_TIP_LIQUID
                ]
                itemsToReturn: [
                    P441_SER_LIQUID
                    P441_NRO_LIQUID
                    P441_TIP_LIQUID
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-value (
        name: Set Value
        execution {
            sequence: 20
        }
        when {
            event: focusout
            selectionType: items
            items: P441_NRO_LIQUID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                       select distinct fec_liquid, tip_liquid, MES, ANIO
                          into :P441_fec_liquid, :P441_tip_liquid, :P441_MES, :P441_ANIO
                          from rhw_cabecera_liq
                          where ID_empresa = :P0_ID_empresa
                            and ser_liquid  = :P441_ser_liquid
                            and nro_liquid  = :P441_nro_liquid ;
                       
                       --:P441_mes  :=  TO_DATE(TO_CHAR(TO_NUMBER(:P441_fec_liquid, 'MM'))) ;
                       --:P441_anio :=  TO_DATE(TO_CHAR(TO_NUMBER(:P441_fec_liquid, 'YYYY')))  ;
                    /*exception
                       when no_data_found then
                          :P441_fec_liquid := null ;
                          :P441_mes        := null ;
                          :P441_anio       := null ;
                       when others then
                          :P441_fec_liquid := null ;
                          :P441_mes        := null ;
                          :P441_anio       := null ;
                          RAISE_APPLICATION_ERROR(-20000, 'Error en la tabla ' || sqlerrm ) ;*/
                    end ;
                    ```
                itemsToSubmit: [
                    P441_SER_LIQUID
                    P441_NRO_LIQUID
                    P0_ID_EMPRESA
                ]
                itemsToReturn: [
                    P441_FEC_LIQUID
                    P441_MES
                    P441_ANIO
                    P441_TIP_LIQUID
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process desliquidar (
        name: DESLIQUIDAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare   vserie    varchar2(1) ;
                          vnumero   number(8) ;  
                					vcierre   varchar2(1) ;          
                begin 
                   vserie  := :P441_ser_liquid ;
                   vnumero := :P441_nro_liquid ;
                   BEGIN
                	  select nvl(cerrado,'N')
                	    into vcierre
                	    from rhw_liquidaciones
                      where id_empresa = :P0_ID_empresa
                        and ser_liquid  = :P441_ser_liquid
                        and nro_liquid  = :P441_nro_liquid ; 	    
                   EXCEPTION
                   	WHEN no_data_found THEN
                   	  RAISE_APPLICATION_ERROR(-20000, 'No se encuentra el Nro. y Serie de la Liquidación. ');	  
                   	WHEN others THEN
                   	  RAISE_APPLICATION_ERROR(-20000, 'Error en la tabla de Liquidaciones. '||sqlerrm);
                   END;
                   IF vcierre = 'N' THEN
                		   
                		   delete from rhw_debcred
                		   where id_concepto = :P370_conc_vacaciones
                		         and nro_liquid_afecto = vnumero
                		         and ser_liquid_afecto = vserie
                		         and proceso = 'S'
                		         and(id_empleado = :P441_ID_EMPLEADO or :P441_ID_EMPLEADO is null);
                		         
                		   delete from rhw_cabecera_liq
                		      where id_empresa = :P0_ID_empresa
                		        and ser_liquid  = :P441_ser_liquid
                		        and nro_liquid  = :P441_nro_liquid 
                		        and (ID_empleado = :P441_ID_EMPLEADO or :P441_ID_EMPLEADO is null);
                		        
                		if :P441_ID_EMPLEADO is null then 
                		   delete from rhw_liquidaciones
                		      where id_empresa = :P0_ID_empresa
                		        and ser_liquid  = :P441_ser_liquid
                		        and nro_liquid  = :bP441_nro_liquid ;
                		end if;
                		        
                		   update rhw_vacaciones
                		     set procesado = 'N', 
                		         ser_liquid = null, 
                		         nro_liquid = null
                		   where ID_empresa = :P0_ID_empresa
                		     and ser_liquid  = :P441_ser_liquid
                		     and nro_liquid  = :P441_nro_liquid 
                		     and (ID_empleado = :P441_ID_EMPLEADO or :P441_ID_EMPLEADO is null);
                		     
                		   /*delete from rhw_debcred
                		   where  SER_DEB_CRED_REF = :P441_ser_liquid
                		   and		nro_DEB_CRED_REF = :P441_nro_liquid
                		   and	  NRO_LIQUID_AFECTO is null
                		   and (ID_empleado = :P441_ID_EMPLEADO or :P441_ID_EMPLEADO is null);*/
                		  
                /* ver tabla
                		   update rh_salidas_empleados
                		     set ser_liquid = null, 
                		         nro_liquid = null
                		   where cod_empresa = :variables.cod_empresa
                		     and ser_liquid = :b_liquida.ser_liquid
                		     and nro_liquid  = :b_liquida.nro_liquid ;*/
                		   
                       if :P441_tip_liquid = 'M' or :P441_tip_liquid = 'V' or :P441_tip_liquid = 'C' then
                  	      promedia_comisiones(:P0_ID_EMPRESA, :P441_ID_EMPLEADO, :P441_NRO_LIQUID);
                       end if;		   
                     
                		   commit ;
                		 apex_application.g_print_success_message := 'Se han eliminado Serie:' || ' ' || vserie || ' ' || ' Nro.: ' ||to_char( vnumero );
                   ELSE
                		 apex_application.g_print_success_message := 'La liquidación ya ha sido cerrada.' ;
                	 END IF;   	
                exception
                   when others then
                      RAISE_APPLICATION_ERROR(-20000, 'Error al eliminar la liquidacion ' || 'Serie ' || vserie || ' y ' || 'Nro. ' || to_char( vnumero ) || sqlerrm);
                end ;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 49537807636443344
        }
        serverSideCondition {
            whenButtonPressed: @desliquidar
        }
    )

