page 59 (
    name: Plan de Cuentas
    alias: PLAN-DE-CUENTAS
    title: Plan de Cuentas - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @plan-de-cuentas
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region plan-de-cuentas (
        name: Plan de Cuentas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PC.ID,
                       PC.ID_EMPRESA,
                       PC.COD_CUENTA,
                       PC.NOMBRE_CUENTA,
                       PC.ABREVIATURA,
                       PC.NIVEL_DE_CUENTA,
                       PC.CUENTA_TOTALIZADORA,
                       PC.IMPRIMIBLE,
                       PC.ASENTABLE,
                       CASE PC.ASENTABLE
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ASENTABLE_ICON,
                       PC.TIPO_CUENTA,
                       PC.DEBITO_ACTUAL,
                       PC.CREDITO_ACTUAL,
                       PC.COD_PLAN_CUENTA,
                       PC.COD_USUARIO_AUD,
                       PC.ID_MONEDA,
                       PC.ID_PLAN_CUE_TOTALIZADORA,
                       PC.ID_PLAN_CUENTA,
                       CS.COD_CUENTA COD_CUENTA_SET,
                       CS.NOMBRE_CUENTA NOMBRE_CUENTA_SET
                
                FROM COW_PLAN_CUENTAS PC
                LEFT JOIN COW_PLAN_CUENTAS_SET CS ON CS.ID = PC.ID_CUENTA_SET
                WHERE PC.ID_EMPRESA=:P0_COD_EMPRESA
                   --AND ( (REPLACE(PC.COD_CUENTA,'.','') LIKE '%'|| :P59_COD_CUENTA ||'%') OR (PC.COD_CUENTA LIKE '%'|| :P59_COD_CUENTA ||'%') OR :P59_COD_CUENTA IS NULL )
                   AND ( (PC.cOD_CUENTA LIKE :P59_COD_CUENTA ||'%') OR :P59_COD_CUENTA IS NULL )
                   AND ( UPPER(PC.NOMBRE_CUENTA) LIKE UPPER('%'|| :P59_NOMBRE_CUENTA ||'%') OR :P59_NOMBRE_CUENTA IS NULL )
                   AND ( PC.ASENTABLE = :P59_ASENTABLE OR :P59_ASENTABLE IS NULL )
                   AND ( PC.TIPO_CUENTA = :P59_TIPO_CUENTA OR :P59_TIPO_CUENTA IS NULL )
                   
                ORDER BY PC.COD_CUENTA
                  /*  regexp_replace(
                        regexp_replace(
                          regexp_replace(
                        PC.COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                        ),
                           '(^|\.)(\d{2})','\1 0\2'
                      ),
                         '(^|\.)(\d)','\1 00\2'
                    )*/
                ```
            pageItemsToSubmit: [
                P59_COD_CUENTA
                P59_NOMBRE_CUENTA
                P59_ASENTABLE
                P59_TIPO_CUENTA
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 60
                items: {
                    P60_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        heading {
            fixedTo: region
            maxReportHeight: 330
        }
        advanced {
            savedReportMappingIdentifier: 10469884590357368
        }

        column ABREVIATURA (
            type: hidden
            heading {
