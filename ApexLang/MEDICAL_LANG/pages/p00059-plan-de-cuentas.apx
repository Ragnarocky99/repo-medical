    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P59_ASENTABLE (
        type: selectList
        label {
            label: <p>Asentable:</p>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sí;S,No;N
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
    )

    pageItem P59_COD_CUENTA (
        type: textField
        label {
            label: <p>Cód. de Cuenta:</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
    )

    pageItem P59_NOMBRE_CUENTA (
        type: textField
        label {
            label: <p>Nombre de cuenta:</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
    )

    pageItem P59_TIPO_CUENTA (
        type: selectList
