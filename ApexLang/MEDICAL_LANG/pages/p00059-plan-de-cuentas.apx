    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 20
            region: @plan-de-cuentas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 60
                clearCache: 60
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @plan-de-cuentas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button limpiar (
        buttonName: LIMPIAR
        label: Limpiar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction clear-items (
        name: CLEAR_ITEMS
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @limpiar
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P59_COD_CUENTA
                    P59_NOMBRE_CUENTA
                    P59_ASENTABLE
                    P59_TIPO_CUENTA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @plan-de-cuentas
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @plan-de-cuentas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @plan-de-cuentas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @buscar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @plan-de-cuentas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid-onchange (
        name: REFRESH_GRID_ONCHANGE
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P59_COD_CUENTA
                P59_NOMBRE_CUENTA
                P59_ASENTABLE
                P59_TIPO_CUENTA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @plan-de-cuentas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17372153789550875
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

    branch (
        name: Go To Page 194
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 194
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

