            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:ACTIVO;A,PASIVO;P,PATRIMONIO NETO;N,HABER;H,DEBE;D
            nullDisplayValue: TODOS
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
