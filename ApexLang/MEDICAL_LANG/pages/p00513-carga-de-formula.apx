    dynamicAction habilitar-deshabilitar-columnas (
        name: Habilitar/Deshabilitar Columnas
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @a-producir
            columns: TIPO_COSTEO
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: columns
                columns: [
                    DECIMALES_COSTO_TOTAL
                    DECIMALES_COSTO_UNITARIO
                    PORCENTAJE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                componentType: item
                item: P513_BANDERA
                value: 2
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: columns
                columns: COSTO_FIJO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                componentType: item
                item: P513_BANDERA
                value: 1
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: columns
                columns: COSTO_FIJO
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P513_BANDERA
                value: 1
            }
        )

        action native-enable-2 (
            action: enable
            affectedElements {
                selectionType: columns
                columns: [
                    DECIMALES_COSTO_TOTAL
                    DECIMALES_COSTO_UNITARIO
                    PORCENTAJE
                ]
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P513_BANDERA
                value: 2
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if nvl( :tipo_costeo, 'X' ) = 'F' then
                        :P513_BANDERA := 1;
                    	:porcentaje               := 0 ;
                    	:decimales_costo_total    := 0 ;
                    	:decimales_costo_unitario := 0 ;
                    elsif nvl( :tipo_costeo, 'X' ) = 'P' then
                        :P513_BANDERA := 2;
                    	:costo_fijo := 0 ;
                    else
                        :P513_BANDERA := 0;
                    	:porcentaje               := 0 ;
                    	:decimales_costo_total    := 0 ;
                    	:decimales_costo_unitario := 0 ;
                    	:costo_fijo               := 0 ;
                    end if ;
                    ```
                itemsToSubmit: [
                    TIPO_COSTEO
                    P513_BANDERA
                ]
                itemsToReturn: [
                    PORCENTAJE
                    DECIMALES_COSTO_TOTAL
                    DECIMALES_COSTO_UNITARIO
                    COSTO_FIJO
                    P513_BANDERA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

