page 513 (
    name: Carga de Fórmula
    alias: CARGA-DE-FORMULA
    title: Carga de Fórmula
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1300
        height: 800
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            $("#cantidad").keypress(function(event) {
              event = event || window.event;
              var charCode = (event.which) ? event.which : event.keyCode;
              if (charCode === 44 || charCode === 46) { // Permitir coma (44) o punto (46)
                if ($(this).val().indexOf('.') !== -1 || $(this).val().indexOf(',') !== -1) {
                  // Ya hay un punto o coma, no permitir otro
                  return false;
                }
                return true;
              }
              if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
              }
              return true;
            });
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P513_ID_USUARIO").readOnly = true;
            document.getElementById("P513_FEC_ALTA").readOnly = true;
            document.getElementById("P513_ID_USUARIO_MODIF").readOnly = true;
            document.getElementById("P513_FEC_MODIF").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region a-producir (
        name: A Producir
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PDW_FORMULA_PRODUCIDOS
            whereClause: ID_FORMULA = :P513_ID
            pageItemsToSubmit: P513_ID
        }
        layout {
            sequence: 140
            parentRegion: @carga-de-formula
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Producidos
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 72037566890824802
        }

