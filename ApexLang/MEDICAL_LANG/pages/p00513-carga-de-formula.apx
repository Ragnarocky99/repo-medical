    dynamicAction calculo (
        name: CALCULO
        execution {
            sequence: 90
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @alimentación
            columns: CANTIDAD_S_MERMA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      if nvl(:porc_merma,0) > 0 then
                        :cantidad := round((:cantidad_s_merma * 1) / (1 - (:porc_merma / 100 )),7) ;	 
                      else
                      	:cantidad := :cantidad_s_merma ;
                      end if ;	
                    end ; 
                    
                    BEGIN
                      if nvl(:cantidad_teor,0) > 0 then
                      	 :indice := round(nvl(:cantidad_S_MERMA,0) / nvl(:cantidad_teor,0),4) ;
                      else
                      	 :indice := 0 ;
                      end if ;
                    END;
                    ```
                itemsToSubmit: [
                    PORC_MERMA
                    CANTIDAD
                    CANTIDAD_S_MERMA
                    CANTIDAD_TEOR
                    INDICE
                ]
                itemsToReturn: [
                    CANTIDAD
                    INDICE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculo-merma (
        name: CALCULO_MERMA
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: columns
