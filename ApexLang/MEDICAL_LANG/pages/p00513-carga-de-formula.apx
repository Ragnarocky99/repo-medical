            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-formula (
        name: Carga de Formula
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_FORMULA,
                       CANT_HORAS,
                       ID_ARTICULO,
                       CANTIDAD,
                       ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       COMENTARIO,
                       RECETA,
                       ID_UNIDAD_MEDIDA,
                       CANTIDAD_UB,
                       NIVEL_AUT,
                       ID_SUCURSAL_DESTINO,
                       FEC_MODIF,
                       ID_USUARIO_MODIF,
                       TIP_FORMULA,
                       SE_INFORMA,
                       VAR_REFINERIA,
                       VAR_PACKING,
                       VIDA_UTIL_MES,
                       OBSERVACION
                  from PDW_FORMULA_CAB
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region variables (
        name: Variables
        type: staticContent
        layout {
            sequence: 130
            parentRegion: @carga-de-formula
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
