    dynamicAction validacion-sucursal-vacio (
        name: Validacion Sucursal Vacio
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @create
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :ID_sucursal_destino is null then
                    	RAISE_APPLICATION_ERROR(-20000, 'Ud. no puede insertar una linea cuya Sucursal de Destino este en Blanco.');
                    else
                        
                    	if nvl( :nro_orden, 0 ) = 0 then
                        :P513_nro_orden  := nvl( :P513_nro_orden, 0 ) + 1 ;
                        :nro_orden := :P513_nro_orden ;
                      end if ;
                    end if ;
                    if nvl( :P513_historico, 'N' ) = 'N' then
                    :P513_BANDERA := 1;
                      INSERTA_HISTORICO(:P0_ID_EMPRESA, :P513_ID, :P513_HISTORICO) ;
                    
                    end if ;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction validate-um (
        name: validate_um
        execution {
            sequence: 50
        }
        when {
            selectionType: columns
            interactiveGrid: @a-producir
            columns: ID_UNIDAD_MEDIDA
        }

        action set-um (
            name: set_um
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                     vmul   number;
                     vdiv   number;
                    begin
                            begin
                            	  select  r.mult, r.divisor
                                   into vmul, vdiv
                                from stw_articulos a, stw_relaciones r, stw_unidades_medida u
                               where a.id_empresa  = :P0_ID_EMPRESA
                                 and a.id = :id_articulo
                                 and r.id_relacion_um = a.id
                                 and r.id_unidad_rel  = :id_unidad_medida
                                 and u.id = r.id_unidad_rel ;
                            exception
                            	when no_data_found then
                            	 vmul := 1;
                                 vdiv := 1;
                            	when others then
                            	 vmul := 1;
                                 vdiv := 1;
                            end ;
                              
                            :cantidad_ub := ( ( nvl( :cantidad, 0 ) * nvl( vmul, 1 ) ) / nvl( vdiv, 1 ) ) ;
                            end;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                    P0_ID_EMPRESA
                ]
                itemsToReturn: CANTIDAD_UB
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p513-cod-formula (
        itemName: P513_COD_FORMULA
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                   declare
                   v_numero number;
                   
                   begin
                   if :P513_COD_FORMULA is null then
                      select nvl( max( TO_NUMBER(COD_FORMULA) ), 0 ) + 1
                         into v_numero
                         from PDW_FORMULA_CAB
                         where ID_EMPRESA = :P0_ID_EMPRESA ;
                       RETURN v_numero;
                      end if;
                      RETURN :P513_COD_FORMULA;
                   exception
                      when no_data_found then
                        :P513_COD_FORMULA  := 1 ;
                        RETURN :P513_COD_FORMULA;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Formula' || sqlerrm ) ;
                   end ;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P513_ID
        }
    )

