page 267 (
    name: Venta Detalle Articulos
    alias: VENTA-DETALLE-RUBRO-FAMILIA
    title: Venta Detalle Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: FILTROS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region venta-detalle-rubro-familia (
        name: Venta Detalle Rubro-Familia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  V.TIP_COMPROBANTE,
                        V.FEC_COMPROBANTE,
                        V.NRO_COMPROBANTE,
                        V.COD_ARTICULO,
                        V.DESC_ARTICULO,
                        V.COD_FABRICANTE,
                        V.MONTO_TOTAL TOT_GRAVADA,
                        V.TOTAL_IVA TOT_IVA,
                        V.MONTO_TOTAL_C_IVA TOT_COMPROBANTE,
                        V.MONTO_TOTAL_S_IVA TOT_EXENTA, --MONTO_TOTAL_S_IVA
                        V.DESC_FAMILIA,
                        V.ID_FAMILIA,
                        V.DESC_RUBRO,
                        V.ID_RUBRO,
                        V.DESC_LINEA,
                        v.ID_LINEA,
                        V.DESC_MARCA,
                        V.ID_MARCA,
                        V.CLIENTE,
                        V.NRO_LOTE,
                        --sum(V.NRO_OCC) as Nro_OCC,
                        Nro_OCC,
                        V.CANTIDAD_UB,
                        V.TRIPTICO,
                        V.FEC_TRIPTICO,
                        V.IND_CONTROLADO,
                        V.ID_ENVASE,
                        V.ID_UNIDAD_MEDIDA,
                        v.id_tip_cliente,
                        V.ID_CLIENTE,
                        V.ID_ARTICULO,
                        v.ID_FACDET,
                        -- (SELECT PC.FEC_COMPROBANTE
                        --    FROM VTW_COMPROBANTES_CABECERA VC
                        --  LEFT JOIN VTW_PEDIDOS_CABECERA PC ON PC.SER_COMPROBANTE = VC.SER_COMPROBANTE_REF AND PC.NRO_COMPROBANTE = VC.NRO_COMPROBANTE_REF
                        --   WHERE VC.ID = V.ID_COMPROBANTE
                        --     AND VC.TIP_COMPROBANTE_REF = 'PED') FEC_PEDIDO,
                        V.FEC_PEDIDO,
                        V.CONTROLADO,
                        V.ID_VENDEDOR,
                        V.NRO_ITEM,
                        V.NRO_PLANILLA_REPARTO,
                        V.NRO_LICITACION,
                        V.FEC_OCC,
                        V.FEC_PLAZO
                FROM    VTV_VENTAS  V
                WHERE   V.ID_EMPRESA  = :P0_ID_EMPRESA
                AND     V.FEC_COMPROBANTE BETWEEN :P267_FECHA_INI AND :P267_FECHA_FIN
                /*AND V.FEC_COMPROBANTE >=  :P267_FECHA_INI
                AND V.FEC_COMPROBANTE <=  :P267_FECHA_FIN
                AND     (V.ID_RUBRO = :P267_RUBRO OR :P267_RUBRO IS NULL)
                AND     (V.ID_FAMILIA = :P267_FAMILIA OR :P267_FAMILIA IS NULL)
                AND     (V.ID_LINEA = :P267_LINEA OR :P267_LINEA IS NULL)*/
                AND     (V.ID_MARCA = :P267_MARCA OR :P267_MARCA IS NULL)
                AND     (NVL(V.IND_CONTROLADO,'N') = :P267_CONTROLADO OR :P267_CONTROLADO IS NULL)
                AND     (V.ID_CLIENTE = :P267_ID_CLIENTE OR :P267_ID_CLIENTE IS NULL)
                AND     (V.ID_ARTICULO = :P267_ID_ARTCIULO OR :P267_ID_ARTCIULO IS NULL)
                
                -- group by V.FEC_COMPROBANTE,
                --         V.NRO_COMPROBANTE,
                --         V.COD_ARTICULO,
                --         V.DESC_ARTICULO,
                --         V.COD_FABRICANTE,
                --         V.TOT_GRAVADA, --MONTO_TOTAL
                --         V.TOT_IVA, --TOTAL_IVA
                --         V.TOT_COMPROBANTE, --MONTO_TOTAL_C_IVA
                --         v.TOT_EXENTA, --MONTO_TOTAL_S_IVA
                --         V.DESC_FAMILIA,
                --         V.ID_FAMILIA,
                --         V.DESC_RUBRO,
                --         V.ID_RUBRO,
                --         V.DESC_LINEA,
                --         v.ID_LINEA,
                --         V.DESC_MARCA,
                --         V.ID_MARCA,
                --         V.CLIENTE,
                --         V.NRO_LOTE,
                --         V.CANTIDAD_UB,
                --         V.TRIPTICO,
                --         V.FEC_TRIPTICO,
                --         V.IND_CONTROLADO,
                --         V.ID_ENVASE,
                --         V.ID_UNIDAD_MEDIDA,
                --         v.id_tip_cliente,
                --         V.ID_CLIENTE,
                --         V.ID_ARTICULO,
                --         v.ID_FACDET,
                --         V.ID_COMPROBANTE,
                --         V.TIP_COMPROBANTE,
                --         V.NRO_OCC,
                --         V.CONTROLADO,
                --         V.ID_VENDEDOR,
                --         V.NRO_ITEM,
                --         --V.NRO_PLANILLA_REPARTO,
                --         V.NRO_LICITACION
                ```
            pageItemsToSubmit: [
                P267_FECHA_INI
                P267_FECHA_FIN
                P267_ID_CLIENTE
                P267_ID_ARTCIULO
                P267_MARCA
                P267_CONTROLADO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 60033769761098925
        }

