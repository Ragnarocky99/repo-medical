page 283 (
    name: Campañas de WhatsApp
    alias: CAMPAÑAS-DE-WHATSAPP
    title: Campañas de WhatsApp
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region campañas-de-whatsapp (
        name: Campañas de WhatsApp
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       NAME,
                       CASE TYPE 
                       WHEN 'text' then 'Texto'
                       WHEN 'media' then 'Imagen'
                       WHEN 'document' then 'documento'
                       END AS TIPO,
                       CASE STATUS 
                   WHEN     'completed' then 'Completado'
                    when   'paused' then    'Pausado'
                    WHEN 'pending'  then 'Pendiente'
                    WHEN 'running'  then 'En Proceso'
                       end as ESTADO,
                       ACCOUNT,
                       TO_CHAR(TO_DATE('01/01/1970','DD/MM/YYYY')+NUMTODSINTERVAL(CREATED,'SECOND'),'DD/MM/YYYY HH24:MI:SS') AS FECHA_CREACION,
                       CONTACTS
                  from WH_CAMPANHAS_WHATSAPP
                  order by fecha_creacion desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 67077979657963890
        }

        column ACCOUNT (
            type: plainText
            heading {
                heading: Cuenta
                alignment: center
            }
            layout {
                sequence: 31
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column CONTACTS (
            type: plainText
            heading {
                heading: Contactos
                alignment: center
            }
            layout {
                sequence: 51
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 71
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column FECHA_CREACION (
            type: plainText
            heading {
                heading: Fecha Creacion
                alignment: center
            }
            layout {
                sequence: 81
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Nombre
                alignment: center
            }
            layout {
                sequence: 21
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 61
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Campañas de WhatsApp
        }

        savedReport 670814 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNT (
                sequence: 3
            )

            displayColumn CONTACTS (
                sequence: 2
            )

            displayColumn NAME (
                sequence: 1
            )

        )

    )

    pageItem P283_CUENTA_ID (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT W_BUSCA_PARAMETRO('WH','ID_CUENTA_WHA') FROM DUAL;
        }
    )

    button excel (
        buttonName: EXCEL
        label: Excel
        layout {
            sequence: 10
            region: @campañas-de-whatsapp
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 289
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button masivo (
        buttonName: Masivo
        label: Masivo
        layout {
            sequence: 20
            region: @campañas-de-whatsapp
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-envelope
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 287
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refrescar (
        buttonName: Refrescar
        label: Refrescar
        layout {
            sequence: 30
            region: @campañas-de-whatsapp
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @masivo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @campañas-de-whatsapp
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-tabla (
        name: Refrescar Tabla
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @campañas-de-whatsapp
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

