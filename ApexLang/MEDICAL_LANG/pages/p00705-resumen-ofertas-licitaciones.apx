    region resumen-ofertas-licitaciones (
        name: Resumen Ofertas-Licitaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    od.id,
                    oc.nro_oferta, 
                    oc.nro_licitacion,
                    od.nro_item,
                    od.id_unidad_medida,
                    od.id_presentacion,
                    ld.tip_contrato,
                    od.cant_min,
                    od.cant_max,
                    od.id_marca,
                    od.pais_procedencia,
                    ar.cod_articulo,
                    ar.cod_origen_art,
                    ar.descripcion,
                    od.cod_articulo_ref,
                    od.desc_articulo_ref,
                    od.cantidad_sistema,
                    --nvl(vpc.nro_pedido,'No encontrado') as nro_pedido,
                    nvl(vpc.cantidad_en_pedido,0) as cantidad_en_pedido,
                    oc.id_cliente,
                    od.id_moneda,
                    od.id_proveedor,
                    od.costo_unitario_local,
                    od.costo_total_local,
                    od.costo_total_gs/od.cantidad_sistema as costo_unitario_gs,
                    od.costo_total_gs,
                    decode(od.ind_conviene,'S','fa fa-check u-success-text','N','fa fa-remove u-danger-text') Adjudicado,
                    decode(od.ind_se_oferta,'S','fa fa-check u-success-text','N','fa fa-remove u-danger-text') Ofertado,
                    --Cálculos y Referencias
                    NVL(fd.cantidad_facturada, 0) AS cantidad_facturada,
                    --NVL(fd.facturado_en, 'No encontrado') AS facturado_en,
                    NVL(rd.cantidad_remisionada, 0) AS cantidad_remisionada,
                    --NVL(rd.remisionado_en, 'No encontrado') AS remisionado_en,
                    NVL(pd.cantidad_comprada, 0) AS cantidad_ocp
                    --NVL(pd.comprado_en, 'No encontrado') AS comprado_en
                FROM lcw_ofertas_det od
                JOIN stw_articulos   ar ON ar.id = od.id_articulo
                JOIN lcw_ofertas_cab oc ON oc.id = od.id_oferta_cab
                JOIN lcw_licitaciones_det ld on od.id_licitacion_det = ld.id
                LEFT JOIN (
                    SELECT 
                        fd.id_oferta_lic, 
                        SUM(fd.cantidad) AS cantidad_facturada
                        
                    FROM vtw_comprobantes_detalle fd
                    LEFT JOIN vtw_comprobantes_cabecera fc ON fc.id = fd.id_comprobante_cabecera
                    GROUP BY fd.id_oferta_lic
                ) fd ON od.id = fd.id_oferta_lic
                LEFT JOIN (
                    SELECT 
                        rd.id_oferta_lic, 
                        SUM(rd.cantidad) AS cantidad_remisionada
                    FROM stw_entsal_det rd
                    LEFT JOIN stw_entsal_cab rc ON rc.id = rd.id_entsal_cab
                    GROUP BY rd.id_oferta_lic
                ) rd ON od.id = rd.id_oferta_lic
                LEFT JOIN (
                    SELECT 
                        pd.id_oferta_lic, 
                        SUM(pd.cantidad) AS cantidad_comprada
                    FROM cmw_pedidos_detalle pd
                    LEFT JOIN cmw_pedidos_cabecera pc ON pc.id = pd.id_pedido_cab
                    GROUP BY pd.id_oferta_lic
                ) pd ON od.id = pd.id_oferta_lic
                LEFT JOIN (
                    SELECT 
                        VPD.ID_OFERTA_LIC,
                        sum(nvl(vpd.cantidad,0)) as cantidad_en_pedido
                    FROM VTW_PEDIDOS_CABECERA VPC
                    JOIN VTW_PEDIDOS_DETALLE  VPD ON VPD.ID_PEDIDO_CABecera = vPc.ID   
                    GROUP BY VPD.ID_OFERTA_LIC
                ) VPC ON  OD.ID = VPC.ID_OFERTA_LIC
                WHERE OC.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (OC.ID_CLIENTE  = :P705_ID_CLIENTE  OR :P705_ID_CLIENTE  IS NULL)
                  AND (OD.ID_ARTICULO = :P705_ID_ARTICULO OR :P705_ID_ARTICULO IS NULL)
                  AND (OC.NRO_OFERTA  = :P705_NRO_OFERTA  OR :P705_NRO_OFERTA  IS NULL)
                  AND (OD.IND_CONVIENE = :P705_IND_ADJUDICADO OR :P705_IND_ADJUDICADO IS NULL)
                  AND (OD.IND_SE_OFERTA = :P705_IND_OFERTADO OR :P705_IND_OFERTADO IS NULL)
                ---WHERE od.id_oferta_cab = 174
                /*GROUP BY 
                    oc.nro_oferta, 
                    ar.cod_articulo,
                    ar.descripcion,
                    od.cod_articulo_ref,
                    od.desc_articulo_ref,
                    od.cantidad_sistema,
                    fd.cantidad_facturada,
                    fd.facturado_en,
                    rd.cantidad_remisionada,
                    rd.remisionado_en,
                    pd.cantidad_comprada,
                    pd.comprado_en,
                    oc.id_cliente,
                    ar.cod_origen_art,
                    od.ind_conviene,
                    vpc.nro_pedido;
                */
                ```
            pageItemsToSubmit: [
                P705_ID_CLIENTE
                P705_ID_ARTICULO
                P705_NRO_OFERTA
                P705_IND_ADJUDICADO
                P705_IND_OFERTADO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 17845824750375340
        }

