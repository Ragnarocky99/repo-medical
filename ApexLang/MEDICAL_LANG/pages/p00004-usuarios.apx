page 4 (
    name: Usuarios
    alias: USUARIOS
    title: Usuarios - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region usuarios (
        name: Usuarios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_USUARIO,
                       ID_PERSONA,
                       CLAVE,
                       ID_GRUPO,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ESTADO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       ID_AREA,
                       SUCURSAL_NCR,
                       ID_SECTOR_VEN,
                       IND_VERIFICA_MENU,
                       PUEDE_FACTURAR,
                       SUCURSAL_DEB,
                       ID_VENDEDOR,
                       E_MAIL,
                       COD_USUARIO_AUD,
                       TIPO_MENU,
                       TIPO_PERFIL,
                       COLOR_MENU,
                       TEMA_MENU,
                       DASHBOARD,
                       ID_CUSTODIO,
                       AUTORIZA_STOCK,
                       AUTORIZA_CTACTE,
                       DARK_MENU,
                       TIPO_DASHBOARD,
                       IND_ANALIZA_CREDITOS,
                       IND_REFERENCISTA,
                       IND_CAJERO,
                       MONTO_APROBACION,
                       TELEFONO,
                       USA_APP
                  from BSW_USUARIOS
                  WHERE ID_SUCURSAL = :P0_COD_SUCURSAL
                  AND ID_EMPRESA = :P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No se ha encontrado ningún dato.
            whenMoreDataFound: El recuento máximo de filas de este informe es #MAX_ROW_COUNT# filas. Aplique un filtro para reducir el número de registros de la consulta.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5254325896084271
        }

        column AUTORIZA_CTACTE (
            type: plainText
            heading {
                heading: Autoriza Ctacte
            }
            layout {
                sequence: 200
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

