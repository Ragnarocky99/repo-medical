            }
            clientSideCondition {
                type: item=value
                item: P737_IND_ASIENTO_APERTURA
                value: S
            }
        )

        action apertura-2 (
            name: APERTURA
            action: show
            affectedElements {
                selectionType: button
                button: @apertura
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P737_IND_ASIENTO_APERTURA
                value: S
            }
        )

    )

