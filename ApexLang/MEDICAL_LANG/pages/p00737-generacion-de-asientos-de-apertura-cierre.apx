        }
    )

    pageItem P737_ID_EJERCICIO (
        type: popupLov
        label {
            label: <p>Ejercicio:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT COD_EJERCICIO D, ID R
                  FROM COW_EJERCICIOS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            region: @generador
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P737_MENSAJE_PROC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @generador
            slot: regionBody
        }
    )

    button apertura (
        buttonName: APERTURA
        label: Apertura
        layout {
            sequence: 10
            region: @botones
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-folder-open
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button cierre (
        buttonName: CIERRE
        label: Cierre
        layout {
            sequence: 20
            region: @botones
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-folder
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction generar-apertura (
        name: Generar Apertura
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @apertura
        }

        action alerta-de-asiento-de-apertura-existente (
            name: Alerta de Asiento de Apertura existente
            action: alert
            settings {
                message: &P737_MENSAJE_PROC.
                style: warning
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P737_MENSAJE_PROC
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vMensaje      VARCHAR2(500);
                        vExiste       VARCHAR2(1);
                        vCodEjercicio COW_EJERCICIOS.COD_EJERCICIO%TYPE;
                        vNumAsiento   COW_DIARIO_CABECERAS_PROV.NUM_ASIENTO%TYPE;
                    BEGIN
                        BEGIN
                            SELECT 'S', EJ.COD_EJERCICIO, DC.NUM_ASIENTO
                              INTO vExiste, vCodEjercicio, vNumAsiento
                              FROM COW_DIARIO_CABECERAS_PROV DC
                              JOIN COW_EJERCICIOS            EJ ON EJ.ID = DC.ID_EJERCICIO
                             WHERE ID_EJERCICIO = :P737_ID_EJERCICIO
                               AND NVL(IND_ASIENTO_APERTURA, 'N') = 'S'
                               AND ROWNUM = 1;
                        EXCEPTION
                            WHEN OTHERS THEN
                                vExiste := 'N';
                        END;
                    
                        IF vExiste = 'S' THEN
                         :P737_MENSAJE_PROC := 'Ya existe el asiento de apertura numero '||vNumAsiento||' para el ejercicio '||vCodEjercicio;
                        END IF;
                        
                        IF vExiste = 'N' THEN
                          -- Call the procedure
                            vMensaje := NULL;
                    
                            COWP_GENERA_CIERRE_APERTURA(p_id_empresa   => :P0_ID_EMPRESA,
                                               p_id_ejercicio => :P737_ID_EJERCICIO,
                                               p_fec_inicio   => :P737_FEC_INI,
                                               p_fec_final    => :P737_FEC_FIN,
                                               p_descripcion  => :P737_DESC_ASIENTO,
                                               p_mensaje      => vMensaje,
                                               p_tipo         => 'A');
                    
                            :P737_MENSAJE_PROC := vMensaje;
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P737_ID_EJERCICIO
                    P737_FEC_INI
                    P737_FEC_FIN
                    P737_DESC_ASIENTO
                ]
                itemsToReturn: P737_MENSAJE_PROC
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction generar-cierre (
        name: Generar Cierre
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @cierre
        }

        action alerta-de-asiento-de-apertura-existente (
            name: Alerta de Asiento de Apertura existente
            action: alert
            settings {
                message: &P737_MENSAJE_PROC.
                style: warning
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P737_MENSAJE_PROC
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vMensaje      VARCHAR2(500);
                        vExiste       VARCHAR2(1);
                        vCodEjercicio COW_EJERCICIOS.COD_EJERCICIO%TYPE;
                        vNumAsiento   COW_DIARIO_CABECERAS_PROV.NUM_ASIENTO%TYPE;
                    BEGIN
                        BEGIN
                            SELECT 'S', EJ.COD_EJERCICIO, DC.NUM_ASIENTO
                              INTO vExiste, vCodEjercicio, vNumAsiento
                              FROM COW_DIARIO_CABECERAS_PROV DC
                              JOIN COW_EJERCICIOS            EJ ON EJ.ID = DC.ID_EJERCICIO
                             WHERE ID_EJERCICIO = :P737_ID_EJERCICIO
                               AND NVL(IND_ASIENTO_CIERRE, 'N') = 'S'
                               AND ROWNUM = 1;
                        EXCEPTION
                            WHEN OTHERS THEN
                                vExiste := 'N';
                        END;
                    
                        IF vExiste = 'S' THEN
                         :P737_MENSAJE_PROC := 'Ya existe el asiento de cierre numero '||vNumAsiento||' para el ejercicio '||vCodEjercicio;
                        END IF;
                        
                        IF vExiste = 'N' THEN
                          -- Call the procedure
                            vMensaje := NULL;
                    
                            COWP_GENERA_CIERRE_APERTURA(p_id_empresa   => :P0_ID_EMPRESA,
                                               p_id_ejercicio => :P737_ID_EJERCICIO,
                                               p_fec_inicio   => :P737_FEC_INI,
                                               p_fec_final    => :P737_FEC_FIN,
                                               p_descripcion  => :P737_DESC_ASIENTO,
                                               p_mensaje      => vMensaje,
                                               p_tipo         => 'C');
                    
                            :P737_MENSAJE_PROC := vMensaje;
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P737_ID_EJERCICIO
                    P737_FEC_INI
                    P737_FEC_FIN
                    P737_DESC_ASIENTO
                ]
                itemsToReturn: P737_MENSAJE_PROC
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asientos-apertura-cierre
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction ocultar-habilitar-botones-apertura (
        name: Ocultar/Habilitar Botones Apertura
