page 737 (
    name: Generacion de Asientos de Apertura/Cierre
    alias: GENERACION-DE-ASIENTOS-DE-APERTURA-CIERRE
    title: Generacion de Asientos de Apertura/Cierre
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asientos-apertura-cierre (
        name: Asientos Apertura/Cierre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CASE
                        WHEN NVL(IND_ASIENTO_APERTURA, 'N') = 'S' THEN 'APERTURA'
                        WHEN NVL(IND_ASIENTO_CIERRE, 'N')   = 'S' THEN 'CIERRE'
                        ELSE ''
                       END TIPO,
                       NUM_ASIENTO,
                       ID
                  FROM COW_DIARIO_CABECERAS_PROV
                 WHERE ID_EJERCICIO = :P737_ID_EJERCICIO
                   AND (NVL(IND_ASIENTO_APERTURA, 'N') = 'S' OR NVL(IND_ASIENTO_CIERRE, 'N') = 'S')
                ```
            pageItemsToSubmit: P737_ID_EJERCICIO
        }
        layout {
            sequence: 20
            slot: fullWidthContent
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column NUM_ASIENTO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Número Asiento
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 235
                    items: {
                        P235_ID: #ID#
                    }
                }
                linkText: #NUM_ASIENTO#
            }
        )

        column TIPO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

    )

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @generador
            slot: subRegions
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noUI
                t-Form--noPadding
            ]
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region definiciones-plan-cuentas (
        name: Definiciones Plan Cuentas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    CASE 
                        WHEN P.TIPO_CUENTA = 'P' AND SUBSTR(P.COD_CUENTA, 1, 1) = '3' THEN 'PN'
                        ELSE P.TIPO_CUENTA
                    END AS TIPO_CUENTA,
                    SUBSTR(P.COD_CUENTA, 1, 1) AS CUENTA
                FROM COW_PLAN_CUENTAS P
                GROUP BY 
                    CASE 
                        WHEN P.TIPO_CUENTA = 'P' AND SUBSTR(P.COD_CUENTA, 1, 1) = '3' THEN 'PN'
                        ELSE P.TIPO_CUENTA
                    END,
                    SUBSTR(P.COD_CUENTA, 1, 1)
                ORDER BY 2;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @asientos-apertura-cierre
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CUENTA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Cuenta
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column TIPO_CUENTA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Tipo Cuenta
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

