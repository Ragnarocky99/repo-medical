    dynamicAction refrescar-lista (
        name: Refrescar Lista
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P737_ID_EJERCICIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asientos-apertura-cierre
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-apertura-cierre (
        name: Setear Apertura/Cierre
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P737_ID_EJERCICIO
        }

        action p737-ind-asiento-apertura (
            name: P737_IND_ASIENTO_APERTURA
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 'S'
                      FROM COW_DIARIO_CABECERAS_PROV
                     WHERE ID_EJERCICIO = :P737_ID_EJERCICIO
                       AND NVL(IND_ASIENTO_APERTURA, 'N') = 'S'
                       AND ROWNUM = 1
                    ```
                itemsToSubmit: P737_ID_EJERCICIO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P737_IND_ASIENTO_APERTURA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action p737-ind-asiento-cierre (
            name: P737_IND_ASIENTO_CIERRE
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 'S'
                      FROM COW_DIARIO_CABECERAS_PROV
                     WHERE ID_EJERCICIO = :P737_ID_EJERCICIO
                       AND NVL(IND_ASIENTO_CIERRE, 'N') = 'S'
                       AND ROWNUM = 1
                    ```
                itemsToSubmit: P737_ID_EJERCICIO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P737_IND_ASIENTO_CIERRE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-periodo (
        name: Setear Periodo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P737_ID_EJERCICIO
        }

        action p737-fec-fin (
            name: P737_FEC_FIN
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TO_DATE('31/12/'||COD_EJERCICIO, 'dd/MM/yyyy')
                      FROM COW_EJERCICIOS
                     WHERE ID = :P737_ID_EJERCICIO
                    ```
                itemsToSubmit: P737_ID_EJERCICIO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P737_FEC_FIN
            }
            execution {
                sequence: 20
            }
        )

        action p737-fec-ini (
            name: P737_FEC_INI
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TO_DATE('01/01/'||COD_EJERCICIO, 'dd/MM/yyyy')
                      FROM COW_EJERCICIOS
                     WHERE ID = :P737_ID_EJERCICIO
                    ```
                itemsToSubmit: P737_ID_EJERCICIO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P737_FEC_INI
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p737-id-ejercicio (
        itemName: P737_ID_EJERCICIO
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT ID
                  FROM COW_EJERCICIOS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                   AND COD_EJERCICIO = :P0_COD_EJERCICIO
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P737_ID_EJERCICIO
        }
    )

)

