    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P741_ID_PROVEEDOR
                P741_ID_ARTICULO
                P741_IND_APROBADO
                P741_NRO_OCP
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @aprobaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-grilla (
        name: Refrescar grilla
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @aprobaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process aprobaciones-save-interactive-grid-data (
