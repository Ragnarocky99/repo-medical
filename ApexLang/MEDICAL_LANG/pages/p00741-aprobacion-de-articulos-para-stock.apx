page 741 (
    name: Aprobacion de Articulos para Stock
    alias: APROBACION-DE-ARTICULOS-PARA-STOCK
    title: Aprobacion de Articulos para Stock
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region aprobaciones (
        name: Aprobaciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PD.ID,
                       PC.ID_SUCURSAL,
                       PC.FEC_COMPROBANTE,
                       PC.NRO_COMPROBANTE NRO_OCP,
                       PC.ID_PROVEEDOR,
                       AR.COD_ARTICULO,
                       AR.COD_ORIGEN_ART,
                       PD.DESC_ARTICULO,
                       PD.PRECIO_UNITARIO_C_IVA COSTO_UNITARIO,
                       PD.CANTIDAD,
                       PD.MONTO_TOTAL_C_IVA,
                       PD.IND_APROBADO,
                       NVL((SELECT SUM(NVL(EA.CANT_DISPON, 0))
                              FROM STW_EXISTENCIA_ART EA
                             WHERE EA.ID_ARTICULO = AR.ID
                               AND EA.ID_LOTE     = LO.ID
                               AND EA.ID_SUCURSAL IN (
                                   SELECT ID
                                     FROM BSW_SUCURSALES
                                    WHERE ID_SUCURSAL_CENTRAL = PC.ID_SUCURSAL
                               )), 0) STOCK,
                       OBTENER_CANTIDAD_BLOQUEO(AR.ID, SU.ID_SUCURSAL_CENTRAL, 'S') CANT_BLOQUEO,
                       PC.ID ID_PEDIDO_CAB
                  FROM CMW_PEDIDOS_DETALLE     PD
                  JOIN CMW_PEDIDOS_CABECERA    PC ON PC.ID = PD.ID_PEDIDO_CAB
                  JOIN STW_ARTICULOS           AR ON AR.ID = PD.ID_ARTICULO
                  JOIN STW_LOTES               LO ON AR.ID = LO.ID_ARTICULO AND LO.NRO_LOTE = PD.NRO_LOTE
                LEFT JOIN CMW_COMPRAS_CABECERA CC ON PC.ID = CC.ID_COMPROBANTE_REF
                  JOIN BSW_SUCURSALES          SU ON SU.ID = PC.ID_SUCURSAL
                 WHERE NVL(PC.ANULADO, 'N') != 'S'
                   AND NVL(PD.IND_PARA_STOCK, 'N') = 'S'
                   AND PC.ID_EMPRESA = :P0_ID_EMPRESA
                   AND PC.FEC_COMPROBANTE BETWEEN :P741_FEC_INI AND :P741_FEC_FIN
                   AND (PD.ID_ARTICULO = :P741_ID_ARTICULO OR :P741_ID_ARTICULO IS NULL)
                   AND (PC.ID_PROVEEDOR = :P741_ID_PROVEEDOR OR :P741_ID_PROVEEDOR IS NULL)
                   AND (NVL(PD.IND_APROBADO, 'N') = :P741_IND_APROBADO OR :P741_IND_APROBADO IS NULL)
                   AND NVL(PD.ANULADO, 'N') != 'S'
                   AND CC.ID IS NULL
                   AND (PC.NRO_COMPROBANTE = :P741_NRO_OCP OR :P741_NRO_OCP IS NULL)
                ```
            pageItemsToSubmit: [
                P741_FEC_INI
                P741_FEC_FIN
                P741_ID_PROVEEDOR
                P741_ID_ARTICULO
                P741_IND_APROBADO
                P741_NRO_OCP
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
