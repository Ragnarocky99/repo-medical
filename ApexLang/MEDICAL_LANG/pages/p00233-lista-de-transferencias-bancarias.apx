page 233 (
    name: Lista de Transferencias Bancarias
    alias: LISTA-DE-TRANSFERENCIAS-BANCARIAS
    title: Lista de Transferencias Bancarias
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lista-de-transferencias-bancarias (
        name: Lista de Transferencias Bancarias
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-de-transferencias-bancarias-2 (
        name: Lista de Transferencias Bancarias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.TIP_COMPROBANTE,
                       D.SER_COMPROBANTE,
                       D.NRO_COMPROBANTE,
                       D.REFERENCIA,
                       D.FEC_COMPROBANTE,
                       D.ID_SUCURSAL,
                       D.ID_PER_JURIDICA,
                       D.ID_CUENTA,
                       D.ID_MONEDA,
                       D.TIP_CAMBIO,
                       D.ID_TIPO_TRANS,
                       D.ID_SUB_TIPO_TRANS,
                       REPLACE(D.ASIENTOS,'*') ASIENTOS,
                       (SELECT C.ID
                        FROM COW_DIARIO_CABECERAS_PROV C
                        WHERE C.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(D.ASIENTOS,'*'),'dep'))
                          AND C.ID_EJERCICIO= TRAE_ID_EJERCICIO(D.FEC_COMPROBANTE)
                          AND C.ID_EMPRESA  = D.ID_EMPRESA) ASIENTO_ID,
                       D.ID_CUENTA_ENT,
                       D.ID_PER_JURIDICA_ENT,
                       D.ID_MONEDA_ENT,
                       D.TIP_CAMBIO_ENT,
                       D.NRO_OPERACION_BANCO,
                       D.FEC_ALTA,
                       D.FEC_MODIF,
                       D.IND_IMPORTACION,
                       D.ID_PROVEEDOR,
                       D.ID_USUARIO_ALTA,
                       D.ID_USUARIO_MODIF,
                       D.FEC_BANCO,
                       D.ID_CENTRO_COSTO,
                       D.NRO_PLANILLA_FF,
                       D.NRO_PLANILLA_ENT,
                       D.REF_COMPROBANTE,
                       D.IMPORTE,
                
                       C.ID AS ID_CHEQUE
                  from CCW_DEBCRED_BANCARIOS D 
                  LEFT JOIN CPW_VALORES_CAJAS C ON  C.ID_DEBCRED=D.ID
                  WHERE D.ID_EMPRESA = :P0_COD_EMPRESA                            
                  AND D.ID_SUCURSAL = :P0_COD_SUCURSAL                             
                  AND D.TIP_COMPROBANTE = 'TRB'
                
                  ORDER BY D.FEC_COMPROBANTE DESC, D.NRO_COMPROBANTE DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 199
                items: {
                    P199_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 47482155957794951
        }

