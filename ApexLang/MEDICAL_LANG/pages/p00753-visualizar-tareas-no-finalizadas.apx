                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            readOnly {
                type: expression
                plsqlExpression:
                    ```plsql
                    :RESPONSABLE != TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) OR
                    NVL(:IND_FINALIZADO, 'N') = 'S'
