    dynamicAction setear-datos-oferta (
        name: Setear Datos Oferta
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action oferta (
            name: Oferta
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT OA.ID_OFERTA,
                           LO.ID_ARTICULO
                      FROM LCW_OFERTAS_APROBACIONES OA
                      JOIN LCW_OFERTAS  LO ON LO.ID = OA.ID_OFERTA
                     WHERE OA.ID = :P753_ID_APROBACION_LIC
                    ```
                itemsToSubmit: P753_ID_APROBACION_LIC
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P753_ID_OFERTA
                    P753_ID_ARTICULO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

