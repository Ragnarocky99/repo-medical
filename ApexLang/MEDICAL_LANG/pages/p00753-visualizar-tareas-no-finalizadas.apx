    region tareas-no-finalizadas (
        name: Tareas No Finalizadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SEG.ID,
                       SEG.FEC_PROX_EVENTO,
                       SEG.DEFINICION,
                       SEG.OBSERVACION,
                       SEG.RESPONSABLE,
                       SEG.IND_FINALIZADO,
                       SEG.ID_PEDIDO,
                       SEG.ID_PEDIDO_DET,
                       SEG.ID_ARTICULO,
                       SEG.ID_COTIZA_ART,
                       SEG.ID_APROBACION_LIC,
                       SEG.ID_OFERTA,
                       SEG.ID_EMPRESA,
                       (SELECT PS.NOMBRE
                          FROM CMW_COTIZA_ARTICULOS CA
                          JOIN VTW_PEDIDOS_CABECERA PC ON PC.ID = CA.ID_PEDIDO
                          JOIN CCW_CLIENTES         CL ON CL.ID = PC.ID_CLIENTE
                          JOIN BSW_PERSONAS         PS ON PS.ID = CL.ID_SOPORTE
                         WHERE CA.ID = SEG.ID_COTIZA_ART
                       UNION ALL
                       SELECT PS.NOMBRE
                          FROM LCW_OFERTAS_APROBACIONES AP
                          JOIN LCW_LICITACIONES_CAB     LC ON LC.ID = AP.ID_LICITACION_CAB
                          JOIN CCW_CLIENTES             CL ON CL.ID = LC.ID_CLIENTE
                          JOIN BSW_PERSONAS         PS ON PS.ID = CL.ID_SOPORTE
                         WHERE AP.ID = SEG.ID_APROBACION_LIC
                       ) SOPORTE
                  FROM CLW_ACCIONES_SEGUI SEG
                  --JOIN CLW_ACCIONES_SEGUI_DEFINICION ASD ON ASD.ID = SEG.DEFINICION
                 WHERE /*NVL(SEG.IND_FINALIZADO, 'N') = 'N'
                   AND */(SEG.ID_COTIZA_ART = :P753_ID_COTIZA_ART OR SEG.ID_APROBACION_LIC = :P753_ID_APROBACION_LIC)
                --ORDER BY SEG.FEC_PROX_EVENTO DESC
                ```
            pageItemsToSubmit: [
                P753_ID_COTIZA_ART
                P753_ID_APROBACION_LIC
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
