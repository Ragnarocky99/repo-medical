    process setear-campos (
        name: Setear Campos
        type: executeCode
        editableRegion: @tareas-no-finalizadas
        source {
            plsqlCode:
                ```plsql
                :ID_ARTICULO       := :P753_ID_ARTICULO;
                :ID_PEDIDO         := :P753_ID_PEDIDO;
                :ID_PEDIDO_DET     := :P753_ID_PEDIDO_DET;
                :ID_COTIZA_ART     := :P753_ID_COTIZA_ART;
                :ID_OFERTA         := :P753_ID_OFERTA;
                :ID_APROBACION_LIC := :P753_ID_APROBACION_LIC;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 31154076784904948
        }
        serverSideCondition {
            type: never
