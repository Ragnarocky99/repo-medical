page 851 (
    name: Proforma - Prestamos
    alias: ORDENES-DE-COMPRA-SERVICIOS
    title: Proforma - Prestamos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ordenes-de-compra-servicios (
        name: Ordenes de Compra - Servicios
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CMWV_ORDEN_COMPRA
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                IND_TIPO_OC = 'SE'
                ```
            orderByClause: NRO_COMPROBANTE DESC
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 854
                items: {
                    P854_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 97077835299008351
        }

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 33
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AG
            }
        )

        column COMENTARIO (
            type: plainText
            heading {
                heading: Comentario
                alignment: center
            }
            layout {
                sequence: 37
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AK
            }
        )

        column ESTADO (
            type: plainTextBasedOnLov
            heading {
                heading: Estado
                alignment: center
            }
            lov {
                lov: @lv-estado-pedido-cm
            }
            layout {
                sequence: 22
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column FEC_ALTA (
