    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @ordenes-de-compra-servicios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 854
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
