        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Ordenes de Compra - Servicios
        }

        savedReport 970985 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_USUARIO_AUD (
                sequence: 16
            )

            displayColumn COMENTARIO (
                sequence: 15
            )

            displayColumn ESTADO (
                sequence: 12
            )

            displayColumn FEC_ALTA (
                sequence: 17
            )

            displayColumn FEC_ESTADO (
                sequence: 13
            )

            displayColumn ID_CONDICION_COMPRA (
                sequence: 6
            )

            displayColumn ID_MONEDA (
                sequence: 10
            )

            displayColumn ID_PROVEEDOR (
                sequence: 5
            )

            displayColumn ID_SUCURSAL (
                sequence: 1
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 4
            )

            displayColumn REFERENCIA (
                sequence: 14
            )

            displayColumn SER_COMPROBANTE (
