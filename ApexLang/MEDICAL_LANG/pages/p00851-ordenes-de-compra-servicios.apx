            )

            displayColumn TOT_SALDO (
                sequence: 8
            )

            displayColumn TOT_SALDO_FACTURA (
                sequence: 9
            )

            highlight ir-condition (
                name: Pendiente
                condition {
                    column: ESTADO
                    value: Pendiente
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #ffffff
                    text: #a96e17
                }
                execution {
                    sequence: 10
                }
