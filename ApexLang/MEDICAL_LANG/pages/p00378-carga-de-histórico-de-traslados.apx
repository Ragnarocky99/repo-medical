        }
        settings {
            outputAs: text
        }
    )

    region carga-de-histórico-de-traslados (
        name: Carga de Histórico de Traslados
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID,
                ID_EMPRESA,
                ID_EMPLEADO,
                FEC_TRASLADO,
                ID_SUCURSAL_ANT,
                ID_CENTRO_PAGO_ANT,
                ID_SECCION_ANT,
                ID_SUCURSAL_ACT,
                ID_CENTRO_PAGO_ACT,
                ID_SECCION_ACT,
                COD_USUARIO_AUD
                FROM RHW_HIST_TRASLADOS
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                ORDER BY ID DESC;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

