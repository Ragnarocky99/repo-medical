page 860 (
    name: Existencia Ultimos 5 Dias
    alias: EXISTENCIA-ULTIMOS-5-DIAS
    title: Existencia Ultimos 5 Dias
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region existencia-ultimos-5-dias (
        name: Existencia Ultimos 5 Dias
        type: interactiveReport
        source {
            location: localDatabase
            tableName: STWV_EXIST_ART_5DIAS
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 104242990876421284
        }

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESC_ART (
            type: plainText
            heading {
                heading: Articulo
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESC_SUCURSAL (
            type: plainText
            heading {
                heading: Sucursal
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DIAS_PASADOS (
            type: plainText
            heading {
                heading: Dias Pasados
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column FEC_ULT_MOVIMIENTO (
            type: plainText
            heading {
                heading: Fec. Ult. Movimiento
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 7
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column STOCK (
            type: plainText
            heading {
                heading: Stock
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Existencia Ultimos 5 Dias
        }

        savedReport 1042488 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_ARTICULO (
                sequence: 3
            )

            displayColumn DESC_ART (
                sequence: 4
            )

            displayColumn DESC_SUCURSAL (
                sequence: 2
            )

            displayColumn DIAS_PASADOS (
                sequence: 6
            )

            displayColumn FEC_ULT_MOVIMIENTO (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 7
            )

            displayColumn STOCK (
                sequence: 5
