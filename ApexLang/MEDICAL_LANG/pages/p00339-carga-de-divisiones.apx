page 339 (
    name: Carga de Divisiones
    alias: CARGA-DE-DIVISIONES
    title: Carga de Divisiones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P339_COD_DIVISION").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-divisiones (
        name: Carga de Divisiones
        type: form
        source {
            location: localDatabase
            tableName: RHW_DIVISIONES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P339_COD_DIVISION (
        type: textField
        label {
            label: <p>Cód. División: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-divisiones
            slot: regionBody
            alignment: left
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 5
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-divisiones
            column: COD_DIVISION
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(COD_DIVISION)), 0) + 1 FROM RHW_DIVISIONES WHERE ID_EMPRESA=:P0_ID_EMPRESA;
        }
    )

    pageItem P339_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-divisiones
            slot: regionBody
            alignment: left
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @carga-de-divisiones
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P339_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-divisiones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-divisiones
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P339_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 40
            region: @carga-de-divisiones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-divisiones
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    pageItem P339_ID_SUCURSAL (
        type: hidden
        layout {
            sequence: 50
            region: @carga-de-divisiones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-divisiones
            column: ID_SUCURSAL
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_SUCURSAL
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P339_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P339_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P339_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 13976214105506003
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-divisiones (
        name: Initialize form Carga de Divisiones
        type: formInitialization
        formRegion: @carga-de-divisiones
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13975418514506003
        }
    )

    process process-form-carga-de-divisiones (
        name: Process form Carga de Divisiones
        type: formAutoRowProcessing
        formRegion: @carga-de-divisiones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13975806517506003
        }
    )

)

