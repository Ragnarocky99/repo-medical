    dynamicAction calcular-dias (
        name: Calcular dias
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P335_FEC_FINAL
        }

        action dias (
            name: dias
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: TO_DATE(:P335_FEC_FINAL, 'dd/MM/yyyy') - TO_DATE(:P335_FEC_INICIAL, 'dd/MM/yyyy') + 1
                itemsToSubmit: [
                    P335_FEC_FINAL
                    P335_FEC_INICIAL
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P335_DIAS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cancelar-dialogo (
        name: cancelar dialogo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction conceptos (
        name: CONCEPTOS
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P335_ID_MOTIVO
        }

        action desc-concepto (
            name: DESC_CONCEPTO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    m.id_concepto,
                    c.descripcion AS DESC_CONCEPTO
                     from RHW_motivos m, rhw_conceptos c
                     WHERE m.id_empresa = c.id_empresa(+)
                    and m.id_concepto = c.id (+)
                     AND M.ID = :P335_ID_MOTIVO
                    
                    
                    ```
                itemsToSubmit: P335_ID_MOTIVO
            }
            affectedElements {
                selectionType: items
                items: P335_ID_CONCEPTO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            comments {
                comments:
                    ```
                    SETEA DESCRICION DE CONCEPTO
                    
                    ```
            }
        )

        action habilitar-detalle (
            name: Habilitar Detalle
            action: enable
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: #Detalles
            }
            execution {
                sequence: 50
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.view$.grid("option", "editable", true);
                    grid.model.setOption("editable", true);
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-close (
        name: Dialog Close
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P335_ID_MOTIVO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

