page 335 (
    name: Carga de Novedades de Asistencia
    alias: CARGA-DE-NOVEDADES-DE-ASISTENCIA
    title: Carga de Novedades de Asistencia
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-novedades-de-asistencias (
        name: Carga de Novedades de Asistencias
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_EMPLEADO,
                       FEC_INICIAL,
                       FEC_FINAL,
                       ID_MOTIVO,
                       COMENTARIO,
                       HORAS,
                       ID_SUCURSAL,
                       PERIODO,
                       IND_VACACIONES,
                       DIAS,
                       MINUTOS_TRABAJADOS,
                       ID_CONCEPTO,
                       DESDE_HORA,
                       HASTA_HORA,
                       FEC_DEDUCCION,
                       ESTADO,
                       PROCESADO,
                       FEC_INSERT,
                       ID_USUARIO,
                       MONTO_DESCUENTO,
                       SER_LIQUID_AFECTO,
                       NRO_LIQUID_AFECTO,
                       COD_USUARIO_AUD,
                       id_empleado as id_empleado2,
                       TIP_LIQUID,
                       DESCUENTA,
                       ID_TIPO_NOVEDAD
                  from RHW_NOVEDADES
                --where id_empresa = :p0_id_empresa
                --and id = :ID
                --AND ID_EMPLEADO = :ID_EMPLEADO
                
                ```
            pageItemsToSubmit: P335_ID
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

