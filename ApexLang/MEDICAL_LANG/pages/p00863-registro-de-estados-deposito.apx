page 863 (
    name: Registro de Estados - Deposito
    alias: REGISTRO-DE-ESTADOS-DEPOSITO
    title: Registro de Estados - Deposito
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region estantes (
        name: Estantes
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: STW_ESTANTES
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                AND (ID_SUCURSAL = :P863_ID_SUCURSAL OR :P863_ID_SUCURSAL IS NULL)
                AND (UPPER(REPLACE(DESCRIPCION, ' ', '')) = UPPER(REPLACE(:P863_DESCRIPCION, ' ', '')) OR :P863_DESCRIPCION IS NULL)
                AND (UPPER(REPLACE(PISO, ' ', '')) = UPPER(REPLACE(:P863_PISO, ' ', '')) OR :P863_PISO IS NULL)
                ```
            orderByClause: COD_ESTANTE
            pageItemsToSubmit: [
                P863_ID_SUCURSAL
                P863_PISO
                P863_DESCRIPCION
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 105260774960152232
        }

