    computation p345-nro-embarque (
        itemName: P345_NRO_EMBARQUE
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P345_NRO_EMBARQUE IS  NULL THEN
                SELECT NVL(MAX(NRO_EMBARQUE),0)+1
                INTO v_nro_comprobante
                FROM
                CMW_EMBARQUES
                WHERE ID_EMPRESA=:P0_COD_EMPRESA;
                --AND :P330_SER_COMPROBANTE=SER_COMPROBANTE
                --AND :P330_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P330_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P345_ID
        }
    )

    computation p345-proforma-visualizacion (
        itemName: P345_PROFORMA_VISUALIZACION
        execution {
            sequence: 90
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_nro_proforma number (8);
                begin
                SELECT NRO_COMPROBANTE 
                INTO V_NRO_PROFORMA
                FROM CMW_PROFORMAS_CABECERA
                WHERE ID=:P345_ID_PROFORMA;
                RETURN V_NRO_PROFORMA;
                EXCEPTION WHEN 
                NO_DATA_FOUND THEN
                RETURN NULL;
                end;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P345_ID
        }
    )

    computation p345-subtotal (
        itemName: P345_SUBTOTAL
        execution {
            sequence: 60
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_cabecera IS SELECT * FROM CMW_COMPRAS_CABECERA
                    WHERE :P345_ID=ID;
                    item_cabecera CMW_COMPRAS_CABECERA%rowtype;
                    v_subtotal   CMW_COMPRAS_CABECERA.TOT_COMPROBANTE%TYPE:=0;
                BEGIN
                  OPEN cursor_CABECERA;
                  LOOP
                    FETCH cursor_cabecera INTO item_cabecera;
                    EXIT WHEN cursor_cabecera%NOTFOUND;
                    v_subtotal:=nvl(item_cabecera.tot_comprobante,0)-nvl(item_cabecera.tot_iva,0);
                  END LOOP;
                  CLOSE cursor_cabecera;
                  RETURN v_subtotal;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P345_ID
        }
    )

