    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       A.COD_ORIGEN_ART,
                       A.ID_ENVASE,
                       D.CANTIDAD,
                      -- D.MONTO_TOTAL,
                     --  D.TOTAL_IVA,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                     --  D.MONTO_TOTAL_C_IVA,
                    --   D.IND_STOCK,
                       D.ID_EMBARQUE,
                     --  D.PRECIO_UNITARIO,
                   --    D.PORC_DESCUENTO
                 --      D.DESCUENTO
                     --  D.DESCUENTO_C_IVA
                  --     D.PORC_GRAVADA,
                  --     D.IVA
                    --   D.EXENTO,
                    --   D.GRAVADA,
                      -- D.TOTAL_EXENTO,
                      -- D.TOTAL_GRAVADA
                       A.DESCRIPCION AS DESC_ARTICULO,
                       D.ID_EMPRESA
                  from CMW_EMBARQUES_DET D,STW_ARTICULOS A
                 where ID_EMBARQUE=:P345_ID
                 AND A.ID=D.ID_ARTICULO
                ```
            pageItemsToSubmit: P345_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-Form--noPadding
                t-Form--labelsAbove
            ]
        }
