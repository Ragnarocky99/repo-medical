    dynamicAction cargar-detalle (
        name: "Cargar Detalle "
        execution {
            sequence: 260
        }
        when {
            selectionType: items
            items: P345_ID_PROFORMA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                        SELECT E.ID,
                               --E.ID_PEDIDO_CAB,
                               E.ID_ARTICULO,
                               E.ID_UNIDAD_MEDIDA,
                               --E.ID_IVA,
                               E.CANTIDAD,
                               E.CANTIDAD_CONFIRMADA,
                               E.PRECIO_UNITARIO,
                               --E.IVA,
                               E.MONTO_TOTAL_C_IVA,
                               E.PRECIO_UNITARIO_C_IVA,
                               A.COD_ARTICULO,
                               NVL(E.CANTIDAD_UB,0),
                               A.ID_ENVASE,
                               A.DESCRIPCION AS DESC_ARTICULO
                        FROM   CMW_PROFORMAS_DETALLE E,STW_ARTICULOS A
                       WHERE  ID_PROFORMA_CABECERA=:P345_ID_PROFORMA
                       AND E.ID_ARTICULO=A.ID;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P345_JSON_DETALLE:=JSON_DETALLE;
                    
                    END;
                    ```
                itemsToSubmit: P345_ID_PROFORMA
                itemsToReturn: P345_JSON_DETALLE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                      var T = $v("P345_JSON_DETALLE"), J, intento = 0, maxIntentos = 20;
                      if(!T){console.warn("P345_JSON_DETALLE vacío. No se carga nada.");return;}
                      try{ J = JSON.parse(T); }
                      catch(e){ console.error("JSON inválido:",e); apex.message.alert("El JSON de detalle no es válido."); return; }
                    
                      function txt(v){ return v===null||v===undefined?"":v.toString(); }
                      function tieneDatos(o){ return o && Object.keys(o).some(k => o[k]!==null && o[k]!==undefined && o[k]!=="" ); }
                      function setCol(model,rec,col,val){
                        if(val===null||val===undefined||val===""){return;}
                        try{ model.setValue(rec,col,val.toString()); }
                        catch(e){ console.error("Error en columna:",col,"Valor:",val,e);
                          apex.message.alert("Error al cargar la columna "+col+". Verificá si está Read Only, Display Only o Query Only en el IG.");
                          throw e;
                        }
                      }
                    
                      function esperarIG(){
                        var ig$ = apex.region("Detalles").widget();
                        var grid = ig$.interactiveGrid("getCurrentView");
                        grid.setEditMode(true);
                        var model = grid.model;
                        console.log("Intento:",intento,"allowAdd:",model.allowAdd(),"canAdd:",model.check("canAdd"));
                        if(model.allowAdd() && model.check("canAdd")){ cargarDetalle(model); return; }
                        intento++;
                        if(intento<maxIntentos){ setTimeout(esperarIG,300); return; }
                        apex.message.alert("El grid Detalles no permite agregar filas todavía. Revisá si el código se ejecuta antes del refresh del IG o si alguna configuración bloquea Add Row.");
                      }
                    
                      function cargarDetalle(model){
                        try{
                          if(!J || !Array.isArray(J.DETALLE) || J.DETALLE.length===0){ console.log("No hay detalle para cargar."); return; }
                          var filas = J.DETALLE.filter(tieneDatos);
                          if(filas.length===0){ console.log("El JSON no tiene filas con datos."); return; }
                    
                          for(let i=0;i<filas.length;i++){
                            var d = filas[i];
                            if(!model.allowAdd() || !model.check("canAdd")){ throw new Error("El modelo dejó de permitir insertar en la línea "+(i+1)); }
                            var rec = model.getRecord(model.insertNewRecord());
                    
                            setCol(model,rec,"ID_ARTICULO",txt(d.ID_ARTICULO));
                            setCol(model,rec,"CANTIDAD",txt(d.CANTIDAD));
                            setCol(model,rec,"ID_UNIDAD_MEDIDA",txt(d.ID_UNIDAD_MEDIDA));
                            setCol(model,rec,"DESC_ARTICULO",txt(d.DESC_ARTICULO));
                            setCol(model,rec,"COD_ARTICULO",txt(d.COD_ARTICULO));
                            setCol(model,rec,"ID_ENVASE",txt(d.ID_ENVASE));
                            // puedes ir agregando más columnas según tu necesidad
                          }
                          console.log("Carga de detalle finalizada. Filas cargadas:",filas.length);
                        }catch(e){ console.error("Error cargando detalle:",e); }
                      }
                    
                      setTimeout(esperarIG,300);
                    })();
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalles
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 270
        }
        when {
            selectionType: items
            items: P345_FEC_EMBARQUE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P345_FEC_EMBARQUE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P345_FEC_EMBARQUE,'/','');
                            conv_fecha := substr(:P345_FEC_EMBARQUE,1,2)||'/'||
                                                      substr(:P345_FEC_EMBARQUE,3,2)||'/'||
                                                      lpad(substr(:P345_FEC_EMBARQUE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P345_FEC_EMBARQUE := conv_fecha;
                            ELSIF (length(:P345_FEC_EMBARQUE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P345_FEC_EMBARQUE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P345_FEC_EMBARQUE
                itemsToReturn: P345_FEC_EMBARQUE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

