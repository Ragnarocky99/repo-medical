    dynamicAction traer-ultimo-timbrado (
        name: Traer Ultimo Timbrado
        execution {
            sequence: 140
        }
        when {
            event: focusout
            selectionType: items
            items: P345_NRO_TIMBRADO
        }
        clientSideCondition {
            type: itemIsNull
            item: P345_NRO_TIMBRADO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_nro_timbrado CMW_COMPRAS_CABECERA.NRO_TIMBRADO%TYPE;
                    v_ven_timbrado CMW_COMPRAS_CABECERA.FEC_VENC_TIMBRADO%TYPE;
                    begin
                    IF :P345_ID_PROVEEDOR IS NOT NULL THEN 
                    SELECT TIMBRADO,FEC_VENC_TIMBRADO  
                    INTO V_NRO_TIMBRADO,V_VEN_TIMBRADO
                    FROM CMWV_PROVEEDORES_COMPRAS
                    WHERE ID_PROVEEDOR=:P345_ID_PROVEEDOR AND 
                    ID_EMPRESA=:P0_COD_EMPRESA;
                    :P345_NRO_TIMBRADO:=v_nro_timbrado;
                    :P345_FEC_VENC_TIMBRADO:=v_ven_timbrado;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN 
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    end;
                    ```
                itemsToReturn: [
                    P345_NRO_TIMBRADO
                    P345_FEC_VENC_TIMBRADO
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction validar-fecha-timbrado (
        name: Validar Fecha Timbrado
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: P345_FEC_VENC_TIMBRADO
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                ($v("P345_FEC_COMPROBANTE")>$v("P345_FEC_VENC_TIMBRADO"))
                
                ```
        }

        action native-alert (
            action: alert
            settings {
                title: Atencion
                message: "La fecha de vencimiento no puede ser menor a la fecha del comprobante "
                style: warning
                okLabel: Aceptar
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: SYSDATE
                escapeSpecialChars: false
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P345_FEC_VENC_TIMBRADO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    computation p345-iva (
        itemName: P345_IVA_5
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                    WHERE :P345_ID=ID_COMPRAS_CAB;
                    item_detalle CMW_COMPRAS_DETALLE%rowtype;
                    v_total_iva_5    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P345_ID
        }
    )

