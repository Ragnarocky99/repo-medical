                declare
                v_decimales number(10):=0;
                BEGIN
                SELECT DECIMALES
                into v_decimales
                 FROM BSW_MONEDAS
                WHERE ID=:P345_ID_MONEDA;
                return v_decimales;
                exception 
                when no_data_found then
                return 0;
                END;
