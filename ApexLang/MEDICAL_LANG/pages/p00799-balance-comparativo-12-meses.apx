page 799 (
    name: Balance Comparativo 12 Meses
    alias: BALANCE-COMPARATIVO-12-MESES
    title: Balance Comparativo 12 Meses
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region balance-comparativo-12-meses (
        name: Balance Comparativo 12 Meses
        type: interactiveReport
        source {
            location: localDatabase
            tableName: COWV_BALANCE_COMPARATIVO_12_MESES
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                COD_EJERCICIO = :P0_COD_EJERCICIO
                ```
            orderByClause: COD_CUENTA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 58869140545375156
        }

        column COD_CUENTA (
            type: plainText
            heading {
                heading: Cod. Cuenta
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column COD_EJERCICIO (
            type: hidden
            heading {
                heading: Cod Ejercicio
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_PLAN_CUENTA (
            type: hidden
            heading {
                heading: Id Plan Cuenta
            }
            layout {
                sequence: 8
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column MES (
            type: plainText
            heading {
                heading: Mes
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column MES_LETRA (
            type: plainText
            heading {
                heading: Mes Letra
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column NOMBRE_CUENTA (
            type: plainText
            heading {
                heading: Nombre Cuenta
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column SALDO (
            type: plainText
            heading {
                heading: Saldo
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column TITULO (
            type: hidden
            heading {
                heading: Titulo
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column TITULO_REPORTES (
            type: hidden
            heading {
                heading: Titulo Reportes
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Balance Comparativo 12 Meses
        }

        savedReport 588767 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 50
            }

            displayColumn COD_CUENTA (
                sequence: 5
            )

            displayColumn COD_EJERCICIO (
                sequence: 2
            )

            displayColumn ID_EMPRESA (
                sequence: 1
            )

            displayColumn ID_PLAN_CUENTA (
                sequence: 8
            )

            displayColumn MES (
                sequence: 3
            )

            displayColumn MES_LETRA (
                sequence: 4
            )

            displayColumn NOMBRE_CUENTA (
                sequence: 6
            )

            displayColumn SALDO (
                sequence: 7
            )

            displayColumn TITULO (
                sequence: 10
            )

            displayColumn TITULO_REPORTES (
                sequence: 9
            )

            pivotColumn (
                column: MES
                layout {
                    sequence: 1
                }
            )

            pivotColumn (
                column: MES_LETRA
                layout {
                    sequence: 2
                }
            )

            pivotRowColumn (
                column: COD_CUENTA
                layout {
                    sequence: 1
                }
            )

            pivotRowColumn (
                column: NOMBRE_CUENTA
                layout {
                    sequence: 2
                }
            )

            pivotAggregate ir-pivot-agg (
                aggregate {
                    function: sum
                    column: SALDO
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            pivotSort (
                column: COD_CUENTA
                sort {
                    sequence: 1
                }
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P799_IND_IMPRIMIR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @balance-comparativo-12-meses
            slot: regionBody
        }
    )

    button print (
        buttonName: PRINT
        label: Imprimir
        layout {
            sequence: 10
            region: @balance-comparativo-12-meses
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction imprimir (
        name: Imprimir
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 799
                    items: {
                        P799_IND_IMPRIMIR: S
                    }
                }
                options: submitPageItemsBeforeRedirect
                openTargetInNewWindow: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          v_nom_empresa varchar2(150);
                        BEGIN
                          :P799_IND_IMPRIMIR := NULL;
                          SELECT E.DESCRIPCION INTO v_nom_empresa FROM BSW_EMPRESAS E WHERE E.ID = :P0_ID_EMPRESA;
                          xlog (l_proc, 'url (orig):' || l_report_url);
                          
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('BalanceComparativo12Meses'),
                                  p_rep_format          => apex_util.url_encode('pdf'),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                  p_additional_params   => ('P_ID_EMPRESA='||:P0_ID_EMPRESA||'&'||
                                                            'P_COD_USUARIO='||:APP_USER||'&'||
                                                            'P_COD_EJERCICIO='||:P0_COD_EJERCICIO),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          apex_application.stop_apex_engine();
                
                        exception
                          when apex_application.e_stop_apex_engine then
                            null; -- ok, stop engine raises exception, we can ignore that
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
        serverSideCondition {
            type: item=value
            item: P799_IND_IMPRIMIR
            value: S
        }
    )

)

