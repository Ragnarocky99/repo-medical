    region lista-de-nota-de-envios (
        name: Lista de Nota de Envios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ID,
                       A.ID_EMPRESA,
                       A.TIP_ENVIO,
                       A.NRO_ENVIO,
                       A.ID_SUCURSAL,
                       A.ID_SUCURSAL_ENT,
                       A.FECHA,
                       A.SER_ENVIO,
                       A.DESC_SUCUR_ENT,
                       A.COD_USUARIO_AUD,
                       A.ID_CLIENTE,
                       A.REFERENCIA,
                       --A.IND_ANULADO,
                       
                       CASE A.IND_ANULADO
                         WHEN 'S' THEN
                          'Anulado'
                         ELSE
                          CASE ESTADO_SOLICITUD_ENVIO(A.ID_EMPRESA, A.ID)
                            WHEN 'P' THEN
                             'Pendiente'
                            WHEN 'T' THEN
                             'En Transito'
                            WHEN 'F' THEN
                             'Finiquitado'
                            WHEN 'L' THEN
                             'Parcial'
                            WHEN 'S' THEN
                             'Sin Definir'
                            ELSE
                             ''
                          END
                       END AS Estado,
                
                       'ENVIAR',
                       CASE
                         WHEN (NVL((SELECT SUM(CANTIDAD)
                                     FROM STW_ENTSAL_DET D1, STW_ENTSAL_CAB C1
                                    WHERE ID_SOLICITUD_REF = A.ID
                                      AND C1.ID = D1.ID_ENTSAL_CAB),
                                   0)) < (NVL((SELECT SUM(CANTIDAD)
                                               FROM STW_NOTAS_ENVIO_DET_SOL DS
                                               WHERE A.ID = DS.ID_NRO_ENVIO_CAB),
                                           0)) THEN
                          '<span class="fa fa-send" aria-hidden="true"></span>'
                         ELSE
                          '<p></p>'
                       END AS TEXTO_LINK,
                       
                       CASE
                         WHEN TIENE_REMISION(A.ID) = 1 THEN
                          '<span class="fa fa-search" aria-hidden="true"></span>'
                         ELSE
                          '<p> </p>'
                       END AS VER,
                       
                       --  C.ID AS ID_REMISION,
                       NVL((SELECT SUM(CANTIDAD)
                             FROM STW_ENTSAL_DET D1, STW_ENTSAL_CAB C1
                            WHERE ID_SOLICITUD_REF = A.ID
                              AND C1.ID = D1.ID_ENTSAL_CAB),
                           0) AS ENVIADO,
                           
                       NVL((SELECT SUM(D1.CANTIDAD)
                             FROM STW_ENTSAL_CAB C1, STW_ENTSAL_CAB C2, STW_ENTSAL_DET D1
                            WHERE C1.ID_SOLICITUD_REF = A.ID
                              AND C1.ID = C2.ID_COMPROBANTE_REF
                              AND C2.ID_SUCURSAL = A.ID_SUCURSAL_ENT
                              AND C2.ID = D1.ID_ENTSAL_CAB),
                           0) AS RECEPCIONADO,
                           
                       (NVL((SELECT SUM(CANTIDAD)
                              FROM STW_NOTAS_ENVIO_DET_SOL DS
                             WHERE A.ID = DS.ID_NRO_ENVIO_CAB),
                            0)) as SOLICITADO,
                       
                       NVL((SELECT SUM(D1.CANTIDAD)
                             FROM STW_ENTSAL_CAB C1, STW_ENTSAL_CAB C2, STW_ENTSAL_DET D1
                            WHERE C1.ID_SOLICITUD_REF = A.ID
                              AND C1.ID = C2.ID_COMPROBANTE_REF
                              AND C2.ID_SUCURSAL <> A.ID_SUCURSAL_ENT
                              AND C2.ID = D1.ID_ENTSAL_CAB),
                           0) AS PERDIDO
                
                  from STW_NOTAS_ENVIO_CAB_SOL A
                --LEFT JOIN STW_ENTSAL_CAB C ON A.ID=C.ID_SOLICITUD_REF
                 WHERE A.ID_EMPRESA = :P0_COD_EMPRESA
                   and (A.ID_SUCURSAL = :P0_COD_SUCURSAL OR
                       A.ID_SUCURSAL_ENT = :P0_COD_SUCURSAL)
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
