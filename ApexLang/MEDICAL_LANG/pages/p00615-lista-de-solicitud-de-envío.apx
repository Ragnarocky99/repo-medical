    dynamicAction estados (
        name: Estados
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @lista-de-nota-de-envios
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('td[headers="OPERACION"]').each(function() {
                      var texto = $(this).text();
                      if (texto === 'Finiquitado') {
                        $(this).css("color", "green");
                      } else if (texto === 'En Transito') {
                        $(this).css("color", '#e1ad01');
                      } else if (texto === 'Pendiente') {
                        $(this).css("color", "#FFFF66");
                      } else if (texto === 'Anulado') {
                        $(this).css("color", "red");
                      }else if (texto === 'Parcial') {
                        $(this).css("color", "#e1ad01");
                      }
                      
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @lista-de-nota-de-envios
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    V_ID_REMISION NUMBER(10):=APEX_UTIL.GET_SESSION_STATE('P_ID_REMISION');
                    BEGIN
                    IF    V_ID_REMISION IS NOT NULL THEN
                        :P615_BANDERA_REDIRIGIR:='S'; 
                    ELSIF V_ID_REMISION IS NULL THEN
                        :P615_BANDERA_REDIRIGIR:='N';
                    END IF;
                    END;
                    ```
                itemsToReturn: P615_BANDERA_REDIRIGIR
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-nota-de-envios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grilla (
        name: Refresh Grilla
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-nota-de-envios
            }
            execution {
                sequence: 10
            }
        )

    )

)

