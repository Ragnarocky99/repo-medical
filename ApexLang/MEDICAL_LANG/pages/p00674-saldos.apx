                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P674_FEC_HASTA) = 8) then
                    
                            conv_fecha := replace(:P674_FEC_HASTA,'/','');
                            conv_fecha := substr(:P674_FEC_HASTA,1,2)||'/'||
                                                      substr(:P674_FEC_HASTA,3,2)||'/'||
                                                      lpad(substr(:P674_FEC_HASTA,5,4),4,'0');
                    
                        :P674_FEC_HASTA := conv_fecha;
                        ELSIF (length(:P674_FEC_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P674_FEC_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P674_FEC_HASTA
                itemsToReturn: P674_FEC_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

