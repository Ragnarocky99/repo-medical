    region saldos (
        name: Saldos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                ------saldo clientes a una fecha--------
                select c.id_empresa,
                       c.cod_cliente,
                       c.nombre,
                       c.id_sucursal,
                      --- sum (NVL(C.DEBITO,0) - NVL(C.CREDITO,0)) SALDO
                       SUM(decode(c.tip_comprobante,'ADD',NVL(C.CREDITO,0),NVL(C.DEBITO,0) - NVL(C.CREDITO,0))) SALDO
                       
                  from CCHV_SALDOS_HIST_CLIENTES c
                  where C.id_EMPRESA = :P0_ID_EMPRESA 
                    and (TO_DATE(C.FEC_COMPROBANTE,'DD/MM/YYYY') <= :P674_FEC_HASTA)
                    AND (C.COD_CLIENTE = :P674_CLIENTE OR :P674_CLIENTE IS NULL)
                
                group by C.ID_EMPRESA,
                         c.cod_cliente,
                         c.nombre,
                         c.id_sucursal
                       
                ---ORDER BY C.FEC_COMPROBANTE, C.nro_comprobante
                ```
            pageItemsToSubmit: [
                P674_FEC_HASTA
                P674_CLIENTE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12166680617307433
        }

