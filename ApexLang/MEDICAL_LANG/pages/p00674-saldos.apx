    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P674_FEC_DESDE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P674_FEC_DESDE) = 8) then
                    
                            conv_fecha := replace(:P674_FEC_DESDE,'/','');
                            conv_fecha := substr(:P674_FEC_DESDE,1,2)||'/'||
                                                      substr(:P674_FEC_DESDE,3,2)||'/'||
                                                      lpad(substr(:P674_FEC_DESDE,5,4),4,'0');
                    
                        :P674_FEC_DESDE := conv_fecha;
                        ELSIF (length(:P674_FEC_DESDE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P674_FEC_DESDE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P674_5_FEC_INI
                itemsToReturn: P674_5_FEC_INI
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

