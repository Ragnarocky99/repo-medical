        layout {
            sequence: 10
            region: @datos
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction agregar-botones (
        name: Agregar Botones
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-com-fos-interactive-grid-add-button (
            action: plugin/fosInteractiveGridAddButton
            settings {
                alignment: first
                label: Limpiar
                icon: fa-refresh
                onClick: triggerEvent
                eventName: limpiar
            }
            affectedElements {
                selectionType: region
                region: @articulos-excel
            }
            execution {
                sequence: 10
            }
        )

        action plugin-com-fos-interactive-grid-add-button-2 (
            action: plugin/fosInteractiveGridAddButton
            settings {
                alignment: first
                label: Insertar Articulos
                icon: fa-download
                onClick: triggerEvent
                eventName: inserta_art
                extraOptions: [
                    hideOnNoData
                    toolbarOnlyHot
                ]
            }
            affectedElements {
                selectionType: region
                region: @articulos-excel
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction inserta-articulos (
        name: Inserta Articulos
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: inserta_art
            selectionType: region
            region: @articulos-excel
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INSERTA_ARTICULO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpiar (
        name: Limpiar
        execution {
            sequence: 20
        }
        when {
            event: custom
            customEvent: limpiar
            selectionType: region
            region: @articulos-excel
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: LIMPIAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-subir-excel (
        name: Submit SUBIR_EXCEL
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @subir-excel
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SUBIR_EXCEL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

