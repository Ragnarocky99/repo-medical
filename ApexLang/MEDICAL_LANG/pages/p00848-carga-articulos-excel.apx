    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region datos (
        name: Datos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM STWV_ARTICULOS_EXCEL
                ```
        }
    )

    region errores (
        name: Errores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C001 MENSAJE
                  FROM APEX_COLLECTIONS
                 WHERE COLLECTION_NAME = stwk_excel_utils.obtener_nomb_coleccion_err
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 95898700683868050
        }

        column MENSAJE (
            type: plainText
            heading {
                heading: Mensaje
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Errores
        }

        savedReport 959792 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn MENSAJE (
                sequence: 1
            )

        )

    )

    region selector (
        name: Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            includeShowAll: false
        }
    )

    pageItem P848_EXCEL (
        type: fileUpload
        label {
            label: <p>Excel</p>
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            inlineHelpText:
                ```html
                <strong>A continuación se presentará el formato aceptado para subir el Excel. No se validará otra plantilla. <br>
                Presione <a href="#APP_FILES#formato_subida_articulos_excel.xlsx" title="Descargar" download> Aquí </a> para descargar</strong>
                ```
        }
    )

    pageItem P848_MENSAJE_PROC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @articulos-excel
            slot: regionBody
        }
    )

    button subir-excel (
        buttonName: SUBIR_EXCEL
