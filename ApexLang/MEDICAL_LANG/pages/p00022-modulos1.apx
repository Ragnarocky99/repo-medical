page 22 (
    name: Modulos
    alias: MODULOS1
    title: Modulos - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region modulos (
        name: Modulos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_MODULO,
                       DESCRIPCION,
                          CASE MANEJA_CALENDARIO
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       IND_CALENDARIO,
                       COD_USUARIO_AUD,
                        CASE ACTIVO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_1 
                  from BSW_MODULOS
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 23
                items: {
                    P23_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5557607810792193
        }

        column ACTIVO_1 (
            type: plainText
            heading {
                heading: "Activo "
                alignment: center
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #ACTIVO_1#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column COD_MODULO (
            type: plainText
            heading {
                heading: Cód. Módulo
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column IND_CALENDARIO (
            type: plainText
            heading {
                heading: Maneja Calendario
                alignment: center
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #IND_CALENDARIO#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                MÓDULOS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText:
                ```
                USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
                
                ```
        }

        savedReport 55898 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVO_1 (
                sequence: 4
            )

            displayColumn COD_MODULO (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn IND_CALENDARIO (
                sequence: 3
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @modulos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 23
                clearCache: 23
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @modulos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @modulos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17177490691863410
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

