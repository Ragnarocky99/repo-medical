page 707 (
    name: Imprimir Saldo Historicos de Proveedores
    alias: IMPRIMIR-SALDO-HISTORICOS-DE-PROVEEDORES
    title: Imprimir Saldo Historicos de Proveedores
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                  l_proc varchar2(100) := 'show report';
                  l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                BEGIN
                  xlog (l_proc, 'url (orig):' || l_report_url);
                  xlib_jasperreports.set_report_url(l_report_url);
                  xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('SaldoHistoricosProveedor'),
                          p_rep_format          => apex_util.url_encode('pdf'),
                          p_data_source         => apex_util.url_encode('default'),
                          p_out_filename        => apex_util.url_encode(:P3_out_filename),
                          p_rep_locale          => apex_util.url_encode('es_ES'),
                          p_rep_encoding        => apex_util.url_encode('UTF-8'),
                          p_additional_params   => ('P_COD_PROVEEDOR='||:P675_PROVEEDOR||'&'||'P_COD_EMPRESA='||:P0_COD_EMPRESA||'&'||'P_FEC_HASTA='||:P675_FEC_HASTA||'&'||'IND_DETALLE='||:P675_IND_DETALLE)
                          );
                  apex_application.stop_apex_engine();
                exception
                  when apex_application.e_stop_apex_engine then
                    null;
                  when others then 
                    xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                    raise;
                end;   
                                                     
                ```
        }
    )

)

