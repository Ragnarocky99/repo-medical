page 477 (
    name: Grupos de Bienes
    alias: GRUPOS-DE-BIENES
    title: Grupos de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region grupos-de-bienes (
        name: Grupos de Bienes
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region grupos-de-bienes-2 (
        name: Grupos de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COD_GRUPO_BIEN,
                       DESCRIPCION,
                       ID
                  from COW_GRUPOS_BIENES C
                  where C.ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 478
                items: {
                    P478_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No se ha encontrado ningún dato.
            whenMoreDataFound: El recuento máximo de filas de este informe es #MAX_ROW_COUNT# filas. Aplique un filtro para reducir el número de registros de la consulta.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 113769359604671187
        }

        column COD_GRUPO_BIEN (
            type: plainText
            heading {
                heading: Cod Grupo Bien
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grupos de Bienes
        }

        savedReport 593744 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_GRUPO_BIEN (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ID (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @grupos-de-bienes-2
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 478
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction editar-informe-cuadro-de-diálogo-cerrado (
        name: "Editar Informe: Cuadro de Diálogo Cerrado "
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @grupos-de-bienes-2
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grupos-de-bienes-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 59665859319649546
        }
    )

)

