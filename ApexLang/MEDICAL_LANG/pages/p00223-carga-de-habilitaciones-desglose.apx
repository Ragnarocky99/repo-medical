    dynamicAction calcular-total-cambio-en-cantidad (
        name: Calcular total (cambio en Cantidad)
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-de-habilitaciones-desglose
            columns: CANTIDAD
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: to_number(replace(:VALOR, '.','')) * :CANTIDAD
                itemsToSubmit: [
                    VALOR
                    CANTIDAD
                ]
            }
            affectedElements {
                selectionType: columns
                columns: MONTO
            }
            execution {
                sequence: 10
            }
        )

    )

