    computation p223-id-habilitacion (
        itemName: P223_ID_HABILITACION
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                select HB.id
                from ccw_habilitaciones HB
                where HB.fec_cierre is null
                  AND HB.ID_USUARIO = TRAE_ID_USUARIO(P_EMPRESA =>  :P0_ID_EMPRESA
                                                     ,P_COD_USUARIO => :APP_USER)
                ```
        }
    )

    process carga-de-habilitaciones-desglose-save-interactive-grid-data (
        name: Carga de Habilitaciones Desglose - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @carga-de-habilitaciones-desglose
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 31350904794905330
        }
    )

    process cargar-desglose-a-detalle (
        name: Cargar Desglose a Detalle
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                SUBTIPO_ESTADO NUMBER(10,0);
                
                BEGIN
                
                    SELECT COUNT(ID_SUBTIPO_TRANS)
                    INTO  SUBTIPO_ESTADO
                    FROM  CCW_HABILITACIONES_DETALLE
                    WHERE ID_HABILITACION = :P223_ID_HABILITACION;
                
                    IF SUBTIPO_ESTADO = 0 THEN
                    INSERT INTO CCW_HABILITACIONES_DETALLE (ID_EMPRESA,
                                                            ID_HABILITACION,
                                                            ID_SUBTIPO_TRANS,
                                                            ID_MONEDA,
                                                            MONTO_REAL,
                                                            COD_USUARIO_AUD) 
                                                     VALUES(:P0_COD_EMPRESA,
                                                            :P223_ID_HABILITACION,
                                                            538, ---EFECTIVO
                                                            32,  ---GUARANIES,
                                                            to_number(replace(:P223_TOTAL_DESGLOSE, '.','')),
                                                            :APP_USER);
                
                    ELSE
                    UPDATE CCW_HABILITACIONES_DETALLE
                    SET    MONTO_REAL       = to_number(replace(:P223_TOTAL_DESGLOSE, '.',''))
                    WHERE  ID_EMPRESA       = :P0_COD_EMPRESA
                    AND    ID_HABILITACION  = :P223_ID_HABILITACION
                    AND    COD_USUARIO_AUD  = :APP_USER
                    AND    ID_MONEDA        = 32
                    AND    ID_SUBTIPO_TRANS = 538;
                    END IF;
                
                END;
                
                
                
                    
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 30839883510674942
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

    branch (
        name: Go To Page 210
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 210
            }
        }
    )

)

