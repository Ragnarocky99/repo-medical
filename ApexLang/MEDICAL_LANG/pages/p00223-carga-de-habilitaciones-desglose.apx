    dynamicAction identificar-tipo (
        name: Identificar Tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-de-habilitaciones-desglose
            columns: TIPO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select valor
                    from ccw_tipos_billete
                    where id = :tipo
                    
                    ```
                itemsToSubmit: TIPO
            }
            affectedElements {
                selectionType: columns
                columns: VALOR
            }
            execution {
                sequence: 10
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P223_ID_HABILITACION
                itemsToSubmit: ID_HABILITACION
            }
            affectedElements {
                selectionType: columns
                columns: ID_HABILITACION
            }
            execution {
                sequence: 20
            }
        )

