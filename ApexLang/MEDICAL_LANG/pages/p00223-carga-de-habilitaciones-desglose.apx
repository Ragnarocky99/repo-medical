    region carga-de-habilitaciones-desglose (
        name: Carga de Habilitaciones Desglose
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_HABILITACION,
                       ID_SUBTIPO_TRANS,
                       TIPO,
                       CANTIDAD,
                       MONTO,
                       COD_USUARIO_AUD,
                       OBSERVACION,
                       VALOR
                  from CCW_HABILITACIONES_DESGLOSE 
                  where id_habilitacion = :P223_ID_HABILITACION
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
