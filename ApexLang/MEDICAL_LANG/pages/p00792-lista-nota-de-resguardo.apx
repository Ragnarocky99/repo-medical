page 792 (
    name: Lista Nota de Resguardo
    alias: LISTA-NOTA-DE-RESGUARDO
    title: Lista Nota de Resguardo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-nota-de-entrega (
        name: Lista Nota de Entrega
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.ID,
                       EC.ID_EMPRESA,
                       EC.ID_SUCURSAL,
                       EC.NUM_ENT_SAL,
                       EC.FEC_ENT_SAL,
                       EC.ID_MOTIVO_ENT_SAL,
                       EC.COD_USUARIO_AUD,
                       EC.TIP_REFERENCIA,
                       EC.SER_REFERENCIA,
                       EC.NUM_REFERENCIA,
                       EC.ESTADO,
                       EC.TOT_COSTO,
                       EC.TOT_CANTIDAD,
                       EC.ID_CLIENTE,
                       EC.FEC_ALTA,
                       EC.SER_ENT_SAL,
                       EC.ASIENTOS,
                       EC.TIP_ENT_SAL,
                       EC.ID_LICITACION_CAB,
                       DR.ID ID_DEVOLUCION
                  FROM STW_ENTSAL_CAB EC
                  JOIN STW_ENTSAL_CAB DR ON EC.ID = DR.ID_ENTSAL_REF
                 WHERE EC.TIP_ENT_SAL = W_BUSCA_PARAMETRO('LC', 'TIP_COMPROBANTE_NOTA_RESGUARDO')
                   AND EC.ID_EMPRESA = :P0_ID_EMPRESA
                ORDER BY EC.FEC_ENT_SAL DESC, EC.NUM_ENT_SAL DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 793
                items: {
                    P793_ID: #ID#
                    P793_ID_1: #ID_DEVOLUCION#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 94907538350567530
        }

        column ASIENTOS (
            type: plainText
            heading {
                heading: Asientos
                alignment: center
            }
            layout {
                sequence: 47
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
