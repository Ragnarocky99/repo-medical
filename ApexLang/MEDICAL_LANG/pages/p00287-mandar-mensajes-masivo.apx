page 287 (
    name: Nueva Campaña
    alias: MANDAR-MENSAJES-MASIVO
    title: Nueva Campaña
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 750
        height: 450
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            .solo-mostrar{
                background-color:#eeeeee;
                width: 121px;
                height: 23px;
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .cambio{
                    vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            .timbrado{
                background-color:#eeeeee;
                width: 100px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            .a-GV-rowLabel{display:none;}
            
            .Numeros{
                font-weight: bold;
            }
            .Numeros1{
                font-weight: bold;
                background-color: #f4f9f2;
            }
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            /* Start by setting display:none to make this hidden.
               Then we position it in relation to the viewport window
               with position:fixed. Width, height, top and left speak
               for themselves. Background we set to 80% white with
               our animation centered, and no-repeating */
            .modal {
                display:    none;
                position:   fixed;
                z-index:    1000;
                top:        0;
                left:       0;
                height:     100%;
                width:      100%;
                background: rgba( 255, 255, 255, .8 ) 
                            url('#APP_FILES#Spinner-1s-200px (1).gif') 
                            50% 50% 
                            no-repeat;
            }
            
            /* When the body has the loading class, we turn
               the scrollbar off with overflow:hidden */
            body.loading .modal {
                overflow: hidden;   
            }
            
            /* Anytime the body has the loading class, our
               modal element will be visible */
            body.loading .modal {
                display: block;
            }
            
            
            
            
            
            
            
            
            
            
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region formulario (
        name: Formulario
        type: staticContent
        source {
            htmlCode: <div class="modal"><!-- Place at bottom of page --></div>
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P287_API_SECRET (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
        default {
            type: expression
            plsqlExpression: :P0_API_SECRET
        }
    )

    pageItem P287_CAMPANHA (
        type: textField
        label {
            label: <p>Campaña</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            helpText: Nombre de la campaña de WhatsApp
        }
    )

    pageItem P287_DOCUMENTO (
        type: fileUpload
        label {
            label: Documento
            alignment: left
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 100
            region: @formulario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            helpText: Admite Archivos pdf,xls,xlsx,doc,docx
        }
    )

    pageItem P287_GRUPOS (
        type: popupLov
        label {
            label: <p>Grupos de Contacto</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-grupos-contactos
        }
        multipleValues {
            type: delimitedList
            separator: ,
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: t-Form-fieldContainer--stretchInputs
            width: 30
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P287_ID_CUENTA (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT W_BUSCA_PARAMETRO('WH','ID_CUENTA_WHA') FROM DUAL;
        }
    )

    pageItem P287_IMAGEN (
        type: fileUpload
        label {
            label: Imagen
            alignment: left
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 90
            region: @formulario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            helpText: Sole admite formatos JPG,PNG,GIF
        }
    )

    pageItem P287_MENSAJE (
        type: textarea
        label {
            label: <p>Mensaje</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        sessionState {
            storage: request
        }
    )

    pageItem P287_RECIPIENTE (
        type: textarea
        label {
            label: <p>Números o Grupos</p>
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
            valuePlaceholder: eg.595971001310            1551438074@g.us
        }
        sessionState {
            storage: request
        }
        help {
            helpText: "Múltiples números y direcciones de grupo separado por salto de linea "
        }
    )

    pageItem P287_RESPUESTA (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P287_TIPO (
        type: selectList
        label {
            label: <p>Tipo</p>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Texto;text,Imagen;media,Documento;document
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: static
            staticValue: text
        }
        help {
            helpText: Tipo de mensaje de WhatsApp
        }
    )

    pageItem P287_TIPO_CLIENTES (
        type: popupLov
        label {
            label: <p> Tipo Cliente </p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @ccw-tipo-cliente-cod-tip-cliente
        }
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
            alignment: left
            column: 7
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    button cargar (
        buttonName: Cargar
        label: Cargar
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--hoverIconPush
                t-Button--pillStart
                t-Button--padTop
            ]
            icon: fa-upload
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button enviar (
        buttonName: Enviar
        label: Enviar
        layout {
            sequence: 80
            region: @formulario
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-send
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cargar (
        name: Cargar
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @cargar
        }

        action cargar-numeros-de-clientes (
            name: Cargar Numeros de Clientes
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_numeros varchar2(4000);
                    begin
                    SELECT REPLACE(WH_NUMEROS_CLIENTES(:P287_TIPO_CLIENTES,:P0_ID_EMPRESA),',',CHR(10)) 
                    INTO v_numeros
                    FROM DUAL;
                    :P287_RECIPIENTE:=V_NUMEROS;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    :P287_RECIPIENTE:=NULL;
                    RAISE_APPLICATION_ERROR(-20000,'No se encontraron numeros de clientes');
                    WHEN OTHERS THEN 
                    :P287_RECIPIENTE:=NULL;
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar los numeros ');
                    end;
                    ```
                itemsToSubmit: P287_TIPO_CLIENTES
                itemsToReturn: P287_RECIPIENTE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mandar-mensaje (
        name: Mandar Mensaje
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @enviar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                      declare
                        l_clob      CLOB;     
                        v_api_key   varchar2(200);
                        v_cuenta_id number(10);
                        v_recipiente varchar2(50);    
                        v_tipo varchar2(20);
                        v_mensaje varchar2(2000);
                        url  varchar2(400);
                        v_imagen blob;
                    BEGIN
                    
                    
                    v_api_key:='8e9a5fd1716b87565907233fa53607b8c1a86f5e';
                    v_cuenta_id:=28;
                    v_recipiente:=:P287_RECIPIENTE;
                    v_tipo:=:P287_TIPO;
                    v_mensaje:=:P287_MENSAJE;
                    SELECT LOGO_COMPROBANTE 
                    INTO V_IMAGEN
                    FROM BSW_EMPRESAS
                    WHERE ID=141;
                    
                     
                    
                           -- apex_json.initialize_clob_output();  
                     --apex_json.open_object();  
                     --apex_json.write('secret','8e9a5fd1716b87565907233fa53607b8c1a86f5e'); 
                     --apex_json.write('account',28);
                     --apex_json.write('recipient','595983429149');
                     --apex_json.write('type','text');
                     --apex_json.write('message','Hacer JSONS es divertido :)');
                     --apex_json.close_all();
                      --l_json:=apex_json.get_clob_output();
                      --apex_json.free_output();
                     -- dbms_output.put_line(l_json);
                    
                     
                               apex_web_service.g_request_headers(1).name := 'Content-Type';
                            apex_web_service.g_request_headers(1).value := 'image/png';
                    
                            apex_web_service.g_request_headers(1).name := 'media_file';
                            apex_web_service.g_request_headers(1).value := 'filename.png';
                       
                       if :P287_TIPO='text' THEN 
                    
                       url:='https://flow.cnid.com.py/api/send/whatsapp?secret='||utl_url.escape(v_api_key)||'&account='||utl_url.escape(v_cuenta_id)||'&recipient='||utl_url.escape(v_recipiente)||'&type='||utl_url.escape(v_tipo)||'&message='||utl_url.escape(v_mensaje);
                       elsif :P287_TIPO='media' then
                          url:='https://flow.cnid.com.py/api/send/whatsapp?secret='||utl_url.escape(v_api_key)||'&account='||utl_url.escape(v_cuenta_id)||'&recipient='||utl_url.escape(v_recipiente)||'&type='||utl_url.escape(v_tipo)||'&message='||utl_url.escape(v_mensaje);
                       end if;
                      
                     l_clob :=
                        APEX_WEB_SERVICE.make_rest_request(
                            p_url           => url,
                            p_http_method   => 'POST',
                            p_body_blob => v_imagen);
                            
                            
                        
                        :P287_RESPUESTA:=l_clob;
                    
                    
                       
                            
                    
                     EXCEPTION 
                     WHEN OTHERS THEN
                     RAISE_APPLICATION_ERROR(-20000,'Error al procesar la solicitud! ');
                    END;
                    ```
                itemsToSubmit: [
                    P287_RECIPIENTE
                    P287_MENSAJE
                    P287_TIPO
                ]
                itemsToReturn: P287_RESPUESTA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                           lc_response      clob;
                           lm_multipart     apex_web_service.t_multipart_parts;
                           ln_secret VARCHAR2(400) := '8e9a5fd1716b87565907233fa53607b8c1a86f5e';
                           ln_account number(10):=28;
                           ln_recipient varchar2(50):=:P287_RECIPIENTE;
                           ln_type varchar2(50):=:P287_TIPO;
                           ln_message varchar(3000):=:P287_MENSAJE;
                         --  lc_json          clob          := '{"hello":"world"}';   
                           lv_filename      VARCHAR2(20)  := 'imagen';
                           lv_base_url      VARCHAR2(100):='https://flow.cnid.com.py/api/send/whatsapp'; -- webservice base URL; 
                           lv_api_key       VARCHAR2(100); -- API KEY 
                           lb_blob          blob; -- Blob part of the multipart
                    
                    BEGIN
                    SELECT LOGO_COMPROBANTE
                    INTO lb_blob
                    from bsw_empresas
                    where id=121;
                    
                    
                          --  apex_web_service.g_request_headers.delete();
                            --apex_web_service.g_request_headers(1).name  := 'secret';
                            --apex_web_service.g_request_headers(1).value := '8e9a5fd1716b87565907233fa53607b8c1a86f5e';   
                    
                            /* add a CLOB (JSON) to a multipart/form request body */
                            /*IF lc_json is not null 
                            THEN
                            apex_web_service.APPEND_TO_MULTIPART (
                                    p_multipart    => lm_multipart,
                                    p_name         => 'json_param',
                                    p_content_type => 'application/json',
                                    p_body         => lc_json );
                            END IF;*/
                    
                            /* add a plain text to a multipart/form request body */
                            IF ln_secret is not null
                            THEN        
                            apex_web_service.APPEND_TO_MULTIPART (
                                    p_multipart    => lm_multipart,
                                    p_name         => 'secret',
                                    p_content_type => 'text/plain',
                                    p_body         => ln_secret ); 
                            END IF;        
                    
                               IF ln_recipient is not null
                            THEN        
                            apex_web_service.APPEND_TO_MULTIPART (
                                    p_multipart    => lm_multipart,
                                    p_name         => 'recipient',
                                    p_content_type => 'text/plain',
                                    p_body         => ln_recipient ); 
                            END IF;   
                    
                                 IF ln_type is not null
                            THEN        
                            apex_web_service.APPEND_TO_MULTIPART (
                                    p_multipart    => lm_multipart,
                                    p_name         => 'type',
                                    p_content_type => 'text/plain',
                                    p_body         => ln_type ); 
                            END IF;    
                    
                                IF ln_message is not null
                            THEN        
                            apex_web_service.APPEND_TO_MULTIPART (
                                    p_multipart    => lm_multipart,
                                    p_name         => 'message',
                                    p_content_type => 'text/plain',
                                    p_body         => ln_message ); 
                            END IF;          
                              
                    
                             IF :P287_TIPO='media' then  
                            /*add a BLOB to a multipart/form request body.*/        
                            apex_web_service.APPEND_TO_MULTIPART (
                                    p_multipart    => lm_multipart,
                                    p_name         => 'media_file',
                                    p_filename     => lv_filename,
                                    p_content_type => 'application/octet-stream',
                                    p_body_blob    => lb_blob );
                    
                                    end if;
                    
                            lc_response  := apex_web_service.make_rest_request(
                                                   p_url => lv_base_url,
                                                   p_http_method => 'POST',
                                                   p_body_blob => apex_web_service.generate_request_body(lm_multipart)); 
                    
                            -- generate_request_body: This function generates the multipart/form-data request body from the data in the t_multiparts array.
                    
                            dbms_output.put_line(lc_response);                      
                    
                    END;
                    ```
                itemsToSubmit: [
                    P287_RECIPIENTE
                    P287_TIPO
                    P287_MENSAJE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try{
                    
                    
                    //console.log($v('P287_RESPUESTA'));
                    
                    var json_respuesta = JSON.parse($v('P287_RESPUESTA'));
                    
                    
                    $s('P287_RESPUESTA',json_respuesta.status);
                    
                    //console.log($v('P287_RESPUESTA'));
                    
                    
                    }catch(e){
                        apex.message.alert('Error al procesar la repuesta del servidor');
                    }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action solicitud-https (
            name: Solicitud HTTPS
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function reqListener() {
                      $("body").removeClass('loading');
                     
                    
                    
                    $s('P287_RESPUESTA',JSON.parse(this.responseText).status);
                    $.event.trigger('Alerta');
                     // console.log(this.responseText);
                    }
                    
                    var array = ($v('P287_GRUPOS').replace(/:/g,',')).split(',');
                    console.log(array);
                    
                    const formData = new FormData();
                    const api_secret = $v('P287_API_SECRET');
                    var mensaje = $v('P287_RECIPIENTE').replace(/ +/g, "");
                    formData.append("secret",'941293760c0a5433a83292b9f8aade2e36d3916e');
                    formData.append("account", '&P287_ID_CUENTA.'); 
                    formData.append("recipients",mensaje.replace(/\n/g, ",")); 
                    formData.append("type",$v('P287_TIPO')); 
                    formData.append('campaign',$v('P287_CAMPANHA'))
                    formData.append("message",$v('P287_MENSAJE'));
                    formData.append('groups',array);
                    
                    if($v('P287_TIPO')=='media'){
                    formData.append("media_file",P287_IMAGEN.files[0]); 
                    } 
                    if($v('P287_TIPO')=='document'){
                    formData.append("document_file",P287_DOCUMENTO.files[0]); 
                    } 
                    
                    
                    
                     
                       
                    
                    $("body").addClass('loading');
                    const request = new XMLHttpRequest();
                    request.addEventListener("load", reqListener);
                    request.open("POST", "https://whats-flow.com/api/send/whatsapp.bulk");
                    request.send(formData);
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction mensaje-de-respuesta (
        name: Mensaje de Respuesta
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: Alerta
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-alert (
            action: alert
            settings {
                message: Proceso realizado de manera correcta
                style: success
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P287_RESPUESTA
                value: 200
            }
        )

        action native-alert-2 (
            action: alert
            settings {
                message: Clave de API es invalido !
                style: danger
                icon: fa-warning
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P287_RESPUESTA
                value: 401
            }
        )

        action native-alert-3 (
            action: alert
            settings {
                title: Advertencia
                message: Parámetros Invalidos
                style: danger
                icon: fa-warning
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P287_RESPUESTA
                value: 400
            }
        )

        action native-alert-4 (
            action: alert
            settings {
                message: Acceso denegado a la API !
                style: danger
                icon: fa-warning
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P287_RESPUESTA
                value: 403
            }
        )

        action native-alert-5 (
            action: alert
            settings {
                message: "Cuenta de Whatsapp no existe "
                style: danger
                icon: fa-warning
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P287_RESPUESTA
                value: 404
            }
        )

        action native-alert-6 (
            action: alert
            settings {
                message: "Un error inesperado ha ocurrido "
                style: warning
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P287_RESPUESTA
                value: 500
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

    )

    dynamicAction ocultar (
        name: Ocultar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P287_IMAGEN
                    P287_DOCUMENTO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultar-desocultar (
        name: Ocultar/Desocultar
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P287_TIPO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P287_IMAGEN
                    P287_DOCUMENTO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-show (
