page 461 (
    name: Planilla de Vacaciones
    alias: PLANILLA-DE-VACACIONES
    title: Planilla de Vacaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @planilla
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region planilla (
        name: Planilla
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT VC.ID,
                       VC.ID_EMPRESA,
                       VC.ID_EMPLEADO,
                       EM.FEC_INGRESO,
                       EM.ANTIG_ANTERIOR,
                       EM.ANTIG_ANTERIOR_MES,
                       VC.PERIODO,
                       VC.FEC_INICIAL,
                       VC.FEC_FINAL,
                       VC.DIAS,
                       VC.FEC_REINTEGRO,
                       VC.FEC_NOTIFICACION,
                       VC.DIAS_DISPONIBLES,
                       VC.DIAS_UTILIZADOS,
                       VC.DIAS_ACUMULADOS
                FROM RHW_VACACIONES VC, RHW_EMPLEADOS EM
                WHERE VC.ID_EMPRESA  = :P0_ID_EMPRESA
                  AND VC.ID_EMPLEADO = EM.ID
                  AND (VC.PERIODO = :P461_PERIODO_DESDE||'/'||:P461_PERIODO_HASTA)
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P461_PERIODO_DESDE
                P461_PERIODO_HASTA
            ]
        }
        layout {
            sequence: 10
            parentRegion: @planilla-de-vacaciones
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 462
                items: {
                    P462_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
        }
        advanced {
            savedReportMappingIdentifier: 54689618584259047
        }

        column ANTIG_ANTERIOR (
            type: plainText
            heading {
                heading: Años
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ANTIG_ANTERIOR_MES (
            type: plainText
            heading {
                heading: Meses
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column DIAS (
            type: plainText
            heading {
                heading: Días
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column DIAS_ACUMULADOS (
            type: plainText
            heading {
                heading: Días<br>(Acumulados)
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column DIAS_DISPONIBLES (
            type: plainText
            heading {
                heading: Días<br>(Disponibles)
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column DIAS_UTILIZADOS (
            type: plainText
            heading {
                heading: Días<br>(Utilizados)
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column FEC_FINAL (
            type: plainText
            heading {
                heading: Fec. Final
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column FEC_INGRESO (
            type: plainText
            heading {
                heading: Fec. Ingreso
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column FEC_INICIAL (
            type: plainText
            heading {
                heading: Fec. Inicial
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column FEC_NOTIFICACION (
            type: plainText
            heading {
                heading: Fec. Notificacion
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column FEC_REINTEGRO (
            type: plainText
            heading {
                heading: Fec. Reintegro
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPLEADO (
            type: plainTextBasedOnLov
            heading {
                heading: Empleados
                alignment: center
            }
            lov {
                lov: @lv-empleados
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column PERIODO (
            type: plainText
            heading {
                heading: Periodo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Planilla
        }

        savedReport 557325 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ANTIG_ANTERIOR (
                sequence: 5
            )

            displayColumn ANTIG_ANTERIOR_MES (
                sequence: 6
            )

            displayColumn DIAS (
                sequence: 10
            )

            displayColumn DIAS_ACUMULADOS (
                sequence: 15
            )

            displayColumn DIAS_DISPONIBLES (
                sequence: 13
            )

            displayColumn DIAS_UTILIZADOS (
                sequence: 14
            )

            displayColumn FEC_FINAL (
                sequence: 9
            )

            displayColumn FEC_INGRESO (
                sequence: 4
            )

            displayColumn FEC_INICIAL (
                sequence: 8
            )

            displayColumn FEC_NOTIFICACION (
                sequence: 12
            )

            displayColumn FEC_REINTEGRO (
                sequence: 11
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPLEADO (
                sequence: 3
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn PERIODO (
                sequence: 7
            )

        )

    )

    region planilla-de-vacaciones (
        name: Planilla de Vacaciones
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region planilla-de-vacaciones-2 (
        name: Planilla de Vacaciones
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 50
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P461_ANIO (
        type: textField
        label {
            label: <p>Año:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P461_MES (
        type: textField
        label {
            label: <p>Mes:</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P461_PERIODO_DESDE (
        type: textField
        label {
            label: <p>Periodo:</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 4
        }
        validation {
            maxLength: 4
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT TO_CHAR(SYSDATE,'YYYY') FROM DUAL;
        }
    )

    pageItem P461_PERIODO_HASTA (
        type: textField
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 4
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 4
        }
        validation {
            maxLength: 4
        }
        advanced {
            preText: /
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT (TO_NUMBER(TO_CHAR(SYSDATE,'YYYY')) + 1) FROM DUAL;
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--gapLeft
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @planilla
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 462
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction dialog-cancel (
        name: DIALOG_CANCEL
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @planilla
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @planilla
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-vacaciones (
        name: REFRESH_VACACIONES
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @buscar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @planilla
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-cod-empleado (
        name: SET_COD_EMPLEADO
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @planilla
            columns: ID_EMPLEADO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT E.COD_EMPLEADO
                    FROM RHW_EMPLEADOS E
                    WHERE E.ID = :ID_EMPLEADO
                    ```
                itemsToSubmit: ID_EMPLEADO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: COD_EMPLEADO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

