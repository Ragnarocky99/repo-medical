                declare
                    lBlob    BLOB;
                    lFile    BFILE := BFILENAME('DIR_RG90', :P597_NOMBRE || '.txt');
                    lZipFile BLOB;
                begin
                    -- Crear un BLOB temporal para el ZIP
                    DBMS_LOB.CREATETEMPORARY(lZipFile, TRUE);
                
                    -- Abrir el archivo físico
                    DBMS_LOB.OPEN(lFile, DBMS_LOB.LOB_READONLY);
                
                    -- Crear un BLOB temporal para el contenido del TXT
                    DBMS_LOB.CREATETEMPORARY(lBlob, TRUE);
                    DBMS_LOB.LOADFROMFILE(lBlob, lFile, DBMS_LOB.GETLENGTH(lFile));
                    DBMS_LOB.CLOSE(lFile);
                
                    -- Agregar el TXT dentro del ZIP
                    apex_zip.add_file(
                        p_zipped_blob => lZipFile,
                        p_file_name   => :P597_NOMBRE || '.txt',
                        p_content     => lBlob
                    );
                    apex_zip.finish(lZipFile);
                
                    -- Cabeceras para descargar como ZIP
                    owa_util.mime_header('application/zip', false, 'UTF-8');
                    htp.p('Content-length: ' || DBMS_LOB.GETLENGTH(lZipFile));
                    htp.p('Content-Disposition: attachment; filename="' || :P597_NOMBRE || '.zip"');
                    owa_util.http_header_close;
                
                    -- Descargar el ZIP
                    wpg_docload.download_file(lZipFile);
                
                    -- Liberar recursos
                    DBMS_LOB.FREETEMPORARY(lBlob);
                    DBMS_LOB.FREETEMPORARY(lZipFile);
                end;
                
                ```
