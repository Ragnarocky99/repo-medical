            onLabel: Activo
            offValue: I
            offLabel: Inactivo
        }
        layout {
            sequence: 330
            region: @carga-de-usuarios
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
