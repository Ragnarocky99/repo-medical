    pageItem P5_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal: &ensp;</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION||'('||COD_SUCURSAL||')',ID FROM BSW_SUCURSALES WHERE
                ID_EMPRESA= :P5_ID_EMPRESA
                ```
        }
        cascadingLov {
            parentItems: P5_ID_EMPRESA
            itemsToSubmit: P5_ID_EMPRESA
        }
        layout {
            sequence: 70
            region: @carga-de-usuarios
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-usuarios
            column: ID_SUCURSAL
            dataType: number
        }
    )

