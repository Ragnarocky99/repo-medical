        }
    )

    pageItem P5_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-usuarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-usuarios
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_USUARIOS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

