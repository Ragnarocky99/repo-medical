page 5 (
    name: Carga de Usuarios
    alias: CARGA-DE-USUARIOS
    title: Carga de Usuarios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-usuarios (
        name: Carga de Usuarios
        type: form
        source {
            location: localDatabase
            tableName: BSW_USUARIOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_AUTORIZA_CTACTE (
        type: hidden
        layout {
            sequence: 410
            region: @carga-de-usuarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-usuarios
            column: AUTORIZA_CTACTE
            dataType: varchar2
        }
    )

    pageItem P5_AUTORIZA_STOCK (
        type: hidden
        layout {
            sequence: 240
            region: @carga-de-usuarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-usuarios
            column: AUTORIZA_STOCK
            dataType: varchar2
        }
    )

    pageItem P5_CARGO (
        type: textField
        label {
            label: <p>Cargo: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 470
            region: @carga-de-usuarios
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @carga-de-usuarios
            column: CARGO
            dataType: varchar2
        }
    )

    pageItem P5_CLAVE (
        type: password
        label {
            label: <p>Contraseña: &ensp;</p>
            alignment: left
        }
        layout {
