            region: @carga-de-usuarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-usuarios
            column: CLAVE
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_ID
        }
    )

    pageItem P5_COD_USUARIO (
        type: textField
        label {
            label: <p>Cód. Usuario: &ensp;</p>
