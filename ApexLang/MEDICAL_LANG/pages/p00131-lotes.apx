page 131 (
    name: Lotes
    alias: LOTES
    title: Lotes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region lotes (
        name: Lotes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_ARTICULO,
                       NRO_LOTE,
                       ID_IVA,
                       FEC_VENCIMIENTO,
                       CANTIDAD,
                       COSTO_PROM_NUE,
                       PORC_COMISION,
                       ID_UNIDAD_MEDIDA,
                       COSTO_REF,
                       ID_COMPRA_CAB,
                       ID_INVENTARIO_CAB,
                       ID_ENTSAL_CAB,
                       ID_COLOR,
                       ID_TALLE
                  from STW_LOTES
                 where ID_EMPRESA=:P0_ID_EMPRESA
                   AND ID_ARTICULO IN (SELECT ID FROM STW_ARTICULOS WHERE (COD_ORIGEN_ART=:P131_GRUPO OR :P131_GRUPO IS NULL) AND ID_EMPRESA=:P0_ID_EMPRESA);
                
                
                ```
            pageItemsToSubmit: P131_GRUPO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 132
                items: {
                    P132_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 24231052117813270
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column COSTO_PROM_NUE (
            type: hidden
            heading {
                heading: Costo Prom Nue
            }
            layout {
                sequence: 108
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column COSTO_REF (
            type: hidden
            heading {
                heading: Costo Ref
            }
            layout {
                sequence: 118
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column FEC_VENCIMIENTO (
            type: plainText
            heading {
                heading: Fecha Vencimiento
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 88
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_ARTICULO (
            type: plainTextBasedOnLov
            heading {
                heading: Articulo
                alignment: center
            }
            lov {
                lov: @stw-articulos-cod-articulo
            }
            layout {
                sequence: 138
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_COLOR (
            type: plainText
            heading {
                heading: Id Color
                alignment: end
            }
            layout {
                sequence: 198
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: W
            }
        )

        column ID_COMPRA_CAB (
            type: plainText
            heading {
                heading: Id Compra Cab
                alignment: end
            }
            layout {
                sequence: 168
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: T
            }
        )

        column ID_EMPRESA (
            type: plainText
            heading {
                heading: Id Empresa
                alignment: end
            }
            layout {
                sequence: 128
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column ID_ENTSAL_CAB (
            type: plainText
            heading {
                heading: Id Entsal Cab
                alignment: end
            }
            layout {
                sequence: 188
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: V
            }
        )

        column ID_INVENTARIO_CAB (
            type: plainText
            heading {
                heading: Id Inventario Cab
                alignment: end
            }
            layout {
                sequence: 178
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: U
            }
        )

        column ID_IVA (
            type: plainText
            heading {
                heading: Id Iva
                alignment: end
            }
            layout {
                sequence: 148
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_TALLE (
            type: plainTextBasedOnLov
            heading {
                heading: Talle
                alignment: center
            }
            lov {
                lov: @lv-talles
            }
            layout {
                sequence: 208
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: X
            }
        )

        column ID_UNIDAD_MEDIDA (
            type: plainText
            heading {
                heading: Id Unidad Medida
                alignment: end
            }
            layout {
                sequence: 158
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column NRO_LOTE (
            type: plainText
            heading {
                heading: Nro. Lote
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column PORC_COMISION (
            type: plainText
            heading {
                heading: Porcentaje Comisión
            }
            layout {
                sequence: 58
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Lotes
        }

        savedReport 242398 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 4
            )

            displayColumn COSTO_PROM_NUE (
                sequence: 5
            )

            displayColumn COSTO_REF (
                sequence: 7
            )

            displayColumn FEC_VENCIMIENTO (
                sequence: 3
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn NRO_LOTE (
                sequence: 2
            )

            displayColumn PORC_COMISION (
                sequence: 6
            )

        )

    )

    pageItem P131_GRUPO (
        type: popupLov
        label {
            label: <p>Grupo</p>
            alignment: left
        }
        settings {
            manualEntry: true
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT DISTINCT COD_ORIGEN_ART FROM STW_ARTICULOS;
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @lotes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 132
                clearCache: 132
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lotes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lotes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P131_GRUPO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lotes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

