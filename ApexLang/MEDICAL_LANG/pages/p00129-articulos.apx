page 129 (
    name: Articulos
    alias: ARTICULOS
    title: Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region articulos (
        name: Articulos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT A.ID,
                       A.COD_ARTICULO,
                       A.DESCRIPCION,
                       A.ID_GRUPO_ART,
                       A.ID_PAIS_ORIGEN,
                       A.ID_MARCA,
                       A.ID_RUBRO,
                       A.ID_FAMILIA,
                       A.ID_LINEA,
                       A.ID_ENVASE,
                       A.ID_IVA,
                       A.IND_MANEJA_STOCK,
                       A.ID_UNIDAD_MEDIDA,
                       A.COSTO_PROM,
                       A.ID_MONEDA_COSTO,
                       A.ID_PROVEEDOR_DFLT,
                       A.COD_ORIGEN_ART,
                       A.ID_EMPRESA,
                       A.ESTADO,
                       A.PRECIO_BASE,
                       A.ID_MONEDA_BASE,
                       A.COD_BARRA_ART,
                       A.IND_MODIFICA_PRECIO,
                       A.PORC_DESCUENTO,
                       A.COD_ARTICULO_ORD,
                       A.COD_USUARIO_AUD,
                       A.ID_CUENTA_STOCK,
                       A.ID_CUENTA_GASTO,
                       A.ID_CUENTA_VENTA,
                       A.ID_CUENTA_COSTO,
                       A.IND_VENTA,
                       A.IND_COMPRA,
                       A.IND_MANEJA_LOTE,
                       --A.IMAGEN_ARTICULO,
                       A.MIMETYPE,
                       A.FILENAME,
                       A.ID_TALLE,
                       A.ID_COLOR,
                       A.COD_QUIMICO,
                       A.SINONIMO,
                       --obtener_cantidad_existente(A.ID, :P0_ID_SUCURSAL, 'S') AS CANTIDAD_EXISTENTE,
                       obtener_nombre_ultimo_proveedor(a.ID) AS PROVEEDOR,
                       A.COD_USUARIO_MOD,
                       A.FEC_ALTA,
                       A.FEC_MODIFICACION,
                       DECODE(NVL(A.IND_CONTROLADO, 'N'), 'S', 'Si',
                                                               'No') IND_CONTROLADO,
                       DECODE(NVL(A.IND_PELIGROSO, 'N'), 'S', 'Si',
                                                               'No') IND_PELIGROSO,
                                                              
                       DECODE(NVL(A.IND_STOCK_MINMAX, 'N'), 'S', 'Si',
                                                                 'No') IND_STOCK_MINMAX,
                       DECODE(NVL(A.IND_DIMABEL, 'N'), 'S', 'Si',
                                                            'No') IND_DIMABEL,
                       DECODE(NVL(A.IND_BIOLOGICO, 'N'), 'S', 'Si',
                                                            'No') IND_BIOLOGICO
                FROM 
                     STW_ARTICULOS A
                 WHERE A.ID_EMPRESA= :P0_COD_EMPRESA
                  --AND  (UPPER(A.COD_ARTICULO)   LIKE '%' || UPPER(:P129_COD_ARTICULO)     || '%' OR UPPER(:P129_COD_ARTICULO)     IS NULL)
                   AND (A.COD_ARTICULO = :P129_COD_ARTICULO OR :P129_COD_ARTICULO IS NULL)
                   AND (UPPER(A.DESCRIPCION)    LIKE '%' || UPPER(:P129_DESCRIPCION)      || '%' OR UPPER(:P129_DESCRIPCION)      IS NULL)
                   AND (UPPER(A.COD_ORIGEN_ART) LIKE '%' || UPPER(:P129_COD_ARTICULO_ORI) || '%' OR UPPER(:P129_COD_ARTICULO_ORI) IS NULL)
                   AND (A.ID_FAMILIA    = :P129_FAMILIA OR :P129_FAMILIA IS NULL)
                   AND (A.ID_GRUPO_ART  = :P129_GRUPOS  OR :P129_GRUPOS  IS NULL)
                   AND (A.ID_LINEA      = :P129_LINEA   OR :P129_LINEA   IS NULL)
                   AND (A.ESTADO        = :P129_ESTADO OR :P129_ESTADO IS NULL)
                   AND (A.COD_QUIMICO   = :P129_COD_QUIMICO OR :P129_COD_QUIMICO IS NULL)
                   AND (A.ID_RUBRO = :P129_GENERO OR :P129_GENERO IS NULL)
                   AND (obtener_nombre_ultimo_proveedor(a.ID) = :P129_PROVEEDOR OR :P129_PROVEEDOR IS NULL)
                   AND (UPPER(A.SINONIMO)    LIKE '%' || UPPER(:P129_SINONIMO)|| '%' OR UPPER(:P129_SINONIMO) IS NULL)
                   AND (A.ID_MARCA = :P129_ID_MARCA OR :P129_ID_MARCA IS NULL)
                
                GROUP BY A.ID,
                         A.COD_ARTICULO,
                         A.DESCRIPCION,
                         A.ID_GRUPO_ART,
                         A.ID_PAIS_ORIGEN,
                         A.ID_MARCA,
                         A.ID_RUBRO,
                         A.ID_FAMILIA,
                         A.ID_LINEA,
                         A.ID_ENVASE,
                         A.ID_IVA,
                         A.IND_MANEJA_STOCK,
                         A.ID_UNIDAD_MEDIDA,
                         A.COSTO_PROM,
                         A.ID_MONEDA_COSTO,
                         A.ID_PROVEEDOR_DFLT,
                         A.COD_ORIGEN_ART,
                         A.ID_EMPRESA,
                         A.ESTADO,
                         A.PRECIO_BASE,
                         A.ID_MONEDA_BASE,
                         A.COD_BARRA_ART,
                         A.IND_MODIFICA_PRECIO,
                         A.PORC_DESCUENTO,
                         A.COD_ARTICULO_ORD,
                         A.COD_USUARIO_AUD,
                         A.ID_CUENTA_STOCK,
                         A.ID_CUENTA_GASTO,
                         A.ID_CUENTA_VENTA,
                         A.ID_CUENTA_COSTO,
                         A.IND_VENTA,
                         A.IND_COMPRA,
                         A.IND_MANEJA_LOTE,
                --         A.IMAGEN_ARTICULO,
                         A.MIMETYPE,
                         A.FILENAME,
                         A.ID_TALLE,
                         A.ID_COLOR,
                         A.COD_QUIMICO,
                         A.SINONIMO,---,
                         A.COD_USUARIO_MOD,
                         A.FEC_ALTA,
                         A.FEC_MODIFICACION,
                         NVL(A.IND_CONTROLADO, 'N'),
                         NVL(A.IND_PELIGROSO, 'N'),
                         NVL(A.IND_STOCK_MINMAX, 'N'),
                         NVL(A.IND_DIMABEL, 'N'),
                         NVL(A.IND_BIOLOGICO, 'N')
                        ORDER BY TO_NUMBER(A.COD_ARTICULO) DESC ;
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P129_COD_ARTICULO
                P129_GRUPOS
                P129_DESCRIPCION
                P129_LINEA
                P129_COD_BARRA
                P129_FAMILIA
                P129_COD_ARTICULO_ORI
                P129_ESTADO
                P129_COD_QUIMICO
                P129_PROVEEDOR
                P129_SINONIMO
                P129_GENERO
                P129_ID_MARCA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 130
                items: {
                    P130_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No existen datos.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchField: false
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 14742717028708775
        }

