    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @articulos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 130
                clearCache: 130
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-filter
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button limpiar (
        buttonName: LIMPIAR
        label: Limpiar
        layout {
            sequence: 20
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @articulos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @articulos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar (
        name: FILTRAR
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @articulos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpiar (
        name: LIMPIAR
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @limpiar
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P129_COD_ARTICULO
                    P129_GRUPOS
                    P129_DESCRIPCION
                    P129_LINEA
                    P129_COD_BARRA
                    P129_FAMILIA
                    P129_COD_ARTICULO_ORI
                    P129_ESTADO
                    P129_GENERO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P129_COD_ARTICULO
                P129_GRUPOS
                P129_DESCRIPCION
                P129_LINEA
                P129_COD_BARRA
                P129_FAMILIA
                P129_COD_ARTICULO_ORI
                P129_ESTADO
                P129_COD_QUIMICO
                P129_PROVEEDOR
                P129_SINONIMO
                P129_GENERO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @articulos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18169115416797140
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

