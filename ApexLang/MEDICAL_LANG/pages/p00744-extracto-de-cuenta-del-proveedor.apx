    region extracto-de-cuenta-del-proveedor (
        name: Extracto de cuenta del proveedor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    T.ORDEN,
                    T.SUCURSAL,
                    T.FEC_COMPROBANTE,
                    T.TIP_COMPROBANTE,
                    T.SER_COMPROBANTE,
                    T.NRO_COMPROBANTE,
                    T.TIP_COMPROBANTE_REF,
                    T.SER_COMPROBANTE_REF,
                    TO_CHAR(T.NRO_COMPROBANTE_REF) NRO_COMPROBANTE_REF,
                    T.DOC_PROVEEDOR,
                    T.PROVEEDOR,
                    T.FEC_VENCIMIENTO,
                    DECODE(T.ID_COMPROBANTE, NULL, 0, T.DEBITO) DEBITO,
                    DECODE(T.ID_COMPROBANTE, NULL, 0, T.CREDITO) CREDITO,
                    T.DETALLE,
                    T.MONEDA,
                    T.TIP_CAMBIO,
                    SUM(T.CREDITO - T.DEBITO) OVER (PARTITION BY T.ID_PROVEEDOR, MONEDA ORDER BY T.ID_PROVEEDOR, T.FEC_COMPROBANTE, T.ORDEN) SALDO,
                    PREPARA_URL_CARGA(:P0_ID_EMPRESA, T.TIP_COMPROBANTE, T.ID_COMPROBANTE) URL,
                    CASE
                        WHEN (T.TIP_COMPROBANTE_REF NOT IN ('CAJ', 'OP') OR T.TIP_COMPROBANTE_REF IS NULL) THEN
                            NVL((SELECT 'Pago total'
                                  FROM CMWV_EXTRACTO_PROVEEDOR EP
                                 WHERE EP.ID_COMPROBANTE = T.ID_COMPROBANTE
                                   AND EP.ID_PROVEEDOR = T.ID_PROVEEDOR
                                   AND EP.FEC_COMPROBANTE <= :P744_FEC_HASTA
                                   AND EP.TIP_COMPROBANTE_REF IN ('CAJ', 'OP')
                                   AND EP.ID_CUOTA = T.ID_CUOTA
                                  HAVING ABS(SUM(EP.CREDITO - EP.DEBITO)) = (T.CREDITO - T.DEBITO)
                                 UNION ALL
                                 SELECT 'Pago parcial'
                                  FROM CMWV_EXTRACTO_PROVEEDOR EP
                                 WHERE EP.ID_COMPROBANTE = T.ID_COMPROBANTE
                                   AND EP.ID_PROVEEDOR = T.ID_PROVEEDOR
                                   AND EP.FEC_COMPROBANTE <= :P744_FEC_HASTA
                                   AND EP.TIP_COMPROBANTE_REF IN ('CAJ', 'OP')
                                   AND EP.ID_CUOTA = T.ID_CUOTA
                                  HAVING ABS(SUM(EP.CREDITO - EP.DEBITO)) != (T.CREDITO - T.DEBITO)), 'Pendiente')
                        ELSE
                            NULL
                    END ESTADO,
                    T.NRO_FACTURA,
                    T.NRO_FACTURA_REF,
                    T.ANULADO
                FROM (  
                    SELECT ROW_NUMBER() OVER (ORDER BY ID_PROVEEDOR, MONEDA, FEC_COMPROBANTE, ORD) + 1000 ORDEN,
                           ID_EMPRESA,
                           SUCURSAL,
                           FEC_COMPROBANTE,
                           TIP_COMPROBANTE,
                           SER_COMPROBANTE,
                           NRO_COMPROBANTE,
                           TIP_COMPROBANTE_REF,
                           SER_COMPROBANTE_REF,
                           NRO_COMPROBANTE_REF,
                           DOC_PROVEEDOR,
                           PROVEEDOR,
                           FEC_VENCIMIENTO,
                           DEBITO,
                           CREDITO,
                           DETALLE,
                           MONEDA,
                           TIP_CAMBIO,
                           ID_PROVEEDOR,
                           ID_COMPROBANTE,
                           COD_PROVEEDOR,
                           NRO_FACTURA,
                           NRO_FACTURA_REF,
                           ID_CUOTA,
                           ANULADO,
                           ID_PROVEEDOR_REF
                      FROM CMWV_EXTRACTO_PROVEEDOR
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND FEC_COMPROBANTE BETWEEN :P744_FEC_DESDE AND :P744_FEC_HASTA
                    UNION ALL
                    SELECT ROW_NUMBER() OVER (ORDER BY ID_PROVEEDOR/*, MONEDA*/) ORDEN,
                           ID_EMPRESA,
                           NULL,--SUCURSAL,
                           MAX(FEC_COMPROBANTE),
                           NULL,--TIP_COMPROBANTE,
                           NULL,--SER_COMPROBANTE,
                           NULL,--NRO_COMPROBANTE,
                           NULL,--TIP_COMPROBANTE_REF,
                           NULL,--SER_COMPROBANTE_REF
                           NULL,--NRO_COMPROBANTE_REF
                           DOC_PROVEEDOR,
                           PROVEEDOR,
                           NULL,--FEC_VENCIMIENTO,
                           SUM(DEBITO),
                           SUM(CREDITO),
                           'SALDO ANTERIOR',--DETALLE,
                           'GUARANIES (1)',--MONEDA,
                           NULL,--TIP_CAMBIO
                           ID_PROVEEDOR,
                           NULL,--ID
                           COD_PROVEEDOR,
                           NULL, -- NRO_FACTURA
                           NULL, -- NRO_FACTURA_REF
                           NULL,  -- ID_CUOTA
                           'N' ANULADO,
                           ID_PROVEEDOR_REF
                      FROM CMWV_EXTRACTO_PROVEEDOR
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND FEC_COMPROBANTE < :P744_FEC_DESDE
                    GROUP BY ID_EMPRESA, DOC_PROVEEDOR, PROVEEDOR, /*MONEDA,*/ ID_PROVEEDOR, COD_PROVEEDOR, ID_PROVEEDOR_REF
                    HAVING (SUM(CREDITO) - SUM(DEBITO)) != 0
                ) T
                WHERE T.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (T.ID_PROVEEDOR = :P744_PROVEEDOR OR :P744_PROVEEDOR IS NULL)
                  AND (T.ID_PROVEEDOR_REF = :P744_PROVEEDOR_REF OR :P744_PROVEEDOR_REF IS NULL)
                ```
            pageItemsToSubmit: [
                P744_FEC_DESDE
                P744_FEC_HASTA
                P744_PROVEEDOR
                P744_PROVEEDOR_REF
            ]
        }
