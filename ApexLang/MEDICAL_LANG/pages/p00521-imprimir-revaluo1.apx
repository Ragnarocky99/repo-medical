page 521 (
    name: Imprimir Revaluo
    alias: IMPRIMIR-REVALUO1
    title: Imprimir Revaluo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    branch (
        name: Branch to PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                if :P497_REVALUO_CONT = 'N' THEN
                  declare
                            l_proc varchar2(100) := 'show report';
                            l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          BEGIN
                            xlog (l_proc, 'url (orig):' || l_report_url);
                            xlib_jasperreports.set_report_url(l_report_url);
                            xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('CuadroRevaluo'),
                                    p_rep_format          => apex_util.url_encode('pdf'),
                                    p_data_source         => apex_util.url_encode('default'),
                                    p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                    p_rep_locale          => apex_util.url_encode('es_ES'),
                                    p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                    p_additional_params   => ('P_INICIO='||:P0_FEC_INICIAL_EJERCICIO||'&'||'P_FIN='||:P0_FEC_FINAL_EJERCICIO||'&'||'p_mon_empresa='||:P0_DESC_EMPRESA||'&'||'p_usuario='||:APP_USER)
                                    );
                            apex_application.stop_apex_engine();
                
                          exception
                            when apex_application.e_stop_apex_engine then
                              null; -- ok, stop engine raises exception, we can ignore that
                            when others then 
                              xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                              raise;
                            end;
                else
                  declare
                            l_proc varchar2(100) := 'show report';
                            l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          BEGIN
                            xlog (l_proc, 'url (orig):' || l_report_url);
                            xlib_jasperreports.set_report_url(l_report_url);
                            xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('CuadroRevaluoCont'),
                                    p_rep_format          => apex_util.url_encode('pdf'),
                                    p_data_source         => apex_util.url_encode('default'),
                                    p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                    p_rep_locale          => apex_util.url_encode('es_ES'),
                                    p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                    p_additional_params   => ('P_INICIO='||:P0_FEC_INICIAL_EJERCICIO||'&'||'P_FIN='||:P0_FEC_FINAL_EJERCICIO||'&'||'p_mon_empresa='||:P0_DESC_EMPRESA||'&'||'p_usuario='||:APP_USER)
                                    );
                            apex_application.stop_apex_engine();
                
                          exception
                            when apex_application.e_stop_apex_engine then
                              null; -- ok, stop engine raises exception, we can ignore that
                            when others then 
                              xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                              raise;
                          end;
                end if;
                ```
        }
    )

)

