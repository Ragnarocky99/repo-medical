page 560 (
    name: Mantenimiento de Motivo de Anulación
    alias: MANTENIMIENTO-DE-MOTIVO-DE-ANULACIÓN
    title: Mantenimiento de Motivo de Anulación
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mantenimiento-de-motivo-de-anulación (
        name: Mantenimiento de Motivo de Anulación
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       DESCRIPCION,
                       ESTADO,
                       COD_MOTIVO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON
                  from LTW_MOTIVOS_ANULACION
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 561
                items: {
                    P561_ID: #ID#
                    P561_ID_EMPRESA: #ID_EMPRESA#
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 90224673437205182
        }

        column COD_MOTIVO (
            type: plainText
            heading {
                heading: <p>Código</p>
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: <p>Descripción</p>
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: <p>Activo</p>
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ESTADO_ICON (
            type: plainText
            heading {
                heading: Estado Icon
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: ID_EMPRESA
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Mantenimiento de Motivo de Anulación
        }

        savedReport 902348 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_MOTIVO (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ESTADO (
                sequence: 3
            )

            sort (
                column: COD_MOTIVO
                sort {
                    sequence: 1
                }
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @mantenimiento-de-motivo-de-anulación
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 561
                clearCache: 561
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @mantenimiento-de-motivo-de-anulación
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @mantenimiento-de-motivo-de-anulación
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

