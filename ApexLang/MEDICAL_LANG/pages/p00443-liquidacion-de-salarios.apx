                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
              text-align: right;
              height: 26px;
            }
            
            .cambio{
                    vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 190px;
