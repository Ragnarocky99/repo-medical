    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       ID_EMPLEADO,
                       ID_CONCEPTO,
                       TIPO,
                       MONTO,
                       CANTIDAD,
                       COD_USUARIO_AUD,
                       ID_CAB_LIQUID,
                       ID,
                       ID_PROGRAMA,
                       NRO_CUOTA,
                       ID_SUCURSAL,
                       ANIO,
                       MES,
                       NRO_ORDEN,
                       OBSERVACION,
                       MONTO_REAL,
                       TIP_PROGRAMA,
                       FEC_VENCIMIENTO,
                       CANT_AUS,
                       DIRECCION_IP,
                       DECODE(TIPO,'H',MONTO,'D',0) AS BENEFICIOS,
                       DECODE(TIPO,'D',MONTO,'H',0) AS DEDUCCIONES,
                       DECODE(TIPO,'D',MONTO,'D',0) AS DEBE_COPIA,
                       DECODE(TIPO,'H',MONTO,'H',0) AS HABER_COPIA
                  from RHW_DETALLE_LIQ
                  WHERE ID_CAB_LIQUID=:P443_ID;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @liquidación-de-salarios
            slot: subRegions
