            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P443_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P443_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P443_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P443_URL
                    P443_ASIENTOS_ID
                ]
                itemsToReturn: P443_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P443_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction calc-diferencia (
        name: CALC_DIFERENCIA
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P443_TOT_HABER
                P443_TOT_DEBE
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calcDiferencia();
            }
            affectedElements {
                selectionType: items
                items: P443_DIFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar (
        name: INICIALIZAR
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    //grid.view$.grid("option", "editable", true);
                    //editable true
                        grid.model.setOption("editable", true);
                        //grid.setEditMode(true);
                    //editable false
                    //grid.model.setOption("editable", false);
                        grid.setEditMode(true);
                        grid.setEditMode(false);
                    
                    /*var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        $grid.setEditMode(false);*/
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setear-beneficios-deducciones (
        name: SETEAR_BENEFICIOS_DEDUCCIONES
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                TIPO
                MONTO
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                        v_beneficio NUMBER(10);
                        v_deducciones NUMBER(10);
                    BEGIN
                        IF :TIPO = 'D' THEN
                            v_beneficio := 0;
                            v_deducciones := :MONTO;
                    
                        ELSE IF :TIPO = 'H' THEN 
                                v_beneficio := :MONTO;
                                v_deducciones := 0;
                             ELSE
                                RAISE_APPLICATION_ERROR(-20000, 'ERROR AL CALCULAR BENEFICIOS Y DEDUCCIONES');
                             END IF;
                        END IF;
                        :BENEFICIOS := v_beneficio;
                        :DEDUCCIONES := v_deducciones;
                    END;
                    ```
                itemsToSubmit: [
                    TIPO
                    MONTO
                ]
                itemsToReturn: [
                    BENEFICIOS
                    DEDUCCIONES
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-copias (
        name: SETEAR_COPIAS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                BENEFICIOS
                DEDUCCIONES
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: [
                    P443_TOT_HABER
                    P443_TOT_DEBE
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :BENEFICIOS
                itemsToSubmit: BENEFICIOS
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: HABER_COPIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :DEDUCCIONES
                itemsToSubmit: DEDUCCIONES
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: DEBE_COPIA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    computation p443-asientos-id (
        itemName: P443_ASIENTOS_ID
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                select id 
                from cow_diario_cabeceras_prov
                where num_asiento  = :P135_ASIENTOS
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P443_FEC_LIQUID);
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P443_ASIENTOS
        }
    )

    computation p443-tot-haber (
        itemName: P443_TOT_HABER
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT SUM(DECODE(TIPO,'H',MONTO,0)) FROM RHW_DETALLE_LIQ D WHERE
                D.ID_CAB_LIQUID=:P414_ID;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49533713342443303
        }
    )

    process initialize-form-detalle-de-liquidación (
        name: Initialize form Detalle de Liquidación
        type: formInitialization
        formRegion: @liquidación-de-salarios
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 43633903420814764
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 433
            }
        }
    )

    branch (
        name: Go to Page 449
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 449
                items: {
                    P443_ID: &P443_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

