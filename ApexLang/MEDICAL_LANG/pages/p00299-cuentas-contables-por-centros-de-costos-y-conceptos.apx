page 299 (
    name: Cuentas Contables por Centros de Costos y Conceptos
    alias: CUENTAS-CONTABLES-POR-CENTROS-DE-COSTOS-Y-CONCEPTOS
    title: "Cuentas Contables por Centros de Costos y Conceptos "
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cuentas-contables-por-centros (
        name: Cuentas contables por centros
        type: interactiveReport
        source {
            location: localDatabase
            tableName: RHW_CUENTAS_CENTROS_CONC
            whereClause:
                ```sql
                ID_EMPRESA=:P0_ID_EMPRESA
                AND (ID_SUCURSAL=:P0_ID_SUCURSAL)
                ```
            orderByClause: ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 300
                items: {
                    P300_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 9542306601661803
        }

