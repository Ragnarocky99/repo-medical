    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @cuentas-contables-por-centros
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 300
                items: {
                    P300_ID: &P300_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button imprimir (
        buttonName: Imprimir
        label: Imprimir
        layout {
            sequence: 20
            region: @cuentas-contables-por-centros
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction after-closing-dialog (
        name: After closing dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @cuentas-contables-por-centros
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cuentas-contables-por-centros
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go to Page 301
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 301
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

