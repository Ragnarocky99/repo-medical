    region carga-de-datos-de-reparto-para-repartidor (
        name: Carga de datos de Reparto para Repartidor
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RD.ID,
                       RD.ID_EMPRESA,
                       RD.ID_REPARTO_CABECERA,
                       RD.NRO_PLANILLA,
                       RD.ID_COMPROBANTE_CABECERA,
                       RD.ID_SUCURSAL,
                       RD.ESTADO,
                       RD.OBSERVACION,
                       RD.FEC_CAMBIO_ESTADO,
                       RD.NIVEL,
                       RD.ID_USUARIO_CAMBIO,
                       RD.COD_USUARIO_AUD,
                       RD.REMISION_IMPRESA,
                       RD.ID_FACTURA_VT,
                       RD.ID_REMISION,
                       RD.ID_RECIBO,
                       RD.TIP_COMPROBANTE,
                       RD.IND_ENTREGADO,
                       RD.HORA_ENTREGA,
                       RD.FIRMADO_POR,
                       RD.COMENTARIO,
                       RD.NRO_COMPROBANTE,
                       RD.IND_DOCUMENTO,
                       RD.IND_STOCK,
                       RD.ID_FACTURA_CM,
                       RD.ID_OCP,
                       RD.ID_NOTA_ENVIO,
                       sc.DIRECCION_ENVIO,
                       RD.COD_USUARIO_ENTREGA,
                       RD.ID_SOLICITUD_DET,
                       SC.ID_CLIENTE,
                       SC.ID_PROVEEDOR,
                       SC.COMENTARIO COMENTARIO_SOL
                  from RPW_REPARTO_DETALLE RD
                  join rpw_solicitud_reparto_det sd on sd.id = rd.id_solicitud_det
                  join rpw_solicitud_reparto_cab sc on sc.id = sd.id_solicitud_rep_cab
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

