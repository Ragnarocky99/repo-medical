    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P717_ESTADO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select to_char(sysdate,'dd/MM/yyyy hh24:mi'), 'S', :APP_USER
                    from dual
                    ```
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P717_HORA_ENTREGA
                    P717_IND_ENTREGADO
                    P717_COD_USUARIO_ENTREGA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select p.nombre
                    from ccw_clientes c
                    join bsw_personas p on p.id = c.id_persona
                    where c.id = :P717_ID_CLIENTE
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P717_NOMBRE_ENTIDAD
            }
            execution {
                sequence: 10
            }
        )

    )

