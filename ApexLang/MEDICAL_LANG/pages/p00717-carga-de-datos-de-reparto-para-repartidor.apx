    pageItem P717_ID_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NVL(PE.NOMB_FANTASIA, PE.NOMBRE)||' ('||NVL(PE.RUC, TO_CHAR(PE.NRO_CI))||')' D,
                       CL.ID R
                  FROM CCW_CLIENTES CL
                  JOIN BSW_PERSONAS PE ON PE.ID = CL.ID_PERSONA
                 WHERE CL.ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            region: @carga-de-datos-de-reparto-para-repartidor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-datos-de-reparto-para-repartidor
            column: ID_CLIENTE
            dataType: number
            queryOnly: true
        }
    )

