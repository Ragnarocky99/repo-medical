page 499 (
    name: Impresion de Ranking de Ventas
    alias: IMPRESION-DE-RANKING-DE-VENTAS
    title: Impresion de Ranking de Ventas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                  l_proc varchar2(100) := 'show report';
                  l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                  l_parametros varchar2(1000);
                  l_nombre_reporte varchar2(100);
                BEGIN
                  xlog (l_proc, 'url (orig):' || l_report_url);
                
                IF :P422_TIPO_REPORTE='A' THEN
                l_nombre_reporte:='Ranking_Ventas';
                ELSIF :P422_TIPO_REPORTE='C' THEN
                l_nombre_reporte:='Ranking_Ventas_Clientes';
                END IF;
                
                
                
                   l_parametros:=l_parametros||'P_ID_EMPRESA='||:P0_ID_EMPRESA;
                   l_parametros:=l_parametros||'&'||'P_ID_SUCURSAL='||:P422_ID_SUCURSAL;
                   l_parametros:=l_parametros||'&'||'P_ID_CLIENTE='||:P422_ID_CLIENTE;
                   l_parametros:=l_parametros||'&'||'P_ID_RUBRO='||:P422_ID_RUBRO;
                   l_parametros:=l_parametros||'&'||'P_ID_FAMILIA='||:P422_ID_FAMILIA;
                   l_parametros:=l_parametros||'&'||'P_ID_LINEA='||:P422_ID_LINEA;
                   l_parametros:=l_parametros||'&'||'P_ID_CORPORACION='||:P422_ID_CORPORACION;
                   l_parametros:=l_parametros||'&'||'P_ID_VENDEDOR='||:P422_ID_VENDEDOR;
                   l_parametros:=l_parametros||'&'||'P_ID_MARCA='||:P422_ID_MARCA;
                   l_parametros:=l_parametros||'&'||'P_COD_ARTICULO_DES='||:P422_COD_ARTICULO_DES;
                   l_parametros:=l_parametros||'&'||'P_COD_ARTICULO_HAS='||:P422_COD_ARTICULO_HAS;
                   l_parametros:=l_parametros||'&'||'P_USUARIO='||:APP_USER;
                   l_parametros:=l_parametros||'&'||'P_PRIMEROS='||:P422_PRIMEROS;
                   l_parametros:=l_parametros||'&'||'P_TIPO='||NVL(:P422_TIPO,'totales');
                   l_parametros:=l_parametros||'&'||'P_FEC_INICIAL='||TO_DATE(:P422_FEC_INICIAL,'DD/MM/YYYY');
                   l_parametros:=l_parametros||'&'||'P_FEC_FINAL='||TO_DATE(:P422_FEC_FINAL,'DD/MM/YYYY');
                
                
                
                
                   
                
                
                
                
                  xlib_jasperreports.set_report_url(l_report_url);
                  xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode(l_nombre_reporte),
                          p_rep_format          => apex_util.url_encode('pdf'),
                          p_data_source         => apex_util.url_encode('default'),
                          p_out_filename        => apex_util.url_encode(:P3_out_filename),
                          p_rep_locale          => apex_util.url_encode('es_ES'),
                          p_rep_encoding        => apex_util.url_encode('UTF-8'),
                          p_additional_params   => (l_parametros),
                          p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                          p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                          p_print_media         => apex_util.url_encode(:P3_print_media),
                          p_print_copies        => apex_util.url_encode(:P3_print_copies),
                          p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                          p_print_collate       => case when :P3_print_collate='1' then true else false end,
                          p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                          p_save_filename       => apex_util.url_encode(:P3_save_filename),
                          p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                          p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                          );
                  
                  -- this was used before apex 4.1
                  --apex_application.g_unrecoverable_error := true;
                  apex_application.stop_apex_engine();
                
                exception
                  when apex_application.e_stop_apex_engine then
                    null; -- ok, stop engine raises exception, we can ignore that
                  when others then 
                    xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                    raise;
                end;   
                                                     
                ```
        }
    )

)

