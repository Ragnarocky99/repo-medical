page 466 (
    name: Carga de Feriados
    alias: CARGA-DE-FERIADOS
    title: Carga de Feriados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-feriados (
        name: Carga de Feriados
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT F.ID,
                       F.FERIADO,
                       F.DESCRIPCION,
                       F.COD_USUARIO_AUD
                FROM BSW_FERIADOS F
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P466_COD_USUARIO_AUD (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @carga-de-feriados
            slot: regionBody
        }
        source {
            formRegion: @carga-de-feriados
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P466_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripcion:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-feriados
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 7
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-feriados
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P466_FERIADO (
        type: datePicker
        label {
            label: <p>Fecha:</p>
            alignment: left
        }
        settings {
            useDefaults: false
            appearanceBehavior: [
                monthPicker
                yearPicker
            ]
            showOn: iconClick
        }
        layout {
            sequence: 20
            region: @carga-de-feriados
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-feriados
            column: FERIADO
            dataType: date
        }
    )

    pageItem P466_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-feriados
            slot: regionBody
        }
        source {
            formRegion: @carga-de-feriados
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_FERIADOS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button actualizar (
        buttonName: ACTUALIZAR
        label: Actualizar
        layout {
            sequence: 10
            region: @botones
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @botones
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 10
            region: @botones
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    dynamicAction cancel-dialog (
        name: CANCEL_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process feriados-row-processing (
        name: Feriados - Row Processing
        type: formAutoRowProcessing
        formRegion: @carga-de-feriados
        target {
            targetType: tableView
            tableName: BSW_FERIADOS
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 56407466923149439
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,ACTUALIZAR,ELIMINAR
        }
    )

    process initialize-form-carga-de-feriados (
        name: Initialize form Carga de Feriados
        type: formInitialization
        formRegion: @carga-de-feriados
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 56406979559149434
        }
    )

    process limpiar (
        name: LIMPIAR
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 56407928352149444
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,ELIMINAR
        }
    )

)

