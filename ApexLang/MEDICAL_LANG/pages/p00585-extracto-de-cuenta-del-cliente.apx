                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @extracto-de-cuenta-del-cliente
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @ejecutar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @extracto-de-cuenta-del-cliente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 599
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 504
                items: {
                    P504_PERIODO_DESDE: &P585_FEC_DESDE.
                    P504_FEC_FINAL: &P585_FEC_HASTA.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

