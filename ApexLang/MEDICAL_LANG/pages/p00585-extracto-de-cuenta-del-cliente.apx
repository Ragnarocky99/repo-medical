    region extracto-de-cuenta-del-cliente (
        name: Extracto de cuenta del cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    T.ORDEN,
                    T.SUCURSAL,
                    T.FEC_COMPROBANTE,
                    T.TIP_COMPROBANTE,
                    T.SER_COMPROBANTE,
                    T.NRO_COMPROBANTE,
                    T.TIP_COMPROBANTE_REF,
                    T.SER_COMPROBANTE_REF,
                    TO_CHAR(T.NRO_COMPROBANTE_REF) NRO_COMPROBANTE_REF,
                    T.DOC_CLIENTE,
                    T.NOMB_CLIENTE,
                    T.FEC_VENCIMIENTO,
                    DECODE(T.ID_COMPROBANTE, NULL, 0, T.DEBITO) DEBITO,
                    DECODE(T.ID_COMPROBANTE, NULL, 0, T.CREDITO) CREDITO,
                    T.DETALLE,
                    T.MONEDA,
                    T.TIP_CAMBIO,
                    SUM(T.CREDITO - T.DEBITO) OVER (PARTITION BY T.ID_CLIENTE, MONEDA ORDER BY T.ID_CLIENTE, T.FEC_COMPROBANTE, T.ORDEN) SALDO,
                    PREPARA_URL_CARGA(:P0_ID_EMPRESA, T.TIP_COMPROBANTE, T.ID_COMPROBANTE) URL,
                    CASE
                        WHEN T.TIP_COMPROBANTE NOT IN ('REC', 'CAN') THEN
                            NVL((SELECT 'Cobrado'
                                  FROM CCWV_EXTRACTO_CLIENTE EP
                                 WHERE EP.ID_COMPROBANTE_REF = T.ID_COMPROBANTE
                                   AND EP.ID_CLIENTE = T.ID_CLIENTE
                                   AND ROWNUM = 1
                                   AND EP.FEC_COMPROBANTE <= :P585_FEC_HASTA
                                   AND EP.TIP_COMPROBANTE IN ('REC', 'CAN')), 'Pendiente')
                        ELSE
                            NULL
                    END ESTADO
                    --T.ASIENTOS,
                    -- (SELECT ID
                    --   FROM COW_DIARIO_CABECERAS_PROV
                    --  WHERE NUM_ASIENTO = T.ASIENTOS
                    --    AND ID_EJERCICIO = TRAE_ID_EJERCICIO(T.FEC_COMPROBANTE)) ID_ASIENTO
                FROM (  
                    SELECT ROW_NUMBER() OVER (ORDER BY ID_CLIENTE, MONEDA, FEC_COMPROBANTE, ORD) + 1000 ORDEN,
                           ID_EMPRESA,
                           SUCURSAL,
                           FEC_COMPROBANTE,
                           TIP_COMPROBANTE,
                           SER_COMPROBANTE,
                           NRO_COMPROBANTE,
                           TIP_COMPROBANTE_REF,
                           SER_COMPROBANTE_REF,
                           NRO_COMPROBANTE_REF,
                           DOC_CLIENTE,
                           NOMB_CLIENTE,
                           FEC_VENCIMIENTO,
                           DEBITO,
                           CREDITO,
                           DETALLE,
                           MONEDA,
                           TIP_CAMBIO,
                           ID_CLIENTE,
                           ID_COMPROBANTE,
                           COD_CLIENTE
                           --ASIENTOS
                      FROM CCWV_EXTRACTO_CLIENTE
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND FEC_COMPROBANTE BETWEEN :P585_FEC_DESDE AND :P585_FEC_HASTA
                    UNION ALL
                    SELECT ROW_NUMBER() OVER (ORDER BY ID_CLIENTE, MONEDA) ORDEN,
                           ID_EMPRESA,
                           NULL,--SUCURSAL,
                           MAX(FEC_COMPROBANTE),
                           NULL,--TIP_COMPROBANTE,
                           NULL,--SER_COMPROBANTE,
                           NULL,--NRO_COMPROBANTE,
                           NULL,--TIP_COMPROBANTE_REF,
                           NULL,--SER_COMPROBANTE_REF
                           NULL,--NRO_COMPROBANTE_REF
                           DOC_CLIENTE,
                           NOMB_CLIENTE,
                           NULL,--FEC_VENCIMIENTO,
                           SUM(DEBITO),
                           SUM(CREDITO),
                           'SALDO ANTERIOR',--DETALLE,
                           MONEDA,
                           NULL,--TIP_CAMBIO
                           ID_CLIENTE,
                           NULL,--ID
                           COD_CLIENTE
                           --NULL -- ASIENTOS
                      FROM CCWV_EXTRACTO_CLIENTE
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND FEC_COMPROBANTE < :P585_FEC_DESDE
                    GROUP BY ID_EMPRESA, DOC_CLIENTE, NOMB_CLIENTE, MONEDA, ID_CLIENTE, COD_CLIENTE
                    HAVING (SUM(CREDITO) - SUM(DEBITO)) != 0
                ) T
                WHERE T.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (T.COD_CLIENTE = :P585_CLIENTE OR :P585_CLIENTE IS NULL)
                ```
            pageItemsToSubmit: [
                P585_FEC_DESDE
                P585_FEC_HASTA
                P585_CLIENTE
            ]
        }
