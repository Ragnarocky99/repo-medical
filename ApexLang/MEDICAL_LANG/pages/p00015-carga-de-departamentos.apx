page 15 (
    name: Carga de Departamentos
    alias: CARGA-DE-DEPARTAMENTOS
    title: Carga de Departamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-departamentos (
        name: Carga de Departamentos
        type: form
        source {
            location: localDatabase
            tableName: BSW_PROVINCIAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P15_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura:</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-departamentos
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P15_COD_PROVINCIA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Provincia:</a>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-departamentos
            column: COD_PROVINCIA
            dataType: varchar2
        }
    )

    pageItem P15_COD_PROVINCIA_FE (
        type: textField
        label {
            label: <p>Cód. Provincia F.E.:</p>
            alignment: left
        }
        layout {
            sequence: 100
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-departamentos
            column: COD_PROVINCIA_FE
            dataType: varchar2
        }
    )

    pageItem P15_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 80
            region: @carga-de-departamentos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-departamentos
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P15_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-departamentos
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P15_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-departamentos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-departamentos
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P15_ID_PAIS (
        type: selectList
        label {
            label: <p>País:</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-paises
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 50
            region: @carga-de-departamentos
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-departamentos
            column: ID_PAIS
            dataType: number
        }
    )

    pageItem P15_ID_PROV_EQUIFAX (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-departamentos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-departamentos
            column: ID_PROV_EQUIFAX
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P15_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P15_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button pais (
        buttonName: PAIS
        label: Pais
        layout {
            sequence: 60
            region: @carga-de-departamentos
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P15_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pais
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P15_ID_PAIS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p15-cod-provincia (
        itemName: P15_COD_PROVINCIA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_PROVINCIA)),0)+1
                from BSW_PROVINCIAS A
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9363320902332001
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-departamentos (
        name: Initialize form Carga de Departamentos
        type: formInitialization
        formRegion: @carga-de-departamentos
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9362540168332001
        }
    )

    process process-form-carga-de-departamentos (
        name: Process form Carga de Departamentos
        type: formAutoRowProcessing
        formRegion: @carga-de-departamentos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9362992651332001
        }
    )

)

