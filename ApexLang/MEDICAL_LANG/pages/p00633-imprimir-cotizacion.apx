page 633 (
    name: Imprimir Cotizacion
    alias: IMPRIMIR-COTIZACION
    title: Imprimir Cotizacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P633_FORMATO (
        type: textField
        label {
            label: Formato
            alignment: left
        }
        layout {
            sequence: 50
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P633_ID_CLIENTE (
        type: textField
        label {
            label: Id Cliente
            alignment: left
        }
        layout {
            sequence: 40
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P633_ID_PEDIDO (
        type: textField
        label {
            label: Id Pedido
            alignment: left
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          VNOMB_CLIENTE BSW_PERSONAS.NOMB_FANTASIA%TYPE;
                          VNRO_PEDIDO   VTW_PEDIDOS_CABECERA.NRO_COMPROBANTE%TYPE;
                        BEGIN
                          xlog (l_proc, 'url (orig):' || l_report_url);
                          
                          BEGIN
                            SELECT TRANSLATE(REPLACE(REPLACE(PC.NOMB_FANTASIA, ' ', '_'), 'Ñ', 'N'), 'áéíóúÁÉÍÓÚ', 'aeiouAEIOU'), PC.NRO_COMPROBANTE
                              INTO VNOMB_CLIENTE, VNRO_PEDIDO
                              FROM VTW_PEDIDOS_CABECERA PC
                              JOIN CCW_CLIENTES         CL ON CL.ID = PC.ID_CLIENTE
                              JOIN BSW_PERSONAS         PC ON PC.ID = CL.ID_PERSONA
                             WHERE PC.ID = :P633_ID_PEDIDO;
                          END;
                      --  RAISE_APPLICATION_ERROR(-20000,:P633_ID_CLIENTE||'-'||:P633_ID_PEDIDO);
                
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('CPW_COTIZA_ARTICULOS'),
                                  p_rep_format          => apex_util.url_encode(:P633_FORMATO),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(VNOMB_CLIENTE||'_'||VNRO_PEDIDO||'.'||:P633_FORMATO/*:P3_out_filename*/),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                  p_additional_params   => ('P_COTIZACION='||:P633_ID_PEDIDO||
                                                           '&'||'P_CLIENTE='||:P633_ID_CLIENTE),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          
                          -- this was used before apex 4.1
                          --apex_application.g_unrecoverable_error := true;
                          apex_application.stop_apex_engine();
                
                        exception
                          when apex_application.e_stop_apex_engine then
                            null; -- ok, stop engine raises exception, we can ignore that
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
    )

)

