    dynamicAction agregar-paginacion (
        name: Agregar Paginacion
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total número de filas:
                titleOfFirstPage: Primera página
                titleOfLastPage: Última página
            }
            affectedElements {
                selectionType: region
                region: @libro-diario-definitivo
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction redirigir-pagina-impresion (
        name: Redirigir pagina impresion
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 852
                    items: {
                        P852_IND_IMPRIMIR: S
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: [
                    P852_FEC_INI
                    P852_FEC_FIN
                    P852_NUM_ASIENTO_INI
                    P852_NUM_ASIENTO_FIN
                    P852_NUM_PAGINA_INI
                    P852_IND_IMPRIMIR
                ]
                openTargetInNewWindow: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

