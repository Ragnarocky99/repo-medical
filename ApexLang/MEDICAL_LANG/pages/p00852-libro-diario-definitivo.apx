        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region empresa (
        name: Empresa
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID,
                       SELLO_RUBRICADO
                  FROM BSW_EMPRESAS
                WHERE ID = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region libro-diario-definitivo (
        name: Libro Diario Definitivo
        type: interactiveReport
        source {
            location: localDatabase
            tableName: COWV_LIBRO_DIARIO_DEFINITIVO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                COD_EJERCICIO = :P0_COD_EJERCICIO AND
                (FEC_ASIENTO BETWEEN :P852_FEC_INI AND :P852_FEC_FIN) AND
                (NUM_ASIENTO BETWEEN :P852_NUM_ASIENTO_INI AND :P852_NUM_ASIENTO_FIN OR :P852_NUM_ASIENTO_INI IS NULL OR :P852_NUM_ASIENTO_FIN IS NULL)
                ```
            pageItemsToSubmit: [
                P852_FEC_INI
                P852_FEC_FIN
                P852_NUM_ASIENTO_INI
                P852_NUM_ASIENTO_FIN
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 361396951377952928
        }

