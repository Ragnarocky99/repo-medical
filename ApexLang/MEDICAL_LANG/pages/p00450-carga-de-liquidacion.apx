    dynamicAction convertit-fec (
        name: CONVERTIT_FEC
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P450_FEC_PAGO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P450_FEC_PAGO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P450_FEC_PAGO,'/','');
                            conv_fecha := substr(:P450_FEC_PAGO,1,2)||'/'||
                                                      substr(:P450_FEC_PAGO,3,2)||'/'||
                                                      lpad(substr(:P450_FEC_PAGO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P450_FEC_PAGO := conv_fecha;
                            ELSIF (length(:P450_FEC_PAGO) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P450_FEC_PAGO) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P450_FEC_PAGO
                itemsToReturn: P450_FEC_PAGO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p450-nro-liquid (
        itemName: P450_NRO_LIQUID
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: "SELECT NVL(MAX(TO_NUMBER(NRO_LIQUID)), 0) + 1 FROM RHW_LIQUIDACIONES;  "
        }
        serverSideCondition {
            type: itemIsNull
            item: P450_ID
        }
    )

