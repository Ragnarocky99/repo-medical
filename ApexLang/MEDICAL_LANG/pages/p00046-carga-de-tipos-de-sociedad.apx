            location: localDatabase
            tableName: BSW_TIPOS_SOCIEDAD
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 1
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P46_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-tipos-de-sociedad
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-sociedad
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P46_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-tipos-de-sociedad
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-tipos-de-sociedad
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P46_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipos-de-sociedad
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-sociedad
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_TIPOS_SOCIEDAD_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
