page 452 (
    name: Facturas contado emitidas no cobradas
    alias: FACTURAS-CONTADO-EMITIDAS-NO-COBRADAS
    title: Facturas contado emitidas no cobradas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.Tip_Comprobante,
                c.ser_comprobante,
                c.nro_comprobante,
                c.fec_comprobante,
                c.id_vendedor,
                c.id_lista_precio,
                c.tot_comprobante,
                c.id_mov_caj,
                c.nom_cliente
                
                FROM VTW_COMPROBANTES_CABECERA C 
                WHERE C.ID_MOV_CAJ IS NULL 
                AND C.ID_EMPRESA = :P0_ID_EMPRESA
                  AND C.FEC_COMPROBANTE  >=  :P452_FEC_INICIAL
                  AND C.FEC_COMPROBANTE  <=  :P452_FEC_FINAL
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 8984646605244705
        }

        column FEC_COMPROBANTE (
            type: plainText
            heading {
                heading: Fec Comprobante
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID_LISTA_PRECIO (
            type: plainTextBasedOnLov
            heading {
                heading: Lista Precio
                alignment: center
            }
            lov {
                lov: @vtw-listas-precios-cab-cod-lista-precio
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_MOV_CAJ (
            type: plainText
            heading {
                heading: Movimiento Caja
                alignment: center
            }
            layout {
                sequence: 210
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: U
            }
        )

        column ID_VENDEDOR (
            type: plainTextBasedOnLov
            heading {
                heading: Vendedor
                alignment: center
            }
            lov {
                lov: @lv-vendedores
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column NOM_CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 300
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro Comprobante
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column SER_COMPROBANTE (
            type: plainText
            heading {
                heading: Ser Comprobante
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TIP_COMPROBANTE (
            type: plainText
            heading {
                heading: Tip Comprobante
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column TOT_COMPROBANTE (
            type: plainText
            heading {
                heading: Total Comprobante
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: New
        }

        savedReport 93186 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FEC_COMPROBANTE (
                sequence: 4
            )

            displayColumn ID_LISTA_PRECIO (
                sequence: 6
            )

            displayColumn ID_MOV_CAJ (
                sequence: 8
            )

            displayColumn ID_VENDEDOR (
                sequence: 5
            )

            displayColumn NOM_CLIENTE (
                sequence: 9
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 3
            )

            displayColumn SER_COMPROBANTE (
                sequence: 2
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 1
            )

            displayColumn TOT_COMPROBANTE (
                sequence: 7
            )

        )

    )

    pageItem P452_FEC_FINAL (
        type: datePicker
        label {
            label: <p>Fecha Final: </p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem P452_FEC_INICIAL (
        type: datePicker
        label {
            label: <p>Fecha Inicial: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    pageItem P452_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal: </p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION||'('||COD_SUCURSAL||')',ID FROM 
                BSW_SUCURSALES
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                ```
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button ejecutar (
        buttonName: Ejecutar
        label: Ejecutar
        layout {
            sequence: 50
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-consultar
        }
    )

    button imprimir (
        buttonName: Imprimir
        label: Imprimir
        layout {
            sequence: 40
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P452_FEC_INICIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P452_FEC_INICIAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P452_FEC_INICIAL,'/','');
                            conv_fecha := substr(:P452_FEC_INICIAL,1,2)||'/'||
                                                      substr(:P452_FEC_INICIAL,3,2)||'/'||
                                                      lpad(substr(:P452_FEC_INICIAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P452_FEC_INICIAL := conv_fecha;
                            ELSIF (length(:P452_FEC_INICIAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P452_FEC_INICIAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P452_FEC_INICIAL
                itemsToReturn: P452_FEC_FINAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha-final (
        name: CONVERT_FECHA_FINAL
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P452_FEC_FINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P452_FEC_FINAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P452_FEC_FINAL,'/','');
                            conv_fecha := substr(:P452_FEC_FINAL,1,2)||'/'||
                                                      substr(:P452_FEC_FINAL,3,2)||'/'||
                                                      lpad(substr(:P452_FEC_FINAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P452_FEC_FINAL := conv_fecha;
                            ELSIF (length(:P452_FEC_FINAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P452_FEC_FINAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P452_FEC_FINAL
                itemsToReturn: P452_FEC_FINAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: go to page 456
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 456
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

