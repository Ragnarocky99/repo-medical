page 88 (
    name: Carga de IVA
    alias: CARGA-DE-IVA
    title: Carga de IVA
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-iva (
        name: Carga de IVA
        type: form
        source {
            location: localDatabase
            tableName: STW_IVA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P88_COD_IVA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Código:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @carga-de-iva
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-iva
            column: COD_IVA
            dataType: varchar2
        }
    )

    pageItem P88_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 140
            region: @carga-de-iva
            slot: regionBody
        }
        source {
            formRegion: @carga-de-iva
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P88_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-iva
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-iva
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P88_FEC_VIGENCIA (
        type: datePicker
        label {
            label: <p>Fecha Vigencia:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 120
            region: @carga-de-iva
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-iva
            column: FEC_VIGENCIA
            dataType: date
        }
    )

    pageItem P88_ID (
        type: hidden
        layout {
            sequence: 130
            region: @carga-de-iva
            slot: regionBody
        }
        source {
            formRegion: @carga-de-iva
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: STW_IVA_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P88_ID_CUENTA_COMPRA (
        type: popupLov
        label {
            label: <p>Cuenta Compra:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @cow-plan-cuentas-cod-cuenta
        }
        layout {
            sequence: 70
            region: @carga-de-iva
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-iva
            column: ID_CUENTA_COMPRA
            dataType: number
        }
    )

    pageItem P88_ID_CUENTA_VENTA (
        type: popupLov
        label {
            label: <p>Cuenta Venta:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @cow-plan-cuentas-cod-cuenta
        }
        layout {
            sequence: 100
            region: @carga-de-iva
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-iva
            column: ID_CUENTA_VENTA
            dataType: number
        }
    )

    pageItem P88_PORC_GRAVADA (
        type: hidden
        layout {
            sequence: 150
            region: @carga-de-iva
            slot: regionBody
        }
        source {
            formRegion: @carga-de-iva
            column: PORC_GRAVADA
            dataType: number
        }
    )

    pageItem P88_PORC_IVA_COMPRA (
        type: numberField
        label {
            label: <p>IVA Compra:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @carga-de-iva
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-iva
            column: PORC_IVA_COMPRA
            dataType: number
        }
    )

    pageItem P88_PORC_IVA_VENTA (
        type: numberField
        label {
            label: <p>IVA Venta:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @carga-de-iva
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-iva
            column: PORC_IVA_VENTA
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P88_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button cuentas (
        buttonName: CUENTAS
        label: Cuentas
        layout {
            sequence: 80
            region: @carga-de-iva
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 60
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cuentas-2 (
        buttonName: CUENTAS_1
        label: Cuentas
        layout {
            sequence: 110
            region: @carga-de-iva
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 60
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P88_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P88_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @cuentas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P88_ID_CUENTA_COMPRA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @cuentas-2
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P88_ID_CUENTA_VENTA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11205949899088790
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-stwivaf (
        name: Initialize form STWIVAF
        type: formInitialization
        formRegion: @carga-de-iva
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11205150526088789
        }
    )

    process process-form-stwivaf (
        name: Process form STWIVAF
        type: formAutoRowProcessing
        formRegion: @carga-de-iva
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11205580239088790
        }
    )

)

