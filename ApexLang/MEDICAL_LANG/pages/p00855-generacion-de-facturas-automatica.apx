    region pedidos-autorizado (
        name: Pedidos Autorizado
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT FC.SUCURSAL,
                       TRUNC(FC.FEC_COMPROBANTE) FEC_COMPROBANTE,
                       FC.TIP_COMPROBANTE,
                       FC.SER_COMPROBANTE,
                       FC.NRO_COMPROBANTE,
                       FC.NRO_OCC,
                       FC.CLIENTE,
                       'S' IND_SELECCION
                  FROM VTWV_FACTURAR_COTIZACIONES FC
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                   AND ID_SUCURSAL = :P0_ID_SUCURSAL
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 100339852782154221
        }

