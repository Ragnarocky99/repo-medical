            region: @datos-facturacion
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            cssClasses: comprobante
            warnOnUnsavedChanges: ignore
        }
    )

    button facturar-seleccion (
        buttonName: FACTURAR_SELECCION
        label: Facturar Seleccion
        layout {
            sequence: 20
            region: @datos-facturacion
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-dynamic-content
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button talonario (
        buttonName: Talonario
        label: Talonario
        layout {
            sequence: 10
            region: @datos-facturacion
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--simple
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-number-0-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @talonario
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P855_LV_TALONARIOS_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-en-coleccion (
        name: Cargar datos en coleccion
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR PEDIDOS IS
                          SELECT DISTINCT FC.NRO_OCC
                      FROM VTWV_FACTURAR_COTIZACIONES FC
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND ID_SUCURSAL = :P0_ID_SUCURSAL;
                    BEGIN
                        APEX_COLLECTION.create_or_truncate_collection('PED_SELECCION');
                    
                        FOR P IN PEDIDOS
                        LOOP
                            APEX_COLLECTION.add_member(
                                p_collection_name => 'PED_SELECCION',
                                p_c001            => P.NRO_OCC
                            );
                        END LOOP;
                    END;
                    ```
                itemsToSubmit: P855_ID_PEDIDO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultar-items (
        name: Ocultar items
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P855_LV_TALONARIOS
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validar-talonario (
        name: Validar Talonario
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P855_SER_COMPROBANTE
        }
        error {
            errorMessage: Debe seleccionar un talonario
            associatedItem: @P855_LV_TALONARIOS
        }
    )

    process actualizar-coleccion (
        name: Actualizar Coleccion
        type: executeCode
        editableRegion: @pedidos-autorizado
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSEQ_ID NUMBER;
                BEGIN
                    BEGIN
                        SELECT SEQ_ID
                          INTO VSEQ_ID
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'PED_SELECCION'
                           AND C001 = :NRO_OCC;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VSEQ_ID := NULL;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    
                    IF :IND_SELECCION = 'N' THEN
                        --RAISE_APPLICATION_ERROR(-20000, 'Hola');
                        APEX_COLLECTION.DELETE_MEMBER(P_COLLECTION_NAME => 'PED_SELECCION',
                                                      P_SEQ             => VSEQ_ID);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 101689648548309032
        }
        serverSideCondition {
            whenButtonPressed: @facturar-seleccion
            executionScope: allSubmittedRows
        }
    )

    process facturar (
        name: Facturar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    FOR F IN (
                        SELECT C001 NRO_OCC
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'PED_SELECCION'
                    )
                    LOOP
                        vtwk_genera_factura.procesar_unica_occ(in_id_empresa => :P0_ID_EMPRESA,
                                                         in_id_sucursal => :P0_ID_SUCURSAL,
                                                         in_id_serie => :P855_LV_TALONARIOS,
                                                         in_nro_occ => F.NRO_OCC,
                                                         out_mensaje => :P855_MENSAJE,
                                                         out_id_comprobante => :P855_ID_COMPROBANTE);
                    END LOOP;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 100340862189154231
        }
        serverSideCondition {
            whenButtonPressed: @facturar-seleccion
        }
    )

)

