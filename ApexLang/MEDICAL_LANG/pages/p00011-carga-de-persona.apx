        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 declare
                 l_filename varchar2(100);
                 l_mimetype varchar2(100);
                 begin
                  SELECT filename,mime_type
                   into  l_filename,l_mimetype
                                   FROM apex_application_temp_files
                                  WHERE name = :P11_IMAGEN;
                
                :P11_MIMETYPE:=l_mimetype;
                :P11_FILENAME:=L_FILENAME;
                 end;
                
