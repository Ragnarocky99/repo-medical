page 11 (
    name: Carga de Persona
    alias: CARGA-DE-PERSONA
    title: Carga de Persona
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .imagen{
                width: 120px;
                height: 100px;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-persona (
        name: Carga de Persona
        type: form
        source {
            location: localDatabase
            tableName: BSW_PERSONAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region direccion (
        name: Direccion
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @carga-de-persona
            slot: subRegions
            columnSpan: 12
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-md
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region direcciones (
        name: Direcciones
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @carga-de-persona
            slot: subRegions
            columnSpan: 12
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-md
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

