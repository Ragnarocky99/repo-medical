    pageItem P11_ID_BARRIO (
        type: selectList
        label {
            label: <p>Barrio</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION||'('||COD_BARRIO||')',ID FROM BSW_BARRIOS WHERE
                ID_PAIS=:P11_ID_PAIS AND ID_PROVINCIA=:P11_ID_DEPARTAMENTO AND ID_CIUDAD=:P11_ID_CIUDAD
                ```
            nullDisplayValue: --Sin Seleccionar--
        }
        cascadingLov {
