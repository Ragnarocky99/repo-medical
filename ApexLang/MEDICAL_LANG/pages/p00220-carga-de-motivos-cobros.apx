page 220 (
    name: Carga de Motivos Cobros
    alias: CARGA-DE-MOTIVOS-COBROS
    title: Carga de Motivos Cobros
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .mostrar{
                background-color:#eeeeee;
                width: 171px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-motivos-cobros (
        name: Carga de Motivos Cobros
        type: form
        source {
            location: localDatabase
            tableName: CCW_MOTIVOS_COBROS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P220_COD_MOTIVO (
        type: displayOnly
        label {
            label: <p>Cód. Motivo:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-motivos-cobros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-motivos-cobros
            column: COD_MOTIVO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT MAX(TO_NUMBER(A.COD_MOTIVO))+1
                from CCW_MOTIVOS_COBROS A
                ```
        }
    )

    pageItem P220_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-motivos-cobros
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-cobros
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P220_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @carga-de-motivos-cobros
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @carga-de-motivos-cobros
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P220_ES_COBRO (
        type: switch
        label {
            label: <p>Es Cobro:</p>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: SI
            offValue: N
            offLabel: NO
        }
        layout {
            sequence: 40
            region: @carga-de-motivos-cobros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-motivos-cobros
            column: ES_COBRO
            dataType: varchar2
        }
    )

    pageItem P220_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-motivos-cobros
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-cobros
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: CCW_MOTIVOS_COBROS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P220_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P220_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P220_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 27781114480452103
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-motivos-cobros (
        name: Initialize form Carga de Motivos Cobros
        type: formInitialization
        formRegion: @carga-de-motivos-cobros
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27780304557452103
        }
    )

    process process-form-carga-de-motivos-cobros (
        name: Process form Carga de Motivos Cobros
        type: formAutoRowProcessing
        formRegion: @carga-de-motivos-cobros
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 27780790107452103
        }
    )

)

