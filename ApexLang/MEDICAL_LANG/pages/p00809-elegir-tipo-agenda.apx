page 809 (
    name: Elegir Tipo Agenda
    alias: ELEGIR-TIPO-AGENDA
    title: Elegir Tipo Agenda
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tipos (
        name: Tipos
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    pageItem P809_FECHA (
        type: hidden
        layout {
            sequence: 30
            region: @tipos
            slot: regionBody
        }
    )

    button agenda-crm (
        buttonName: AGENDA_CRM
        label: Agenda
        layout {
            sequence: 10
            region: @tipos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 750
                items: {
                    P750_FECHA: &P809_FECHA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button gestor (
        buttonName: GESTOR
        label: Gestor
        layout {
            sequence: 20
            region: @tipos
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
                t-Button--padLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 808
                items: {
                    P808_FEC_TOPE: &P809_FECHA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

