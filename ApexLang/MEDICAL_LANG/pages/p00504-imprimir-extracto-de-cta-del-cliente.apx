page 504 (
    name: Imprimir Extracto de Cta del Cliente
    alias: IMPRIMIR-EXTRACTO-DE-CTA-DEL-CLIENTE
    title: Imprimir Extracto de Cta del Cliente
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region variables-reportes (
        name: variables-reportes
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P504_FEC_FINAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @variables-reportes
            slot: regionBody
        }
    )

    pageItem P504_ID_CLI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @variables-reportes
            slot: regionBody
        }
    )

    pageItem P504_ID_SUCURSAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @variables-reportes
            slot: regionBody
        }
    )

    pageItem P504_NOMB_CLI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @variables-reportes
            slot: regionBody
        }
    )

    pageItem P504_NOM_EMPRESA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @variables-reportes
            slot: regionBody
        }
    )

    pageItem P504_PERIODO_DESDE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @variables-reportes
            slot: regionBody
        }
    )

    pageItem P504_TIP_CLIENTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @variables-reportes
            slot: regionBody
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 20
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          v_nom_empresa varchar2(150);
                        BEGIN
                          SELECT E.DESCRIPCION INTO v_nom_empresa FROM BSW_EMPRESAS E WHERE E.ID = :P0_ID_EMPRESA;
                          xlog (l_proc, 'url (orig):' || l_report_url);
                          
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('ExtractoCliente'),
                                  p_rep_format          => apex_util.url_encode('pdf'),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                  p_additional_params   => ('p_nomb_cli='||:P504_NOMB_CLI||'&'||'p_periodo_desde='||NULL||'&'||'p_fec_final='||SYSDATE||'&'||'p_nom_empresa='||v_nom_empresa||'&'||'p_id_empresa='||:P0_ID_EMPRESA||'&'||'p_usuario='||:APP_USER||'&'||'p_id_cliente='||:P504_ID_CLI||'&'||'p_tip_cliente='||:P504_TIP_CLIENTE||'&'||'p_id_sucursal='||:P504_ID_SUCURSAL),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          apex_application.stop_apex_engine();
                
                        exception
                          when apex_application.e_stop_apex_engine then
                            null; -- ok, stop engine raises exception, we can ignore that
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
    )

)

