    region detalles-articulos-enviados (
        name: Detalles Articulos Enviados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NRO_LICITACION,
                       NRO_ID_LICITACION,
                       CLIENTE,
                       NRO_ITEM,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       MARCA,
                       PROVEEDOR,
                       PLAZO_ENTREGA,
                       CONDICION_COMPRA,
                       ID_MONEDA_COSTO,
                       TIP_CAMBIO_COSTO,
                       COSTO_TOTAL_RECARGO,
                       PORC_MARGEN,
                       MARGEN_TOTAL,
                       PRECIO_TOTAL,
                       ID_LICITACION_CAB
                  FROM LCWV_RESUMEN_COTIZA_OFERTA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
        masterDetail {
            masterRegion: @licitaciones
        }
        advanced {
            htmlDomId: Detalles
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 47851737614185412
        }

