    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P787_ID_CLIENTE
                P787_NRO_LICITACION
                P787_NRO_ID_LICITACION
                P787_IND_APROBADO
                P787_IND_NO_APROBADO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @licitaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-region (
        name: Refrescar region
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @licitaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process licitaciones-save-interactive-grid-data (
        name: Licitaciones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @licitaciones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 47797870501873710
        }
    )

)

