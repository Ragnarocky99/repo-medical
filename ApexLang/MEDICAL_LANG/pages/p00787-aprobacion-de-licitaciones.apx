        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Licitaciones
        }
    )

    pageItem P787_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P787_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    pageItem P787_ID_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
            popupHeight: 500
        }
        lov {
