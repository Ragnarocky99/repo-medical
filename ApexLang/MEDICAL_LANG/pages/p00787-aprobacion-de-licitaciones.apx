    region licitaciones (
        name: Licitaciones
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: LCW_LICITACIONES_CAB
            whereClause:
                ```sql
                ID IN (SELECT ID_LICITACION_CAB FROM LCWV_RESUMEN_COTIZA_OFERTA) AND
                FEC_LICITACION BETWEEN :P787_FEC_INI AND :P787_FEC_FIN AND
                (NRO_LICITACION = :P787_NRO_LICITACION OR :P787_NRO_LICITACION IS NULL) AND
                (NRO_ID_LICITACION = :P787_NRO_ID_LICITACION OR :P787_NRO_ID_LICITACION IS NULL) AND
                (ID_CLIENTE = :P787_ID_CLIENTE OR :P787_ID_CLIENTE IS NULL) AND
                (IND_APROBADO = :P787_IND_APROBADO OR :P787_IND_APROBADO IS NULL) AND
                (NVL(IND_NO_APROBADO, 'N') = :P787_IND_NO_APROBADO OR :P787_IND_NO_APROBADO IS NULL)
                ```
            orderByClause: NRO_LICITACION DESC
            pageItemsToSubmit: [
                P787_FEC_INI
                P787_FEC_FIN
                P787_ID_CLIENTE
                P787_NRO_LICITACION
                P787_NRO_ID_LICITACION
                P787_IND_APROBADO
                P787_IND_NO_APROBADO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 47576136629108132
        }

