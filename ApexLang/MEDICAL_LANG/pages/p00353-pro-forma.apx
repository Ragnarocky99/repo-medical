page 353 (
    name: Pro Forma
    alias: PRO-FORMA
    title: ProForma
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pro-forma (
        name: Pro Forma
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.ID,
                       P.ID_EMPRESA,
                       P.TIP_COMPROBANTE,
                       P.SER_COMPROBANTE,
                       P.NRO_COMPROBANTE,
                       P.ID_SUCURSAL,
                       P.FEC_COMPROBANTE,
                       P.ID_PROVEEDOR,
                       P.ID_CONDICION_COMPRA,
                       P.TOT_COMPROBANTE,
                       P.TOT_GRAVADAS,
                       P.TOT_EXENTAS,
                       P.TOT_IVA,
                       P.DESCUENTO,
                       P.ID_MONEDA,
                       P.TIP_CAMBIO,
                       P.VERIFICADORA,
                       P.TRANSPORTE,
                       P.ID_VIA,
                       P.FEC_EMBARQUE,
                       P.FEC_CONFIRMACION,
                       P.ESTADO,
                       P.FEC_ESTADO,
                       P.ID_USUARIO,
                       P.FEC_ALTA,
                       P.ANULADO,
                       P.CAMBIO_MONEDA_PRECIO,
                       P.TIP_COMPROBANTE_REF,
                       P.SER_COMPROBANTE_REF,
                       P.NRO_COMPROBANTE_REF,
                      P.REFERENCIA,
                       P.VIGENTE,
                       P.ID_PROVEEDOR_REF,
                       P.NRO_FACT_EXP,
                       P.COD_USUARIO_AUD,
                       P.ID_CLIENTE,
                       P.ID_SUCURSAL_CENTRAL,
                       P.PLAZO_PAGO,
                       P.FORMA_PAGO,
                          CASE P.ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       ICONO_ANULADO       
                  from CMW_PROFORMAS_CABECERA P
                 where ID_EMPRESA=:P0_ID_EMPRESA
                 ORDER BY NRO_COMPROBANTE DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 330
                items: {
                    P330_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16660449435781043
        }

        column ANULADO (
            type: plainText
            heading {
                heading: Anulado
            }
            layout {
                sequence: 26
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ICONO_ANULADO#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

