    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexbeforepagesubmit
        }
        config {
            buildOption: @comentado
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var id_mov_caj;
                    
                    id_mov_caj = $v("P159_ID");
                    var model = apex.region("igemp").widget().interactiveGrid("getViews", "grid").model;
                    model.forEach(function(igrow) {
                         model.setValue(igrow, 'ID_MOV_CAJ', id_mov_caj);
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p159-nro-mov-caj (
        itemName: P159_NRO_MOV_CAJ
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT 
                    CASE WHEN MAX(TO_CHAR(NRO_MOV_CAJ)) IS NULL THEN 1 ELSE MAX(TO_CHAR(NRO_MOV_CAJ)+1) END
                FROM CCW_MOVIMIENTOS_CAJAS
                ```
        }
        comments {
            comments: https://stackoverflow.com/questions/14962970/sql-query-if-value-is-null-then-return-1
        }
    )

