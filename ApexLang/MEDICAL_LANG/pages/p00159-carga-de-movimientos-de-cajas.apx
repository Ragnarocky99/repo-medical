    region movimiento-de-comprobantes (
        name: Movimiento de Comprobantes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MC.ID,
                       MC.ID_EMPRESA,
                       MC.ID_MOV_CAJ,
                       MC.ID_COMPROBANTE,
                       MC.ID_MONEDA,
                       MC.TIP_CAMBIO,
                       MC.TOT_COMPROBANTE,
                       MC.COD_USUARIO_AUD,
                       MC.ID_RECIBO,
                       MC.TIP_COMPROBANTE,
                       MC.IMPORTECAMBIO,
                       MC.ESCOMPROBANTE,
                       MC.ID_NOTAS_DEBCRED,
                       MC.IND_TIPO,
                       MC.FECHA_COMPROBANTE,
                       MC.FECHA_COBRO,
                       MC.ID_CLIENTE,
                       MC.ID_SALDOS
                  from CCW_MOVIMIENTOS_COMP MC
                 where ID_MOV_CAJ = :P159_ID
                
                
                ```
            pageItemsToSubmit: P159_ID
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-lg
            ]
        }
        advanced {
            htmlDomId: igemp
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
