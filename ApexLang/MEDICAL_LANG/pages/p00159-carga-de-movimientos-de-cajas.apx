    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 158
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P159_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: t-Button--danger
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P159_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P159_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button volver (
        buttonName: Volver
        label: Volver
        layout {
            sequence: 10
            region: @carga-de-movimientos-de-cajas-2
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo-arrow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 158
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostar-detalle (
        name: Mostar Detalle
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P159_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P159_ID
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @movimiento-de-comprobantes
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P159_ID_CLIENTE_N
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
