    dynamicAction insertar-detalle (
        name: Insertar Detalle
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P500_JSON_COMISION
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT NVL(SUM(MONTO), 0)
                    INTO :P500_TOTAL 
                    FROM FVW_TMP_COMISION_VENTA
                    WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    and DIRECCION_IP = :P500_DIRECCION_IP;
                    
                    :P500_JSON_COMISION:=NULL;
                    DELETE FVW_TMP_COMISION_VENTA
                    where DIRECCION_IP = :P500_DIRECCION_IP;
                    COMMIT;
                    
                    ```
                itemsToSubmit: P500_DIRECCION_IP
                itemsToReturn: [
                    P500_JSON_COMISION
                    P500_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var json_detalle = JSON.parse($v('P500_JSON_COMISION'));
                    console.log(json_detalle);
                    
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    var total=0;
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                        try {
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    //total=total+json_detalle.DETALLE[i].MONTO;
                    
                    if((json_detalle.DETALLE[i].ID_EMPRESA!=null)){
                        $model.setValue($newRecord, "ID_EMPRESA",(json_detalle.DETALLE[i].ID_EMPRESA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_CLIENTE!=null)){
                        $model.setValue($newRecord, "ID_CLIENTE",(json_detalle.DETALLE[i].ID_CLIENTE).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_VENDEDOR!=null)){
                        $model.setValue($newRecord, "ID_VENDEDOR",(json_detalle.DETALLE[i].ID_VENDEDOR).toString());
                    }
                    if((json_detalle.DETALLE[i].VISITA_PERIODO!=null)){
                        $model.setValue($newRecord, "VISITA_PERIODO",(json_detalle.DETALLE[i].VISITA_PERIODO).toString());
                    }
                    if((json_detalle.DETALLE[i].VISITA_REALIZADA!=null)){
                        $model.setValue($newRecord, "VISITA_REALIZADA",(json_detalle.DETALLE[i].VISITA_REALIZADA).toString());
                    
                    }
                    if((json_detalle.DETALLE[i].VISITA_CANTIDAD!=null)){
                        $model.setValue($newRecord, "VISITA_CANTIDAD",(json_detalle.DETALLE[i].VISITA_CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].TIP_COMPROBANTE!=null)){
                        $model.setValue($newRecord, "TIP_COMPROBANTE",(json_detalle.DETALLE[i].TIP_COMPROBANTE).toString());
                    }
                    if((json_detalle.DETALLE[i].NRO_COMPROBANTE!=null)){
                        $model.setValue($newRecord, "NRO_COMPROBANTE",(json_detalle.DETALLE[i].NRO_COMPROBANTE).toString());
                    }
                    if((json_detalle.DETALLE[i].SER_COMPROBANTE!=null)){
                        $model.setValue($newRecord, "SER_COMPROBANTE",(json_detalle.DETALLE[i].SER_COMPROBANTE).toString());
                    }
                    if((json_detalle.DETALLE[i].FEC_COMPROBANTE!=null)){
                        $model.setValue($newRecord, "FEC_COMPROBANTE",(json_detalle.DETALLE[i].FEC_COMPROBANTE));
                    }
                    if((json_detalle.DETALLE[i].FEC_VENCIMIENTO!=null)){
                        $model.setValue($newRecord, "FEC_VENCIMIENTO",(json_detalle.DETALLE[i].FEC_VENCIMIENTO));
                    }
                    if((json_detalle.DETALLE[i].FEC_MOV_CAJ!=null)){
                        $model.setValue($newRecord, "FEC_MOV_CAJ",(json_detalle.DETALLE[i].FEC_MOV_CAJ));
                    }
                    if((json_detalle.DETALLE[i].MONTO_BASE!=null)){
                        $model.setValue($newRecord, "MONTO_BASE",(json_detalle.DETALLE[i].MONTO_BASE).toString());
                    }
                    if((json_detalle.DETALLE[i].NRO_RECIBO!=null)){
                        $model.setValue($newRecord, "NRO_RECIBO",(json_detalle.DETALLE[i].NRO_RECIBO).toString());
                    }
                    if((json_detalle.DETALLE[i].ATRASO_EMISION!=null)){
                        $model.setValue($newRecord, "ATRASO_EMISION",(json_detalle.DETALLE[i].ATRASO_EMISION).toString());
                    }
                    if((json_detalle.DETALLE[i].NRO_MOV_CAJ!=null)){
                        $model.setValue($newRecord, "NRO_MOV_CAJ",(json_detalle.DETALLE[i].NRO_MOV_CAJ).toString());
                    }
                    if((json_detalle.DETALLE[i].PORC_COMISION!=null)){
                        $model.setValue($newRecord, "PORC_COMISION",(json_detalle.DETALLE[i].PORC_COMISION).toString().replace('.',','));
                    }
                    if((json_detalle.DETALLE[i].MONTO!=null)){
                        $model.setValue($newRecord, "MONTO",(json_detalle.DETALLE[i].MONTO).toString());
                    }
                    
                     $model.setValue($newRecord, "ID_COMPROBANTE_VT",(json_detalle.DETALLE[i].ID_COMPROBANTE_VT).toString());
                     
                    if((json_detalle.DETALLE[i].ID_SUCURSAL!=null)){
                        $model.setValue($newRecord, "ID_SUCURSAL",(json_detalle.DETALLE[i].ID_SUCURSAL).toString());
                    }
                    if((json_detalle.DETALLE[i].NRO_PERIODO!=null)){
                        $model.setValue($newRecord, "NRO_PERIODO",(json_detalle.DETALLE[i].NRO_PERIODO).toString());
                    }
                        }catch(e){
                            console.log(e)
                        }
                    }
                    
                    //calculaTotales();
                    
                    }
                    ```
            }
            affectedElements {
                selectionType: items
                items: P500_JSON_COMISION
            }
            execution {
                sequence: 10
            }
        )

    )

