    process borrar (
        name: Borrar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                      delete fvw_comisiones_ventas
                       where  id_empresa = :P0_ID_empresa
                         and  nro_periodo = :P500_periodo
                         and (ID_vendedor = :P500_ID_vendedor or :P500_ID_vendedor is null);
                    EXCEPTION
                      when others then
                        RAISE_APPLICATION_ERROR(-20000, 'No se pudieron borrar las comisiones para el periodo '||sqlerrm);
                    END;
                    commit;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 66785427209440949
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process carga-de-calculo-de-comisiones-save-interactive-grid-data (
        name: Carga de Calculo de Comisiones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @carga-de-calculo-de-comisiones
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 68880419154763010
        }
    )

    process procesar (
        name: PROCESAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                	VEXISTE    VARCHAR2(5);
                BEGIN
                BEGIN
                	SELECT 'S'
                	  INTO VEXISTE
                	  FROM FVW_COMISIONES_VENTAS C
                	 WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                	   AND C.NRO_PERIODO = :P500_PERIODO
                	   AND C.ID_VENDEDOR = :P500_ID_VENDEDOR
                	   AND ROWNUM = '1'
                	 ;
                EXCEPTION
                	WHEN OTHERS THEN
                	  VEXISTE := 'N';
                END;
                
                IF VEXISTE = 'S' THEN
                	RAISE_APPLICATION_ERROR(-20000, 'La comision para el vendedor en este periodo ya fue generada!!!');
                ELSE
                	procesa_comisiones(:P500_ID_VENDEDOR, :P500_FEC_INICIAL, :P500_FEC_FINAL, :P500_PERIODO, :P0_ID_EMPRESA, :P500_DIRECCION_IP);
                  commit;
                  
                END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 66783788182440932
        }
        serverSideCondition {
            whenButtonPressed: @procesar
        }
    )

    process procesar-json (
        name: PROCESAR_JSON
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                  l_cursor SYS_REFCURSOR;
                  json_detalle CLOB;
                
                BEGIN
                    OPEN l_cursor FOR
                    SELECT  ID_EMPRESA,
                            ID_CLIENTE,
                            ID_VENDEDOR,
                            VISITA_PERIODO,
                            VISITA_REALIZADA,
                            VISITA_CANTIDAD,
                            TIP_COMPROBANTE,
                            NRO_COMPROBANTE,
                            SER_COMPROBANTE,
                            TO_CHAR(FEC_COMPROBANTE, 'DD/MM/YYYY') AS FEC_COMPROBANTE,
                            TO_CHAR(FEC_VENCIMIENTO, 'DD/MM/YYYY') AS FEC_VENCIMIENTO,
                            TO_CHAR(FEC_MOV_CAJ, 'DD/MM/YYYY') AS FEC_MOV_CAJ,
                            MONTO_BASE,
                            NRO_RECIBO,
                            ATRASO_EMISION,
                            NRO_MOV_CAJ,
                            PORC_COMISION,
                            MONTO,
                            DIRECCION_IP,
                            ID_COMPROBANTE_VT,
                            ID_SUCURSAL,
                            NRO_PERIODO
                    FROM FVW_TMP_COMISION_VENTA
                    WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    and DIRECCION_IP = :P500_DIRECCION_IP;
                
                  APEX_JSON.initialize_clob_output;
                
                  APEX_JSON.open_object;
                  APEX_JSON.write('DETALLE', l_cursor);
                  APEX_JSON.close_object;
                
                  JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                  :P500_JSON_COMISION :=JSON_DETALLE;
                  
                  SELECT SUM(NVL(MONTO,0))  
                  INTO :P500_TOTAL 
                  FROM FVW_TMP_COMISION_VENTA
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  and DIRECCION_IP = :P500_DIRECCION_IP;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 66784115890440936
        }
        serverSideCondition {
            whenButtonPressed: @procesar
        }
    )

)

