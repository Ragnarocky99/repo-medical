page 500 (
    name: Calculo de Comisiones
    alias: CALCULO-DE-COMISIONES
    title: Calculo de Comisiones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("MONTO_COPIA");
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                          
                        v_total_cantidad      = v_total_cantidad     + parseFloat(r[v_cantidad].replace(/\./g,''));
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=0;
                 }
            
                 $s('P500_TOTAL',v_total_cantidad.toString().replace('.', ''));
            }
            ```
        executeWhenPageLoads: document.getElementById("P500_TOTAL").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            
            .totales{
                text-align: center;
                font-size: medium;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                margin-bottom-none
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region carga-de-calculo-de-comisiones (
        name: Carga de Calculo de Comisiones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select V.ID,
                       V.ID_EMPRESA,
                       V.NRO_PERIODO,
                       V.ANIO,
                       V.ID_VENDEDOR,
                       V.ID_CLIENTE,
                       V.ID_ARTICULO,
                       V.MONTO,
                       V.MONTO AS MONT_COPIA,
                       V.CANTIDAD,
                       V.FEC_PROCESO,
                       V.MONTO_BASE,
                       V.TIP_COMPROBANTE,
                       V.SER_COMPROBANTE,
                       V.NRO_COMPROBANTE,
                       V.VISITA_PERIODO,
                       V.VISITA_CANTIDAD,
                       V.VISITA_REALIZADA,
                       V.NRO_RECIBO,
                       V.PORC_COMISION,
                       V.FEC_COMPROBANTE,
                       V.FEC_VENCIMIENTO,
                       V.ATRASO_EMISION,
                       V.FEC_MOV_CAJ,
                       V.NOTA,
                       V.PORC_DESCUENTO,
                       V.NRO_MOV_CAJ,
                       V.ID_SUCURSAL,
                       V.ID_COMPROBANTE_VT
                  from FVW_COMISIONES_VENTAS V
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  and 1=2
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: saveButton
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 66827816414542740
        }

