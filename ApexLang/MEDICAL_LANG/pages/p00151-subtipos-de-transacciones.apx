page 151 (
    name: Subtipos de Transacciones
    alias: SUBTIPOS-DE-TRANSACCIONES
    title: Subtipos de Transacciones - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region subtipos-de-transacciones (
        name: Subtipos de Transacciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ST.ID,
                       ST.ID_EMPRESA,
                       ST.ID_MODULO,
                       TT.TIPO_TRANS,
                       ST.SUBTIPO_TRANS,
                       ST.DESCRIPCION,
                       ST.USA_DINERO,
                       CASE USA_DINERO
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END USA_DINERO_ICON,
                       ST.CONCEPTO,
                       ST.CARGA_VALORES,
                       CASE CARGA_VALORES
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END CARGA_VALORES_ICON,
                       ST.VERIFICA_VALORES,
                       CASE VERIFICA_VALORES
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END VERIFICA_VALORES_ICON,
                       ST.ID_CUENTA,
                       ST.COD_USUARIO_AUD,
                       ST.AFECTA_IMPONIBLE,
                       CASE AFECTA_IMPONIBLE
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_IMPONIBLE_ICON,
                       ST.ID_AGRUPACION,
                       ST.TIP_DOCUMENTO,
                       ST.CARGA_DEPOSITO,
                       ST.CARGA_OTROS,
                       CASE CARGA_OTROS
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END CARGA_OTROS_ICON,
                       ST.AFECTA_IVA,
                       ST.AFECTA_RENTA,
                       ST.GASTO_DESPACHO,
                       ST.ABREVIATURA,
                       ST.AFECTA_ASIENTO,
                       ST.TIPO,
                       ST.USA_CUENTA_PROV,
                       ST.IND_FORMA_COBRO,
                       ST.IND_AUTORIZADO,
                       ST.ACTIVO,
                       CASE
                       WHEN ACTIVO ='S' THEN 'fa fa-check u-success-text'
                       WHEN ACTIVO ='N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON,
                       ST.IND_ES_TARJETA_CREDITO,
                       'Ver Cuentas' AS cuentas_link,
                       CASE NVL(IND_AFECTA_FLUJO, 'N')
                         WHEN 'S' THEN 'fa fa-check u-success-text'
                         WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_FLUJO_ICON,
                       NVL(IND_AFECTA_FLUJO, 'N') IND_AFECTA_FLUJO
                  from BSW_SUBTIPOS_TRANS ST, BSW_TIPOS_TRANS TT
                  where ST.ID_TIPO_TRANS = TT.ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 152
                items: {
                    P152_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 17219168961952309
        }

