page 127 (
    name: Condiciones de Compra
    alias: CONDICIONES-DE-COMPRA
    title: Condiciones de Compra
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region condiciones-de-compra (
        name: Condiciones de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_CONDICION_COMPRA,
                       DESCRIPCION,
                       NRO_CUOTAS,
                       DIAS_INICIAL,
                       PER_CUOTAS,
                       ESTADO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       ID_USUARIO,
                       FEC_ALTA,
                       PLAZO,
                       COD_USUARIO_AUD,
                       ID_TIP_DOCUMENTO,
                       SIGLA_CONDICION,
                       IND_REPLICA
                  from CMW_CONDICIONES_COMPRAS
                 where ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 128
                items: {
                    P128_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 14655515045521735
        }

        column COD_CONDICION_COMPRA (
            type: plainText
            heading {
                heading: Cód. Condición Compra
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cod Usuario Aud
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DIAS_INICIAL (
            type: plainText
            heading {
                heading: Días Inicial
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ESTADO_ICON (
            type: hidden
            heading {
                heading: Estado Icon
            }
            layout {
                sequence: 56
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column FEC_ALTA (
            type: plainText
            heading {
                heading: Fecha Alta
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: plainText
            heading {
                heading: Id Empresa
                alignment: center
            }
            layout {
                sequence: 26
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_TIP_DOCUMENTO (
            type: plainText
            heading {
                heading: Id Tip Documento
                alignment: center
            }
            layout {
                sequence: 46
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column ID_USUARIO (
            type: plainText
            heading {
                heading: Id Usuario
                alignment: center
            }
            layout {
                sequence: 36
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column IND_REPLICA (
            type: plainText
            heading {
                heading: Ind Replica
                alignment: center
            }
            layout {
                sequence: 16
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column NRO_CUOTAS (
            type: plainText
            heading {
                heading: Nro. Cuotas
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column PER_CUOTAS (
            type: plainText
            heading {
                heading: Periodo Cuotas
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column PLAZO (
            type: plainText
            heading {
                heading: Plazo
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column SIGLA_CONDICION (
            type: plainText
            heading {
                heading: Sigla Condicion
                alignment: center
            }
            layout {
                sequence: 15
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                CONDICIONES DE COMPRA
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 146647 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CONDICION_COMPRA (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 7
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn DIAS_INICIAL (
                sequence: 4
            )

            displayColumn ESTADO (
                sequence: 8
            )

            displayColumn NRO_CUOTAS (
                sequence: 3
            )

            displayColumn PER_CUOTAS (
                sequence: 5
            )

            displayColumn PLAZO (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @condiciones-de-compra
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 128
                clearCache: 128
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @condiciones-de-compra
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @condiciones-de-compra
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18150781098636767
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

