    pageItem P199_NRO_COMPROBANTE (
        type: numberField
        label {
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @new-2
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @transferencia-bancaria
            column: NRO_COMPROBANTE
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_nro_comprobante CCW_DEBCRED_BANCARIOS.NRO_COMPROBANTE%TYPE;
                BEGIN
                    IF :P199_NRO_COMPROBANTE IS  NULL THEN
                        SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                           INTO v_nro_comprobante
                        FROM CCW_DEBCRED_BANCARIOS 
                        WHERE ID_EMPRESA = :P0_COD_EMPRESA
                          AND SER_COMPROBANTE = :P199_SER_COMPROBANTE
                          AND TIP_COMPROBANTE = :P199_TIP_COMPROBANTE;
                        RETURN V_NRO_COMPROBANTE;
                    END IF;
                    RETURN :P199_NRO_COMPROBANTE;
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            V_NRO_COMPROBANTE:=1;
                            RETURN V_NRO_COMPROBANTE;
                        WHEN OTHERS THEN 
                            RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                ```
        }
    )

