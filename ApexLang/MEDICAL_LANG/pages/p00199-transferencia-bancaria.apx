        source {
            formRegion: @transferencia-bancaria
            column: ID_TIPO_TRANS
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT T.ID
                FROM BSW_TIPOS_TRANS T
                WHERE T.ID_EMPRESA = :P0_ID_EMPRESA
                  AND T.ID_MODULO = TRAE_ID_MODULO('CC')
                  AND T.TIPO_TRANS = W_BUSCA_PARAMETRO('CC','TIPO_TRANSFERENCIA')
                ```
        }
    )

