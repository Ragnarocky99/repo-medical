page 199 (
    name: Transferencia Bancaria
    alias: TRANSFERENCIA-BANCARIA
    title: Transferencia Bancaria
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P199_ID_MONEDA").readOnly = true;
            document.getElementById("P199_ID_MONEDA_ENT").readOnly = true;
            document.getElementById("P199_ID_SUB_TIPO_TRANS").readOnly = true;
            document.getElementById("P199_COD_USUARIO_AUD").readOnly = true;
            document.getElementById("P199_FEC_MODIF").readOnly = true;
            document.getElementById("P199_TIP_COMPROBANTE").readOnly = true;
            document.getElementById("P199_SER_COMPROBANTE").readOnly = true;
            //document.getElementById("P199_TIP_CAMBIO").readOnly = true;
            //document.getElementById("P199_TIP_CAMBIO_ENT").readOnly = true;
            document.getElementById("P199_NRO_COMPROBANTE").readOnly = true;
            document.getElementById("P199_ASIENTOS").readOnly = true;
            document.getElementById("P199_DESCRIPCION_ENT").readOnly = true;
            document.getElementById("P199_DESCRIPCION").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 190px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: left;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            .totales{
                text-align: center;
                font-size: large;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

