    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: items
            items: P199_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P199_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P199_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P199_ASIENTOS_ID',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P199_URL
                    P199_ASIENTOS_ID
                ]
                itemsToReturn: P199_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P199_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-cuenta (
        name: Cargar Datos Cuenta
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P199_ID_CUENTA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select C.ID 
                    from bsw_monedas c, ccw_cuentas_bancarias b
                    where c.id = b.id_moneda 
                    and b.ID = :P199_ID_CUENTA
                    
                    ```
                itemsToSubmit: P199_ID_CUENTA
            }
            affectedElements {
                selectionType: items
                items: P199_ID_MONEDA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select B.ID_PER_JURIDICA 
                    from bsw_PERSONAS c, ccw_cuentas_bancarias b
                    where c.id = b.id_PER_JURIDICA 
                    and b.ID = :P199_ID_CUENTA
                    ```
                itemsToSubmit: P199_ID_CUENTA
            }
            affectedElements {
                selectionType: items
                items: P199_ID_PER_JURIDICA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select cb.referencia from CCW_CUENTAS_BANCARIAS CB
                    where cb.id = :P199_ID_CUENTA
                    ```
                itemsToSubmit: P199_ID_CUENTA
            }
            affectedElements {
                selectionType: items
                items: P199_DESCRIPCION
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

