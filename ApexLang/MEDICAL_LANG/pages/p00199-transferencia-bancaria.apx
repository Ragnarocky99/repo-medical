    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 160
        }
        when {
            selectionType: items
            items: P199_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P199_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P199_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P199_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P199_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P199_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P199_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P199_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P199_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CH','ID_MODULO_CH'),:P199_FEC_COMPROBANTE);
                    end;
                    ```
                itemsToSubmit: P199_FEC_COMPROBANTE
                itemsToReturn: P199_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction descripcion-tipo-trans (
        name: Descripcion Tipo Trans
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P199_TIP_VALOR
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                        if :P199_TIP_VALOR is not null then
                            :P199_FEC_emision := SYSDATE;
                        end if;
                    ```
                itemsToSubmit: P199_TIP_VALOR
                itemsToReturn: P199_FEC_EMISION
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                        if :P199_TIP_VALOR is not null then
                            :P199_FEC_VENCIMIENTO := SYSDATE;
                        end if;
                    ```
                itemsToSubmit: P199_TIP_VALOR
                itemsToReturn: P199_FEC_VENCIMIENTO
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
