        error {
            errorMessage: Debe especificar un concepto de compra para esta transaccion.
            associatedItem: @P199_ID_CONCEPTO_COMPRA
        }
        serverSideCondition {
            type: item=value
            item: P199_AFECTA_FLUJO
            value: S
        }
    )

    validation validafecha (
        name: validafecha
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('CC', 'ID_MODULO_CC'), :P199_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P199_FEC_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }
    )

