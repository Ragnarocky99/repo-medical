    pageItem P199_ID_SUB_TIPO_TRANS (
        type: selectList
        label {
            label: <p>Concepto:&ensp;</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT T.DESCRIPCION,T.ID
                FROM BSW_SUBTIPOS_TRANS T, BSW_TIPOS_TRANS TT
                WHERE T.SUBTIPO_TRANS = W_BUSCA_PARAMETRO ('CC', 'SUBTIPO_TRANS')
                AND TT.TIPO_TRANS = W_BUSCA_PARAMETRO ('CC', 'TIPO_TRANSFERENCIA') AND T.ID_TIPO_TRANS = TT.ID
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @new-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: comprobante
        }
        source {
            formRegion: @transferencia-bancaria
            column: ID_SUB_TIPO_TRANS
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT T.ID FROM BSW_SUBTIPOS_TRANS T, BSW_TIPOS_TRANS TT
                WHERE T.SUBTIPO_TRANS = W_BUSCA_PARAMETRO ('CC', 'SUBTIPO_TRANS')
                AND TT.TIPO_TRANS = W_BUSCA_PARAMETRO ('CC', 'TIPO_TRANSFERENCIA') AND T.ID_TIPO_TRANS = TT.ID
                ```
        }
    )

