    dynamicAction new (
        name: New
        execution {
            sequence: 180
        }
        when {
            selectionType: items
            items: P199_NRO_PLANILLA_ENT
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    V_IMPORTE CCW_DEBCRED_BANCARIOS.IMPORTE%TYPE;
                    V_NRO_CUENTA CCW_CUENTAS_BANCARIAS.NRO_CUENTA%TYPE;
                    
                    BEGIN
                    
                        SELECT NRO_CUENTA
                        INTO V_NRO_CUENTA
                        FROM CCW_CUENTAS_BANCARIAS CB  
                        WHERE CB.ID = :P199_ID_CUENTA_ENT;
                    
                    
                         V_IMPORTE := TRAE_MONTO_FONDO(:P0_ID_EMPRESA,V_NRO_CUENTA,:P199_NRO_PLANILLA_ENT);
                         RETURN V_IMPORTE;
                    
                            EXCEPTION
                                WHEN OTHERS THEN
                                 RAISE_APPLICATION_ERROR(-20000,'Error al buscar el monto para la reposicion de fondo fijo: '||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    P199_NRO_CUENTA_ENT
                    P199_NRO_PLANILLA_ENT
                    P199_ID_CUENTA_ENT
                ]
            }
            affectedElements {
                selectionType: items
                items: P199_IMPORTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

