            sequence: 180
            parentRegion: @transferencia-bancaria
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region transferencia-bancaria (
        name: Transferencia Bancaria
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       REFERENCIA,
                       FEC_COMPROBANTE,
                       ID_SUCURSAL,
                       ID_PER_JURIDICA,
                       ID_CUENTA,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ID_TIPO_TRANS,
                       ID_SUB_TIPO_TRANS,
                       CONCEPTO,
                       IMPORTE,
                       COD_USUARIO_AUD,
                       IND_GENERA_ASIENTO,
                       REPLACE(REPLACE(ASIENTOS,'*'),'cobros') ASIENTOS,
                       --ASIENTOS,
                       NRO_CUENTA_ENT,
                       TIENE_DETALLE,
                       ID_CUENTA_CONT,
                       ID_CUENTA_ENT,
                       ID_PER_JURIDICA_ENT,
                       ID_MONEDA_ENT,
                       TIP_CAMBIO_ENT,
                       NRO_OPERACION_BANCO,
                       FEC_ALTA,
                       FEC_MODIF,
                       IND_IMPORTACION,
                       ID_PROVEEDOR,
                       ID_USUARIO_ALTA,
                       ID_USUARIO_MODIF,
                       FEC_BANCO,
                       ID_CENTRO_COSTO,
                       NRO_PLANILLA_FF,
                       NRO_PLANILLA_ENT,
                       NRO_DOCUMENTO,
                       ID_CONCEPTO_COMPRA
                from CCW_DEBCRED_BANCARIOS
                where id_empresa = :P0_COD_EMPRESA and id_sucursal = :P0_COD_SUCURSAL
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

