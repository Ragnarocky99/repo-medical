page 510 (
    name: Cuotas POS
    alias: CUOTAS-POS
    title: Cuotas POS
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            $("#P510_CUOTAS").keypress(function(event){
            event = (event) ? event : window.event;
            var charCode = (event.which) ? event.which : event.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
            }
            return true;
            });
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            .solo-mostrar{
                background-color:#eeeeee;
                width: 121px;
                height: 23px;
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .cambio{
                    vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            .timbrado{
                background-color:#eeeeee;
                width: 100px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            .a-GV-rowLabel{display:none;}
            
            .Numeros{
                font-weight: bold;
            }
            .Numeros1{
                font-weight: bold;
                background-color: #f4f9f2;
            }
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region opcion (
        name: Opcion
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region parametros (
        name: Parametros
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P510_CUOTAS (
        type: numberField
        label {
            label: <p>Cuotas</p>
            alignment: left
        }
        settings {
            minValue: 1
            maxValue: 99
        }
        layout {
            sequence: 20
            region: @parametros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: 0
        }
        sessionState {
            storage: request
        }
    )

    pageItem P510_IP_POS (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P510_MENSAJE (
        type: hidden
        layout {
            sequence: 50
            region: @parametros
            slot: regionBody
        }
    )

    pageItem P510_MONTO_POS (
        type: hidden
        layout {
            sequence: 30
            region: @opcion
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P510_MONTO_POS_DISPLAY (
        type: numberField
        label {
            label: <p>Monto</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @opcion
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        advanced {
            cssClasses: comprobante
        }
        default {
            type: expression
            plsqlExpression:
                ```plsql
                :P510_MONTO_POS
                
                ```
        }
        sessionState {
            storage: request
        }
    )

    pageItem P510_NRO_BOLETA (
        type: hidden
        layout {
            sequence: 60
            region: @parametros
            slot: regionBody
        }
    )

    pageItem P510_NRO_MOV_CAJ (
        type: hidden
        layout {
            sequence: 30
            region: @parametros
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P510_OPCION (
        type: popupLov
        label {
            label: <p>Opción</p>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Un Solo Pago;P,Cuotas;C
        }
        layout {
            sequence: 10
            region: @opcion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: static
            staticValue: P
        }
    )

    pageItem P510_PLAN (
        type: selectList
        label {
            label: <p>Plan</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT DESCRIPCION,COD_PLAN FROM CCW_PLAN_CUOTAS_POS
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @parametros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: 0
        }
        sessionState {
            storage: request
        }
    )

    button aceptar (
        buttonName: Aceptar
        label: Aceptar
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
            column: 11
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 30
            slot: contentBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cambiar-opcion (
        name: Cambiar Opcion
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P510_OPCION
        }
        clientSideCondition {
            type: item=value
            item: P510_OPCION
            value: C
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P510_PLAN:=1;
                    :P510_CUOTAS:=1;
                    ```
                itemsToReturn: [
                    P510_PLAN
                    P510_CUOTAS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P510_CUOTAS:=0;
                    :P510_PLAN:=0;
                    ```
                itemsToReturn: [
                    P510_CUOTAS
                    P510_PLAN
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @parametros
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @parametros
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cancelar (
        name: Cancelar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction llamar-pos (
        name: Llamar POS
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @aceptar
        }

        action native-alert (
            action: alert
            settings {
                message: &P510_MENSAJE.
                style: information
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P510_MENSAJE_POS
            }
        )

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    DECLARE
                      V_NRO_BOLETA          VARCHAR2(12);
                      V_MENSAJE             VARCHAR2(200);
                      V_SUBTIPO_TRANS       VARCHAR2(30);
                      V_VUELTO              NUMBER(12);
                      V_NRO_MOV_CAJ         NUMBER(8);
                      TMP_BOLETA CONSTANT   VARCHAR2(30):='BOLETA_POS';
                    BEGIN
                      BEGIN
                        SELECT SUBTIPO_TRANS
                          INTO V_SUBTIPO_TRANS
                          FROM BSW_SUBTIPOS_TRANS
                         WHERE ID = :P75_ID_SUB_TIPO_TRANS;
                      EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                          NULL;
                        WHEN OTHERS THEN
                          NULL;
                      END;
                    
                      BEGIN
                        SELECT MAX(NRO_MOV_CAJ) + 1
                          INTO V_NRO_MOV_CAJ
                          FROM CCW_MOVIMIENTOS_CAJAS
                         WHERE ID_EMPRESA = :P0_ID_EMPRESA
                           AND ID_SUCURSAL = :P0_ID_SUCURSAL;
                           EXCEPTION
                           WHEN OTHERS THEN
                           RAISE_APPLICATION_ERROR(-20000,'Error al traer el numero de caja');
                      END;
                    
                      IF TO_NUMBER(REPLACE(:P510_MONTO_POS,'.','')) <0 THEN
                      RAISE_APPLICATION_ERROR(-20000,'Monto Invalido');
                      END IF;
                    
                      IF :P510_OPCION='P' THEN
                      :P510_CUOTAS:=0;
                      :P510_PLAN:=0;
                      END IF;
                    
                        VENTA_CUOTAS_POS(NVL(:P510_NRO_MOV_CAJ, V_NRO_MOV_CAJ),
                                          REPLACE(:P510_MONTO_POS, '.', ''),
                                          :P510_CUOTAS,
                                          :P510_PLAN,
                                          :P510_IP_POS,
                                          V_NRO_BOLETA,
                                          V_MENSAJE,
                                          V_VUELTO);
                                          
                         :P510_MENSAJE:=V_MENSAJE;
                    
                              IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_BOLETA) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_BOLETA);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_BOLETA);
                    
                      APEX_COLLECTION.ADD_MEMBER(p_collection_name => TMP_BOLETA,
                                                 p_c001            => V_NRO_BOLETA);
                    
                    
                    
                      
                    END;
                    
                    ```
                itemsToSubmit: [
                    P510_PLAN
                    P510_CUOTAS
                    P510_NRO_MOV_CAJ
                    P510_MONTO_POS
                    P510_OPCION
                    P510_IP_POS
                ]
                itemsToReturn: [
                    P510_NRO_BOLETA
                    P510_MENSAJE
                ]
                successMessage: &P510_MENSAJE.
                errorMessage: #SQLERRM#
                extraOptions: [
                    showErrorAsAlert
                    showSpinnerProcessingIcon
                    showSpinnerWithModalOverlayMask
                    escapeSpecialCharactersInMessages
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ocultar-region (
        name: Ocultar Region
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @parametros
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p510-monto-pos (
        itemName: P510_MONTO_POS
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                nombre varchar2(255):='MONTO_POS';
                V_MONTO  NUMBER(9);
                BEGIN
                Select NVL(c001,0)
                into V_MONTO
                From APEX_COLLECTIONS
                Where COLLECTION_NAME = 'MONTO_POS'
                AND SEQ_ID = 1;
                
                APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => 'MONTO_POS');
                return V_MONTO;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                RAISE_APPLICATION_ERROR(-20000,sqlerrm);
                
                RETURN 0;
                WHEN OTHERS THEN
                RETURN 0;
                END;
                ```
        }
    )

)

