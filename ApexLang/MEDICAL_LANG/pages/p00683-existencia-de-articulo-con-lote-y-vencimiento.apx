    region existencia-de-articulo-con-lote-y-vencimiento (
        name: Existencia de Articulo con Lote y Vencimiento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  S.DESCRIPCION AS SUCURSAL, A.COD_ARTICULO, A.DESCRIPCION, E.CANT_DISPON, L.NRO_LOTE, L.FEC_VENCIMIENTO
                FROM STW_EXISTENCIA_ART E, STW_LOTES L, STW_ARTICULOS A, BSW_SUCURSALES S
                WHERE A.ID = L.ID_ARTICULO
                AND A.ID = E.ID_ARTICULO
                AND E.ID_SUCURSAL = S.ID
                AND (S.ID = :P683_SUCURSAL OR :P683_SUCURSAL IS NULL)
                AND (A.ID = :P683_ARTICULOS OR :P683_ARTICULOS IS NULL)
                AND (:P683_NRO_LOTE = L.NRO_LOTE OR :P683_NRO_LOTE IS NULL)
                ```
            pageItemsToSubmit: [
                P683_SUCURSAL
                P683_ARTICULOS
                P683_NRO_LOTE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 42204592938824169
        }

        column CANT_DISPON (
            type: plainText
            heading {
                heading: Cant Dispon
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_ARTICULO (
            type: plainText
