page 683 (
    name: Existencia de Articulo con Lote y Vencimiento
    alias: EXISTENCIA-DE-ARTICULO-CON-LOTE-Y-VENCIMIENTO
    title: Existencia de Articulo con Lote y Vencimiento
    appearance {
