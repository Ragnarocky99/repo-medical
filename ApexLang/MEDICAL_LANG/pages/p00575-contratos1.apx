page 575 (
    name: Contratos-Loteamientos
    alias: CONTRATOS1
    title: Contratos-Loteamientos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region contratos (
        name: Contratos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  L.NRO_COMPROBANTE,
                        L.ID_MANZANA,
                        L.ID_LOTE,
                        L.ID_FRACCION,
                        L.ID_CONDICION_VENTA,
                        L.FEC_COMPROBANTE,
                        L.TOT_COMPROBANTE,
                        L.TOT_IVA,
                        L.TOT_GRAVADAS,
                        L.TOT_EXENTAS,
                        L.ID,
                       DECODE(L.ESTADO,'A','ACTIVO','I','INACTIVO','C','CANCELADO','INDEFINIDO') ESTADO
                  from LTW_CONTRATOS L
                  WHERE L.ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 557
                items: {
                    P557_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 95424737116743042
        }

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 108
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column FEC_COMPROBANTE (
            type: plainText
            heading {
                heading: Fec Comprobante
                alignment: center
            }
            layout {
                sequence: 48
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 98
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AC
            }
        )

        column ID_CONDICION_VENTA (
            type: plainTextBasedOnLov
            heading {
                heading: Condicion Venta
                alignment: center
            }
            lov {
                lov: @lv-condiciones-venta
            }
            layout {
                sequence: 28
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID_FRACCION (
            type: plainTextBasedOnLov
            heading {
                heading: Fracción
                alignment: center
            }
            lov {
                lov: @lv-fracciones
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_LOTE (
            type: plainText
            heading {
                heading: Lote
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_MANZANA (
            type: plainText
            heading {
                heading: Manzana
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Contrato
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TOT_COMPROBANTE (
            type: plainText
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 58
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column TOT_EXENTAS (
            type: plainText
            heading {
                heading: Exentas
                alignment: center
            }
            layout {
                sequence: 78
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AA
            }
        )

        column TOT_GRAVADAS (
            type: plainText
            heading {
                heading: Gravadas
                alignment: center
            }
            layout {
                sequence: 88
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AB
            }
        )

        column TOT_IVA (
            type: plainText
            heading {
                heading: IVA
                alignment: center
            }
            layout {
                sequence: 68
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Z
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Contratos
        }

        savedReport 954947 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FEC_COMPROBANTE (
                sequence: 6
            )

            displayColumn ID_CONDICION_VENTA (
                sequence: 5
            )

            displayColumn ID_FRACCION (
                sequence: 2
            )

            displayColumn ID_LOTE (
                sequence: 4
            )

            displayColumn ID_MANZANA (
                sequence: 3
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 1
            )

            displayColumn TOT_COMPROBANTE (
                sequence: 7
            )

            displayColumn TOT_EXENTAS (
                sequence: 9
            )

            displayColumn TOT_GRAVADAS (
                sequence: 10
            )

            displayColumn TOT_IVA (
                sequence: 8
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @contratos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 557
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

)

