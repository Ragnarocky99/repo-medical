page 406 (
    name: Unidades de Medida F.E.
    alias: UNIDADES-DE-MEDIDA-FE
    title: Unidades de Medida F.E.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region unidades-de-medida (
        name: Unidades de Medida
        type: interactiveReport
        source {
            location: localDatabase
            tableName: FEW_UNIDADES_MEDIDA
            orderByClause: COD_UNIDAD ASC
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 416
                items: {
                    P416_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 23506223756643471
        }

        column COD_UNIDAD (
            type: plainText
            heading {
                heading: Cód. Unidad
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column REPRESENTACION (
            type: plainText
            heading {
                heading: Representación
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Unidades de Medida
        }

        savedReport 235106 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_UNIDAD (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn REPRESENTACION (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @unidades-de-medida
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 416
                clearCache: 416
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @unidades-de-medida
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unidades-de-medida
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

