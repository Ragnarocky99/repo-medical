page 847 (
    name: Lista de Tareas Programadas
    alias: LISTA-DE-TAREAS-PROGRAMADAS
    title: Lista de Tareas Programadas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-de-tareas-programadas (
        name: Lista de Tareas Programadas
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLW_GESTOR_TAREAS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                AND IND_PROGRAMADO = 'S'
                ```
            orderByClause: NRO_TAREA DESC
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 850
                items: {
                    P850_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 86886268636161690
        }

        column COMENTARIO (
            type: hidden
            heading {
                heading: Comentario
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESCRIPCION_TAREA (
            type: plainText
            heading {
                heading: Descripcion
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column FEC_ESTADO (
            type: hidden
            heading {
                heading: Fec Estado
            }
            layout {
                sequence: 12
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column FEC_FINALIZADO (
            type: plainText
            heading {
                heading: Fec. Finalizado
                alignment: center
            }
            layout {
                sequence: 15
                columnAlignment: center
            }
            appearance {
                formatMask: dd/MM/yyyy HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column FEC_SOLICITUD (
            type: plainText
            heading {
                heading: Fec. Solicitud
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column FEC_TOPE (
            type: plainText
            heading {
                heading: Fec. Tope
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_AGENDA (
            type: hidden
            heading {
                heading: Id Agenda
            }
            layout {
                sequence: 17
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EQUIPO (
            type: plainTextBasedOnLov
            heading {
                heading: Equipo
                alignment: center
            }
            lov {
                lov: @clw-equipo-descripcion
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID_ESTADO (
            type: plainTextBasedOnLov
            heading {
                heading: Estado
                alignment: center
            }
            lov {
                lov: @clw-estado-gestor-tarea-descripcion
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID_INVOLUCTADOS (
            type: hidden
            heading {
                heading: Id Involuctados
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_RESPONSABLE (
            type: plainTextBasedOnLov
            heading {
                heading: Responsable
                alignment: center
            }
            lov {
                lov: @lv-usuarios
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_SOLICITANTE (
            type: plainTextBasedOnLov
            heading {
                heading: Solicitante
                alignment: center
            }
            lov {
                lov: @lv-usuarios
            }
            layout {
                sequence: 9
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_TIPO_TAREA (
            type: plainTextBasedOnLov
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                lov: @clw-tipo-tarea-descripcion
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_USUARIO_FINALIZA (
            type: hidden
            heading {
                heading: Id Usuario Finaliza
            }
            layout {
                sequence: 16
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column IND_FINALIZADO (
            type: plainText
            heading {
                heading: Finalizado
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column NRO_TAREA (
            type: plainText
            heading {
                heading: Nro. Tarea
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Lista de Tareas Programadas
        }

        savedReport 868941 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMENTARIO (
                sequence: 13
            )

            displayColumn DESCRIPCION_TAREA (
                sequence: 7
            )

            displayColumn FEC_ESTADO (
                sequence: 12
            )

            displayColumn FEC_FINALIZADO (
                sequence: 15
            )

            displayColumn FEC_SOLICITUD (
                sequence: 4
            )

            displayColumn FEC_TOPE (
                sequence: 8
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_AGENDA (
                sequence: 17
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn ID_EQUIPO (
                sequence: 10
            )

            displayColumn ID_ESTADO (
                sequence: 11
            )

            displayColumn ID_INVOLUCTADOS (
                sequence: 18
            )

            displayColumn ID_RESPONSABLE (
                sequence: 5
            )

            displayColumn ID_SOLICITANTE (
                sequence: 9
            )

            displayColumn ID_TIPO_TAREA (
                sequence: 6
            )

            displayColumn ID_USUARIO_FINALIZA (
                sequence: 16
            )

            displayColumn IND_FINALIZADO (
                sequence: 14
            )

            displayColumn NRO_TAREA (
                sequence: 3
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @lista-de-tareas-programadas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 850
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

)

