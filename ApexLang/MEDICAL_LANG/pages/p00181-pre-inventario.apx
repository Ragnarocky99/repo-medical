    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P181_FEC_FIN_INVENT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P181_FEC_FIN_INVENT) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P181_FEC_FIN_INVENT,'/','');
                            conv_fecha := substr(:P181_FEC_FIN_INVENT,1,2)||'/'||
                                                      substr(:P181_FEC_FIN_INVENT,3,2)||'/'||
                                                      lpad(substr(:P181_FEC_FIN_INVENT,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P181_FEC_FIN_INVENT := conv_fecha;
                        end if;
                    end;
                    ```
                itemsToSubmit: P181_FEC_FIN_INVENT
                itemsToReturn: P181_FEC_FIN_INVENT
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 140
        }
        when {
            selectionType: items
            items: P181_FEC_INI_INVENT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P181_FEC_INI_INVENT) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P181_FEC_INI_INVENT,'/','');
                            conv_fecha := substr(:P181_FEC_INI_INVENT,1,2)||'/'||
                                                      substr(:P181_FEC_INI_INVENT,3,2)||'/'||
                                                      lpad(substr(:P181_FEC_INI_INVENT,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P181_FEC_INI_INVENT := conv_fecha;
                        end if;
                    end;
                    ```
                itemsToSubmit: P181_FEC_INI_INVENT
                itemsToReturn: P181_FEC_INI_INVENT
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

