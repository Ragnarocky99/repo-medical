page 181 (
    name: Pre Inventario
    alias: PRE-INVENTARIO
    title: Pre Inventario
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var orden=0;
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P181_DESCRIPCION").readOnly = true;
            
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:13.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region articulo (
        name: Articulo
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @conteo-del-inventario
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
    )

    region conteo-del-inventario (
        name: Conteo del Inventario
        type: form
        source {
            location: localDatabase
            tableName: STW_INVENT_CAB
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--standardPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region inventario-det (
        name: INVENTARIO_DET
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select I.ID,
                       I.ID_EMPRESA,
                       I.ID_NUM_INVENT_CAB,
                       I.ID_ARTICULO,
                       A.DESCRIPCION,
                       A.COD_ARTICULO,
                       A.COD_ORIGEN_ART,
                       A.ID_MARCA,
                       A.ID_ENVASE,
                       A.ID_RUBRO,
                       I.CANT_REAL,
                       I.CANT_FISICA,
                       I.CANT_BLOQUEO,
                       I.ORDEN,
                       I.COD_USUARIO_AUD,
                       I.ID_LOTE,
                       I.NRO_LOTE,
                       I.LOTE_VENC,
                       I.ID_UNIDAD_MEDIDA,
                       I.CANTIDAD_UB,
                       I.ID_MONEDA,
                       I.TIP_CAMBIO,
                       I.COSTO,
                       I.OBSERVACION,
                       I.FEC_ALTA
                  from STW_INVENT_DET_PROV I,STW_ARTICULOS A
                  WHERE ID_NUM_INVENT_CAB=:P181_ID
                  AND I.ID_ARTICULO=A.ID
                ```
            pageItemsToSubmit: P181_ID
        }
        layout {
            sequence: 30
            parentRegion: @conteo-del-inventario
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        readOnly {
            type: item=value
            item: P181_IND_CERRADO
            value: S
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        editAuthorization {
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    orden=orden-1;
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                            };    
                       
                       
                                
                
                        } ;      
                        return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 79851471170153925
        }

