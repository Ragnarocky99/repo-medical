    computation p181-num-invent (
        itemName: P181_NUM_INVENT
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_numero number;
                begin
                if :P181_NUM_INVENT IS NULL THEN 
                SELECT nvl(MAX(NUM_INVENT),0)+1  
                into v_numero
                FROM STW_INVENT_CAB
                WHERE ID_EMPRESA=:P0_COD_EMPRESA;
                return v_numero;
                END IF;
                RETURN :P181_NUM_INVENT;
                EXCEPTION 
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(20000,'Error en la tabla de inventario');
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    computation p181-validar-acceso (
        itemName: P181_VALIDAR_ACCESO
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_bandera number;
                BEGIN
                SELECT 1 
                into v_bandera
                FROM STW_INVENT_CAB 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA 
                AND ID_SUCURSAL=:P0_COD_SUCURSAL
                AND IND_CERRADO='N';
                if v_bandera=1 then 
                RETURN 1;
                END IF;
                END;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                raise_application_error(-20000,'No hay inventario activo!');
                ```
        }
    )

