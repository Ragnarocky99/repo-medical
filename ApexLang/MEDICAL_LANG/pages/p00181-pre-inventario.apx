        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT MAX(ID) 
                FROM STW_INVENT_CAB
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND IND_CERRADO='N'
                AND ID_SUCURSAL=:P0_COD_SUCURSAL
