    process insertar-detalle (
        name: Insertar Detalle
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR LOTES IS
                        SELECT EA.ID_ARTICULO,
                               EA.ID_LOTE,
                               AR.ID_UNIDAD_MEDIDA,
                               LO.NRO_LOTE,
                               LO.FEC_VENCIMIENTO,
                               AR.ID_MONEDA_COSTO,
                               TRAE_COSTO_PROM(:P0_ID_EMPRESA, AR.ID, SYSDATE) COSTO,
                               FTIPOS_CAMBIO(AR.ID_MONEDA_COSTO,SYSDATE,'C','V') TIP_CAMBIO
                          FROM STW_EXISTENCIA_ART EA
                          JOIN STW_ARTICULOS      AR ON AR.ID = EA.ID_ARTICULO
                          JOIN STW_LOTES          LO ON LO.ID = EA.ID_LOTE
                         WHERE EA.ID_SUCURSAL = :P0_ID_SUCURSAL
                           AND EA.ID_ARTICULO = :P181_ID_ARTICULO_2
                           AND EA.CANT_DISPON > 0
                           AND :P181_IND_LOTE = 'S'
                        UNION ALL
                        SELECT LO.ID_ARTICULO,
                               LO.ID,
                               AR.ID_UNIDAD_MEDIDA,
                               LO.NRO_LOTE,
                               LO.FEC_VENCIMIENTO,
                               AR.ID_MONEDA_COSTO,
                               TRAE_COSTO_PROM(:P0_ID_EMPRESA, AR.ID, SYSDATE),
                               FTIPOS_CAMBIO(AR.ID_MONEDA_COSTO,SYSDATE,'C','V')
                          FROM STW_ARTICULOS AR
                          JOIN STW_LOTES     LO ON AR.ID= LO.ID_ARTICULO
                         WHERE AR.ID = :P181_ID_ARTICULO_2
                           AND :P181_IND_LOTE = 'N'
                           AND ROWNUM = 1
                        ORDER BY 2;
                    VCANT_FISICA NUMBER := 0;
                BEGIN
                   -- RAISE_APPLICATION_ERROR(-20000, 'ART ID '||:P181_ID_ARTICULO_2||' SUC ID'||:P181_ID_SUCURSAL||' LOTE '||:P181_IND_LOTE);
                    FOR LOTE IN LOTES
                    LOOP
                        INSERT INTO STW_INVENT_DET_PROV(ID_EMPRESA,
                                                        ID_NUM_INVENT_CAB,
                                                        ID_ARTICULO,
                                                        CANT_FISICA,
                                                        COD_USUARIO_AUD,
                                                        ID_LOTE,
                                                        NRO_LOTE,
                                                        LOTE_VENC,
                                                        ID_UNIDAD_MEDIDA,
                                                        ID_MONEDA,
                                                        TIP_CAMBIO,
                                                        COSTO,
                                                        FEC_ALTA
                                                        )
                        VALUES(:P0_ID_EMPRESA,
                               :P181_ID,
                               LOTE.ID_ARTICULO,
                               VCANT_FISICA,
                               :APP_USER,
                               LOTE.ID_LOTE,
                               LOTE.NRO_LOTE,
                               LOTE.FEC_VENCIMIENTO,
                               LOTE.ID_UNIDAD_MEDIDA,
                               LOTE.ID_MONEDA_COSTO,
                               LOTE.TIP_CAMBIO,
                               LOTE.COSTO,
                               SYSDATE
                               );
                    END LOOP;
                END;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Articulo añadido
        }
        advanced {
            executionMappingIdentifier: 42321835717032946
        }
        serverSideCondition {
            whenButtonPressed: @agregar
        }
    )

