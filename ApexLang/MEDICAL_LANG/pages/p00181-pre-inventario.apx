    dynamicAction cargar-datos-del-articulo-cab (
        name: Cargar Datos del Articulo Cab
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P181_ID_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.DESCRIPCION,A.ID_UNIDAD_MEDIDA,1,A.ID_MONEDA_BASE,A.ID
                    INTO :P181_DESCRIPCION,:P181_ID_UNIDAD_MEDIDA,:P181_CANTIDAD,:P181_ID_MONEDA,/* Aca guardo el ID del articulo*/:P181_ID_ARTICULO_2
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:P181_ID_ARTICULO OR B.COD_BARRA=:P181_ID_ARTICULO OR A.COD_ORIGEN_ART=:P181_ID_ARTICULO ) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: P181_ID_ARTICULO
                itemsToReturn: [
                    P181_DESCRIPCION
                    P181_ID_UNIDAD_MEDIDA
                    P181_CANTIDAD
                    P181_ID_MONEDA
                    P181_ID_ARTICULO_2
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    SELECT ID,NRO_LOTE,FEC_VENCIMIENTO
                    INTO :P181_ID_LOTE,:P181_NRO_LOTE,:P181_LOTE_VENC
                    FROM 
                    STW_LOTES
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA AND
                    ID_ARTICULO=:P181_ID_ARTICULO_2 AND 
                    ROWNUM=1;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el lote del articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de lotes'||sqlerrm);
                    end;
                    ```
                itemsToSubmit: P181_ID_ARTICULO_2
                itemsToReturn: [
                    P181_ID_LOTE
                    P181_NRO_LOTE
                    P181_LOTE_VENC
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P181_CANTIDAD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SUM(CANT_DISPON) FROM 
                    STW_EXISTENCIA_ART WHERE
                    ID_LOTE=:P181_ID_LOTE
                    AND ID_ARTICULO=:P181_ID_ARTICULO_2
                    AND ID_EMPRESA=:P0_COD_EMPRESA
                    ```
                itemsToSubmit: [
                    P181_ID_ARTICULO_2
                    P181_ID_LOTE
                ]
            }
            affectedElements {
                selectionType: items
                items: P181_CANT_REAL
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TRAE_COSTO_PROM(:P0_COD_EMPRESA,:P181_ID_ARTICULO_2,sysdate)FROM DUAL;
                    
                    ```
                itemsToSubmit: P181_ID_ARTICULO_2
            }
            affectedElements {
                selectionType: items
                items: P181_COSTO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-lote (
        name: Cargar Lote
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @inventario-det
            columns: ID_LOTE
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: ID_LOTE
        }

        action cant-fisica (
            name: CANT_FISICA
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL((SELECT SUM(CANT_DISPON)
                                  FROM STW_EXISTENCIA_ART
                                 WHERE ID_LOTE = :ID_LOTE
                                   AND ID_ARTICULO = :ID_ARTICULO
                                   AND ID_EMPRESA = :P0_ID_EMPRESA
                                   AND ID_SUCURSAL = :P0_ID_SUCURSAL), 0) CANT_DISPON
                      FROM DUAL
                    ```
                itemsToSubmit: [
                    ID_LOTE
                    ID_ARTICULO
                ]
            }
            affectedElements {
                selectionType: columns
                columns: CANT_FISICA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action lote-venc (
            name: LOTE_VENC
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare 
                    fecha_venc date;
                    begin
                    SELECT FEC_VENCIMIENTO F
                    INTO FECHA_VENC
                    FROM
                    STW_LOTES
                    WHERE ID=:ID_LOTE
                    AND ID_EMPRESA=:P0_COD_EMPRESA;
                    RETURN FECHA_VENC;
                    end;
                    EXCEPTION when no_DATA_FOUND THEN
                    RETURN NULL;
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de lotes'||sqlerrm);
                    ```
                itemsToSubmit: ID_LOTE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: LOTE_VENC
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action nro-lote (
            name: NRO_LOTE
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare 
                    nro_lote STW_LOTES.NRO_LOTE%TYPE;
                    begin
                    SELECT NRO_LOTE
                    INTO NRO_LOTE
                    FROM  STW_LOTES
                    WHERE ID=:ID_LOTE
                    AND ID_EMPRESA=:P0_COD_EMPRESA;
                    RETURN NRO_LOTE;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el numero de lote');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de lotes');
                    end;
                    ```
                itemsToSubmit: ID_LOTE
                escapeSpecialChars: false
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: columns
                columns: NRO_LOTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

