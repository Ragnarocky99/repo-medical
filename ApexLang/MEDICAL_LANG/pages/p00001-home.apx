    region tiempo (
        name: Tiempo
        type: staticContent
        source {
            htmlCode: <iframe src="https://www.meteoblue.com/en/weather/widget/three?geoloc=detect&nocurrent=0&noforecast=0&days=4&tempunit=CELSIUS&windunit=KILOMETER_PER_HOUR&layout=image"  frameborder="0" scrolling="NO" allowtransparency="true" sandbox="allow-same-origin allow-scripts allow-popups allow-popups-to-escape-sandbox" style="width: 460px; height: 594px"></iframe><div><!-- DO NOT REMOVE THIS LINK --><a href="https://www.meteoblue.com/en/weather/week/index?utm_source=weather_widget&utm_medium=linkus&utm_content=three&utm_campaign=Weather%2BWidget" target="_blank" rel="noopener">meteoblue</a></div>
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: u-normal-border
        }
        advanced {
            customAttributes: "STYLE=\"height:100%\" "
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P1_CUMPLE (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @calendario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: "Buen día &APP_USER., bienvenido al sistema. "
        }
    )

    pageItem P1_ID_RESPONSABLE (
        type: popupLov
        label {
            label: <p>Responsable</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-usuarios
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 10
            region: @agenda-crm
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: expression
            plsqlExpression: TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) IN ('DIR', 'ADMIN')
        }
    )

    pageItem P1_NRO_TAREA (
        type: numberField
