    dynamicAction click-refres-agenda (
        name: Click refres agenda
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @refresh-agenda
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @agenda-crm
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cumple (
        name: Cumple
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 
                           'Feliz cumpleaños  '||NOMBRE||'!'
                      from BSW_PERSONAS
                     where TO_CHAR(FEC_NACIMIENTO,'mm')=to_char(sysdate, 'mm')
                    and TO_CHAR(FEC_NACIMIENTO,'dd')=to_char(sysdate,'dd')
                    ```
            }
            affectedElements {
                selectionType: items
                items: P1_CUMPLE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @whatsapp
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                      declare
                        l_clob      CLOB;     
                        v_api_key   varchar2(200);
                        v_cuenta_id number(10);
                        v_recipiente varchar2(50);    
                        v_tipo varchar2(20);
                        v_mensaje varchar2(2000);
                        url  varchar2(400);
                    BEGIN
                    
                    
                    v_api_key:='8e9a5fd1716b87565907233fa53607b8c1a86f5e';
                    v_cuenta_id:=28;
                    v_recipiente:='595983429149';
                    v_tipo:='text';
                    v_mensaje:='Bugeada tremenda';
                    
                     
                    
                           -- apex_json.initialize_clob_output();  
                     --apex_json.open_object();  
                     --apex_json.write('secret','8e9a5fd1716b87565907233fa53607b8c1a86f5e'); 
                     --apex_json.write('account',28);
                     --apex_json.write('recipient','595983429149');
                     --apex_json.write('type','text');
                     --apex_json.write('message','Hacer JSONS es divertido :)');
                     --apex_json.close_all();
                      --l_json:=apex_json.get_clob_output();
                      --apex_json.free_output();
                     -- dbms_output.put_line(l_json);
                       
                       url:='https://flow.cnid.com.py/api/send/whatsapp?secret='||utl_url.escape(v_api_key)||'&account='||utl_url.escape(v_cuenta_id)||'&recipient='||utl_url.escape(v_recipiente)||'&type='||utl_url.escape(v_tipo)||'&message='||utl_url.escape(v_mensaje);
                    
                      
                     l_clob :=
                        APEX_WEB_SERVICE.make_rest_request(
                            p_url           => url,
                            p_http_method   => 'POST');
                            
                            
                        
                        :P1_RESPUESTA:=l_clob;
                            
                    
                    
                    END;
                    ```
                itemsToReturn: P1_RESPUESTA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var respuesta = JSON.parse($v('P1_RESPUESTA'));
                    
                    
                    if (respuesta.status=403){
                       apex.message.alert('Se alcanzo el limite diario de mensajes!');
                    
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-agenda (
        name: Refrescar Agenda
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @agenda-crm
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tareas-vencidas
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 718
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            target: {
                page: 718
                successMessage: false
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM RPW_REPARTIDORES R
                  JOIN BSW_USUARIOS     U ON U.ID = R.ID_USUARIO
                 WHERE U.COD_USUARIO = :APP_USER
                   AND NVL(ACTIVO, 'S') = 'S'
                ```
        }
    )

)

