page 1 (
    name: Inicio
    alias: HOME
    title: Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .tarjeta{
                background-color: #9189fd;
                height: 230px;
            }
            .tarjeta2{
                background-color: #ffbf79;
                height: 230px;
            }
            .tarjeta3{
                background-color: #f790c8;
                height: 230px;
            }
            
            .u-color{
                background-color: #133561 !important;
            }
            
            .a-CardView-icon, .a-CardView-icon.fa{
                height: 40px !important;
                width: 40px !important;
            }
            
            h4{
                line-height: 1 !important;
            }
            
            .a-TMV-w-scroll {
                overflow-x: hidden;
                overflow-y: hidden;
            
            }
            .tarjeta h2, .tarjeta2 h2, .tarjeta3 h2 {
                overflow: hidden;
                text-overflow: ellipsis;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient:vertical;
            }
            
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region agenda-crm (
        name: Agenda CRM
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT AG.ID,
                       AG.FECHA,
                       AG.DISPLAY,
                       PREPARA_URL_CARGA(P_ID_EMPRESA      => AG.ID_EMPRESA,
                                         P_TIP_COMPROBANTE => AG.TIPO,
                                         P_ID              => AG.ID) URL,
                       AG.COLOR,
                       AG.DESCRIPCION
                  FROM AGENDAS AG
                 WHERE AG.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (AG.COD_USUARIO = :APP_USER OR
                        TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) IN ('DIR', 'ADMIN') OR
                        TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) MEMBER OF APEX_STRING.SPLIT_NUMBERS(AG.ID_INVOLUCTADOS, ':') OR
                        TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) MEMBER OF APEX_STRING.SPLIT_NUMBERS(AG.ID_MENCIONES, ':'))
                   AND (AG.ID_RESPONSABLE = :P1_ID_RESPONSABLE OR :P1_ID_RESPONSABLE IS NULL)
                   AND (AG.NRO_TAREA = :P1_NRO_TAREA OR :P1_NRO_TAREA IS NULL)
                ```
            pageItemsToSubmit: [
                P1_ID_RESPONSABLE
                P1_NRO_TAREA
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            displayColumn: DISPLAY
            startDateColumn: FECHA
            pkColumn: ID
            supplementalInfo: &DESCRIPCION.
            additionalCalendarViews: [
                list
                navigation
            ]
            createLink: {
                page: 809
                items: {
                    P809_FECHA: &APEX$NEW_START_DATE.
                }
                clearCache: Y
            }
            viewEditLink: {
                type: url
                url: &URL.
            }
            cssClass: COLOR
        }
    )

    region calendario (
        name: Calendario
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_EVENTO,
                       DESCRIPCION,
                       FEC_INICIO,
                       FEC_FIN,
                       ID_USUARIO,
                       TIPO_EVENTO,
                       TITULO
                  from BSW_AGENDA WHERE ID_USUARIO=(SELECT ID FROM BSW_USUARIOS WHERE UPPER(COD_USUARIO)=UPPER(:APP_USER))
                ```
        }
        layout {
            sequence: 100
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: u-normal-border
            icon: fa-calendar-edit
        }
        advanced {
            htmlDomId: Calendario
            customAttributes: "STYLE=\"height:100%\" "
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        settings {
            displayColumn: TITULO
            startDateColumn: FEC_INICIO
            endDateColumn: FEC_FIN
            pkColumn: ID
            additionalCalendarViews: [
                list
                navigation
            ]
            createLink: {
                page: 69
                items: {
                    P69_FEC_INICIO: &APEX$NEW_START_DATE.
                    P69_FEC_FIN: &APEX$NEW_END_DATE.
                }
            }
            viewEditLink: {
                page: 69
                items: {
                    P69_ID: &ID.
                }
            }
        }
    )

    region cambio-de-divisas (
        name: Cambio de Divisas
        type: staticContent
        source {
            htmlCode:
                ```html
                <script>
                var xhttp = new XMLHttpRequest();
                var texto;
                xhttp.onreadystatechange = function() {
                    if (this.readyState == 4 && this.status == 200) {
                       // Typical action to be performed when the document is ready:
                        var textoHTML;
                        var diccionario = xhttp.responseText;
                        var cambioDolar=  JSON.parse(diccionario);
                        var tiempo = cambioDolar['updated']
                        var cambioDolarPY=  cambioDolar['dolarpy'];
                        var cambioDolarPyBcpCompra = cambioDolarPY['bcp']['compra'];
                        var cambioDolarPyBcpVenta = cambioDolarPY['bcp']['venta'];
                
                
                        textoHTML=`<table style="border-spacing: 50px 0">
                <tr>
                <th>MONEDA</th>
                <th>Compra</th>
                <th>Venta</th>
                </tr>
                <tr>
                <td> <img src="#APP_FILES#bandera-dolar.jpg" style="vertical-align: middle;">      DOLAR     </td>
                <td>   ${cambioDolarPyBcpCompra}   </td>
                <td>   ${cambioDolarPyBcpVenta}   </td>
                </tr>
                </table>
                <h6> Fuente: Banco Central del Paraguay |   Actualizado el ${tiempo}</h6>   `
                
                
                
                
                             
                       document.getElementById("demo").innerHTML = textoHTML;
                       
                    }
                
                      
                };
                xhttp.open("GET", "https://dolar.melizeche.com/api/1.0/", true);
                xhttp.send();
                
                
                </script>
                
                <div id="demo" style="overflow-x:auto;" >           </div>
                
                ```
        }
        layout {
            sequence: 130
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

