    region tareas-vencidas (
        name: Tareas Vencidas
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLWV_TAREAS_VENCIDAS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                COD_USUARIO_RESPONSABLE = :APP_USER
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 638
                items: {
                    P638_ID_COTIZA_ART: #ID_COTIZA_ART#
                    P638_IND_VARIOS: N
                    P638_ID_APROBACION_LIC: #ID_APROBACION_LIC#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No hay tareas vencidas
        }
        advanced {
            savedReportMappingIdentifier: 35187522891864129
        }

