page 825 (
    name: Subir Objetivo de Ventas Excel
    alias: SUBIR-OBJETIVO-DE-VENTAS-EXCEL
    title: Subir Objetivo de Ventas Excel
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P825_EXCEL (
        type: fileUpload
        label {
            label: <p>Excel:&ensp;</p>
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            inlineHelpText:
                ```html
                <strong>A continuación se presentará el formato aceptado para subir el Excel. No se validará otra plantilla. <br>
                Presione <a href="#APP_FILES#ObjetivoVentasFormato.xlsx" title="Descargar" download> Aquí </a> para descargar</strong>
                ```
        }
    )

    pageItem P825_TIPO (
        type: selectList
        label {
            label: <p>Tipo:&ensp;</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-tipo-objetivo-venta
            displayNullValue: false
        }
        layout {
            sequence: 10
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    dynamicAction submit (
        name: Submit
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P825_EXCEL
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 64283759294987906
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P825_EXCEL
        }
    )

    process subir-excel (
        name: Subir Excel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VID_EJERCICIO   COW_EJERCICIOS.ID%TYPE;
                    VID_VENDEDOR    FVW_VENDEDORES.ID%TYPE;
                    VID_RUBRO       STW_RUBRO.ID%TYPE;
                    VID_MARCA       STW_MARCAS.ID%TYPE;
                BEGIN
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('PRESUPUESTO_ERR');
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('PRESUPUESTO');
                    FOR R1 IN (SELECT *  
                                 FROM APEX_APPLICATION_TEMP_FILES F, 
                                      TABLE( APEX_DATA_PARSER.PARSE(
                                                P_CONTENT                     => F.BLOB_CONTENT,
                                                P_ADD_HEADERS_ROW             => 'N',
                                                P_FILE_NAME                   => F.FILENAME) 
                                            ) P
                                 WHERE F.NAME = :P825_EXCEL AND
                                       P.LINE_NUMBER > 1
                              )
                    LOOP
                        --IF R1.COL001 IS NOT NULL AND R1.COL002 IS NOT NULL AND R1.COL003 IS NOT NULL THEN
                            -- Buscamos el ejercicio
                            BEGIN
                                SELECT ID
                                  INTO VID_EJERCICIO
                                  FROM COW_EJERCICIOS
                                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                                   AND COD_EJERCICIO = R1.COL001;
                
                            EXCEPTION
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener el ejercicio en la linea '||R1.LINE_NUMBER||'. Err '||SQLERRM);
                            END;
                
                            -- Buscamos el vendedor
                            BEGIN
                                SELECT ID
                                  INTO VID_VENDEDOR
                                  FROM FVW_VENDEDORES
                                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                                   AND COD_VENDEDOR = R1.COL002;
                
                            EXCEPTION
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener el vendedor en la linea '||R1.LINE_NUMBER||'. Err '||SQLERRM);
                            END;
                
                            -- Buscamos el rubro
                            BEGIN
                                SELECT ID
                                  INTO VID_RUBRO
                                  FROM STW_RUBRO
                                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                                   AND COD_RUBRO = R1.COL003;
                
                            EXCEPTION
                               WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener el rubro en la linea '||R1.LINE_NUMBER||'. Err '||SQLERRM);
                            END;
                
                            -- Buscamos la marca
                            BEGIN
                                SELECT ID
                                  INTO VID_MARCA
                                  FROM STW_MARCAS
                                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                                   AND COD_MARCA = R1.COL004;
                
                            EXCEPTION
                               WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener la marca en la linea '||R1.LINE_NUMBER||'. Err '||SQLERRM);
                            END;
                
                            -- Datos Numericos
                            BEGIN
                                INSERT INTO VTW_OBJETIVO(
                                                      ID_EMPRESA,
                                                      ID_EJERCICIO,
                                                      ID_VENDEDOR,
                                                      ID_RUBRO,
                                                      ID_MARCA,
                                                      PRE_ENERO,
                                                      PRE_FEBRERO,
                                                      PRE_MARZO,
                                                      PRE_ABRIL,
                                                      PRE_MAYO,
                                                      PRE_JUNIO,
                                                      PRE_JULIO,
                                                      PRE_AGOSTO,
                                                      PRE_SEPTIEMBRE,
                                                      PRE_OCTUBRE,
                                                      PRE_NOVIEMBRE,
                                                      PRE_DICIEMBRE,
                                                      TIPO)
                                VALUES(
                                    :P0_ID_EMPRESA,
                                    VID_EJERCICIO,
                                    VID_VENDEDOR,
                                    VID_RUBRO,
                                    VID_MARCA,
                                    REPLACE(R1.COL005, '.', ','), -- Enero
                                    REPLACE(R1.COL006, '.', ','), -- Febrero
                                    REPLACE(R1.COL007, '.', ','), -- Marzo
                                    REPLACE(R1.COL008, '.', ','), -- Abril
                                    REPLACE(R1.COL009, '.', ','), -- Mayo
                                    REPLACE(R1.COL010, '.', ','), -- Junio
                                    REPLACE(R1.COL011, '.', ','), -- Julio
                                    REPLACE(R1.COL012, '.', ','), -- Agosto
                                    REPLACE(R1.COL013, '.', ','), -- Septiembre
                                    REPLACE(R1.COL014, '.', ','), -- Octubre
                                    REPLACE(R1.COL015, '.', ','), -- Noviembre
                                    REPLACE(R1.COL016, '.', ','), -- Diciembre
                                    :P825_TIPO
                                );
                            EXCEPTION
                                WHEN OTHERS THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'PRESUPUESTO_ERR',
                                                               P_C001            => 'No se insertaron',
                                                               P_N001            => R1.LINE_NUMBER);
                            END;
                        --END IF;
                            
                        END LOOP;
                
                    -- IF VCANTIDAD > 0 THEN
                    --     :P794_MENSAJE := 'Proceso concluido con Exito. Se procesaron '||VCANTIDAD||' registros';
                    -- ELSE
                    --     :P794_MENSAJE := 'No se realizó ninguna accion';
                    -- END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 64283366800987906
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P825_EXCEL
        }
    )

)

