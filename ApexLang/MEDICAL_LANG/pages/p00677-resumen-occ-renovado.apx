    button filtrar (
        buttonName: REFRESCAR
        label: Refrescar
        layout {
            sequence: 200
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }

        triggerAction refrescar-reporte (
            name: Refrescar Reporte
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-de-orden-de-compra
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction acciones-al-cargar-la-pagina (
        name: Acciones al cargar la pagina
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @resumen-de-orden-de-compra
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 170
        }
        when {
            selectionType: items
            items: P677_TODOS
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select count(1) from cmw_cotiza_articulos
            }
            affectedElements {
                selectionType: items
                items: P677_LIMITE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

