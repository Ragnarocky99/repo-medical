        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Resumen de Orden de Compra
        }

        savedReport 302097 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ANULADA (
                sequence: 18
            )

            displayColumn APROBADA (
                sequence: 17
            )

            displayColumn COD_ARTICULO (
                sequence: 4
            )

            displayColumn COD_ORIGEN_ART (
                sequence: 5
            )

            displayColumn DESC_ARTICULO (
                sequence: 6
            )

            displayColumn DISPONIBILIDAD (
                sequence: 22
            )

            displayColumn ENTREGADA (
                sequence: 19
            )

            displayColumn ESTADO_OCC (
                sequence: 21
            )

            displayColumn FECHA_PLAZO (
                sequence: 16
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 1
            )

            displayColumn FEC_OCC (
                sequence: 15
            )

            displayColumn ID_CLIENTE (
                sequence: 11
            )

            displayColumn ID_ENVASE (
                sequence: 7
            )

            displayColumn ID_MARCA (
                sequence: 9
            )

            displayColumn ID_SUCURSAL_PEDIDO (
                sequence: 24
            )

            displayColumn ID_TIPO_ENTREGA (
                sequence: 10
            )

            displayColumn ID_UNIDAD_MEDIDA (
                sequence: 8
            )

            displayColumn ID_VENDEDOR (
                sequence: 25
            )

            displayColumn NRO_ITEM (
                sequence: 3
            )

            displayColumn NRO_OCC (
                sequence: 14
            )

            displayColumn NRO_PEDIDO (
                sequence: 2
            )

            displayColumn PRECIO_TOTAL (
                sequence: 13
            )

            displayColumn PRECIO_UNITARIO (
                sequence: 12
            )

            displayColumn REMISIONADA (
                sequence: 20
            )

            displayColumn STOCK (
                sequence: 23
            )

            aggregate (
                column: PRECIO_TOTAL
            )

            highlight ir-condition (
                name: Controlado
                condition {
                    column: IND_CONTROLADO
                    value: S
                }
                colors {
                    background: #ffd6d2
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    pageItem P677_COD_FABRICANTE (
        type: textField
        label {
            label: <p>Cod. Fabricante:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 170
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P677_ESTADO (
        type: selectList
        label {
            label: <p>Estado:&ensp;</p>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pendiente;Pendiente,Facturado;Facturado,Anulado;Anulado,Remision;Remision
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 140
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P677_FEC_OCC_DESDE (
        type: datePicker
        label {
            label: <p><b style="color:red;">*</b>Periodo OCC:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    pageItem P677_FEC_OCC_HASTA (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P677_ID_ARTICULO (
        type: popupLov
        label {
            label: <p>Articulo:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-articulos
            nullDisplayValue: -- TODOS --
        }
        layout {
            sequence: 160
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

