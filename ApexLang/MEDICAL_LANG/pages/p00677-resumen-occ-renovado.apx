    region resumen-de-orden-de-compra (
        name: Resumen de Orden de Compra
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CMWV_RESUMEN_OCC
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                and FEC_OCC between :P677_FEC_OCC_DESDE and :P677_FEC_OCC_HASTA
                and (ID_CLIENTE = :P677_ID_CLIENTE or :P677_ID_CLIENTE IS NULL)
                and (NRO_OCC = :P677_NRO_OCC or :P677_NRO_OCC IS NULL)
                and (ID_ARTICULO = :P677_ID_ARTICULO or :P677_ID_ARTICULO is null)
                and (COD_ORIGEN_ART = :P677_COD_FABRICANTE or :P677_COD_FABRICANTE is null)
                and (NRO_PEDIDO = :P677_NRO_PEDIDO or :P677_NRO_PEDIDO is null)        
                and (ESTADO_OCC = :P677_ESTADO or :P677_ESTADO is null)
                ```
            orderByClause: C_ID DESC
            pageItemsToSubmit: [
                P677_ID_CLIENTE
                P677_FEC_OCC_HASTA
                P677_FEC_OCC_DESDE
                P677_NRO_OCC
                P677_COD_FABRICANTE
                P677_ESTADO
                P677_NRO_PEDIDO
                P677_ID_ARTICULO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        advanced {
            savedReportMappingIdentifier: 83489816510155804
        }

