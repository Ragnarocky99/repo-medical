page 389 (
    name: Carga de Referencia Geografica
    alias: CARGA-DE-REFERENCIA-GEOGRAFICA
    title: Carga de Referencia Geografica
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 228px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-referencia-geografica (
        name: Carga de Referencia Geografica
        type: form
        source {
            location: localDatabase
            tableName: FEW_REFERENCIA_GEOGRAFICA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P389_COD_CIUDAD (
        type: popupLov
        label {
            label: <p>Código Ciudad: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-ciudades-fe-p
        }
        cascadingLov {
            parentItems: [
                P389_COD_PAIS
                P389_COD_DEPARTAMENTO
                P389_COD_DISTRITO
            ]
            itemsToSubmit: [
                P389_COD_PAIS
                P389_COD_DEPARTAMENTO
                P389_COD_DISTRITO
            ]
        }
        layout {
            sequence: 70
            region: @carga-de-referencia-geografica
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-referencia-geografica
            column: COD_CIUDAD
            dataType: varchar2
        }
    )

    pageItem P389_COD_DEPARTAMENTO (
        type: popupLov
        label {
            label: <p>Cód. Departamento: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-depto-fe-p
        }
        cascadingLov {
            parentItems: P389_COD_PAIS
            itemsToSubmit: P389_COD_PAIS
        }
        layout {
            sequence: 60
            region: @carga-de-referencia-geografica
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-referencia-geografica
            column: COD_DEPARTAMENTO
            dataType: varchar2
        }
    )

    pageItem P389_COD_DISTRITO (
        type: popupLov
        label {
