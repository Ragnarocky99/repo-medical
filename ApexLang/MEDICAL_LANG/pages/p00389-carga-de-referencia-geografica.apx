    pageItem P389_DESC_PAIS (
        type: textField
        label {
            label: <p>Descripción País: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-referencia-geografica
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @carga-de-referencia-geografica
            column: DESC_PAIS
            dataType: varchar2
        }
    )

    pageItem P389_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-referencia-geografica
            slot: regionBody
        }
        source {
            formRegion: @carga-de-referencia-geografica
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P389_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P389_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P389_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-desc-ciudad (
        name: Setear Desc Ciudad
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P389_COD_CIUDAD
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descripcion
                    from few_ciudades
                    where COD_CIUDAD = :P389_COD_CIUDAD
                    ```
                itemsToSubmit: P389_COD_CIUDAD
            }
            affectedElements {
                selectionType: items
                items: P389_DESC_CIUDAD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-desc-depto (
        name: Setear Desc Depto
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P389_COD_DEPARTAMENTO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    	SELECT d.descripcion
                    	FROM FEW_DEPARTAMENTOS D
                    	WHERE D.COD_DEPARTAMENTO = :P389_COD_DEPARTAMENTO;
                    ```
                itemsToSubmit: P389_COD_DEPARTAMENTO
            }
            affectedElements {
                selectionType: items
                items: P389_DESC_DEPARTAMENTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-desc-distrito (
        name: Setear Desc Distrito
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P389_COD_DISTRITO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descripcion
                    from few_distritos
                    where cod_distrito = :P389_COD_DISTRITO
                    ```
                itemsToSubmit: P389_COD_DISTRITO
            }
            affectedElements {
                selectionType: items
                items: P389_DESC_DISTRITO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-descripcion (
        name: Setear Descripcion
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P389_COD_PAIS
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    	SELECT p.descripcion
                    	FROM FEW_PAISES p
                    	WHERE p.COD_pais = :P389_COD_pais;
                    ```
                itemsToSubmit: P389_COD_PAIS
            }
            affectedElements {
                selectionType: items
                items: P389_DESC_PAIS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 22368888622993184
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-referencia-geografica (
        name: Initialize form Carga de Referencia Geografica
        type: formInitialization
        formRegion: @carga-de-referencia-geografica
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22368023395993184
        }
    )

    process process-form-carga-de-referencia-geografica (
        name: Process form Carga de Referencia Geografica
        type: formAutoRowProcessing
        formRegion: @carga-de-referencia-geografica
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 22368484242993184
        }
    )

)

