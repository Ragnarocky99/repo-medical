        type: textField
        label {
            label: <p>Descripción Distrito: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-referencia-geografica
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
