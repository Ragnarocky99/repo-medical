        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-referencia-geografica
            column: COD_DISTRITO
            dataType: varchar2
        }
    )

    pageItem P389_COD_PAIS (
        type: popupLov
        label {
            label: <p>Código País: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
