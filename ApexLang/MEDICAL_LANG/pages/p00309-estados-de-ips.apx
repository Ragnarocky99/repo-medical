page 309 (
    name: Estados de IPS
    alias: ESTADOS-DE-IPS
    title: Estados de IPS
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region estados-de-ips (
        name: Estados de IPS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COD_ESTADO,
                       DESCRIPCION,
                       COD_USUARIO_AUD
                  from RHW_ESTADOS_IPS
                 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 310
                items: {
                    P310_COD_ESTADO: \#COD_ESTADO#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 10457587596734926
        }

        column COD_ESTADO (
            type: plainText
            heading {
                heading: Cód. Estado
                alignment: center
            }
            layout {
                sequence: 0
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cód. Usuario Aud
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            orientation: portrait
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #a7a3a3
        }
        pageHeader {
            pageHeaderText:
                ```
                Estados de IPS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        columnHeadings {
            backgroundColor: #ffffff
        }
        pageFooter {
            fontSize: 8
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 104649 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_ESTADO (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 3
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @estados-de-ips
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 310
                clearCache: 310
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @estados-de-ips
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @estados-de-ips
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

