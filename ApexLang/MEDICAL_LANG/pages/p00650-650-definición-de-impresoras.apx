            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    button save (
        buttonName: SAVE
        label: Guardar
        layout {
            sequence: 10
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
    )

    process definición-de-impresoras-save-interactive-grid-data (
        name: Definición de Impresoras - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @definición-de-impresoras
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 114061038743621295
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process impresoras-usuarios-save-interactive-grid-data (
        name: Impresoras-Usuarios - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @impresoras-usuarios
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 114066521406621298
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process settear-empresa-definición (
        name: Settear empresa -Definición
        type: executeCode
        editableRegion: @definición-de-impresoras
        source {
            plsqlCode: :ID_EMPRESA := :P0_ID_EMPRESA;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 56325604038247203
        }
    )

    process settear-empresa-usuario (
        name: Settear empresa - Usuario
        type: executeCode
        editableRegion: @impresoras-usuarios
        source {
            plsqlCode: :ID_EMPRESA := :P0_ID_EMPRESA;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 56325899502247205
        }
    )

    process settear-impresora-usuario (
        name: Settear impresora - Usuario
        type: executeCode
        editableRegion: @impresoras-usuarios
        source {
            plsqlCode: :IMPRESORA := '';
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 56326096631247207
        }
    )

    process settear-sucursal-usuario (
        name: Settear sucursal - Usuario
