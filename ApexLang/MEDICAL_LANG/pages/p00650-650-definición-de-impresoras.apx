page 650 (
    name: 650. Definición de Impresoras
    alias: 650-DEFINICIÓN-DE-IMPRESORAS
    title: 650. Definición de Impresoras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            h1{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size: large;
            }
            .solo-mostrar{
                background-color:#eeeeee;
                width: 121px;
                height: 23px;
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .cambio{
                    vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            .timbrado{
                background-color:#eeeeee;
                width: 100px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .totales{
                text-align: center;
                font-size: 13.5px;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            .a-GV-rowLabel{display:none;}
            
            .Numeros{
                font-weight: bold;
            }
            .Numeros1{
                font-weight: bold;
                background-color: #f4f9f2;
            }
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            canvas#image-preview{  
            text-align: center;  
            margin-left: 100px;  
            margin-top: 30px;  
            border: 1px solid black; 
             width: 240px !important;
            }
            
            label {
              margin-left: 1px;
              align-self: flex-start; /* Align labels to the start of the container */
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region definición-de-impresoras (
        name: Definición de Impresoras
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: BSW_IMPRESORAS
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 227394545294424539
        }

        savedReport 1133405 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_SUCURSAL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IMPRESORA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ID_USUARIO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TIPO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ESTADO
                layout {
                    sequence: 8
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRIPCION (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ESTADO (
            type: checkbox
            heading {
                heading: <p>Estado</p>
            }
            settings {
                useDefaults: false
                checkedValue: A
                uncheckedValue: I
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_SUCURSAL (
            type: popupLov
            heading {
                heading: <p>Sucursal</p>
            }
            settings {
                title: Sucursal
            }
            lov {
                type: sharedComponent
                lov: @bsw-sucursales-cod-sucursal
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 5
            }
            source {
                databaseColumn: ID_SUCURSAL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_USUARIO (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ID_USUARIO
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IMPRESORA (
            type: textField
            heading {
                heading: <p>Dirección Impresora</p>
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: IMPRESORA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPO (
            type: selectList
            heading {
                heading: <p>Tipo de Impresora</p>
            }
            lov {
                type: staticValues
                staticValues: STATIC:CHEQUE;CHEQUE,FLEJE;FLEJE,BARRA;BARRA
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: TIPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Definición de Impresoras
        }
    )

