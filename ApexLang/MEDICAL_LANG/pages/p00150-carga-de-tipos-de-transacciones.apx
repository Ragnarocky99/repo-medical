page 150 (
    name: Carga de Tipos de Transacciones
    alias: CARGA-DE-TIPOS-DE-TRANSACCIONES
    title: Carga de Tipos de Transacciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tipos-de-transacciones (
        name: Carga de Tipos de Transacciones
        type: form
        source {
            location: localDatabase
            tableName: BSW_TIPOS_TRANS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P150_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 30
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P150_CONTABILIZA (
        type: checkbox
        label {
            label: <p>Contabiliza</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 80
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: CONTABILIZA
            dataType: varchar2
        }
    )

    pageItem P150_COSTO_X_SERVIC (
        type: checkbox
        label {
            label: <p>Costo por Servicio</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 90
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: COSTO_X_SERVIC
            dataType: varchar2
        }
    )

    pageItem P150_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 40
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P150_ESTADO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 110
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: ESTADO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P150_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_TIPOS_TRANS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P150_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P150_ID_MODULO (
        type: popupLov
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Módulo:</a>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @bsw-modulos-cod-modulo
        }
        layout {
            sequence: 40
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: ID_MODULO
            dataType: number
        }
    )

    pageItem P150_IMPRIME_COMPROB (
        type: checkbox
        label {
            label: <p>Imprime Comprobante</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 100
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: IMPRIME_COMPROB
            dataType: varchar2
        }
    )

    pageItem P150_TIPO_TRANS (
        type: numberField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Tipo de Transacción:</a>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: TIPO_TRANS
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P150_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P150_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P150_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 17156211549799764
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tipos-de-transacciones (
        name: Initialize form Carga de Tipos de Transacciones
        type: formInitialization
        formRegion: @carga-de-tipos-de-transacciones
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17155410693799764
        }
    )

    process process-form-carga-de-tipos-de-transacciones (
        name: Process form Carga de Tipos de Transacciones
        type: formAutoRowProcessing
        formRegion: @carga-de-tipos-de-transacciones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 17155821443799764
        }
    )

)

