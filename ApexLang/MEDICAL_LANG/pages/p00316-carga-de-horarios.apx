page 316 (
    name: Carga de Horarios
    alias: CARGA-DE-HORARIOS
    title: Carga de Horarios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P316_COD_HORARIO").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-horarios (
        name: Carga de Horarios
        type: form
        source {
            location: localDatabase
            tableName: RHW_HORARIOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P316_ACTIVO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 220
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-horarios
            column: ACTIVO
            dataType: varchar2
        }
    )

    pageItem P316_CHK_CALCULAR (
        type: checkbox
        label {
            label: <p>Chk Calcular</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 210
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-horarios
            column: CHK_CALCULAR
            dataType: varchar2
        }
    )

    pageItem P316_COD_HORARIO (
        type: textField
        label {
            label: <p>Código Horario: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-horarios
            column: COD_HORARIO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(H.COD_HORARIO)), 0) + 1 FROM RHW_HORARIOS H WHERE H.ID_EMPRESA = :P0_ID_EMPRESA
        }
    )

    pageItem P316_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 160
            region: @carga-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-horarios
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P316_DESCONTAR (
        type: numberField
        label {
            label: <p>Descontar: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 130
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-horarios
            column: DESCONTAR
            dataType: number
        }
    )

    pageItem P316_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @carga-de-horarios
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P316_DIRECCION_IP (
        type: textField
        label {
            label: <p>Dirección IP: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 150
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        advanced {
            cssClasses: readOnly
        }
        source {
            formRegion: @carga-de-horarios
            column: DIRECCION_IP
            dataType: varchar2
        }
    )

    pageItem P316_DOBLE_ENTRADA (
        type: checkbox
        label {
            label: <p>Doble Entrada</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 170
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-horarios
            column: DOBLE_ENTRADA
            dataType: varchar2
        }
    )

    pageItem P316_HORAS_CUMPLIR (
        type: numberField
        label {
            label: <p>Horas Cumplir: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 140
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-horarios
            column: HORAS_CUMPLIR
            dataType: number
        }
    )

    pageItem P316_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-horarios
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P316_ID_CATEGORIA_HOR (
        type: popupLov
        label {
            label: <p>Categoría Horario: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @rhw-categorias-horario-cod-categoria-horario
            displayExtraValues: false
            nullDisplayValue: --Sin seleccionar--
        }
        layout {
            sequence: 110
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-horarios
            column: ID_CATEGORIA_HOR
            dataType: number
        }
    )

    pageItem P316_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
