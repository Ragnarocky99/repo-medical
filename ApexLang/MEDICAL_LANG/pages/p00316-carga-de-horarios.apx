        }
    )

    pageItem P316_IND_ROTATIVO (
        type: checkbox
        label {
            label: <p>Indicador Rotativo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 180
            region: @carga-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
