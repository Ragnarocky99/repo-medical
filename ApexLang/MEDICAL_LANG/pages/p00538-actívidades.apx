page 538 (
    name: actívidades
    alias: ACTÍVIDADES
    title: Actívidades
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region actividades (
        name: Actividades
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.id,
                       c.id_actividad,
                       c.titulo_actividad,
                       c.fec_inicio,
                       c.FEC_TERMINO_ESTIMADO,
                       c.fec_termino,
                       c.nivel,
                       c.TIPO_ESTADO,
                       c.descripcion,
                       (c.PORC_AVANCE * 100)||'%' PORC_AVANCE ,
                       c.cod_usuario ,
                        (case when c.ID_SUB_ACTIVIDAD is null then 
                                                  'ACTIVIDAD'
                                        ELSE 'SUB_ACTIVIDAD' END) CATEGORIA,
                        C.siguiente_Actividad, c.NOMBRE
                
                  from bpmv_actividad_gantt c
                   where c.cod_empresa = :P0_ID_EMPRESA
                  and  (c.id_estado = :P538_ESTADO or :P538_ESTADO is null)
                  and  (c.cod_usuario = :P538_USUARIO or :P538_USUARIO is null)
                  and (c.fec_inicio >= :P538_FEC_INICIAL or :P538_FEC_INICIAL is null)
                  and (c.fec_inicio <= :P538_FEC_FINAL or :P538_FEC_FINAL is null)
                   start with C.ID_SUB_ACTIVIDAD is null
                  connect by prior C.ACTIVIDAD_PADRE= C.ID_SUB_ACTIVIDAD
                ```
            pageItemsToSubmit: [
                P538_USUARIO
                P538_ESTADO
                P538_FEC_INICIAL
                P538_FEC_FINAL
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchButtonLabel: 50
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 83359822209452641
        }

