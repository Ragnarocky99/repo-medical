        series grafico-pendiente (
            name: GRAFICO_PENDIENTE
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  c.descripcion,
                            COUNT(C.descripcion) CANTIDAD
                      from bpmv_actividad_gantt c
                      where c.cod_empresa = :P0_ID_EMPRESA
                      and  (c.id_estado = :P538_ESTADO or :P538_ESTADO is null)
                      and  (c.cod_usuario = :P538_USUARIO or :P538_USUARIO is null)
                      and (c.fec_inicio >= :P538_FEC_INICIAL or :P538_FEC_INICIAL is null)
                      and (c.fec_inicio <= :P538_FEC_FINAL or :P538_FEC_FINAL is null)
                       start with C.ID_SUB_ACTIVIDAD is null
                      connect by prior C.ACTIVIDAD_PADRE= C.ID_SUB_ACTIVIDAD
                      GROUP BY c.descripcion
                    ```
                pageItemsToSubmit: [
                    P538_USUARIO
                    P538_ESTADO
                    P538_FEC_INICIAL
                    P538_FEC_FINAL
                ]
            }
            columnMapping {
                label: DESCRIPCION
                value: CANTIDAD
            }
            label {
                show: true
            }
        )

    )

