    region actividades-gantt (
        name: Actividades Gantt
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                js-showMaximizeButton
                t-Region--showIcon
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: gantt
            regionDisplaySelector: true
        }
        chart {
            type: gantt
        }
        chartLayout {
            height: 400
        }
        settings {
            showHorizontalGrid: true
            showVerticalGrid: true
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        tooltip {
            showRow: false
            showBaseline: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                
                    var event = new Date();
                    // Define Reference Object line on the chart
                    var constantLine = [ { value: event.toISOString() } ];
                    
                    // Set the referenceObjects option as part of the chart initialization
                    options.referenceObjects = constantLine;
                    
                    return options;
                }
                ```
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select c.cod_empresa,
                           c.id,
                           c.id_actividad,
                           c.titulo_actividad,
                           c.fec_inicio,
                           c.FEC_TERMINO_ESTIMADO,
                           c.fec_termino,
                           c.nivel,
                           c.TIPO_ESTADO,
                           c.descripcion,
                           c.PORC_AVANCE,
                           c.cod_usuario , c.id_estado, c.nombre,
                           (select min(fec_inicio) -5 from bpmv_actividad_gantt) gantt_start_date,
                           (select max(fec_termino) from bpmv_actividad_gantt)  gantt_end_date, c.id_sub_actividad
                    
                      from bpmv_actividad_gantt c
                      where c.cod_empresa = :P0_ID_EMPRESA
                      and  (c.id_estado = :P538_ESTADO or :P538_ESTADO is null)
                      and  (c.cod_usuario = :P538_USUARIO or :P538_USUARIO is null)
                      and (c.fec_inicio >= :P538_FEC_INICIAL or :P538_FEC_INICIAL is null)
                      and (c.fec_inicio <= :P538_FEC_FINAL or :P538_FEC_FINAL is null)
                       start with C.ID_SUB_ACTIVIDAD is null
                      connect by prior C.ACTIVIDAD_PADRE= C.ID_SUB_ACTIVIDAD
                    
                    ```
                pageItemsToSubmit: [
                    P538_ESTADO
                    P538_USUARIO
                    P538_FEC_INICIAL
                    P538_FEC_FINAL
                ]
            }
            timeline {
                startDateSourceType: databaseColumn
                startDateColumn: GANTT_START_DATE
                endDateSourceType: databaseColumn
                endDateColumn: GANTT_END_DATE
            }
            columnMapping {
                rowId: ID_SUB_ACTIVIDAD
                rowName: TITULO_ACTIVIDAD
                taskId: ID_ACTIVIDAD
                taskName: NOMBRE
                taskStartDate: FEC_INICIO
                taskEndDate: FEC_TERMINO
                progress: PORC_AVANCE
            }
            appearance {
                taskCssClasses: u-color-32
                progressCssClasses: u-color-32
                baselineCssClasses: u-color-32
            }
            label {
                show: true
                fontColor: #191414
            }
        )

        axis major (
            name: major
            showAxis: false
            timeScale {
                scale: months
            }
        )

        axis minor (
            name: minor
            timeScale {
                scale: months
            }
            zoomScale {
                days: false
                weeks: false
                months: false
                quarters: false
            }
        )

