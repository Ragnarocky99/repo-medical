    dynamicAction carga-id-habilitacion-nueva-fila (
        name: Carga id_habilitacion_nueva_fila
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detalles-cierre
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT HB.ID
                    FROM CCW_HABILITACIONES HB
                    WHERE HB.FEC_CIERRE IS NULL
                      AND HB.ID_USUARIO = TRAE_ID_USUARIO(P_EMPRESA =>  :P0_ID_EMPRESA
                                                         ,P_COD_USUARIO => :APP_USER)
                    ```
                itemsToSubmit: ID_HABILITACION
            }
            affectedElements {
                selectionType: columns
                columns: ID_HABILITACION
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction subtipo-efectivo (
        name: Subtipo = Efectivo
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles-cierre
            columns: ID_SUBTIPO_TRANS
        }
        clientSideCondition {
            type: itemColumn=value
            column: ID_SUBTIPO_TRANS
            value: 538
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: columns
                columns: MONTO_REAL
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: columns
                columns: MONTO_REAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation validartotal (
        name: ValidarTotal
        execution {
            sequence: 20
        }
        validation {
            type: item!=Value
            item: P210_MONTO_REAL
            value: 0
        }
        error {
            errorMessage: Inserte monto para poder cerrar caja.
            displayLocation: inlineWithField
            associatedItem: @P210_MONTO_REAL
        }
    )

    computation p210-id-habilitacion (
        itemName: P210_ID_HABILITACION
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT HB.ID
                FROM CCW_HABILITACIONES HB
                WHERE HB.FEC_CIERRE IS NULL
                  AND HB.ID_USUARIO = TRAE_ID_USUARIO(P_EMPRESA =>  :P0_ID_EMPRESA
                                                     ,P_COD_USUARIO => :APP_USER)
                ```
        }
    )

    process actualizar-fec-hora-cierre (
        name: Actualizar_Fec_Hora_Cierre
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update ccw_habilitaciones set hora_cierre = to_char(sysdate, 'HH24:MI:SS'),
                fec_cierre = sysdate, saldo_cierre = to_number(replace(:P210_MONTO_REAL, '.',''))
                where id = :P210_ID_HABILITACION;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 26776745714219940
        }
    )

