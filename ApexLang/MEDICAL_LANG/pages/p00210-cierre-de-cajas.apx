    region cierre-de-cajas (
        name: Cierre de Cajas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT HAB.ID,
                       HAB.ID_EMPRESA,
                       HAB.ID_SUCURSAL,
                       HAB.ID_CAJA,
                       HAB.NRO_HABILITACION,
                       HAB.FEC_HABILITACION,
                       HAB.FEC_CIERRE,
                       HAB.ID_USUARIO,
                       HAB.HORA_HABILITACION,
                       HAB.HORA_CIERRE,
                       HAB.FEC_ALTA,
                       HAB.COD_SECTOR_VEN,
                       HAB.COD_USUARIO_AUD,
                       HAB.SALDO_INICIAL,
                       HAB.ESTADO,
                       HAB.IND_DEPOSITO,
                       SUC.DESCRIPCION DESC_SUC,
                       SUC.COD_SUCURSAL,
                       CAJ.DESCRIPCION DESC_CAJ,
                       CAJ.COD_CAJA, 
                       US.COD_USUARIO
                  FROM CCW_HABILITACIONES HAB, BSW_SUCURSALES SUC, CCW_CAJAS CAJ, BSW_USUARIOS US
                  WHERE HAB.ID_EMPRESA  = :P0_COD_EMPRESA 
                  AND   HAB.ID_SUCURSAL = :P0_COD_SUCURSAL
                  AND   HAB.ID_USUARIO  = US.ID
                  AND   US.COD_USUARIO  = :APP_USER
                  AND   SUC.ID          = :P0_COD_SUCURSAL
                  AND   HAB.ID_CAJA     = CAJ.ID
                  AND   HAB.HORA_CIERRE IS NULL
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound:
                ```
                
                <div class="warning-msg">
                  <center><i class="fa fa-warning"></i>
                  No existe caja habilitada.</center>
                </div>
                ```
        }

