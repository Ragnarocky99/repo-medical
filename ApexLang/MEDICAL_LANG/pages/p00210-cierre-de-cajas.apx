    region detalles-cierre (
        name: Detalles_Cierre
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT HD.ID,
                       HD.ID_EMPRESA,
                       HD.ID_HABILITACION,
                       HD.ID_SUBTIPO_TRANS,
                       HD.ID_MONEDA,
                       HD.TIPO_CAMBIO,
                       HD.CANTIDAD,
                       HD.MONTO_REAL,
                       HD.MONTO_SISTEMA,
                       HD.OBSERVACION,
                       HD.IND_VERIFICADO,
                       HD.COD_USUARIO_AUD,
                       HD.TIPO
                
                  FROM CCW_HABILITACIONES_DETALLE HD, CCW_HABILITACIONES HAB
                  WHERE HD.ID_HABILITACION = HAB.ID
                  AND HAB.FEC_CIERRE IS NULL
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: det
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ID_HABILITACION
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: saveButton
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 27292293099624125
        }

