    dynamicAction trae-desc-cuenta (
        name: trae_desc_cuenta
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P475_CUENTA
        }

        action native-set-value (
            name: P475_DESC_CUENTA
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare 
                     vdesc varchar2(200);
                     begin
                            begin
                                     select upper(c.referencia)
                                      into vdesc
                                      from ccw_cuentas_bancarias c
                                     where c.nro_cuenta = :P475_CUENTA;
                              exception
                               when others then 
                                 vdesc := 'TODOS';
                             end;
                         return vdesc;
                     end;
                    ```
                itemsToSubmit: P475_CUENTA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P475_DESC_CUENTA
            }
            execution {
                sequence: 10
            }
        )

    )

