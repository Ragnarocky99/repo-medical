    region extracto-2 (
        name: Extracto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                  c.ID,
                  c.COD_BANCO,
                  c.NRO_CUENTA,
                  c.ORDEN,
                  CASE
                    WHEN c.TIP_COMPROBANTE = 'COB' THEN 'CAJ'
                    ELSE c.TIP_COMPROBANTE
                  END AS TIP_COMPROBANTE,
                  c.SER_COMPROBANTE,
                  c.NRO_COMPROBANTE,
                  c.FEC_COMPROBANTE,
                  c.FEC_EMISION,
                  c.FEC_VENCIMIENTO,
                  c.BENEFICIARIO,
                  c.BANCO,
                  c.COD_MONEDA,
                  c.DESCRIPCION,
                  c.TOT_DEBITO,
                  c.TOT_CREDITO,
                  c.ANULADO,
                  c.REFERENCIA,
                  decode(c.ord,1,'SALDO ANTERIOR',c.DETALLE) DETALLE,
                  c.DECIMALES,
                  c.ID_EMPRESA,
                  c.ID_PER_JURIDICA,
                  c.ORD,
                  c.CUENTA_PRINCIPAL,
                  c.CUENTA_SECUNDARIA,
                  CASE c.TIP_COMPROBANTE
                    WHEN 'DEP' THEN 'f?p=&APP_ID.:341:&SESSION.::NO::P341_ID:' || c.ID
                    WHEN 'BCR' THEN 'f?p=&APP_ID.:236:&SESSION.::NO::P236_ID:' || c.ID
                    WHEN 'TRB' THEN 'f?p=&APP_ID.:199:&SESSION.::NO::P199_ID:' || c.ID
                    WHEN 'COB' THEN 'f?p=&APP_ID.:75:&SESSION.::NO::P75_ID:' || c.ID
                    WHEN 'CAJ' THEN 'f?p=&APP_ID.:238:&SESSION.::NO::P238_ID:' ||c.ID
                    ELSE NULL
                  END AS REFLINK,
                  CASE c.TIP_COMPROBANTE
                    WHEN 'DEP' THEN 'fa fa-search'
                    WHEN 'BCR' THEN 'fa fa-search'
                    WHEN 'TRB' THEN 'fa fa-search'
                    WHEN 'COB' THEN 'fa fa-search'
                    WHEN 'CAJ' THEN 'fa fa-search'
                    ELSE NULL
                  END AS ICON,
                  CASE
                    WHEN c.ord <> 1 THEN calcula_saldo_bancario(c.NRO_CUENTA, c.COD_BANCO, 121, to_date(:P475_FEC_INI, 'dd/mm/yyyy'), to_date(:P475_FEC_FIN, 'dd/mm/yyyy'), c.tip_comprobante, c.ser_comprobante, c.NRO_COMPROBANTE)
                    ELSE CHW_SALDO_ANTERIOR_FORMULA(c.ID_EMPRESA, c.ID_PER_JURIDICA, c.NRO_CUENTA, to_date(:P475_FEC_INI, 'dd/mm/yyyy'), c.DECIMALES)
                  END AS saldo_anterior
                FROM chvw_prueba_bancaria c
                WHERE c.ID_EMPRESA = :P0_ID_EMPRESA
                  ------AND (c.ID_PER_JURIDICA = :P475_BANCO OR :P475_BANCO IS NULL)
                  AND (c.nro_cuenta = :P475_CUENTA OR :P475_CUENTA IS NULL)
                  AND (TO_DATE(/*C.FEC_COMPROBANTE*/C.FEC_VENCIMIENTO, 'DD/MM/YY') BETWEEN TO_DATE(:P475_FEC_INI, 'DD/MM/YY') AND TO_DATE(:P475_FEC_FIN, 'DD/MM/YY') OR c.ORD = 1)
                
                ```
            pageItemsToSubmit: [
                P475_FEC_INI
                P475_FEC_FIN
                P475_BANCO_2
                P475_CUENTA
            ]
        }
