    region extracto (
        name: Extracto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n001 as id,
                       c002 as cod_banco,
                       c003 as nro_cuenta,
                       c004 as orden,
                       c005 as tip_comprobante,
                       c006 as ser_comprobante,
                       c007 as nro_comprobante,
                       c008 as fec_comprobante,
                       c009 as fec_emision,
                       C010 as fec_vencimiento, 
                       c011 as benificiario,
                       c012 as banco,
                       c013 as cod_moneda,
                       c014 as descripcion,
                       TO_NUMBER(c015) as tot_debito,
                       TO_NUMBER(c016) as tot_credito,
                       c017 as anulado,
                       c018 as referencia,
                       c019 as detalle,
                       c020 as decimales,
                       c021 as id_empresa,
                       c022 as id_per_juridica,
                       c023 as ord,
                       c024 as cuenta_principal,
                       c025 as cuenta_secundaria,
                       c026 as reflink,
                       c027 as icon,
                       TO_NUMBER(c028) as saldo_anterior,
                       c030 as conciliado,
                       c031 as fec_conciliado,
                       case nvl(c030,'N')
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       end as CONCILIADO_ICON,
                       SEQ_ID
                 from apex_collections
                where collection_name = 'CCW_EXTRACTO_BANCARIO'
                  and (nvl(c030,'N') = :P475_ESTADO or :P475_ESTADO is null)
                  ORDER BY SEQ_ID
                ```
            pageItemsToSubmit: [
                P475_FEC_INI
                P475_FEC_FIN
                P475_BANCO_2
                P475_CUENTA
                P475_ESTADO
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
