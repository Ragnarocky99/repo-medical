        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare 
                     vdesc varchar2(200);
                     begin
                            begin
                                    select upper(nvl(p.nomb_fantasia, p.nombre))
                                      into vdesc
                                      from bsw_personas p
                                     where p.id = :P475_BANCO;
                              exception
                               when others then 
                                 vdesc := 'TODOS';
                             end;
                         return vdesc;
                     end;
                    ```
                itemsToSubmit: P475_BANCO
            }
            affectedElements {
                selectionType: items
                items: P475_DESC_BANCO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process generar-extracto (
        name: Generar Extracto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                V_FEC_INI DATE :=TO_DATE('01/01/2022','DD/MM/YYYY');
                  /*TO_DATE('01'||TO_CHAR(SYSDATE,'MM/YYYY'),'DD/MM/YYYY')*/
                V_FEC_FIN DATE := LAST_DAY(SYSDATE);
                
                BEGIN
                  CCW_GENERA_EXTRACTO_BANCARIO2(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                               P_FEC_INI => NVL(:P475_FEC_INI,V_FEC_INI),
                                               P_FEC_FIN => NVL(:P475_FEC_FIN,V_FEC_FIN),
                                               P_NRO_CUENTA => :P475_CUENTA,
                                               P_NRO_PLANILLA => NULL);
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 57779486891896926
        }
    )

    process generar-extracto-inicial (
        name: Generar Extracto Inicial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                V_FEC_INI DATE :=TO_DATE('01/01/2022','DD/MM/YYYY');
                  /*TO_DATE('01'||TO_CHAR(SYSDATE,'MM/YYYY'),'DD/MM/YYYY')*/
                V_FEC_FIN DATE := LAST_DAY(SYSDATE);
                
                BEGIN
                  CCW_GENERA_EXTRACTO_BANCARIO(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                               P_FEC_INI => NVL(:P475_FEC_INI,V_FEC_INI),
                                               P_FEC_FIN => NVL(:P475_FEC_FIN,V_FEC_FIN),
                                               P_NRO_CUENTA => :P475_CUENTA,
                                               P_NRO_PLANILLA => NULL);
                     exception
                       when others then
                                                null;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 57779048309896926
        }
    )

