        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Extracto
        }

        savedReport 885537 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BANCO (
                sequence: 7
