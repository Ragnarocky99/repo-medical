page 191 (
    name: Lista de Nota de Envios
    alias: LISTA-DE-NOTA-DE-ENVIOS
    title: Lista de Nota de Envios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-de-nota-de-envios (
        name: Lista de Nota de Envios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ID,
                       A.ID_EMPRESA,
                       A.TIP_ENVIO,
                       A.NRO_ENVIO,
                       A.ID_SUCURSAL,
                       A.ID_SUCURSAL_ENT,
                       A.FECHA,
                       A.SER_ENVIO,
                       A.DESC_SUCUR_ENT,
                       A.COD_USUARIO_AUD,
                       A.ID_CLIENTE,
                       A.REFERENCIA,
                       NVL((SELECT B.IND_RECEPCION FROM STW_NOTAS_ENVIO_DET B
                            WHERE IND_RECEPCION = 'N'
                            AND B.ID_NRO_ENVIO_CAB = A.ID
                            GROUP BY B.IND_RECEPCION), 'S') AS IND_RECEPCION,
                       CASE   nvl((SELECT B.IND_RECEPCION FROM STW_NOTAS_ENVIO_DET B
                            WHERE IND_RECEPCION = 'N'
                            AND B.ID_NRO_ENVIO_CAB = A.ID
                            GROUP BY B.IND_RECEPCION), 'S') 
                            WHEN 'S' THEN 'fa fa-check u-success-text'
                      WHEN 'N' THEN 'fa fa-remove u-danger-text'
                         END ICONO,
                      A.FEC_ALTA,
                      A.COD_USUARIO_MOD,
                      A.FEC_MODIFICACION
                  from STW_NOTAS_ENVIO_CAB A
                  WHERE ID_EMPRESA = :P0_COD_EMPRESA
                    and (ID_SUCURSAL = :P0_COD_SUCURSAL OR ID_SUCURSAL_ENT = :P0_COD_SUCURSAL)
                    
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 84
                items: {
                    P84_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 43812600396629145
        }

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
