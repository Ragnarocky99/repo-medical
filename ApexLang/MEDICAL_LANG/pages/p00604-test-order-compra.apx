    process carga-json (
        name: Carga_json
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    json_detalle CLOB;
                    l_cursor SYS_REFCURSOR;
                    filename    VARCHAR2(255);
                    blob_content blob;
                    mimetype VARCHAR2(255);
                    v_name_collec CONSTANT varchar2(255) := 'DETALLE';
                
                    CURSOR c_files IS
                        WITH files AS (
                            SELECT blob_content,
                                   filename
                            FROM apex_application_temp_files
                            ORDER BY created_on DESC
                        FETCH FIRST 1 ROW ONLY
                    )
                    
                    SELECT line_number, 
                        col001 AS variante, 
                        col002 AS ean,
                        col003 AS desc_articulo,
                        col004 as cantidad,
                        col005 as precio,
                        row_info
                    FROM files f
                    CROSS JOIN TABLE(apex_data_parser.parse(
                        p_content   => f.blob_content,
                        p_file_name => f.filename
                    )) excel
                    WHERE line_number > 1
                    ;
                
                --JSON
                BEGIN
                   IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => v_name_collec) THEN
                       APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => v_name_collec);
                   END IF;
                   APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => v_name_collec);
                   
                   FOR rec IN c_files LOOP
                        apex_collection.add_member(
                            p_collection_name => v_name_collec,
                            p_c001 => rec.variante,
                            p_c002 => rec.ean,
                            p_c003 => rec.desc_articulo,
                            p_c004 => rec.cantidad,
                            p_c005 => rec.precio
                        ); 
                       -- raise_application_error(-20000,'entra en loop');
                    end loop;
                END;
                
                
                DECLARE
                  l_cursor SYS_REFCURSOR;
                  json_detalle CLOB;
                  V_PRUEBA      VARCHAR2(5);
                BEGIN
                    :P604_JSON_DETALLE:='';
                    OPEN l_cursor FOR
                        SELECT  C001 AS id_,
                                C002 AS cod,
                                C003 AS desc_articulo,
                                C003 AS can,
                                c004 AS pre
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'DETALLE'
                        ORDER BY TO_NUMBER(C001) DESC;
                
                  APEX_JSON.initialize_clob_output;
                  APEX_JSON.open_object;
                  APEX_JSON.write('DETALLE', l_cursor);
                  APEX_JSON.close_object;
                  JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                  :P604_JSON_DETALLE:=JSON_DETALLE;
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 7429925258083722
        }
        serverSideCondition {
            type: never
        }
    )

    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                             
                             
                
                             --SELECT REPLACE(:TOTAL_IVA,'.','') INTO :TOTAL_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL_C_IVA,'.','') INTO :MONTO_TOTAL_C_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL,'.','') INTO :MONTO_TOTAL  FROM DUAL;
                
                               
                               IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                              :DESCUENTO:=(NVL(:DESCUENTO_C_IVA,0))-(NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0))));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              
                              END IF;
                
                                insert into CMW_PEDIDOS_DETALLE 
                                (ID_ARTICULO,ID_PEDIDO_CAB,CANTIDAD,ID_IVA,TOTAL_IVA,MONTO_TOTAL_C_IVA,
                                PRECIO_UNITARIO_C_IVA,PRECIO_UNITARIO,ID_UNIDAD_MEDIDA,COD_USUARIO_AUD,MONTO_TOTAL,IVA,PORC_DESCUENTO
                                ,DESCUENTO_C_IVA,DESCUENTO,DESC_ARTICULO)
                                values(:ID_ARTICULO,:P604_ID,:CANTIDAD,:ID_IVA,REPLACE(:TOTAL_IVA,'.',''),
                                REPLACE(:MONTO_TOTAL_C_IVA,'.',''),REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                :PRECIO_UNITARIO,:ID_UNIDAD_MEDIDA,:COD_USUARIO_AUD,
                                REPLACE(:MONTO_TOTAL,'.',''),:PORC_IVA,:PORC_DESCUENTO,
                                :DESCUENTO_C_IVA,:DESCUENTO,:DESC_ARTICULO);
                            
                            WHEN 'U' then  
                         
                                IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                             :DESCUENTO:=NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0)));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              END IF;
                
                 
                
                                update CMW_PEDIDOS_DETALLE  d
                                    set  ID_ARTICULO = :ID_ARTICULO,
                                         cantidad     = :cantidad,
                                         precio_unitario_c_iva       = REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                         id_iva     = :ID_IVA,
                                         TOTAL_IVA    = REPLACE(:TOTAL_IVA,'.',''),
                                         monto_total  = REPLACE(:MONTO_TOTAL,'.',''),
                                         MONTO_TOTAL_C_IVA      = REPLACE(:MONTO_TOTAL_C_IVA,'.',''),
                                         PRECIO_UNITARIO=REPLACE(:PRECIO_UNITARIO,'.',''),
                                         ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                                         IVA=:IVA,
                                         PORC_DESCUENTO=:PORC_DESCUENTO,
                                         --ID_LOTE=:ID_LOTE,
                                         --NRO_LOTE=:NRO_LOTE,
                                         DESCUENTO_C_IVA=:DESCUENTO_C_IVA,
                                         DESCUENTO=:DESCUENTO,
                                         DESC_ARTICULO=:DESC_ARTICULO
                
                                where   d.ID_PEDIDO_CAB = :P604_ID
                                    and d.id = :id;
                
                           when 'D' then
                                delete CMW_PEDIDOS_DETALLE d     
                                WHERE d.ID_PEDIDO_CAB = :ID_PEDIDO_CAB
                                           and d.id = :id;  
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8523410701207268
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE,DELETE
        }
        comments {
            comments: "Proceso para guardar, actualizar, eliminar los detalles de la factura "
        }
    )

