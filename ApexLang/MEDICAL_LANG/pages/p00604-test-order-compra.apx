    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.MONTO_TOTAL_C_IVA,
                       D.IND_STOCK,
                       D.ID_PEDIDO_CAB,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PORC_DESCUENTO,
                       D.DESCUENTO,
                       D.DESCUENTO_C_IVA,
                       D.PORC_GRAVADA,
                       D.IVA,
                       D.EXENTO,
                       D.GRAVADA,
                       D.TOTAL_EXENTO,
                       D.TOTAL_GRAVADA,
                       A.DESCRIPCION AS DESC_ARTICULO,
                       D.ID_IVA,
                       D.PRECIO_UNITARIO
                  from CMW_PEDIDOS_DETALLE D,STW_ARTICULOS A
                 where ID_PEDIDO_CAB=:P604_ID
                 AND A.ID=D.ID_ARTICULO
                ```
            pageItemsToSubmit: P604_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
