    process new (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR C2 IS
                        SELECT C001, C002, C003, C004, C005
                        FROM APEX_COLLECTIONS 
                        WHERE COLLECTION_NAME = 'CSVDATACASH';
                    
                    json_detalle CLOB;
                    l_cursor SYS_REFCURSOR;
                    filename VARCHAR2(255);
                    blob_content blob;
                    mimetype VARCHAR2(255);
                    v_name_collec CONSTANT varchar2(255) := 'CSVDATACASH';
                
                    -- Definimos el cursor c_files aquí
                    CURSOR c_files IS
                        WITH files AS (
                            SELECT blob_content,
                                   filename
                            FROM apex_application_temp_files
                            ORDER BY created_on DESC
                            FETCH FIRST 1 ROW ONLY
                        )
                        SELECT line_number, 
                               col001 AS variante, 
                               col002 AS ean,
                               col003 AS desc_articulo,
                               col004 AS cantidad,
                               col005 AS precio,
                               row_info
                        FROM files f
                        CROSS JOIN TABLE(apex_data_parser.parse(
                            p_content   => f.blob_content,
                            p_file_name => f.filename
                        )) excel
                        WHERE line_number > 1;
                
                BEGIN
                    -- Parte 1: Insertar datos en la tabla temporal
                
                    FOR I IN C2
                    LOOP
                        INSERT INTO apex_application_temp_files (blob_content, filename)
                        VALUES (I.c001 || ',' || I.C002 || ',' || I.C003 || ',' || I.C004 || ',' || I.C005, 
                                'data.csv'); -- Suponiendo que deseas nombrar el archivo como "data.csv"
                    END LOOP;
                
                    -- Parte 2: Insertar datos en la colección APEX_COLLECTION
                
                    IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => v_name_collec) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => v_name_collec);
                    END IF;
                    APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => v_name_collec);
                
                    FOR rec IN c_files LOOP
                        apex_collection.add_member(
                            p_collection_name => v_name_collec,
                            p_c001 => rec.variante,
                            p_c002 => rec.ean,
                            p_c003 => rec.desc_articulo,
                            p_c004 => rec.cantidad,
                            p_c005 => rec.precio
                        ); 
                    END LOOP;
                
                    -- Parte 3: Generar el JSON
                
                    :P604_JSON_DETALLE := '';
                    OPEN l_cursor FOR
                        SELECT C001 AS id_,
                               C002 AS cod,
                               C003 AS desc_articulo,
                               C003 AS can,
                               C004 AS pre
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'CSVDATACASH'
                        ORDER BY TO_NUMBER(C001) DESC;
                
                    APEX_JSON.initialize_clob_output;
                    APEX_JSON.open_object;
                    APEX_JSON.write('CSVDATACASH', l_cursor);
                    APEX_JSON.close_object;
                    JSON_DETALLE := APEX_JSON.GET_CLOB_OUTPUT;
                    :P604_JSON_DETALLE := JSON_DETALLE;
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11084764989110030
        }
    )

