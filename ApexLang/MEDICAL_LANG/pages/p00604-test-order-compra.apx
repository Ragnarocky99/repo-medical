    dynamicAction new (
        name: New
        execution {
            sequence: 260
        }
        when {
            event: click
            selectionType: button
            button: @upload-excel
        }

        action genera-json (
            name: genera json
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        json_detalle CLOB;
                        l_cursor SYS_REFCURSOR;
                        filename    VARCHAR2(255);
                        blob_content blob;
                        mimetype VARCHAR2(255);
                        v_name_collec CONSTANT varchar2(255) := 'DETALLE_EXCEL';
                    
                        CURSOR c_files IS
                            WITH files AS (
                            SELECT blob_content,
                                   filename
                            FROM apex_application_temp_files
                            ORDER BY created_on DESC
                            FETCH FIRST 1 ROW ONLY
                        )
                        
                        SELECT line_number, 
                            col001 AS id_articulo, 
                            col002 AS cod_articulo,
                            col003 AS desc_articulo,
                            col004 as cantidad,
                            col005 as precio,
                            row_info
                        FROM files f
                        CROSS JOIN TABLE(apex_data_parser.parse(
                            p_content   => f.blob_content,
                            p_file_name => f.filename
                        )) excel
                        WHERE line_number > 1
                        ;
                    
                    
                    --JSON
                    
                    BEGIN
                       IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => v_name_collec) THEN
                           APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => v_name_collec);
                       END IF;
                       APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => v_name_collec);
                        
                        --FOR rec IN c_files LOOP
                        --    RAISE_APPLICATION_ERROR(-20000,'HAY ALGO');
                        --END LOOP;
                       FOR rec IN c_files LOOP
                            apex_collection.add_member(
                                p_collection_name => v_name_collec,
                                p_c001 => rec.id_articulo,
                                p_c002 => rec.cod_articulo,
                                p_c003 => rec.desc_articulo,
                                p_c004 => rec.cantidad,
                                p_c005 => rec.precio
                            ); 
                            --raise_application_error(-20000,'entra en loop');
                        end loop;
                    END;
                    /*
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                      V_PRUEBA      VARCHAR2(5);
                    BEGIN
                        :P604_JSON_DETALLE:='';
                        OPEN l_cursor FOR
                            SELECT  C001 AS id_,
                                    C002 AS cod,
                                    C003 AS desc_articulo,
                                    C003 AS can,
                                    c004 AS pre
                            FROM APEX_COLLECTIONS
                            WHERE COLLECTION_NAME = 'DETALLE'
                            ORDER BY TO_NUMBER(C001) DESC;
                    
                      APEX_JSON.initialize_clob_output;
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P604_JSON_DETALLE:=JSON_DETALLE;
                    END;*/
                    ```
                itemsToReturn: P604_JSON_DETALLE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                      // Function to handle the file input change event
                      function handleFile(e) {
                        const file = e.target.files[0];
                        const reader = new FileReader();
                    
                        reader.onload = function (event) {
                          const data = new Uint8Array(event.target.result);
                          const workbook = XLSX.read(data, { type: "array" });
                          const sheetName = workbook.SheetNames[0];
                          const worksheet = workbook.Sheets[sheetName];
                          
                          // Loop through each row
                          for (const cellAddress in worksheet) {
                            if (!cellAddress.startsWith("!")
                              && worksheet.hasOwnProperty(cellAddress)) {
                              const cell = worksheet[cellAddress];
                              console.log(`Cell Address: ${cellAddress}, Value: ${cell.v}`);
                            }
                          }
                        };
                    
                        reader.readAsArrayBuffer(file);
                      }
                    
                      // Attach the event listener to the file input element
                      const fileInput = document.getElementById("P604_EXCEL");
                      fileInput.addEventListener("change", handleFile);
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalles-zzz
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

