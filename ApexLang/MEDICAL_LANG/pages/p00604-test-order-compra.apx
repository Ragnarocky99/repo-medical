                ```plsql
                DECLARE
                  vmensaje varchar2(400);
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P604_FEC_COMPROBANTE) 
                    into vmensaje
                    from dual;
                    IF VMENSAJE IS NULL THEN
