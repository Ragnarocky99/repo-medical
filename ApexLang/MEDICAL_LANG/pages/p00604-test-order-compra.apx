    process new-3 (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                
                IF  APEX_COLLECTION.COLLECTION_EXISTS('CSVDATACASH') THEN
                
                    APEX_COLLECTION.TRUNCATE_COLLECTION('CSVDATACASH');
                
                END IF;
                
                
                
                IF NOT APEX_COLLECTION.COLLECTION_EXISTS('CSVDATACASH') THEN
                
                    APEX_COLLECTION.CREATE_COLLECTION('CSVDATACASH');
                
                END IF; 
                
                
                
                for r1 in (select *  from
                
                                    apex_application_temp_files f, table( apex_data_parser.parse(
                
                                                    p_content                     => f.blob_content,
                
                                                    p_add_headers_row             => 'Y',
                
                                                   -- p_store_profile_to_collection => 'FILE_PROV_CASH',
                
                                                    p_file_name                   => f.filename ) ) p
                
                                where      f.name = :P172_UPLOAD_FILES 
                
                                )
                
                
                
                        loop
                
                        APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CSVDATACASH',
                
                                                            p_C001            => nvl(REPLACE(r1.col001,'-',''),0),
                
                                                            p_c002            => nvl(REPLACE(r1.col002,'-',''),0),
                
                                                            P_C003            => nvl(REPLACE(r1.col003,'-',''),0),
                
                                                            p_c004            => nvl(REPLACE(r1.col004,'-',''),0),
                
                                                            p_c005            => nvl(REPLACE(r1.col005,'-',''),0)
                
                                                            
                
                                                            );
                
                           
                
                
                
                                
                
                        END LOOP; 
                
                
                
                    end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 11084660093110029
        }
        serverSideCondition {
            whenButtonPressed: @upload-excel
        }
    )

