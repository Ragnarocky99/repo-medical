page 755 (
    name: Reporte de Contactos del Cliente
    alias: REPORTE-DE-CONTACTOS-DEL-CLIENTE
    title: Reporte de Contactos del Cliente
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region reporte-de-contactos-del-cliente (
        name: Reporte de Contactos del Cliente
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLWV_CONTACTOS_CLIENTE
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P755_ID_CLIENTE OR :P755_ID_CLIENTE IS NULL)
                ```
            orderByClause: CLIENTE
            pageItemsToSubmit: P755_ID_CLIENTE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 26026378893094982
        }

        column CARGO_CONTACTO (
            type: plainText
            heading {
                heading: Cargo Contacto
                alignment: center
            }
            layout {
                sequence: 33
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column CORREO_CONTACTO (
            type: plainText
            heading {
                heading: Correo Contacto
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DEPARTAMENTO_CONTACTO (
            type: plainText
            heading {
                heading: Dep. Contacto
                alignment: center
            }
            layout {
                sequence: 23
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_CLIENTE (
            type: hidden
            heading {
                heading: Id Cliente
            }
            layout {
                sequence: 43
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 63
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_PERSONA_CONTACTO (
            type: hidden
            heading {
                heading: Id Persona Contacto
            }
            layout {
                sequence: 53
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column NOMBRE_CONTACTO (
            type: plainText
            heading {
                heading: Nombre Contacto
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TELEFONO_CONTACO (
            type: plainText
            heading {
                heading: Telefono Contaco
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reporte de Contactos del Cliente
        }

        savedReport 260288 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CARGO_CONTACTO (
                sequence: 6
            )

            displayColumn CLIENTE (
                sequence: 1
            )

            displayColumn CORREO_CONTACTO (
                sequence: 3
            )

            displayColumn DEPARTAMENTO_CONTACTO (
                sequence: 5
            )

            displayColumn NOMBRE_CONTACTO (
                sequence: 2
            )

            displayColumn TELEFONO_CONTACO (
                sequence: 4
            )

        )

    )

    pageItem P755_ID_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P755_ID_CLIENTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-de-contactos-del-cliente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-de-contactos-del-cliente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

