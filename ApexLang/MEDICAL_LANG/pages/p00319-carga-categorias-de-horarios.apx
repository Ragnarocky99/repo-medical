page 319 (
    name: Carga Categorias de Horarios
    alias: CARGA-CATEGORIAS-DE-HORARIOS
    title: Carga Categorias de Horarios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P319_COD_CATEGORIA_HOR").readOnly = true;
        executeWhenPageLoads:
            ```javascript-browser
            //Este script es para hacer que los elementos sea de solo lectura y no se pueden escribir en ellos 
            document.getElementById("P319_COD_CATEGORIA_HOR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-categoría-de-horarios (
        name: Carga de Categoría de Horarios
        type: form
        source {
            location: localDatabase
            tableName: RHW_CATEGORIAS_HORARIO
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar
            delete: @derechos-borrar-2
        }
    )

    pageItem P319_COD_CATEGORIA_HOR (
        type: textField
        label {
            label: <P>Concepto: &ensp;</P>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-categoría-de-horarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: COD_CATEGORIA_HOR
            dataType: varchar2
        }
    )

    pageItem P319_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 80
            region: @carga-de-categoría-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P319_DESCRIPCION (
        type: textField
        label {
            label: <P>Descripción: &ensp;</P>
            alignment: left
        }
        settings {
            textCase: upper
        }
        layout {
            sequence: 40
            region: @carga-de-categoría-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P319_DIRECCION_IP (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-categoría-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: DIRECCION_IP
            dataType: varchar2
        }
    )

    pageItem P319_HORAS (
        type: numberField
        label {
            label: <P>Horas a retrasar para la fecha: &ensp;</P>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-categoría-de-horarios
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: HORAS
            dataType: number
        }
    )

    pageItem P319_HORAS_NOCTURNAS (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-categoría-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: HORAS_NOCTURNAS
            dataType: varchar2
        }
    )

    pageItem P319_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-categoría-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P319_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-categoría-de-horarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categoría-de-horarios
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: P0_COD_EMPRESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P319_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P319_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P319_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p319-cod-categoria-hor (
        itemName: P319_COD_CATEGORIA_HOR
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT NVL(MAX(COD_CATEGORIA_HOR), 0) +1 FROM RHW_CATEGORIAS_HORARIO WHERE ID_EMPRESA = :P0_COD_EMPRESA
        }
        serverSideCondition {
            type: itemIsNull
            item: P319_ID
        }
    )

    computation p319-direccion-ip (
        itemName: P319_DIRECCION_IP
        execution {
            sequence: 20
        }
        computation {
            sqlQuery: SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL;
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12083850063446102
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-categoria-de-horarios (
        name: Initialize form Carga Categoria de Horarios
        type: formInitialization
        formRegion: @carga-de-categoría-de-horarios
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44687499748788533
        }
    )

    process process-form-carga-de-categoria-de-horarios (
        name: Process form Carga de Categoria de horarios
        type: formAutoRowProcessing
        formRegion: @carga-de-categoría-de-horarios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12083784350446101
        }
    )

)

