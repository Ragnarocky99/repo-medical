    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region propietario-fracciones (
        name: Propietario Fracciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_FRACCION,
                       NRO_ORDEN,
                       ID_CLIENTE,
                       PORC_FRACCION,
                       PORC_COM_ADMINIST,
                       IND_PROP,
                       IND_DIST,
                       IND_DEFECTO,
                       IND_RETENCION,
                       IND_RETENCION_30,
                       CUOTA_COMISION_DESDE,
                       CUOTA_COMISION_HASTA
                  from LTW_PROPIETARIO_FRACCIONES
                  WHERE ID_FRACCION = :P556_FRACCION
                  and ID_EMPRESA = :P0_ID_EMPRESA
                
                
                ```
            pageItemsToSubmit: [
                P556_FRACCION
                P0_ID_EMPRESA
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 91368731553511765
        }

