            icon: fa-eraser
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P258_FECHA_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P258_FECHA_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P258_FECHA_FIN,'/','');
                            conv_fecha := substr(:P258_FECHA_FIN,1,2)||'/'||
                                                      substr(:P258_FECHA_FIN,3,2)||'/'||
                                                      lpad(substr(:P258_FECHA_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P258_FECHA_FIN := conv_fecha;
                            ELSIF (length(:P258_FECHA_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P258_FECHA_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P258_FECHA_FIN
                itemsToReturn: P258_FECHA_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-detalle-venta
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P258_FECHA_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P258_FECHA_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P258_FECHA_INI,'/','');
                            conv_fecha := substr(:P258_FECHA_INI,1,2)||'/'||
                                                      substr(:P258_FECHA_INI,3,2)||'/'||
                                                      lpad(substr(:P258_FECHA_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P258_FECHA_INI := conv_fecha;
                            ELSIF (length(:P258_FECHA_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P258_FECHA_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P258_FECHA_INI
                itemsToReturn: P258_FECHA_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-detalle-venta
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P258_ARTICULO
                P258_SERIE
                P258_NRO_INI
                P258_NRO_FIN
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-detalle-venta
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar (
        name: LIMPIAR
        type: clearSessionState
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 58602280649018217
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    branch (
        name: Go To Page 249
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 249
                items: {
                    P258_FECHA_INI: &P258_FECHA_INI.
                    P258_FECHA_FIN: &P258_FECHA_FIN.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

