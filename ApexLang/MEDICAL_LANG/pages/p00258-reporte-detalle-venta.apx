                ```
                &P0_DESC_EMPRESA. 
                &PO_LOGIN_TIMESTAMP.
                Reporte Detalle Venta
                ```
        }
        pageFooter {
            fontSize: 8
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 585992 (
