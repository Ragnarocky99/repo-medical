page 258 (
    name: Reporte de Productos Facturados
    alias: REPORTE-DETALLE-VENTA
    title: Reporte de Productos Facturados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Roboto","Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region reporte-detalle-venta (
        name: Reporte Detalle Venta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM VTWV_VENTAS_ARTICULO_DETALLADO
                WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  AND FEC_COMPROBANTE BETWEEN TO_DATE(:P258_FECHA_INI,'DD/MM/YYYY') AND TO_DATE(:P258_FECHA_FIN,'DD/MM/YYYY') 
                  AND (NRO_COMPROBANTE BETWEEN TO_NUMBER(NVL(:P258_NRO_INI,NRO_COMPROBANTE)) 
                  AND TO_NUMBER(NVL(:P258_NRO_FIN,NRO_COMPROBANTE)))
                  AND (ID_SERIE_COMP = :P258_SERIE OR :P258_SERIE IS NULL)
                  AND (ID_ARTICULO = :P258_ARTICULO OR :P258_ARTICULO IS NULL)
                ORDER BY NRO_COMPROBANTE DESC , FEC_COMPROBANTE DESC
                ```
            pageItemsToSubmit: [
                P258_FECHA_INI
                P258_FECHA_FIN
                P258_NRO_INI
                P258_NRO_FIN
                P258_ARTICULO
                P258_SERIE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No se encontraron datos.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 58594112242998718
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: end
            }
            layout {
                sequence: 111
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
