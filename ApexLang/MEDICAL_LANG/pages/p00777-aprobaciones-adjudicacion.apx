page 777 (
    name: Aprobaciones Adjudicacion
    alias: APROBACIONES-ADJUDICACION
    title: Aprobaciones Adjudicacion
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region anulaciones-catalogo (
        name: Anulaciones Catalogo
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: LCW_OFERTAS_APROBACIONES
        }
        layout {
            sequence: 30
            parentRegion: @catalogo
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent13
                t-Region--scrollBody
                margin-top-sm
            ]
        }
        masterDetail {
            masterRegion: @aprobaciones-catalogo
        }
        edit {
            enabled: true
            allowedOperations: add
            addRowIfEmpty: false
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 39206827311335318
        }

