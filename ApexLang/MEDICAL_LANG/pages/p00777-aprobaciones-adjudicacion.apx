    region articulos (
        name: Articulos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       
                       COD_FABRICANTE,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       PRESENTACION,
                       UNIDAD_MEDIDA,
                       MARCA,
                       PLAZO_ENTREGA,
                       CANT_OFERTADA,
                       ID_EMPRESA,
                       ID_OFERTA,
                       ID_LICITACION_CAB,
                       ID_LICITACION_DET,
                       COMENTARIO_COMPRAS,
                       OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO => ID_ARTICULO,
                                                  P_ID_SUCURSAL => NULL,
                                                  P_IND_DISPONIBLE => 'S') DISPONIBILIDAD,
                       PRECIO_UNITARIO,
                       COSTO_UNITARIO_RECARGO_GS
                  from LCWV_ADJUDICACIONES
                 where ID_LICITACION_DET = :P777_ID_LICITACION_DET
                ```
            pageItemsToSubmit: P777_ID_LICITACION_DET
        }
