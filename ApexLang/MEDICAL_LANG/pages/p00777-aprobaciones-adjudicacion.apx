    dynamicAction acciones-al-cambiar-cantidad (
        name: Acciones al cambiar Cantidad
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @aprobaciones-sistema
            columns: CANTIDAD
        }

        action calcular-cantidad-reservada (
            name: Calcular Cantidad Reservada
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    PKGW_LICITACIONES.LCW_OBTIENE_CANTIDAD_RESERVADA(P_ID_OFERTA  => :ID_OFERTA,
                                                                     P_CANTIDAD   => :CANTIDAD)
                    ```
                itemsToSubmit: [
                    ID_OFERTA
                    CANTIDAD
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: CANT_RESERVADA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                column: CANTIDAD
            }
        )

        action disponibilidad (
            name: DISPONIBILIDAD
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VID_ARTICULO LCW_OFERTAS.ID_ARTICULO%TYPE;
                    BEGIN
                        BEGIN
                            SELECT ID_ARTICULO
                              INTO VID_ARTICULO
                              FROM LCW_OFERTAS
                             WHERE ID = :ID_OFERTA;
                        EXCEPTION
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error al obtener el articulo '||SQLERRM);
                        END;
                    
                        RETURN OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO    => VID_ARTICULO,
                                                          P_ID_SUCURSAL    => NULL,
                                                          P_IND_DISPONIBLE => 'S');
                    END;
                    ```
                itemsToSubmit: ID_OFERTA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: DISPONIBILIDAD
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                column: CANTIDAD
            }
        )

    )

    dynamicAction inicializar-fila (
        name: Inicializar Fila
        execution {
            sequence: 40
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @aprobaciones-sistema
        }

        action cantidad (
            name: CANTIDAD
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT CANTIDAD
                      FROM LCW_OFERTAS
                     WHERE ID = :ID_OFERTA
                    ```
                itemsToSubmit: ID_OFERTA
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: CANTIDAD
            }
        )

    )

    dynamicAction setear-datos (
        name: Setear Datos
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @aprobaciones-sistema
            columns: NRO_OCC
        }

        action fec-occ (
            name: FEC_OCC
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: SYSDATE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: FEC_OCC
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action fec-occ-nulo (
            name: FEC_OCC - Nulo
            action: setValue
            affectedElements {
                selectionType: columns
                columns: FEC_OCC
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: NRO_OCC
            }
        )

        action fec-plazo (
            name: FEC_PLAZO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SYSDATE + NRO_DIAS FEC_PLAZO
                      FROM LCW_OFERTAS O
                      JOIN CMW_TIPO_ENTREGA TE ON TE.ID = O.ID_TIPO_ENTREGA
                     WHERE O.ID = :ID_OFERTA
                    ```
                itemsToSubmit: ID_OFERTA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: FEC_PLAZO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action fec-plazo-nulo (
            name: FEC_PLAZO - Nulo
            action: setValue
            affectedElements {
                selectionType: columns
                columns: FEC_PLAZO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: NRO_OCC
            }
        )

    )

