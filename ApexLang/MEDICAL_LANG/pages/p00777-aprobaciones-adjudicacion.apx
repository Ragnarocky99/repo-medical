    region aprobaciones-catalogo (
        name: Aprobaciones Catalogo
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: LCW_OFERTAS_APROBACIONES
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                TIPO = 'AP' AND
                ID_LICITACION_DET = :P777_ID_LICITACION_DET AND
                TIPO_ADJUDICACION = 'C'
                ```
            orderByClause: NRO_LINEA
            pageItemsToSubmit: P777_ID_LICITACION_DET
        }
        layout {
            sequence: 20
            parentRegion: @catalogo
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent5
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-sm
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 38538055194174050
        }

