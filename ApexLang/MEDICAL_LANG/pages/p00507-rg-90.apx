    region detalle (
        name: detalle
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  query1 varchar2(5000);
                  query2 varchar2(5000);
                  vmask     varchar2(15)  := 'DD/MM/YYYY';
                begin
                
                
                QUERY1 := ('SELECT 2       LIBRO,
                       cm.TIP_IDEN          IDENTIFICACION,
                       cm.RUC_PROV          RUC,
                       cm.NOMBRE            NOMBRE,
                       cm.Codigo            CODIGO,
                       cm.FEC_COMPROBANTE,
                       cm.TIMBRADO,
                       cm.NUM_COMPROBANTE COMPROBANTE,
                       cm.TOT_GRAVADA_10  GRAVADAS_10,
                       cm.TOT_GRAVADA_5   GRAVADAS_5,
                       cm.TOT_EXENTA      EXENTAS,
                       cm.TOT_COMPROBANTE  TOTAL,
                       cm.CONDICION_COMPRA  CONDICION,
                       CM.OPERACION_EXTRANJERA,
                       CM.IND_IVA IMPUTA_AL_IVA,
                       CM.IND_IRE IMPUTA_AL_IRE,
                       CM.IND_IRP IMPUTA_AL_IRP_RSP,
                       CM.NO_IMPUTA NO_IMPUTA,
                       CM.referencia ,
                       CM.TIMBRADO_REF TIMBRADO_REF,
                       CM.ID_EMPRESA COD_EMPRESA
                  from CMWV_LIBRO_COMPRA CM 
                    where cm.id_Empresa = :P0_ID_EMPRESA
                      and cm.mes        = :P507_MES
                      and cm.anio       = :P507_ANIO
                      and cm.tip_iden   != 18 --no deben aparecer los del exterior, según me dijeron. ~MR. 12-03-2025.
                      and cm.dia     between :P507_DIA_DESDE and :P507_DIA_HASTA'
                 );
                  
                  QUERY2 := ('SELECT 1 libro,
                           to_chaR(cc.TIP_IDEN) IDENTIFICACION,
                           cc.ruc RUC,
                           cc.CLIENTE NOMBRE,
                           cc.codigo, 
                           cc.FEC_COMPROBANTE,
                           cc.NRO_TIMBRADO TIMBRADO,
                           cc.NRO_COMPROBANTE comprobante,
                           cc.TOT_GRAVADA_10  GRAVADAS_10,
                           cc.TOT_GRAVADA_5 GRAVADAS_5,
                           cc.TOT_exenta EXENTAS,
                           cc.TOT_COMPROBANTE TOTAL,
                           cc.CONDICION_VENTA CONDICION,
                           cc.OPERACION_EXTRANJERA,
                           cc.IND_IVA IMPUTA_AL_IVA,
                           cc.IND_IRE IMPUTA_AL_IRE,
                           cc.IND_IRP IMPUTA_AL_IRP_RSP, 
                           CC.NO_IMPUTA NO_IMPUTA,
                           cc.NRO_COMP_REF REFERENCIA,
                           cc.timbrado_Ref TIMBRADO_ref,
                           cc.ID_EMPRESA COD_EMPRESA
                    FROM VTWV_RES_90 cc
                       where cc.id_Empresa = :P0_ID_EMPRESA
                      and cc.mes        = :P507_MES
                      and cc.anio       = :P507_ANIO
                      and cc.dia     between :P507_DIA_DESDE and :P507_DIA_HASTA');
                    
                    if :P507_TIP_LIBRO = 'V' then
                      return(query2);
                     else
                       return(query1);
                    end if;
                 
                end;
                ```
            pageItemsToSubmit: [
                P507_TIP_LIBRO
                P507_MES
                P507_ANIO
                P507_DIA_DESDE
                P507_DIA_HASTA
                P0_ID_EMPRESA
            ]
        }
