    dynamicAction set-dia-final (
        name: set_dia_final
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P507_MES
        }

        action envia-dia-fin (
            name: envia_dia_fin
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      v_mes NUMBER;
                      v_anio NUMBER;
                      v_dias NUMBER;
                    BEGIN
                      v_mes := :P507_MES;
                      v_anio := :P507_ANIO;
                      
                      CASE v_mes
                        WHEN 4 THEN v_dias := 30;
                        WHEN 6 THEN v_dias := 30;
                        WHEN 9 THEN v_dias := 30;
                        WHEN 11 THEN v_dias := 30;
                        WHEN 2 THEN 
                          IF (MOD(v_anio, 4) = 0 AND (MOD(v_anio, 100) != 0 OR MOD(v_anio, 400) = 0)) THEN
                            v_dias := 29;
                          ELSE
                            v_dias := 28;
                          END IF;
                        ELSE v_dias := 31;
                      END CASE;
                      
                      
                      return v_dias;
                        --RAISE_APPLICATION_ERROR(-20001, 'La fecha ingresada no es válida. El mes seleccionado tiene ' || v_dias || ' días.');
                    
                    
                    END;
                    ```
                itemsToSubmit: [
                    P507_MES
                    P507_ANIO
                ]
            }
            affectedElements {
                selectionType: items
                items: P507_DIA_HASTA
            }
            execution {
                sequence: 10
            }
        )

    )

