    dynamicAction crea-nombre (
        name: crea_nombre
        execution {
            sequence: 10
        }
        when {
            event: focusin
            selectionType: items
            items: P507_NOMBRE
        }

        action set-valuea (
            name: set_valuea01
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    	cont number(4);
                        vruc_empresa varchar2(50);
                        vmes         varchar2(10);
                    begin
                    	vruc_empresa := trae_empresa(:P0_ID_EMPRESA);
                    
                    if :P507_TIP_LIBRO = 'V' THEN
                            begin	
                             SELECT SEQ_RES90V.nextval 
                               INTO cont
                               FROM DUAL;
                            exception
                            	when others then
                            	null;
                            end;
                    else
                         begin	
                             SELECT SEQ_RES90C.nextval 
                               INTO cont
                               FROM DUAL;
                            exception
                            	when others then
                            	null;
                            end;
                    end if;
                    if :P507_MES < 10 then
                      vmes := '0'||:P507_MES;
                    else 
                      vmes := :P507_MES;
                    end if;
                    
                    :P507_NOMBRE := (vruc_empresa||'_REG_'||vmes||
                    :P507_ANIO||'_'||:P507_TIP_LIBRO||lpad(cont,4,0));
                    return :P507_NOMBRE;
                    end;
                    ```
                itemsToSubmit: [
                    P507_NOMBRE
                    P507_ANIO
                    P507_MES
                    P507_TIP_LIBRO
                ]
            }
            affectedElements {
                selectionType: items
                items: P507_NOMBRE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction crea-nombre-2 (
        name: crea_nombre02
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P507_TIP_LIBRO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    	cont number(4);
                        vruc_empresa varchar2(50);
                    begin
                    	vruc_empresa := trae_empresa(:P0_ID_EMPRESA);
                    
                    if :P507_TIP_LIBRO = 'V' THEN
                            begin	
                             SELECT SEQ_RES90V.nextval 
                               INTO cont
                               FROM DUAL;
                            exception
                            	when others then
                            	null;
                            end;
                    else
                         begin	
                             SELECT SEQ_RES90C.nextval 
                               INTO cont
                               FROM DUAL;
                            exception
                            	when others then
                            	null;
                            end;
                    end if;
                    
                    :P507_NOMBRE := (vruc_empresa||'_REG_'||:P507_MES||
                    :P507_ANIO||'_'||:P507_TIP_LIBRO||lpad(cont,4,0));
                    return :P507_NOMBRE;
                    end;
                    ```
                itemsToSubmit: [
                    P507_MES
                    P507_ANIO
                    P507_TIP_LIBRO
                    P507_NOMBRE
                ]
            }
            affectedElements {
                selectionType: items
                items: P507_NOMBRE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction procesos-al-presionar-execute (
        name: Procesos al presionar execute
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @execute
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_RG90 CONSTANT VARCHAR2(255) := 'TMP_RG90';     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_RG90) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_RG90);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_RG90);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_RG90,
                        p_c001 => :P507_ANIO,
                        p_c002 => :P507_DIA_DESDE,
                        p_c003 => :P507_DIA_HASTA,
                        p_c004 => :P507_MES,
                        p_c005 => :P507_NOMBRE,
                        p_c006 => :P507_TIP_LIBRO
                        
                         );
                    EXCEPTION
                      WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    ```
                itemsToSubmit: [
