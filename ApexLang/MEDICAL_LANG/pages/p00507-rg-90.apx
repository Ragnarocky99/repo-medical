            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if :P507_ANIO < 2000 or :P507_ANIO > to_number(to_char(sysdate, 'YYYY')) then
                   return false;
                 else 
                  return true;
                end if;
                ```
        }
        error {
            errorMessage: El año debe ser mayor al año 2000 y no puede sobrepasar el año actual, favor validar!!
            associatedItem: @P507_ANIO
        }
        serverSideCondition {
            whenButtonPressed: @execute
        }
    )

    validation valida-dia-final (
        name: valida_dia_final
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  v_mes NUMBER;
                  v_anio NUMBER;
                  v_dias NUMBER;
                BEGIN
                  v_mes := :P507_MES;
                  v_anio := :P507_ANIO;
                  
                  CASE v_mes
                    WHEN 4 THEN v_dias := 30;
                    WHEN 6 THEN v_dias := 30;
                    WHEN 9 THEN v_dias := 30;
                    WHEN 11 THEN v_dias := 30;
                    WHEN 2 THEN 
                      IF (MOD(v_anio, 4) = 0 AND (MOD(v_anio, 100) != 0 OR MOD(v_anio, 400) = 0)) THEN
                        v_dias := 29;
                      ELSE
                        v_dias := 28;
                      END IF;
                    ELSE v_dias := 31;
                  END CASE;
                  
                  IF :P507_DIA_HASTA < 1 or  :P507_DIA_HASTA > v_dias  THEN
                  return 'La fecha ingresada no es válida. El mes seleccionado tiene ' || v_dias || ' días.';
                    --RAISE_APPLICATION_ERROR(-20001, 'La fecha ingresada no es válida. El mes seleccionado tiene ' || v_dias || ' días.');
                  elsif to_number(:P507_DIA_DESDE) > to_number(:P507_DIA_hasta) then
                       return 'El dia final no puede ser menor al dia inicial, favor validar';
                  elsif :P507_DIA_hasta is null then
                         return 'El campo de dia final no puede quedar vacío, favor validar';
                  END IF;
                
                END;
                ```
        }
        error {
            associatedItem: @P507_DIA_HASTA
        }
        serverSideCondition {
            whenButtonPressed: @execute
        }
    )

