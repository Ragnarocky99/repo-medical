page 569 (
    name: Lotes
    alias: LOTES1
    title: Lotes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derechos-consultar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lotes (
        name: Lotes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_FRACCION,
                       ID_MANZANA,
                       COD_LOTE,
                       DESCRIPCION,
                       CTA_CTE_CAT,
                       ID_MORA,
                       SUPERFICIE,
                       PRECIO,
                       DECODE(ESTADO, 'L','LIBRE',
                                      'V','VENDIDO',
                                      'C','CANCELADO',
                                      'R','RECUPERADO',
                                      'S','RESERVADO',
                                      'J','JUDICIALES') ESTADO,
                       ID_MONEDA,
                       LONG_FRENTE,
                       LIND_FRENTE,
                       LONG_CONTRAFRENTE,
                       LIND_CONTRAFRENTE,
                       LONG_COSTADO1,
                       LIND_COSTADO1,
                       LONG_COSTADO2,
                       LIND_COSTADO2,
                       IND_ALAMBRADO,
                       IND_CIMIENTO,
                       IND_CONSTRUIDO,
                       IND_BALDIO,
                       TIP_CAMINO,
                       IND_PRECARIO,
                       CARDINALIDAD_FRENTE,
                       CARDINALIDAD_CONTRAFRENTE,
                       CARDINALIDAD_COSTADO1,
                       CARDINALIDAD_COSTADO2,
                       PUNTO_FRENTE,
                       PUNTO_CONTRAFRENTE,
                       PUNTO_COSTADO1,
                       PUNTO_COSTADO2,
                       PADRON,
                       ID_CONDICION_VENTA,
                       BLOQUEADO,
                       NRO_CUOTAS
                  from LTW_LOTES
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 567
                items: {
                    P567_ID: #ID#
                    P567_ID_EMPRESA: #ID_EMPRESA#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 94151821164175703
        }

