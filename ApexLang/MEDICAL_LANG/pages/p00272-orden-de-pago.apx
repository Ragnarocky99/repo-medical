    dynamicAction abrir-lista-de-valores (
        name: Abrir lista de valores
        execution {
            sequence: 70
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @detalles
            columns: NUM_COMPROBANTE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#lista_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-ordenes-seleccionados (
        name: Cargar Ordenes Seleccionados
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    IF :P272_ORDEN_SELECCIONADO IS NOT NULL THEN 
                    
                    
                      
                      OPEN l_cursor FOR
                        SELECT  C.NRO_COMPROBANTE,
                                c.TIP_COMPROBANTE,
                                nvl(C.SER_COMPROBANTE,'A') SER_COMPROBANTE,
                                C.ID,
                                C.NUM_CUOTA,
                                to_char(C.FEC_VENCIMIENTO,'DD/MM/YYYY') AS FEC_VENCIMIENTO,
                                C.ID_MONEDA,
                                ---C.TOT_SALDO,
                                decode(c.tip_comprobante,'NTC',-1,1) * (NVL(C.TOT_CUOTA,0) -NVL( C.MONTO_EN_OP,0)) TOT_SALDO,
                                C.ID_PROVEEDOR,
                                nvl(M.REFERENCIA,'Sin Referencia') REFERENCIA,
                                C.ID_COMPROBANTE_CM,
                                C.ID_COMPROBANTE
                        FROM   CPW_CUOTAS C, 
                               CMW_COMPRAS_CABECERA M 
                        WHERE C.ID_COMPROBANTE_CM = M.ID--(+) -- Tobi Val, añadido para las NCP's
                          AND C.ID IN (SELECT  TO_NUMBER (column_value)
                        FROM  XMLTABLE (:P272_ORDEN_SELECCIONADO))
                        UNION ALL
                        SELECT  C.NRO_COMPROBANTE,
                                c.TIP_COMPROBANTE,
                                nvl(C.SER_COMPROBANTE,'A') SER_COMPROBANTE,
                                C.ID,
                                C.NUM_CUOTA,
                                to_char(C.FEC_VENCIMIENTO,'DD/MM/YYYY') AS FEC_VENCIMIENTO,
                                C.ID_MONEDA,
                                ---C.TOT_SALDO,
                                --NVL(C.TOT_CUOTA,0) -NVL( C.MONTO_EN_OP,0) TOT_SALDO,
                                decode(c.tip_comprobante,'NCP',-1,1) * (NVL(C.TOT_CUOTA,0) -NVL( C.MONTO_EN_OP,0)) TOT_SALDO,
                                C.ID_PROVEEDOR,
                                nvl(M.REFERENCIA,'Sin referencia') REFERENCIA,
                                C.ID_COMPROBANTE_CM,
                                C.ID_COMPROBANTE
                        FROM   CPW_CUOTAS C, 
                               CPW_COMPROBANTES_CABECERA M 
                        WHERE C.ID_COMPROBANTE = M.ID
                          AND C.ID IN (SELECT	TO_NUMBER (column_value)
                        FROM	XMLTABLE (:P272_ORDEN_SELECCIONADO));
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('CUOTAS', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P272_JSON_DETALLE:=JSON_DETALLE;
                      /*
                      SELECT SUM(NVL(TOT_CUOTA,0) - nvl(MONTO_EN_OP,0))  INTO :P272_SUMA_TOTAL FROM CPW_CUOTAS
                      WHERE ID IN (SELECT TO_NUMBER(column_value) FROM XMLTABLE(:P272_ORDEN_SELECCIONADO));
                      */
                    END IF;
                    
                    END;
                    ```
                itemsToSubmit: P272_ORDEN_SELECCIONADO
                itemsToReturn: P272_JSON_DETALLE
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var total=0;
                    //var total_actual=$v("P272_SUMA_TOTAL");;
                    var json_detalle = JSON.parse($v('P272_JSON_DETALLE'));
                    console.log(json_detalle);
                    
                    
                    
                    
                    if ((Object.keys(json_detalle.CUOTAS).length)!=0){
                    
                    
                        for(let i=0;i<json_detalle.CUOTAS.length;i++){
                    
                    
                        //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                        var $widget = apex.region("det").widget();
                        var $grid = $widget.interactiveGrid("getViews", "grid");
                        var $model = $grid.model;
                            $grid.setEditMode(true);
                        //insert new record on a model
                        var newRecordId = $model.insertNewRecord();
                        var $newRecord = $model.getRecord(newRecordId);
                    
                    
                        total=total+json_detalle.CUOTAS[i].TOT_SALDO;
                        try {
                            $model.setValue($newRecord, "ID_PROVEEDOR",(json_detalle.CUOTAS[i].ID_PROVEEDOR).toString());
                            $model.setValue($newRecord, "TIP_COMPROBANTE",(json_detalle.CUOTAS[i].TIP_COMPROBANTE).toString());
                            $model.setValue($newRecord, "SER_COMPROBANTE",(json_detalle.CUOTAS[i].SER_COMPROBANTE).toString());
                            $model.setValue($newRecord, "NUM_COMPROBANTE",(json_detalle.CUOTAS[i].NRO_COMPROBANTE).toString());
                            if ((json_detalle.CUOTAS[i].REFERENCIA)!=null){
                            $model.setValue($newRecord, "REFERENCIA",(json_detalle.CUOTAS[i].REFERENCIA).toString());
                            }
                            $model.setValue($newRecord, "TOT_ORDEN_PAGO",(json_detalle.CUOTAS[i].TOT_SALDO).toString().replace(/\./g,','));
                            $model.setValue($newRecord, "CUOTA_COPIA",(json_detalle.CUOTAS[i].TOT_SALDO).toString().replace(/\./g,','));
                            $model.setValue($newRecord, "ID_CUOTA",(json_detalle.CUOTAS[i].ID).toString());
                            if ((json_detalle.CUOTAS[i].ID_COMPROBANTE_CM)!=null){ 
                            $model.setValue($newRecord, "ID_COMPROBANTE_CM",(json_detalle.CUOTAS[i].ID_COMPROBANTE_CM).toString());
                            }
                            if ((json_detalle.CUOTAS[i].ID_COMPROBANTE)!=null){
                            $model.setValue($newRecord, "ID_COMPROBANTE",(json_detalle.CUOTAS[i].ID_COMPROBANTE).toString());
                            }
                            if ((json_detalle.CUOTAS[i].NUM_CUOTA)!=null){
                            $model.setValue($newRecord, "NUM_CUOTA",(json_detalle.CUOTAS[i].NUM_CUOTA).toString());
                            }
                        }catch(e){
                            console.log(e.stack)
                        }
                        }
                        /*
                        console.log("total actual : " + total_actual);
                    
                        if(isNaN(parseFloat(total_actual))){
                            total = total + 0;
                            console.log("total_actual is nan: " + total_actual)
                        }else{
                            total = total + parseFloat(total_actual);
                            console.log("suma totales " + total);
                        }
                    
                        apex.item("P272_SUMA_TOTAL").setValue(total);
                        console.log("total : " + total);
                        */
                        calculaTotales();
                    //$s('P170_TOTAL',total);
                    
                    }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P272_ORDEN_SELECCIONADO
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    nombre varchar2(255):=WWV_FLOW.G_INSTANCE;
                    orden_seleccionados varchar(500);
                    BEGIN
                    Select SUBSTR(c001, 0, LENGTH(c001) - 1) as c001
                    into orden_seleccionados
                    From APEX_COLLECTIONS
                    Where COLLECTION_NAME = nombre
                    AND SEQ_ID = 1;
                    return orden_seleccionados;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    RETURN NULL;
                    WHEN OTHERS THEN 
                    RETURN NULL;
                    END;
                    
                    ```
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P272_ORDEN_SELECCIONADO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-proveedor (
        name: Cargar Proveedor
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P272_ID_PROVEEDOR
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_PROVEEDOR CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_PROVEEDOR) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_PROVEEDOR);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_PROVEEDOR);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_PROVEEDOR,
                        p_c001 => :P272_ID_PROVEEDOR
                         );
                    END;
                    ```
                itemsToSubmit: P272_ID_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 160
        }
        when {
            selectionType: items
            items: P272_FEC_EMISION
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P272_FEC_EMISION) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P272_FEC_EMISION,'/','');
                            conv_fecha := substr(:P272_FEC_EMISION,1,2)||'/'||
                                                      substr(:P272_FEC_EMISION,3,2)||'/'||
                                                      lpad(substr(:P272_FEC_EMISION,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P272_FEC_EMISION := conv_fecha;
                            ELSIF (length(:P272_FEC_EMISION) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P272_FEC_EMISION) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P272_FEC_EMISION
                itemsToReturn: P272_FEC_EMISION
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

