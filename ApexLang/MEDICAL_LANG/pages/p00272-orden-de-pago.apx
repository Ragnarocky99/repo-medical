    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                                insert into CPW_DETALLE_ORDEN_PAGO 
                                (ID_ORDEN_PAGO_CAB,TIP_COMPROBANTE,SER_COMPROBANTE,NUM_COMPROBANTE,ID_PROVEEDOR,
                                TOT_ORDEN_PAGO, ID_CUOTA, NUM_CUOTA, ID_COMPROBANTE_CM, ID_COMPROBANTE,ID_EMPRESA, COD_USUARIO_AUD, REFERENCIA)
                                values(:P272_ID,:TIP_COMPROBANTE,:SER_COMPROBANTE, :NUM_COMPROBANTE,
                                :ID_PROVEEDOR,REPLACE(:TOT_ORDEN_PAGO,'.',''), :ID_CUOTA, :NUM_CUOTA, :ID_COMPROBANTE_CM,:ID_COMPROBANTE
                                , :P0_ID_EMPRESA,
                                :APP_USER, :REFERENCIA);
                            
                            WHEN 'U' then  
                                update CPW_DETALLE_ORDEN_PAGO  d
                                    set  TIP_COMPROBANTE   = :TIP_COMPROBANTE,
                                         SER_COMPROBANTE   = :SER_COMPROBANTE,
                                         NUM_COMPROBANTE   = :NUM_COMPROBANTE,
                                         ID_PROVEEDOR      = :ID_PROVEEDOR,
                                         TOT_ORDEN_PAGO    = REPLACE(:TOT_ORDEN_PAGO,'.',''),
                                         ID_CUOTA          = :ID_CUOTA,
                                         NUM_CUOTA         = :NUM_CUOTA,
                                         ID_COMPROBANTE_CM = :ID_COMPROBANTE_CM,
                                         ID_COMPROBANTE = : ID_COMPROBANTE,
                                         REFERENCIA        = :REFERENCIA
                
                                where   d.ID_ORDEN_PAGO_CAB = :P272_ID
                                    and d.id = :id;
                
                           when 'D' then
                                delete CPW_DETALLE_ORDEN_PAGO d     
                                WHERE d.ID_ORDEN_PAGO_CAB = :ID_ORDEN_PAGO_CAB
                                           and d.id = :id;  
                    end case;
                                         
                
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 64271774289068928
        }
    )

