                selectionType: columns
                columns: [
                    TIP_COMPROBANTE
                    SER_COMPROBANTE
                    NUM_COMPROBANTE
                    NUM_CUOTA
                    ID_PROVEEDOR
                    TOT_ORDEN_PAGO
                    REFERENCIA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

