            columns: ID_CUOTA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT C.TIP_COMPROBANTE, C.SER_COMPROBANTE, C.NRO_COMPROBANTE, C.NUM_CUOTA, C.ID_PROVEEDOR,
                    CASE C.TIP_cOMPROBANTE
                       WHEN 'NCP' THEN -C.TOT_SALDO
                       ELSE C.TOT_SALDO
                       END AS TOT_SALDO, nvl(M.REFERENCIA,'Sin Referencia')
                    FROM CPW_CUOTAS C, CMW_COMPRAS_CABECERA M
                    WHERE C.ID = :ID_CUOTA
                    AND C.ID_COMPROBANTE_CM = M.ID(+)
                    ```
                itemsToSubmit: ID_CUOTA
            }
