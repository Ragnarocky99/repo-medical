    region orden-de-pago (
        name: Orden de Pago
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       SER_ORDEN_PAGO,
                       NUM_ORDEN_PAGO,
                       FEC_EMISION,
                       FEC_VENCIMIENTO,
                       ID_USUARIO_AUTORIZ,
                       AUTORIZADO,
                       ESTADO,
                       RETENIDO,
                       COD_USUARIO_AUD,
                       PORC_RET_IVA,
                       TOT_RET_IVA,
                       IND_PAGO_ADELANTADO,
                       GRAVADAS,
                       IVA,
                       ID_MOV_CAJ,
                       ID_PROVEEDOR,
                       FEC_AUTORIZADO,
                       IND_CAJA_CHICA,
                       ID_CUENTA_BANCARIA,
                       ID_CONSIGNACION,
                       ID_MONEDA,
                       ID_SUCURSAL,
                       TIP_CAMBIO,
                       NRO_PLANILLA,
                       SUMA_TOTAL,
                       ID_CENTRO_COSTO
                  from CPW_CABECERA_ORDEN_PAGO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
