page 272 (
    name: Orden de Pago
    alias: ORDEN-DE-PAGO
    title: Orden de Pago
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
             function calculaTotales(){
                var model= apex.region("det").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("CUOTA_COPIA");
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                        
                         console.log('jyyju'+r[v_cantidad]);
                          
                        v_total_cantidad      = v_total_cantidad     + parseFloat(r[v_cantidad].toString().replace('.', '').replace('.', '').replace(',', '.') /*.replace(/\./g,'')*/);
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                 $s('P272_SUMA_TOTAL',v_total_cantidad);
            }
            
            function f_setRowCount(){
                    var grid = apex.region("det").widget().interactiveGrid("getViews", "grid");
                    var model = grid.model;
                    var rowCount = 0;
                    model.forEach(function (record) {
                        rowCount ++;
                    });
                    $s("P272_ROWCOUNT",rowCount);
                }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            //document.getElementById("P272_TIP_CAMBIO").readOnly = true;
            /*document.getElementById("P272_SER_ORDEN_PAGO").readOnly = true;*/
            document.getElementById("P272_NUM_ORDEN_PAGO_ANT").readOnly = true;
            document.getElementById("P272_NUM_ORDEN_PAGO").readOnly = true;
            document.getElementById("P272_SUMA_TOTAL").readOnly = true;
            ```
    }
