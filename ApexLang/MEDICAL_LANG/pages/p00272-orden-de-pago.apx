    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_ORDEN_PAGO_CAB,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NUM_COMPROBANTE,
                       C.ID_PROVEEDOR,
                       C.TOT_ORDEN_PAGO,
                       C.TOT_ORDEN_PAGO AS CUOTA_COPIA,
                       C.TOT_RETENCION,
                       C.RETENIDO,
                       C.RUC_CLIENTE,
                       C.NRO_ITEM_RETENC,
                       C.COD_USUARIO_AUD,
                       C.ID_CUOTA,
                       C.ID_COMPROBANTE,
                       C.INCLUIR,
                       C.ID_EMPRESA,
                       C.ID_MOV_CAJ,
                       C.ID_COMPROBANTE_CM,
                       C.GENERO_OSIRIS,
                       C.NUM_CUOTA,
                       C.REFERENCIA
                  from CPW_DETALLE_ORDEN_PAGO C
                  WHERE C.ID_ORDEN_PAGO_CAB = :P272_ID
                
                ```
            pageItemsToSubmit: P272_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: det
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                        $( ".selector" ).grid( {
                    autoAddRecord: false
                } );
                        
                           
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calculaTotales();
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    calculaTotales();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    calculaTotales();
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    calculaTotales();
                            };    
                
                            /*
                             var rowAddRow = actions.lookup("selection-add-row"),
                                originalDuplicateAction = rowAddRow.action;
                
