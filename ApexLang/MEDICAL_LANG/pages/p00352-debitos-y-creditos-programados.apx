page 352 (
    name: Debitos y Creditos Programados
    alias: DEBITOS-Y-CREDITOS-PROGRAMADOS
    title: Debitos y Creditos Programados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region débitos-y-créditos-programados (
        name: Débitos y Créditos Programados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NRO_PROGRAMA,
                       ID_EMPLEADO,
                       ID_CONCEPTO,
                       FEC_INICIO,
                       FEC_FINAL,
                       MONTO_TOTAL,
                       TIP_DEBCRED,
                       MONTO_CUOTA,
                       OBSERVACION,
                       ACTIVO,
                       ORI_DEBCRED,
                       TIP_LIQUID,
                       ID_MONEDA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_SUCURSAL,
                       SALDO,
                       NRO_CHEQUE,
                       COD_USUARIO_AUD,
                       COD_USUARIO_ALTA,
                       FECHA_ALTA
                  from RHW_DEBCRED_PROG_CAB
                 where ID_EMPRESA = :P0_ID_EMPRESA
                  AND ID_SUCURSAL = :P0_ID_SUCURSAL
                  and (FEC_INICIO = :P352_FECHA_INICIO OR :P352_FECHA_INICIO IS NULL)
                  AND (ID_CONCEPTO = :P352_CONCEPTO OR :P352_CONCEPTO IS NULL)
                  AND (ID_EMPLEADO = :P352_EMPLEADO OR :P352_EMPLEADO IS NULL)
                  AND (NRO_PROGRAMA = :P352_NRO_PROGRAMA OR :P352_NRO_PROGRAMA IS NULL)
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 331
                items: {
                    P331_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 15860206208708114
        }

