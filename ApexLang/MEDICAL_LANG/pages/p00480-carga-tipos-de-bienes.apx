    button aplicar-cambios (
        buttonName: APLICAR_CAMBIOS
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P480_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P480_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P480_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P480_DESCRIPCION IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Cargar descripción
            displayLocation: onErrorPage
            associatedItem: @P480_DESCRIPCION
        }
        serverSideCondition {
            type: itemIsNull
            item: P480_ID
        }
    )

    validation new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P480_ID_CUENTA IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Ingrese Cuenta
            displayLocation: onErrorPage
            associatedItem: @P480_ID_CUENTA
        }
    )

    validation new-3 (
        name: New_2
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P480_VIDA_UTIL IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Cargar Vida Útil
            displayLocation: onErrorPage
            associatedItem: @P480_VIDA_UTIL
        }
    )

    validation new-4 (
        name: New_3
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P480_PORC_VALOR_RESIDUAL IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Cargar % Valor Residual
            displayLocation: onErrorPage
            associatedItem: @P480_PORC_VALOR_RESIDUAL
        }
    )

    process cerrar-recuadro-de-diálogo (
        name: Cerrar Recuadro de Diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 59707771470687853
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-tipos-de-bienes (
        name: Initialize form Carga Tipos de Bienes
        type: formInitialization
        formRegion: @carga-de-tipos-de-bienes
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 59706915092687851
        }
    )

    process process-form-carga-de-tipos-de-bienes (
        name: Process form Carga de Tipos de Bienes
        type: formAutoRowProcessing
        formRegion: @carga-de-tipos-de-bienes
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 59707358142687853
        }
    )

)

