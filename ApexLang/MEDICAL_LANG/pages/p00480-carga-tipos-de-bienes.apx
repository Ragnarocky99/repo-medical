page 480 (
    name: Carga Tipos de Bienes
    alias: CARGA-TIPOS-DE-BIENES
    title: Carga Tipos de Bienes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region carga-de-tipos-de-bienes (
        name: Carga de Tipos de Bienes
        type: form
        source {
            location: localDatabase
            tableName: COW_TIPOS_BIENES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P480_COD_TIPO_BIEN (
        type: textField
        label {
            label: <p><b style="color:red">*</b>Código Tipo:</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-tipos-de-bienes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @carga-de-tipos-de-bienes
            column: COD_TIPO_BIEN
            dataType: varchar2
        }
    )

    pageItem P480_DESCRIPCION (
        type: textField
        label {
            label: <p><b style="color:red">*</b>Descripción:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-tipos-de-bienes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 125
        }
        source {
            formRegion: @carga-de-tipos-de-bienes
            column: DESCRIPCION
            dataType: varchar2
        }
    )

