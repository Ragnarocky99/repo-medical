            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-bienes
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: COW_TIPOS_BIENES_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
