page 177 (
    name: Impresion de movimientos de artículos
    alias: IMPRESION-DE-MOVIMIENTOS-DE-ARTÍCULOS
    title: Impresion de movimientos de artículos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                DECLARE
                vcName PK_JRXML2PDF_TYPES.tName;
                
                l_ReportList PK_JRXML2PDF_TYPES.tReportNameList;
                
                r_Params PK_JRXML2PDF_REPGEN.TPARAMETER;
                l_Params PK_JRXML2PDF_REPGEN.TPARAMLIST;
                
                bl BLOB;
                
                BEGIN
                
                vcName := 'Movimientos_art';
                
                r_Params.vcName := 'P_COD_EMPRESA';
                r_Params.vcValue := :P0_COD_EMPRESA;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_COD_USER';
                r_Params.vcValue := :APP_USER;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                
                r_Params.vcName := 'P_SUCURSAL_DESDE';
                r_Params.vcValue := :P173_SUCURSAL_DESDE;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_SUCURSAL_HASTA';
                r_Params.vcValue := :P173_SUCURSAL_HASTA;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                
                r_Params.vcName := 'P_ARTICULO';
                r_Params.vcValue := :P173_ARTICULO;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                
                r_Params.vcName := 'P_FECHA_DESDE';
                r_Params.vcValue := TO_DATE(:P173_FECHA_DESDE,'DD/MM/YYYY');
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_FECHA_HASTA';
                r_Params.vcValue := TO_DATE(:P173_FECHA_HASTA,'DD/MM/YYYY');
                l_Params(l_Params.COUNT+1) := r_Params;
                
                l_ReportList(1) := vcName;
                
                
                
                bl := PK_JRXML2PDF_REPGEN.FK_RUN(i_lReports=>l_ReportList,
                i_lParams=>l_Params,
                i_bResetPageNumber=>false
                );
                
                PK_JRXML2PDF_REPGEN.PR_SHOW_REPORT(bl);
                APEX_APPLICATION.STOP_APEX_ENGINE;
                
                END;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 20
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          v_nom_empresa varchar2(150);
                        BEGIN
                          SELECT E.DESCRIPCION INTO v_nom_empresa FROM BSW_EMPRESAS E WHERE E.ID = :P0_ID_EMPRESA;
                          xlog (l_proc, 'url (orig):' || l_report_url);
                          
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('ficha_ent_sal_articulo'),
                                  p_rep_format          => apex_util.url_encode('pdf'),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                  p_additional_params   => (
                                        'P_ID_EMPRESA='||:P0_ID_EMPRESA||'&'||
                                        'P_SUCURSAL='||:P173_SUCURSAL_DESDE||'&'||
                                        'P_FECHA_INI='||:P173_FECHA_DESDE||'&'||
                                        'P_FECHA_FIN='||:P173_FECHA_HASTA||'&'||
                                        'P_ARTICULO='||:P173_ARTICULO||'&'||
                                        'P_USER='||:APP_USER||'&'||
                                        'P_REMOTE_ADDR='||owa_util.get_cgi_env('REMOTE_ADDR')
                                  ),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          apex_application.stop_apex_engine();
                
                        exception
                          when apex_application.e_stop_apex_engine then
                            null; -- ok, stop engine raises exception, we can ignore that
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
    )

)

