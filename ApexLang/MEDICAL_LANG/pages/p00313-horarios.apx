        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Horarios
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 122968 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVO (
                sequence: 11
            )

            displayColumn CHK_CALCULAR (
                sequence: 10
            )

            displayColumn COD_HORARIO (
                sequence: 1
            )

            displayColumn DESCONTAR (
                sequence: 4
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn DIRECCION_IP (
                sequence: 8
            )

            displayColumn DOBLE_ENTRADA (
                sequence: 5
            )

            displayColumn HORAS_CUMPLIR (
                sequence: 9
            )

            displayColumn ID_CATEGORIA_HOR (
                sequence: 3
            )

            displayColumn IND_ROTATIVO (
                sequence: 6
            )

            displayColumn MEDIO_TIEMPO (
                sequence: 7
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @horarios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 316
                items: {
                    P316_ID: &P316_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction when-dialog-closed (
        name: When dialog closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @horarios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @horarios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

