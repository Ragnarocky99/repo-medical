page 173 (
    name: Movimientos de Articulos
    alias: MOVIMIENTOS-DE-ARTICULOS
    title: Ficha de Entrada/Salida de Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ficha-entrada-salida (
        name: Ficha Entrada Salida
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region movimientos-de-articulos (
        name: Movimientos de Articulos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select M.ID,
                       M.ID_EMPRESA,
                       M.COD_SUCURSAL,
                       M.COD_ARTICULO,
                       M.DESC_ART,
                       M.DESC_SUCURSAL,
                       M.DESC_MOTIVO,
                       M.NUMERO,
                       M.CANT_ENT,
                       M.CANT_SAL,
                       M.COD_MOTIVO_ENT_SAL,
                       M.ID_ARTICULO ARTICULO,
                       M.fec_alta,
                       M.NROLOTE,
                       --M.ID_SUCURSAL_CENTRAL,
                       M.SALDO
                
                  from STW_TMP_FICHA_ARTICULOS M
                  where ID_EMPRESA = :P0_ID_EMPRESA
                   AND M.ip_maquina = owa_util.get_cgi_env('REMOTE_ADDR')
                   AND M.FEC_ALTA BETWEEN TO_DATE(:P173_FECHA_DESDE,'DD/MM/YYYY') AND TO_DATE(:P173_FECHA_HASTA,'DD/MM/YYYY')
                   AND (ID_ARTICULO = :P173_ARTICULO OR :P173_ARTICULO IS NULL)
                   AND (M.COD_SUCURSAL = :P173_SUCURSAL_DESDE or :P173_SUCURSAL_DESDE IS NULL)
                
                order by M.ID_ARTICULO, M.COD_SUCURSAL, M.FEC_ALTA DESC
                ```
            pageItemsToSubmit: [
                P173_SUCURSAL_DESDE
                P173_ARTICULO
                P173_FECHA_DESDE
                P173_FECHA_HASTA
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No se ha encontrado ningún dato.
            whenMoreDataFound: El recuento máximo de filas de este informe es #MAX_ROW_COUNT# filas. Aplique un filtro para reducir el número de registros de la consulta.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 118445659484551086
        }

