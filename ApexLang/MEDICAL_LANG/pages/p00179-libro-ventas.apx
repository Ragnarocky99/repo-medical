page 179 (
    name: Libro de Ventas
    alias: LIBRO-VENTAS
    title: Libro de Ventas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region libro-de-ventas (
        name: Libro de Ventas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT e.descripcion AS DESC_EMPRESA,
                       C.TIP_COMPROBANTE TIP_COMPROBANTE,
                       NVL(C.SERIE, C.SER_COMPROBANTE) SERIE,
                       NVL(SC.SER_TIMBRADO, C.SER_COMPROBANTE) || '-' ||LPAD(TO_CHAR(C.NRO_COMPROBANTE), 7, '0') NRO_COMPROBANTE,
                       TRUNC(C.FEC_COMPROBANTE) FEC_COMPROBANTE,
                       S.COD_SUCURSAL,
                       S.DESCRIPCION SUCURSAL,
                       CC.COD_CLIENTE,
                       E.RUC_EMPRESA,
                       --NVL(PC.NOMBRE, PC.NOMB_FANTASIA) CLIENTE,
                       DECODE(C.ESTADO,'A','--ANULADO--',NVL(PC.NOMBRE, PC.NOMB_FANTASIA)) CLIENTE,
                       
                       C.RUC_CLIENTE,
                       
                       CV.COD_CONDICION_VENTA,
                       CV.DESCRIPCION CONDICION_VENTA,
                       c.cod_usuario_aud,
                       M.COD_MONEDA,
                       M.DESCRIPCION MONEDA,
                       M.SIGLAS,
                       NVL(C.TIP_CAMBIO, 1) TIP_CAMBIO,
                       V.COD_VENDEDOR,
                       LTRIM(PV.NOMBRE) VENDEDOR,
                       TO_CHAR(C.FEC_COMPROBANTE, 'DD') DIA,
                       TO_CHAR(C.FEC_COMPROBANTE, 'MM') MES,
                       TO_CHAR(C.FEC_COMPROBANTE, 'YYYY') ANIO,
                       TC.DESCRIPCION DESC_TIPO_COMPROBANTE,
                       M.DECIMALES,
                       TC.IND_HECHAUKA,
                       --ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 0, 0, ROUND(D.MONTO_TOTAL_C_IVA / ((100 + IVA.PORC_IVA_VENTA) / 100), 16)) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_GRAVADA,
                      -- ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 5, ROUND(D.MONTO_TOTAL_C_IVA / ((100 + IVA.PORC_IVA_VENTA) / 100), 16), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_GRAVADA_5,
                       ---ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 5, ROUND((D.MONTO_TOTAL_C_IVA * IVA.PORC_IVA_VENTA) / (IVA.PORC_IVA_VENTA + 100), 16), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_IVA_5,
                       --ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 0, NVL(D.MONTO_TOTAL, 0), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_EXENTA,
                       --ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 0, 0, ROUND((D.MONTO_TOTAL_C_IVA * IVA.PORC_IVA_VENTA) / (IVA.PORC_IVA_VENTA + 100), 16)) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_IVA, 0 DESCUENTO, ROUND(SUM((NVL(D.MONTO_TOTAL_C_IVA, 0)) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_COMPROBANTE,
                      DECODE(C.Estado,'A','0',ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 0, 0, ROUND(D.MONTO_TOTAL_C_IVA / ((100 + IVA.PORC_IVA_VENTA) / 100), 16)) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))) * DECODE(nvl(CC.TIPO_IMPUESTO,'G'),'E',0,1) TOT_GRAVADA,
                      DECODE(C.Estado,'A','0',ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 5, ROUND(D.MONTO_TOTAL_C_IVA / ((100 + IVA.PORC_IVA_VENTA) / 100), 16), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))) * DECODE(nvl(CC.TIPO_IMPUESTO,'G'),'E',0,1) TOT_GRAVADA_5,
                      DECODE(C.Estado,'A','0',ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 5, ROUND((D.MONTO_TOTAL_C_IVA * IVA.PORC_IVA_VENTA) / (IVA.PORC_IVA_VENTA + 100), 16), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))) * DECODE(nvl(CC.TIPO_IMPUESTO,'G'),'E',0,1) TOT_IVA_5,
                      DECODE(C.Estado,'A','0',ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 0, NVL(D.MONTO_TOTAL, 0), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))) + DECODE(nvl(CC.TIPO_IMPUESTO,'G'),'E',C.TOT_COMPROBANTE,0) TOT_EXENTA,
                     
                       C.SERIE SERIE_FACTURA,
                       0 TOT_IVA_DECIMAL,
                       C.NRO_TIMBRADO,
                       DECODE(C.TIP_COMPROBANTE, 'FCR', TO_CHAR(CV.NRO_CUOTAS), '0') NRO_CUOTAS,
                       C.ID_EMPRESA,
                       '1' TIPO_DOCUMENTO,
                       --ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 10, ROUND(D.MONTO_TOTAL_C_IVA / ((100 + IVA.PORC_IVA_VENTA) / 100), 16), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_GRAVADA_10,
                       --ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 10, ROUND((D.MONTO_TOTAL_C_IVA * IVA.PORC_IVA_VENTA) / (IVA.PORC_IVA_VENTA + 100),16),0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) TOT_IVA_10,
                       DECODE(C.TIP_COMPROBANTE, 'FCR', '2', '1') COND_VENTA,
                       C.ID_SUCURSAL_CENTRAL ID_SUCURSAL,
                
                       DECODE(C.Estado,'A','0',ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 10, ROUND(D.MONTO_TOTAL_C_IVA / ((100 + IVA.PORC_IVA_VENTA) / 100), 16), 0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))) * DECODE(nvl(CC.TIPO_IMPUESTO,'G'),'E',0,1) TOT_GRAVADA_10,    
                       DECODE(C.Estado,'A','0',ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 10, ROUND((D.MONTO_TOTAL_C_IVA * IVA.PORC_IVA_VENTA) / (IVA.PORC_IVA_VENTA + 100),16),0) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))) * DECODE(nvl(CC.TIPO_IMPUESTO,'G'),'E',0,1) TOT_IVA_10,
                       C.ID ID_COMPROBANTE,
                       
                CASE 
                   WHEN C.ESTADO = 'A' OR NVL(CC.TIPO_IMPUESTO,'G') = 'E' THEN 
                     0
                  ELSE 
                    ROUND(SUM(DECODE(IVA.PORC_IVA_VENTA, 0, 0, ROUND((D.MONTO_TOTAL_C_IVA * IVA.PORC_IVA_VENTA) / (IVA.PORC_IVA_VENTA + 100), 16)) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1))
                 END AS TOT_IVA,
                 
                CASE 
                   WHEN C.ESTADO = 'A' /*OR NVL(CC.TIPO_IMPUESTO,'G') = 'E'*/ THEN 
                     0
                     ELSE 
                      ROUND(SUM((NVL(D.MONTO_TOTAL_C_IVA, 0)) * NVL(C.TIP_CAMBIO, 1)) * DECODE(TC.SALDOS,'R',-1,1)) 
                      END AS TOT_COMPROBANTE
                
                
                
                  FROM VTW_COMPROBANTES_CABECERA C,
                       VTW_COMPROBANTES_DETALLE  D,
                       STW_ARTICULOS             A,
                       STW_IVA                   IVA,
                       CCW_CLIENTES              CC,
                       BSW_PERSONAS              PC,
                       CCW_CONDICIONES_VENTAS    CV,
                       BSW_MONEDAS               M,
                       FVW_VENDEDORES            V,
                       BSW_PERSONAS              PV,
                       BSW_SUCURSALES            S,
                       BSW_TIPOS_COMPROBANTES    TC,
                       BSW_IDENT_PERSONAS        ID,
                       BSW_EMPRESAS              E,
                       BSW_SERIES_COMPROB        SC
                       
                WHERE E.ID = :P0_COD_EMPRESA
                   AND C.FEC_COMPROBANTE BETWEEN :PV_FEC_INI AND :PV_FEC_FIN
                   AND (S.ID = :PV_ID_SUCURSAL OR :PV_ID_SUCURSAL IS NULL)
                   
                   
                   AND C.ID_EMPRESA = CC.ID_EMPRESA
                   AND C.ID_CLIENTE = CC.ID
                   AND CC.ID_PERSONA = PC.ID
                   AND C.ID_EMPRESA = TC.ID_EMPRESA
                   AND C.TIP_COMPROBANTE = TC.TIP_COMPROBANTE
                   --AND NVL(C.ESTADO, 'x') != 'A'
                   AND C.ID_EMPRESA = S.ID_EMPRESA
                   AND C.ID_SUCURSAL = S.ID
                   AND C.ID_MONEDA = M.ID
                   AND C.ID_EMPRESA = CV.ID_EMPRESA
                   AND C.ID_CONDICION_VENTA = CV.ID(+)
                   AND C.ID_EMPRESA = V.ID_EMPRESA(+)
                   AND C.ID_VENDEDOR = V.ID(+)
                   AND V.ID_PERSONA = PV.ID(+)
                   AND ID.ID_PERSONA(+) = CC.ID_PERSONA
                   AND ID.ID_IDENTIFICACIONES(+) = 1
                   AND C.ID_SERIE_COMP = SC.ID
                   --AND NVL(C.IMPRIME_IVA, 'S') = 'S'
                   --AND C.TIP_COMPROBANTE != 'NCR'
                   AND D.ID_COMPROBANTE_CABECERA = C.ID
                   AND A.ID = D.ID_ARTICULO
                   AND IVA.ID = D.ID_IVA
                   AND E.ID=c.id_empresa
                   --AND C.SER_COMPROBANTE<>'B'
                   and C.ser_comprobante != 'MIGR'
                   --and cc.cod_cliente = '247' que problemas que nos generó itaiupu lgmt
                   
                 GROUP BY C.TIP_COMPROBANTE,
                          NVL(C.SERIE, C.SER_COMPROBANTE),
                          LPAD(TO_CHAR(C.NRO_COMPROBANTE), 7, '0'),
                          TRUNC(C.FEC_COMPROBANTE),
                          SC.SER_TIMBRADO,
                          C.SER_COMPROBANTE,
                          S.COD_SUCURSAL,
                          S.DESCRIPCION,
                          CC.COD_CLIENTE,
                          NVL(PC.NOMBRE, PC.NOMB_FANTASIA),
                          CV.COD_CONDICION_VENTA,
                          CV.DESCRIPCION,
                          M.COD_MONEDA,
                          M.DESCRIPCION,
                          M.SIGLAS,
                          NVL(C.TIP_CAMBIO, 1),
                          V.COD_VENDEDOR,
                          LTRIM(PV.NOMBRE),
                          TO_CHAR(C.FEC_COMPROBANTE, 'DD'),
                          TO_CHAR(C.FEC_COMPROBANTE, 'MM'),
                          TO_CHAR(C.FEC_COMPROBANTE, 'YYYY'),
                          TC.DESCRIPCION,
                          M.DECIMALES,
                          TC.IND_HECHAUKA,
                          C.SERIE,
                          C.NRO_TIMBRADO,
                          E.RUC_EMPRESA,
                          DECODE(C.TIP_COMPROBANTE, 'FCR', TO_CHAR(CV.NRO_CUOTAS), '0'),
                          C.ID_EMPRESA,
                          DECODE(C.TIP_COMPROBANTE, 'FCR', '2', '1'),
                          C.ID_SUCURSAL_CENTRAL,
                          E.DESCRIPCION,
                          C.FEC_COMPROBANTE,
                          TC.SALDOS,
                          C.RUC_CLIENTE,
                          C.ESTADO,
                          c.cod_usuario_aud,
                          CC.TIPO_IMPUESTO,
                          C.TOT_COMPROBANTE,
                          C.ID
                ORDER BY C.FEC_COMPROBANTE DESC
                
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 43630118465893534
        }

