    pageItem P646_PERMISO_FACTURA_NEGATIVO (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    dynamicAction cargar-datos-en-coleccion (
        name: Cargar datos en coleccion
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR BLOQUEO IS
                           SELECT
                               C.ID_SUCURSAL,
                               C.ID_ARTICULO,
                               NVL(C.CANT_RESERVADA, 0) CANT_RESERVADA,
                               CA.ID
                          FROM STWV_ARTICULOS_BLOQUEO C
                          JOIN CMW_COTIZA_ARTICULOS CA ON CA.ID = C.ID_COTIZA
                          WHERE C.ID_EMPRESA = :P0_COD_EMPRESA
                            AND C.ID_ARTICULO = :P646_ID
                            AND C.CANT_BLOQUEO > 0
                        GROUP BY C.ID_EMPRESA,
                                 C.ID_SUCURSAL,
                                 C.ID_ARTICULO,
                                 C.CANT_BLOQUEO,
                                 C.FEC_COMPROBANTE,
                                 C.NRO_COMPROBANTE,
                                 C.DESC_VENDEDOR,
                                 C.DESC_CLIENTE,
                                 C.NRO_OCC,
                                 C.FEC_OCC,
                                 C.ID_PEDIDO,
                                 C.FEC_PLAZO,
                                 C.CANT_RESERVADA,
                                 CA.ID,
                                 C.DESC_ARTICULO,
                                 CA.COD_USUARIO_MOD_CANT_RESERVADA,
                                 CA.FEC_MOD_CANT_RESERVADA;
                    BEGIN
                        APEX_COLLECTION.create_or_truncate_collection('COL_BLOQUEO');
                    
                        FOR B IN BLOQUEO
                        LOOP
                            APEX_COLLECTION.add_member(
                                p_collection_name => 'COL_BLOQUEO',
                                p_c001            => B.ID_SUCURSAL,
                                p_c002            => B.ID_ARTICULO,
                                p_n001            => B.ID,
                                p_n002            => B.CANT_RESERVADA
                            );
                        END LOOP;
                    END;
                    ```
                itemsToSubmit: P646_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validar-no-superar-el-bloqueo (
        name: Validar no superar el bloqueo
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @bloqueo-de-stock
            plsqlExpression:
                ```plsql
                TO_NUMBER(:CANT_RESERVADA) <= TO_NUMBER(:CANT_BLOQUEO) OR
                :P646_PERMISO_FACTURA_NEGATIVO = 'S'
                ```
        }
        error {
            errorMessage: La cantidad reservada (&CANT_RESERVADA.) no puede superar la cantidad bloqueada (&CANT_BLOQUEO.)
            associatedColumn: CANT_RESERVADA
        }
    )

    validation validar-no-superar-el-stock (
        name: Validar no superar el stock
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @bloqueo-de-stock
            plsqlExpression:
                ```plsql
                TO_NUMBER(:CANT_RESERVADA) <= TO_NUMBER(OBTENER_CANTIDAD_EXISTENTE(:ID_ARTICULO, :ID_SUCURSAL, 'N')) OR
                :P646_PERMISO_FACTURA_NEGATIVO = 'S'
                ```
        }
        error {
            errorMessage: La cantidad reservada no puede superar el stock
            associatedColumn: CANT_RESERVADA
        }
    )

    validation validar-no-superar-stock-todas-las-lineas (
        name: Validar no superar stock - Todas las lineas
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    VTOTAL_RESERVADO NUMBER;
                    VID_ARTICULO     NUMBER;
                    VID_SUCURSAL     NUMBER;
                
                    CURSOR SUCURSALES IS
                        SELECT DISTINCT(N002) ID_SUCURSAL
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'RESERVAS_ARTICULOS';
                BEGIN
                    FOR SUCURSAL IN SUCURSALES
                    LOOP
                        SELECT DISTINCT N001, SUM(N003)
                          INTO VID_ARTICULO, VTOTAL_RESERVADO
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'RESERVAS_ARTICULOS'
                           AND N002 = SUCURSAL.ID_SUCURSAL;
                
                        IF VTOTAL_RESERVADO > OBTENER_CANTIDAD_EXISTENTE(VID_ARTICULO, VID_SUCURSAL, 'N') THEN
                            RETURN FALSE;
                        END IF;
                    END LOOP;
                
                    RETURN TRUE;
                    
                
                END;
                ```
        }
        error {
            errorMessage: La suma total reservada supera el stock del sistema
        }
        serverSideCondition {
            type: never
        }
    )

    computation p646-permiso-factura-negativo (
        itemName: P646_PERMISO_FACTURA_NEGATIVO
        execution {
            sequence: 10
        }
        computation {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, 135, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER),'FACTURA_STOCK_NEGATIVO')
        }
    )

    process actualizar-coleccion (
        name: Actualizar Coleccion
        type: executeCode
        editableRegion: @bloqueo-de-stock
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSEQ_ID NUMBER;
                BEGIN
                    BEGIN
                        SELECT SEQ_ID
                          INTO VSEQ_ID
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'COL_BLOQUEO'
                           AND N001 = :ID;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VSEQ_ID := NULL;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    
                    IF VSEQ_ID IS NOT NULL THEN
                        APEX_COLLECTION.update_member(
                            p_collection_name => 'COL_BLOQUEO',
                            p_seq             => VSEQ_ID,
                            p_c001            => :ID_SUCURSAL,
                            p_c002            => :ID_ARTICULO,
                            p_n001            => :ID,
                            p_n002            => NVL(:CANT_RESERVADA, 0)
                        );
                    ELSE
                        IF :APEX$ROW_STATUS = 'C' THEN
                             APEX_COLLECTION.add_member(
                                p_collection_name => 'COL_BLOQUEO',
                                p_c001            => :ID_SUCURSAL,
                                p_c002            => :ID_ARTICULO,
                                p_n001            => :ID,
                                p_n002            => :CANT_RESERVADA
                            );
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
