    region bloqueo-de-stock (
        name: Bloqueo de Stock
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_ARTICULO,
                       SUM(C.CANT_BLOQUEO) CANT_BLOQUEO,
                       C.FEC_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.DESC_VENDEDOR,
                       C.DESC_CLIENTE,
                       C.NRO_OCC,
                       C.FEC_OCC,
                       C.FEC_PLAZO FECHA_PLAZO,
                       NVL(C.CANT_RESERVADA, 0) CANT_RESERVADA,
                       CA.ID,
                       C.DESC_ARTICULO,
                       C.COD_USUARIO_MOD_CANT_RESERVADA,
                       C.FEC_MOD_CANT_RESERVADA,
                       C.NRO_LICITACION,
                       C.ID_APROBACION_LIC
                  FROM STWV_ARTICULOS_BLOQUEO C
                LEFT JOIN CMW_COTIZA_ARTICULOS CA ON CA.ID = C.ID_COTIZA
                  WHERE C.ID_EMPRESA = :P0_COD_EMPRESA
                    AND C.ID_ARTICULO = :P646_ID
                    AND C.CANT_BLOQUEO > 0
                GROUP BY C.ID_EMPRESA,
                         C.ID_SUCURSAL,
                         C.ID_ARTICULO,
                         C.CANT_BLOQUEO,
                         C.FEC_COMPROBANTE,
                         C.NRO_COMPROBANTE,
                         C.DESC_VENDEDOR,
                         C.DESC_CLIENTE,
                         C.NRO_OCC,
                         C.FEC_OCC,
                         C.ID_PEDIDO,
                         C.FEC_PLAZO,
                         C.CANT_RESERVADA,
                         CA.ID,
                         C.DESC_ARTICULO,
                         C.COD_USUARIO_MOD_CANT_RESERVADA,
                         C.FEC_MOD_CANT_RESERVADA,
                         C.NRO_LICITACION,
                         C.ID_APROBACION_LIC
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
