    process validar-no-superar-stock (
        name: Validar no superar STOCK
        type: executeCode
        editableRegion: @bloqueo-de-stock
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSTOCK          NUMBER;
                    VCANT_RESERVADA NUMBER;
                
                    CURSOR SUCURSALES IS
                        SELECT C001 ID_SUCURSAL,
                               C002 ID_ARTICULO,
                               SUM(N002) CANT_RESERVADA
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'COL_BLOQUEO'
                        GROUP BY C001, C002;
                BEGIN
                
                    FOR SUC IN SUCURSALES
                    LOOP
                        VSTOCK := OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO    => SUC.ID_ARTICULO,
                                                             P_ID_SUCURSAL    => SUC.ID_SUCURSAL,
                                                             P_IND_DISPONIBLE => 'N');
                        
                        IF (SUC.CANT_RESERVADA > VSTOCK) AND :P646_PERMISO_FACTURA_NEGATIVO = 'N' THEN
                            RAISE_APPLICATION_ERROR(-20000, 'La cantidad total reservada supera al stock del sistema.');
                        END IF;
                    END LOOP;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 39126317717654050
        }
    )

)

