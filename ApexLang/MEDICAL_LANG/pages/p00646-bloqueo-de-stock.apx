    process bloqueo-de-stock-save-interactive-grid-data (
        name: Bloqueo de Stock - Save Interactive Grid Data
        type: executeCode
        editableRegion: @bloqueo-de-stock
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    CASE :APEX$ROW_STATUS
                    WHEN 'C' THEN
                        NULL;
                    WHEN 'U' THEN
                        UPDATE CMW_COTIZA_ARTICULOS
                           SET CANT_RESERVADA = :CANT_RESERVADA,
                               COD_USUARIO_MOD_CANT_RESERVADA = :APP_USER,
                               FEC_MOD_CANT_RESERVADA = SYSDATE
                          WHERE ID = :ID;
                        
                        UPDATE LCW_OFERTAS_APROBACIONES
                           SET CANT_RESERVADA = :CANT_RESERVADA,
                               COD_USUARIO_MOD_CANT_RESERVADA = :APP_USER,
                               FEC_MOD_CANT_RESERVADA = SYSDATE
                         WHERE ID = :ID_APROBACION_LIC;
                        APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('RESERVAS_ARTICULOS');
                    WHEN 'D' THEN
                        NULL;
                    END CASE;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 36912219056424641
        }
    )

