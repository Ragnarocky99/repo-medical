    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @movimientos-de-cajas
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region movimientos-de-cajas (
        name: Movimientos de Cajas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.NRO_MOV_CAJ,
                       C.ID_SUCURSAL,
                       C.FEC_MOV_CAJ,
                       C.ID_CAJA,
                       C.NRO_HABILITACION,
                       C.NUM_ASIENTO,
                       C.ANULADO,
                       C.FEC_ANULACION,
                       C.ID_USUARIO,
                       C.NUM_ASIENTO_ANUL,
                       C.TOT_NRO_MOV_CAJ,
                       C.ID_MONEDA,
                       C.TIPO_CAMBIO,
                       C.TIP_CAMBIO,
                       C.FEC_ALTA,
                       C.VUELTO,
                       C.ID_CORPORACION,
                       C.COD_USUARIO_AUD,
                       C.ID_CLIENTE,
                       REPLACE(REPLACE(C.ASIENTOS,'*'),'cobros') ASIENTOS,
                       (SELECT D.ID
                       FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'cobros'))
                        AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_MOV_CAJ)
                        AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTOS_ID,
                       C.TRANSAC_PRONET,
                       C.ID_HABILITACION,
                       C.NRO_TRANS_PM,
                       C.NRO_PAGO_EXPRESS,
                       C.IND_GEN_AUTO
                  from CCW_MOVIMIENTOS_CAJAS C
                 where C.ID_EMPRESA = :P0_ID_EMPRESA
                   and C.ID_SUCURSAL = :P0_ID_SUCURSAL
                   and C.FEC_MOV_CAJ between :P74_FEC_INI and :P74_FEC_FIN
                   and (C.ID_CLIENTE = :P74_ID_CLIENTE OR :P74_ID_CLIENTE IS NULL)
                   and (C.NRO_MOV_CAJ = :P74_NRO_MOV_CAJA OR :P74_NRO_MOV_CAJA IS NULL)
                order by C.FEC_MOV_CAJ desc,
                         C.NRO_MOV_CAJ desc
                ```
            pageItemsToSubmit: [
                P74_FEC_INI
                P74_FEC_FIN
                P74_ID_CLIENTE
                P74_NRO_MOV_CAJA
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 75
                items: {
                    P75_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
