            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-motivos-de-salida-de-la-empresa (
        name: Carga de Motivos de Salida de la Empresa
        type: form
        source {
            location: localDatabase
            tableName: RHW_MOTIVOS_SALIDA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P303_COD_MOTIVO_SALIDA (
        type: textField
        label {
            label: <p>Cód. Motivo Salida: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-motivos-de-salida-de-la-empresa
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 7
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-motivos-de-salida-de-la-empresa
            column: COD_MOTIVO_SALIDA
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_MOTIVO_SALIDA)), 0) + 1
                FROM RHW_MOTIVOS_SALIDA A
                WHERE A.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

