page 193 (
    name: Carga de Conceptos de Compra
    alias: CARGA-DE-CONCEPTOS-DE-COMPRA1
    title: Carga de Conceptos de Compra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .mostrar{
                   background-color:#eeeeee;
                width: 171px;
                height: 23px;
              
                vertical-align: middle;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-conceptos-de-compra (
        name: Carga de Conceptos de Compra
        type: form
        source {
            location: localDatabase
            tableName: CPW_CONCEPTOS_COMPRAS
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P193_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-conceptos-de-compra
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P193_COD_CONCEPTO_COMP (
        type: displayOnly
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Concepto:</a>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-conceptos-de-compra
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: COD_CONCEPTO_COMP
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT MAX(TO_NUMBER(A.COD_CONCEPTO_COMP))+1
                from CPW_CONCEPTOS_COMPRAS A
                WHERE A.ID_EMPRESA = :P0_COD_EMPRESA;
                ```
        }
    )

    pageItem P193_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-conceptos-de-compra
            slot: regionBody
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P193_DESCRIPCION (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Descripción:</a>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-conceptos-de-compra
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 7
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P193_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-conceptos-de-compra
            slot: regionBody
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P193_ID_CUENTA (
        type: popupLov
        label {
            label: <p>Cuenta:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
            popupWidth: 700
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-cuentas-contables-asentable
        }
        layout {
            sequence: 80
            region: @carga-de-conceptos-de-compra
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: ID_CUENTA
            dataType: number
        }
    )

    pageItem P193_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 60
            region: @carga-de-conceptos-de-compra
            slot: regionBody
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P193_ID_SUBTIP_DENOMINACION (
        type: popupLov
        label {
            label: <p>Sub-Categoria</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION, ID
                  FROM FCW_SUBTIP_DENOMINACIONES_CAB
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                   AND ID_TIP_DENOMINACION = :P193_ID_TIP_DENOMINACION
                ```
        }
        cascadingLov {
            parentItems: P193_ID_TIP_DENOMINACION
            itemsToSubmit: P193_ID_TIP_DENOMINACION
        }
        layout {
            sequence: 100
            region: @carga-de-conceptos-de-compra
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-conceptos-de-compra
            column: ID_SUBTIP_DENOMINACION
            dataType: number
        }
    )

    pageItem P193_ID_TIP_DENOMINACION (
        type: popupLov
        label {
            label: <p>Categoria:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-categoria-flujo-caja
            nullDisplayValue: -- SIN SELECCIONAR --
        }
        layout {
            sequence: 90
            region: @carga-de-conceptos-de-compra
            slot: regionBody
