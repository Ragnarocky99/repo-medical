page 805 (
    name: Parametros Tareas
    alias: PARAMETROS-TAREAS
    title: Parametros Tareas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region parametros-tareas (
        name: Parametros Tareas
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CLW_PARAMETROS_TAREAS
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 61358474361586067
        }

        savedReport 613589 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TIPO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DIAS_PLAZO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @NIVEL_CLIENTE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID_RUBRO_ART
                layout {
                    sequence: 6
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DIAS_PLAZO (
            type: numberField
            heading {
                heading: <p>Dias Plazo</p>
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: DIAS_PLAZO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_RUBRO_ART (
            type: popupLov
            heading {
                heading: <p>Categoria de producto</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-rubros-articulos
                nullDisplayValue: --SIN SELECCIONAR--
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: ID_RUBRO_ART
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column NIVEL_CLIENTE (
            type: textField
            heading {
                heading: <p>Nivel Cliente</p>
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: NIVEL_CLIENTE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPO (
            type: selectList
            heading {
                heading: <p>Tipo</p>
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Gestion;G,Cotizacion;C
                displayNullValue: false
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: TIPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Parametros Tareas
        }
    )

    process parametros-tareas-save-interactive-grid-data (
        name: Parametros Tareas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @parametros-tareas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 61366646523586071
        }
    )

)

