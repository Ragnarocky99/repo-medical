    region listado-mov-caja-cob (
        name: Listado Mov Caja Cob
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.NRO_MOV_CAJ,
                       C.FEC_MOV_CAJ,
                       C.TOT_NRO_MOV_CAJ,
                       C.ID_MONEDA,
                       C.TIPO_CAMBIO,
                       C.ID_CLIENTE,
                       D.TIP_COMPROBANTE,
                       D.SER_COMPROBANTE,
                       D.ID_RECIBO,
                       D.NRO_CUOTA,
                       D.TOT_COMPROBANTE,
                       F.ID_TRANS,
                       F.ID_SUB_TIPO_TRANS,
                       F.ID_PER_JURIDICA,
                       F.NRO_VALOR,
                       F.ID_MONEDA_COBRO,
                       F.TIP_CAMBIO,
                       F.FEC_EMISION,
                       F.FEC_VENCIMIENTO,
                       F.MONTO,
                       F.NRO_CUENTA
                      
                  FROM CCW_MOVIMIENTOS_CAJAS C,
                       CCW_MOVIMIENTOS_COMP  D,
                       CCW_FORMAS_COBROS     F
                 WHERE C.ID_EMPRESA = D.ID_EMPRESA
                   AND C.ID = D.ID_MOV_CAJ
                   AND C.ID_EMPRESA = F.ID_EMPRESA
                   AND C.ID = F.ID_MOV_CAJ
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
