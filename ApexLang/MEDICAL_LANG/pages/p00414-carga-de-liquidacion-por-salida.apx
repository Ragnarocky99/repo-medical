                BEGIN
                :P414_porc_bonif               := W_Busca_parametro( 'RH', 'RH_PORC_BONIF' );
                 :P414_limite_bonif            := to_number( ltrim( rtrim( W_busca_parametro( 'RH', 'RH_LIMITE_BONIF' ) ) ) );
                 :P414_salario_minimo_global   := W_busca_parametro( 'RH', 'RH_SALARIO_MINIMO');
                 :P414_COD_PLANILLA_PROMEDIO   := W_busca_parametro( 'RH', 'RH_PLANILLA_PROMEDIO' ) ;
                 :P414_serie                   := W_busca_parametro( 'RH', 'SERIE_LIQ_SALIDA' );
                 :P414_conc_sueldo             := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_SUELDO'      )) ;
                 :P414_conc_comple             := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_COMPLEMENTO' )) ;
                 :P414_conc_ips                := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_IPS'         )) ;
                 :P414_porc_ips                := W_busca_parametro( 'RH', 'RH_PORC_IPS' ) ;
                 :P414_conc_vacaciones         := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_VACACIONES'  )) ;
                 :P414_conc_iva                := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_IVA'         )) ;
                 --:variables.porc_iva            TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_  := inv.busca_parametro( 'RH', 'RH_PORC_IVA')         ) ;
                 :P414_conc_comis              := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_COMIS_2'     ) ) ;
                 :P414_conc_aguin              := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_AGUIN'       )) ;
                 :P414_conc_preaviso           := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_PREAVISO'    )   ) ;
                 :P414_conc_indemnizacion      := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_INDEMNIZA'   )    ) ;
                 :P414_conc_proporcionales     := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_VAC_PROPORCIONAL' )      ) ;
                 :P414_otros_descuentos        := W_busca_parametro( 'RH', 'RH_CONC_PARA_VALES'  );
                 :P414_conc_anticipo           := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_ANTICIPO'    )   ) ;
                 :P414_planilla_liq_final      := W_busca_parametro( 'RH', 'RH_LIQ_FINAL') ;
                 :P414_jornal_mes              := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_JORNAL'      ) ) ;
                 :P414_conc_bonif              := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_BONIF'       )) ;
                 END;
