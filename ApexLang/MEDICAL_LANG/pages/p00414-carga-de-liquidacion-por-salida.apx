    dynamicAction insertar-detalle (
        name: Insertar Detalle
        execution {
            sequence: 140
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P414_JSON_DET_LIQ
        }
        serverSideCondition {
            type: itemIsNull
            item: P414_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT    SUM(NVL(DECODE(TIPO,'D',MONTO*-1,'H',MONTO),0))
                    INTO :P414_TOTAL 
                    FROM RHW_TMP_DETALLE_SAL_LIQ
                    WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    and DIRECCION_IP = :P414_DIRECCION_IP;
                    
                    :P414_JSON_DET_LIQ:=NULL;
                    DELETE RHW_TMP_DETALLE_SAL_LIQ
                    where DIRECCION_IP = :P414_DIRECCION_IP;
                    COMMIT;
                    
                    ```
                itemsToSubmit: P414_DIRECCION_IP
                itemsToReturn: [
                    P414_JSON_DET_LIQ
                    P414_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var json_detalle = JSON.parse($v('P414_JSON_DET_LIQ'));
                    console.log(json_detalle);
                    
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    var total=0;
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    //total=total+json_detalle.DETALLE[i].MONTO;
                    
                    if((json_detalle.DETALLE[i].ID_EMPRESA!=null)){
                        $model.setValue($newRecord, "ID_EMPRESA",(json_detalle.DETALLE[i].ID_EMPRESA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_CONCEPTO!=null)){
                        $model.setValue($newRecord, "ID_CONCEPTO",(json_detalle.DETALLE[i].ID_CONCEPTO).toString());
                    }
                    if((json_detalle.DETALLE[i].DIRECCION_IP!=null)){
                        $model.setValue($newRecord, "DIRECCION_IP",(json_detalle.DETALLE[i].DIRECCION_IP).toString());
                    }
                    if((json_detalle.DETALLE[i].TIPO!=null)){
                        $model.setValue($newRecord, "TIPO",(json_detalle.DETALLE[i].TIPO).toString());
                    }
                    if((json_detalle.DETALLE[i].MONTO!=null)){
                        $model.setValue($newRecord, "MONTO",(json_detalle.DETALLE[i].MONTO).toString());
                         $model.setValue($newRecord, "MONTO_COPIA",(json_detalle.DETALLE[i].MONTO).toString());
                    
                    }
                    if((json_detalle.DETALLE[i].MONTO_LEGAL!=null)){
                        $model.setValue($newRecord, "MONTO_LEGAL",(json_detalle.DETALLE[i].MONTO_LEGAL).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                        $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_PROGRAMA!=null)){
                        $model.setValue($newRecord, "ID_PROGRAMA",(json_detalle.DETALLE[i].ID_PROGRAMA).toString());
                    }
                    if((json_detalle.DETALLE[i].NRO_CUOTA!=null)){
                        $model.setValue($newRecord, "NRO_CUOTA",(json_detalle.DETALLE[i].NRO_CUOTA).toString());
                    }
                    
                    }
                    
                    //calculaTotales();
                    
                    }
                    ```
            }
            affectedElements {
                selectionType: items
                items: P414_JSON_DET_LIQ
            }
            execution {
                sequence: 10
            }
        )

    )

