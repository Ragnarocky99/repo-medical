    computation p414-nro-liquid (
        itemName: P414_NRO_LIQUID
        execution {
            sequence: 30
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P414_NRO_LIQUID is null then
                      select nvl(max(to_number(NRO_LIQUID)), 0) + 1
                         into v_numero
                         from RHW_CABECERA_LIQ
                         where SER_LIQUID=:P414_SER_LIQUID;
                       RETURN v_numero;
                      end if; 
                      RETURN :P414_NRO_LIQUID;
                   exception
                      when no_data_found then
                        :P414_NRO_LIQUID := 1 ;
                        RETURN :P414_NRO_LIQUID;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Cabecera de Liquidación' || sqlerrm ) ;
                   end ;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P414_ID
        }
    )

