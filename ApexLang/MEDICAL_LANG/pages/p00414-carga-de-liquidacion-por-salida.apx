                --VINCULAR DETALLE CON CABECERA 
                :ID_CAB_LIQUID:=:P414_ID;
                :ID_EMPLEADO := :P414_ID_EMPLEADO;
                :ID_SUCURSAL := :P414_ID_SUCURSAL;
                :ANIO := :P414_ANIO;
                :MES := :P414_MES;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 56708740033535103
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,SAVE
        }
    )

    branch (
        name: GO TO PAGE 484
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 484
                items: {
                    P414_CONC_SUELDO: &P414_CONC_SUELDO.
                    P414_SER_LIQUID: &P414_SER_LIQUID.
                    P414_NRO_LIQUID: &P414_NRO_LIQUID.
                    P414_ID_EMPRESA: &P414_ID_EMPRESA.
                    P414_ID_EMPLEADO: &P414_ID_EMPLEADO.
                    P414_CONC_AGUIN: &P414_CONC_AGUIN.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
            type: itemIsNotNull
            item: P414_ID
        }
    )

)

