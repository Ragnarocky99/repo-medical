    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: items
            items: P414_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P414_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P414_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P414_ASIENTO_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P414_URL
                    P414_ASIENTO_ID
                ]
                itemsToReturn: P414_URL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P414_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction calcula-monto-total (
        name: CALCULA_MONTO_TOTAL
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: MONTO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: P414_TOTAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MONTO
                itemsToSubmit: MONTO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: MONTO_COPIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction d235-inicializar (
        name: D235_INICIALIZAR
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P414_ID IS NOT NULL THEN
                RETURN TRUE;
                ELSE
                RETURN FALSE;
                END IF;
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    //grid.view$.grid("option", "editable", true);
                    //editable true
                    grid.model.setOption("editable", true);
                    grid.setEditMode(true);
                    //editable false
                    //grid.model.setOption("editable", false);
                    grid.setEditMode(false);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction formato-fecha (
        name: FORMATO FECHA
        execution {
            sequence: 110
        }
        when {
            selectionType: items
            items: P414_FEC_LIQUID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P414_FEC_LIQUID) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P414_FEC_LIQUID,'/','');
                            conv_fecha := substr(:P414_FEC_LIQUID,1,2)||'/'||
                                                      substr(:P414_FEC_LIQUID,3,2)||'/'||
                                                      lpad(substr(:P414_FEC_LIQUID,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P414_FEC_LIQUID := conv_fecha;
                            ELSIF (length(:P414_FEC_LIQUID) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P414_FEC_LIQUID) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P414_FEC_LIQUID
