    region carga-de-liquidacion-por-salida-de-empleado (
        name: Carga de Liquidacion por Salida de Empleado
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select R.ID_EMPRESA,
                       R.SER_LIQUID,
                       R.NRO_LIQUID,
                       R.FEC_LIQUID,
                       R.ID_EMPLEADO,
                       R.MES,
                       R.ANIO,
                       R.ID_ESTADO,
                       R.COD_USUARIO_AUD,
                       R.ID,
                       R.ID_SUCURSAL,
                       R.ID_CENTRO,
                       R.IND_VACACIONES,
                       R.IND_CIERRE_MES,
                       R.IND_LIQ_FINAL,
                       R.SUELDO_BASE,
                       R.TIPO_LIQ,
                       R.DIAS_VACACIONES,
                       R.SUELDO_FINAL,
                       R.JORNAL_BASE,
                       R.SALARIO_MINIMO,
                       R.ID_SECTOR_EMP,
                       R.SALDO_ROJO,
                       R.PROV_AGUINALDO,
                       R.PROV_AGUINALDO_LEGAL,
                       R.COMPENSACION,
                       R.ASIENTOS,
                       R.ID_DEPARTAMENTO,
                       R.MONTO,
                       R.DIAS,
                       R.ID_MOTIVO_CALIDA,
                       R.ID_MOTIVO_SALIDA,
                       R.CI,
                       R.ID_CENTRO_PAGO,
                       R.TIP_LIQUID,
                       R.ID_CAB_HABILITACION,
                       R.SUELDO_PROMEDIO,
                       R.NRO_PATRONAL,
                       R.DIRECCION_IP,
                       R.FEC_CARGA,
                       R.FECHA_RENUNCIA,
                       R.FECHA_SALIDA,
                       R.ID_EMPLEADO AS ID_EMPLEADO_1
                       from rhw_cabecera_liq R
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT D.ID_CAB_LIQUID, D.ID_EMPRESA, D.ID, D.ID_CONCEPTO, 
                       D.TIPO, D.CANTIDAD, 
                       D.MONTO, 
                       D.OBSERVACION, D.ID_EMPLEADO, D.MONTO AS MONTO_COPIA,
                       D.NRO_ORDEN, D.COD_USUARIO_AUD,
                       D.ID_PROGRAMA,
                       D.NRO_CUOTA,
                       D.ID_SUCURSAL,
                       D.MONTO_REAL,
                       D.TIP_PROGRAMA,
                       D.FEC_VENCIMIENTO,
                       D.CANT_AUS,
                       D.DIRECCION_IP,
                       D.ANIO,
                       D.MES
                FROM RHW_DETALLE_LIQ D
                WHERE D.ID_CAB_LIQUID=:P414_ID;
                ```
            pageItemsToSubmit: P414_ID
        }
        layout {
            sequence: 10
            parentRegion: @carga-de-liquidacion-por-salida-de-empleado
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--standardPadding
                t-Form--stretchInputs
                margin-top-md
            ]
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                        $( ".selector" ).grid( {
                    autoAddRecord: false
                } );
                        
                           
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calculaTotales();
                                  //  orden=orden-1;
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    calculaTotales();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    calculaTotales();
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    calculaTotales();
                            };    
                
                            /*
                             var rowAddRow = actions.lookup("selection-add-row"),
                                originalDuplicateAction = rowAddRow.action;
                
                            rowAddRow.action = function(_, el){
                                 var $widget = apex.region("Detalles").widget();
                               var $grid = $widget.interactiveGrid("getViews", "grid");
                              var $model = $grid.model;
