    process recalcular (
        name: RECALCULAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  	BEGIN
                      :P414_SALARIO_MES:=REPLACE(:P414_SALARIO_MES, '.', '');
                     
                			CALCULA_IPS(:P414_ID_ESTADO, :P0_ID_EMPRESA, :P414_ID_EMPLEADO, REPLACE(:P414_SALARIO_MES,'.',''), :P414_DIRECCION_IP);
                			aguinaldo(:P414_tot_vac_causadas, :P0_ID_EMPRESA, :P414_ID_EMPLEADO,to_date(:P414_FEC_LIQUID,'DD/MM/YYYY'), :P414_ANIO, :P414_MES, 
                  TO_date(:P414_INGRESO,'DD/MM/YYYY'), :P414_DIRECCION_IP, :P414_DCTO_PREAVISO, 
                  :P414_SALARIO_MES, REPLACE(:P414_SUELDO_BASE,'.',''), :P414_ANIO_ANTIGUEDAD, REPLACE(:P414_SUELDO_FINAL,'.',''), :P414_ID_ESTADO, TO_DATE(:P414_FECHA_SALIDA,'DD/MM/YYYY'), 
                  :P414_DIAS, :P414_CONC_SUELDO);
                
                		EXCEPTION
                			WHEN OTHERS THEN
                				RAISE_APPLICATION_ERROR(-20000, 'ERROR AL REPROCESAR LOS DATOS '||SQLERRM);
                		END;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 56709328167535109
        }
        serverSideCondition {
            whenButtonPressed: @recalcular
        }
    )

    process setear-id (
        name: SETEAR_ID
        type: executeCode
