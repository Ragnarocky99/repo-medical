    dynamicAction permitir-solo-numeros (
        name: Permitir Solo Numeros
        execution {
            sequence: 160
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#P414_NRO_LIQUID").keypress(function(event){ 
                        event = (event) ? event : window.event;
                        var charCode = (event.which) ? event.which : event.keyCode;
                        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                           return false;
                        }
                        return true;
                    });
                    
                    $("#P414_MES").keypress(function(event){ 
                        event = (event) ? event : window.event;
                        var charCode = (event.which) ? event.which : event.keyCode;
                        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                           return false;
                        }
                        return true;
                    });
                    
                    $("#P414_ANIO").keypress(function(event){ 
                        event = (event) ? event : window.event;
                        var charCode = (event.which) ? event.which : event.keyCode;
                        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                           return false;
                        }
                        return true;
                    });
                    ```
