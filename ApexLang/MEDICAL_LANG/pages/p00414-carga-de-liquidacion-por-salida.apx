page 414 (
    name: Carga de Liquidacion por Salida
    alias: CARGA-DE-LIQUIDACION-POR-SALIDA
    title: Carga de Liquidacion por Salida
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_monto_detalle    = model.getFieldKey("MONTO_COPIA") || 0;
                var v_tipo = model.getFieldKey("TIPO");
                var v_monto_total     = 0;
            
            
            
                model.forEach(function(r, index, id) {
            
                    
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                  //  console.log('TIPO ES '+JSON.stringify(r[v_tipo]).v);
                      console.log(r[v_tipo].v);
                          if(r[v_tipo]=='D') {
                        v_monto_total     = ((v_monto_total || 0)    +( parseFloat(r[v_monto_detalle].replace(/\./g,'')) || 0)*-1);
                          }else if (r[v_tipo]=='H'){
                         v_monto_total     = ((v_monto_total || 0)    +( parseFloat(r[v_monto_detalle].replace(/\./g,'')) || 0))
                          }
            
                     //  console.log('Suma '+r[v_monto_detalle]);
                    }
                    
                    
                });
            
                //v_cambio_debe = ( v_mon_debe * parseFloat(v_cambio.replace(/\./g,'')) );
                //v_cambio_haber = ( v_mon_haber * parseFloat(v_cambio.replace(/\./g,'')));
            
                 $s('P414_TOTAL',v_monto_total.toString().replace('.', ''));
            
                 //console.log('cambio es '+ v_cambio_debe + " | " + v_cambio_haber);
            
            }
            
            /*function getCalcSal () {
              apex.server.process(
                'getCalcSal',                             // Process or AJAX Callback name
              );
            }*/
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P414_TOTAL").readOnly = true;
            document.getElementById("P414_INGRESO").readOnly = true;
            document.getElementById("P414_SUELDO_BASE").readOnly = true;
            document.getElementById("P414_DIAS").readOnly = true;
            document.getElementById("P414_SALARIO_MES").readOnly = true;
            document.getElementById("P414_ANIO_ANTIGUEDAD").readOnly = true;
            document.getElementById("P414_MES_ANTIGUEDAD").readOnly = true;
            document.getElementById("P414_SUELDO_PROMEDIO").readOnly = true;
            document.getElementById("P414_TIP_LIQUID").readOnly = true;
            document.getElementById("P414_SUELDO_FINAL").readOnly = true;
            document.getElementById("P414_ASIENTOS").readOnly = true;
            ```
    }
