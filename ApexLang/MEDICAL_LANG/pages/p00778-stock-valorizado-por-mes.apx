page 778 (
    name: Stock Valorizado por Mes
    alias: STOCK-VALORIZADO-POR-MES
    title: Stock Valorizado por Mes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region stock-valorizado-por-mes (
        name: Stock Valorizado por Mes
        type: interactiveReport
        source {
            location: localDatabase
            tableName: STWV_STOCK_VALORIZADO_POR_MES
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                ANHO = :P778_ANHO AND
                (ID_SUCURSAL = :P778_ID_SUCURSAL OR :P778_ID_SUCURSAL IS NULL) AND
                (MES = :P778_MES OR :P778_MES IS NULL) AND
                (ID_ARTICULO = :P778_ID_ARTICULO OR :P778_ID_ARTICULO IS NULL)
                ```
            pageItemsToSubmit: [
                P778_ANHO
                P778_ID_SUCURSAL
                P778_MES
                P778_ID_ARTICULO
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 41121537755100145
        }

