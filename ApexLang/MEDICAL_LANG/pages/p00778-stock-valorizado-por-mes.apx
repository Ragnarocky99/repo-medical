    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction acciones-al-cargar-pagina (
        name: Acciones al cargar pagina
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @stock-valorizado-por-mes
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P778_ANHO
                P778_ID_SUCURSAL
                P778_MES
                P778_ID_ARTICULO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stock-valorizado-por-mes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stock-valorizado-por-mes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

