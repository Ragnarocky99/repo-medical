                sequence: 5
            )

            displayColumn PRESENTACION (
                sequence: 8
            )

            displayColumn UNIDAD_MEDIDA (
                sequence: 9
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression: " ROUND (M * L)"
                    dataType: number
                }
                label {
                    column: Costo Total
                }
                appearance {
                    formatMask: 999G999G999G999G999G999G990
                }
            )

            sort (
                column: MES
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: APXWS_CC_001
            )

            controlBreak (
                column: MES_LETRA
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P778_ANHO (
        type: popupLov
        label {
            label: <p>Año:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 SELECT DISTINCT(TO_CHAR(M.FEC_ENT_SAL, 'yyyy')) D,
                        TO_CHAR(M.FEC_ENT_SAL, 'yyyy') R
                       FROM STWV_MOVIMIENTOS_ENTSAL M
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TO_CHAR(SYSDATE, 'yyyy')
        }
    )

    pageItem P778_ID_ARTICULO (
        type: popupLov
        label {
            label: <p>Articulo:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-articulos
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
