    dynamicAction cargar-datos-en-coleccion (
        name: Cargar datos en coleccion
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR SEGUIMIENTO IS
                            SELECT NVL(S.IND_FINALIZADO, 'N') IND_FINALIZADO,
                                   OBTENER_ESTADO_OCC(S.ID_COTIZA_ART) ESTADO_OCC,
                                   S.ID
                              FROM CLW_ACCIONES_SEGUI S
                            WHERE S.ID_EMPRESA = :P0_ID_EMPRESA
                              AND ((S.ID_PEDIDO, S.ID_PEDIDO_DET) IN (SELECT CA.ID_PEDIDO, CA.ID_PEDIDO_DET
                                                                        FROM CMW_COTIZA_ARTICULOS CA
                                                                       WHERE CA.ID = :P638_ID_COTIZA_ART) OR
                                   S.ID_OFERTA IN (SELECT OA.ID_OFERTA
                                                         FROM LCW_OFERTAS_APROBACIONES OA
                                                        WHERE OA.ID = :P638_ID_APROBACION_LIC));
                    
                    BEGIN
                        APEX_COLLECTION.create_or_truncate_collection('DETALLES_SEGUIMIENTO');
                    
                        FOR SEG IN SEGUIMIENTO
                        LOOP
                            APEX_COLLECTION.add_member(
                                p_collection_name => 'DETALLES_SEGUIMIENTO',
                                p_c001            => SEG.IND_FINALIZADO,
                                p_c002            => SEG.ESTADO_OCC,
                                p_n001            => SEG.ID
                            );
                        END LOOP;
                    END;
                    ```
                itemsToSubmit: [
                    P638_ID_COTIZA_ART
                    P638_ID_APROBACION_LIC
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

