    dynamicAction habilitar-copiado-en-grilla (
        name: Habilitar copiado en grilla
        execution {
            sequence: 50
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.addEventListener('copy', (event) => {
                        const activeElement = $(document.activeElement)[0];
                        const textToCopy = activeElement?.innerText || window.getSelection();
                        event.clipboardData.setData('text/plain', textToCopy);
                        event.preventDefault();
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

