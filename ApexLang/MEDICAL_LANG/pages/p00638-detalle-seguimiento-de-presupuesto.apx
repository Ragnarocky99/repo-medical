    region detalle-seguimiento-de-presupuesto (
        name: Detalle Seguimiento de Presupuesto
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT S.ID,
                       S.ID_EMPRESA,
                       S.DEFINICION,
                       S.FEC_PROX_EVENTO,
                       S.OBSERVACION,
                       S.ID_PEDIDO,
                       S.FEC_CARGA,
                       S.COD_USU_AUD,
                       S.RESPONSABLE,
                       S.ID_ARTICULO,
                       S.ID_PEDIDO_DET,
                       S.ID_COTIZA_ART,
                       S.IND_FINALIZADO,
                       S.COD_USUARIO_FINALIZA,
                       S.FEC_FINALIZADO,
                       S.ID_APROBACION_LIC,
                       S.ID_OFERTA
                  FROM CLW_ACCIONES_SEGUI S
                WHERE S.ID_EMPRESA = :P0_ID_EMPRESA
                  AND ((S.ID_PEDIDO, S.ID_PEDIDO_DET) IN (SELECT CA.ID_PEDIDO, CA.ID_PEDIDO_DET
                                                            FROM CMW_COTIZA_ARTICULOS CA
                                                           WHERE CA.ID = :P638_ID_COTIZA_ART) OR
                       S.ID_OFERTA IN (SELECT OA.ID_OFERTA
                                             FROM LCW_OFERTAS_APROBACIONES OA
                                            WHERE OA.ID = :P638_ID_APROBACION_LIC))
                --AND   ((S.ID_PEDIDO  = :P638_ID_PEDIDO
                --AND   (S.RESPONSABLE = :P638_RESPONSABLE OR :P638_RESPONSABLE IS NULL)
                ---AND   S.ID_ARTICULO = :P638_ID_ARTICULO
                --AND   S.ID_PEDIDO_DET = :P638_ID_PEDIDO_DET) OR S.ID_APROBACION_LIC = :P638_ID_APROBACION_LIC)
                  --AND (S.ID_COTIZA_ART = :P638_ID_COTIZA_ART OR S.ID_APROBACION_LIC = :P638_ID_APROBACION_LIC)
                --AND S.FEC_PROX_EVENTO = (SELECT MAX(SS.FEC_PROX_EVENTO) FROM CLW_ACCIONES_SEGUI SS WHERE SS.ID_PEDIDO = S.ID_PEDIDO)
                
                ```
            pageItemsToSubmit: [
                P638_ID_PEDIDO
                P638_RESPONSABLE
                P638_ID_ARTICULO
                P638_ID_PEDIDO_DET
            ]
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        serverSideCondition {
            type: expression
            plsqlExpression: NVL(:P638_IND_VARIOS, 'N') = 'N'
        }
