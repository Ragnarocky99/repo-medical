        name: Validar tareas
        type: executeCode
        editableRegion: @detalle-seguimiento-de-presupuesto
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VCANT_FINALIZADO    NUMBER;
                    VCANT_REGISTROS     NUMBER;
                BEGIN
                    BEGIN
                        SELECT COUNT(*)
                          INTO VCANT_FINALIZADO
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'DETALLES_SEGUIMIENTO'
                           AND C001 = 'S';
                    END;
                
                     BEGIN
                        SELECT COUNT(*)
                          INTO VCANT_REGISTROS
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'DETALLES_SEGUIMIENTO';
                    END;
                
                    IF VCANT_FINALIZADO = VCANT_REGISTROS THEN
                        RAISE_APPLICATION_ERROR(-20000, 'No puede finalizar todas las tareas.');
                    END IF;
                END;
                ```
