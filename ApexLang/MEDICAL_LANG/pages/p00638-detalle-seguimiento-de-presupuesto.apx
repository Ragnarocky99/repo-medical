            }
        )

    )

    process actualizar-coleccion (
        name: Actualizar Coleccion
        type: executeCode
        editableRegion: @detalle-seguimiento-de-presupuesto
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSEQ_ID NUMBER;
                BEGIN
                    BEGIN
                        SELECT SEQ_ID
                          INTO VSEQ_ID
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'DETALLES_SEGUIMIENTO'
                           AND N001 = :ID;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VSEQ_ID := NULL;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    
                    IF VSEQ_ID IS NOT NULL THEN
                        APEX_COLLECTION.update_member(
                            p_collection_name => 'DETALLES_SEGUIMIENTO',
                            p_seq  => VSEQ_ID,
                            p_c001 => NVL(:IND_FINALIZADO, 'N'),
                            p_c002 => OBTENER_ESTADO_OCC(:ID_COTIZA_ART),
                            p_n001 => :ID
                        );
                    ELSE
                        IF :APEX$ROW_STATUS = 'C' /*AND :RESPONSABLE = TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) */THEN
                            APEX_COLLECTION.add_member(
                                p_collection_name => 'DETALLES_SEGUIMIENTO',
                                p_c001            => NVL(:IND_FINALIZADO, 'N'),
                                p_c002            => OBTENER_ESTADO_OCC(:ID_COTIZA_ART),
                                p_n001            => :ID
                            );
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 37181446642162138
        }
    )

    process cargar-seguimiento-presupuesto-varios (
        name: Cargar Seguimiento Presupuesto - Varios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  CURSOR SELECCION IS
                    SELECT N001 ID_PEDIDO,
                           N002 ID_PEDIDO_DET,
                           N003 ID_COTIZA_ART,
                           N004 ID_ARTICULO,
                           N005 ID_APROBACION_LIC,
                           (SELECT OA.ID_OFERTA FROM LCW_OFERTAS_APROBACIONES OA WHERE OA.ID = N005) ID_OFERTA
                      FROM APEX_COLLECTIONS
                     WHERE COLLECTION_NAME = 'COL_SEGUIMIENTO_PRESUPUESTO';
                  VID_PEDIDO         APEX_T_VARCHAR2 := APEX_STRING.SPLIT(:P635_ID_PEDIDOS, '|');
                  VID_ARTICULO       APEX_T_VARCHAR2 := APEX_STRING.SPLIT(:P635_ID_ARTICULOS, '|');
                  VID_PEDIDO_DETALLE APEX_T_VARCHAR2 := APEX_STRING.SPLIT(:P635_ID_PEDIDO_DETALLES, '|');
                  VID_COTIZA_ART     APEX_T_VARCHAR2 := APEX_STRING.SPLIT(:P635_ID_COTIZA_ARTS, '|');
                  VID_OFERTA         CLW_ACCIONES_SEGUI.ID_OFERTA%TYPE;
                  VID_APROBACION     APEX_T_VARCHAR2 := APEX_STRING.SPLIT(:P635_ID_APROBACIONES, '|');
                  v_cnt              NUMBER;
                BEGIN
                  IF VID_PEDIDO.COUNT = VID_ARTICULO.COUNT AND
                     VID_PEDIDO.COUNT = VID_PEDIDO_DETALLE.COUNT AND
                     VID_PEDIDO.COUNT = VID_COTIZA_ART.COUNT AND
                     VID_PEDIDO.COUNT = VID_APROBACION.COUNT
                
                  THEN
                    --FOR i IN 1 .. VID_PEDIDO.COUNT LOOP
                    FOR I IN SELECCION LOOP
                      SELECT COUNT(*) 
                        INTO v_cnt
                        FROM CLW_ACCIONES_SEGUI
                       WHERE ((ID_PEDIDO      = I.ID_PEDIDO AND
                              ID_PEDIDO_DET  = I.ID_PEDIDO_DET AND
                              ID_COTIZA_ART  = I.ID_COTIZA_ART) OR
                              ID_APROBACION_LIC = I.ID_APROBACION_LIC)
                         AND ID_EMPRESA     = :P0_ID_EMPRESA
                         AND ID_ARTICULO    = I.ID_ARTICULO
                         
                         AND RESPONSABLE    = :P638_RESPONSABLE_
                         AND DEFINICION     = :P638_DEFINICION
                         AND (OBSERVACION   = :P638_OBSERVACION OR :P638_OBSERVACION IS NULL)
                         AND COD_USU_AUD    = :APP_USER
                        -- AND TRUNC(FEC_PROX_EVENTO) = TO_DATE(:P638_FEC_PROX_EVENTO, 'dd/MM/'
                       ;
                
                      IF v_cnt = 0 THEN
                        INSERT INTO CLW_ACCIONES_SEGUI(
                          ID_PEDIDO,
                          ID_EMPRESA,
                          ID_ARTICULO,
                          ID_PEDIDO_DET,
                          ID_COTIZA_ART,
                          DEFINICION,
                          COD_USU_AUD,
                          FEC_CARGA,
                          FEC_PROX_EVENTO,
                          OBSERVACION,
                          RESPONSABLE,
                          ID_APROBACION_LIC,
                          ID_OFERTA
                        ) VALUES (
                          I.ID_PEDIDO,
                          :P0_ID_EMPRESA,
                          I.ID_ARTICULO,
                          I.ID_PEDIDO_DET,
                          I.ID_COTIZA_ART,
                          :P638_DEFINICION,
                          :APP_USER,
                          SYSDATE,
                          TO_DATE(:P638_FEC_PROX_EVENTO,'DD/MM/YYYY HH24:MI'),
                          :P638_OBSERVACION,
                          :P638_RESPONSABLE_,
                          I.ID_APROBACION_LIC,
                          I.ID_OFERTA
                        );
                      END IF;
                    END LOOP;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 18095887032726418
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P638_IND_VARIOS = 'S'
        }
    )

