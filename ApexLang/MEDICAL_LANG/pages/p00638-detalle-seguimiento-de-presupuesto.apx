                    NVL(APEX_STRING.SPLIT(:P635_ID_PEDIDOS, '|').COUNT(), 0) <= 1 AND
                    NVL(APEX_STRING.SPLIT(:P635_ID_APROBACIONES, '|').COUNT(), 0) <= 1
