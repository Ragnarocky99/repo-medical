    dynamicAction js-valida-cantidades (
        name: JS_VALIDA_CANTIDADES
        execution {
            sequence: 350
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: CANTIDAD_COPIA_1
        }
        serverSideCondition {
            type: never
        }

        action js-set-cantidades (
            name: JS_SET_CANTIDADES
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var widget    = apex.region('Detalles').widget();
                    var grid      = widget.interactiveGrid('getViews', 'grid');
                    var model     = grid.model;
                    var selected  = grid.view$.grid("getSelectedRecords");
                    var vTotal_1  = $v('P625_TOTAL_PRECIO_1'); ///RETURN
                    var vTotal_2 = $v('P625_TOTAL_PRECIO_2');
                    var vTotal_3 = $v('P625_TOTAL_PRECIO_3');
                    var vTotal_4 = $v('P625_TOTAL_PRECIO_4');
                    selected.forEach(function (r) {
                    
                        var gridCuota = model.getValue(r,"ID_CUOTA_JSON");
                        var gridOrden = model.getValue(r,"NUM_ORDEN");
                        //console.log("Cuota grilla "+gridCuota);
                        if (vBandera == 0 && vActCuota == gridCuota && vNumOrden == gridOrden) {
                                model.setValue(r, "INTERES", 0);
                                apex.item("P589_BANDERA_CUOTA").setValue("0");
                                apex.item("P589_CUOTA_ACT").setValue(vActCuota);
                            }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

