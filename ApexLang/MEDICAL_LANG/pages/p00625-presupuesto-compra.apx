    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            (function($) {
            
                function update(model) {
                    ///var salKey = model.getFieldKey("PRECIO_1")
                    var precio1Key  = model.getFieldKey("PRECIO_1");
                    var cantidad1Key = model.getFieldKey("CANTIDAD_1");
                    var    total_1 = 0;
                        console.log(">> starting sum precio_1 column")
                    //<--------------------------------------------->//
                    var precio2Key  = model.getFieldKey("PRECIO_2");
                    var cantidad2Key = model.getFieldKey("CANTIDAD_2");
                    var total_2 = 0; 
                        console.log(">> starting sum precio_2 column") 
                    //<--------------------------------------------->//
                    var precio3Key  = model.getFieldKey("PRECIO_3");
                    var cantidad3Key = model.getFieldKey("CANTIDAD_3");
                    var total_3 = 0; 
                        console.log(">> starting sum precio_3 column") 
                    //<--------------------------------------------->//
                    var precio4Key  = model.getFieldKey("PRECIO_4");
                    var cantidad4Key = model.getFieldKey("CANTIDAD_4");
                    var total_4 = 0;            
                    console.log(">> starting sum precio_4 column")
            
                    model.forEach(function(record, index, id) {
                        var precio_1 = parseFloat(record[precio1Key].replace(/\./g, ''));
                        var cantidad_1 = parseFloat(record[cantidad1Key]);
            
                        //<-------------------------------------------->//
                        var precio_2 = parseFloat(record[precio2Key].replace(/\./g, ''));
                        var cantidad_2 = parseFloat(record[cantidad2Key]);
                        //<--------------------------------------------->//
                        var precio_3 = parseFloat(record[precio3Key].replace(/\./g, ''));
                        var cantidad_3 = parseFloat(record[cantidad3Key]);
                        //<--------------------------------------------->//
                        var precio_4 = parseFloat(record[precio4Key].replace(/\./g, ''));
                        var cantidad_4 = parseFloat(record[cantidad4Key]);
            
                            meta = model.getRecordMetadata(id);
            
                        if (!isNaN(precio_1) && !meta.deleted && !meta.agg) {
                            total_1 += precio_1*cantidad_1;            
                        }
                        if (!isNaN(precio_2) && !meta.deleted && !meta.agg) {
                            total_2 += precio_2*cantidad_2;
                        }
                        if (!isNaN(precio_3) && !meta.deleted && !meta.agg) {
                            total_3 += precio_3*cantidad_3;
                        }
                        if (!isNaN(precio_4) && !meta.deleted && !meta.agg) {
                            total_4 += precio_4*cantidad_4;
                        }
                    });
                    console.log(">> setting sum precio_1 column to " + total_1)
                    $s("P625_TOTAL_PRECIO_1", total_1);
                    //<------------------------------------------------------>//
                    console.log(">> setting sum precio_2 column to " + total_2)
                    $s("P625_TOTAL_PRECIO_2", total_2);
                    //<------------------------------------------------------>//
                    console.log(">> setting sum precio_3 column to " + total_3)
                    $s("P625_TOTAL_PRECIO_3", total_3);
                    //<------------------------------------------------------>//
                    console.log(">> setting sum precio_4 column to " + total_4)
                    $s("P625_TOTAL_PRECIO_4", total_4);
                    
                }
            
                $(function() {
                   
                    $("#Detalles").on("interactivegridviewmodelcreate", function(event, ui) {
                        var sid,
                            model = ui.model;
            
                        if ( ui.viewId === "grid" ) {
                            sid = model.subscribe( {
                                onChange: function(type, change) {
                                    console.log(">> model changed ", type, change);
                                    if ( type === "set" ) {
                                         if (change.field === "PRECIO_1" ||change.field==="CANTIDAD_1") {
                                            update( model );
                                        }
                                        else if (change.field === "PRECIO_2" ||change.field==="CANTIDAD_2") {
                                            update( model );
                                        }
                                        else if (change.field === "PRECIO_3" ||change.field==="CANTIDAD_3") {
                                            update( model );
                                        }
                                        else if (change.field === "PRECIO_4" ||change.field==="CANTIDAD_4") {
                                            update( model );
                                        }
                                    } else if (type !== "move" && type !== "metaChange") {
                                      update( model );
                                    }
                                },
                                progressView: $("#P625_TOTAL_PRECIO_1"),                    
                                progressView: $("#P625_TOTAL_PRECIO_2"),
                                progressView: $("#P625_TOTAL_PRECIO_3"),
                                progressView: $("#P625_TOTAL_PRECIO_4") 
                            } );
                             update( model );           
                            model.fetchAll(function() {});
                        }
                    });
            
                });
            
            })(apex.jQuery);
            ```
