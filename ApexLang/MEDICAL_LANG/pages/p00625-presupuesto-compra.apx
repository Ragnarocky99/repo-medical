    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID_EMPRESA,
                       D.ID_SUCURSAL,
                       D.TIP_COMPROBANTE,
                       D.NRO_COMPROBANTE,
                       D.NRO_ITEM,
                       D.IND_ORDEN,
                       D.ID_ARTICULO,
                       D.CANTIDAD_1, 
                       D.CANTIDAD_1 AS CANTIDAD_COPIA_1, 
                       D.CANTIDAD_2,
                       D.CANTIDAD_2 AS CANTIDAD_COPIA_2,
                       D.CANTIDAD_3,
                       D.CANTIDAD_3 AS CANTIDAD_COPIA_3,
                       D.CANTIDAD_4,
                       D.CANTIDAD_4 AS CANTIDAD_COPIA_4,
                       D.PRECIO_1 AS PRECIO_COPIA_1,
                       D.PRECIO_1,
                       D.PRECIO_2,
                       D.PRECIO_2 AS PRECIO_COPIA_2,
                       D.PRECIO_3,
                       D.PRECIO_3 AS PRECIO_COPIA_3,
                       D.PRECIO_4,
                       D.PRECIO_4 AS PRECIO_COPIA_4,
                       D.APROBADO_1,
                       D.APROBADO_2,
                       D.APROBADO_3,
                       D.APROBADO_4,
                       D.ID_COTIZA_CAB,
                       D.ID,
                       A.COD_ARTICULO,
                       A.DESCRIPCION AS DESC_ARTICULO,
                       A.ID_ENVASE,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MARCA
                  from CMW_COTIZA_DET D, STW_ARTICULOS A
                  WHERE D.ID_COTIZA_CAB = :P625_ID
                  AND   D.ID_EMPRESA = :P0_ID_EMPRESA
                  AND  D.ID_ARTICULO=A.ID
                ```
            pageItemsToSubmit: P625_ID
        }
