    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 360
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    NVL(A.ESTADO,'N')='S'
                    AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P625_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-cantidad (
        name: Calcular cantidad 1
        execution {
            sequence: 220
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: CANTIDAD_1
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :CANTIDAD_1 <= 0 then
                    :CANTIDAD_1 := null;
                    RAISE_APPLICATION_ERROR(-20000, 'El cantidad no debe ser menor o igual a 0');
                    end if;
                    ```
                itemsToSubmit: CANTIDAD_1
                itemsToReturn: CANTIDAD_1
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: P625_TOTAL_PRECIO_1
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    :cantidad_1
                    
                    ```
                itemsToSubmit: CANTIDAD_1
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_COPIA_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P625_TOTAL_PRECIO_1
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: CANTIDAD_1
            }
        )

    )

