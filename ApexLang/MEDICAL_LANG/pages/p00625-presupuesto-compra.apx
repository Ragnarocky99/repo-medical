    region nº-solicitud (
        name: Nº  Solicitud
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @presupuesto-compra
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region presupuesto-compra (
        name: Presupuesto Compra
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       ID_SUCURSAL,
                       TIP_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_PROVEEDOR_1,
                       ID_PROVEEDOR_2,
                       ID_PROVEEDOR_3,
                       ID_PROVEEDOR_4,
                       ID_MONEDA_1,
                       ID_MONEDA_2,
                       ID_MONEDA_3,
                       ID_MONEDA_4,
                       TIP_CAMBIO_1,
                       TIP_CAMBIO_2,
                       TIP_CAMBIO_3,
                       TIP_CAMBIO_4,
                       OBSERVACION_1,
                       OBSERVACION_2,
                       OBSERVACION_3,
                       OBSERVACION_4,
                       ID,
                       ID_CONDICION_1,
                       ID_CONDICION_2,
                       ID_CONDICION_3,
                       ID_CONDICION_4
                  from CMW_COTIZA_CAB
                ```
            pageItemsToSubmit: P625_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

