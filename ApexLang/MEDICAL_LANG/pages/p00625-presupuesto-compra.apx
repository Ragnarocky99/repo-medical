    dynamicAction genera-json (
        name: Genera json
        execution {
            sequence: 260
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: [
                PRECIO_COPIA_1
                CANTIDAD_COPIA_1
                PRECIO_COPIA_2
                CANTIDAD_COPIA_2
                PRECIO_COPIA_3
                CANTIDAD_COPIA_3
                PRECIO_COPIA_4
                CANTIDAD_COPIA_4
            ]
        }
        serverSideCondition {
            type: never
        }

        action genera-json (
            name: Genera json
            action: plugin/getIgData
            settings {
                igRegionStaticId: Detalles
                itemToHoldData: P625_JSON_DETALLES
                includeColumns: PRECIO_1,CANTIDAD_1,PRECIO_2,CANTIDAD_2,PRECIO_3,CANTIDAD_3,PRECIO_4,CANTIDAD_4,
            }
            execution {
                sequence: 10
            }
        )

        action lee-json (
            name: LEE_JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vJson         clob;
                        vTotal_1      number(20,2); ----out
                        vTotal_2      number(20,2);
                        vTotal_3      number(20,2);
                        vTotal_4      number(20,2);
                    
                    BEGIN
                        ------------------------------------
                        vJson         := :P625_JSON_DETALLES;
                    
                      IF :P625_ID_PROVEEDOR_1 IS NOT NULL OR :P625_ID_PROVEEDOR_2 IS NOT NULL 
                        OR :P625_ID_PROVEEDOR_3 IS NOT NULL OR :P625_ID_PROVEEDOR_4 IS NOT NULL THEN
                           CMWP_CALCULA_TOTAL(p_json  => vJson,
                                              pTotal1 => vTotal_1,
                                              pTotal2 => vTotal_2,
                                              pTotal3 => vTotal_3, 
                                              pTotal4 => vTotal_4);               
                        END IF;
                    
                        :P625_TOTAL_PRECIO_1 := vTotal_1;
                        :P625_TOTAL_PRECIO_2 := vTotal_2;
                        :P625_TOTAL_PRECIO_3 := vTotal_3;
                        :P625_TOTAL_PRECIO_4 := vTotal_4;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P625_JSON_DETALLES
                    P625_ID_PROVEEDOR_1
                    P625_ID_PROVEEDOR_2
                    P625_ID_PROVEEDOR_3
                    P625_ID_PROVEEDOR_4
                ]
                itemsToReturn: [
                    P625_TOTAL_PRECIO_1
                    P625_TOTAL_PRECIO_2
                    P625_TOTAL_PRECIO_3
                    P625_TOTAL_PRECIO_4
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction inicia-detalle (
        name: INICIA_DETALLE
        execution {
            sequence: 190
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    //grid.view$.grid("option", "editable", true);
                    //editable true
                    grid.model.setOption("editable", true);
                    grid.setEditMode(true);
                    //editable false
                    //grid.model.setOption("editable", false);
                    grid.setEditMode(false);
                    
                    let actions = apex.region("Detalles").call("getActions");
                    //actions.hide("selection-duplicate");
                    //actions.hide("selection-delete");
                    //actions.hide("selection-copy-down");
                    //actions.hide("selection-copy");
                    //actions.hide("selection-refresh"); 
                    //actions.hide("selection-revert"); 
                    actions.show("selection-add-row");
