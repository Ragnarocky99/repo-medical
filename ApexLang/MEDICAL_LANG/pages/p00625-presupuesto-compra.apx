    computation p625-nro-comprobante (
        itemName: P625_NRO_COMPROBANTE
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(NRO_COMPROBANTE)), 0)+1
                from CMW_COTIZA_CAB
                WHERE ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P625_ID
        }
    )

    computation p625-total-aprobado (
        itemName: P625_TOTAL_APROBADO_1
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(SUM(PRECIO_1*CANTIDAD_1),0) FROM CMW_COTIZA_DET D
                WHERE D.APROBADO_1 = 'S'
                AND   D.ID_COTIZA_CAB = :P625_ID
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P625_ID
        }
    )

    computation p625-total-aprobado-2 (
        itemName: P625_TOTAL_APROBADO_2
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(SUM(PRECIO_2*CANTIDAD_2),0) FROM CMW_COTIZA_DET D
                WHERE D.APROBADO_2 = 'S'
                AND   D.ID_COTIZA_CAB = :P625_ID
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P625_ID
        }
    )

    computation p625-total-aprobado-3 (
        itemName: P625_TOTAL_APROBADO_3
        execution {
            sequence: 40
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(SUM(PRECIO_3*CANTIDAD_3),0) FROM CMW_COTIZA_DET D
                WHERE D.APROBADO_3 = 'S'
                AND   D.ID_COTIZA_CAB = :P625_ID
