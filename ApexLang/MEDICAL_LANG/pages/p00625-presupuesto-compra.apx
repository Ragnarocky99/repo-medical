    dynamicAction setear-articulos (
        name: Setear articulos
        execution {
            sequence: 390
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: ID_ARTICULO
        }

        action descripción-articulo (
            name: Descripción Articulo
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM 
                    STW_ARTICULOS WHERE
                    ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT COD_ARTICULO 
                    into :cod_articulo
                    FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:ID_ARTICULO;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: COD_ARTICULO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    console.log(array);
                    grid.gotoCell(array[0][18],'COD_ARTICULO');
                    
                    
                    
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P625_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT id_envase,id_unidad_medida,id_marca FROM 
                    STW_ARTICULOS WHERE
                    ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: [
                    ID_ENVASE
                    ID_UNIDAD_MEDIDA
                    ID_MARCA
                ]
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P625_BANDERA
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-cambio (
        name: Setear Cambio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P625_ID_MONEDA_1
        }
        comments {
            comments: Setea el cambio de la moneda seleccionada
        }

        action cambio (
            name: Cambio
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                    RETURN FTIPOS_CAMBIO(:P625_ID_MONEDA_1,SYSDATE,'C','V');
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al encontrar el cambio de la moneda');
                    END;
                    ```
                itemsToSubmit: P625_ID_MONEDA_1
            }
            affectedElements {
                selectionType: items
                items: P625_TIP_CAMBIO_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

