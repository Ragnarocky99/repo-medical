    region embarque (
        name: Embarque
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select em.id, em.nro_embarque, em.fec_embarque, em.id_proforma,
                pc.nro_comprobante as nro_proforma,
                 ped.nro_comprobante as nro_pedido, pc.ser_comprobante, em.id_puerto,
                  pu.descripcion des_puerto, pr.cod_proveedor, ltrim(pe.nombre) nom_transporte ,PC.FEC_COMPROBANTE AS FEC_PROFORMA,pu.cod_puerto,V.DESCRIPCION
                from cmw_embarques em,
                 cmw_proformas_cabecera pc
                 , cmw_puertos pu, 
                 cmw_proveedores pr, 
                 bsw_personas pe,
                  bsw_parametros_generales pg ,
                  cmw_pedidos_cabecera ped,
                  CMW_VIAS V 
                  where em.id_empresa = :P0_ID_EMPRESA and em.id_empresa 
                  = pc.id_empresa and pg.id_modulo = w_busca_parametro('CM','ID_MODULO_CM') and
                   pg.parametro = 'TIPO_PROFORMA' and pc.tip_comprobante 
                   = ltrim(rtrim(pg.valor)) and
                    pc.id=em.id_proforma and 
                     pu.id = em.id_puerto and 
                     pr.id_empresa = em.id_empresa
                      and pr.id = em.transporte 
                      and pr.id_persona = pe.id 
                      and ped.id=pc.referencia
                      AND EM.ID_VIA=V.ID(+)
                      order by em.fec_embarque desc, em.nro_embarque desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        readOnly {
            type: never
        }
    )

