    dynamicAction validar-fecha-llegada (
        name: Validar Fecha Llegada
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @rutas-de-embarque
            columns: FEC_PROB_LLEGADA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :FEC_PROB_LLEGADA <= :FEC_RUTA THEN 
                    :FEC_PROB_LLEGADA:=NULL;
                    RAISE_APPLICATION_ERROR(-20000,'La fecha de probable llegada debe ser mayor que la fecha de embarque');
                    END IF;
                    
                    
                    
                    ```
                itemsToSubmit: [
                    FEC_RUTA
                    FEC_PROB_LLEGADA
                ]
                itemsToReturn: FEC_PROB_LLEGADA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

