page 603 (
    name: Generar Remision
    alias: GENERAR-REMISION
    title: Generando Envio...
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 300
        maxWidth: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region previsualizacion (
        name: Previsualizacion
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT            
                           C.NRO_COMPROBANTE,
                           C.ID_SUCURSAL,
                           TRUNC(C.FEC_COMPROBANTE) FEC_COMPROBANTE,
                           D.ID_ARTICULO,
                           D.CANTIDAD_APROBADA,
                           D.CANTIDAD_A_ENTREGAR,
                           D.DESC_ARTICULO,
                           D.NRO_OCC,
                           C.ID_CLIENTE,
                           E.CANT_DISPON STOCK
                    FROM  VTW_PEDIDOS_CABECERA C,
                          CMW_COTIZA_ARTICULOS D,
                          STW_ARTICULOS        A,
                          STW_EXISTENCIA_ART   E
                    WHERE C.ID             = D.ID_PEDIDO
                    AND   C.ID_EMPRESA     = D.ID_EMPRESA
                    AND   D.ID_ARTICULO    = A.ID
                    AND   E.ID_ARTICULO(+) = A.ID
                    AND   E.ID_SUCURSAL(+) = C.ID_SUCURSAL
                    AND NVL(D.CANTIDAD_A_ENTREGAR,0) > 0
                    AND   D.NRO_OCC     = :P603_NRO_OCC
                    AND nvl(c.autoriza_stock,'N') = 'S'
                    AND (nvl(D.CANTIDAD,0)-nvl(D.Cant_Anulada,0)) != 0
                    AND C.ID_SUCURSAL = :P0_ID_SUCURSAL
                    AND (NVL(E.CANT_DISPON, 0) > 0 OR W_BUSCA_PERMISO(:P0_ID_EMPRESA, 135, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER),'FACTURA_STOCK_NEGATIVO') = 'S')
                    AND C.Id not in (14100, 13860, 14781, 14460, 14768, 14801, 15970, 16010, 17320, 17313, 17314, 17319, 18973, 17315, 17316,24672,16490,17351);
                ```
            pageItemsToSubmit: P603_NRO_OCC
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 46211970106905905
        }

        savedReport 463735 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @STOCK
                layout {
                    sequence: 16
                }
            )

            displayColumn (
                column: @NRO_COMPROBANTE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ID_SUCURSAL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @FEC_COMPROBANTE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID_ARTICULO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @CANTIDAD_APROBADA
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @CANTIDAD_A_ENTREGAR
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @DESC_ARTICULO
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @NRO_OCC
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @ID_CLIENTE
                layout {
                    sequence: 15
                }
            )

        )

        column CANTIDAD_APROBADA (
            type: numberField
            heading {
                heading: <p>Cantidad Aprobada</p>
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_APROBADA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column CANTIDAD_A_ENTREGAR (
            type: numberField
            heading {
                heading: <p>Cantidad A Entregar</p>
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_A_ENTREGAR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DESC_ARTICULO (
            type: textarea
            heading {
                heading: <p>Desc Articulo</p>
            }
            layout {
                sequence: 130
            }
            validation {
                maxLength: 600
            }
            source {
                databaseColumn: DESC_ARTICULO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
