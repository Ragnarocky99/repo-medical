    region detalle-compra-familia-rubro (
        name: Detalle Compra Familia-Rubro
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       SUM(NVL(D.CANTIDAD_UB,0)) CANTIDAD_UB,
                       SUM(NVL(D.MONTO_TOTAL,0)) MONTO_TOTAL,
                       SUM(NVL(D.TOTAL_IVA,0)) TOTAL_IVA,
                       SUM(NVL(D.MONTO_TOTAL_C_IVA,0)) MONTO_TOTAL_C_IVA,
                       RU.DESCRIPCION DESC_RUBRO,
                       RU.COD_RUBRO,
                       FA.DESCRIPCION DESC_FAMILIA,
                       FA.COD_FAMILIA
                       
                FROM CMW_COMPRAS_CABECERA C,
                     CMW_COMPRAS_DETALLE D,
                     BSW_TIPOS_COMPROBANTES TC,
                     BSW_EMPRESAS E,
                     BSW_SERIES_COMPROB SC,
                     STW_ARTICULOS A,
                     CMW_PROVEEDORES PP,
                     BSW_PERSONAS PV,
                     STW_FAMILIA FA,
                     STW_RUBRO   RU
                WHERE   C.ID_EMPRESA  = :P0_COD_EMPRESA
                
                  AND C.ID = D.ID_COMPRAS_CAB
                  AND C.FEC_COMPROBANTE BETWEEN :P257_FECHA_INI AND :P257_FECHA_FIN
                  AND (RU.ID = :P257_RUBRO OR :P257_RUBRO IS NULL)
                  AND (FA.ID =:P257_FAMILIA OR :P257_FAMILIA IS NULL)
                  --AND (A.ID= :P258_ARTICULO OR :P258_ARTICULO IS NULL) 
                  AND C.ID_EMPRESA = E.ID
                  AND C.ID_EMPRESA = TC.ID_EMPRESA
                  AND C.TIP_COMPROBANTE = TC.TIP_COMPROBANTE
                  
                  AND C.ID_EMPRESA      = SC.ID_EMPRESA
                  AND C.TIP_COMPROBANTE = SC.TIP_COMPROBANTE
                  AND C.SER_COMPROBANTE = SC.SER_COMPROBANTE 
                  
                  AND D.ID_ARTICULO = A.ID
                  AND C.ID_PROVEEDOR = PP.ID
                  AND A.ID_EMPRESA = FA.ID_EMPRESA(+)
                  AND A.ID_FAMILIA = FA.ID(+)
                  AND A.ID_EMPRESA = RU.ID_EMPRESA(+)
                  AND A.ID_RUBRO   = RU.ID(+)
                
                GROUP BY RU.DESCRIPCION,
                       RU.COD_RUBRO,
                       FA.DESCRIPCION,
                       FA.COD_FAMILIA
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 60208245918806343
        }

