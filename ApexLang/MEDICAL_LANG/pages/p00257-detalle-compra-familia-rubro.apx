    branch (
        name: Go To Page 270
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 270
                items: {
                    P257_FECHA_INI: &P257_FECHA_INI.
                    P257_FECHA_FIN: &P257_FECHA_FIN.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

