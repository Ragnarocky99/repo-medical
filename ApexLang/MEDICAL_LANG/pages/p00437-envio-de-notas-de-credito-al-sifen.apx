    pageItem P437_SER_COMPROBANTE (
        type: popupLov
        label {
            label: <p>Serie Fact.: &ensp;</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SER_TIMBRADO,ID FROM BSW_SERIES_COMPROB S
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                  AND ID_SUCURSAL=:P0_ID_SUCURSAL
                  AND NVL(IND_FACT_ELECTRONICA,'X')='S'
                  AND ID_TIP_COMP=TRAE_ID_TIPO_COMPROBANTE(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('VT','TIPO_NOTACRE'));
                ```
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

