    region envio-de-notas-de-credito-al-sifen (
        name: Envio de Notas de Credito al SIFEN
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.TOT_COMPROBANTE,
                       C.FEC_ALTA,
                       C.CAMBIO_DOLAR,
                       C.CAMBIO_MONEDA_PRECIO,
                       C.NOM_CLIENTE,
                       C.RUC_CLIENTE,
                       C.NRO_AUTORIZ_FACT,
                       C.COD_USUARIO_AUD,
                       C.TIENE_REMISION,
                       C.NRO_MOV_CAJ,
                       C.ID_DESPACHO_CAB,
                       C.ID_CLIENTE,
                       C.ID_PEDIDO_REF,
                       DECODE(C.ESTADO,'A', 'S', 'N') ANULADO,
                       NVL(C.IND_ENVIADO_FE,'N') AS IND_ENVIADO,
                       'N' IND_SELECCIONADO,
                       NVL(C.IND_APROBADO_FE,'N') AS IND_APROBADO,
                       NVL(C.IND_RECHAZADO_FE,'N') IND_RECHAZADO_FE
                from VTW_COMPROBANTES_CABECERA C , BSW_SERIES_COMPROB S 
                where C.ID_EMPRESA = :P0_ID_EMPRESA 
                AND C.tip_comprobante in ('NCR')
                --and ( nvl( C.ind_enviado_fe, 'N' ) = 'N' or nvl( C.ind_rechazado_fe, 'N' ) = 'S'  )
                and trunc( C.fec_comprobante ) between nvl( :p437_fec_desde, trunc( C.fec_comprobante ) ) and nvl( :P437_fec_hasta, trunc( C.fec_comprobante ) ) 
                --and C.fec_comprobante >= '02/01/2023'
                and C.nro_comprobante between nvl( :P437_nro_desde, C.nro_comprobante ) and nvl( :P437_nro_hasta, C.nro_comprobante ) 
                and (C.id_serie_comp =  :P437_ser_comprobante or :P437_SER_COMPROBANTE  is null) 
                and c.id_serie_comp  = s.id
                and s.ind_fact_electronica='S'
                
                fetch next 200 rows only
                ```
            pageItemsToSubmit: [
                P437_AMBIENTE_SIFEN
                P437_SER_COMPROBANTE
                P437_FEC_DESDE
                P437_FEC_HASTA
                P437_NRO_DESDE
                P437_NRO_HASTA
            ]
        }
