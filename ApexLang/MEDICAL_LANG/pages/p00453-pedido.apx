    dynamicAction setea-diferencia (
        name: Setea Diferencia
        execution {
            sequence: 330
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                STOCK
            ]
        }

        action diferencia (
            name: DIFERENCIA
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      VDIFERENCIA    NUMBER;
                      VCANT          NUMBER;
                        BEGIN
                            VCANT := :STOCK; -- Traemos directo el valor de la columna;
                            -- select existencia_actual(:P0_ID_SUCURSAL,:ID_ARTICULO,:P0_ID_EMPRESA, 'S')
                            --         -
                            --        obtener_cantidad_bloqueo(:ID_ARTICULO,:P0_ID_SUCURSAL, 'S','S') 
                            --        as EXISTENCIA
                            --   INTO VCANT
                            --   from bsw_sucursales su
                            --   where su.id = :P0_ID_SUCURSAL;
                            ----SE COMENTA SUCURSAL POR QUE CONTROL DE EXISTENCIA POR SUCURSAL SOLO DEBE TENER EN FACTURA, A PEDIDO DE LAURA  15/03/2024
                                IF NVL(VCANT,0) < 0  THEN
                                   VDIFERENCIA := 0;
                                ELSE
                                   VDIFERENCIA := VCANT;
                                END IF;
                            RETURN VDIFERENCIA - :CANTIDAD;
                        EXCEPTION 
                          WHEN OTHERS THEN
                           RETURN NULL;
                        END;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    CANTIDAD
                    DIFERENCIA
                    STOCK
                ]
            }
            affectedElements {
                selectionType: columns
                columns: DIFERENCIA
            }
            execution {
                sequence: 90
            }
        )

    )

