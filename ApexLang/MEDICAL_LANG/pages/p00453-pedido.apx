    computation p453-iva (
        itemName: P453_IVA_10
        execution {
            sequence: 110
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_PEDIDOS_DETALLE
                    WHERE :P453_ID=ID_PEDIDO_CABECERA;
                    item_detalle VTW_PEDIDOS_DETALLE%rowtype;
                    v_total_iva_10    VTW_COMPROBANTES_CABECERA.TOT_IVA%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_iva_10:=v_total_iva_10+item_detalle.TOTAL_IVA;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_10;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
    )

