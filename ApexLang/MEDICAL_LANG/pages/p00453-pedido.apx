    dynamicAction abrir-lista-de-valores (
        name: Abrir Lista de Valores
        execution {
            sequence: 190
            eventScope: once
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P453_ID
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P453_LV_TALONARIOS_lov_btn").click();
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    vnro_ini  NUMBER(8);
                    V_IP_MAQUINA VARCHAR(200);
                    
                    BEGIN
                    
                    
                      
                    
                    SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                    
                        select count(*)
                          into vnro_ini
                          from BSW_series_comprob s
                         where S.ID_EMPRESA   = :P0_ID_EMPRESA
                           and S.TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT', 'TIPO_COMPROBANTE_VENTA')
                           and S.ID_SUCURSAL  = :P0_ID_SUCURSAL
                           and nvl( S.IND_ACTIVO, 'S' ) <> 'N'
                           and S.TERMINAL = V_IP_MAQUINA;
                        -- and t.cod_empresa   = s.cod_empresa
                        -- and t.tip_talonario = s.tip_comprobante
                        -- and t.serie         = s.ser_comprobante;
                        -- and nvl(s.terminal,vterminal) = vterminal ;
                    --     and s.terminal      = vterminal ;
                    
                        IF nvl( vnro_ini, 0 ) > 1 THEN
                            RETURN TRUE;
                        END IF;
                    
                      END;
                    
                    ```
            }
        )

    )

    dynamicAction abrir-talonario (
        name: Abrir Talonario
        execution {
            sequence: 210
        }
        when {
            event: click
            selectionType: button
            button: @talonario
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P453_LV_TALONARIOS_lov_btn").click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction asiento-doble-click (
        name: ASIENTO_DOBLE_CLICK
        execution {
            sequence: 220
        }
        when {
            event: click
            selectionType: items
            items: P453_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P453_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P453_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P453_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P453_URL
                    P453_ASIENTOS_ID
                ]
                itemsToReturn: P453_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P453_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 100
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.cod_articulo
                    INTO :cod_articulo
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: COD_ARTICULO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

