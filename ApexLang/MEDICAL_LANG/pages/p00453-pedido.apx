    dynamicAction setear-precios-y-lote (
        name: Setear Precios y Lote
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_ARTICULO
        }
        comments {
            comments: "Al seleccionar un producto setea su precio y lote correspondiente si es que tienen "
        }

        action descripción-articulo (
            name: Descripción Articulo
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :ID_ARTICULO IS NULL OR :DESC_ARTICULO_STD IS NULL THEN
                        BEGIN
                            select ar.descripcion,
                            case :ID_ARTICULO
                              when to_char(813) then :DESC_ARTICULO
                              ELSE null--ar.descripcion
                              end
                              into :DESC_ARTICULO, :DESC_ARTICULO_STD
                             FROM STW_ARTICULOS AR 
                             WHERE AR.ID = :ID_ARTICULO;
                             --and ar.id != 813;
                        EXCEPTION 
                           WHEN NO_DATA_FOUND THEN 
                             NULL;
                        END;
                    END IF;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    DESC_ARTICULO
                    DESC_ARTICULO_STD
                ]
                itemsToReturn: [
                    DESC_ARTICULO
                    DESC_ARTICULO_STD
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                column: BANDERA
                value: 1
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null then
                         :PRECIO_UNITARIO_C_IVA :=0;
                    end if;
                    if :IVA IS NULL THEN
                    :IVA:=0;
                    END IF;
                    
                    BEGIN 
                        SELECT A.ID_UNIDAD_MEDIDA,
                               A.COD_ORIGEN_ART,
                               A.ID_ENVASE,
                               A.ID_MARCA,
                               A.ID_GRUPO_ART,
                               A.ID_RUBRO,
                               DECODE(A.ID,
                                      813,
                                      0,
                                      /*OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO => A.ID,
                                                                 P_ID_SUCURSAL => NULL,
                                                                 P_IND_DISPONIBLE => 'S')*/
                                      CMWK_COTIZACIONES.TRAE_RESERVA_DISPONIBLE(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                                                                P_ID_ARTICULO => A.ID,
                                                                                P_ID_SUCURSAL => NULL)) STOCK
                          INTO :ID_UNIDAD_MEDIDA,
                               :COD_ORIGEN_ART,
                               :ID_ENVASE,
                               :ID_MARCA,
                               :ID_GRUPO_ART,
                               :ID_RUBRO,
                               :STOCK
                          FROM STW_ARTICULOS A
                         WHERE A.ID_EMPRESA = :P0_COD_EMPRESA
                           AND A.ID = :ID_ARTICULO;
                        END;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            :STOCK := 0;
                    BEGIN
                    /*SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;*/
                    /*
                    SELECT 0
                    INTO :CANTIDAD 
                    FROM DUAL;*/
                    
                    SELECT ID_UNIDAD_MEDIDA
                    INTO :ID_UNIDAD_MEDIDA
                     FROM 
                    STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    SELECT COD_ORIGEN_ART
                    INTO :COD_ORIGEN_ART
                     FROM 
                    STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    SELECT ID_ENVASE
                    INTO :ID_ENVASE
                     FROM 
                    STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    SELECT ID_MARCA
                    INTO :ID_MARCA
                     FROM 
                    STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    SELECT ID_GRUPO_ART
                    INTO :ID_GRUPO_ART
                     FROM 
                    STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    SELECT ID_RUBRO
                    INTO :ID_RUBRO
                     FROM 
                    STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    
                      EXCEPTION 
                      WHEN NO_DATA_FOUND THEN
                      null; --se suprime este error, ya que provoca errores al ejecutarse cuando se añade un item. (ni se cargaron datos del art y aparece
                      --el error)
                      --RAISE_APPLICATION_ERROR(-20000,'Error al cargar el precio del articulo'||sqlerrm);
                    END;
                    WHEN OTHERS THEN
                      RAISE_APPLICATION_ERROR(-20000,'Error  al cargar los datos del articulo '||sqlerrm);
                    
                        
                    
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: [
                    ID_IVA
                    IVA
                    PORC_IVA
                    ID_UNIDAD_MEDIDA
                    COD_ORIGEN_ART
                    ID_ENVASE
                    ID_MARCA
                    ID_GRUPO_ART
                    ID_RUBRO
                    STOCK
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                    v_precio_unitario number(18,3);
                    v_porc_iva  number(10);
                    
                    
                    
                    
                    BEGIN
                    IF NVL(:P453_IND_EXENTO,'N')='S' THEN 
                    SELECT  I.PORC_IVA_VENTA 
                    INTO  v_porc_iva
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(v_porc_iva/(100+v_porc_iva)),NVL(:P453_DECIMALES,0));
                     :PRECIO_UNITARIO_C_IVA:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,NVL(:P453_DECIMALES,0));
                    END IF;
                    END;
                    EXCEPTION WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al traer el precio unitario');
                    ```
                itemsToSubmit: [
                    P453_DECIMALES
                    PRECIO_UNITARIO_C_IVA
                    ID_ARTICULO
                    P453_IND_EXENTO
                ]
                itemsToReturn: PRECIO_UNITARIO_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 50
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin 
                    SELECT COD_ARTICULO
                    into :cod_articulo
                    FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:ID_ARTICULO;
                    exception
                     when no_data_found then
                      null;
                     end;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: COD_ARTICULO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 60
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    console.log(array);
                    grid.gotoCell(array[0][1],'COD_ARTICULO');
                    
                    
                    
                    ```
            }
            execution {
                sequence: 70
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P453_BANDERA
                value: 0
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P453_BANDERA
            }
            execution {
                sequence: 80
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD
            }
            execution {
                sequence: 100
            }
            serverSideCondition {
                type: never
            }
        )

        action setea-lote-iva-y-vencimiento (
            name: Setea Lote, iva y vencimiento
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_maneja_lote varchar(1);
                    BEGIN
                    IF NVL(:P453_IND_EXENTO,'N') ='N' THEN 
                    SELECT NVL(IND_MANEJA_LOTE,'X')
                    into v_maneja_lote
                    from stw_articulos 
                    where id=:id_articulo ;
                    
                    --IF V_MANEJA_LOTE='S' THEN
                    IF CMWK_COTIZACIONES.TRAE_RESERVA_DISPONIBLE(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                                                 P_ID_ARTICULO => :ID_ARTICULO,
                                                                 P_ID_SUCURSAL => NULL) > 0 THEN -- Se agrego para traer el lote con menor vencimiento por defecto en caso de haya stock SC 27/03/2025
                        SELECT L.ID,L.ID_IVA,I.PORC_IVA_VENTA,L.NRO_LOTE, DECODE(L.FEC_VENCIMIENTO, '31/12/2099', NULL, L.FEC_VENCIMIENTO)
                          INTO :ID_LOTE,:ID_IVA,:PORC_IVA,:NRO_LOTE, :FEC_VENCIMIENTO_LOTE
                          FROM STW_LOTES L
                          JOIN STW_IVA I ON I.ID = L.ID_IVA
                          JOIN STW_EXISTENCIA_ART EA ON EA.ID_LOTE = L.ID
                         WHERE L.ID_ARTICULO = :ID_ARTICULO
                           AND L.FEC_VENCIMIENTO >= SYSDATE
                           AND NVL(EA.CANT_DISPON, 0) != 0
                        ORDER BY L.FEC_VENCIMIENTO
                        FETCH FIRST 1 ROW ONLY;
                    ELSE
                        SELECT L.ID,L.ID_IVA,I.PORC_IVA_VENTA,MAX(L.NRO_LOTE)
                        INTO :ID_LOTE,:ID_IVA,:PORC_IVA,:NRO_LOTE
                        FROM STW_LOTES L,STW_IVA I
                        WHERE L.ID_ARTICULO=:ID_ARTICULO
                        AND  L.ID_IVA=I.ID
                        AND FEC_VENCIMIENTO>=SYSDATE
                        AND ROWNUM = 1
                        GROUP BY L.ID,L.ID_IVA,I.PORC_IVA_VENTA;
                    END IF;
                    /*ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;*/
                    --END IF;
                    ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I WHERE 
                    COD_IVA=W_BUSCA_PARAMETRO('ST','COD_IVA_EXENTA')
                    and rownum = 1;
                    END IF;
                    EXCEPTION WHEN
                    NO_DATA_FOUND THEN null;
                    /*SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;*/
                    END;
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P453_IND_EXENTO
                    P453_ID_SUCURSAL
                ]
                itemsToReturn: [
                    ID_LOTE
                    ID_IVA
                    PORC_IVA
                    NRO_LOTE
                    FEC_VENCIMIENTO_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 40
            }
        )

