    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                    --   D.ID_COMPROBANTE_CABECERA,
                    D.ID_PEDIDO_CABECERA,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                    --   D.CANTIDAD_REFERENCIA,
                       D.PRECIO_UNITARIO,
                       D.PRECIO_LISTA,
                       D.DESCUENTO,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                  --     D.COSTO_PROMEDIO,
                      -- D.COSTO_PROMEDIO_REF,
                 --      D.COSTO_CON,
                      D.NUM_ORDEN,
                    --   D.ID_MECANICO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                   --    D.FEC_VENC,
                       D.PORC_DESCUENTO,
                       D.IVA,
                   --    D.ID_PEDIDO_DETALLE,
                   --    D.ID_COMPROBANTE_DETALLE_REF,
                       D.PORC_DESC_ESP,
                       D.MONTO_DESC_ESPECIAL,
                       D.ID_LOTE,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PRECIO_LISTA_C_IVA,
                       D.MONTO_TOTAL_C_IVA,
                       D.DESCUENTO_C_IVA,
                   --    D.IND_MUEVE_STOCK,
                  --     D.CANTIDAD_ENTREGADA,
                 --      D.CANTIDAD_REMISIONADA,
                --       D.ID_PROMO_CAB_GRUPO,
                       D.ID_IVA,
                       D.PORC_GRAVADA,
                       D.IND_PROMO,
                      -- D.CANTIDAD_RESGUARDADA
                       D.DESC_ARTICULO,
                       D.DESC_ARTICULO_STD,
                      -- D.ID_BARRA,
                      D.IND_ANULADO,
                      --D.STOCK,
                      D.OBSERVACION,
                      --D.NRO_ITEM,
                      D.ESTADO,
                      A.ID_MARCA,
                      A.ID_GRUPO_ART,
                      A.ID_ENVASE,
                      A.COD_ORIGEN_ART,
                      D.Diferencia,
                     /* case 
                        when sum(nvl(E.CANT_DISPON,0) - nvl(D.CANTIDAD,0)) < 0 then
                            0 -- - nvl(d.cantidad, 0)
                        else
                            d.diferencia
                        end as diferencia,*/
                
                
                      A.ID_RUBRO,
                      sum(nvl(E.CANT_DISPON,0) - nvl(D.CANTIDAD,0)) as diferencia_copia,
                      0 as bandera,
                     -- CASE 
                     --   WHEN D.DIFERENCIA < 0 THEN
                      --     0
                      --   ELSE
                      /*(sum(E.CANT_DISPON)-obtener_cantidad_bloqueo(A.id, :P0_ID_SUCURSAL, 'S')) AS STOCK,*/
                      --/*(sum(*/existencia_actual(null/*:P0_ID_SUCURSAL*/,d.id_articulo,:P0_ID_EMPRESA) -
                       ---obtener_cantidad_bloqueo(d.id_articulo,/*:P0_ID_SUCURSAL*/NULL, 'S')/*))*/ 
                       D.STOCK,
                       NVL(A.IND_CONTROLADO, 'N') IND_CONTROLADO,
                       (SELECT FEC_VENCIMIENTO FROM STW_LOTES L WHERE L.ID = D.ID_LOTE) FEC_VENCIMIENTO_LOTE,
                       NVL((SELECT ID FROM CMW_COTIZA_ARTICULOS WHERE ID_PEDIDO_DET = D.ID AND ROWNUM = 1), 0) ID_COTIZA_ART
                      --- END as STOCK 
                       /*SE COMENTA COD SUCURSAL POR QUE NO DEBE TENER CONTROL DE EXISTENCIA POR SUCRUSAL EN EL PEDIDO SOLO EN LA FACTURA,
                         A PEDIDO DE LAURA-15/03/2024*/
                  from VTW_PEDIDOS_DETALLE D
                  JOIN STW_ARTICULOS A  ON D.ID_ARTICULO=A.ID
                  LEFT JOIN STW_EXISTENCIA_ART E ON  E.ID_ARTICULO = D.ID_ARTICULO AND E.ID_EMPRESA = D.ID_EMPRESA
                 where ID_PEDIDO_CABECERA=:P453_ID
                
                group by D.ID,
                    --   D.ID_COMPROBANTE_CABECERA,
                       D.ID_PEDIDO_CABECERA,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                    --   D.CANTIDAD_REFERENCIA,
                       D.PRECIO_UNITARIO,
                       D.PRECIO_LISTA,
                       D.DESCUENTO,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                  --     D.COSTO_PROMEDIO,
                      -- D.COSTO_PROMEDIO_REF,
                 --      D.COSTO_CON,
                      D.NUM_ORDEN,
                    --   D.ID_MECANICO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                   --    D.FEC_VENC,
                       D.PORC_DESCUENTO,
                       D.IVA,
                   --    D.ID_PEDIDO_DETALLE,
                   --    D.ID_COMPROBANTE_DETALLE_REF,
                       D.PORC_DESC_ESP,
                       D.MONTO_DESC_ESPECIAL,
                       D.ID_LOTE,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PRECIO_LISTA_C_IVA,
                       D.MONTO_TOTAL_C_IVA,
                       D.DESCUENTO_C_IVA,
                   --    D.IND_MUEVE_STOCK,
                  --     D.CANTIDAD_ENTREGADA,
                 --      D.CANTIDAD_REMISIONADA,
                --       D.ID_PROMO_CAB_GRUPO,
                       D.ID_IVA,
                       D.PORC_GRAVADA,
                       D.IND_PROMO,
                      -- D.CANTIDAD_RESGUARDADA
                       D.DESC_ARTICULO,
                       D.DESC_ARTICULO_STD,
                      -- D.ID_BARRA,
                      D.IND_ANULADO,
                      D.STOCK,
                      D.OBSERVACION,
                      --D.NRO_ITEM,
                      D.ESTADO,
                      A.ID_MARCA,
                      A.ID_GRUPO_ART,
                      A.ID_ENVASE,
                      A.COD_ORIGEN_ART,
                      D.Diferencia,
                      A.ID_RUBRO,
                      A.Id,
                      NVL(A.IND_CONTROLADO, 'N')
                
                ```
