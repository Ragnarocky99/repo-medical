    dynamicAction imprimir-factura (
        name: Imprimir Factura
        execution {
            sequence: 130
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.navigation.openInNewWindow($v('P453_CHECKSUM'));
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_checksum varchar2(2000);
                    
                    BEGIN 
                     RETURN  APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':463:'||:APP_SESSION||'::NO::P453_ID,P0_ID_EMPRESA:'||:P453_ID_FACTURA||','||
                     '&P0_ID_EMPRESA.', p_checksum_type => 'SESSION');
                     exception 
                     when others then 
                     RAISE_APPLICATION_ERROR(-20000,'ERROR al realizar la impresion!');
                    END;
                    ```
                itemsToSubmit: [
                    P453_ID_FACTURA
                    P0_ID_EMPRESA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P453_CHECKSUM
            }
