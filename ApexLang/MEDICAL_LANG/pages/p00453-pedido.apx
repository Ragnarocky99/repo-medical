    computation p453-nro-comprobante (
        itemName: P453_NRO_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P453_NRO_COMPROBANTE IS  NULL THEN
                SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                INTO v_nro_comprobante
                FROM
                VTW_PEDIDOS_CABECERA 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P453_SER_COMPROBANTE=SER_COMPROBANTE
                AND :P453_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P453_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
        comments {
            comments: "Calculo para calcular el nro comprobante a guardarse si es qque no se escribio un numero de manera manual "
        }
    )

    computation p453-ser-comprobante (
        itemName: P453_SER_COMPROBANTE
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_ser varchar2(7);
                V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                select SER_COMPROBANTE
                INTO v_ser
                 from BSW_SERIES_COMPROB t 
                 WHERE
                ID_EMPRESA=:P0_COD_EMPRESA AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                --AND TERMINAL=V_IP_MAQUINA
                AND TIP_COMPROBANTE=W_BUSCA_PARAMETRO('VT','TIPO_PEDIDO')
                AND IND_ACTIVO='S';
                RETURN v_ser;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                return null;
                WHEN OTHERS THEN
                 RETURN null; 
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P453_ID
        }
    )

    computation p453-subtotal (
        itemName: P453_SUBTOTAL
        execution {
            sequence: 60
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_cabecera IS SELECT * FROM VTW_COMPROBANTES_CABECERA
                    WHERE :P453_ID=ID;
                    item_cabecera VTW_COMPROBANTES_CABECERA%rowtype;
                    v_subtotal   VTW_COMPROBANTES_CABECERA.TOT_COMPROBANTE%TYPE:=0;
                BEGIN
                  OPEN cursor_CABECERA;
                  LOOP
                    FETCH cursor_cabecera INTO item_cabecera;
                    EXIT WHEN cursor_cabecera%NOTFOUND;
                    v_subtotal:=nvl(item_cabecera.tot_comprobante,0)-nvl(item_cabecera.tot_iva,0);
                  END LOOP;
                  CLOSE cursor_cabecera;
                  RETURN v_subtotal;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P453_ID
        }
    )

