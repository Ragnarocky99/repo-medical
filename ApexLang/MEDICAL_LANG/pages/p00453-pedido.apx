        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detalles
        }
    )

    region p-comentario-ensp-p (
        name: <p>Comentario &ensp;</p>
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @pedido
            slot: subRegions
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--stretchInputs
                t-Form--labelsAbove
                margin-bottom-none
            ]
        }
    )

    region pedido (
        name: Pedido
        type: form
        source {
            location: localDatabase
            tableName: VTW_PEDIDOS_CABECERA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            htmlDomId: Contenedor
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region totales (
        name: Totales
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        serverSideCondition {
            type: never
        }
    )

