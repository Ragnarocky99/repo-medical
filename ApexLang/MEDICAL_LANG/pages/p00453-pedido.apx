    validation validaratencion (
        name: ValidarAtencion
        execution {
            sequence: 70
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    VCOD_TIP_CLIENTE_PARTICULAR CCW_TIPO_CLIENTE.COD_TIP_CLIENTE%TYPE := W_BUSCA_PARAMETRO('CC', 'COD_TIP_CLIENTE_PARTICULAR');
                    VID_TIP_CLIENTE_PARTICULAR  CCW_TIPO_CLIENTE.ID%TYPE;
                    VID_TIP_CLIENTE             CCW_TIPO_CLIENTE.ID%TYPE;
                BEGIN
                    BEGIN
                        SELECT ID
                          INTO VID_TIP_CLIENTE_PARTICULAR
                          FROM CCW_TIPO_CLIENTE
                         WHERE COD_TIP_CLIENTE = VCOD_TIP_CLIENTE_PARTICULAR;
                    EXCEPTION
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, 'No se pudo encontrar el tipo de cliente particular. Err '||SQLERRM);
                    END;
                
                    BEGIN
                        SELECT ID_TIP_CLIENTE
                          INTO VID_TIP_CLIENTE
                          FROM CCW_CLIENTES
                         WHERE ID = :P453_ID_CLIENTE;
                    EXCEPTION
                        WHEN OTHERS THEN
                            NULL;
                    END;
                
                    --RAISE_APPLICATION_ERROR(-20000, VID_TIP_CLIENTE_PARTICULAR||' '||VID_TIP_CLIENTE);
                    IF VID_TIP_CLIENTE = VID_TIP_CLIENTE_PARTICULAR OR
                       VID_TIP_CLIENTE IS NULL OR
                       :P453_ID_PERSONA_RELACION IS NOT NULL THEN
                        RETURN TRUE;
                    END IF;
                    
                    RETURN FALSE;
                END;
                ```
        }
        error {
            errorMessage: Este tipo de cliente requiere completar el campo Atencion.
            associatedItem: @P453_ID_PERSONA_RELACION
        }
    )

