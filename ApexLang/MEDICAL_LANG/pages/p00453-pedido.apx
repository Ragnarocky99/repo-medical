    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 240
        }
        when {
            selectionType: items
            items: P453_FEC_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P453_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P453_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P453_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P453_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P453_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P453_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P453_FEC_COMPROBANTE) = 22) THEN
                            NULL;
                    
                            ELSIF (length(:P453_FEC_COMPROBANTE) > 22) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P453_FEC_COMPROBANTE
                itemsToReturn: P453_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

