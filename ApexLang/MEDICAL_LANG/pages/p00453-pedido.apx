    process actualizamos-stock-y-diferencia (
        name: Actualizamos Stock y Diferencia
        type: executeCode
        editableRegion: @detalles
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'C' THEN
                    --IF :ID_ARTICULO = W_BUSCA_PARAMETRO('ST', 'ID_ART_ESTANDAR') THEN
                    --    :STOCK := 0;
                    --ELSE
                        :STOCK := nvl(existencia_actual(:P0_ID_SUCURSAL, :ID_ARTICULO, :P0_ID_EMPRESA, 'S'), 0) -
                                  nvl(obtener_cantidad_bloqueo(:ID_ARTICULO, :P0_ID_SUCURSAL, 'S', 'S'), 0);
                    --END IF;
                END IF;
                
                IF REPLACE(:STOCK, '.', '') <= 0 THEN
                    :DIFERENCIA := REPLACE(:CANTIDAD, '.', '') * -1;
                ELSE
                    :DIFERENCIA := REPLACE(:STOCK, '.', '') - REPLACE(:CANTIDAD, '.', '');
                END IF;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 23119791278117528
        }
        serverSideCondition {
            type: never
        }
    )

