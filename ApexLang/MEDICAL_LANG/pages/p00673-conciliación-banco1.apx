    dynamicAction convert-fecha-fin (
        name: CONVERT_FECHA_FIN
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P673_FECHA_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P673_FECHA_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P673_FECHA_FIN,'/','');
                            conv_fecha := substr(:P673_FECHA_FIN,1,2)||'/'||
                                                      substr(:P673_FECHA_FIN,3,2)||'/'||
                                                      lpad(substr(:P673_FECHA_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P673_FECHA_FIN := conv_fecha;
                            ELSIF (length(:P673_FECHA_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P673_FECHA_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P673_FECHA_FIN
                itemsToReturn: P673_FECHA_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha-ini (
        name: CONVERT_FECHA_INI
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P673_FECHA_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P673_FECHA_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P673_FECHA_INI,'/','');
                            conv_fecha := substr(:P673_FECHA_INI,1,2)||'/'||
                                                      substr(:P673_FECHA_INI,3,2)||'/'||
                                                      lpad(substr(:P673_FECHA_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P673_FECHA_INI := conv_fecha;
                            ELSIF (length(:P673_FECHA_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P673_FECHA_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P673_FECHA_INI
                itemsToReturn: P673_FECHA_INI
