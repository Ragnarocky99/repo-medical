                fireOnInit: false
            }
        )

        action p673-saldo-inicial (
            name: P673_SALDO_INICIAL
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        	NVL(SUM(NVL(TOT_CREDITO, 0)) - SUM(NVL(TOT_DEBITO, 0)) ,0)
                        FROM "CHVW_EXTRACTO_BANCARIO" E
                        WHERE 
                        	 E.ID_EMPRESA = :P0_ID_EMPRESA
                        AND E.NRO_CUENTA = :P673_CUENTA
                        AND E.ID_PER_JURIDICA = :P673_BANCO_ID
                        AND NVL(E.ANULADO, 'N') != 'S'
                        AND NVL(E.IND_CONCILIADO, 'N') = 'S'
                        --AND E.FEC_VENCIMIENTO < :P673_FECHA_INI
                        AND NVL(E.FEC_BANCO, LAST_DAY(E.FEC_VENCIMIENTO)) < :P673_FECHA_INI
                    ```
                itemsToSubmit: [
                    P673_FECHA_INI
                    P673_FECHA_FIN
                    P673_CUENTA
                    P673_BANCO_ID
                ]
            }
            affectedElements {
                selectionType: items
                items: P673_SALDO_INICIAL
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action p673-total (
            name: P673_TOTAL
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: "REPLACE(:P673_TOTAL_CONCILIADO_BANCO, '.', '') + REPLACE(:P673_SALDO_INICIAL, '.', '') "
                itemsToSubmit: [
                    P673_SALDO_INICIAL
                    P673_TOTAL_CONCILIADO_BANCO
                    P673_TOTAL_BANCO
                ]
            }
            affectedElements {
                selectionType: items
                items: P673_TOTAL
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action p673-total-banco (
            name: P673_TOTAL_BANCO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select NVL((SUM(NVL(TOT_CREDITO, 0)) - SUM(NVL(TOT_DEBITO, 0))), 0)
                     from CHVW_EXTRACTO_BANCARIO
                     where NRO_CUENTA = :P673_CUENTA
                       and FEC_BANCO BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                       and (ANULADO != 'S' or ANULADO is null)
                       and (IND_CONCILIADO = :P673_ESTADO OR :P673_ESTADO IS NULL)
                       and FEC_VENCIMIENTO > :P673_FECHA_FIN
                    --    and t_id not in (
                    --        select t_id
                    --         from CHVW_EXTRACTO_BANCARIO
                    --         where NRO_CUENTA = :P673_CUENTA
                    --           and FEC_VENCIMIENTO BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                    --           and (ANULADO != 'S' or ANULADO is null)
                    --           and (IND_CONCILIADO = :P673_ESTADO OR :P673_ESTADO IS NULL)
                    --    )
                    
                    ```
                itemsToSubmit: [
                    P673_FECHA_INI
                    P673_FECHA_FIN
                    P673_CUENTA
                    P673_BANCO_ID
                ]
            }
            affectedElements {
                selectionType: items
                items: P673_TOTAL_BANCO
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action p673-total-conciliado-banco (
            name: P673_TOTAL_CONCILIADO_BANCO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select NVL((SUM(NVL(TOT_CREDITO, 0)) - SUM(NVL(TOT_DEBITO, 0))), 0)
                     from CHVW_EXTRACTO_BANCARIO
                     where NRO_CUENTA = :P673_CUENTA
                       --and FEC_VENCIMIENTO BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                       and (ANULADO != 'S' or ANULADO is null)
                       and NVL(IND_CONCILIADO, 'N') = 'S'
                       and NVL(FEC_BANCO, LAST_DAY(FEC_VENCIMIENTO)) BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                    ```
                itemsToSubmit: [
                    P673_FECHA_INI
                    P673_FECHA_FIN
                    P673_CUENTA
                    P673_BANCO_ID
                ]
            }
            affectedElements {
                selectionType: items
                items: P673_TOTAL_CONCILIADO_BANCO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

