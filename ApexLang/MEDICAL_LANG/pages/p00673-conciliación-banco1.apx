    process crear-coleccion (
        name: Crear Coleccion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                --Creamos la colección
                
                if :P673_EXT_BANCO is null then
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION (
                        p_collection_name => 'EXTRACTO_BANCARIO_COL'
                    );
                
                    -- Iteramos sobre el archivo cargado desde el File Broswer y lo guardamos en la coleccion.      
                    for i in (
                        select  *
                        from    apex_application_temp_files f,
                                table(
                                        apex_data_parser.parse(
                                        p_content           => f.blob_content,
                                        p_file_name         => f.filename,
                                        --p_skip_rows         => 1,
                                        --p_xlsx_sheet_name   => case when :P655_XLSX_WORKSHEET is not null then :P655_XLSX_WORKSHEET end,
                                        --p_file_profile      => apex_data_loading.get_file_profile( p_static_id => 'ventas_excel' ),
                                        p_max_rows          => 500 
                                    )
                                ) p
                
                        where f.name = :P673_ARCHIVO
                    )
                    loop
                        APEX_COLLECTION.ADD_MEMBER(
                            p_collection_name   => 'EXTRACTO_BANCARIO_COL',
                            p_c001              => i.col001,
                            p_c002              => i.col002,
                            p_c003              => i.col003,
                            p_c004              => i.col004,
                            p_c005              => i.col005,
                            p_c006              => i.col006,
                            p_c007              => i.col007,
                            p_c008              => i.col008,
                            p_c009              => i.col009,
                            p_c010              => i.col010,
                            p_c011              => i.col011,
                            p_c012              => i.col012,
                            p_c013              => i.col013,
                            p_c014              => i.col014,
                            p_c015              => i.col015
                        );       
                    end loop;
                    :P673_EXT_BANCO := 'S';
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 95349060412966679
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P673_ARCHIVO
        }
    )

    process subir-excel (
        name: Subir Excel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    apex_collection.create_or_truncate_collection('EXTRACTO');
                    for r1 in (select *
                                 from apex_application_temp_files f, 
                                      table( apex_data_parser.parse(
                                                p_content                     => f.blob_content,
                                                p_add_headers_row             => 'n',
                                                p_file_name                   => f.filename) 
                                            ) p
                                 where f.name = :P673_ARCHIVO 
                                   and p.line_number > 1
                              )
                    loop
                        -- Solo ejecutar si no esta vacio los campos
                        if r1.col001 is null then
                            raise_application_error(-20000, 'No puede dejar el campo de la fecha. Linea '||r1.col001);
                        end if;
                
                        apex_collection.add_member(p_collection_name => 'EXTRACTO',
                                                   p_d001            => to_date(r1.col001, 'yyyy-MM-dd'),
                                                   p_c001            => r1.col002,
                                                   p_n001            => nvl(replace(r1.col003, '.', ','), 0),
                                                   p_n002            => nvl(replace(r1.col004, '.', ','), 0));
                
                    end loop;
                
                exception
                    when others then
                        raise_application_error(-20000, sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 29465980077695240
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P673_ARCHIVO
        }
    )

)

