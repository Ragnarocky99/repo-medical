    dynamicAction accionar-al-cargar-pagina (
        name: Accionar al cargar pagina
        execution {
            sequence: 130
        }
        when {
            event: ready
        }

        action habilitar-copiar-grilla-ig (
            name: Habilitar copiar grilla ig
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.addEventListener('copy', (event) => {
                        const activeElement = $(document.activeElement)[0];
                        const textToCopy = activeElement?.innerText || window.getSelection();
                        event.clipboardData.setData('text/plain', textToCopy);
                        event.preventDefault();
                    });
                    ```
            }
            execution {
                sequence: 40
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @extracto-sistema
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    to_number(replace(:P673_TOTAL_CONCILIADO_BANCO,'.',''))
                    - to_number(replace(:P673_SALDO_INICIAL,'.',''))
                    - to_number(replace(:P673_TOTAL_PENDIENTE_BANCO,'.',''))
                    ```
                itemsToSubmit: [
                    P673_TOTAL_CONCILIADO_BANCO
                    P673_SALDO_INICIAL
                    P673_TOTAL_PENDIENTE_BANCO
                ]
            }
            affectedElements {
                selectionType: items
                items: P673_TOTAL
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        action p673-cuenta (
            name: P673_CUENTA
            action: setValue
            affectedElements {
                selectionType: items
                items: P673_CUENTA
            }
            execution {
                sequence: 20
            }
        )

    )

