    validation is-valid-file-type (
        name: Is valid file type
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_file_name varchar2(100);
                begin
                    select filename into l_file_name from apex_application_temp_files where name = :P673_ARCHIVO;
                    
                    if apex_data_parser.assert_file_type(
                           p_file_name => l_file_name,
                           p_file_type => apex_data_parser.c_file_type_xlsx )
                    then
                        return true;
                    else
                        --:P673_ARCHIVO := null;
                        return false;
                    end if;
                end;
                ```
        }
        error {
            errorMessage: Tipo de archivo inválido. Solo soportado archivos XLSX (Excel)
            associatedItem: @P673_ARCHIVO
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P673_ARCHIVO
        }
    )

    computation p673-cod-banco (
        itemName: P673_COD_BANCO
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                select cod_persona
                from bsw_personas
                where id = :P673_BANCO_ID
                ```
