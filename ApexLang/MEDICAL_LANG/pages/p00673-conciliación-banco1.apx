    process conciliar (
        name: Conciliar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_seq number;
                    l_estado varchar2(100);
                    l_cantidad number;
                    l_nro_comp  varchar2(100);
                    l_debito varchar2(100) ;
                    l_credito varchar2(100) ;
                begin
                    if not APEX_COLLECTION.COLLECTION_EXISTS('EXTRACTO_BANCARIO_COL') then
                        raise_application_error(-20000, 'No se ha subido ningún extracto bancario');
                    end if;
                    if :P673_CUENTA is null then
                        raise_application_error(-20000, 'No se ha seleccionado ninguna cuenta');
                    end if;
                        
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION (
                        p_collection_name => 'CONCILIACION_COLL'
                    );
                    -- Recorremos los datos del movimiento bancario
                    for i in (
                        select  *
                        from    CHVW_EXTRACTO_BANCARIO
                        where   NRO_CUENTA = :P673_CUENTA
                        and     /*FEC_COMPROBANTE*/FEC_VENCIMIENTO between :P673_FECHA_INI and :P673_FECHA_FIN
                        ---and     NRO_COMPROBANTE = 23
                        and     (ANULADO <> 'S' or ANULADO is null)
                    )
                    loop
                    
                        -- Verificar si el comprobante existe en el extracto bancario
                        begin
                            select  count(1),
                                    c001,
                                    nvl(c002,0) c002,
                                    nvl(c003,0) c003
                            into    l_cantidad,
                                    l_nro_comp,
                                    l_debito,
                                    l_credito
                            from    apex_collections
                            where   collection_name = 'EXTRACTO_BANCARIO_COL'
                            and     c001 = i.NRO_COMPROBANTE
                            and     replace(c002,'.','') = replace(i.TOT_DEBITO,'.','')
                            and     replace(c003,'.','') = replace(i.TOT_CREDITO,'.','') 
                            group by c001,c002, c003;      
                        exception
                            when    NO_DATA_FOUND then
                                l_cantidad := 0;
                                l_nro_comp := 0;
                                l_credito := 0;
                                l_debito := 0;
                        end;
                        
                        if l_debito is null then
                         l_debito := 0;
                        end if;
                        if l_credito is null then
                         l_credito := 0;
                        end if;
                       
                        if  l_cantidad > 0 and (
                            replace(l_debito,'.','') = replace(i.TOT_DEBITO,'.','')  and -- or
                            replace(l_credito,'.','') = replace(i.TOT_CREDITO,'.','') 
                        ) /*AND l_nro_comp = i.NRO_COMPROBANTE*/ then
                            l_estado := 'CONCILIADO';
                        ---elsif l_cantidad > 0 and (l_debito <> i.TOT_CREDITO or l_credito <> i.TOT_DEBITO) then
                        elsif l_cantidad > 0 and (l_debito <> i.TOT_DEBITO or /*and*/ l_credito <> i.TOT_CREDITO) then
                            l_estado := 'NO COINCIDE';
                        else
                            l_estado := 'PENDIENTE';
                        end if;
                
                
                        APEX_COLLECTION.ADD_MEMBER(
                            p_collection_name   => 'CONCILIACION_COLL',
                            p_c001              => to_char(sysdate),
                            p_c002              => i.TIP_COMPROBANTE,
                            p_c003              => i.NRO_COMPROBANTE,
                            p_c004              => i.SER_COMPROBANTE,
                            p_c005              => i.DETALLE,
                            p_c006              => i.DESCRIPCION,
                            p_c007              => replace(i.TOT_DEBITO ,'.', ''),
                            p_c008              => replace(i.TOT_CREDITO ,'.', ''),
                            p_c009              => nvl(replace(l_debito,'.',''),0),
                            p_c010              => nvl(replace(l_credito,'.',''),0),
                            p_c011              => abs(to_number(nvl(replace(i.TOT_DEBITO, '.', ''), 0))  - to_number(nvl(replace(l_debito,'.',''), 0))),
                            p_c012              => abs(to_number(nvl(replace(i.TOT_CREDITO, '.', ''), 0)) - to_number(nvl(replace(l_credito,'.',''), 0))),
                            p_c013              => l_estado
                        );
                          
                    end loop;
                    :P673_MOSTRAR_CONCILIACION := 'S';
                    :P673_FILENAME := null;
                    :P673_MOSTRAR_EXT_SISTEMA := null;
                      
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 95350224739966681
        }
        serverSideCondition {
            whenButtonPressed: @conciliar
            type: never
        }
    )

