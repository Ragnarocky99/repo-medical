    region extracto-sistema (
        name: Extracto Sistema
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  t_id as id,
                        FEC_COMPROBANTE,
                        TIP_COMPROBANTE,
                        NRO_COMPROBANTE,
                        DETALLE,
                        SER_COMPROBANTE,
                        DESCRIPCION,
                        TOT_DEBITO,
                        TOT_CREDITO,
                        case nvl(ind_conciliado,'N')
                          when 'N' then ''
                          when 'S' then 'Desconciliar'
                        end as desconciliar,
                        FEC_CONCILIACION,
                        case
                            when (IND_CONCILIADO is null or IND_CONCILIADO = 'N') then 'PENDIENTE'
                            when IND_CONCILIADO = 'S' then 'CONCILIADO'
                        end ESTADO_CONCILIACION,
                        FEC_BANCO,
                        FEC_BANCO FEC_BANCO_ORI,
                        IND_CONCILIADO,
                        IND_CONCILIADO IND_CONCILIADO_ORI,
                        PREPARA_URL_CARGA(:P0_ID_EMPRESA, TIP_COMPROBANTE, ID) URL,
                        FEC_VENCIMIENTO
                from CHVW_EXTRACTO_BANCARIO
                where   NRO_CUENTA = :P673_CUENTA
                  --and   FEC_COMPROBANTE BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                and     NVL(FEC_BANCO, LAST_DAY(FEC_VENCIMIENTO)) BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                --and     FEC_VENCIMIENTO BETWEEN :P673_FECHA_INI AND :P673_FECHA_FIN
                --and     /*FEC_COMPROBANTE*/ ((FEC_COMPROBANTE between :P673_FECHA_INI and :P673_FECHA_FIN) or (nvl(ind_conciliado,'N') = 'N' and fec_vencimiento <= :P673_FECHA_INI)) 
                and     (ANULADO <> 'S' or ANULADO is null)
                and     (IND_CONCILIADO = :P673_ESTADO OR :P673_ESTADO IS NULL)
                and   FEC_COMPROBANTE != '01/01/1000'
                ```
            pageItemsToSubmit: [
                P673_CUENTA
                P673_ESTADO
                P673_FECHA_INI
                P673_FECHA_FIN
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: EXTRACTO
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            type: page
        }
        toolbar {
