page 251 (
    name: Cheque
    alias: CHEQUE
    title: Cheque
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        height: 350
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P251_ID_BANCO").readOnly = true;
            document.getElementById("P251_COD_MONEDA").readOnly = true;
            document.getElementById("P251_DESC_BANCO").readOnly = true;
            document.getElementById("P251_DESC_MONEDA").readOnly = true;
            document.getElementById("P251_DESC_TIPO").readOnly = true;
            document.getElementById("P251_TOT_VALOR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cheque (
        name: Cheque
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.TIP_MOV_CAJ,
                       C.SER_MOV_CAJ,
                       C.NRO_MOV_CAJ,
                       C.TIP_VALOR,
                       C.SER_VALOR,
                       C.NUM_VALOR,
                       C.ID_BANCO,
                       C.ID_CUENTA,
                       C.ID_MONEDA_PAGO,
                       C.TIP_CAMBIO,
                       C.BENEFICIARIO,
                       C.FEC_EMISION,
                       C.FEC_VENCIMIENTO,
                       C.TOT_VALOR,
                       C.ID_USUARIO,
                       C.ANULADO,
                       C.BENEFICIARIO_TALON,
                       C.NRO_LINEA,
                       C.COD_USUARIO_AUD,
                       C.ID_CAB_CAJAS,
                       C.IMPRESO,
                       C.ID_SUB_TIPO_TRANS,
                       C.IMPORTE_CAMBIO,
                       C.REFER,
                       C.ASIENTOS,
                       C.GENERADO,
                       C.NRO_CTA_PROV,
                       C.ID_ENTIDAD_DESTINO,
                       C.ID_TALON_CHE,
                       C.NRO_OPERACION,
                       C.FEC_ANULACION,
                       C.FEC_COBRO,
                       C.FEC_BANCO,
                       C.IMPRESION_AUTORIZADA,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.MOT_ANULACION,
                       M.COD_MONEDA,
                       C.ID_DEBCRED,
                       M.DESCRIPCION AS DESC_MONEDA,
                       P.NOMB_FANTASIA AS DESC_BANCO,
                       ST.DESCRIPCION AS DESC_TIPO
                  from CPW_VALORES_CAJAS C,BSW_MONEDAS M, BSW_PERSONAS P, BSW_SUBTIPOS_TRANS ST, CCW_DEBCRED_BANCARIOS D
                  WHERE C.ID_MONEDA_PAGO=M.ID
                  AND C.ID_DEBCRED = d.id
                  AND c.ID_BANCO = P.ID
                  and st.id = c.tip_valor
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P251_ANULADO (
        type: hidden
        layout {
            sequence: 240
            region: @cheque
            slot: regionBody
        }
        source {
            formRegion: @cheque
            column: ANULADO
            dataType: varchar2
        }
    )

