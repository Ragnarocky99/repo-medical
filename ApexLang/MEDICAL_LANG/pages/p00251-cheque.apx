    dynamicAction setear-valores-del-talonario (
        name: Setear Valores del talonario
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P251_ID_TALON_CHE
        }

        action p251-id-cuenta-p251-ser-valor (
            name: P251_ID_CUENTA,P251_SER_VALOR
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT ID_CUENTA_BANCARIA, SERIE
                      INTO :P251_ID_CUENTA, :P251_SER_VALOR
                      FROM CCW_TALONARIOS_CHEQUES
                     WHERE ID = :P251_ID_TALON_CHE;
                    ```
                itemsToSubmit: P251_ID_TALON_CHE
                itemsToReturn: [
                    P251_ID_CUENTA
                    P251_SER_VALOR
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action p251-num-valor (
            name: P251_NUM_VALOR
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(MAX(TO_NUMBER(NUM_VALOR)), 0) + 1
                      FROM CPW_VALORES_CAJAS
                     WHERE ID_TALON_CHE =:P251_ID_TALON_CHE
                    ```
                itemsToSubmit: P251_ID_TALON_CHE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P251_NUM_VALOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation validar-cheque (
        name: Validar Cheque
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P251_ID_CUENTA IS NOT NULL THEN
                    IF :P251_TIP_VALOR IS NULL OR :P251_ID_BANCO IS NULL OR :P251_FEC_EMISION IS NULL 
                        OR :P251_FEC_VENCIMIENTO IS NULL OR :P251_SER_VALOR IS NULL THEN
                            RETURN FALSE;
                    END IF;
                END IF;
                ```
        }
        error {
            errorMessage: Debe cargar el resto de los campos del cheque
        }
    )

    validation validar-cheque-2 (
        name: Validar Cheque 2
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P251_TIP_VALOR IS NOT NULL THEN    
                    IF :P251_ID_CUENTA IS NULL OR :P251_ID_BANCO IS NULL THEN
                        RETURN FALSE;
                    END IF;
                END IF;
                ```
        }
        error {
            errorMessage: Debe cargar el resto de los campos del cheque
        }
    )

    validation validar-num-valor (
        name: Validar Num Valor
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P251_num_valor IS NULL   THEN
                	    RAISE_APPLICATION_ERROR (-20000, 'Ingrese Nro. de cheque');
                	elsif :P251_num_valor IS not NULL and :P251_ID is null then
                    declare
                	  	 v_existe varchar2(1):='N' ;
                	  begin
                		        select 'S'
                		        into v_existe
                		        from cpw_valores_cajas
                		        where ID_empresa  = :P0_COD_EMPRESA
                		        and ID_sucursal = :P251_id_SUCURSAL
                		        and ID_banco    = :P251_ID_banco
                		        and tip_valor    = :P251_tip_valor
                		        and nvl(anulado,'N') <> 'S'
                		        and nvl(ser_valor, 'A')    = nvl(:P251_ser_valor,'A')
                		        and num_valor    = :P251_num_valor
                		        AND ROWNUM=1;
                                     if nvl(v_existe, 'N') = 'S' then
                		        RETURN  FALSE;
                                ELSE 
                                    RETURN TRUE;
                		    end if ;
                		        exception
                		        when no_data_found then 
                		        v_existe := 'N' ;
                                RETURN TRUE;
                		        when others then
                		        v_existe := 'N' ;
                	    end;
                    end if;
                ```
        }
        error {
            errorMessage: El Nro. de Cheque ya existe
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation validar-num-valor-2 (
        name: Validar Num Valor_1
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                v_valor varchar2(100);
                 v_existe varchar2(1):='N' ;
                 begin
                SELECT NUM_VALOr
                into v_valor
                 FROM CPW_VALORES_CAJAS
                WHERE ID=:P251_ID;
                
                IF :P251_num_valor IS NULL   THEN
                	    RAISE_APPLICATION_ERROR (-20000, 'Ingrese Nro. de cheque');
                	elsif :P251_num_valor IS not NULL AND V_VALOR<>:P251_NUM_VALOR  then
                		        select 'S'
                		        into v_existe
                		        from cpw_valores_cajas
                		        where ID_empresa  = :P0_COD_EMPRESA
                		        and ID_sucursal = :P251_id_SUCURSAL
                		        and ID_banco    = :P251_ID_banco
                		        and tip_valor    = :P251_tip_valor
                		        and nvl(anulado,'N') <> 'S'
                		        and nvl(ser_valor, 'A')    = nvl(:P251_ser_valor,'A')
                		        and num_valor    = :P251_num_valor
                		        AND ROWNUM=1;
                                     if nvl(v_existe, 'N') = 'S' then
                		            RETURN  FALSE;
                                ELSE 
                                    RETURN TRUE;
                		            end if ;
                                    ELSE 
                                    RETURN TRUE;
                 end if;
                	    end;
                        exception
                		        when no_data_found then 
                		        RETURN TRUE ;
                		        when others then
                		        RAISE_APPLICATION_ERROR(-20000,'Error al validar el numero del cheque');
                ```
        }
        error {
            errorMessage: El Nro. de Cheque ya existe
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation validar-tipo-cambio (
        name: Validar Tipo Cambio
        execution {
            sequence: 50
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P251_TIP_CAMBIO <= 0 OR :P251_TIP_CAMBIO IS NULL THEN
                    RETURN FALSE;
                ELSE
                    RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: El tipo de cambio debe ser mayor a 0
        }
    )

