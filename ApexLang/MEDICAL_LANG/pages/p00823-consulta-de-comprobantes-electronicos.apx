    pageItem P823_SERIE_COMPROBANTE (
        type: popupLov
        label {
            label: Serie Comprobante:
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SER_TIMBRADO,ID FROM BSW_SERIES_COMPROB
                WHERE ID_TIP_COMP=:P823_TIPO_COMPROBANTE
                AND NVL(IND_FACT_ELECTRONICA,'X')='S'
                ORDER BY SER_TIMBRADO ASC
                ```
        }
        cascadingLov {
            parentItems: P823_TIPO_COMPROBANTE
            itemsToSubmit: P823_TIPO_COMPROBANTE
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: tabindex="2"
        }
    )

    pageItem P823_TIPO_COMPROBANTE (
        type: popupLov
        label {
            label: Tipo Comprobante:
            alignment: left
        }
        settings {
            displayAs: modalDialog
            popupWidth: 750
            popupHeight: 750
        }
        lov {
            type: sharedComponent
            lov: @lv-tip-comprobantes-ind-fe
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: tabindex="1"
        }
    )

    dynamicAction cambiar-detalle (
        name: Cambiar Detalle
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @comprobantes-electrónicos
        }

        action id-consulta-fe (
            name: ID_CONSULTA_FE
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :ID_PETICION_CONSULTA_FE
                itemsToSubmit: ID_PETICION_CONSULTA_FE
            }
            affectedElements {
                selectionType: items
                items: P823_ID_CONSULTA_FE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action id-envio-fe (
            name: ID_ENVIO_FE
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :ID_PETICION_ENVIO_FE
                itemsToSubmit: ID_PETICION_ENVIO_FE
            }
            affectedElements {
                selectionType: items
                items: P823_ID_ENVIO_FE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sifen-audit
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction reaccion-grilla (
        name: Reaccion Grilla
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("COMPROB").call("getViews").grid;
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar-al-consultar (
        name: Refrescar al Consultar
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @comprobantes-electrónicos
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P823_TIPO_COMPROBANTE
                P823_SERIE_COMPROBANTE
                P823_FEC_DESDE
                P823_FEC_HASTA
                P823_NRO_DESDE
                P823_NRO_HASTA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comprobantes-electrónicos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

