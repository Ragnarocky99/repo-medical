page 823 (
    name: Consulta de Comprobantes Electronicos
    alias: CONSULTA-DE-COMPROBANTES-ELECTRONICOS
    title: Consulta de Comprobantes Electronicos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            p{
                font-family: "Roboto","Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            .a-GV-header{
             font-family: "Roboto","Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            .t-Form-label{
            font-family: "Roboto","Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            
            .a-IRR-headerLink{
                font-size: 11px;
            }
            .t-Breadcrumb-label {
                font-size: 20px;
                font-family: "Roboto","Arial", serif;
            }
            .t-Region-title{
                    font-size: 15px;
                font-family: "Roboto","Arial", serif;
                    color:#000000;
            }
            .a-GV-cell{
                font-family: "Roboto","Arial", serif;
                font-weight:normal;
                font-size: 11.5px;
            }
            #SIFEN .a-GV-cell {
              height: 50px;
            }
            .wrap-cell {
              max-height: 64px;
              white-space: normal;
              overflow: hidden;
            
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region comprobantes-electrónicos (
        name: Comprobantes Electrónicos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_COMPROBANTE,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.FEC_COMPROBANTE,
                       C.NOMBRE_CLIENTE,
                       C.TOT_BRUTO,
                       C.IND_ENVIADO_FE,
                       C.IND_APROBADO_FE,
                       C.IND_RECHAZADO_FE,
                       C.ENLACE_QR_FE,
                       C.ID_PETICION_ENVIO_FE,
                       C.ID_PETICION_CONSULTA_FE,
                       C.ID_MONEDA,
                       'Consultar',
                       '' AS VER_SIFEN
                  from FEWV_COMPROBANTES_ELECTRONICOS C
                  where C.ID_EMPRESA=:P0_ID_EMPRESA
                    AND (C.ID_TIPO_COMP=:P823_TIPO_COMPROBANTE)
                    AND (C.ID_SERIE_COMP=:P823_SERIE_COMPROBANTE)
                    AND (C.FEC_COMPROBANTE BETWEEN :P823_FEC_DESDE AND :P823_FEC_HASTA)
                    AND (C.NRO_COMPROBANTE BETWEEN NVL(:P823_NRO_DESDE,C.NRO_COMPROBANTE) AND NVL(:P823_NRO_HASTA,C.NRO_COMPROBANTE))
                
                ```
            pageItemsToSubmit: [
                P823_TIPO_COMPROBANTE
                P823_SERIE_COMPROBANTE
                P823_FEC_DESDE
                P823_FEC_HASTA
                P823_NRO_DESDE
                P823_NRO_HASTA
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--showIcon
                t-Region--scrollBody
            ]
            icon: fa-search
        }
        advanced {
            htmlDomId: COMPROB
            customAttributes: tabindex="7"
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 250
        }
        advanced {
            savedReportMappingIdentifier: 184300170348460607
        }
        help {
            helpText:
                ```html
                
                
                ```
        }

