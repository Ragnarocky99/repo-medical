    region sifen-audit (
        name: Sifen Audit
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       CDC,
                       FECHA_PROCESO,
                       DIG_VAL,
                       ESTADO,
                       NRO_TRANSACCION,
                       URL_QR,
                       TIPO_EVENTO,
                       ID_PETICION,
                       DPROTAUT,
                       DFECPROC,
                       DCODRESLOT,
                       DMSGRESLOT,
                       DPROTCONSLOTE,
                       DESTRES,
                       DCODRES,
                       DMSGRES
                  from WSINV.SIFEN_AUDIT_DE
                  WHERE (ID_PETICION=:P823_ID_CONSULTA_FE OR ID_PETICION=:P823_ID_ENVIO_FE)
                ```
            pageItemsToSubmit: [
                P823_ID_CONSULTA_FE
                P823_ID_ENVIO_FE
            ]
        }
        layout {
            sequence: 10
            parentRegion: @comprobantes-electrónicos
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
