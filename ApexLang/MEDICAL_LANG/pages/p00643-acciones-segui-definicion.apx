page 643 (
    name: ACCIONES SEGUI DEFINICION
    alias: ACCIONES-SEGUI-DEFINICION
    title: Acciones Segui Definicion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region acciones-segui-definicion (
        name: ACCIONES_SEGUI_DEFINICION
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_DEFINICION,
                       DESCRIPCION,
                       CASE ESTADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS ICONO_CERRADO,
                       ESTADO,
                       DECODE(IND_MOSTRAR, 'S', 'Si', 'N', 'No') MOSTRAR
                  from CLW_ACCIONES_SEGUI_DEFINICION
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 644
                items: {
                    P644_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            filename: &P643_NOMBRE
            supplementalText: hola
        }
        advanced {
            savedReportMappingIdentifier: 45814016125463123
        }

        column COD_DEFINICION (
            type: plainText
            heading {
                heading: Codigo
                alignment: center
            }
            layout {
                sequence: 34
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ICONO_CERRADO#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ICONO_CERRADO (
            type: hidden
            heading {
                heading: Icono Cerrado
            }
            layout {
                sequence: 24
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column MOSTRAR (
            type: plainText
            heading {
                heading: Mostrar
                alignment: center
            }
            layout {
                sequence: 44
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: ACC
        }

        savedReport 458188 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_DEFINICION (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ESTADO (
                sequence: 4
            )

            displayColumn MOSTRAR (
                sequence: 3
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P643_NOMBRE (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
        default {
            type: static
            staticValue: MEdical Quimica
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @acciones-segui-definicion
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 644
                clearCache: 644
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @acciones-segui-definicion
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acciones-segui-definicion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

