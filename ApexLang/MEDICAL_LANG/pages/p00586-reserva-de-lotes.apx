page 586 (
    name: Reserva de Lotes
    alias: RESERVA-DE-LOTES
    title: Reserva de Lotes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reserva-de-lotes (
        name: Reserva_de_Lotes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  R.ID,
                        R.NRO_COMPROBANTE,
                        R.ID_FRACCION,
                        R.ID_MANZANA,
                        R.ID_LOTE,
                        R.ID_VENDEDOR,
                        R.FEC_RESERVA,
                        R.FEC_VENCIMIENTO,
                        R.CANT_DIAS,
                        R.ESTADO,
                        R.TIP_RESERVA
                FROM    LTW_RESERVAS R
                WHERE   R.ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 572
                items: {
                    P572_ID: \#ID#\
                    P572_TIP_COMPROBANTE: \#TIP_COMPROBANTE#\
                    P572_SER_COMPROBANTE: \#SER_COMPROBANTE#\
                    P572_NRO_COMPROBANTE: \#NRO_COMPROBANTE#\
                    P572_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 110321886398824696
        }

        column CANT_DIAS (
            type: plainText
            heading {
                heading: Cant Dias
                alignment: end
            }
            layout {
                sequence: 126
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AL
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 136
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AM
            }
        )

        column FEC_RESERVA (
            type: plainText
            heading {
                heading: Fec Reserva
            }
            layout {
                sequence: 106
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AJ
            }
        )

        column FEC_VENCIMIENTO (
            type: plainText
            heading {
                heading: Fec Vencimiento
            }
            layout {
                sequence: 116
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AK
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 66
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AD
            }
        )

        column ID_FRACCION (
            type: plainText
            heading {
                heading: Fraccion
                alignment: center
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID_LOTE (
            type: plainText
            heading {
                heading: Lote
                alignment: center
            }
            layout {
                sequence: 16
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column ID_MANZANA (
            type: plainText
            heading {
                heading: Id Manzana
                alignment: end
            }
            layout {
                sequence: 86
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AH
            }
        )

        column ID_VENDEDOR (
            type: plainText
            heading {
                heading: Id Vendedor
                alignment: end
            }
            layout {
                sequence: 96
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AI
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro Comprobante
                alignment: end
            }
            layout {
                sequence: 76
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AG
            }
        )

        column TIP_RESERVA (
            type: plainText
            heading {
                heading: Tip Reserva
            }
            layout {
                sequence: 146
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AN
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reserva_de_Lotes
        }

        savedReport 934947 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ID_FRACCION (
                sequence: 1
            )

            displayColumn ID_LOTE (
                sequence: 2
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @reserva-de-lotes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 572
                clearCache: 572
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @reserva-de-lotes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reserva-de-lotes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

