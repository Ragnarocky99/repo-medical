    region reporte-de-ficha-tecnica-del-cliente (
        name: Reporte de Ficha Tecnica del Cliente
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLWV_FICHA_TECNICA_CLIENTE
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P746_ID_CLIENTE OR :P746_ID_CLIENTE IS NULL) AND
                (ID_INFO_TECNICA_CAB = :P746_ID_INFO_TECNICA_CAB OR :P746_ID_INFO_TECNICA_CAB IS NULL)
                ```
            orderByClause: CLIENTE
            pageItemsToSubmit: [
                P746_ID_CLIENTE
                P746_ID_INFO_TECNICA_CAB
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 26011854329958745
        }

