page 558 (
    name: Inmuebles
    alias: INMUEBLES
    title: Inmuebles
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region inmuebles (
        name: Inmuebles
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_INMUEBLE,
                       DESCRIPCION,
                       ID_DEPARTAMENTO,
                       ID_CIUDAD,
                       ID_BARRIO,
                       ID_TIP_INMUEBLE,
                       ID_EMPRESA,
                       CTA_CTE_CTRAL,
                       COD_USUARIO_AUD,
                       DIRECCION,
                       'LINK_PORCENTAJE'
                  from ACW_INMUEBLES
                 where ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 559
                items: {
                    P559_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 88797318728164892
        }

        column 'LINK_PORCENTAJE' (
            type: link
            heading {
                heading: Porc.Unidades
                alignment: center
            }
            layout {
                sequence: 39
                columnAlignment: center
            }
            link {
                target: {
                    page: 564
                    items: {
                        P564_INMUEBLE: #ID#
                    }
                }
                linkText: <img src="#APP_FILES#155541.png" class="apex-edit-page" alt="">
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column COD_INMUEBLE (
            type: plainText
            heading {
                heading: Cod Inmueble
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 19
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CTA_CTE_CTRAL (
            type: plainText
            heading {
                heading: Cta Cte Ctral
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DIRECCION (
            type: plainText
            heading {
                heading: Direccion
                alignment: center
            }
            layout {
                sequence: 29
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_BARRIO (
            type: plainTextBasedOnLov
            heading {
                heading: Barrio
                alignment: end
            }
            lov {
                lov: @lv-barrios
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_CIUDAD (
            type: plainTextBasedOnLov
            heading {
                heading: Ciudad
                alignment: end
            }
            lov {
                lov: @lv-ciudades
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_DEPARTAMENTO (
            type: plainTextBasedOnLov
            heading {
                heading: Departamento
                alignment: end
            }
            lov {
                lov: @lv-provincias
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 8
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_TIP_INMUEBLE (
            type: plainTextBasedOnLov
            heading {
                heading: Tipo
                alignment: end
            }
            lov {
                lov: @lv-categorias
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Inmuebles
        }

        savedReport 888035 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn 'LINK_PORCENTAJE' (
                sequence: 9
            )

            displayColumn COD_INMUEBLE (
                sequence: 1
            )

            displayColumn CTA_CTE_CTRAL (
                sequence: 7
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn DIRECCION (
                sequence: 8
            )

            displayColumn ID_BARRIO (
                sequence: 5
            )

            displayColumn ID_CIUDAD (
                sequence: 4
            )

            displayColumn ID_DEPARTAMENTO (
                sequence: 3
            )

            displayColumn ID_TIP_INMUEBLE (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @inmuebles
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 559
                clearCache: 559
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

)

