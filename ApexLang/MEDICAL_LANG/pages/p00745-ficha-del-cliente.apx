        action p745-id-cliente-p745-id-tip-cliente-p745-id-vendedor (
            name: P745_ID_CLIENTE,P745_ID_TIP_CLIENTE,P745_ID_VENDEDOR
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT NVL(PC.NOMB_FANTASIA, PC.NOMBRE), TC.DESCRIPCION, NVL(PV.NOMB_FANTASIA, PV.NOMBRE),
                           PC.ID
                      INTO :P745_NOMB_CLIENTE, :P745_TIP_CLIENTE, :P745_VENDEDOR,
                           :P745_ID_PERSONA
                      FROM CCW_CLIENTES CL
                      JOIN CCW_TIPO_CLIENTE TC ON TC.ID = CL.ID_TIP_CLIENTE
                      JOIN FVW_VENDEDORES   VE ON VE.ID = CL.ID_VENDEDOR
                      JOIN BSW_PERSONAS     PC ON PC.ID = CL.ID_PERSONA
                      JOIN BSW_PERSONAS     PV ON PV.ID = VE.ID_PERSONA
                     WHERE CL.ID = :P745_LV_CLIENTES;
                    ```
                itemsToSubmit: P745_LV_CLIENTES
                itemsToReturn: [
                    P745_NOMB_CLIENTE
                    P745_TIP_CLIENTE
                    P745_VENDEDOR
                    P745_ID_PERSONA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

