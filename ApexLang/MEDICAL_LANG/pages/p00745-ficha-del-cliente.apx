    region contactos (
        name: Contactos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PT.NOMBRE,
                       PT.DIREC_ELECTRONICA CORREO,
                       PT.TELEFONO,
                       DE.DESCRIPCION DEPARTAMENTO,
                       CA.DESCRIPCION CARGO,
                       PT.ID
                  FROM BSW_PERSONAS      PT
                LEFT JOIN BSW_DEPARTAMENTOS DE ON DE.ID = PT.ID_DEPARTAMENTO_TRAB
                LEFT JOIN BSW_CARGOS        CA ON CA.ID = PT.ID_CARGO
                 WHERE PT.ID_TRABAJO_PER IN (
                     SELECT ID_PERSONA
                       FROM CCW_CLIENTES CL
                      WHERE CL.ID = :P745_LV_CLIENTES
                 )
                ```
        }
        layout {
            sequence: 10
            parentRegion: @datos-del-cliente
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 11
                items: {
                    P11_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 49900472069033401
        }

