page 745 (
    name: Ficha del Cliente
    alias: FICHA-DEL-CLIENTE
    title: Ficha del Cliente
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region actividad (
        name: Actividad
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CLW_FICHA_TECNICA_CLIENTE
            whereClause:
                ```sql
                ID_EMPRESA          = :P0_ID_EMPRESA AND
                ID_CLIENTE          = :P745_LV_CLIENTES AND
                ID_INFO_TECNICA_CAB = (SELECT ID FROM CLW_INFO_TECNICA_CAB WHERE COD_INFO_TECNICA = '1')
                ```
            pageItemsToSubmit: [
                P745_LV_CLIENTES
                P745_ID_INFO_TECNICA_CAB
            ]
        }
        layout {
            sequence: 10
            parentRegion: @info-tecnica
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: saveButton
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 24827087819339639
        }

        savedReport 256073 (
