page 631 (
    name: Resumen por Ventas
    alias: RESUMEN-POR-VENTAS
    title: Resumen por Ventas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /*.a-IRR-header {    background-color:#4047bc;color: white;}.a-IRR-headerLink {    font-weight: bold;color: white;}
             */ 
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region datos (
        name: Datos
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region grafico-linea (
        name: Grafico/Linea
        type: chart
        layout {
            sequence: 10
            parentRegion: @reporte-ventas-linea
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: lineWithArea
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series linea (
            name: Linea
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT V.ID_LINEA,
                           V.COD_LINEA,
                           V.DESC_LINEA,
                           SUM(V.CANTIDAD) AS CANTIDAD,
                           SUM(V.TOT_COMPROBANTE) AS TOT_COMPROBANTE
                    FROM VTV_VENTAS_BASE V
                    WHERE V.ID_EMPRESA = :P0_ID_EMPRESA
                      AND (V.FEC_COMPROBANTE BETWEEN :P631_FEC_DESDE AND :P631_FEC_HASTA )
                      AND (V.COD_ORIGEN_ART = :P631_COD_ORIGEN_ART OR :P631_COD_ORIGEN_ART IS NULL)
                      AND (V.ID_VENDEDOR = :P631_VENDEDOR OR :P631_VENDEDOR IS NULL)
                      AND (V.ID_CLIENTE = :P631_CLIENTE OR :P631_CLIENTE IS NULL)
                      AND (V.ID_FAMILIA = :P631_FAMILIA OR :P631_FAMILIA IS NULL)
                      AND (V.ID_RUBRO = :P631_RUBRO OR :P631_RUBRO IS NULL)
                      AND (V.ID_LINEA = :P631_LINEA OR :P631_LINEA IS NULL)
                      AND (V.ID_MARCA = :P631_MARCA OR :P631_MARCA IS NULL)
                      having SUM(V.TOT_COMPROBANTE)!=0
                    
                    GROUP BY  V.ID_LINEA, V.COD_LINEA, V.DESC_LINEA
                    ```
                pageItemsToSubmit: [
                    P631_FEC_DESDE
                    P631_FEC_HASTA
                    P631_COD_ORIGEN_ART
                    P631_VENDEDOR
                    P631_TIPO_REPORTE
                    P631_CLIENTE
                    P631_FAMILIA
                    P631_RUBRO
                    P631_MARCA
                    P631_LINEA
                ]
            }
            columnMapping {
                seriesName: COD_LINEA
                label: DESC_LINEA
                value: TOT_COMPROBANTE
            }
            serverSideCondition {
                type: item=value
                item: P631_TIPO_REPORTE
                value: L
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

