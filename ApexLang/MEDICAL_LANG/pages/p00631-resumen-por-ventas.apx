    region reporte-ventas-linea (
        name: Reporte Ventas/Linea
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT V.ID_LINEA,
                       V.COD_LINEA,
                       V.DESC_LINEA,
                       SUM(V.CANTIDAD) AS CANTIDAD,
                       SUM(V.TOT_COMPROBANTE) AS TOT_COMPROBANTE
                FROM VTV_VENTAS_BASE V
                WHERE V.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (V.FEC_COMPROBANTE BETWEEN :P631_FEC_DESDE AND :P631_FEC_HASTA )
                  AND (V.COD_ORIGEN_ART = :P631_COD_ORIGEN_ART OR :P631_COD_ORIGEN_ART IS NULL)
                  AND (V.ID_VENDEDOR = :P631_VENDEDOR OR :P631_VENDEDOR IS NULL)
                  AND (V.ID_CLIENTE = :P631_CLIENTE OR :P631_CLIENTE IS NULL)
                  AND (V.ID_FAMILIA = :P631_FAMILIA OR :P631_FAMILIA IS NULL)
                  AND (V.ID_RUBRO = :P631_RUBRO OR :P631_RUBRO IS NULL)
                  AND (V.ID_LINEA = :P631_LINEA OR :P631_LINEA IS NULL)
                  AND (V.ID_MARCA = :P631_MARCA OR :P631_MARCA IS NULL)
                  having SUM(V.TOT_COMPROBANTE)!=0
                
                GROUP BY  V.ID_LINEA, V.COD_LINEA, V.DESC_LINEA
                ```
            pageItemsToSubmit: [
                P631_FEC_DESDE
                P631_FEC_HASTA
                P631_COD_ORIGEN_ART
                P631_VENDEDOR
                P631_TIPO_REPORTE
                P631_CLIENTE
                P631_FAMILIA
                P631_RUBRO
                P631_MARCA
                P631_LINEA
            ]
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P631_TIPO_REPORTE
            value: L
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 22217053158081316
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

