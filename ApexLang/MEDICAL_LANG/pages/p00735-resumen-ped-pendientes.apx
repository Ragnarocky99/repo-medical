    region resumen-occ-renovado (
        name: Resumen OCC Renovado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH BLOQUEOS AS (
                    SELECT SUM(CANT_BLOQUEO) CANT_BLOQUEO,
                           ID_ARTICULO
                      FROM STWV_ARTICULOS_BLOQUEO
                     WHERE CANT_BLOQUEO > 0
                    GROUP BY ID_ARTICULO
                )
                SELECT NRO_PEDIDO,
                       NRO_ITEM,
                       COD_ARTICULO,
                       COD_ORIGEN_ART COD_FABRICANTE,
                       DESC_ARTICULO,
                       ID_ENVASE,
                       ID_UNIDAD_MEDIDA,
                       ID_MARCA,
                       ID_TIPO_ENTREGA,
                       ID_CLIENTE,
                       PRECIO_UNITARIO,
                       PRECIO_TOTAL,
                       NRO_OCC,
                       FEC_OCC,
                       FECHA_PLAZO,
                       APROBADA,
                       ANULADA,
                       ENTREGADA,
                       REMISIONADA,
                       OCC ESTADO_OCC,
                       STOCK,
                       STOCK - NVL(B.CANT_BLOQUEO, 0) DISPONIBILIDAD,
                       ID_SUCURSAL,
                       IND_CONTROLADO
                  FROM CMW_RESUMEN_OCC_RENOVADO R
                LEFT JOIN BLOQUEOS B ON R.ID_ARTICULO = B.ID_ARTICULO
                 WHERE NRO_PEDIDO = :P735_NRO_PEDIDO
                   AND OCC = 'Pendiente'
                ```
            pageItemsToSubmit: P735_NRO_PEDIDO
            optimizerHint: WITH_PLSQL
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 64218529065365611
        }

