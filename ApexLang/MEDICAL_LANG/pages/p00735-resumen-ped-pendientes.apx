    dynamicAction alerta (
        name: Alerta
        execution {
            sequence: 160
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-alert (
            action: alert
            settings {
                title: Aviso, se está trabajando en esta página
                message: Se está añadiendo un(a) validación/proceso/cambio a la página, lo que puede provocar errores si está usando la página.
                style: information
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cambio-desc-articulo (
        name: Cambio_Desc_Articulo
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P735_ARTICULO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ID_ARTICULO
                    from STWV_ARTICULOS
                    where DESC_ARTICULO = :P735_ARTICULO
                    ```
            }
            affectedElements {
                selectionType: items
                items: P735_ARTICULO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 170
        }
        when {
            selectionType: items
            items: P735_TODOS
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select count(1) from cmw_cotiza_articulos
            }
            affectedElements {
                selectionType: items
                items: P735_LIMITE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 140
        }
        when {
            selectionType: items
            items: P735_PROVEEDOR
        }
        serverSideCondition {
            type: never
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-de-orden-de-compra
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

