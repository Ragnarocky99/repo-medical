    region resumen-de-orden-de-compra (
        name: Resumen de Orden de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with function estado_occ_f(
                        p_cant_aprobada in number,
                        p_cant_anulada in number,
                        p_cant_entregada in number,
                        p_cant_remisionada in number
                        ) return varchar2 is
                     l_estado varchar2(20);
                     begin
                       select case p_cant_aprobada
                         when p_cant_anulada then 'Anulado'
                         when p_cant_entregada+p_cant_anulada then 'Facturado'
                         when p_cant_remisionada then 'Remision'
                         else 'Pendiente'
                        end as occ
                       into  l_estado
                       from dual;
                       
                       return l_estado;
                     end;
                
                     cantidades_externas as(
                    select greatest(OBTENER_CANTIDAD_PENDIENTE(P_ID_PEDIDO  => ca.ID_PEDIDO /*IN NUMBER*/,
                                               P_ID_ARTICULO  => ca.ID_ARTICULO/*IN NUMBER*/,
                                               P_ID_EMPRESA  => ca.ID_EMPRESA/*IN NUMBER*/,
                                               P_ID  => ca.ID /*IN NUMBER*/) - nvl(ca.cant_anulada,0),0)
                                               as pendiente,
                             least(nvl((SELECT SUM(D1.CANTIDAD)
                             FROM STW_ENTSAL_CAB C1,
                                STW_ENTSAL_DET D1
                                WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                AND C1.ID = D1.ID_ENTSAL_CAB
                                AND NVL(C1.ESTADO, 'N') != 'A'
                                AND D1.ID_ARTICULO = ca.ID_ARTICULO
                                AND D1.ID_PEDIDO_DETALLE = ca.ID_PEDIDO_DET),0),ca.cantidad_aprobada) as remisionada,
                                obtener_cantidad_existente(ca.id_articulo, /*vtpeca.id_sucursal*/NULL, 'S') DISPONIBILIDAD,
                                nvl(existencia_actual(/*vtpeca.id_sucursal*/NULL,ca.id_articulo,ca.id_empresa), 0) STOCK, --stock                
                                ca.id
                    from cmw_cotiza_articulos ca
                    join vtw_pedidos_cabecera vtpeca on ca.id_pedido = vtpeca.id
                    and (vtpeca.nro_comprobante = :P735_NRO_PEDIDO or :P735_NRO_PEDIDO is null)
                
                ),
                cantidades_internas as (
                    select ca.ID,     
                    nvl(ca.CANTIDAD_APROBADA,0) as aprobada,
                    nvl(ca.CANT_ANULADA,0)    as anulada,
                    /*case 
                        when ca.cant_anulada = ca.cantidad_aprobada then 0
                        when ce.pendiente = 0 and ce.remisionada >= 0 then nvl(ca.CANTIDAD_APROBADA,0)-nvl(ca.cant_anulada,0)
                        -- ce.remisionada = 0  -> ce.remisionada >=0
                        when ca.cantidad_entregada > ca.cantidad_aprobada then nvl(ca.cantidad_aprobada,0)-nvl(ca.cant_anulada,0)     
                        else nvl(ca.CANTIDAD_ENTREGADA,0)
                        cometado el 30/12/2024. Esto ya no sirve.
                    end as entregada*/
                    nvl(ca.cantidad_aprobada,0)-nvl(ce.pendiente,0)-nvl(ca.cant_anulada,0) as entregada
                    from CMW_COTIZA_ARTICULOS ca
                    join vtw_pedidos_cabecera c4 on ca.id_pedido = c4.id
                    join CANTIDADes_EXTERNAS ce on ca.id = ce.id
                    and (c4.nro_comprobante = :P735_NRO_PEDIDO or :P735_NRO_PEDIDO is null)
                
                )
                SELECT
                    C.ID AS C_ID,
                    --test_f(c.id),
                    C.ID_EMPRESA,
                    C.ID_SUCURSAL,
                    C.ID_ARTICULO,
                    C.ID_PROVEEDOR,
                    C.ID_MONEDA,
                    C.PRECIO,
                    C.PRECIO * C.CANTIDAD AS mon_costo,
                    C.PRECIO AS mon_costo_copia,
                    C.NRO_ITEM,
                    A.ID_ENVASE,
                    A.ID_UNIDAD_MEDIDA,
                    A.ID_MARCA,
                    A.COD_ARTICULO,
                    A.DESCRIPCION AS DESC_ARTICULO,
                    C.ID_TIPO_ENTREGA,
                    C.PRECIO_UNITARIO,
                    C.PRECIO_TOTAL,
                    P.ID AS P_ID,
                    P.ID_CLIENTE,
                    P.FEC_COMPROBANTE,
                    C.NRO_OCC,
                    C.FEC_OCC,                
                    A.COD_ORIGEN_ART,
                    A.ID_GRUPO_ART,
                    T.NRO_DIAS NRO_DIAS,
                    C.FEC_OCC + T.NRO_DIAS AS FECHA_PLAZO,
                    P.NRO_COMPROBANTE AS NRO_PEDIDO,
                    ci.aprobada,
                    ci.anulada,
                    ci.entregada,
                    ce.pendiente,
                    ce.remisionada,
                    --es.occ,
                    estado_occ_f(nvl(ci.aprobada,0), nvl(ci.anulada,0), nvl(ci.entregada,0), nvl(ce.remisionada,0)) as occ,
                    ce.disponibilidad,
                    ce.stock,
                    c.cantidad_entregada,
                    c.cant_remision,
                
                    P.id as Ped_Id,
                    A.id as Art_Id,
                    C.Id as Cot_Id,
                    C.id_pedido_det,
                    P.ID_SUCURSAL ID_SUCURSAL_PEDIDO,
                    NVL(A.IND_CONTROLADO, 'N') IND_CONTROLADO
                
                FROM CMW_COTIZA_ARTICULOS C
                JOIN STW_ARTICULOS A         ON A.ID = C.ID_ARTICULO AND A.ID_EMPRESA = C.ID_EMPRESA
                JOIN VTW_PEDIDOS_CABECERA P  ON P.ID = C.ID_PEDIDO AND P.ID_EMPRESA = C.ID_EMPRESA
                LEFT JOIN CMW_TIPO_ENTREGA T ON T.ID = NVL(C.ID_TIPO_ENTREGA,40) AND T.ID_EMPRESA = NVL(C.ID_EMPRESA,/*:P0_ID_EMPRESA*/121)
                JOIN CANTIDADES_INTERNAS  CI ON C.ID = CI.ID 
                JOIN CANTIDADES_EXTERNAS  CE ON C.ID = CE.ID
                
                WHERE (C.NRO_OCC IS NOT NULL AND C.NRO_OCC <> '0')
                AND (P.NRO_COMPROBANTE = :P735_NRO_PEDIDO OR :P735_NRO_PEDIDO IS NULL)   
                AND (estado_occ_f(nvl(ci.aprobada,0), nvl(ci.anulada,0), nvl(ci.entregada,0), nvl(ce.remisionada,0)) = 'Pendiente')     
                
                order by c.id desc
                ---fetch first :P677_LIMITE rows only
                ```
            pageItemsToSubmit: [
                P735_LIMITE
                P735_TODOS
                P735_BANDERA
                P735_NRO_PEDIDO
            ]
            optimizerHint: WITH_PLSQL
        }
