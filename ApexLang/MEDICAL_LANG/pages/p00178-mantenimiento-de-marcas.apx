page 178 (
    name: Mantenimiento de Marcas
    alias: MANTENIMIENTO-DE-MARCAS
    title: Mantenimiento de Marcas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region mantenimiento-de-marcas (
        name: Mantenimiento de Marcas
        type: form
        source {
            location: localDatabase
            tableName: STW_MARCAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P178_ABREVIATURA (
        type: textField
        label {
            label: Abreviatura
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @mantenimiento-de-marcas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P178_COD_MARCA (
        type: textField
        label {
            label: Cod Marca
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @mantenimiento-de-marcas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: COD_MARCA
            dataType: varchar2
        }
    )

    pageItem P178_COD_USUARIO_AUD (
        type: textField
        label {
            label: Cod Usuario Aud
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @mantenimiento-de-marcas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
    )

    pageItem P178_DESCRIPCION (
        type: textField
        label {
            label: Descripcion
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @mantenimiento-de-marcas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P178_ID (
        type: hidden
        layout {
            sequence: 10
            region: @mantenimiento-de-marcas
            slot: regionBody
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P178_ID_EMPRESA (
        type: selectList
        label {
            label: Id Empresa
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @bsw-empresas-cod-empresa
        }
        layout {
            sequence: 50
            region: @mantenimiento-de-marcas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: ID_EMPRESA
            dataType: number
        }
    )

    pageItem P178_IND_REPLICA (
        type: textField
        label {
            label: Ind Replica
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @mantenimiento-de-marcas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 1
        }
        source {
            formRegion: @mantenimiento-de-marcas
            column: IND_REPLICA
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P178_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P178_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P178_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 39286219912935753
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-mantenimiento-de-marcas (
        name: Initialize form Mantenimiento de Marcas
        type: formInitialization
        formRegion: @mantenimiento-de-marcas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 39285404249935753
        }
    )

    process process-form-mantenimiento-de-marcas (
        name: Process form Mantenimiento de Marcas
        type: formAutoRowProcessing
        formRegion: @mantenimiento-de-marcas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 39285808610935753
        }
    )

)

