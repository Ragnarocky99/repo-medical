page 386 (
    name: Parametros Generales F.E.
    alias: PARAMETROS-GENERALES
    title: Parametros Generales F.E.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region parametros-generales (
        name: Parametros Generales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       PARAMETRO,
                       DESCRIPCION,
                       VALOR
                  from FEW_PARAMETROS_GENERALES
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 387
                items: {
                    P387_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 22324384355658448
        }

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Empresa
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PARAMETRO (
            type: plainText
            heading {
                heading: Parametro
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Parametros Generales
        }

        savedReport 223330 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn PARAMETRO (
                sequence: 3
            )

            displayColumn VALOR (
                sequence: 5
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @parametros-generales
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 387
                clearCache: 387
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @parametros-generales
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @parametros-generales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

