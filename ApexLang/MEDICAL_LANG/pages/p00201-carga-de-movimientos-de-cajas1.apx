page 201 (
    name: Carga de Movimientos de Cajas
    alias: CARGA-DE-MOVIMIENTOS-DE-CAJAS1
    title: Carga de Movimientos de Cajas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-movimientos-de-cajas (
        name: Carga de Movimientos de Cajas
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NRO_MOV_CAJ,
                       ID_SUCURSAL,
                       FEC_MOV_CAJ,
                       ID_CAJA,
                       NRO_HABILITACION,
                       NUM_ASIENTO,
                       ANULADO,
                       FEC_ANULACION,
                       ID_USUARIO,
                       NUM_ASIENTO_ANUL,
                       TOT_NRO_MOV_CAJ,
                       ID_MONEDA,
                       TIPO_CAMBIO,
                       TIP_CAMBIO,
                       FEC_ALTA,
                       VUELTO,
                       ID_CORPORACION,
                       COD_USUARIO_AUD,
                       ID_CLIENTE,
                       ASIENTOS,
                       TRANSAC_PRONET,
                       ID_HABILITACION,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       IND_GEN_AUTO
                  from CCW_MOVIMIENTOS_CAJAS
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

