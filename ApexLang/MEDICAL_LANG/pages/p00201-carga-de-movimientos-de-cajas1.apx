    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P201_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cliente-display-only (
        name: cliente_display_only
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P201_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_ID_CLIENTE_N
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P201_ID_CLIENTE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P201_ID_CLIENTE_N
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p201-nro-mov-caj (
        itemName: P201_NRO_MOV_CAJ
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT 
                    CASE WHEN MAX(TO_CHAR(NRO_MOV_CAJ)) IS NULL THEN 1 ELSE MAX(TO_CHAR(NRO_MOV_CAJ)+1) END
                FROM CCW_MOVIMIENTOS_CAJAS
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 23154536405410768
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-movimientos-de-cajas (
        name: Initialize form Carga de Movimientos de Cajas
        type: formInitialization
        formRegion: @carga-de-movimientos-de-cajas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 23153766365410767
        }
    )

    process process-form-carga-de-movimientos-de-cajas (
        name: Process form Carga de Movimientos de Cajas
        type: formAutoRowProcessing
        formRegion: @carga-de-movimientos-de-cajas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23154120385410768
        }
    )

)

