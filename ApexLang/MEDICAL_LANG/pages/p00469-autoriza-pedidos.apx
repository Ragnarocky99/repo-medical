    region lotes (
        name: Lotes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT LO.ID_EMPRESA,
                       LO.ID_ARTICULO,
                       E.ID_SUCURSAL,
                       SU.DESCRIPCION,
                       E.ID_LOTE,
                       LO.NRO_LOTE,
                       LO.FEC_VENCIMIENTO,
                       E.CANT_DISPON
                FROM STW_LOTES LO,
                     BSW_SUCURSALES SU,
                     STW_EXISTENCIA_ART E
                WHERE E.ID_EMPRESA  = LO.ID_EMPRESA
                  AND E.ID_ARTICULO = LO.ID_ARTICULO
                  AND E.ID_LOTE     = LO.ID
                  AND E.ID_SUCURSAL = SU.ID
                ```
        }
        layout {
            sequence: 20
            parentRegion: @detalle-de-autoriza-pedido
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            renderComponents: belowContent
        }
        masterDetail {
            masterRegion: @detalle-de-autoriza-pedido
        }
