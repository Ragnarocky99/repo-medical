    validation validar-cantidad-a-entregar (
        name: Validar cantidad a entregar
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @detalle-de-autoriza-pedido
            plsqlExpression: :DIFERENCIA_ENTREGA >=0
            alwaysExecute: true
        }
        error {
            errorMessage: Error, la cantidad a entregar no puede ser mayor que la pendiente.
            associatedColumn: DIFERENCIA_ENTREGA
        }
    )

    validation validar-reserva (
        name: Validar reserva
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @detalle-de-autoriza-pedido
            plsqlExpression: TO_NUMBER(REPLACE(:CANTIDAD_A_ENTREGAR, '.', '')) <= TO_NUMBER(REPLACE(:CANT_RESERVADA, '.', ''))
            alwaysExecute: true
        }
        error {
            errorMessage:
                ```
                La cantidad a entregar no puede ser mayor a la cantidad reservada
                
                ```
            associatedColumn: CANTIDAD_A_ENTREGAR
        }
    )

    computation p469-carga-autoriza-ctacte (
        itemName: P469_CARGA_AUTORIZA_CTACTE
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    V_PERMISO VARCHAR2(1);
                BEGIN
                    SELECT 'S'
                      INTO V_PERMISO 
                    FROM BSW_PERMISOS_FORMAS F,
                         BSW_PERMISOS_OPCIONES O
                    WHERE F.ID_PERMISO = O.ID
                      AND F.ID_EMPRESA = O.ID_EMPRESA
                      AND F.ID_EMPRESA = :P0_ID_EMPRESA
                      AND F.ID_USUARIO = TRAE_ID_USUARIO(F.ID_EMPRESA,UPPER(:APP_USER))
                      AND O.PARAMETRO = 'AUTORIZA_CTACTE';
                    RETURN V_PERMISO;
                EXCEPTION WHEN OTHERS THEN
                RETURN 'N';
                END;
                ```
        }
    )

