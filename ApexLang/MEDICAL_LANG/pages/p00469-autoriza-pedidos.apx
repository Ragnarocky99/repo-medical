    dynamicAction autoriza-ctacte (
        name: AUTORIZA_CTACTE
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @autoriza-pedidos
            columns: AUTORIZA_CTACTE
        }

        action autoriza-ctacte-fec (
            name: AUTORIZA_CTACTE_FEC
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vfec VARCHAR2(20);
                    BEGIN
                        IF :P469_CARGA_AUTORIZA_CTACTE = 'S' THEN 
                            IF NVL(:AUTORIZA_CTACTE,'N') = 'S' AND :P469_CARGA_AUTORIZA_CTACTE = 'S' THEN
                                vfec := SYSDATE/*TO_CHAR(SYSDATE,'DD/MM/YYYY HH:MM:SS')*/;
                            ELSE
                                vfec := NULL;
                            END IF;
                        END IF;
                        RETURN vfec;
                    END;
                    ```
                itemsToSubmit: [
                    AUTORIZA_CTACTE
                    P469_CARGA_AUTORIZA_CTACTE
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: AUTORIZA_CTACTE_FEC
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P469_CARGA_AUTORIZA_CTACTE
                value: S
            }
        )

        action autoriza-ctacte-usuario (
            name: AUTORIZA_CTACTE_USUARIO
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vuser VARCHAR2(20);
                    BEGIN
                        IF :P469_CARGA_AUTORIZA_CTACTE = 'S' THEN 
                            IF NVL(:AUTORIZA_CTACTE,'N') = 'S' THEN
                                vuser := :APP_USER;
                            ELSE
                                vuser := NULL;
                            END IF;
                        END IF;
                        RETURN vuser;
                    END;
                    ```
                itemsToSubmit: [
                    AUTORIZA_CTACTE
                    P469_CARGA_AUTORIZA_CTACTE
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: AUTORIZA_CTACTE_USU
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P469_CARGA_AUTORIZA_CTACTE
                value: S
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select /*TO_CHAR(SYSDATE,'DD/MM/YYYY HH:MM:SS')*/sysdate from dual;
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: AUTORIZA_CTACTE_FEC
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

