    dynamicAction new (
        name: New
        execution {
            sequence: 120
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle-de-autoriza-pedido
            columns: CANTIDAD_A_ENTREGAR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       l_cantidad_a_entregar NUMBER := :CANTIDAD_A_ENTREGAR; 
                       l_cantidad_pendiente NUMBER := :CANTIDAD_PENDIENTE; 
                    BEGIN
                       IF l_cantidad_a_entregar > l_cantidad_pendiente THEN
                          raise_application_error(-20001, 'La cantidad a entregar no puede ser mayor que la cantidad pendiente.');
                       ELSIF l_cantidad_a_entregar = 0 THEN
                          raise_application_error(-20001, 'La cantidad a entregar no puede ser igual a 0.'); 
                       END IF;
                    END;
                    
                    ```
                itemsToSubmit: [
                    CANTIDAD_A_ENTREGAR
                    CANTIDAD_PENDIENTE
                    NRO_OCC
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

