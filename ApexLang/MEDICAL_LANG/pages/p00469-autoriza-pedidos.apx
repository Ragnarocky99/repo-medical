    dynamicAction marcar-todos-c (
        name: Marcar Todos_C
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @marcar-todo-ctacte
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: DBMS_LOCK.SLEEP(0.2);
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try {
                        var model = apex.region("Autoriza").widget().interactiveGrid("getCurrentView").model;
                        var v_seleccionada = model.getFieldKey("AUTORIZA_CTACTE");
                        ///var v_total_cantidad = 0;
                        var bandera = 'N';
                        model.forEach(function(r, index, id) {
                            var meta = model.getRecordMetadata(id);
                    
                            console.log(meta.fields); // meta.fields undifined validation   --deprecated By RP
                            if ((meta != undefined) && (!meta.deleted)) {
                    
                                if (r[v_seleccionada] == 'N' || r[v_seleccionada] == null || r[v_seleccionada] == '') {
                                    bandera = 'S';
                                    model.setValue(r, 'AUTORIZA_CTACTE', 'S');
                    
                                }
                                if (r[v_seleccionada] == 'S' && bandera == 'N') {
                                    model.setValue(r, 'AUTORIZA_CTACTE', 'N');
                                }
                            }
                        });
                        
                        // Llamar a la función de devolución de llamada cuando se complete la operación
                        if (typeof callback === "function") {
                            callback();
                        }
                    } catch (e) {
                        console.error("Se produjo un error:", e);
                    }
                    
                    
                    /*
                    // Llamar a la función marcarTodos con una función de devolución de llamada
                    marcarTodos(function() {
                            console.log("La función de devolución de llamada se ha ejecutado.");
                    
                        // Realizar otras operaciones después de marcar
                        // Esta función se ejecutará después de que los cambios se apliquen
                    });
                    */
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression: $( "Autoriza" ).grid( "focus" );
            }
            execution {
                sequence: 10
            }
        )

    )

