page 469 (
    name: Autoriza Pedidos
    alias: AUTORIZA-PEDIDOS
    title: "Autorizacion de OCC "
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P469_DESC_CLIENTE").readOnly = true;
            //document.getElementById("P469_DESC_SUPERVISOR").readOnly = true;
            document.getElementById("P469_DESC_VENDEDOR_DET").readOnly = true;
            document.getElementById("P469_DESC_VENDEDOR_CAB").readOnly = true;
            document.getElementById("P469_DESC_ZONA").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region autoriza-pedidos (
        name: Autoriza Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT P.ID,
                       P.ID_EMPRESA,
                       P.ID_SUCURSAL,
                       NVL(P.ESTADO, 'PE') ESTADO,
                       P.TIP_COMPROBANTE,
                       P.SER_COMPROBANTE,
                       P.NRO_COMPROBANTE,
                       P.FEC_ALTA,
                       P.ID_CLIENTE,
                       P.NOM_CLIENTE,
                       P.FEC_COMPROBANTE,
                       P.ID_VENDEDOR,
                       P.ID_CONDICION_VENTA,
                       P.ID_LISTA_PRECIO,
                       P.TOT_COMPROBANTE,
                       P.AUTORIZA_STOCK_USU,
                       P.AUTORIZA_STOCK_FEC,
                       P.AUTORIZA_STOCK,
                       P.AUTORIZA_STOCK as AUTORIZA_STOCK_COPIA,
                       P.AUTORIZA_CTACTE_USU,
                       P.AUTORIZA_CTACTE_FEC,
                       P.AUTORIZA_CTACTE,
                       P.AUTORIZA_CTACTE as AUTORIZA_CTATE_COPIA,
                       P.IND_PRIORIDAD,
                       P.ID_ZONA,
                       P.ESTADO_AUT_FAC,
                       P.ind_sin_stock,
                       P.ind_sin_occ,
                       P.NUEVA_FECHA,
                       p.OBSERVACION,
                       P.ID_SOPORTE,
                       P.AUTORIZA_FACTURA,
                       P.AUTORIZA_FACTURA_USU,
                       P.AUTORIZA_FACTURA_FEC,
                       CASE
                        WHEN EXISTS (SELECT 1
                                       FROM CMW_RESUMEN_OCC_RENOVADO R
                                      WHERE R.PED_ID = P.ID
                                        AND R.OCC = 'Pendiente'
                                        AND R.APROBADA - R.ENTREGADA != R.CANT_RESERVADA) THEN 'PARCIAL'
                        ELSE 'TOTAL'
                       END ESTADO_PENDIENTES
                
                       ---,
                       ---P.COMENTARIO_OPERATIVO
                  FROM
                (SELECT PD.ID,
                       PD.ID_EMPRESA,
                       PD.ID_SUCURSAL,
                       NVL(PD.ESTADO,'EP') ESTADO,
                       PD.TIP_COMPROBANTE,
                       PD.SER_COMPROBANTE,
                       PD.NRO_COMPROBANTE,
                       PD.FEC_ALTA,
                       PD.ID_CLIENTE,
                       PD.NOM_CLIENTE,
                       PD.FEC_COMPROBANTE,
                       PD.ID_VENDEDOR,
                       PD.ID_CONDICION_VENTA,
                       PD.ID_LISTA_PRECIO,
                       PD.TOT_COMPROBANTE,
                       PD.AUTORIZA_STOCK_USU,
                       PD.AUTORIZA_STOCK_FEC,
                       NVL(PD.AUTORIZA_STOCK,'N') AUTORIZA_STOCK,
                       PD.AUTORIZA_CTACTE_USU,
                       PD.AUTORIZA_CTACTE_FEC,
                       NVL(PD.AUTORIZA_CTACTE,'N') AUTORIZA_CTACTE,
                       PD.IND_PRIORIDAD,
                       FV.ID_ZONA,
                       PD.ESTADO_AUT_FAC,
                       
                       /*nvl((select 'S' 
                        from vtw_pedidos_detalle pdd
                        where pdd.id_pedido_cabecera = pd.id
                          and obtener_cantidad_existente(pdd.id_articulo,pd.id_sucursal,'S') < 0 
                        group by 'S'),'N') ind_sin_stock,*/
                       
                       nvl((select 'N' 
                        --from vtw_pedidos_detalle pdd
                        from cmw_cotiza_articulos pdd
                        --where pdd.id_pedido_cabecera = pd.id
                        where pdd.id_pedido = pd.id
                          /*AND PDD.ID_ARTICULO IN( SELECT E.ID_ARTICULO
                                                        FROM STW_EXISTENCIA_ART E
                                                        WHERE E.CANT_DISPON > 0)*/
                         and exists(select 1 
                                    from stw_existencia_art e, stw_articulos ax
                                    where e.id_articulo = pdd.id_articulo
                                      and ax.id = e.id_articulo
                                      and (e.cant_dispon > 0 or nvl(ax.ind_maneja_stock,'S') = 'N')
                                      )
                        group by 'S'),'S') ind_sin_stock,
                        
                        nvl((select 'S' 
                        from cmw_cotiza_articulos cca
                        where cca.id_pedido = pd.id
                          and (cca.nro_occ = '0' OR cca.nro_occ IS NULL) 
                        group by 'S'),'N')ind_sin_occ,
                        
                        (SELECT COUNT(*)
                          FROM CMW_COTIZA_ARTICULOS Z
                         WHERE Z.ID_PEDIDO = pd.id
                           AND (Z.NRO_OCC <> '0' OR Z.NRO_OCC IS NULL)) CANT_PEND_OCC,
                         
                         (SELECT COUNT(*)
                          FROM CMW_COTIZA_ARTICULOS Z1
                         WHERE Z1.ID_PEDIDO = pd.id
                           AND (Z1.NRO_OCC <> '0' OR Z1.NRO_OCC IS NOT NULL)) CANT_COT_OCC,
                           
                         (SELECT SUM(Z2.CANT_ANULADA)
                            FROM CMW_COTIZA_ARTICULOS Z2
                           WHERE Z2.ID_PEDIDO = PD.ID) CANT_ANULADA,
                      PD.NUEVA_FECHA,/*,
                
                         (SELECT Z3.OBSERVACION
                            FROM CMW_COTIZA_ARTICULOS Z3
                           WHERE Z3.ID_PEDIDO = PD.ID) COMENTARIO_OPERATIVO*/
                
                           (select count(*)
                           from cmw_Cotiza_articulos ca 
                           where ca.id_pedido = PD.id
                           AND nvl(CA.NRO_OCC,'0') <> '0') cantidad_en_pedido,
                
                           (select count(*)
                           from cmw_Cotiza_articulos ca 
                           where ca.id_pedido = PD.id
                           --and nvl(ca.cantidad_aprobada,ca.cantidad)<=obtener_cantidad_existente(ca.id_articulo, ca.id_sucursal, 'S')
                           and nvl(existencia_actual(ca.id_sucursal,ca.id_articulo,ca.id_empresa),0)>=0
                           AND nvl(CA.NRO_OCC,'0') <> '0')
                           cantidad_ok,
                           pd.OBSERVACION,
                           CL.ID_SOPORTE,
                           PD.AUTORIZA_FACTURA,
                           PD.AUTORIZA_FACTURA_USU,
                           AUTORIZA_FACTURA_FEC
                
                
                FROM VTW_PEDIDOS_CABECERA PD, FVW_VENDEDORES FV, CCW_CLIENTES CL
                WHERE PD.ID_EMPRESA   = :P0_ID_EMPRESA
                  AND PD.ID_VENDEDOR  = FV.ID
                  AND CL.ID = PD.ID_CLIENTE
                ) P
                  
                  WHERE (P.IND_SIN_STOCK ='N' or nvl(:P469_PERMISO_STOCK_NEGATIVO,'N') = 'S')
                  ---AND   P.ind_sin_occ = 'N'
                  AND   (P.ID_CLIENTE     = :P469_COD_CLIENTE OR :P469_COD_CLIENTE IS NULL)
                  AND   (P.ID_VENDEDOR    = :P469_COD_VENDEDOR OR :P469_COD_VENDEDOR IS NULL)
                  AND   (P.ID_ZONA        = :P469_COD_ZONA OR :P469_COD_ZONA IS NULL)
                  AND   (P.ESTADO_AUT_FAC = :P469_ESTADO_FACTURA OR :P469_ESTADO_FACTURA IS NULL)
                  AND   (:P469_NRO_OCC IN (SELECT NRO_OCC FROM CMW_COTIZA_ARTICULOS CA WHERE CA.ID_PEDIDO = P.ID) OR :P469_NRO_OCC IS NULL )
                  AND   P.ID IN (SELECT C1.ID_PEDIDO
                                    FROM CMW_COTIZA_ARTICULOS C1
                                    JOIN STW_ARTICULOS        AR1 ON AR1.ID = C1.ID_ARTICULO
                                   WHERE C1.ID_EMPRESA = :P0_ID_EMPRESA
                                    and c1.id_pedido = p.id
                                    AND NVL(C1.CANT_RESERVADA, 0) > 0
                                     /*AND obtener_cantidad_pendiente(C1.ID_PEDIDO,C1.ID_ARTICULO,C1.ID_EMPRESA,C1.id) > 0)*/ -- comentado porque debe ser el stock > 0, no la disponibilidad
                                    --and nvl(existencia_actual(c1.id_sucursal,c1.id_articulo,c1.id_empresa), 0) > 0) -- el stock mayor a cero, pero que si estoy en la sucursal oficina muestre todo excepto licitacion, comentado por eso
                                    and (CASE :P0_ID_SUCURSAL
                                        WHEN '1' THEN
                                            (SELECT SUM(NVL(EA.CANT_DISPON, 0)) 
                                               FROM STW_EXISTENCIA_ART EA
                                              WHERE EA.ID_ARTICULO = C1.ID_ARTICULO
                                                AND EA.ID_SUCURSAL != '690')
                                        ELSE
                                           nvl(existencia_actual(:P0_ID_SUCURSAL,C1.ID_ARTICULO,:P0_ID_EMPRESA), 0)
                                       END > 0) OR NVL(AR1.IND_MANEJA_STOCK, 'N') = 'N' OR NVL(AR1.IND_MANEJA_STOCK, 'N') = 'N' OR nvl(:P469_PERMISO_STOCK_NEGATIVO,'N') = 'S') -- stock corregido aqui, si esta en oficina traera la cantidad disponible en todas las sucursales excepto licitacion, en caso contrario trae el de la sucursal posicionada
                
                                    ---PARA EL CONTROL DE QUE TENGA OCC LO HAGA POR ARTICULO Y NO POR PEDIDO 
                  AND P.CANT_PEND_OCC <> 0  
                  AND P.CANT_COT_OCC > 0
                  --AND P.ESTADO <> 'A'  -- COMENTADO porque usamos la funcion que calcula el estado del pedido
                  AND TRAE_ESTADO_PEDIDO_CABECERA3(P.ID) != 'AN'
                  
                   AND P.ID IN (select CA.ID_PEDIDO
                                from CMW_COTIZA_ARTICULOS CA
                                WHERE (exists ( SELECT 1 
                                                                      FROM STW_EXISTENCIA_ART E, stw_articulos aj
                                                                      WHERE e.id_articulo = ca.id_articulo
                                                                       and aj.id = e.id_articulo
                                                                       and (E.CANT_DISPON > 0 or nvl(aj.ind_maneja_stock,'S') = 'N')
                                                                      ) or nvl(:P469_PERMISO_STOCK_NEGATIVO,'N') = 'S')
                                  AND NVL(CA.NRO_OCC,0) <> '0'
                                  AND NVL(CA.NRO_OCC,0) IS NOT NULL
                                  AND NVL(CA.CANT_ANULADA,0) < obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA,ca.id))
                
                  ---AND NVL(P.CANT_ANULADA,0) < NVL(P.CANT_PEND_OCC,0) 
                  AND(P.ID_SUCURSAL = :P469_SUCURSAL or :P469_SUCURSAL is null)
                  AND(P.AUTORIZA_CTACTE =:P469_FUE_AUTORIZADO or :P469_FUE_AUTORIZADO is null)
                  
                  AND (NVL(P.NUEVA_FECHA,TO_CHAR(SYSDATE,'DD/MM/YYYY')) BETWEEN :P469_NUEVA_FEC_DESDE AND :P469_NUEVA_FEC_HASTA)
                  AND (P.NRO_COMPROBANTE = :P469_NRO_PEDIDO OR :P469_NRO_PEDIDO IS NULL)
                  AND (P.ID_SOPORTE = :P469_ID_SOPORTE OR :P469_ID_SOPORTE IS NULL)
                      
                
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P469_COD_ZONA
                P469_COD_VENDEDOR
                P469_COD_CLIENTE
                P469_ESTADO_FACTURA
                P469_NRO_OCC
                P469_SUCURSAL
                P469_FUE_AUTORIZADO
                P469_NUEVA_FEC_DESDE
                P469_NUEVA_FEC_HASTA
                P469_NRO_PEDIDO
                P469_ID_SOPORTE
            ]
        }
