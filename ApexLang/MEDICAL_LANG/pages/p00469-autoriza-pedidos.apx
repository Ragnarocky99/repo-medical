    region detalle-de-autoriza-pedido (
        name: Detalle de autoriza pedido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                  FROM (    
                    select CA.ID,
                           CA.ID_EMPRESA,
                           CA.ID_ARTICULO,
                           NVL(CA.CANTIDAD_APROBADA,CA.CANTIDAD) AS CANTIDAD,
                           CA.ID_PEDIDO,
                           CA.PRECIO_UNITARIO,
                           CA.NRO_OCC,
                           CA.DESC_ARTICULO,
                           DECODE(NVL(A.IND_MANEJA_STOCK, 'N'), 'N', 0, CASE :P0_ID_SUCURSAL
                                                                          WHEN '1' THEN
                                                                              (SELECT SUM(NVL(EA.CANT_DISPON, 0)) 
                                                                                 FROM STW_EXISTENCIA_ART EA
                                                                                WHERE EA.ID_ARTICULO = CA.ID_ARTICULO
                                                                                  AND EA.ID_SUCURSAL != '690')
                                                                          ELSE
                                                                             nvl(existencia_actual(:P0_ID_SUCURSAL,ca.id_articulo,ca.id_empresa), 0)
                                                                         END) EXISTENCIA, -- Este es el stock, pidieron que si estan en la sucursal OFICINA (1) muestre el stock de todas sucursales excepto licitaciones, si estan en licitacion, que muestre solo de esa sucursal
                           --nvl(existencia_actual(ca.id_sucursal,ca.id_articulo,ca.id_empresa), 0) EXISTENCIA, --stock
                           DECODE(NVL(A.IND_MANEJA_STOCK, 'N'), 'N', 0, obtener_cantidad_existente(ca.id_articulo, ca.id_sucursal, 'S')) STOCK,--disponibilidad
                           /*obtener_cantidad(id_pedido, id_articulo, :P0_ID_EMPRESA)*/
                           CA.CANTIDAD_ENTREGADA,
                           (obtener_cantidad_pendiente(CA.id_pedido, CA.id_articulo, :P0_ID_EMPRESA,ca.id) -
                            nvl(CA.CANT_ANULADA,0)                                                         -
                            NVL((SELECT SUM(RP.CANTIDAD_PENDIENTE)
                                 FROM VTWV_FACTURAR_REMISIONES RP
                                WHERE RP.ID_COTIZA_ART = CA.ID), 0)) CANTIDAD_PENDIENTE,
                           NVL(CA.CANTIDAD_A_ENTREGAR,0)CANTIDAD_A_ENTREGAR,
                           ''FACTURAR,
                           obtener_cantidad_pendiente(CA.id_pedido, CA.id_articulo, :P0_ID_EMPRESA,ca.id)-NVL(CA.CANTIDAD_A_ENTREGAR,0) as DIFERENCIA_ENTREGA,
                           CA.ID_ARTICULO AS ID_ARTICULO_2,
                           CA.OBSERVACION,
                           (select num_orden from vtw_pedidos_Detalle dl where dl.id = ca.id_pedido_det) as nro_item,
                           (SELECT NVL(A.IND_CONTROLADO, 'N') FROM STW_ARTICULOS A WHERE A.ID = CA.ID_ARTICULO) IND_CONTROLADO,
                           CA.FEC_PLAZO FECHA_PLAZO,--CA.FEC_OCC + T.NRO_DIAS AS FECHA_PLAZO,
                           A.COD_ARTICULO,
                           NVL((SELECT SUM(RP.CANTIDAD_PENDIENTE)
                                 FROM VTWV_FACTURAR_REMISIONES RP
                                WHERE RP.ID_COTIZA_ART = CA.ID), 0) CANT_REMISION_SIN_FACTURA,
                          '' VER_TAREA,
                          CA.ID_PEDIDO_DET,
                          CA.COMENTARIO_AUTORIZA,
                          CA.OBSERVACION COMENTARIO_OPERATIVO,
                          NVL(CA.CANT_RESERVADA, 0) CANT_RESERVADA
                            
                      from CMW_COTIZA_ARTICULOS CA, CMW_TIPO_ENTREGA T, STW_ARTICULOS A
                    --   WHERE (
                    --     CA.ID_ARTICULO IN (
                    --         SELECT E.ID_ARTICULO
                    --         FROM STW_EXISTENCIA_ART E
                    --         WHERE E.CANT_DISPON > 0
                    --         AND E.ID_ARTICULO = CA.ID_ARTICULO
                    --     )
                    --     OR NVL(:P469_PERMISO_STOCK_NEGATIVO, 'N') = 'S'
                    --     OR EXISTS (
                    --         SELECT 1
                    --         FROM STW_ARTICULOS AR
                    --         WHERE AR.ID = CA.ID_ARTICULO
                    --         AND NVL(AR.IND_MANEJA_STOCK, 'S') = 'N'
                    --     )
                    -- )
                    -- AND NVL(CA.CANT_ANULADA, 0) < obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA, CA.ID)
                    -- /*WHERE obtener_cantidad_existente(CA.ID_ARTICULO, CA.ID_SUCURSAL, 'S') > 0 */
                    -- AND NVL(CA.NRO_OCC, '0') <> '0'
                    -- AND obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA, CA.ID) > 0
                      WHERE (
                                (CA.ID_ARTICULO IN (
                                     SELECT E.ID_ARTICULO
                                    FROM STW_EXISTENCIA_ART E
                                    WHERE E.ID_ARTICULO = CA.ID_ARTICULO
                                      AND (E.CANT_DISPON > 0 OR NVL(:P469_PERMISO_STOCK_NEGATIVO, 'N') = 'S')
                                )
                                OR EXISTS (
                                    SELECT 1
                                    FROM STW_ARTICULOS AR
                                    WHERE AR.ID = CA.ID_ARTICULO
                                    AND NVL(AR.IND_MANEJA_STOCK, 'S') = 'N'
                                ))
                                AND (
                                    -- Verificar si stock pendiente es positivo o el usuario tiene permiso para stock negativo S.C 26/03/2025
                                    (nvl(existencia_actual(ca.id_sucursal,ca.id_articulo,ca.id_empresa), 0) >= 0 or nvl(a.ind_maneja_stock, 'N') = 'N')
                                    OR NVL(:P469_PERMISO_STOCK_NEGATIVO, 'N') = 'S'
                                )
                            )
                            AND NVL(CA.CANT_ANULADA, 0) < obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA, ca.id)
                            AND NVL(CA.NRO_OCC, '0') <> '0' 
                            AND CA.ID_EMPRESA = T.ID_EMPRESA  
                            AND NVL(CA.ID_TIPO_ENTREGA,40) = T.ID
                            AND CA.ID_ARTICULO = A.ID
                            AND obtener_cantidad_pendiente(id_pedido, id_articulo, :P0_ID_EMPRESA, ca.id) > 0
                            AND NVL(CA.CANT_RESERVADA, 0) > 0)
                  WHERE CANTIDAD_PENDIENTE > 0
                ```
            pageItemsToSubmit: P469_PERMISO_STOCK_NEGATIVO
        }
