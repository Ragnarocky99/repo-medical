    region bloqueos (
        name: Bloqueos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       ID_SUCURSAL,
                       ID_ARTICULO,
                       CANT_BLOQUEO,
                       FEC_COMPROBANTE,
                       NRO_COMPROBANTE,
                       DESC_VENDEDOR,
                       DESC_CLIENTE,
                       Nro_Occ,
                       Fec_Occ
                  from STWV_ARTICULOS_BLOQUEO
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                   --- AND (ID_ARTICULO = :ID_ARTICULO)
                    AND CANT_BLOQUEO > 0
                ```
            pageItemsToSubmit: P0_ID_EMPRESA
        }
        layout {
            sequence: 30
            parentRegion: @detalle-de-autoriza-pedido
            slot: subRegions
        }
        appearance {
            template: @content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-ContentBlock--shadowBG
            ]
        }
        masterDetail {
            masterRegion: @detalle-de-autoriza-pedido
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13472479335673516
        }

