    pageItem P469_ID_SOPORTE (
        type: popupLov
        label {
            label: <p>Soporte:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT NVL(PS.NOMB_FANTASIA, PS.NOMBRE) SOPORTE,
                       PS.ID
                  FROM CCW_CLIENTES   CL
                  JOIN FVW_VENDEDORES VE ON VE.ID = CL.ID_VENDEDOR
                  JOIN BSW_PERSONAS   PS ON PS.ID = CL.ID_SOPORTE
                 WHERE (VE.ID = :P469_COD_VENDEDOR OR :P469_COD_VENDEDOR IS NULL)
                ```
            nullDisplayValue: --SIN SELECCIONAR--
        }
        cascadingLov {
            parentItems: P469_COD_VENDEDOR
            itemsToSubmit: P469_COD_VENDEDOR
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        source {
            used: always
        }
    )

