            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column MONTO (
            type: plainText
            heading {
                heading: Monto
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column NUMERO (
            type: link
            heading {
                heading: Numero
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            link {
                target: {
                    type: url
                    url: #URL#
                }
                linkText: #NUMERO#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column SERIE (
            type: plainText
            heading {
                heading: Serie
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column URL (
            type: hidden
            heading {
                heading: Url
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Inventario de Documentos
        }

        savedReport 212752 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BENEFICIARIO (
                sequence: 5
            )

            displayColumn ESTADO (
                sequence: 8
            )

            displayColumn FEC_REGISTRO (
                sequence: 1
            )

            displayColumn ID_MONEDA (
                sequence: 6
            )

            displayColumn MONTO (
                sequence: 7
            )

            displayColumn NUMERO (
                sequence: 4
            )

            displayColumn SERIE (
                sequence: 3
            )

            displayColumn TIPO (
                sequence: 2
            )

            sort (
                column: NUMERO
                sort {
                    sequence: 1
                }
            )

            highlight ir-condition (
                name: Anulado
                condition {
                    column: ESTADO
                    value: Anulado
                }
                colors {
                    background: #ffd6d2
                }
                execution {
