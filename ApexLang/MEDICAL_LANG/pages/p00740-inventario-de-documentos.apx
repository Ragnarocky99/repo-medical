    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction agregar-paginacion (
        name: Agregar Paginacion
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @inventario-de-documentos
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @inventario-de-documentos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P740_ID_TALONARIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @inventario-de-documentos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-datos (
        name: Setear Datos
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P740_ID_TALONARIO
        }

        action p740-ser-comprobante-p740-nro-timbrado-p740-num-inicial-p740-num-final-p740-banco (
            name: P740_SER_COMPROBANTE,P740_NRO_TIMBRADO,P740_NUM_INICIAL,P740_NUM_FINAL,P740_BANCO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SER_COMPROBANTE, NRO_TIMBRADO, NUM_INICIAL, NUM_FINAL, BANCO
                      FROM BSWV_TALONARIOS
                     WHERE ID = :P740_ID_TALONARIO
                    ```
                itemsToSubmit: P740_ID_TALONARIO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P740_SER_COMPROBANTE
                    P740_NRO_TIMBRADO
                    P740_NUM_INICIAL
                    P740_NUM_FINAL
                    P740_BANCO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

)

