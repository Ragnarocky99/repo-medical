page 740 (
    name: Inventario de Documentos
    alias: INVENTARIO-DE-DOCUMENTOS
    title: Inventario de Documentos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region inventario-de-documentos (
        name: Inventario de Documentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH TALONARIO AS (
                    SELECT ID,
                           SER_COMPROBANTE,
                           TIP_COMPROBANTE,
                           :P740_NUM_INICIAL NUM_INICIAL,
                           :P740_NUM_FINAL NUM_FINAL
                      FROM BSWV_TALONARIOS
                     WHERE ID = :P740_ID_TALONARIO
                ),
                RANGO_TALONARIO AS (
                    SELECT NUM_INICIAL + LEVEL - 1 AS NUMERO,
                           TIP_COMPROBANTE TIPO,
                           ID,
                           SER_COMPROBANTE SERIE
                    FROM TALONARIO
                    CONNECT BY LEVEL <= (NUM_FINAL - NUM_INICIAL + 1)
                    ORDER BY NUMERO
                )
                SELECT    CT.FEC_REGISTRO,
                          RT.TIPO,
                          RT.SERIE,
                          RT.NUMERO,
                          CT.BENEFICIARIO,
                          CT.ID_MONEDA,
                          CT.MONTO,
                          CASE
                            WHEN CT.ID IS NULL THEN
                                'Faltante'
                            WHEN CT.ANULADO = 'S' THEN
                                'Anulado'
                            ELSE
                                'Utilizado'
                          END ESTADO,
                          PREPARA_URL_CARGA(:P0_ID_EMPRESA, CT.TIP_COMPROBANTE, CT.ID_REGISTRO) URL
                  FROM    RANGO_TALONARIO   RT
                LEFT JOIN COMPROBANTES_TALONARIO CT ON
                          CT.ID = :P740_ID_TALONARIO AND
                          CT.NUMERO = RT.NUMERO
                 WHERE (CT.FEC_REGISTRO BETWEEN :P740_FEC_INI AND :P740_FEC_FIN OR :P740_FEC_INI IS NULL OR CT.FEC_REGISTRO IS NULL)
                   
                ```
            pageItemsToSubmit: [
                P740_ID_TALONARIO
                P740_FEC_INI
                P740_FEC_FIN
                P740_NUM_INICIAL
                P740_NUM_FINAL
            ]
            optimizerHint: WITH_PLSQL
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 20715229139591944
        }

        column BENEFICIARIO (
            type: plainText
            heading {
                heading: Cliente/Proveedor
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
