    pageItem P559_ID_BARRIO (
        type: popupLov
        label {
            label: <p>Barrio:</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION , ID FROM BSW_BARRIOS
                WHERE ID_PROVINCIA=:P559_ID_DEPARTAMENTO AND
                ID_CIUDAD=:P559_ID_CIUDAD
                ```
            displayExtraValues: false
            displayNullValue: false
