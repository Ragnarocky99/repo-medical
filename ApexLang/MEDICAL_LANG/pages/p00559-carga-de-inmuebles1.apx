    process unir-local-y-inmueble (
        name: Unir Local y Inmueble
        type: executeCode
        editableRegion: @unidades
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS='C' THEN 
                :ID_INMUEBLE:=:P559_ID;
                :ID_EMPRESA:=:P0_ID_EMPRESA;
                :ID_SUCURSAL:=:P0_ID_SUCURSAL;
                END IF;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
