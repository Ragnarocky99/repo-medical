page 559 (
    name: Carga de Inmuebles
    alias: CARGA-DE-INMUEBLES1
    title: Carga de Inmuebles
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:12.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region carga-de-inmuebles (
        name: Carga de Inmuebles
        type: form
        source {
            location: localDatabase
            tableName: ACW_INMUEBLES
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region datos (
        name: Datos
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @carga-de-inmuebles
            slot: regionBody
            column: 1
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region propietarios (
        name: Propietarios
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: ACW_INMUEBLES_PROPIETARIOS
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 250
        }
        advanced {
            savedReportMappingIdentifier: 88970646141519447
        }

        savedReport 893011 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_INMUEBLE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ID_PERSONA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: :APP_USER
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
                primaryKey: true
            }
            default {
                type: expression
                plsqlExpression: :P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_INMUEBLE (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_INMUEBLE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_PERSONA (
            type: popupLov
            heading {
                heading: <p>Propietario</p>
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lv-personas
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: ID_PERSONA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Propietarios
        }
    )

    region unidades (
        name: Unidades
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: ACW_LOCALES
            whereClause: ID_INMUEBLE=:P559_ID
