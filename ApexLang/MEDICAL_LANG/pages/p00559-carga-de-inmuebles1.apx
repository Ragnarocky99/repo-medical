    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: columns
            interactiveGrid: @unidades
            columns: VER
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unidades
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p559-cod-inmueble (
        itemName: P559_COD_INMUEBLE
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vcod_inmueble varchar2(5);
                
                begin
                SELECT MAX(TO_NUMBER(COD_INMUEBLE))+1 
                INTO VCOD_INMUEBLE
                FROM ACW_INMUEBLES
                WHERE ID_EMPRESA=:P0_ID_EMPRESA;
                RETURN VCOD_INMUEBLE;
                    EXCEPTION
                        WHEN OTHERS THEN
                            NULL;
                
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P559_ID
        }
    )

