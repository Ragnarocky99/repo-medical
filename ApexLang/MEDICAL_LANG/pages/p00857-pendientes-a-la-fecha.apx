page 857 (
    name: Pendientes a la fecha
    alias: PENDIENTES-A-LA-FECHA
    title: Pendientes a la fecha
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        headerAndFooter {
            footerText: &P857_FECHA.
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region inicio (
        name: Inicio
        type: cards
        source {
            location: localDatabase
            tableName: VISUALIZACION_INICIAL_RES
            whereClause: COD_USUARIO = :APP_USER
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @cards-container
            templateOptions: #DEFAULT#
        }
        card {
            cssClasses: &COLOR!ATTR.
        }
        title {
            column: TITULO
        }
        body {
            advancedFormatting: true
            htmlExpression: &HTML_BODY!RAW.
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No hay datos de cotizaciones/seguimiento
        }
    )

    pageItem P857_FECHA (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

    computation p857-fecha (
        itemName: P857_FECHA
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: expression
            plsqlExpression: SYSDATE
        }
    )

)

