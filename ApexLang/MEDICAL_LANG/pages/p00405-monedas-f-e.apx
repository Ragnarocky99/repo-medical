page 405 (
    name: Monedas F.E
    alias: MONEDAS-F-E
    title: Monedas F.E
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-2
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region carga-de-moneda-facturación-electrónica (
        name: Carga de Moneda Facturación Electrónica
        type: interactiveReport
        source {
            location: localDatabase
            tableName: FEW_MONEDAS
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 415
                items: {
                    P415_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 22653436125125636
        }

        column COD_MONEDA (
            type: plainText
            heading {
                heading: Cod Moneda
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Carga de Moneda Facturación Electrónica
        }

        savedReport 235199 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_MONEDA (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @carga-de-moneda-facturación-electrónica
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 415
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @carga-de-moneda-facturación-electrónica
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @carga-de-moneda-facturación-electrónica
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

