page 729 (
    name: Generacion Alternativa de Reparto
    alias: GENERACION-ALTERNATIVA-DE-REPARTO
    title: Generacion Alternativa de Reparto
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region detalles-a-generar (
        name: Detalles a Generar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  select sd.tip_comprobante,
                         sd.cod_usuario_aud,
                         decode(nvl(sd.ind_cancelado,'N'),'S','Si','N','No') ind_cancelado,
                         sd.nro_comprobante,
                         sd.direccion_envio,
                         decode(nvl(sd.estado,'PE'),'PE','Pendiente','CA','Cancelado','EN','Enviado') estado,
                         sd.fec_estado
                    from rpw_solicitud_reparto_det sd
                    join rpw_solicitud_reparto_cab sc on sc.id = sd.id_solicitud_rep_cab
                   where SC.ID IN (select column_value from apex_string.split(:P729_SELECTED_IDS,','))
                     and nvl(sd.ind_cancelado,'N') = 'N'
                     and nvl(sd.estado,'XY') != 'EN'
                     and not exists(
                     select 1
                       from rpw_reparto_detalle  rd
                       join rpw_reparto_cabecera rc on rc.id = rd.id_reparto_cabecera
                       where rd.id_solicitud_det = sd.id
                         and nvl(rc.estado,'N') = 'N' 
                     ); 
                ```
            pageItemsToSubmit: P729_SELECTED_IDS
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 69970440775301749
        }

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DIRECCION_ENVIO (
            type: plainText
            heading {
                heading: Direccion Envio
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column FEC_ESTADO (
            type: plainText
