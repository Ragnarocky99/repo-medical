    button generarreparto (
        buttonName: GenerarReparto
        label: Generar Reparto
        layout {
            sequence: 120
            region: @generacion-de-reparto
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P729_SELECTED_IDS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalles-a-generar
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process generar-reparto (
        name: Generar Reparto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  RPW_GENERA_REPARTO_ALTERNATIVO(P_ID_REPARTIDOR => :P729_ID_REPARTIDOR,
                                                 P_ID_VEHICULO => :P729_ID_VEHICULO,
                                                 P_ID_ACOMPANHANTE => :P729_ID_ACOMPANHANTE,
                                                 P_ID_ZONA => :P729_ID_ZONA,
                                                 P_ID_EMPRESA => :P0_ID_EMPRESA,
                                                 P_ID_SUCURSAL => :P0_ID_SUCURSAL,
                                                 P_COD_USUARIO_AUD => :APP_USER,
                                                 P_SELECTED_IDS => :P729_SELECTED_IDS,
                                                 P_ID_REPARTO => :P729_ID_REPARTO_OUT);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage:
                ```
                Exito. Se ha generado el reparto correctamente, sera redireccionado al reparto generado
                
                ```
        }
        advanced {
            executionMappingIdentifier: 69969371301301738
        }
    )

    branch (
        name: Ir a reparto
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 725
                items: {
                    P725_ID: &P729_ID_REPARTO_OUT.
                }
            }
        }
    )

)

