page 834 (
    name: Flujo de Efectivo Real
    alias: FLUJO-EFECTIVO-REAL
    title: Flujo de Efectivo Real
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @flujo-efectivo-real
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region flujo-efectivo-real (
        name: Flujo Efectivo Real
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select FEC_COMPROBANTE,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       COD_PERSONA,
                       PERSONA,
                       TIPO_PERSONA,
                       COD_CONCEPTO,
                       CONCEPTO,
                       CATEGORIA,
                       SUB_CATEGORIA,
                       TIPO_FACTURA,
                       NRO_FACTURA,
                       NRO_INTERNO_FAC,
                       MONEDA,
                       TIP_CAMBIO,
                       MONTO,
                       MONTO_GS,
                       FEC_VENCIMIENTO,
                       BENEFICIARIO,
                       IND_AFECTA_FLUJO,
                       ID_EMPRESA,
                       ID_PERSONA,
                       ID_REGISTRO,
                       PREPARA_URL_CARGA(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                         P_TIP_COMPROBANTE => TIP_COMPROBANTE,
                                         P_ID => ID_REGISTRO) URL,
                       ID_DETALLE_CAJA,
                       ID
                  from FCWV_FLUJO_EJECTIVO
                 where ID_EMPRESA = :P0_ID_EMPRESA AND
                FEC_VENCIMIENTO BETWEEN :P834_FEC_INI AND :P834_FEC_FIN AND
                (ID_PERSONA = :P834_ID_PERSONA OR :P834_ID_PERSONA IS NULL)
                ```
            pageItemsToSubmit: [
                P834_FEC_INI
                P834_FEC_FIN
                P834_ID_PERSONA
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 74349846157653134
        }

