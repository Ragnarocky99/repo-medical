    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @flujo-efectivo-real
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process flujo-efectivo-real-save-interactive-grid-data (
        name: Flujo Efectivo Real - Save Interactive Grid Data
        type: executeCode
        editableRegion: @flujo-efectivo-real
        source {
            plsqlCode:
                ```plsql
                IF :TIP_COMPROBANTE IN ('CAJ', 'OP') THEN
                    UPDATE CPW_VALORES_CAJAS
                       SET IND_AFECTA_FLUJO = :IND_AFECTA_FLUJO
                     WHERE ID = REGEXP_SUBSTR(:ID, '[0-9]+$');
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 74416239353994113
        }
    )

)

