page 192 (
    name: Conceptos de Compras
    alias: CONCEPTOS-DE-COMPRAS
    title: Conceptos de Compras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region conceptos-de-compra (
        name: Conceptos de Compra
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region conceptos-de-compras (
        name: Conceptos de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CC.ID,
                       CC.COD_CONCEPTO_COMP,
                       CC.DESCRIPCION,
                       CC.ABREVIATURA,
                       CC.ID_EMPRESA,
                       CC.COD_USUARIO_AUD,
                       CC.ID_CUENTA,
                       TD.DESCRIPCION CATEGORIA,
                       ST.DESCRIPCION SUB_CATEGORIA,
                       DECODE(CC.IND_ACTIVO, 'N', 'No',
                                             'S', 'Si') ACTIVO,
                       CASE
                        WHEN CC.IND_ACTIVO = 'S' THEN 'fa fa-check u-success-text'
                        WHEN CC.IND_ACTIVO = 'N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON
                  from CPW_CONCEPTOS_COMPRAS CC
                 left join FCW_TIP_DENOMINACIONES TD on TD.ID = CC.ID_TIP_DENOMINACION
                 left join FCW_SUBTIP_DENOMINACIONES_CAB ST on ST.ID = CC.ID_SUBTIP_DENOMINACION
                  where CC.id_empresa=:P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 193
                items: {
                    P193_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 39780829224285095
        }

        column ABREVIATURA (
            type: plainText
            heading {
                heading: Abreviatura
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 48
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ACTIVO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ACTIVO_ICON (
            type: hidden
            heading {
                heading: Activo Icon
            }
            layout {
                sequence: 58
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CATEGORIA (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 28
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COD_CONCEPTO_COMP (
            type: plainText
            heading {
                heading: Código del Concepto
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Código del Usuario
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_CUENTA (
            type: plainTextBasedOnLov
            heading {
                heading: Cuenta
                alignment: center
            }
            lov {
                lov: @lv-cuentas-contables-asentable
            }
            layout {
                sequence: 8
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_EMPRESA (
            type: plainText
            heading {
                heading: Id Empresa
                alignment: center
            }
            layout {
                sequence: 18
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column SUB_CATEGORIA (
            type: plainText
            heading {
                heading: Sub Categoria
                alignment: center
            }
            layout {
                sequence: 38
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText: Conceptos de Compras
        }

        savedReport 397859 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ABREVIATURA (
                sequence: 3
            )

            displayColumn ACTIVO (
                sequence: 8
            )

            displayColumn CATEGORIA (
                sequence: 6
            )

            displayColumn COD_CONCEPTO_COMP (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 4
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ID_CUENTA (
                sequence: 5
            )

            displayColumn SUB_CATEGORIA (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @conceptos-de-compras
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 193
                clearCache: 193
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @conceptos-de-compras
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @conceptos-de-compras
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

