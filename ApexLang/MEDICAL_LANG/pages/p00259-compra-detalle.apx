        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
    )

    pageItem P259_FECHA_FIN (
        type: datePicker
        label {
            label: <p>Hasta la fecha:</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem P259_FECHA_INI (
        type: datePicker
        label {
