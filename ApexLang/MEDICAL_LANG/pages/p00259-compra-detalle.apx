    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P259_FECHA_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P259_FECHA_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P259_FECHA_FIN,'/','');
                            conv_fecha := substr(:P259_FECHA_FIN,1,2)||'/'||
                                                      substr(:P259_FECHA_FIN,3,2)||'/'||
                                                      lpad(substr(:P259_FECHA_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P259_FECHA_FIN := conv_fecha;
                            ELSIF (length(:P259_FECHA_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P259_FECHA_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P259_FECHA_FIN
                itemsToReturn: P259_FECHA_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P259_FECHA_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P259_FECHA_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P259_FECHA_INI,'/','');
                            conv_fecha := substr(:P259_FECHA_INI,1,2)||'/'||
                                                      substr(:P259_FECHA_INI,3,2)||'/'||
                                                      lpad(substr(:P259_FECHA_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P259_FECHA_INI := conv_fecha;
                            ELSIF (length(:P259_FECHA_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P259_FECHA_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P259_FECHA_INI
                itemsToReturn: P259_FECHA_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar (
        name: LIMPIAR
        type: clearSessionState
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 58603563040018230
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    branch (
        name: Go To Page 262
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 262
                items: {
                    P259_FECHA_INI: &P259_FECHA_INI.
                    P259_FECHA_FIN: &P259_FECHA_FIN.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

