        type: popupLov
        label {
            label: <p>Articulo:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-articulos
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

