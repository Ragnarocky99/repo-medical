page 259 (
    name: Compra Detalle
    alias: COMPRA-DETALLE
    title: Compra Detalle
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region compra-detalle (
        name: Compra Detalle
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT TIP_COMPROBANTE,
                       NRO_COMPROBANTE,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       CANTIDAD_UB,
                       MONTO_TOTAL,
                       TOTAL_IVA,
                       MONTO_TOTAL_C_IVA,
                       DESC_PRO,
                       COD_PRO,
                       FEC_COMPROBANTE,
                       SER_COMPROBANTE,
                       SER_TIMBRADO,
                       NRO_OCP_EMB,
                       NRO_LOTE,
                       TRIPTICO,
                       FEC_TRIPTICO,
                       IND_CONTROLADO,
                       PRESENTACION,
                       UNIDAD_MEDIDA,
                       PORC_IMP,
                       MONEDA,
                       RUBRO_ARTICULO
                
                FROM CMWV_COMPRAS_DETALLE
                WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  AND FEC_COMPROBANTE BETWEEN :P259_FECHA_INI AND :P259_FECHA_FIN
                  AND (ID_ARTICULO = :P259_ARTICULO OR :P259_ARTICULO IS NULL) 
                  AND (ID_PROVEEDOR = :P259_PROVEEDOR OR :P259_PROVEEDOR IS NULL) 
                  AND (NVL(IND_CONTROLADO,'N') = :P259_CONTROLADO OR :P259_CONTROLADO IS NULL)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 59415232604564345
        }

