    process guardar-seleccion (
        name: Guardar Seleccion
        type: executeCode
        editableRegion: @seguimiento-presupuesto
        source {
            plsqlCode:
                ```plsql
                IF :IND_SELECCION = 'S' THEN
                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'COL_SEGUIMIENTO_PRESUPUESTO',
                                               P_N001            => :ID_PEDIDO,
                                               P_N002            => :ID_PEDIDO_DET,
                                               P_N003            => :ID_COTIZA_ART,
                                               P_N004            => :ID_ARTICULO,
                                               P_N005            => :ID_APROBACION_LIC);
                END IF;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 102945898384690015
        }
        serverSideCondition {
            type: request=Value
            value: SEGUI
        }
    )

