    region pendiente-vencido (
        name: Pendiente Vencido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with cantidades_externas as(
                    select greatest(OBTENER_CANTIDAD_PENDIENTE(P_ID_PEDIDO  => ca.ID_PEDIDO /*IN NUMBER*/,
                                               P_ID_ARTICULO  => ca.ID_ARTICULO/*IN NUMBER*/,
                                               P_ID_EMPRESA  => ca.ID_EMPRESA/*IN NUMBER*/,
                                               P_ID  => ca.ID /*IN NUMBER*/) - nvl(ca.cant_anulada,0),0)
                                               as pendiente,
                             nvl((SELECT SUM(D1.CANTIDAD)
                             FROM STW_ENTSAL_CAB C1,
                                STW_ENTSAL_DET D1
                                WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                AND C1.ID = D1.ID_ENTSAL_CAB
                                AND NVL(C1.ESTADO, 'N') != 'A'
                                AND D1.ID_ARTICULO = ca.ID_ARTICULO
                                AND D1.ID_PEDIDO_DETALLE = ca.ID_PEDIDO_DET),0) as remisionada,               
                                ca.id
                    from cmw_cotiza_articulos ca
                ),
                cantidades_internas as (
                    select ca.ID,     
                    nvl(ca.CANTIDAD_APROBADA,0) as aprobada,
                    nvl(ca.CANT_ANULADA,0)    as anulada,
                    case 
                        when ca.cant_anulada = ca.cantidad_aprobada then 0
                        when ce.pendiente = 0 and ce.remisionada = 0 then nvl(ca.CANTIDAD_APROBADA,0)-nvl(ca.cant_anulada,0)
                        when ca.cantidad_entregada > ca.cantidad_aprobada then nvl(ca.cantidad_aprobada,0)-nvl(ca.cant_anulada,0)     
                        else nvl(ca.CANTIDAD_ENTREGADA,0)
                    end as entregada
                    from CMW_COTIZA_ARTICULOS ca
                    join CANTIDADes_EXTERNAS ce on ca.id = ce.id
                ),
                datos as (
                    select
                         ce.id,
                        case ci.aprobada
                         when ci.anulada then 'Anulado'
                         when ci.entregada+ci.anulada then 'Entregado'
                         when ce.remisionada then 'Remisión'
                         else 'Pendiente'
                        end as estado_occ,
                        ci.entregada,
                        ce.pendiente
                    from CANTIDADes_EXTERNAS ce 
                    join cantidades_internas ci on ce.id = ci.id 
                )
                
                select S.ID,
                       S.ID_EMPRESA,
                       S.DEFINICION,
                       S.FEC_PROX_EVENTO,
                       S.OBSERVACION,
                       S.ID_PEDIDO,
                       P.NRO_COMPROBANTE,
                       S.FEC_CARGA,
                       S.COD_USU_AUD,
                       S.RESPONSABLE,
                       S.ID_ARTICULO,
                       S.ID_PEDIDO_DET,
                       OBTENER_ESTADO_OCP_CRM(C.ID,S.ID_ARTICULO,C.ID_PEDIDO,C.ID_PEDIDO_DET) AS ESTADO_OCP,
                       obtener_ocp(C.ID_PEDIDO, C.ID_EMPRESA, C.ID_ARTICULO ) NRO_OCP,
                       C.NRO_OCC,
                       C.NRO_ITEM,
                       A.DESCRIPCION AS DESC_ART,
                       A.COD_ORIGEN_ART,
                       A.ID_ENVASE,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MARCA,
                       C.ID_TIPO_ENTREGA,
                       PER.NOMBRE AS CLIENTE,
                       C.CANTIDAD_APROBADA, 
                       nvl(CPD.Cantidad - NVL((SELECT SUM(CD.CANTIDAD)
                                                    FROM CMW_COMPRAS_DETALLE CD
                                                   WHERE /*CD.ID_PEDIDO_CAB = PC.ID 
                                                     and */CD.Id_Articulo = A.Id 
                                                     and cd.id_pedido_det = cpd.id), 0) - NVL(CPD.Cantidad_Anulada, 0),c.cantidad_aprobada) as CANTIDAD_PENDIENTE_OCP,
                       datos.pendiente cantidad_pendiente_occ,
                       C.FEC_OCC,
                       datos.estado_occ ESTADO_OCC,
                       C.FEC_OCC+T.NRO_DIAS FECHA_PLAZO,
                         case 
                           when datos.estado_occ = 'Pendiente' AND TO_DATE((C.FEC_OCC+T.NRO_DIAS),'DD/MM/YYYY') < TO_DATE(SYSDATE,'DD/MM/YYYY') THEN
                             'VENCIDO'
                           ELSE 
                             'EN TIEMPO'
                         END AS ESTADO_PRODUCTO , 
                       TRUNC((C.FEC_OCC + T.NRO_DIAS)) - TRUNC(SYSDATE) AS DIAS_PASADOS,  
                       datos.entregada CANTIDAD_ENTREGADA,
                       case 
                        when cpd.id is null then 'Sin Proveedor'
                        else PPR.Nombre
                       end as Proveedor,
                       (SELECT CPC.FEC_COMPROBANTE
                          FROM CMW_PEDIDOS_CABECERA CPC
                         WHERE CPC.ID_EMPRESA = C.ID_EMPRESA
                           AND CPC.ID = CPD.ID_PEDIDO_CAB ) FECHA_OCP
                
                  from CLW_ACCIONES_SEGUI S,
                       CMW_COTIZA_ARTICULOS C,
                       VTW_PEDIDOS_CABECERA P,
                       STW_ARTICULOS        A,
                       CCW_CLIENTES         CL,
                       BSW_PERSONAS         PER,
                       CMW_PEDIDOS_DETALLE  CPD,
                      --- CMW_PEDIDOS_CABECERA CPC,
                       datos                DATOS,
                       CMW_TIPO_ENTREGA     T,
                       CMW_PROVEEDORES      PR,
                       BSW_PERSONAS         PPR
                
                where S.ID_EMPRESA = :P0_ID_EMPRESA
                  AND S.ID_EMPRESA = C.ID_EMPRESA
                  AND S.ID_EMPRESA = C.ID_EMPRESA
                  AND S.ID_EMPRESA = P.ID_EMPRESA
                  AND S.ID_PEDIDO = P.ID(+)
                  AND S.ID_PEDIDO = C.ID_PEDIDO
                  AND S.ID_PEDIDO_DET = C.ID_PEDIDO_DET
                  AND S.ID_ARTICULO = C.ID_ARTICULO
                  AND C.ID_ARTICULO = A.ID
                  AND P.ID_CLIENTE = CL.ID
                  AND CL.ID_PERSONA = PER.ID
                  
                  AND CPD.ID_PEDIDO(+) = P.ID
                  AND CPD.ID_ARTICULO(+) = A.ID
                  AND CPD.ID_COTIZA_ART(+) = C.ID
                  AND datos.id = c.id
                  AND NVL(C.ID_TIPO_ENTREGA,'40') = T.ID
                  AND C.ID_PROVEEDOR = PR.ID(+)
                  AND PR.ID_PERSONA = PPR.ID(+)
                 --- and p.nro_comprobante = '1212'
                 --- AND S.RESPONSABLE = '438'
                  AND (S.RESPONSABLE =
                       (select id from bsw_usuarios U where u.cod_usuario = :APP_USER) or :APP_USER IN ('LCOUCH','INV'))
                  AND S.FEC_PROX_EVENTO <= SYSDATE
                 --- AND   S.ID_PEDIDO  = '574'
                  AND (C.NRO_OCC IS NOT NULL AND C.NRO_OCC <> '0')
                  AND OBTENER_ESTADO_OCP_CRM(C.ID,S.ID_ARTICULO,C.ID_PEDIDO,C.ID_PEDIDO_DET) = 'PENDIENTE'
                  AND (S.ID = (select max(id) from CLW_ACCIONES_SEGUI CI where CI.id_pedido = S.id_pedido
                  and CI.id_articulo = S.id_articulo) or S.ID is null)
                  AND (S.FEC_PROX_EVENTO = (select max(ci.FEC_PROX_EVENTO)
                                              from CLW_ACCIONES_SEGUI ci
                                            where ci.ID_EMPRESA = s.id_empresa
                                            AND   ci.ID_PEDIDO  = s.id_pedido) )
                  AND datos.estado_occ = 'Pendiente'
                  /*AND (S.FEC_CARGA,S.ID_PEDIDO,S.ID_PEDIDO_DET,S.RESPONSABLE,S.ID_ARTICULO) = (select MAX(S1.FEC_CARGA),
                                                                                                      S1.ID_PEDIDO,
                                                                                                      S1.ID_PEDIDO_DET,
                                                                                                      S1.RESPONSABLE,
                                                                                                      S1.ID_ARTICULO
                                                                                                from CLW_ACCIONES_SEGUI S1,
                                                                                                     CMW_COTIZA_ARTICULOS C1,
                                                                                                     VTW_PEDIDOS_CABECERA P1
                                                                                              where S1.ID_EMPRESA = :P0_ID_EMPRESA
                                                                                                AND S1.ID_EMPRESA = C1.ID_EMPRESA
                                                                                                AND S1.ID_EMPRESA = P1.ID_EMPRESA
                                                                                                AND S1.ID_PEDIDO = P1.ID(+)
                                                                                                AND S1.ID_PEDIDO = C1.ID_PEDIDO
                                                                                                AND S1.ID_PEDIDO_DET = C1.ID_PEDIDO_DET
                                                                                                AND S1.ID_ARTICULO = C1.ID_ARTICULO
                                                                                               --- AND S.RESPONSABLE = '438'
                                                                                               ---- AND (S.RESPONSABLE = :P635_RESPONSABLE OR :P635_RESPONSABLE = '1')
                                                                                                AND S1.FEC_PROX_EVENTO <= SYSDATE
                                                                                                ---AND   S.ID_PEDIDO  = '574'
                                                                                                AND (C1.NRO_OCC IS NOT NULL AND C1.NRO_OCC <> '0')
                                                                                                AND OBTENER_ESTADO_OCP_CRM(C1.ID,S.ID_ARTICULO,C1.ID_PEDIDO,C1.ID_PEDIDO_DET) = 'PENDIENTE'
                                                                                                AND ROWNUM = 1
                                                                                              GROUP BY S1.ID_PEDIDO,S1.ID_PEDIDO_DET,S1.RESPONSABLE,S1.ID_ARTICULO)*/
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size720x480
