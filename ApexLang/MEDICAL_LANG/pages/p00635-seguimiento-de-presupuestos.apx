        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --RAISE_APPLICATION_ERROR(-20000, 'APROBACIONES '||:P635_ID_APROBACIONES);
                    :P635_ID_PEDIDOS         := SUBSTR(:P635_ID_PEDIDOS, 1, LENGTH(:P635_ID_PEDIDOS) - 1);
                    :P635_ID_ARTICULOS       := SUBSTR(:P635_ID_ARTICULOS, 1, LENGTH(:P635_ID_ARTICULOS) - 1);
                    :P635_ID_PEDIDO_DETALLES := SUBSTR(:P635_ID_PEDIDO_DETALLES, 1, LENGTH(:P635_ID_PEDIDO_DETALLES) - 1);
                    :P635_ID_COTIZA_ARTS     := SUBSTR(:P635_ID_COTIZA_ARTS, 1, LENGTH(:P635_ID_COTIZA_ARTS) - 1);
                    :P635_ID_OFERTAS         := SUBSTR(:P635_ID_OFERTAS, 1, LENGTH(:P635_ID_OFERTAS) - 1);
                    :P635_ID_APROBACIONES    := SUBSTR(:P635_ID_APROBACIONES, 1, LENGTH(:P635_ID_APROBACIONES) - 1);
                    
                    
                    ```
                itemsToSubmit: [
                    P635_ID_PEDIDOS
                    P635_ID_ARTICULOS
                    P635_ID_PEDIDO_DETALLES
                    P635_ID_COTIZA_ARTS
                    P635_ID_OFERTAS
                    P635_ID_APROBACIONES
                ]
                itemsToReturn: [
                    P635_ID_PEDIDOS
                    P635_ID_ARTICULOS
                    P635_ID_PEDIDO_DETALLES
                    P635_ID_COTIZA_ARTS
                    P635_ID_OFERTAS
                    P635_ID_APROBACIONES
