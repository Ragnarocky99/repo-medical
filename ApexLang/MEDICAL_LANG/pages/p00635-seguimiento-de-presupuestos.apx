        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Seguimiento Presupuesto
        }
    )

    pageItem P635_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: ---Sin Seleccionar--
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

