    region seguimiento-presupuesto (
        name: Seguimiento Presupuesto
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CLWV_SEGUIMIENTO_PRESUPUESTO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (FEC_OCC BETWEEN :P635_FEC_OCC_DESDE AND :P635_FEC_OCC_HASTA OR (:P635_FEC_OCC_DESDE IS NULL AND :P635_FEC_OCC_HASTA IS NULL)) AND
                (FEC_PROX_EVENTO BETWEEN :P635_FEC_EVENTO_INI AND :P635_FEC_EVENTO_FIN OR (:P635_FEC_EVENTO_INI IS NULL AND :P635_FEC_EVENTO_FIN IS NULL)) AND
                (NRO_OCC = :P635_NRO_OCC OR :P635_NRO_OCC IS NULL) AND
                (ESTADO_OCC = :P635_ESTADO_OCC OR :P635_ESTADO_OCC IS NULL) AND
                (ID_CLIENTE = :P635_CLIENTE OR :P635_CLIENTE IS NULL) AND
                (ID_VENDEDOR = :P635_VENDEDOR OR :P635_VENDEDOR IS NULL) AND
                (NIVEL_CLIENTE = :P635_NIVEL_CLIENTE OR :P635_NIVEL_CLIENTE IS NULL) AND
                (ID_PROVEEDOR = :P635_COD_PROVEEDOR OR :P635_COD_PROVEEDOR IS NULL) AND
                (ID_SOPORTE = :P635_ID_SOPORTE OR :P635_ID_SOPORTE IS NULL) AND
                (NRO_OCP = :P635_NRO_OCP OR :P635_NRO_OCP IS NULL) AND
                (ESTADO_OCP = :P635_ESTADO_OCP OR :P635_ESTADO_OCP IS NULL) AND
                (NRO_COMPROBANTE = :P635_NRO_PEDIDO OR :P635_NRO_PEDIDO IS NULL) AND
                (ID_RESPONSABLE = :P635_RESPONSABLE OR :P635_RESPONSABLE IS NULL) AND
                (ID_ARTICULO = :P635_ID_ARTICULO OR :P635_ID_ARTICULO IS NULL) AND
                (ID_DEFINICION MEMBER OF APEX_STRING.SPLIT_NUMBERS(:P635_DEFINICION, ':') OR :P635_DEFINICION IS NULL)
                
                ```
            pageItemsToSubmit: [
                P635_FEC_OCC_DESDE
                P635_FEC_OCC_HASTA
                P635_NRO_OCC
                P635_ESTADO_OCC
                P635_FEC_EVENTO_INI
                P635_FEC_EVENTO_FIN
                P635_CLIENTE
                P635_VENDEDOR
                P635_NIVEL_CLIENTE
                P635_COD_PROVEEDOR
                P635_ID_SOPORTE
                P635_NRO_OCP
                P635_ESTADO_OCP
                P635_NRO_PEDIDO
                P635_RESPONSABLE
                P635_DEFINICION
                P635_ID_ARTICULO
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 204683323319477744
        }

