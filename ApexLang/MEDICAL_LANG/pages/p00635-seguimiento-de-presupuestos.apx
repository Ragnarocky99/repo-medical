        action refrescamos-la-vista-materializada (
            name: Refrescamos la vista materializada
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       v_sql VARCHAR2(200);
                    BEGIN
                       -- Construct the anonymous PL/SQL block as a string
                       v_sql := 'BEGIN DBMS_MVIEW.REFRESH(''CMWMV_SEGUIMIENTO_PRESUPUESTO''); END;';
                    
                       -- Execute the PL/SQL block
                       EXECUTE IMMEDIATE v_sql;
                    
                    EXCEPTION
                       WHEN OTHERS THEN
                          RAISE_APPLICATION_ERROR(-20000, 'Error refreshing materialized view: ' || SQLERRM);
                    END;
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

