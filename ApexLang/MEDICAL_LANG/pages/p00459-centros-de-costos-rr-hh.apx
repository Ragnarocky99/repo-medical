page 459 (
    name: Centros de Costos RR.HH.
    alias: CENTROS-DE-COSTOS-RR-HH
    title: Centros de Costos RR.HH.
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region centros-de-costos (
        name: Centros de Costos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CR.ID,
                       CR.ID_EMPRESA,
                       CR.COD_CENTRO,
                       CR.ID_SUCURSAL,
                       CR.DESCRIPCION,
                       CR.COD_USUARIO_AUD
                FROM RHW_CENTROS_COSTOS CR
                WHERE CR.ID_EMPRESA = :P0_ID_EMPRESA
                ```
            pageItemsToSubmit: P0_ID_EMPRESA
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 460
                items: {
                    P460_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 52229054073906824
        }

        column COD_CENTRO (
            type: plainText
            heading {
                heading: Cód. de Centro
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Centros de Costos
        }

        savedReport 530414 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CENTRO (
                sequence: 3
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 6
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn ID_SUCURSAL (
                sequence: 5
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @centros-de-costos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 460
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction onclose-dialog (
        name: ONCLOSE_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @centros-de-costos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @centros-de-costos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

