page 167 (
    name: Carga de Anulacion de Comprobantes de Ventas
    alias: CARGA-DE-ANULACION-DE-COMPROBANTES-DE-VENTAS
    title: Carga de Anulacion de Comprobantes de Ventas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P167_TIP_COMPROBANTE").readOnly = true;
            document.getElementById("P167_SER_COMPROBANTE").readOnly = true;
            document.getElementById("P167_NRO_TIMBRADO").readOnly = true;
            document.getElementById("P167_NRO_COMPROBANTE").readOnly = true;
            document.getElementById("P167_ID_CLIENTE").readOnly = true;
            document.getElementById("P167_ID_VENDEDOR").readOnly = true;
            document.getElementById("P167_TOT_COMPROBANTE").readOnly = true;
            document.getElementById("P167_FEC_COMPROBANTE").readOnly = true;
            
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-anulacion-de-comprobantes-de-ventas (
        name: Carga de Anulacion de Comprobantes de Ventas
        type: form
        source {
            location: localDatabase
            tableName: VTW_COMPROBANTES_CABECERA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
        }
        advanced {
            htmlDomId: CargaAnulacion
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

