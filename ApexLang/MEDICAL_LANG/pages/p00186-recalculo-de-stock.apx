    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P186_FEC_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P186_FEC_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P186_FEC_FIN,'/','');
                            conv_fecha := substr(:P186_FEC_FIN,1,2)||'/'||
                                                      substr(:P186_FEC_FIN,3,2)||'/'||
                                                      lpad(substr(:P186_FEC_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P186_FEC_FIN := conv_fecha;
                            ELSIF (length(:P186_FEC_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P186_FEC_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P186_FEC_FIN
                itemsToReturn: P186_FEC_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P186_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P186_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P186_FEC_INI,'/','');
                            conv_fecha := substr(:P186_FEC_INI,1,2)||'/'||
                                                      substr(:P186_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:P186_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P186_FEC_INI := conv_fecha;
                            ELSIF (length(:P186_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P186_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P186_FEC_INI
                itemsToReturn: P186_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ejecutar (
        name: ejecutar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @recalcularstock
        }

        action native-alert (
            action: alert
            settings {
                message: &P186_MENSAJE_PROCEDIMIENTO.
                style: information
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    let timerInterval
                    Swal.fire({
                      title: 'Espere porfavor...',
                      html: 'No cierre la ventana del navegador',
                      timer: 5000,
                      timerProgressBar: true,
                      didOpen: () => {
                        Swal.showLoading()
                        timerInterval = setInterval(() => {
                          const content = Swal.getHtmlContainer()
                          if (content) {
                            const b = content.querySelector('b')
                            if (b) {
                              b.textContent = Swal.getTimerLeft()
                            }
                          }
                        }, 100)
                      },
                      willClose: () => {
                        clearInterval(timerInterval)
                      }
                    }).then((result) => {
                      /* Read more about handling dismissals below */
                      if (result.dismiss === Swal.DismissReason.timer) {
                        //console.log('I was closed by the timer')
                      }
                    })
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if(apex.item("EJECUTAR").getValue() == 'Pago realizado satisfactoriamente.'){
                    Swal.fire(
                      apex.item("EJECUTAR").getValue(),
                      '',
                      'success'
                    )
                    }else{
                    Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: apex.item("EJECUTAR").getValue(),
                      //footer: '<a href>Why do I have this issue?</a>'
                    })
                    }
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @existencia-art
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerColor: #647edc
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action recalculo-stock (
            name: RECALCULO_STOCK
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        V_MENSAJE VARCHAR(250);
                    BEGIN
                        stw_recalcula_stock(p_id_empresa => :P0_ID_EMPRESA,
                                          p_id_sucursal => :P186_SUCURSAL,
                                          p_id_articulo => :P186_ARTICULOS,
                                          p_id_linea => NULL,
                                          p_id_marca => :P186_MARCA,
                                          p_id_origen => NULL,
                                          p_fec_inicial => :P186_FEC_INI,
                                          p_fec_final => :P186_FEC_FIN,
                                          pmensaje => V_MENSAJE);
                    
                        :P186_MENSAJE_PROCEDIMIENTO := V_MENSAJE;
                    /*EXCEPTION
                        WHEN OTHERS THEN
                        :P186_MENSAJE_PROCEDIMIENTO := SQLERRM;*/
                    END;
                    ```
                itemsToSubmit: [
                    P186_MENSAJE_PROCEDIMIENTO
                    P186_FEC_INI
                    P186_FEC_FIN
                    P0_ID_EMPRESA
                    P186_SUCURSAL
                    P186_ARTICULOS
                    P186_MARCA
                ]
                itemsToReturn: P186_MENSAJE_PROCEDIMIENTO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: refresh_grid
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @existencia-art
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid-2 (
