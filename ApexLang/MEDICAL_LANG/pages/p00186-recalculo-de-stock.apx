page 186 (
    name: Recalculo de Stock
    alias: RECALCULO-DE-STOCK
    title: Recalculo de Stock
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region existencia-art (
        name: Existencia Art.
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_ARTICULO,
                       ID_SUCURSAL,
                       CANT_DISPON,
                       --CANT_BLOQUEO,
                       FEC_ULTIMO_INVENT,
                       --CANT_MINIMA,
                       --CANT_MAXIMA,
                       ID_EMPRESA,
                       --SER_ARTICULO,
                       --COD_USUARIO_AUD,
                       --ID_UNIDAD_MEDIDA,
                       ID_LOTE
                from STW_EXISTENCIA_ART
                where (id_sucursal = :P186_SUCURSAL or :P186_SUCURSAL is null)
                  and (id_articulo = :P186_ARTICULOS or :P186_ARTICULOS is null)
                  and (id_lote     = :P186_LOTE or :P186_LOTE is null)
                ```
            pageItemsToSubmit: [
                P186_LOTE
                P186_SUCURSAL
                P186_ARTICULOS
            ]
        }
        layout {
            sequence: 10
            parentRegion: @recalculo-de-stock
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 139906482674662875
        }

        column CANT_DISPON (
            type: plainText
            heading {
                heading: Cant. Disponible
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column FEC_ULTIMO_INVENT (
            type: hidden
            heading {
                heading: Ultimo Invent
            }
            layout {
                sequence: 100
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_ARTICULO (
            type: plainTextBasedOnLov
            heading {
                heading: Artículo
                alignment: center
            }
            lov {
                lov: @lv-articulos
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_LOTE (
            type: plainTextBasedOnLov
            heading {
                heading: Lote
                alignment: center
            }
            lov {
                lov: @lv-lotes-racalc
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Existencia Art.
        }

        savedReport 88081 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANT_DISPON (
                sequence: 4
            )

            displayColumn ID_ARTICULO (
                sequence: 2
            )

            displayColumn ID_LOTE (
                sequence: 3
            )

            displayColumn ID_SUCURSAL (
                sequence: 1
            )

        )

    )

