page 731 (
    name: Solicitudes de Reparto Canceladas
    alias: SOLICITUDES-DE-REPARTO-CANCELADAS
    title: Solicitudes de Reparto Canceladas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region solicitudes-de-reparto-canceladas (
        name: Solicitudes de Reparto Canceladas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sc.id as nro_solicitud,
                       sc.fecha_solicitud,
                       sc.id_cliente,
                       sc.id_proveedor,
                       sc.observacion,
                       sd.tip_comprobante,
                       sd.nro_comprobante,      
                       to_char(sd.fec_estado,'dd/MM/yyyy hh24:mi:ss') fecha_cancelacion,
                       sc.comentario
                from rpw_solicitud_reparto_det sd
                join rpw_solicitud_reparto_cab sc on sc.id = sd.id_solicitud_rep_cab
                where sd.ind_cancelado = 'S'
                order by sc.id desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 12393774220311154
        }

        column COMENTARIO (
            type: plainText
            heading {
                heading: Comentario
                alignment: center
            }
            layout {
                sequence: 27
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column FECHA_CANCELACION (
            type: plainText
            heading {
                heading: Fecha Cancelacion
                alignment: center
            }
            layout {
                sequence: 17
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column FECHA_SOLICITUD (
            type: plainText
            heading {
                heading: Fecha Solicitud
            }
            layout {
                sequence: 2
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_CLIENTE (
            type: plainTextBasedOnLov
            heading {
                heading: Cliente
                alignment: center
            }
            lov {
                lov: @lv-clientes
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_PROVEEDOR (
            type: plainTextBasedOnLov
