                heading: Proveedor
                alignment: center
            }
            lov {
                lov: @lv-proveedores
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro Comprobante
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column NRO_SOLICITUD (
            type: plainText
            heading {
                heading: Nro Solicitud
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column OBSERVACION (
            type: plainText
            heading {
                heading: Observacion
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
