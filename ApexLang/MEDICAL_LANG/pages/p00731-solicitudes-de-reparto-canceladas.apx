            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Solicitudes de Reparto Canceladas
        }

        savedReport 123973 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMENTARIO (
                sequence: 6
            )

            displayColumn FECHA_CANCELACION (
                sequence: 9
