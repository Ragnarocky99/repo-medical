page 407 (
    name: Carga de Tipos de Pago
    alias: CARGA-DE-TIPOS-DE-PAGO1
    title: Carga de Tipos de Pago
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tipos-de-pago (
        name: Carga de Tipos de Pago
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: SELECT ID, TIP_PAGO, DESCRIPCION FROM FEW_TIPOS_PAGOS;
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P407_DESCRIPCION (
        type: textarea
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-tipos-de-pago
            slot: regionBody
            alignment: left
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-tipos-de-pago
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P407_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipos-de-pago
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-pago
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P407_TIP_PAGO (
        type: textField
        label {
            label: <p>Tipo de Pago: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
            disabled: true
        }
        layout {
            sequence: 20
            region: @carga-de-tipos-de-pago
            slot: regionBody
            alignment: left
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-tipos-de-pago
            column: TIP_PAGO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P407_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P407_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P407_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p407-tip-pago (
        itemName: P407_TIP_PAGO
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P407_TIP_PAGO is null then
                      select nvl(max(to_number(TIP_PAGO)), 0) + 1
                         into v_numero
                         from FEW_TIPOS_PAGOS;
                       RETURN v_numero;
                      end if; 
                      RETURN :P407_TIP_PAGO;
                   exception
                      when no_data_found then
                        :P407_TIP_PAGO  := 1 ;
                        RETURN :P407_TIP_PAGO;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Tipos de Comprobantes' || sqlerrm ) ;
                   end ;
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 23126934942204037
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tipos-de-pago (
        name: Initialize form Carga de Tipos de Pago
        type: formInitialization
        formRegion: @carga-de-tipos-de-pago
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 23126133952204037
        }
    )

    process process-form-carga-de-tipos-de-pago (
        name: Process form Carga de Tipos de Pago
        type: formAutoRowProcessing
        formRegion: @carga-de-tipos-de-pago
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23126507315204037
        }
    )

)

