page 738 (
    name: Plazos por Proveedor
    alias: PLAZOS-POR-PROVEEDOR
    title: Plazos por Proveedor
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region plazos-por-proveedor (
        name: Plazos por Proveedor
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CMW_HISTORICO_COTIZA_AUTO_PLAZOS
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 19090744344912081
        }

        savedReport 190912 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_PROVEEDOR
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @PLAZO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 4
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: :P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_PROVEEDOR (
            type: popupLov
            heading {
                heading: <p>Proveedor</p>
                alignment: center
            }
            settings {
                displayAs: modalDialog
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-proveedores
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_PROVEEDOR
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column PLAZO (
            type: numberField
            heading {
                heading: <p>Plazo</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: PLAZO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Plazos por Proveedor
        }
    )

    process plazos-por-proveedor-save-interactive-grid-data (
        name: Plazos por Proveedor - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @plazos-por-proveedor
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 19097057298912085
        }
    )

)

