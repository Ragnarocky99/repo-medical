    process guardar-coleccion (
        name: Guardar Coleccion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    R_ARTICULO STW_ARTICULOS%ROWTYPE;
                    VCANTIDAD  NUMBER := 0;
                BEGIN
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('ARTICULOS_ERR');
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('ARTICULOS');
                    FOR R1 IN (SELECT *  
                                 FROM APEX_APPLICATION_TEMP_FILES F, 
                                      TABLE( APEX_DATA_PARSER.PARSE(
                                                P_CONTENT                     => F.BLOB_CONTENT,
                                                P_ADD_HEADERS_ROW             => 'N',
                                                P_FILE_NAME                   => F.FILENAME) 
                                            ) P
                                 WHERE F.NAME = :P794_EXCEL AND
                                       P.LINE_NUMBER > 1
                              )
                    LOOP
                        -- Buscamos el rubro del articulo
                        BEGIN
                            SELECT ID
                              INTO R_ARTICULO.ID_RUBRO
                              FROM STW_RUBRO
                             WHERE ID_EMPRESA = :P0_ID_EMPRESA
                               AND (COD_RUBRO = R1.COL003 OR
                                    UPPER(REPLACE(DESCRIPCION, ' ', '')) = UPPER(REPLACE(REPLACE(R1.COL003, ' ', ''), CHR(13), '')));
                
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                IF R1.COL003 IS NOT NULL THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                               P_C001            => 'Categoria no existe',
                                                               P_C002            => R1.COL003,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener la categoria del articulo. Err '||SQLERRM);
                        END;
                
                        -- Buscamos el grupo del articulo
                        BEGIN
                            SELECT ID
                              INTO R_ARTICULO.ID_GRUPO_ART
                              FROM STW_GRUPOS_ART
                             WHERE ID_EMPRESA = :P0_ID_EMPRESA
                               AND (COD_GRUPO_ART = R1.COL004 OR
                                    UPPER(REPLACE(DESCRIPCION, ' ', '')) = UPPER(REPLACE(REPLACE(R1.COL004, ' ', ''), CHR(13), '')));
                
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                IF R1.COL004 IS NOT NULL THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                               P_C001            => 'Grupo no existe',
                                                               P_C002            => R1.COL004,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener el grupo del articulo. Err '||SQLERRM);
                        END;
                
                        -- Buscamos la linea del articulo
                        BEGIN
                            SELECT ID
                              INTO R_ARTICULO.ID_LINEA
                              FROM STW_LINEA
                             WHERE ID_EMPRESA = :P0_ID_EMPRESA
                               AND (COD_LINEA= R1.COL005 OR
                                    UPPER(REPLACE(DESCRIPCION, ' ', '')) = UPPER(REPLACE(REPLACE(R1.COL005, ' ', ''), CHR(13), '')));
                
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                IF R1.COL005 IS NOT NULL THEN
                                   APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                               P_C001            => 'Linea no existe',
                                                               P_C002            => R1.COL005,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener la linea del articulo. Err '||SQLERRM);
                        END;
                
                        -- Buscamos la familia del articulo
                        BEGIN
                            SELECT ID
                              INTO R_ARTICULO.ID_FAMILIA
                              FROM STW_FAMILIA
                             WHERE ID_EMPRESA = :P0_ID_EMPRESA
                               AND (COD_FAMILIA = R1.COL009 OR
                                    UPPER(REPLACE(DESCRIPCION, ' ', '')) = UPPER(REPLACE(REPLACE(R1.COL009, ' ', ''), CHR(13), '')));
                
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                IF R1.COL009 IS NOT NULL THEN
                                   APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                               P_C001            => 'Familia no existe',
                                                               P_C002            => R1.COL009,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error inesperado intentando obtener la familia del articulo. Err '||SQLERRM);
                        END;
                
                        -- Datos Numericos
                        BEGIN
                            R_ARTICULO.PORC_EFECTIVIDAD := REPLACE(R1.COL006, '.', ',');
                            R_ARTICULO.STOCK_MINIMO     := REPLACE(R1.COL007, '.', ',');
                            R_ARTICULO.CANT_MAX         := REPLACE(R1.COL008, '.', ',');
                        EXCEPTION
                            WHEN OTHERS THEN
                                APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                           P_C001            => 'Error con valores numericos',
                                                           P_C002            => R1.COL001,
                                                           P_C003            => R1.COL002,
                                                           P_N001            => R1.LINE_NUMBER);
                        END;
                        R_ARTICULO.COD_QUIMICO := R1.COL010;
                        -- Obtemos el ID del articulo y sus datos.
                        BEGIN
                            SELECT ID
                              INTO R_ARTICULO.ID
                              FROM STW_ARTICULOS
                             WHERE ID_EMPRESA = :P0_ID_EMPRESA
                               AND COD_ARTICULO = REPLACE(REPLACE(R1.COL001, ' ', ''), CHR(13), '');
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                           P_C001            => 'Articulo no encontrado',
                                                           P_C002            => R1.COL001,
                                                           P_C003            => R1.COL002,
                                                           P_N001            => R1.LINE_NUMBER);
                            WHEN OTHERS THEN
                                APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS_ERR',
                                                           P_C001            => 'Error inesperado. Error '||SQLERRM,
                                                           P_C002            => R1.COL001,
                                                           P_C003            => R1.COL002,
                                                           P_N001            => R1.LINE_NUMBER);
                        END;
                
                        IF R_ARTICULO.ID IS NOT NULL THEN
                            FOR I IN (
                                SELECT *
                                  FROM STW_ARTICULOS
                                 WHERE ID = R_ARTICULO.ID
                            )
                            LOOP
                                APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'ARTICULOS',
                                                           P_C001            => R_ARTICULO.ID_RUBRO,
                                                           P_C002            => R_ARTICULO.ID_GRUPO_ART,                        
                                                           P_C003            => R_ARTICULO.ID_LINEA,
                                                           P_C004            => R_ARTICULO.PORC_EFECTIVIDAD,
                                                           P_C005            => R_ARTICULO.STOCK_MINIMO,
                                                           P_C006            => R_ARTICULO.CANT_MAX,
                                                           P_C007            => R_ARTICULO.ID_FAMILIA,
                                                           P_C008            => R_ARTICULO.COD_QUIMICO,
                                                           P_N001            => I.ID);
                            END LOOP;
                            -- UPDATE STW_ARTICULOS
                            --    SET ID_RUBRO         = R_ARTICULO.ID_RUBRO,
                            --        ID_GRUPO_ART     = R_ARTICULO.ID_GRUPO_ART,
                            --        ID_LINEA         = R_ARTICULO.ID_LINEA,
                            --        PORC_EFECTIVIDAD = R_ARTICULO.PORC_EFECTIVIDAD,
                            --        STOCK_MINIMO     = R_ARTICULO.STOCK_MINIMO,
                            --        CANT_MAX         = R_ARTICULO.CANT_MAX
                            --  WHERE ID = R_ARTICULO.ID;
                            
                           -- VCANTIDAD := VCANTIDAD + 1;
                        END IF;
                        
                    END LOOP;
                
                    -- IF VCANTIDAD > 0 THEN
                    --     :P794_MENSAJE := 'Proceso concluido con Exito. Se procesaron '||VCANTIDAD||' registros';
                    -- ELSE
                    --     :P794_MENSAJE := 'No se realizó ninguna accion';
                    -- END IF;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 50628063930219623
        }
        serverSideCondition {
            whenButtonPressed: @excel
            type: itemIsNotNull
            item: P794_EXCEL
        }
    )

)

