                ```sql
                SELECT ART.COD_ARTICULO,
                       ART.DESCRIPCION DESC_ARTICULO,
                       COL.C001 ID_RUBRO_NUEVO,
                       COL.C002 ID_GRUPO_NUEVO,
                       COL.C003 ID_LINEA_NUEVO,
                       COL.C004 PORC_EFECTIVIDAD_NUEVO,
                       COL.C005 STOCK_MINIMO_NUEVO,
                       COL.C006 STOCK_MAXIMO_NUEVO
                  FROM APEX_COLLECTIONS COL
                  JOIN STW_ARTICULOS    ART ON ART.ID = COL.N001
                 WHERE COLLECTION_NAME = 'ARTICULOS'
                ```
