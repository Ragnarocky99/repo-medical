    process actualizar-articulos (
        name: Actualizar Articulos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR A_PROCESAR IS
                        SELECT N001 ID_ARTICULO,
                               C001 ID_RUBRO,
                               C002 ID_GRUPO,
                               C003 ID_LINEA,
                               C004 PORC_EFECTIVIDAD,
                               C005 STOCK_MINIMO,
                               C006 STOCK_MAXIMO,
                               C007 ID_FAMILIA,
                               C008 COD_QUIMICO
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'ARTICULOS';
                    VCANTIDAD NUMBER := 0;
                BEGIN
                    FOR P IN A_PROCESAR
                    LOOP
                        UPDATE STW_ARTICULOS AR
                           SET AR.ID_RUBRO      = NVL(P.ID_RUBRO, AR.ID_RUBRO),
                               AR.ID_GRUPO_ART  = NVL(P.ID_GRUPO, AR.ID_GRUPO_ART),
                               AR.ID_LINEA      = NVL(P.ID_LINEA, AR.ID_LINEA),
                               PORC_EFECTIVIDAD = NVL(P.PORC_EFECTIVIDAD, AR.PORC_EFECTIVIDAD),
                               STOCK_MINIMO     = NVL(P.STOCK_MINIMO, AR.STOCK_MINIMO),
                               CANT_MAX         = NVL(P.STOCK_MAXIMO, AR.CANT_MAX),
                               ID_FAMILIA       = NVL(P.ID_FAMILIA, AR.ID_FAMILIA),
                               COD_QUIMICO      = NVL(P.COD_QUIMICO, AR.COD_QUIMICO)
                         WHERE AR.ID = P.ID_ARTICULO;
                        
                        VCANTIDAD := VCANTIDAD + 1;
                    END LOOP;
                
                    IF VCANTIDAD = 0 THEN
                        :P794_MENSAJE := 'No se procesó nigún registro';
                    ELSE
                        :P794_MENSAJE := 'Se procesó '||VCANTIDAD||' registros';
                    END IF;
                
                    APEX_COLLECTION.DELETE_COLLECTION(P_COLLECTION_NAME => 'ARTICULOS_ERR');
                    APEX_COLLECTION.DELETE_COLLECTION(P_COLLECTION_NAME => 'ARTICULOS');
                END;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: &P794_MENSAJE.
        }
        advanced {
            executionMappingIdentifier: 55197864458584525
        }
        serverSideCondition {
            type: request=Value
            value: SAVE
        }
    )

