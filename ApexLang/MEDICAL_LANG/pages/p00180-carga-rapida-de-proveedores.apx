page 180 (
    name: Carga Rapida de Proveedores
    alias: CARGA-RAPIDA-DE-PROVEEDORES
    title: Carga Rapida de Proveedores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region carga-rapida-de-proveedores (
        name: Carga Rapida de Proveedores
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P180_BANDERA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P180_CI (
        type: numberField
        label {
            label: <p>Cédula de Ident.: </p>
            alignment: left
        }
        settings {
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @carga-rapida-de-proveedores
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 40
        }
        sessionState {
            storage: request
        }
    )

    pageItem P180_COD_PERSONA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
            region: @carga-rapida-de-proveedores
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(COD_PERSONA)),0) +1 FROM BSW_PERSONAS
        }
        sessionState {
            storage: request
        }
    )

    pageItem P180_COD_PROVEEDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @carga-rapida-de-proveedores
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_PROVEEDOR)),0)+1 FROM CMW_PROVEEDORES
                WHERE ID_EMPRESA = :P0_COD_EMPRESA;
                ```
        }
        sessionState {
            storage: request
        }
    )

