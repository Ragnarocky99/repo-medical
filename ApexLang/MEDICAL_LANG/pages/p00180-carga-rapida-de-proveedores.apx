    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @carga-rapida-de-proveedores
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            icon: fa-undo-arrow
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button condicion (
        buttonName: CONDICION
        label: Condicion
        layout {
            sequence: 30
            region: @carga-rapida-de-proveedores
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 128
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button generar (
        buttonName: GENERAR
        label: Generar
        layout {
            sequence: 10
            region: @carga-rapida-de-proveedores
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-right
