            affectedElements {
                selectionType: items
                items: P180_ID_SECTOR
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 80
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @sector
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P180_ID_SECTOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 70
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @condicion
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P180_COND_COMPRA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction traer-nombre (
        name: Traer Nombre
        execution {
            sequence: 50
        }
        when {
            event: focusin
            selectionType: items
            items: P180_NOMBRE_FANTASIA
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P180_NOMBRE
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    --declare
                    --    v_nombre varchar2(200);
                    --begin
                        if :P180_NOMBRE is not null and :P180_NOMBRE_FANTASIA is null then
                            :P180_NOMBRE_FANTASIA := :P180_NOMBRE;
                            return :P180_NOMBRE_FANTASIA;
                        end if;
                        return :P180_NOMBRE_FANTASIA; 
                    --end;
                    
                    
                    ```
                itemsToSubmit: [
                    P180_NOMBRE
                    P180_NOMBRE_FANTASIA
                ]
            }
            affectedElements {
                selectionType: items
                items: P180_NOMBRE_FANTASIA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction validar-ruc (
        name: Validar RUC
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P180_RUC
        }

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró el RUC
                style: warning
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 0
            }
        )

        action native-alert-2 (
            action: alert
            settings {
                title: Advertencia
                message: &P180_MENSAJE_VALIDACION.
                style: warning
                icon: fa-warning
                okLabel: Aceptar
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P180_MENSAJE_VALIDACION
            }
        )

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P180_NOMBRE
                    P180_ID_SECTOR
                    P180_COND_COMPRA
                    P180_TIPO_PERSONA
                    P180_MONEDA
                    P180_NOMBRE_FANTASIA
                    P180_CI
                    P180_DIRECCION
                    P180_EXENTO
                    P180_EXTERIOR
                    P180_TELEFONO_1
                    P180_DIRECTO
                    P180_COD_PERSONA
                    P180_COD_PROVEEDOR
                    P180_ID_PROVEEDOR
                ]
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 0
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P180_ID_SECTOR
                    P180_TIPO_PERSONA
                    P180_COND_COMPRA
                    P180_NOMBRE
                    P180_MONEDA
                    P180_NOMBRE_FANTASIA
                    P180_DIRECCION
                    P180_EXENTO
                    P180_EXTERIOR
                    P180_TELEFONO_1
                    P180_DIRECTO
                ]
            }
            execution {
                sequence: 50
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 0
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P180_ID_SECTOR
                    P180_TIPO_PERSONA
                    P180_COND_COMPRA
                    P180_NOMBRE
                    P180_MONEDA
                    P180_NOMBRE_FANTASIA
                    P180_DIRECCION
                    P180_EXENTO
                    P180_EXTERIOR
                    P180_TELEFONO_1
                    P180_DIRECTO
                    P180_COD_PERSONA
                    P180_COD_PROVEEDOR
                    P180_ID_PROVEEDOR
                ]
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 1
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera number:=0;
                    
                    BEGIN
                    IF :P180_RUC IS NOT NULL THEN
                    SELECT NVL((SELECT 1 FROM CONTRIBUYENTES WHERE RUC||'-'||DV = :P180_RUC),0) 
                    AS BANDERA 
                    INTO VBANDERA
                    FROM DUAL;
                    :P180_BANDERA := VBANDERA;
                    END IF;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el RUC');
                    END;
                    ```
                itemsToSubmit: P180_RUC
                itemsToReturn: P180_BANDERA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nombre from contribuyentes c
                    where c.ruc||'-'||c.dv = :P180_RUC
                    ```
                itemsToSubmit: P180_RUC
            }
            affectedElements {
                selectionType: items
                items: P180_NOMBRE
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 1
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nombre from contribuyentes c
                    where c.ruc||'-'||c.dv = :P180_RUC
                    ```
                itemsToSubmit: P180_RUC
            }
            affectedElements {
                selectionType: items
                items: P180_NOMBRE_FANTASIA
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 1
            }
            serverSideCondition {
                type: never
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @sector
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 1
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: button
                button: @condicion
            }
            execution {
                sequence: 110
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P180_BANDERA
                value: 1
            }
        )

        action validacion-actualizada (
            name: VALIDACION_ACTUALIZADA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vci            VARCHAR2(12);
                        vcontribuyente NUMBER(2):=0;
                        vpersona       NUMBER(2):=0;
                        vnombre_pro    VARCHAR2(200);
                        vestado_ruc    VARCHAR2(100);
                        vmensaje       VARCHAR2(250);
                        --vbandera       NUMBER(2);
                    
                    BEGIN
                        IF :P180_RUC IS NOT NULL AND (instr(:P180_RUC,'-',1) > 0 ) THEN
                    
                            IF length(:P180_RUC) = 7 THEN -- CI DE 5 DÍGITOS
                              
                                vci := SUBSTR(:P180_RUC,1,5);
                                
                            ELSE IF length(:P180_RUC) = 8 THEN -- CI DE 6 DÍGITOS
                              
                                 vci := SUBSTR(:P180_RUC,1,6);
                                 
                                 ELSE IF length(:P180_RUC) = 9 THEN -- CI DE 7 DÍGITOS
                                   
                                      vci := SUBSTR(:P180_RUC,1,7);
                                      
                                      ELSE IF length(:P180_RUC) = 10 THEN -- CI DE 8 DÍGITOS
                                        
                                           vci := SUBSTR(:P180_RUC,1,8);
                                           
                                           END IF;
                               
                                      END IF;
                                 END IF;
                            END IF;
                            
                            :P180_CI := vci;
                            
                            SELECT NVL((SELECT 1 
                                        FROM BSW_PERSONAS P,  CMW_PROVEEDORES C
                                        WHERE P.RUC = :P180_RUC
                                          AND C.ID_PERSONA = P.ID 
                                          AND C.ESTADO = 'A' 
                                          AND ROWNUM=1
                                        ),0)
                              INTO vpersona
                            FROM DUAL;
                    
                            SELECT NVL((SELECT 1 FROM CONTRIBUYENTES WHERE RUC||'-'||DV = :P180_RUC),0) 
                            AS BANDERA 
                             INTO vcontribuyente
                            FROM DUAL;
                            --:P180_BANDERA:= vcontribuyente;
                            IF vcontribuyente = 1 AND vpersona = 1 THEN
                                vcontribuyente := 0;
                                vpersona := 1;
                            END IF;
                            IF vcontribuyente = 0 AND vpersona = 1 THEN
                              
                                :P180_BANDERA:= vpersona;
                                --:P392_BANDERA_RUC_GUARDADO := 0;
                                
                                SELECT C.ID AS ID_CLI, P.NOMBRE
                                  INTO :P180_ID_PROVEEDOR, vnombre_pro
                                FROM BSW_PERSONAS P, CMW_PROVEEDORES C
                                WHERE P.RUC = :P180_RUC
                                  AND C.ID_PERSONA = P.ID
                                  AND C.ESTADO = 'A';
                    
                                :P180_NOMBRE := vnombre_pro;
                                :P180_NOMBRE_FANTASIA := vnombre_pro;              
                    
                            ELSE IF vcontribuyente = 1 AND vpersona = 0 THEN
                                    :P180_BANDERA:= vcontribuyente;
                    
                                    --INSERT
                                    SELECT C.NOMBRE, C.ESTADO
                                      INTO vnombre_pro, vestado_ruc
                                    FROM CONTRIBUYENTES C
                                    WHERE C.RUC||'-'||DV = :P180_RUC;
                    
                                    :P180_NOMBRE := vnombre_pro;
                                    :P180_NOMBRE_FANTASIA := vnombre_pro;
                    
                                    IF vestado_ruc != 'ACTIVO' THEN
                                       vmensaje := 'El RUC se encuentra ' || vestado_ruc || '.';
                                       :P180_MENSAJE_VALIDACION := vmensaje;
                                    END IF;
                                    
                                    --:P392_BANDERA_RUC_GUARDADO := vbandera;
                    
                                 ELSE IF vcontribuyente = 0 AND vpersona = 0 THEN
                                        :P180_BANDERA := 0;
                                      --ELSE
                                        --RAISE_APPLICATION_ERROR(-20000,'No se ha encontrado el RUC: '||:P180_RUC);
                                      END IF;
                                 END IF;
                            END IF;
                        ELSE
                            RAISE_APPLICATION_ERROR(-20000, 'Favor cargar un ruc válido.');
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: P180_RUC
                itemsToReturn: [
                    P180_BANDERA
                    P180_MENSAJE_VALIDACION
                    P180_CI
                    P180_NOMBRE
                    P180_NOMBRE_FANTASIA
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                VBANDERA NUMBER:=0;
                BEGIN
                IF :P180_RUC IS NOT NULL THEN
                SELECT NVL((SELECT 1 FROM CONTRIBUYENTES WHERE RUC||'-'||DV =:P180_RUC),0) 
                AS BANDERA 
                INTO VBANDERA
                FROM DUAL ;
                IF VBANDERA = 1 THEN 
                RETURN TRUE;
                ELSE 
                RETURN FALSE;
                END IF;
                END IF;
                END;
                ```
        }
        error {
            errorMessage: RUC no es valido
        }
    )

    process crear-proveedor (
        name: Crear Proveedor
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                v_id number;
                
                begin
                
                IF :P180_RUC IS NOT NULL THEN
                :P180_TIENE_RUC := 'S';
                END IF;
                
                INSERT INTO BSW_PERSONAS (COD_PERSONA, NOMBRE, NOMB_FANTASIA, DIRECCION, TELEFONO, RUC, NRO_CI, ES_FISICA, TIENE_RUC)
                VALUES (:P180_COD_PERSONA, :P180_NOMBRE, :P180_NOMBRE_FANTASIA, :P180_DIRECCION, :P180_TELEFONO_1, :P180_RUC,
                :P180_CI, :P180_TIPO_PERSONA, :P180_TIENE_RUC);
                SELECT id 
                into v_id
                from bsw_personas
                where cod_persona = :P180_COD_PERSONA;
                insert into cmw_proveedores (ID, ID_EMPRESA, COD_PROVEEDOR, ID_PERSONA, ESTADO, ID_MONEDA, ID_SECTOR, EXENTO, 
                DIRECTO,IND_RET_IVA, IND_EXTERIOR, ID_CONDICION_COMPRA, COD_USUARIO_AUD)
                VALUES (:P180_ID_PROVEEDOR, :P0_COD_EMPRESA, :P180_COD_PROVEEDOR, V_ID, 'A', :P180_MONEDA, :P180_ID_SECTOR, :P180_EXENTO,
                :P180_DIRECTO, 'N', :P180_EXTERIOR, :P180_COND_COMPRA, :APP_USER);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Operacion realizada correctamente!
        }
        advanced {
            executionMappingIdentifier: 39297394148983429
