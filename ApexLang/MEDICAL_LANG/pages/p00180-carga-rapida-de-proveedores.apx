    dynamicAction agregar-ci (
        name: Agregar CI
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P180_CI
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P180_RUC
                    P180_ID_SECTOR
                    P180_COND_COMPRA
                    P180_TIPO_PERSONA
                    P180_MONEDA
                    P180_NOMBRE
                    P180_TELEFONO_1
                    P180_NOMBRE_FANTASIA
                    P180_EXENTO
                    P180_EXTERIOR
                    P180_DIRECCION
                    P180_DIRECTO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P180_CI
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @condicion
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: button
                button: @sector
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction desactivar (
        name: Desactivar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P180_ID_SECTOR
                    P180_TIPO_PERSONA
                    P180_COND_COMPRA
                    P180_NOMBRE
                    P180_MONEDA
                    P180_NOMBRE_FANTASIA
                    P180_DIRECCION
                    P180_EXENTO
                    P180_EXTERIOR
                    P180_TELEFONO_1
                    P180_DIRECTO
                ]
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemIsNull
                item: P180_CI
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @sector
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: itemIsNull
                item: P180_CI
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: button
                button: @condicion
            }
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: itemIsNull
                item: P180_CI
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P180_RUC
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
