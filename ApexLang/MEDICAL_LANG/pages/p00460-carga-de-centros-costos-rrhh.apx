page 460 (
    name: Carga de Centros de Costos RRHH
    alias: CARGA-DE-CENTROS-COSTOS-RRHH
    title: Carga de Centros de Costos RRHH
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-centros-de-costos-rr-hh (
        name: Carga de Centros de Costos RR.HH.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CR.ID,
                       CR.ID_EMPRESA,
                       CR.COD_CENTRO,
                       CR.ID_SUCURSAL,
                       CR.DESCRIPCION,
                       CR.COD_USUARIO_AUD
                FROM RHW_CENTROS_COSTOS CR
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P460_COD_CENTRO (
        type: textField
        label {
            label: <p><b style="color:red">*</b>Código: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-centros-de-costos-rr-hh
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-centros-de-costos-rr-hh
            column: COD_CENTRO
            dataType: varchar2
        }
    )

    pageItem P460_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-centros-de-costos-rr-hh
            slot: regionBody
        }
        source {
            formRegion: @carga-de-centros-de-costos-rr-hh
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P460_DESCRIPCION (
        type: textField
        label {
            label: <p><b style="color:red">*</b>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-centros-de-costos-rr-hh
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @carga-de-centros-de-costos-rr-hh
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P460_ID (
        type: hidden
        layout {
            sequence: 30
            region: @carga-de-centros-de-costos-rr-hh
            slot: regionBody
        }
        source {
            formRegion: @carga-de-centros-de-costos-rr-hh
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: RHW_CENTROS_COSTOS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P460_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 40
            region: @carga-de-centros-de-costos-rr-hh
            slot: regionBody
        }
        source {
            formRegion: @carga-de-centros-de-costos-rr-hh
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    pageItem P460_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p><b style="color:red">*</b>Sucursal: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            popupHeight: 380
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
        }
        layout {
            sequence: 80
            region: @carga-de-centros-de-costos-rr-hh
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-centros-de-costos-rr-hh
            column: ID_SUCURSAL
            dataType: number
        }
    )

    button aplicar-cambios (
        buttonName: APLICAR_CAMBIOS
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @botones
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P460_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button borrar (
        buttonName: BORRAR
        label: Borrar
        layout {
            sequence: 10
            region: @botones
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar el registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P460_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @botones
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P460_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction cancel-dialog (
        name: CANCEL_DIALOG
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process centros-costo-rrhh-row-processing (
        name: Centros Costo RRHH - Row Processing
        type: formAutoRowProcessing
        formRegion: @carga-de-centros-de-costos-rr-hh
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Se ha guardado correctamente.
        }
        advanced {
            executionMappingIdentifier: 52231158137906845
        }
    )

    process initialize-form-carga-de-conceptos-rrhh (
        name: Initialize form Carga de Conceptos RRHH
        type: formInitialization
        formRegion: @carga-de-centros-de-costos-rr-hh
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 52229959376906833
        }
    )

    process limpiar (
        name: LIMPIAR
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 52231254102906846
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ELIMINAR,CREAR
        }
    )

)

