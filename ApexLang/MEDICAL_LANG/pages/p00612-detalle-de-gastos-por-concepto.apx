        column ID_PROVEEDOR (
            type: plainTextBasedOnLov
            heading {
                heading: Proveedor
                alignment: center
            }
            lov {
                lov: @lv-proveedores
            }
            layout {
                sequence: 56
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column MONTO_TOTAL (
            type: plainText
            heading {
                heading: Monto Total
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
