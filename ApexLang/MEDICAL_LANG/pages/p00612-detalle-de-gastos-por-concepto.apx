            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: DETALLE DE GASTOS POR CONCEPTO
        }

        savedReport 102130 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CENTRO_COSTO (
                sequence: 7
            )

            displayColumn CONCEPTO_COMPRA (
                sequence: 6
            )

            displayColumn CUENTA_CONTABLE (
                sequence: 8
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 1
            )

            displayColumn ID_PROVEEDOR (
                sequence: 5
            )

            displayColumn MONTO_TOTAL (
                sequence: 13
            )

            displayColumn MON_EXENTA (
                sequence: 12
            )

            displayColumn MON_GRAVADA (
                sequence: 10
            )

            displayColumn NRO_FACTURA (
                sequence: 4
            )

            displayColumn NUM_COMPROBANTE (
                sequence: 3
            )

            displayColumn OBSERVACION (
                sequence: 9
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 2
            )

            displayColumn TOT_IVA (
                sequence: 11
            )

        )

    )

    region filros (
        name: Filros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    pageItem P612_CENTRO_COSTO (
        type: popupLov
        label {
            label: <P>Centro Costo: </P>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-centro-costo
            nullDisplayValue: ---Sin Seleccionar---
        }
        layout {
            sequence: 40
            region: @filros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P612_CONCEPTO (
        type: popupLov
        label {
            label: <P>Concepto: </P>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-conceptos-pag
            nullDisplayValue: ---Sin Seleccionar---
        }
        layout {
            sequence: 50
            region: @filros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P612_FEC_FINAL (
        type: datePicker
        label {
            label: <P>Fecha Final: </P>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem P612_FEC_INICIAL (
        type: datePicker
        label {
            label: <P>Fecha Inicial: </P>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    button ejecutar (
        buttonName: EJECUTAR
        label: Ejecutar
        layout {
            sequence: 10
            region: @filros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @filros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 614
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 614
                items: {
                    P614_CENTRO_COSTO: &P612_CENTRO_COSTO.
                    P614_CONCEPTO: &P612_CONCEPTO.
                    P614_FEC_FINAL: &P612_FEC_FINAL.
                    P614_FEC_INICIAL: &P612_FEC_INICIAL.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

