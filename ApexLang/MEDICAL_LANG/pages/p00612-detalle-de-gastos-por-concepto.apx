            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column NUM_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro. Comprobante
                alignment: center
            }
            layout {
                sequence: 66
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column OBSERVACION (
            type: plainText
            heading {
                heading: Observacion
                alignment: center
            }
