            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column NRO_FACTURA (
            type: plainText
            heading {
                heading: Nro. Factura
                alignment: center
            }
