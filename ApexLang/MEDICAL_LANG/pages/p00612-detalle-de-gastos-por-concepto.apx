page 612 (
    name: Detalle de gastos por concepto
    alias: DETALLE-DE-GASTOS-POR-CONCEPTO
    title: Detalle de gastos por concepto
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region detalle-de-gastos-por-concepto (
        name: DETALLE DE GASTOS POR CONCEPTO
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select FEC_COMPROBANTE,
                       ID_CONCEPTO_COMPRA,
                       CONCEPTO_COMPRA,
                       ID_CENTRO_COSTO,
                       CENTRO_COSTO,
                       MON_GRAVADA,
                       MON_EXENTA,
                       TOT_IVA,
                       MONTO_TOTAL,
                       ID_EMPRESA,
                       EMPRESA,
                       Id_Proveedor,
                       Num_Comprobante,
                       CUENTA_CONTABLE,
                       OBSERVACION,
                       NRO_FACTURA,
                       TIP_COMPROBANTE
                  from CPWV_GASTOS_CONCEPTOS
                  where ID_EMPRESA           = :P0_ID_EMPRESA
                  AND   FEC_COMPROBANTE     >=  :P612_FEC_INICIAL
                  AND   FEC_COMPROBANTE     <=  :P612_FEC_FINAL
                  AND   (ID_CONCEPTO_COMPRA  = :P612_CONCEPTO OR :P612_CONCEPTO IS NULL)
                  AND   (ID_CENTRO_COSTO     = :P612_CENTRO_COSTO OR :P612_CENTRO_COSTO IS NULL)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 10209609474900915
        }

        column CENTRO_COSTO (
            type: plainText
            heading {
                heading: Centro Costo
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CONCEPTO_COMPRA (
            type: plainText
            heading {
                heading: Concepto Compra
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CUENTA_CONTABLE (
            type: plainText
            heading {
                heading: Cuenta Contable
                alignment: center
            }
            layout {
                sequence: 76
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column EMPRESA (
            type: hidden
            heading {
                heading: Empresa
            }
            layout {
                sequence: 26
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column FEC_COMPROBANTE (
            type: plainText
            heading {
                heading: Fecha Comprobante
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_CENTRO_COSTO (
            type: hidden
            heading {
                heading: Id Centro Costo
            }
            layout {
                sequence: 46
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID_CONCEPTO_COMPRA (
            type: hidden
            heading {
                heading: Id Concepto Compra
            }
            layout {
                sequence: 2
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 36
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
