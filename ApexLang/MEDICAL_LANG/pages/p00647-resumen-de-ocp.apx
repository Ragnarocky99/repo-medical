page 647 (
    name: Resumen de OCP
    alias: RESUMEN-DE-OCP
    title: Resumen de OCP
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            try {
              var model = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
              var v_nro_occ = model.getFieldKey("NRO_OCC");
               
              
              var numeroIngre = $v('P628_NRO_OCC');
            
              model.forEach(function(r, index, id) {
                var meta = model.getRecordMetadata(id);
                if ((meta.fields !== undefined) && (!meta.deleted)) {
            
                  model.setValue(r, v_nro_occ, numeroIngre);
                }
              });
            
            } catch (e) {
              // Manejar errores aquí
              console.error("Se produjo un error:", e);
            }
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            ///document.getElementById("P632_NUM_SOLICITUD_COMPRA").readOnly = true;
            //document.getElementById("P628_ID_CLIENTE").readOnly = true;
            //document.getElementById("P628_ID_PEDIDO").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            .apex-item-display-only{
             display: inline-block;
              padding: 6px 12px;
              font-size: 14px;
              width: 250px;
              line-height: 1.42857143;
              color: #555;
              background-color: #fff;
              background-image: none;
              border: 1px solid #ccc;
              border-radius: 4px;
              -webkit-box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
              box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
              cursor: not-allowed;
            }
            
            .apex-item {
              display: block;
              padding: 6px 12px;
              font-size: 14px;
              width: 300px;
              line-height: 1.42857143;
              color: #555;
              background-color: #fff;
              background-image: none;
              cursor: not-allowed;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region resumen-de-orden-de-compra (
        name: Resumen de Orden de Compra
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CMWV_RESUMEN_OCP
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                AND ID_SUCURSAL = :P0_ID_SUCURSAL
                AND FECHA_OCP BETWEEN :P647_FEC_OCP_DESDE AND :P647_FEC_OCP_HASTA
                AND (ART_ID = :P647_ARTICULO OR :P647_ARTICULO IS NULL)
                AND (ID_PROVEEDOR = :P647_ID_PROVEEDOR OR :P647_ID_PROVEEDOR IS NULL)
                AND (NRO_OCP = :P647_NRO_OCP OR :P647_NRO_OCP IS NULL)
                ```
            pageItemsToSubmit: [
                P647_ID_PROVEEDOR
                P647_FEC_OCP_HASTA
                P647_FEC_OCP_DESDE
                P647_NRO_OCP
                P647_ARTICULO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        advanced {
            savedReportMappingIdentifier: 77829396472482768
        }

