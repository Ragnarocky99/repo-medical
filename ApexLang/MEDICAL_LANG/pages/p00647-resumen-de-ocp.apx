        }
        layout {
            sequence: 40
            slot: body
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P647_DECIMALES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P647_FEC_OCP_DESDE (
        type: datePicker
        label {
            label: <p>Periodo OCP:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/'||TO_CHAR(SYSDATE,'MM/YYYY') FROM DUAL;
        }
    )

    pageItem P647_FEC_OCP_HASTA (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
    )

    pageItem P647_ID (
        type: hidden
        layout {
            sequence: 70
            slot: body
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P647_ID_PROVEEDOR (
        type: popupLov
        label {
            label: <p>Proveedor:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            popupWidth: 800
        }
        lov {
            type: sharedComponent
            lov: @lv-proveedores
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P647_MON_COSTO_COPIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: body
        }
    )

    pageItem P647_NRO_OCP (
        type: textField
        label {
            label: <p>Nro. OCP:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 130
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }

        triggerAction refrescar-reporte (
            name: Refrescar Reporte
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-de-orden-de-compra
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction agregar-paginacion (
        name: Agregar paginacion
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @resumen-de-orden-de-compra
            }
            execution {
                sequence: 10
            }
        )

    )

)

