        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_ESTANTE (
            type: numberField
            heading {
                heading: <p>Codigo</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: COD_ESTANTE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column FEC_ALTA (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: FEC_ALTA
                dataType: date
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_SUCURSAL (
            type: popupLov
            heading {
                heading: <p>Sucursal</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-sucursales
                displayNullValue: false
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_SUCURSAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
