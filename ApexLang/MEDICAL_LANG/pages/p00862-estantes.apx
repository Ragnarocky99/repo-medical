    dynamicAction inicializar-grilla (
        name: Inicializar Grilla
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @estantes
        }

        action cod-estante (
            name: COD_ESTANTE
            action: setValue
            settings {
                type: jsExpression
                jsExpression: i
            }
            affectedElements {
                selectionType: columns
                columns: COD_ESTANTE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: COD_ESTANTE
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: i = apex.region("Detalles").widget().interactiveGrid("getViews", "grid").model.getTotalRecords();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

