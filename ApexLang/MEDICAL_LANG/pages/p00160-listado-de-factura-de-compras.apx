page 160 (
    name: Listado de Factura de Compras
    alias: LISTADO-DE-FACTURA-DE-COMPRAS
    title: Listado de Factura de Compras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region listado-de-factura-de-compras (
        name: Listado de Factura de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_SUCURSAL,
                       FEC_COMPROBANTE,
                       ID_PROVEEDOR,
                       ID_CONDICION_COMPRA,
                       TIP_COMPROBANTE_REF,
                       SER_COMPROBANTE_REF,
                       NRO_COMPROBANTE_REF,
                       TOT_COMPROBANTE,
                       TOT_GRAVADAS,
                       TOT_EXENTAS,
                       TOT_IVA,
                       DESCUENTO,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       REFERENCIA,
                       ID_PROVEEDOR_REF,
                       NOM_PROVEEDOR,
                       RUC,
                       TOT_AJUSTE,
                       COD_USUARIO_AUD,
                       ID_EMBARQUE,
                       ID_PEDIDO,
                       IND_COBRO_TARJETA,
                       IND_CAJA_CHICA,
                       NRO_TIMBRADO,
                       ASIENTOS,
                       NRO_COMPROBANTE_PROV,
                       ID_CENTRO_COSTO,
                       IND_GENERA_ASIENTO,
                       ID_CUENTA,
                       ID_TIMBRADO,
                       ID_MOTIVO_NCR,
                       ID_COMPROBANTE_REF,
                       PATH_FACTURA,
                       NOMBRE_CORTO,
                       ID_RECEPCION,
                       ID_SUCURSAL_CENTRAL,
                       ID_ANTERIOR,
                       PORC_DESCUENTO_1,
                       DESCUENTO_1,
                       DESCUENTO_C_IVA_1,
                       PORC_DESCUENTO_2,
                       DESCUENTO_2,
                       DESCUENTO_C_IVA_2,
                       ID_SUBTIP_DENOMINACION,
                       FEC_VENC_TIMBRADO
                  from CMW_COMPRAS_CABECERA
                  WHERE ID_EMPRESA=:P0_COD_EMPRESA
                  ORDER BY NRO_COMPROBANTE DESC,FEC_COMPROBANTE DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 155
                items: {
                    P155_ID: #ID#
                }
            }
            linkIcon: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 31828571865881876
        }

