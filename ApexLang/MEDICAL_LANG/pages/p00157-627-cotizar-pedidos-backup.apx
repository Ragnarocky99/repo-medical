    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       ID,
                        CASE
                            WHEN ID IS NOT NULL THEN 'fa fa-search u-primary-text'
                       END Cotiza,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_SUCURSAL,
                       FEC_COMPROBANTE,
                       ID_CLIENTE,
                       ID_VENDEDOR,
                       ID_CONDICION_VENTA,
                       ID_LISTA_PRECIO,
                       DESCUENTO,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       TOT_COMPROBANTE,
                       TOT_GRAVADAS,
                       TOT_EXENTAS,
                       TOT_IVA,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       NRO_AUTORIZACION,
                       CAMBIO_MONEDA_PRECIO,
                       TIP_CAMBIO_COMPRA,
                       FEC_VENCIMIENTO,
                       NOM_CLIENTE,
                       RUC_CLIENTE,
                       COMENTARIO,
                       COD_USUARIO_AUD,
                       ESTADO_FAC,
                       IND_CAMBIO_PRECIO,
                       IND_LIMITE_CREDITO,
                       ENTREGA_INICIAL,
                       ID_MEDIO_PAGO,
                       ESTADO_CREDITO,
                       ID_CANAL_VENTA,
                       ID_TIPO_ENTREGA,
                       ID_SUCURSAL_CENTRAL,
                       IND_ENTREGA_INICIAL,
                       ID_CONCEPTO_COMP,
                       ID_CORPORACION,
                       NRO_OC,
                       ESTADO_OC,
                       FEC_ESTADO_OC,
                       ID_LISTA_BODA_CAB,
                       ID_SOLICITUD_CREDITO,
                       ID_DEPOSITO_RESGUARDO,
                       CONTACTO_NOMBRE,
                       CONTACTO_TELEFONO,
                       DIRECCION,
                       TELEFONO,
                       DIREC_ENTREGA,
                       LATITUD,
                       LONGITUD,
                       ID_ZONA,
                       AUTORIZA_STOCK,
                       AUTORIZA_STOCK_USU,
                       AUTORIZA_STOCK_FEC,
                       AUTORIZA_CTACTE,
                       AUTORIZA_CTACTE_USU,
                       AUTORIZA_CTACTE_FEC,
                       ID_FACTURA,
                       ID_SECTOR_VEN,
                       COD_USUARIO_DESPACHANDO
                      
                  from VTW_PEDIDOS_CABECERA
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  AND (NRO_COMPROBANTE = :P157_NRO_PEDIDO OR :P157_NRO_PEDIDO IS NULL)
                  AND (ID_CLIENTE = :P157_CLIENTE OR :P157_CLIENTE IS NULL)
                  AND (ID_SUCURSAL = :P157_SUCURSAL OR :P157_SUCURSAL IS NULL)
                  AND (
                      (:P157_ESTADO = '--- Sin seleccionar ---' AND ESTADO IN ('PE', 'PA'))
                      OR (ESTADO = :P157_ESTADO AND :P157_ESTADO IS NOT NULL)
                  )
                  AND (FEC_COMPROBANTE BETWEEN :P157_FECHA_DESDE AND :P157_FECHA_HASTA)
                  AND ESTADO NOT IN ('EP');
                
                
                
                
                   
                ```
            pageItemsToSubmit: [
                P157_CLIENTE
                P157_ESTADO
                P157_TIPO
                P157_SUCURSAL
                P157_FECHA_DESDE
                P157_FECHA_HASTA
                P157_NRO_PEDIDO
            ]
        }
