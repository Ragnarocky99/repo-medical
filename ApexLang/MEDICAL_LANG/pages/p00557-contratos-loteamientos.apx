    dynamicAction genera-cuotas (
        name: Genera Cuotas
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @generar-cuotas
        }

        action generar-cuotas (
            name: GENERAR_CUOTAS
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                      DECLARE 
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    
                    begin
                    GENERAR_CUOTAS(P_ID_EMPRESA         =>  :P0_ID_EMPRESA,
                                   P_ID_LOTE            =>  :P557_ID_LOTE,
                                   P_ID_FRACCION        =>  :P557_ID_FRACCION,
                                   P_ID_MANZANA         =>  :P557_ID_MANZANA,
                                   P_ID_MONEDA          =>  :P557_ID_MONEDA,
                                   P_MONTO_CUOTA        =>  REPLACE(:P557_MONTO_CUOTA,'.',''),
                                   P_CUOTAS_PAGAR       =>  :P557_CUOTAS_PAGADAS,
                                   P_CANT_CUOTAS        =>  :P557_CANT_CUOTAS,
                                   P_ID_IVA             =>  NVL(:P557_ID_IVA,66),
                                   P_PORC_IVA           =>  5               ,
                                   P_DECIMALES          => :P557_DECIMALES   ,
                                   P_FEC_COMPROBANTE    =>  TO_DATE(:P557_FEC_COMPROBANTE,'DD/MM/YYYY'),
                                   P_TOT_COMPROBANTE    =>  :P557_TOT_COMPROBANTE,
                                   P_TOT_IVA            =>  :P557_TOT_IVA        ,
                                   P_TOT_GRAVADAS       =>  :P557_TOT_GRAVADAS   ,
                                   P_TOT_EXENTAS        =>  :P557_TOT_EXENTAS);
                    
                                   IF :P557_TOT_COMPROBANTE IS NULL THEN
                                   RAISE_APPLICATION_ERROR(-20000,'No se genero ninguna cuota');
                                   END IF;
                    OPEN L_CURSOR FOR 
                    SELECT  C001 AS FECHA_VENCIMIENTO,
                            C002 AS TOT_CUOTA        ,
                            C003 AS PORC_IVA         ,
                            C004 AS TOT_IVA          ,
                            C005 AS MONTO_CUOTA      ,
                            C006 AS NRO_CUOTA        ,
                            C007 AS INDICE_CUOTA     ,
                            C008 AS DIAS 
                            FROM APEX_COLLECTIONS
                            WHERE COLLECTION_NAME='TMP_CUOTAS_LT'
                            ORDER BY TO_NUMBER(NRO_CUOTA) DESC ;
                           
                    
                    
                              APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P557_JSON_CUOTAS:=JSON_DETALLE;
                    
                    
                    
                    end;
                    ```
                itemsToSubmit: [
                    P557_ID_FRACCION
                    P557_ID_MANZANA
                    P557_ID_LOTE
                    P557_MONTO_CUOTA
                    P557_CUOTAS_PAGADAS
                    P557_CANT_CUOTAS
                    P557_DECIMALES
                    P557_FEC_COMPROBANTE
                ]
                itemsToReturn: [
                    P557_TOT_GRAVADAS
                    P557_TOT_EXENTAS
                    P557_TOT_IVA
                    P557_TOT_COMPROBANTE
                    P557_JSON_CUOTAS
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_GENERAR_CUOTAS
                value: S
            }
        )

