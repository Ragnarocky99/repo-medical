    dynamicAction validar-estado (
        name: Validar Estado
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P557_ESTADO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare vestado varchar2(1);
                    
                    BEGIN
                    
                    	BEGIN
                    		select estado
                    		 into	 vestado
                    		from ltw_contratos
                    		where id_empresa     = :P0_ID_EMPRESA
                            AND ID=:P557_ID;
                    	EXCEPTION
                    		WHEN no_data_found THEN
                    		 vestado := 'A';
                    	END;
                    
                    
                      
                    	  IF ( ( nvl( vestado,'A') = 'N' ) and
                    	  	   ( nvl( :P557_ESTADO,'X') <> 'N' )  ) THEN
                    	  	if nvl(:P557_CAMBIA_ESTADO_CONTRATO,'N') = 'S' then
                           NULL;	:P557_ESTADO:=VESTADO;
                          else
                    	
                    		    :P557_ESTADO :=  vestado; 
                              RAISE_APPLICATION_ERROR(-20000,'No se puede Des-Anular un Contrato');
                    		  end if;
                    	  ELSIF ( ( nvl( vestado,'A')  <> 'C' ) and
                    	  	      ( nvl( :P557_ESTADO,'X') = 'C' )  )THEN
                    	   
                    	    :P557_ESTADO :=  vestado; 
                            RAISE_APPLICATION_ERROR(-20000,'No se puede dar por Cancelado el Contrato desde Aqui!!');
                    	  ELSIF ( ( nvl( vestado,'A')  = 'C' ) and
                    	  	      ( nvl( :P557_ESTADO,'X') <> 'C' )  )THEN
                          if nvl(:P557_CAMBIA_ESTADO_CONTRATO,'N') = 'S' then
                           :P557_ESTADO:=VESTADO  ;    --	:b_contratos.estado := :b_contratos.radio_estado;
                          else
                    		    RAISE_APPLICATION_ERROR(-20000,'No se puede Des-Cancelado el Contrato');
                    		    :P557_ESTADO :=  vestado; 
                    	    end if;
                    	  ELSIF ( ( :P557_ID is null  ) and
                    	  	      ( nvl( :P557_ESTADO,'X') = 'N' )  )THEN
                    	    RAISE_APPLICATION_ERROR(-20000,'Es necesario Guardar el contrato para luego Anularlo');
                    	    :P557_ESTADO :=  'A'; 
                    	  ELSE
                    	    /*declare
                    	       id_view VIEWPORT;
                    	      begin 
                    	       id_view := find_view('CA_ANULAR');
                    	       SET_VIEW_PROPERTY(ID_VIEW, VISIBLE, PROPERTY_TRUE);
                    	       SET_ITEM_PROPERTY( 'ANULAR.ACEPTAR',  ENABLED, PROPERTY_FALSE );
                    	       SET_ITEM_PROPERTY( 'ANULAR.CANCELAR', ENABLED, PROPERTY_TRUE );
                    	       go_item('anular.cod_motivo_anu');
                    	      end;*/
                              :P557_IND_ANULACION:='S';
                    	  END IF; 
                    END;
                    ```
                itemsToSubmit: [
                    P557_ID
                    P557_ESTADO
                ]
                itemsToReturn: P557_ESTADO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
                stopExecutionOnError: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: :P557_IND_ANULACION:='N';
                itemsToReturn: P557_IND_ANULACION
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P557_ID_MOTIVO_ANU_lov_btn').click();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_ANULACION
                value: S
            }
        )

    )

    dynamicAction when-validate-item-id-lote (
        name: WHEN-VALIDATE-ITEM-ID_LOTE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P557_ID_MANZANA
        }

        action native-confirm (
            action: confirm
            settings {
                message:
                    ```html
                    Es una Venta directa porque no existe un compromiso activo para Este Lote.
                    '¿Desea continuar de todas formas?'
                    ```
                style: warning
                confirmLabel: Aceptar
                cancelLabel: Cancelar
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_ALERT
                value: S
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P557_ID_MANZANA is not null 	THEN	
                    	declare
                    		vestado varchar2(3):= 'A';
                    BEGIN
                    			select tip_comprobante,ser_comprobante, nro_comprobante,id_contrato_ref
                    			into   :P557_TIP_COMPROBANTE_REF ,
                    			       :P557_SER_COMPROBANTE_REF ,
                    			       :P557_NRO_COMPROBANTE_REF,
                                       :P557_ID_CONTRATO_REF
                    			from ltw_contratos
                    			where  id_empresa     = :P0_ID_EMPRESA
                    			   and id_fraccion    = :P557_ID_FRACCION
                    			   and id_manzana     = :P557_ID_MANZANA
                    			   and id_lote 		   = :P557_ID_LOTE
                    			   and rownum          = 1
                    			   and nvl(estado,'N') = 'A';
                    			   
                    	EXCEPTION
                    		  WHEN no_data_found THEN
                           
                           BEGIN		 	
                    			 	select tip_comprobante,ser_comprobante, nro_comprobante
                    				  into :P557_TIP_COMPROBANTE_REF ,
                    				       :P557_SER_COMPROBANTE_REF ,
                    				       :P557_NRO_COMPROBANTE_REF
                    				  from ltw_comprobantes_compromiso
                    				 where id_empresa     =  :P0_ID_EMPRESA
                    				   and id_fraccion    = :P557_ID_FRACCION
                    				   and id_manzana     = :P557_ID_MANZANA
                    				   and id_lote 		   = :P557_ID_LOTE
                    				   and rownum          = 1
                    				   and nvl(estado,'N') = 'C';
                            EXCEPTION
                           	  WHEN no_data_found	 THEN 
                           	  
                           	  ------carga estado de lo que sí hay cargado-----------
                         BEGIN
                    			select estado
                    			into   vestado
                    			from ltw_contratos
                    			where  id_empresa     = :P0_ID_EMPRESA
                    			   and id_fraccion    = :P557_ID_FRACCION
                    			   and id_manzana     = :P557_ID_MANZANA
                    			   and id_lote 		   = :P557_ID_LOTE
                    			   and rownum          = 1;
                    			   
                    	EXCEPTION
                    		  WHEN others THEN
                    		  vestado := 'A';
                    		 end;
                           	 ----------------------------------------------------------------- 
                           	  if nvl(vestado,'A') = 'C' then
                           	  	if nvl(:P557_DOBLE_CARGA_LOTE,'N') = 'S' then
                           	  		RAISE_APPLICATION_ERROR(-20000,'Ya existe otro contrato con el mismo lote en estado Cancelado.');
                           	      :P557_IND_ALERT:='S';    --  venta_directa;
                           	  	else 
                           	  		RAISE_APPLICATION_ERROR
                                         (-20000,'Ya existe otro contrato con el mismo lote en estado Cancelado. Usted no tiene permiso para volver a crear otro contrato del mismo lote.');
                           	  	end if;
                           	 else
                           	      :P557_IND_ALERT:='S';  -- 	venta_directa;
                           	 end if;
                           	 
                            END;
                    		  	 :P557_IND_BUSCAR_COND_LOTES:='S';    --buscar_cond_lotes;
                       		WHEN others THEN
                    			  RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el nro del Contrato - '||sqlerrm);
                    			
                        END;
                    		
                    		if :P557_TIP_COMPROBANTE_REF = 'COM' then
                    			declare	
                    					vcant number;
                    			begin
                    				select count(*)
                    				into vcant
                    				from ccw_saldos
                    				where id_empresa = :P0_ID_EMPRESA and
                    							tipo_comprobante = :P557_TIP_COMPROBANTE_REF and
                    							ser_comprobante = :P557_SER_COMPROBANTE_REF and
                    							nro_comprobante	= :P557_NRO_COMPROBANTE_REF and
                    							saldo_cuota > 0;
                    							
                    			  if nvl(vcant,0) > 0 then
                    			  	RAISE_APPLICATION_ERROR(-20000,'El compromiso aun no fue cancelado.');
                    			  end if;
                    			end;
                    		end if;
                    	END IF;
                    	
                    begin	
                    declare
                    	vblo varchar2(1);	
                    BEGIN
                    
                    		BEGIN
                    			select nvl(bloqueado,'N')
                    					into vblo
                    			 from ltw_lotes 
                    			 where   id_empresa =  :P0_ID_EMPRESA
                    			 and 		id_fraccion = :P557_ID_FRACCION
                    			 and 		id_manzana	 = :P557_ID_MANZANA
                    			 and    id 	=    :P557_ID_LOTE;
                    		exception 
                    	when no_data_found then
                    	vblo := 'N';
                    		END;
                    		
                    		IF vblo = 'S' then
                    			raise_application_error(-20000,'El lote ha sido recuperado pero se debe desbloquear para continuar.');
                    		end if;
                    end;
                    end;
                          
                    
                    ```
                itemsToSubmit: [
                    P557_ID_FRACCION
                    P557_ID_MANZANA
                    P557_ID_LOTE
                    P557_DOBLE_CARGA_LOTE
                ]
                itemsToReturn: [
                    P557_TIP_COMPROBANTE_REF
                    P557_SER_COMPROBANTE_REF
                    P557_NRO_COMPROBANTE_REF
                    P557_ID_CONTRATO_REF
                    P557_IND_BUSCAR_COND_LOTES
                    P557_IND_ALERT
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    	 
                      	IF :P557_ID_MANZANA IS NULL THEN
                    	   RAISE_APPLICATION_ERROR (-20000,'Debe ingresar el Código de Lote.');
                    	ELSE
                    		DECLARE
                    		  v_estado        varchar2(1);
                    		  vexiste         varchar2(1);
                    		  vpropiet      varchar2(1);
                    		BEGIN
                                BEGIN
                                	select 'S',tip_reserva
                                	  into vexiste,vpropiet
                                	  from ltw_reservas
                                	where id_empresa   = :P0_ID_EMPRESA
                                	  and id_fraccion  = :P557_ID_FRACCION
                                	  and id_lote      = :P557_ID_LOTE
                                	  and id_manzana   = :P557_ID_MANZANA
                                      and nvl(estado,'X') = 'A';
                                	 
                                EXCEPTION
                                	WHEN no_data_found THEN
                                	 vexiste := 'N';
                                END;
                    			
                                    BEGIN
                                        select estado
                                          into v_estado
                                          from ltw_lotes
                                         where id_empresa  = :P0_ID_EMPRESA
                                           and id_fraccion = :P557_ID_FRACCION
                                           and id_manzana  = :P557_ID_MANZANA
                                           and id     = :P557_ID_LOTE;
                                      EXCEPTION
                                      	WHEN no_data_found THEN
                                      	  raise_application_error(-20000,'El lote '||:P557_ID_LOTE||' no Existe.');
                                      	  :P557_ID_LOTE := null;
                                      	WHEN others THEN
                                      	  raise_application_error(-20000,'Error al recuperar el precio del lote - '||sqlerrm);
                                    END;
                    	
                                    IF nvl(v_estado,'X') = 'V' THEN
                                        RAISE_APPLICATION_ERROR(-20000,'El lote '||:P557_ID_LOTE||' esta Vendido');
                                    ELSIF nvl(v_estado,'X') = 'S' THEN
                                        RAISE_APPLICATION_ERROR(-20000,'El lote '||:P557_ID_LOTE||' tiene una seña no cancelada');
                                    ELSIF nvl(v_estado,'X') = 'I' THEN
                                        RAISE_APPLICATION_ERROR(-20000,'El lote '||:P557_ID_LOTE||' fue retirado de la administración');
                                    ELSIF ( ( nvl(v_estado,'X') = 'E') and ( nvl(vpropiet,'N') = 'P' )  ) THEN
                                        RAISE_APPLICATION_ERROR(-20000,'EL lote '||:P557_ID_LOTE||' está reservado por el Propietario');
                                    ELSIF ( ( nvl(v_estado,'X') = 'E') and ( nvl(vpropiet,'N') = 'S' )  ) THEN
                                        RAISE_APPLICATION_ERROR(-20000,'EL lote '||:P557_ID_LOTE||' tiene una Reserva Activa');
                                    END IF;
                    		  
                            BEGIN
                    		    select id_moneda
                    		      into :P557_ID_MONEDA
                    		      from ltw_lotes
                    		     where id_empresa  = :P0_ID_EMPRESA
                    		       and id_fraccion = :P557_ID_FRACCION
                    		       and id_manzana  = :P557_ID_MANZANA
                    		       and id     = :P557_ID_LOTE;
                    		  EXCEPTION
                    		  	WHEN no_data_found THEN
                    		  	  RAISE_APPLICATION_ERROR(-20000,'La moneda no Existe.');
                    		  	  :P557_ID_LOTE := null;
                    		  	WHEN others THEN
                    		  	  RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el la moneda del lote - '||sqlerrm);
                    		  END;
                    	    END ;
                        END IF ;
                    END;
                    :P557_IND_BUSCAR_COND_LOTES:='N';
                    
                    ```
                itemsToSubmit: [
                    P557_ID_FRACCION
                    P557_ID_MANZANA
                    P557_ID_LOTE
                    P557_DOBLE_CARGA_LOTE
                ]
                itemsToReturn: P557_IND_BUSCAR_COND_LOTES
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_BUSCAR_COND_LOTES
                value: S
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P557_IND_DIRECTO:='S';
                    :P557_IND_ALERT:='N';
                    ```
                itemsToReturn: [
                    P557_IND_DIRECTO
                    P557_IND_ALERT
                ]
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_ALERT
                value: S
            }
        )

    )

    validation validar-refinanciacion (
        name: Validar Refinanciacion
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P557_ID_MOTIVO_REFINAN IS NOT NULL AND :P557_IND_REFINANCIACION<>'S' THEN
