                                   END IF;
                    OPEN L_CURSOR FOR 
                    SELECT  C001 AS FECHA_VENCIMIENTO,
                            C002 AS TOT_CUOTA        ,
                            C003 AS PORC_IVA         ,
                            C004 AS TOT_IVA          ,
                            C005 AS MONTO_CUOTA      ,
                            C006 AS NRO_CUOTA        ,
                            C007 AS INDICE_CUOTA     ,
                            C008 AS DIAS 
                            FROM APEX_COLLECTIONS
                            WHERE COLLECTION_NAME='TMP_CUOTAS_LT'
                            ORDER BY TO_NUMBER(NRO_CUOTA) DESC ;
                           
                    
                    
                              APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P557_JSON_CUOTAS:=JSON_DETALLE;
                    
                    
                    
