    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 30
            region: @datos-generales
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P557_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button cuotas-especiales (
        buttonName: CUOTAS_ESPECIALES
        label: "Previsión cuota especial "
        layout {
            sequence: 20
            region: @cuotas-2
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-exclamation
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @datos-generales
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: "Desea borrar el registro ? "
            style: warning
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P557_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

