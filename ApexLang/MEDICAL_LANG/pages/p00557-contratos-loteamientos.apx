    computation p557-nro-comprobante (
        itemName: P557_NRO_COMPROBANTE
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante LTW_CONTRATOS.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P557_NRO_COMPROBANTE IS  NULL THEN
                SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                INTO v_nro_comprobante
                FROM
                LTW_CONTRATOS 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P557_SER_COMPROBANTE=SER_COMPROBANTE
                AND :P557_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P557_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
    )

