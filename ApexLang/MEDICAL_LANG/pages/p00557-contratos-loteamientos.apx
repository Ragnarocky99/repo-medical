                value: S
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF(  ( nvl(:P557_IND_PLAN_ESPECIAL,'N') = 'N' ) and
                    	   ( :P557_ID is null ) ) THEN
                    			--	go_block('B_CUOTAS');
                    	  :P557_IND_GENERAR_CUOTAS:='S';	  --	  generar_cuotas;
                    --	mensaje('1');
                    ELSIF(  ( nvl(:P557_IND_PLAN_ESPECIAL,'N') = 'S' ) and
                    	   ( :P557_ID is null ) ) THEN
                            --go_block('B_CUOTAS');
                         :P557_IND_GENERAR_CUOTAS_ESPECIALES:='S';     -- generar_cuotas_especiales;
                    
                    ---	mensaje('2');
                    ELSIF(  ( nvl(:P557_IND_PLAN_ESPECIAL,'N') = 'S' ) and
                    	   ( :P557_ID is not null ) and nvl(:P557_IND_REFINANCIACION,'N') ='S') THEN
                    	----	mensaje('3');
                    BEGIN
                    				:P557_IND_ALERT_REFINANCIADO:='S' ; --		    generar_cuotas_refinancia;
                     END;
                    else
                    	RAISE_APPLICATION_ERROR(-20000,'No se genero ninguna cuota');
                    END IF;
                    ```
                itemsToSubmit: [
                    P557_IND_PLAN_ESPECIAL
                    P557_IND_REFINANCIACION
                    ID
                    P557_ID
                ]
                itemsToReturn: [
                    P557_IND_GENERAR_CUOTAS
                    P557_IND_GENERAR_CUOTAS_ESPECIALES
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

