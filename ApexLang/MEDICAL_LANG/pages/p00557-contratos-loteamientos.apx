    dynamicAction cambio-y-decimales (
        name: Cambio y Decimales
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P557_ID_MONEDA
        }

        action cambio (
            name: Cambio
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: FTIPOS_CAMBIO(:P557_ID_MONEDA,SYSDATE,'C','V')
                itemsToSubmit: P557_ID_MONEDA
            }
            affectedElements {
                selectionType: items
                items: P557_TIP_CAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action decimales (
            name: Decimales
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DECIMALES  
                    FROM BSW_MONEDAS
                    WHERE ID=:P557_ID_MONEDA;
                    ```
                itemsToSubmit: P557_ID_MONEDA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P557_DECIMALES
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

