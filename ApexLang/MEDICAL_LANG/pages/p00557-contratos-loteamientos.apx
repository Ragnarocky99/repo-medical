page 557 (
    name: Contratos Loteamientos
    alias: CONTRATOS-LOTEAMIENTOS
    title: Contratos Loteamientos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial" ,serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;}
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region clientes (
        name: Clientes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_CONTRATO,
                       ID_CLIENTE,
                       IND_DEFECTO,
                       ID_USUARIO,
                       NRO_ORDEN,
                       IND_MIGRADO,
                       ID_ESTADO_CIVIL,
                       NOMBRE_CONYUGE,
                       DOC_CONYUGE
                  from LTW_CLIENTES_CONTRATOS
                 where ID_CONTRATO=:P557_ID
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contrato
            slot: subRegions
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--noBorder
                t-Region--scrollBody
                margin-bottom-none
            ]
        }
        advanced {
            customAttributes: tabindex="18"
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 93255060380927225
        }

        savedReport 942559 (
