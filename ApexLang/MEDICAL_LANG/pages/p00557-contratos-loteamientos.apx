    region plan-especial (
        name: Plan Especial
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_CONTRATO,
                       NRO_ORDEN,
                       ID_FRACCION,
                       ID_MANZANA,
                       ID_LOTE,
                       NRO_CUOTA_DESDE,
                       NRO_CUOTA_HASTA,
                       TOT_CUOTA,
                       IND_MIGRADO,
                       REFINANCIADO,
                       REFINAN_AUTORIZADO,
                       FEC_AUTORIZADO,
                       IND_REFUERZO,
                       MONTO_CUOTA,
                       MONTO_REFUERZO,
                       ID_FRACCION_ORIGINAL,
                       ID_MANZANA_ORIGINAL,
                       ID_LOTE_ORIGINAL,
                       NRO_CONTRATO_ORIGINAL,
                       (nvl(nro_cuota_hasta,0)-nvl(nro_cuota_desde,0) + 1)*nvl(tot_cuota,0) AS MONTO_TOTAL
                  from LTW_PLAN_PAGOS_ESPECIALES
                ```
            pageItemsToSubmit: P557_ID
        }
        layout {
            sequence: 50
            parentRegion: @contrato
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: PlanEspecial
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
