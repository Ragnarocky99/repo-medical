                    P557_TOT_GRAVADAS
                    P557_JSON_CUOTAS
                ]
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_PLAN_ESPECIAL
                value: S
            }
        )

        action insertar-cuotas (
            name: INSERTAR_CUOTAS
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P557_JSON_CUOTAS'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    $model.setValue($newRecord, "FEC_VENCIMIENTO",(json_detalle.DETALLE[i].FECHA_VENCIMIENTO).toString());
                    $model.setValue($newRecord, "TOT_CUOTA",(json_detalle.DETALLE[i].TOT_CUOTA).toString());
                    $model.setValue($newRecord, "NRO_CUOTA",(json_detalle.DETALLE[i].NRO_CUOTA).toString());
                    $model.setValue($newRecord, "TOT_IVA",(json_detalle.DETALLE[i].TOT_IVA).toString());
                    $model.setValue($newRecord, "TOT_SALDO",(json_detalle.DETALLE[i].MONTO_CUOTA).toString());
                    
                    
                    
                    
                    
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P557_IND_GENERAR_CUOTAS
                value: S
            }
        )

        action insertar-cuotas-especiales (
            name: INSERTAR_CUOTAS_ESPECIALES
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P557_JSON_CUOTAS'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
