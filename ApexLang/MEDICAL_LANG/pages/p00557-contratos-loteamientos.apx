    dynamicAction key-next-item-id-condicion-venta (
        name: KEY-NEXT_ITEM-ID_CONDICION_VENTA
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P557_ID_CONDICION_VENTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P557_ID_CONDICION_VENTA IS NULL THEN
                       RAISE_APPLICATION_ERROR (-20000,'Debe ingresar un Código de Condición de Venta.');
                    ELSE
                    
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      l_json   clob        ;
                       BEGIN
                    	    select cuota_hasta, tot_cuota
                    	      into :P557_CANT_CUOTAS, :P557_MONTO_CUOTA
                    	      from ltw_lotes_det
                    	     where id_empresa 					= :P0_ID_EMPRESA
                    	       and id_condicion_venta 	        = :P557_ID_CONDICION_VENTA
                    	       and id_fraccion 				    = :P557_ID_FRACCION
                    	       and id_manzana 					= :P557_ID_MANZANA
                    	       and id_lote 						= :P557_ID_LOTE;
                       EXCEPTION
                       		when too_many_rows then
                       		CARGA_PLAN_ESPECIAL(:P0_ID_EMPRESA,
                                                :P557_ID_FRACCION,
                                                :P557_ID_MANZANA,
                                                :P557_ID_LOTE,
                                                :P557_ID_CONDICION_VENTA,
                                                :P557_TIP_COMPROBANTE,
                                                :P557_SER_COMPROBANTE,
                                                :P557_NRO_COMPROBANTE,
                                                :P557_CANT_CUOTAS,
                                                :P557_IND_PLAN);
                            
                                                
                    
                            OPEN L_CURSOR FOR  
                            SELECT  C001 AS ID_EMPRESA,
                                    C002 AS TIP_COMPROBANTE,
                                    C003 AS SER_COMPROBANTE,
                                    C005 AS ID_FRACCION    ,
                                    C006 AS ID_MANZANA     ,
                                    C007 AS ID_LOTE        ,
                                    C008 AS CUOTA_DESDE    ,
                                    C009 AS CUOTA_HASTA    ,
                                    C010 AS TOT_CUOTA      ,
                                    C011 AS TOT_MONTO      
                            FROM APEX_COLLECTIONS
                            WHERE COLLECTION_NAME='TMP_PLAN_ESPECIAL'
                            ORDER BY CUOTA_DESDE ASC;
                    
                              APEX_JSON.initialize_clob_output;
                    
                              APEX_JSON.open_object;
                              APEX_JSON.write('DETALLE', l_cursor);
                              APEX_JSON.close_object;
                    
                              l_json:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                             :P557_JSON_PLAN_ESPECIAL:=l_json;
                    
                    
                    
                          
                    DBMS_LOCK.SLEEP(0.6);
                           
                    	  	WHEN no_data_found THEN
                    	  	  RAISE_APPLICATION_ERROR(-20000,'No existe la condición de venta para el Lote');
                    	  	WHEN others THEN
                    	  	  RAISE_APPLICATION_ERROR(-20000,'Error en la tabla detalle de lotes - '||sqlerrm);
                    	  END;	
                    END IF;
                    
                    
                    ```
                itemsToSubmit: [
                    P557_ID_CONDICION_VENTA
                    P557_ID_FRACCION
                    P557_ID_MANZANA
                    P557_ID_LOTE
                    P557_TIP_COMPROBANTE_REF
                    P557_TIP_COMPROBANTE
                    P557_SER_COMPROBANTE
                    P557_NRO_COMPROBANTE
                ]
                itemsToReturn: [
                    P557_CANT_CUOTAS
                    P557_IND_PLAN
                    P557_JSON_PLAN_ESPECIAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P557_JSON_PLAN_ESPECIAL'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("PlanEspecial").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    $model.setValue($newRecord, "NRO_CUOTA_DESDE",(json_detalle.DETALLE[i].CUOTA_DESDE).toString());
                    $model.setValue($newRecord, "NRO_CUOTA_HASTA",(json_detalle.DETALLE[i].CUOTA_HASTA).toString());
                    $model.setValue($newRecord, "TOT_CUOTA",(json_detalle.DETALLE[i].TOT_CUOTA).toString());
                    $model.setValue($newRecord, "MONTO_CUOTA",(json_detalle.DETALLE[i].TOT_CUOTA).toString());
                    $model.setValue($newRecord, "MONTO_TOTAL",(json_detalle.DETALLE[i].TOT_MONTO).toString());
                    
                    
                    
                    
                    
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT * FROM APEX_COLLECTIONS
                    WHERE COLLECTION_NAME='TMP_PLAN_ESPECIAL';
                    ```
            }
        )

    )

