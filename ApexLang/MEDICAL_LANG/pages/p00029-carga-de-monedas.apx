        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 110
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-monedas
            column: TIPO_CAMBIO
            dataType: number
        }
    )

    pageItem P29_TIPO_CAMBIO_COMPRA (
        type: numberField
        label {
            label: <p>Tipo Cambio Compra:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
