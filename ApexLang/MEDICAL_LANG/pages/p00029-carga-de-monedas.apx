    pageItem P29_TIPO_CAMBIO_DIA (
        type: numberField
        label {
            label: <p>Tipo Cambio Día:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
