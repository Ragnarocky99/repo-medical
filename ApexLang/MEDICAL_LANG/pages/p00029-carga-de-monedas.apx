    pageItem P29_SIGLAS_TESAKA (
        type: textField
        label {
            label: <p>Siglas Tesaka:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 130
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
