page 29 (
    name: Carga de Monedas
    alias: CARGA-DE-MONEDAS
    title: Carga de Monedas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P29_COD_MONEDA").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-monedas (
        name: Carga de Monedas
        type: form
        source {
            location: localDatabase
            tableName: BSW_MONEDAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P29_COD_MONEDA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Moneda:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 4
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-monedas
            column: COD_MONEDA
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_MONEDA)), 0)+1
                from BSW_MONEDAS A
                --WHERE A.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

    pageItem P29_COD_MONEDA_FE (
        type: textField
        label {
            label: <p>Cód. Moneda FE:</p>
            alignment: left
        }
        layout {
            sequence: 120
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 3
        }
        source {
            formRegion: @carga-de-monedas
            column: COD_MONEDA_FE
            dataType: varchar2
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P29_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-monedas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-monedas
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P29_DECIMALES (
        type: numberField
        label {
            label: <p>Decimales:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 8
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-monedas
            column: DECIMALES
            dataType: number
        }
    )

    pageItem P29_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 60
        }
        source {
            formRegion: @carga-de-monedas
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P29_FEC_TIPO_CAMBIO (
        type: datePicker
        label {
            label: <p>Fecha Tipo Cambio:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 100
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-monedas
            column: FEC_TIPO_CAMBIO
            dataType: date
        }
    )

    pageItem P29_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-monedas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-monedas
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P29_ID_PAIS (
        type: popupLov
        label {
            label: <p>País:</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-paises
        }
        layout {
            sequence: 70
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-monedas
            column: ID_PAIS
            dataType: number
        }
    )

    pageItem P29_SIGLAS (
        type: textField
        label {
            label: <p>Siglas:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 150
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
