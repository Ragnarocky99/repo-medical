        }
        source {
            formRegion: @carga-de-monedas
            column: SIGLAS
            dataType: varchar2
        }
    )

    pageItem P29_SIGLAS_DNCP (
        type: textField
        label {
            label: <p>Sigla DNCP:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 160
            region: @carga-de-monedas
            slot: regionBody
            alignment: left
