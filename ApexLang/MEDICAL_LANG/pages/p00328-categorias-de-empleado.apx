page 328 (
    name: Categorias de Empleado
    alias: CATEGORIAS-DE-EMPLEADO
    title: Categorias de Empleado
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region categorias (
        name: Categorias
        type: interactiveReport
        source {
            location: localDatabase
            tableName: RHW_CATEGORIAS
        }
        layout {
            sequence: 10
            slot: body
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 329
                items: {
                    P329_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12539636056311229
        }

        column COD_CATEGORIA (
            type: plainText
            heading {
                heading: Código Categoría
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Categorias
        }

        savedReport 131000 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CATEGORIA (
                sequence: 3
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @categorias
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 329
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction when-dialog-closes (
        name: When dialog closes
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @categorias
        }

        action when-dialog-closes (
            name: When dialog closes
            action: refresh
            affectedElements {
                selectionType: region
                region: @categorias
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

