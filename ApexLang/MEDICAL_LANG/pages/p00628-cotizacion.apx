        action cant-reservada (
            name: CANT_RESERVADA
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                        IF NVL(:CANT_ANULADA, 0) > 0 THEN
                            RETURN :CANT_RESERVADA - :CANT_ANULADA;
                        END IF;
                    
                        IF NVL(:CANT_ANULADA, 0) = 0 THEN
                            RETURN NVL(:CANTIDAD_APROBADA, 0);
                        END IF;
                    
                    END;
