    dynamicAction acciones-al-cambiar-cant-aprobada (
        name: Acciones al cambiar Cant. Aprobada
        execution {
            sequence: 340
        }
        when {
            selectionType: columns
            interactiveGrid: @cotizacion-de-compras
            columns: CANTIDAD_APROBADA
        }

        action cant-reservada (
            name: CANT_RESERVADA
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VSALDO_STOCK NUMBER;
                        VID_SUCURSAL NUMBER;
                    BEGIN
                        BEGIN
                            SELECT SU.ID_SUCURSAL_CENTRAL
                              INTO VID_SUCURSAL
                              FROM VTW_PEDIDOS_CABECERA PC
                              JOIN BSW_SUCURSALES       SU ON SU.ID = PC.ID_SUCURSAL
                             WHERE PC.ID = :ID_PEDIDO;
                        EXCEPTION
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error obteniendo la sucursal del pedido. Err '||SQLERRM);
                        END;
                    
                        VSALDO_STOCK := /*OBTENER_CANTIDAD_EXISTENTE(:ID_ARTICULO, VID_SUCURSAL, 'S')*/:DISPONIBILIDAD;
                        IF VSALDO_STOCK >= REPLACE(:CANTIDAD_APROBADA, '.', '') THEN
                            RETURN REPLACE(:CANTIDAD_APROBADA, '.', '');
                        END IF;
                    
                        IF VSALDO_STOCK > 0 THEN
                            RETURN VSALDO_STOCK;
                        END IF;
                    
                        RETURN NULL;
                    END;
                    ```
                itemsToSubmit: [
                    ID_PEDIDO
                    ID_ARTICULO
                    CANTIDAD_APROBADA
                    DISPONIBILIDAD
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: CANT_RESERVADA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                column: CANTIDAD_APROBADA
            }
        )

        action cant-reservada-2 (
            name: CANT_RESERVADA
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    CMWK_COTIZACIONES.CALCULA_RESERVA(P_ID_EMPRESA    => :P0_ID_EMPRESA,
                                                      P_ID_ARTICULO   => :ID_ARTICULO,
                                                      P_ID_SUCURSAL   => :ID_SUCURSAL,
                                                      P_CANT_APROBADA => :CANTIDAD_APROBADA)
                    ```
                itemsToSubmit: [
                    ID_SUCURSAL
                    ID_ARTICULO
                    CANTIDAD_APROBADA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: CANT_RESERVADA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action precio-total (
            name: PRECIO_TOTAL
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VCANTIDAD NUMBER;
                    BEGIN
                        IF NVL(:CANTIDAD_APROBADA, 0) > 0 THEN
                            VCANTIDAD := :CANTIDAD_APROBADA;
                        ELSE
                            VCANTIDAD := :CANTIDAD;
                        END IF;
                        
                        RETURN REPLACE(:PRECIO_UNITARIO, '.', '') * VCANTIDAD;
                    END;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO
                    CANTIDAD_APROBADA
                    CANTIDAD
                ]
            }
            affectedElements {
                selectionType: columns
                columns: PRECIO_TOTAL
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction actualizar-disponibilidad (
        name: Actualizar Disponibilidad
        execution {
            sequence: 290
        }
        when {
            selectionType: columns
            interactiveGrid: @cotizacion-de-compras
            columns: NRO_OCC
        }

        action cant-reservada (
            name: CANT_RESERVADA
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VSALDO_STOCK NUMBER;
                        VID_SUCURSAL NUMBER;
                    BEGIN
                        BEGIN
                            SELECT SU.ID_SUCURSAL_CENTRAL
                              INTO VID_SUCURSAL
                              FROM VTW_PEDIDOS_CABECERA PC
                              JOIN BSW_SUCURSALES       SU ON SU.ID = PC.ID_SUCURSAL
                             WHERE PC.ID = :ID_PEDIDO;
                        EXCEPTION
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error obteniendo la sucursal del pedido. Err '||SQLERRM);
                        END;
                    
                        VSALDO_STOCK := /*OBTENER_CANTIDAD_EXISTENTE(:ID_ARTICULO, VID_SUCURSAL, 'S')*/:DISPONIBILIDAD;
                        IF VSALDO_STOCK >= REPLACE(:CANTIDAD_APROBADA, '.', '') THEN
                            RETURN REPLACE(:CANTIDAD_APROBADA, '.', '');
                        END IF;
                    
                        IF VSALDO_STOCK > 0 THEN
                            RETURN VSALDO_STOCK;
                        END IF;
                    
                        RETURN NULL;
                    END;
                    ```
                itemsToSubmit: [
                    ID_PEDIDO
                    ID_ARTICULO
                    CANTIDAD_APROBADA
                    DISPONIBILIDAD
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: CANT_RESERVADA
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                column: CANTIDAD_APROBADA
            }
        )

        action cant-reservada-nulo (
            name: CANT_RESERVADA - NULO
            action: setValue
            affectedElements {
                selectionType: columns
                columns: CANT_RESERVADA
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                column: APROBAR
                value: S
            }
        )

        action disponibilidad (
            name: DISPONIBILIDAD
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                     vid_sucursal bsw_sucursales.id%type;
                     vcantidad_bloqueo_actual number := 0;
                     vdisponibilidad number;
                    begin
                      -- Verificamos la sucursal
                      if :id_sucursal not in (1, 690) then -- Oficina y Licitacion
                        vid_sucursal := 1; -- Tiene que tomar la sucursal central si no es oficina o licitacion
                      else
                        vid_sucursal := :id_sucursal;
                      end if;
                    
                      --raise_application_error(-20000, 'art '||:id_articulo||' suc '||vid_sucursal||' ped '||:id_pedido||' ped det '||:id_pedido_det||' nro occ'||:nro_occ);
                      -- Obtenemos el bloqueo actual para evitar conflictos
                      begin
                        select sum(nvl(cant_bloqueo, 0))
                          into vcantidad_bloqueo_actual
                          from stwv_articulos_bloqueo
                         where id_articulo   = :id_articulo
                           and id_sucursal   = vid_sucursal
                           and id_pedido     = :id_pedido
                           and id_pedido_det = :id_pedido_det
                           and nro_occ       = :nro_occ;
                      exception
                        when others then
                            vcantidad_bloqueo_actual := 0;
                      end;
                      
                      --raise_application_error(-20000, :cantidad_aprobada);
                      -- Si estoy aprobando calculo la disponibilidad en ese instante (sin contar este). Y verifico que no se dispare al anular
                      if (nvl(:cantidad_aprobada, 0) - nvl(:cant_anulada, 0)) > 0 then
                          --raise_application_error(-20000, obtener_cantidad_existente(:id_articulo, vid_sucursal, 'S'));
                        vdisponibilidad := nvl(obtener_cantidad_existente(:id_articulo, vid_sucursal, 'S'), 0) + nvl(vcantidad_bloqueo_actual, 0);
                      end if;
                      
                      if (nvl(:cantidad_aprobada, 0) - nvl(:cant_anulada, 0) = 0) then
                        vdisponibilidad := null;
                      end if;
                    
                      return vdisponibilidad;
                    end;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    CANTIDAD_APROBADA
                    ID_SUCURSAL
                    CANT_ANULADA
                    ID_PEDIDO
                    ID_PEDIDO_DET
                    NRO_OCC
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: DISPONIBILIDAD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: APROBAR
                value: S
            }
            serverSideCondition {
                type: never
            }
        )

