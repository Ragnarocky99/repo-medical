        )

        action cantidad-copia (
            name: CANTIDAD_COPIA
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_COPIA
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        V_CANT_APRO NUMBER(15);
                        V_CANT_AUX  NUMBER(18,5);
                        V_DECIMALES NUMBER := 0;
                    BEGIN
                        BEGIN
                          SELECT DECIMALES 
                            INTO V_DECIMALES
                          FROM BSW_MONEDAS MO
                          WHERE MO.ID = :ID_MONEDA_PRECIO;
                        EXCEPTION
                          WHEN OTHERS THEN
                            V_DECIMALES := 0;
                        END;
                        IF :CANTIDAD IS NULL THEN 
                           :CANTIDAD :=1;
                        END IF;
                    
                        IF :PRECIO_RECARGO IS NULL THEN
                          :PRECIO_RECARGO :=0;
                        END IF;
                    
                    
                        IF :PORC_MARGEN IS NULL THEN
                          :PORC_MARGEN :=0;
                        END IF;
                    
                        IF :MARGEN_UNITARIO IS NULL THEN
                          :MARGEN_UNITARIO := 0;
                        END IF;
                    
                        IF :CANTIDAD_APROBADA = 0 THEN
                            V_CANT_APRO := 0;
                        ELSE
                            V_CANT_APRO := :CANTIDAD_APROBADA; 
                        END IF;
                        --AGREGADO 22/01/2024
                        IF NVL(:CANTIDAD_APROBADA,0) > 0 THEN
                           V_CANT_AUX := :CANTIDAD_APROBADA;
                        ELSE 
                           V_CANT_AUX := :CANTIDAD;  
                        END IF;
                            
                    
                        --:MON_COSTO       := :CANTIDAD*(replace(:PRECIO_RECARGO,'.',''));
                        :MARGEN_UNITARIO := ((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.',''));
                        :MARGEN_TOTAL    := (((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.',''))*(V_CANT_AUX/*NVL(V_CANT_APRO,:CANTIDAD*/));
                    
                        IF :ID_MONEDA = nvl(:ID_MONEDA_PRECIO,:id_moneda) THEN
                          :PRECIO_SUGERIDO := ROUND(((replace(:PRECIO_RECARGO,'.',''))+((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.',''))),V_DECIMALES);
                          --:PRECIO_TOTAL    := ROUND(((replace(:PRECIO_SUGERIDO,'.',''))*(V_CANT_AUX)),V_DECIMALES);
                        ELSE
                          :PRECIO_SUGERIDO := ROUND((((replace(:PRECIO_RECARGO,'.',''))+((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.','')))*replace(:CAMBIO,'.','')/replace(:TIP_CAMBIO_MONEDA_PRECIO,'.','')),V_DECIMALES);
                          --:PRECIO_TOTAL    := ROUND(((replace(:PRECIO_SUGERIDO,'.',''))*(nvl(V_CANT_AUX,0))),V_DECIMALES);
                        END IF;
                       EXCEPTION
                        WHEN OTHERS THEN
                         RAISE_APPLICATION_ERROR(-20000,'Error al calcular: '||dbms_utility.format_error_backtrace);
                    END;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_RECARGO
                    PORC_MARGEN
                    MARGEN_UNITARIO
                    CANTIDAD_APROBADA
                    ID_MONEDA_PRECIO
                    TIP_CAMBIO_MONEDA_PRECIO
                    ID_MONEDA
                    CAMBIO
                    PRECIO_SUGERIDO
                ]
                itemsToReturn: [
                    MARGEN_UNITARIO
                    MARGEN_TOTAL
                    PRECIO_SUGERIDO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                column: PORC_MARGEN
                value: 0
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        V_CANT_APRO NUMBER(15);
                        V_CANT_AUX  NUMBER(18,5);
                        V_DECIMALES NUMBER := 0;
                    BEGIN
                        BEGIN
                          SELECT DECIMALES 
                            INTO V_DECIMALES
                          FROM BSW_MONEDAS MO
                          WHERE MO.ID = :ID_MONEDA_PRECIO;
                        EXCEPTION
                          WHEN OTHERS THEN
                            V_DECIMALES := 0;
                        END;
                        IF :CANTIDAD IS NULL THEN 
                           :CANTIDAD :=1;
                        END IF;
                    
                        IF :PRECIO_RECARGO IS NULL THEN
                          :PRECIO_RECARGO :=0;
                        END IF;
                    
                    
                        IF :PORC_MARGEN IS NULL THEN
                          :PORC_MARGEN :=0;
                        END IF;
                    
                        IF :MARGEN_UNITARIO IS NULL THEN
                          :MARGEN_UNITARIO := 0;
                        END IF;
                    
                        IF :CANTIDAD_APROBADA = 0 THEN
                            V_CANT_APRO := 0;
                        ELSE
                            V_CANT_APRO := :CANTIDAD_APROBADA; 
                        END IF;
                        --AGREGADO 22/01/2024
                        IF NVL(:CANTIDAD_APROBADA,0) > 0 THEN
                           V_CANT_AUX := :CANTIDAD_APROBADA;
                        ELSE 
                           V_CANT_AUX := :CANTIDAD;  
                        END IF;
                            
                    
                        :MON_COSTO       := :CANTIDAD*(replace(:PRECIO_RECARGO,'.',''));
                        :MARGEN_UNITARIO := ((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.',''));
                        :MARGEN_TOTAL    := (((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.',''))*(V_CANT_AUX/*NVL(V_CANT_APRO,:CANTIDAD*/));
                    
                        IF :PRECIO_UNITARIO IS NULL OR REPLACE(:PRECIO_UNITARIO, '.', '') = 0 THEN
                            IF :ID_MONEDA = nvl(:ID_MONEDA_PRECIO,:id_moneda) THEN
                              :PRECIO_UNITARIO := ROUND(((replace(:PRECIO_RECARGO,'.',''))+((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.',''))) /** (1 + NVL(:PORC_AJUSTE / 100, 0))*/,V_DECIMALES);
                              :PRECIO_TOTAL    := ROUND(((replace(:PRECIO_UNITARIO,'.',''))*(V_CANT_AUX)),V_DECIMALES);
                            ELSE
                              :PRECIO_UNITARIO := ROUND((((replace(:PRECIO_RECARGO,'.',''))+((replace(:PRECIO_RECARGO,'.',''))/ 100)*(replace(:PORC_MARGEN,'.','')))*replace(:CAMBIO,'.','')/replace(:TIP_CAMBIO_MONEDA_PRECIO,'.','')) /** (1 + NVL(:PORC_AJUSTE / 100, 0))*/,V_DECIMALES);
                              :PRECIO_TOTAL    := ROUND(((replace(:PRECIO_UNITARIO,'.',''))*(nvl(V_CANT_AUX,0))),V_DECIMALES);
                            END IF;
                        ELSE
                            IF REPLACE(:PRECIO_SUGERIDO, '.', '') != 0 THEN
                                :PORC_AJUSTE := 100 * ((REPLACE(:PRECIO_UNITARIO, '.', '') / REPLACE(:PRECIO_SUGERIDO, '.', '')) - 1);
                            ELSE
                                :PORC_AJUSTE := 0;
                            END IF;
                        END IF;
                       EXCEPTION
                        WHEN OTHERS THEN
                         RAISE_APPLICATION_ERROR(-20000,'Error al calcular: '||dbms_utility.format_error_backtrace);
                    END;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_RECARGO
                    PORC_MARGEN
                    MARGEN_UNITARIO
                    CANTIDAD_APROBADA
                    ID_MONEDA_PRECIO
                    TIP_CAMBIO_MONEDA_PRECIO
                    ID_MONEDA
                    CAMBIO
                    PRECIO_UNITARIO
                    PORC_AJUSTE
                ]
                itemsToReturn: [
                    MON_COSTO
                    MARGEN_UNITARIO
                    MARGEN_TOTAL
                    PRECIO_UNITARIO
                    PRECIO_TOTAL
                    PORC_AJUSTE
                ]
                showProcessing: true
