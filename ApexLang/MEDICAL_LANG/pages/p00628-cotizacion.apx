    process guardar-estado-vtw-pedidos (
        name: Guardar estado vtw_pedidos
        type: interactiveGridAutoRowProcessing
        editableRegion: @cotizacion-de-compras
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                BEGIN -- It runs row by row for interactive grid
                    IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                        
                        RETURN;
                    ELSIF :APEX$ROW_STATUS = 'C' THEN -- CREATE
                        IF :IND_ENVIO = 'S' THEN
                            UPDATE VTW_PEDIDOS_CABECERA
                            SET ESTADO = 'EN'
                            WHERE ID = :ID_PEDIDO;
                        END IF;
                        RETURN;
                    ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                        IF :IND_ENVIO = 'S' THEN
                            UPDATE VTW_PEDIDOS_CABECERA
                            SET ESTADO = 'EN'
                            WHERE ID = :ID_PEDIDO;
                        END IF;
                        RETURN;
                    END IF;
                END;
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 71830745953125000
        }
        serverSideCondition {
            type: never
        }
    )

    process re-calcula-reserva (
        name: Re-Calcula Reserva
        type: executeCode
        editableRegion: @cotizacion-de-compras
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSALDO_STOCK    NUMBER;
                    VCANT_RESERVADA NUMBER;
                    VID_SUCURSAL    NUMBER;
                    VIND_ACTUALIZAR VARCHAR2(1) := 'N';
                    VCANT_REAL      NUMBER;
                    VDISPONIBILIDAD NUMBER;
                    VSEQ_ID         NUMBER;
                BEGIN
                    VCANT_REAL := NVL(:CANTIDAD_APROBADA, 0) - NVL(:CANT_ANULADA, 0);
                    --VDISPONIBILIDAD := :DISPONIBILIDAD;
                    BEGIN
                        SELECT SU.ID_SUCURSAL_CENTRAL
                          INTO VID_SUCURSAL
                          FROM VTW_PEDIDOS_CABECERA PC
                          JOIN BSW_SUCURSALES       SU ON SU.ID = PC.ID_SUCURSAL
                         WHERE PC.ID = :ID_PEDIDO;
                    EXCEPTION
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, 'Error obteniendo la sucursal del pedido. Err '||SQLERRM);
                    END;
                
                    -- Comprobamos si debemos actualizar la fila
                    BEGIN
                        SELECT 'S'
                          INTO VIND_ACTUALIZAR
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'COTIZACION_COL'
                           AND N001 = :ID
                           AND VCANT_REAL != N003
                           AND VCANT_REAL > 0;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VIND_ACTUALIZAR := 'N';
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, 'Error verificando si falta actualizar reserva. '||SQLERRM);
                    END;
                    IF VIND_ACTUALIZAR = 'S' THEN
                        -- Verificamos si reservamos el mismo articulo en esta cotizacion
                        BEGIN
                            SELECT SUM(N002)
                              INTO VCANT_RESERVADA
                              FROM APEX_COLLECTIONS
                             WHERE COLLECTION_NAME = 'COTIZACION_COL'
                               AND C002 = :ID_ARTICULO
                               AND N001 != :ID;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                VCANT_RESERVADA := 0;
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'Error recalulando reserva. '||SQLERRM);
                        END;
                        
                        --VSALDO_STOCK := OBTENER_CANTIDAD_EXISTENTE(:ID_ARTICULO, VID_SUCURSAL, 'S') - NVL(VCANT_RESERVADA, 0);
                        VSALDO_STOCK := CMWK_COTIZACIONES.TRAE_RESERVA_DISPONIBLE(P_ID_EMPRESA  => :P0_ID_EMPRESA,
                                                                                  P_ID_ARTICULO => :ID_ARTICULO,
                                                                                  P_ID_SUCURSAL => VID_SUCURSAL) - NVL(VCANT_RESERVADA, 0);
                        :DISPONIBILIDAD := VSALDO_STOCK;
                
                        --IF NVL(VCANT_RESERVADA, 0) > 0 THEN
                        --    RAISE_APPLICATION_ERROR(-20000, 'Stock '||VSALDO_STOCK);
                        --END IF;
                        IF VSALDO_STOCK >= REPLACE(:CANTIDAD_APROBADA, '.', '') THEN
                            :CANT_RESERVADA := REPLACE(:CANTIDAD_APROBADA, '.', '');
                        ELSIF VSALDO_STOCK > 0 THEN
                          :CANT_RESERVADA := VSALDO_STOCK;
                        ELSE
                          :CANT_RESERVADA := NULL;
                        END IF;
                
                        -- Actualizamos reserva
                        BEGIN
                            SELECT SEQ_ID
                              INTO VSEQ_ID
                              FROM APEX_COLLECTIONS
                             WHERE COLLECTION_NAME = 'COTIZACION_COL'
                               AND N001 = :ID;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                VSEQ_ID := NULL;
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                        END;
                        
                        IF VSEQ_ID IS NOT NULL THEN
                            APEX_COLLECTION.update_member(
                                p_collection_name => 'COTIZACION_COL',
                                p_seq             => VSEQ_ID,
                                p_c001            => :ID_SUCURSAL,
                                p_c002            => :ID_ARTICULO,
                                p_n001            => :ID,
                                p_n002            => NVL(:CANT_RESERVADA, 0)
                            );
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 65808471419809707
        }
    )

    process setear-estado-pedido (
        name: Setear estado pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_estado        inv.vtw_pedidos_cabecera.estado%type;
                    v_ind_enviado   inv.cmw_cotiza_articulos.ind_envio%type;
                    v_id_pedido     inv.vtw_pedidos_cabecera.id%type;
                begin
                    select  p.id, p.estado
                    into    v_id_pedido, v_estado
                    from    vtw_pedidos_cabecera p
                    where   p.nro_comprobante = :P628_ID_PEDIDO;
                
                    raise_application_error(-20000, v_id_pedido||' '||v_estado);
                    select  c.ind_envio
                    into    v_ind_enviado
                    from    cmw_cotiza_articulos c
                    where   c.id_pedido = v_id_pedido;
                
                    if v_ind_enviado = 'S' and v_estado = 'PA' then
                        update  vtw_pedidos_cabecera
                        set     estado = 'EN'
                        where   id = v_id_pedido;
                    end if;
                
                    if v_ind_enviado = 'N' and v_estado = 'EN' then
                        update  vtw_pedidos_cabecera
                        set     estado = 'PA'
                        where   id = v_id_pedido;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 71835480955125006
        }
        serverSideCondition {
            type: never
        }
    )

