        }
        error {
            errorMessage: Debe asignar un plazo de entrega
            associatedColumn: ID_TIPO_ENTREGA
        }
        serverSideCondition {
            type: item=value
            item: APROBAR
            value: S
        }
    )

    validation validar-cantidad-anulada (
        name: Validar cantidad anulada
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @cotizacion-de-compras
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF nvl(:ind_anulado,'N') = 'S' then
                
                 if nvl(to_number(:cantidad_aprobada),0) < nvl(to_number(:cant_anulada),0) then
                 --raise_application_error(-20000,'f');
                    return false;
                 else 
                    return true;
                 end if;
                else 
                  return true;
                end if;
                ```
        }
        error {
            errorMessage: Error, no se puede anular &CANT_ANULADA. una cantidad mayor que la aprobada &CANTIDAD_APROBADA.
            associatedColumn: CANT_ANULADA
        }
    )

    validation validar-cantidad-anulada-ocp (
        name: Validar cantidad anulada OCP
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cotizacion-de-compras
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    VCANT_ANULADA_OCP CMW_PEDIDOS_DETALLE.CANTIDAD%TYPE;
                BEGIN
                    BEGIN
                        SELECT SUM(PD.CANTIDAD) CANTIDAD
                          INTO VCANT_ANULADA_OCP
                          FROM CMW_PEDIDOS_DETALLE PD
                          JOIN CMW_COTIZA_ARTICULOS CA ON CA.ID = PD.ID_COTIZA_ART
                         WHERE CA.ID = :ID
                           AND NVL(PD.IND_ANULA_OCC, 'N') = 'S'
                        GROUP BY PD.ID_COTIZA_ART;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VCANT_ANULADA_OCP := 0;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-2000, 'Error buscando la cantidad ocp anulada. '||SQLERRM);
                    END;
                
                    IF NVL(:IND_ANULADO,'N') = 'S' THEN
                
                        IF NVL(TO_NUMBER(:CANT_ANULADA),0) <= VCANT_ANULADA_OCP THEN
                            RETURN FALSE;
                        ELSE 
                            RETURN TRUE;
                        END IF;
                    ELSE 
                        RETURN TRUE;
                    END IF;
                END;
                ```
        }
        error {
            errorMessage: La cantidad anulada supera la cantidad anulada en OCP
            associatedColumn: CANT_ANULADA
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-fec-occ-nulo (
        name: Validar Fec OCC nulo
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @cotizacion-de-compras
            type: columnIsNotNull
