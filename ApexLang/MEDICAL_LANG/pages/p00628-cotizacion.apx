page 628 (
    name: Cotizacion
    alias: COTIZACION
    title: Cotizacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            try {
              var model = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
              var v_nro_occ = model.getFieldKey("NRO_OCC");
              ////var vaprobar  = model.getFieldKey("APROBAR");
            
              var numeroIngre = $v('P628_NRO_OCC');
            
              model.forEach(function(r, index, id) {
                var meta = model.getRecordMetadata(id);
                if ((meta.fields !== undefined) && (!meta.deleted)) {
            
                  model.setValue(r, v_nro_occ, numeroIngre);
                }
              });
            
            } catch (e) {
              // Manejar errores aquí
              console.error("Se produjo un error:", e);
            }
            
            // create a private scope where $ is set to apex.jQuery
            (function($) {
                // This is the function that calculates over all the rows of the model and then
                // updates something else.
                // Change this to do whatever calculation is needed.
                // Call this whenever the model data changes.
                function update(model) {
                    var aprobarKey = model.getFieldKey("APROBAR")
            
                    var salKey = model.getFieldKey("CANTIDAD_APROBADA"),
                        total = 0;
                    var precioKey = model.getFieldKey("PRECIO_TOTAL"),
                        precio = 0;
            
                    ///console.log(">> starting sum SAL column")
                    model.forEach(function(record, index, id) {
                        var apr = record[aprobarKey];
                        var pre = parseFloat(record[precioKey].replace(/\./g,''), 10)
                        var sal = parseInt(record[salKey], 10),  // record[salKey] should be a little faster than using model.getValue in a loop
                        
                            meta = model.getRecordMetadata(id);
            
                        if (!isNaN(sal) && !meta.deleted && !meta.agg) {
                            total += sal;
                        }
                        if (!isNaN(pre) && !meta.deleted && !meta.agg) {
                           // console.log('Precio'+pre+'aprobado'+apr);
                         if (apr === 'S'  )
                          
                            precio += pre;
                        }
                        
                    });
                    ///console.log(">> setting sum SAL column to " + total)
                    console.log(precio);
                  $s("P628_CANTIDAD_TOTAL", total);
                    $s("P628_TOTAL_GENERAL", precio);
            
                    
                }
            
                //
                // This is the general pattern for subscribing to model notifications
                //
            
                // need to do this here rather than in Execute when Page Loads so that the handler
                // is setup BEFORE the IG is initialized otherwise miss the first model created event
                $(function() {
                    // the model gets released and created at various times such as when the report changes
                    // listen for model created events so that we can subscribe to model notifications
                    $("#Detalles").on("interactivegridviewmodelcreate", function(event, ui) {
                        var sid,
                            model = ui.model;
            
                        // note this is only done for the grid veiw. It could be done for
                        // other views if desired. The imporant thing to realize is that each
                        // view has its own model
                        if ( ui.viewId === "grid" ) {
                            sid = model.subscribe( {
                                onChange: function(type, change) {
                                   // console.log(">> model changed ", type, change);
                                    if ( type === "set" ) {
                                        // don't bother to recalculate if other columns change
                                        if (change.field === "CANTIDAD_APROBADA" || change.field === "PRECIO_TOTAL"   
                                        || change.field === "APROBAR"  )  {
                                            update( model );
                                        }
                                    } else if (type !== "move" && type !== "metaChange") {
                                        // any other change except for move and metaChange affect the calculation
                                        update( model );
                                    }
                                },
                                progressView: $("#P628_CANTIDAD_TOTAL"), // in theory this will cause a spinner on this field but I don't see it.
                                progressView: $("#P628_TOTAL_GENERAL")
                            } );
                            // if not lazy loaded there is no notification for initial data so update
                            update( model ); 
                            // just in case fetch all the data. Model notifications will
                            // cause calls to update so nothing to do in the callback function.
                            // can remove if data will always be less than 50 records
                            model.fetchAll(function() {});
                        }
                    });
            
                });
            
            })(apex.jQuery);
            
            function refrescarGrillaDetalle(columna){
                var view = apex.region("Detalles").call("getCurrentView").view$;
                view.grid("lockActive");
            
                setTimeout( function() {
                    view.grid( "setActiveRecordValue", columna ).grid( "unlockActive" );
                }, 100 );
            }
            
            function calcularDisponibilidad(idArticulo, disponibilidadBD){
                var ig$ = apex.region("Detalles").widget();
                var model = ig$.interactiveGrid("getViews","grid").model;
                var cod_articulok = model.getFieldKey("COD_ARTICULO");
                var cantidadk = model.getFieldKey("CANTIDAD_APROBADA");
                var aprobark = model.getFieldKey("APROBAR_COPIA");
                var aprobar;
            
                var totalPendiente = 0;
            
                // Recorremos todas las filas del modelo
                model.forEach(function(record){
                    aprobar = String(record[aprobark]).trim();
                    if(String(record[cod_articulok]).trim() === String(idArticulo).trim() && aprobar !== 'S'){
                        var cantidad = parseFloat(record[cantidadk]) || 0;
                        console.log(cantidad)
                        totalPendiente += cantidad;
                    }
                });
            
                // Retornamos la disponibilidad ajustada
                return disponibilidadBD - totalPendiente;
            }
            ```
