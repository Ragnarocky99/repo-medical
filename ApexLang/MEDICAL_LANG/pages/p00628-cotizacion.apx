    region cotizacion-de-compras (
        name: cotizacion de compras
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  C.ID,
                        C.ID_EMPRESA,
                        C.ID_SUCURSAL,
                        C.ID_ARTICULO,
                        C.ID_PROVEEDOR,
                        C.ID_MONEDA,
                        c.PRECIO_RECARGO,
                        c.PRECIO_RECARGO*c.cantidad AS mon_costo,
                        C.PRECIO AS mon_costo_copia,
                        C.APROBADO,
                        C.TIPO_IVA,
                        C.PORCENTAJE_DESCUENTO,
                        C.CANTIDAD,
                        C.CANTIDAD AS CANTIDAD_COPIA,
                        C.COD_ARTICULO_REF,
                        C.NRO_ITEM,
                        C.SALDO,
                        C.OBSERVACION,
                        C.COTIZA,
                        C.COD_USUARIO_APRO,
                        C.CAMBIO,
                        C.ID_CONDICION_VENTAS,
                        C.IND_GENERA_OC,
                        C.IND_ORDEN,
                        A.ID_ENVASE,
                        A.ID_UNIDAD_MEDIDA,
                        A.ID_MARCA,
                        A.COD_ARTICULO,
                        ---A.DESCRIPCION AS DESC_ARTICULO,
                        ---D.DESC_ARTICULO AS DESC_ARTICULO,
                        CASE WHEN  C.ID_ARTICULO != W_BUSCA_PARAMETRO('ST','ID_ART_ESTANDAR')
                        THEN A.DESCRIPCION
                        ELSE NVL(D.DESC_ARTICULO,A.DESCRIPCION) 
                        END AS DESC_ARTICULO,
                        D.DESC_ARTICULO_STD,
                        C.ID_PEDIDO,
                        C.ID_TIPO_ENTREGA,
                        C.IND_ENVIO,
                        --round(DECODE(C.PORC_MARGEN, NULL, 0, PORC_MARGEN)) AS PORC_MARGEN, modificado por el pedido 61559
                        DECODE(C.PORC_MARGEN, NULL, 0, PORC_MARGEN) AS PORC_MARGEN,
                        round(nvl(C.MARGEN_UNITARIO,0)) MARGEN_UNITARIO,
                        round(nvl(C.MARGEN_TOTAL,0)) MARGEN_TOTAL,
                        ''espacio,
                        NVL(C.ID_MONEDA_PRECIO,'32') ID_MONEDA_PRECIO,
                        C.TIP_CAMBIO_MONEDA_PRECIO,
                        round(nvl(C.PRECIO_UNITARIO,0),mo.decimales) PRECIO_UNITARIO,
                        round(nvl(C.PRECIO_TOTAL,0),mo.decimales) PRECIO_TOTAL,
                        round(nvl(C.PRECIO_TOTAL,0) / 1.1,mo.decimales) PRECIO_TOTAL_SIN_IVA,
                        round(nvl(C.CANTIDAD_APROBADA,0),mo.decimales)CANTIDAD_APROBADA,
                        C.NRO_OCC,
                        C.FEC_OCC,
                        CASE 
                            WHEN (CANTIDAD_APROBADA >0 )THEN 'S'
                            WHEN CANTIDAD_APROBADA IS NULL THEN 'N'
                            ELSE 'N'
                        END AS Aprobar,
                        nvl(C.PRECIO_TOTAL,0) as PRECIO_TOTAL_COPIA,
                        nvl(C.CANTIDAD_APROBADA,0) AS CANTIDAD_APROBADA_COPIA,
                        C.IND_ANULADO,
                        C.COD_USARIO_ANU,
                        C.FEC_ANULACION,
                        C.CANT_ANULADA,
                        C.COMENTARIO_ANULACION,
                        C.COD_USUARIO_APROB,
                        C.FEC_APROB,
                        C.COMENTARIO_APROB,
                        C.COMENTARIO_A_COMPRA,
                        A.COD_ORIGEN_ART,
                        A.ID_RUBRO,
                        A.ID_GRUPO_ART,
                        A.ESTADO,
                        C.FEC_ENVIO,
                        C.ID_PEDIDO_DET,
                        --NVL(CF_PRECIO_VENTA_ANTFORMULA(C.ID_EMPRESA,43,SYSDATE,C.ID_ARTICULO),0) PRECIO_FIJO_CIVA,
                        C.OBS_COMPRA,
                        nvl(C.IND_NO_ENVIO,'N') IND_NO_ENVIO,
                        C.INSERT_AUTO,
                        NVL((SELECT CA.PRECIO_UNITARIO
                               FROM CMW_COTIZA_ARTICULOS CA
                               JOIN VTW_PEDIDOS_CABECERA PC ON PC.ID = CA.ID_PEDIDO
                              WHERE CA.FEC_OCC IS NOT NULL
                                AND PC.ID_CLIENTE  = :P628_ID_CLIENTE
                                AND CA.ID_ARTICULO = C.ID_ARTICULO
                                AND CA.ID != C.ID
                              ORDER BY CA.FEC_OCC DESC
                              FETCH FIRST 1 ROW ONLY), 0) PRECIO_ULTIMA_OCC,
                      NVL(A.IND_CONTROLADO, 'N') IND_CONTROLADO,
                      C.IND_CLIENTE,
                      NVL(C.IND_EXCEL_AUTO, 'N') IND_EXCEL_AUTO,
                      C.OBSERVACION_AUTO,
                      C.DISPONIBILIDAD,
                      NVL(C.IND_ALTERNATIVA, 'N') IND_ALTERNATIVA,
                      C.FEC_PLAZO,
                      C.PRECIO_SUGERIDO,
                      C.PORC_AJUSTE,
                      NVL((SELECT 'S'
                             FROM STW_LOTES LO
                             JOIN STW_EXISTENCIA_ART EA ON EA.ID_LOTE = LO.ID
                            WHERE LO.ID_ARTICULO = C.ID_ARTICULO
                              AND EA.CANT_DISPON > 0
                              AND TRUNC(MONTHS_BETWEEN(TRUNC(LO.FEC_VENCIMIENTO), TRUNC(SYSDATE))) < 12
                              AND ROWNUM = 1) , 'N') IND_VENCE_LOTE,
                     C.MOTIVO_RECOTIZACION,
                     C.CANT_RESERVADA,
                     ROUND(C.PRECIO_RECARGO * C.CAMBIO) PRECIO_RECARGO_GS,
                     ROUND(C.MARGEN_TOTAL * C.CAMBIO) MARGEN_TOTAL_GS,
                     NVL((SELECT  LO.FEC_VENCIMIENTO
                             FROM STW_LOTES LO
                             JOIN STW_EXISTENCIA_ART EA ON EA.ID_LOTE = LO.ID
                             JOIN BSW_SUCURSALES     SU ON SU.ID = EA.ID_SUCURSAL
                            WHERE LO.ID_ARTICULO = C.ID_ARTICULO
                              AND EA.CANT_DISPON > 0
                              AND LO.FEC_VENCIMIENTO != TO_DATE('31/12/2099', 'dd/MM/yyyy')
                              AND SU.COD_SUCURSAL != W_BUSCA_PARAMETRO('BS', 'COD_SUCURSAL_VENCIDOS')
                              --AND TRUNC(MONTHS_BETWEEN(TRUNC(LO.FEC_VENCIMIENTO), TRUNC(SYSDATE))) < 12
                          ORDER BY LO.FEC_VENCIMIENTO
                          FETCH FIRST 1 ROW ONLY ) , C.VENCIMIENTO_PRODUCTO) VENCIMIENTO_PRODUCTO_D,
                     C.VENCIMIENTO_PRODUCTO,
                     A.PORC_EFECTIVIDAD,
                     C.IND_CONTRATO,
                     C.PRECIO_TOTAL - ROUND(C.PRECIO_RECARGO * C.CAMBIO) RECAL_MARGEN,
                     DECODE(NVL(C.PRECIO_RECARGO, 0), 0, NULL, ROUND((C.PRECIO_TOTAL / ROUND(C.PRECIO_RECARGO * C.CAMBIO) - 1) * 100, 2)) PORC_RECAL_MARKUP,
                     CASE 
                            WHEN (CANTIDAD_APROBADA >0 )THEN 'S'
                            WHEN CANTIDAD_APROBADA IS NULL THEN 'N'
                            ELSE 'N'
                     END AS APROBAR_COPIA,
                     NVL(A.IND_SOLO_MAR, 'N') IND_SOLO_MAR,
                     NVL(A.IND_SOLO_AEREO, 'N') IND_SOLO_AEREO,
                     C.IND_REFERENCIA
                FROM 
                    CMW_COTIZA_ARTICULOS C,
                    BSW_MONEDAS MO,
                    STW_ARTICULOS A,
                    VTW_PEDIDOS_DETALLE D,
                    STW_EXISTENCIA_ART E,
                    CMW_PROVEEDORES PRO
                
                WHERE 
                    C.ID_EMPRESA = :P0_ID_EMPRESA
                    -- AND C.ID = :P658_ID
                    --AND C.ID_PEDIDO = :P658_ID_PEDIDO
                    AND C.ID_PEDIDO = :P628_ID_PEDIDO_2
                    AND C.IND_CLIENTE = 'S'
                    AND A.ID         = C.ID_ARTICULO 
                    AND A.ID_EMPRESA = C.ID_EMPRESA
                    AND D.ID = C.ID_PEDIDO_DET 
                   -- AND D.ID_EMPRESA = C.ID_EMPRESA
                    AND C.ID_ARTICULO = E.ID_ARTICULO(+) 
                   -- AND C.ID_EMPRESA = E.ID_EMPRESA
                    AND C.ID_MONEDA_PRECIO = MO.ID(+)
                    AND PRO.ID(+) = C.ID_PROVEEDOR
                group by C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_ARTICULO,
                       C.ID_PROVEEDOR,
                       C.ID_MONEDA,
                       c.PRECIO_RECARGO,
                       c.PRECIO_RECARGO,
                       C.PRECIO,
                       C.APROBADO,
                       C.TIPO_IVA,
                       C.PORCENTAJE_DESCUENTO,
                       C.CANTIDAD,
                       C.COD_ARTICULO_REF,
                       C.NRO_ITEM,
                       C.SALDO,
                       C.OBSERVACION,
                       C.COTIZA,
                       C.COD_USUARIO_APRO,
                       C.CAMBIO,
                       C.ID_CONDICION_VENTAS,
                       C.IND_GENERA_OC,
                       C.IND_ORDEN,
                       A.ID_ENVASE,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MARCA,
                       A.COD_ARTICULO,
                       D.DESC_ARTICULO,
                       D.DESC_ARTICULO_STD,
                       A.DESCRIPCION,
                       C.ID_PEDIDO,
                       C.ID_TIPO_ENTREGA,
                       C.IND_ENVIO,
                       C.PORC_MARGEN,
                       C.MARGEN_UNITARIO,
                       C.MARGEN_TOTAL,
                       C.ID_MONEDA_PRECIO,
                       C.TIP_CAMBIO_MONEDA_PRECIO,
                       C.PRECIO_UNITARIO,
                       C.PRECIO_TOTAL,
                       C.CANTIDAD_APROBADA,
                       C.NRO_OCC,
                       C.FEC_OCC,
                       C.PRECIO_TOTAL,
                       C.CANTIDAD_APROBADA,
                       C.IND_ANULADO,
                       C.COD_USARIO_ANU,
                       C.FEC_ANULACION,
                       C.CANT_ANULADA,
                       C.COMENTARIO_ANULACION,
                       A.COD_ORIGEN_ART,
                       A.ID_RUBRO,
                       A.ID_GRUPO_ART,
                       C.COD_USUARIO_APROB,
                       C.FEC_APROB,
                       C.COMENTARIO_APROB,
                       C.COMENTARIO_A_COMPRA,
                       A.ESTADO,
                       C.FEC_ENVIO,
                       MO.DECIMALES,
                       C.OBS_COMPRA,
                       C.ID_PEDIDO_DET,
                       C.IND_NO_ENVIO,
                       C.INSERT_AUTO,
                       NVL(A.IND_CONTROLADO, 'N'),
                       C.IND_CLIENTE,
                       NVL(C.IND_EXCEL_AUTO, 'N'),
                       C.OBSERVACION_AUTO,
                       C.DISPONIBILIDAD,
                       NVL(C.IND_ALTERNATIVA, 'N'),
                       C.FEC_PLAZO,
                       C.PRECIO_SUGERIDO,
                       C.PORC_AJUSTE,
                       C.MOTIVO_RECOTIZACION,
                       C.CANT_RESERVADA,
                       C.VENCIMIENTO_PRODUCTO,
                       A.PORC_EFECTIVIDAD,
                       C.IND_CONTRATO,
                       A.IND_SOLO_MAR,
                       A.IND_SOLO_AEREO,
                       C.IND_REFERENCIA
                ```
