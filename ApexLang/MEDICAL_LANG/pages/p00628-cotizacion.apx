    dynamicAction re-calcula-montos (
        name: Re Calcula Montos
        execution {
            sequence: 330
        }
        when {
            selectionType: columns
            interactiveGrid: @cotizacion-de-compras
            columns: [
                PRECIO_UNITARIO
                CANTIDAD
            ]
        }

        action porc-ajuste (
            name: PORC_AJUSTE
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                        IF REPLACE(:PRECIO_SUGERIDO, '.', '') != 0 THEN
                            RETURN 100 * ((REPLACE(:PRECIO_UNITARIO, '.', '') / REPLACE(:PRECIO_SUGERIDO, '.', '')) - 1);
                        END IF;
                    
                        RETURN 0;
                    END;
                    
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO
                    PRECIO_SUGERIDO
                ]
            }
            affectedElements {
                selectionType: columns
                columns: PORC_AJUSTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action precio-total (
            name: PRECIO_TOTAL
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VCANT_AUX NUMBER;
                    BEGIN
                        IF NVL(:CANTIDAD_APROBADA, 0) > 0 THEN
                            VCANT_AUX := :CANTIDAD_APROBADA;
                        ELSE
                            VCANT_AUX := :CANTIDAD;
                        END IF;
                    
                        RETURN ROUND(REPLACE(:PRECIO_UNITARIO, '.', '') * VCANT_AUX, MONEDA_DECIMALES(:ID_MONEDA_PRECIO));
                    END;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO
                    CANTIDAD
                    ID_MONEDA_PRECIO
                    CANTIDAD_APROBADA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: PRECIO_TOTAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

