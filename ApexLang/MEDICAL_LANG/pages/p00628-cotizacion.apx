    dynamicAction cambiar-montos (
        name: Cambiar Montos
        execution {
            sequence: 80
            type: debounce
            time: 1
        }
        when {
            selectionType: columns
            interactiveGrid: @cotizacion-de-compras
            columns: [
                PRECIO_RECARGO
                PORC_MARGEN
                ID_MONEDA_PRECIO
                TIP_CAMBIO_MONEDA_PRECIO
                " ID_MONEDA"
                " CAMBIO"
            ]
        }

        action cantidad-aprobada-copia (
            name: CANTIDAD_APROBADA_COPIA
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD_APROBADA
                itemsToSubmit: CANTIDAD_APROBADA
            }
            affectedElements {
                selectionType: columns
