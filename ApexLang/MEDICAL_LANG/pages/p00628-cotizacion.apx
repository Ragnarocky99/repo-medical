                SELECT IND_ANULADO 
                FROM CMW_COTIZA_ARTICULOS 
                WHERE ID_PEDIDO = :P628_ID_PEDIDO 
                AND   ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P628_ID_PEDIDO
        }
    )

    computation p628-cantidad-total (
        itemName: P628_CANTIDAD_TOTAL
        execution {
