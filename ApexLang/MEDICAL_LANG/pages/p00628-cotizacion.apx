            type: item=value
            item: APROBAR
            value: S
        }
    )

    validation validar-nro-de-occ (
        name: Validar Nro de OCC
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @cotizacion-de-compras
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF nvl(:aprobar,'N') = 'S' THEN 
                  IF :nro_occ IS NULL THEN 
                    RETURN FALSE;
                  ELSE 
                    RETURN TRUE;
                  END IF;
                ELSE
                  RETURN TRUE;
                END IF;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Error el Nro de OCC no puede quedar Vacío.
        }
    )

