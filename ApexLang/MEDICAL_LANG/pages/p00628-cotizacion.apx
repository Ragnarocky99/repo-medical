    process actualizar-coleccion (
        name: Actualizar Coleccion
        type: executeCode
        editableRegion: @cotizacion-de-compras
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VSEQ_ID    NUMBER;
                    VCANT_REAL NUMBER;
                    VN003      NUMBER;
                BEGIN
                    VCANT_REAL := NVL(:CANTIDAD_APROBADA, 0) - NVL(:CANT_ANULADA, 0);
                    BEGIN
                        SELECT SEQ_ID, N003
                          INTO VSEQ_ID, VN003
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'COTIZACION_COL'
                           AND N001 = :ID
                           AND VCANT_REAL != N003;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VSEQ_ID := NULL;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    
                    IF VSEQ_ID IS NOT NULL THEN
                        APEX_COLLECTION.update_member(
                            p_collection_name => 'COTIZACION_COL',
                            p_seq             => VSEQ_ID,
                            p_c001            => :ID_SUCURSAL,
                            p_c002            => :ID_ARTICULO,
                            p_n001            => :ID,
                            p_n002            => NVL(:CANT_RESERVADA, 0),
                            p_n003            => VN003
                        );
                    ELSE
                        IF :APEX$ROW_STATUS = 'C' AND
                           NVL(:CANTIDAD_APROBADA, 0) - NVL(:CANT_ANULADA, 0) > 0 THEN
                             APEX_COLLECTION.add_member(
                                p_collection_name => 'COL_BLOQUEO',
                                p_c001            => :ID_SUCURSAL,
                                p_c002            => :ID_ARTICULO,
                                p_n001            => :ID,
                                p_n002            => NVL(:CANT_RESERVADA, 0)
                            );
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 66635451933455528
        }
        serverSideCondition {
            type: never
        }
    )

    process calcula-disponibilidad (
        name: Calcula Disponibilidad
        type: executeCode
        editableRegion: @cotizacion-de-compras
        source {
            plsqlCode:
                ```plsql
                declare
                 vid_sucursal bsw_sucursales.id%type;
                 vcantidad_bloqueo_actual number := 0;
                begin
                  -- Verificamos la sucursal
                  if :id_sucursal not in (1, 690) then -- Oficina y Licitacion
                    vid_sucursal := 1; -- Tiene que tomar la sucursal central si no es oficina o licitacion
                  else
                    vid_sucursal := :id_sucursal;
                  end if;
                
                  -- Obtenemos el bloqueo actual para evitar conflictos
                  begin
                    select sum(nvl(cant_bloqueo, 0))
                      into vcantidad_bloqueo_actual
                      from stwv_articulos_bloqueo
                     where id_articulo   = :id_articulo
                       and id_sucursal   = vid_sucursal
                       and id_pedido     = :id_pedido
                       and id_pedido_det = :id_pedido_det
                       and nro_occ       = :nro_occ;
                  exception
                    when others then
                        vcantidad_bloqueo_actual := 0;
                  end;
                  
                  --raise_application_error(-20000, :cantidad_aprobada);
                  -- Si estoy aprobando calculo la disponibilidad en ese instante (sin contar este). Y verifico que no se dispare al anular
                  if (nvl(:cantidad_aprobada, 0) - nvl(:cant_anulada, 0)) > 0 then
                      --raise_application_error(-20000, obtener_cantidad_existente(:id_articulo, vid_sucursal, 'S'));
                    :disponibilidad := obtener_cantidad_existente(:id_articulo, vid_sucursal, 'S') + nvl(vcantidad_bloqueo_actual, 0);
                  end if;
                  
                  if (nvl(:cantidad_aprobada, 0) - nvl(:cant_anulada, 0) = 0) then
                    :disponibilidad := null;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 14867659295305941
        }
        serverSideCondition {
            type: never
        }
    )

