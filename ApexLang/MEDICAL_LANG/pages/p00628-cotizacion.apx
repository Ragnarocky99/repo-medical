    dynamicAction cargar-datos-en-coleccion (
        name: Cargar datos en coleccion
        execution {
            sequence: 410
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        CURSOR COTIZACION IS
                           SELECT C.ID_SUCURSAL,
                                  C.ID_ARTICULO,
                                  NVL(C.CANT_RESERVADA, 0) CANT_RESERVADA,
                                  C.ID,
                                  NVL(C.CANTIDAD_APROBADA, 0) - NVL(C.CANT_ANULADA, 0) CANTIDAD_REAL
                    FROM 
                        CMW_COTIZA_ARTICULOS C
                    WHERE 
                        C.ID_EMPRESA = :P0_ID_EMPRESA
                        AND C.ID_PEDIDO = :P628_ID_PEDIDO_2
                        AND C.IND_CLIENTE = 'S';
                    BEGIN
                        APEX_COLLECTION.create_or_truncate_collection('COTIZACION_COL');
                    
                        FOR C IN COTIZACION
                        LOOP
                            APEX_COLLECTION.add_member(
                                p_collection_name => 'COTIZACION_COL',
                                p_c001            => C.ID_SUCURSAL,
                                p_c002            => C.ID_ARTICULO,
                                p_n001            => C.ID,
                                p_n002            => C.CANT_RESERVADA,
                                p_n003            => C.CANTIDAD_REAL
                            );
                        END LOOP;
                    END;
                    ```
                itemsToSubmit: P628_ID_PEDIDO_2
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction cargar-detalles (
        name: Cargar Detalles
        execution {
            sequence: 150
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       v_contador NUMBER(18);
                    BEGIN
                       IF :P628_ID_PEDIDO_2 IS NOT NULL THEN 
                          SELECT COUNT(*)
                          INTO v_contador
                          FROM CMW_COTIZA_ARTICULOS
                          WHERE ID_PEDIDO = :P628_ID_PEDIDO_2;
                          
                          IF v_contador > 0 THEN
                             raise_application_error(-20000, '"Este pedido ya ha sido cotizado anteriormente."');
                          END IF;
                       ELSE
                          raise_application_error(-20000, 'El ID_PEDIDO es nulo');
                       END IF;
                    EXCEPTION
                       WHEN NO_DATA_FOUND THEN 
                          raise_application_error(-20000, 'No se encontró la cotizacion');
                       WHEN OTHERS THEN
                          raise_application_error(-20000, 'Error ' || sqlerrm);
                    END;
                    
                    ```
                itemsToSubmit: P628_ID_PEDIDO_2
                itemsToReturn: P628_ID_PEDIDO_2
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                     SELECT    D.NUM_ORDEN,
                               D.ID_ARTICULO,
                               A.ID_GRUPO_ART,
                               D.DESC_ARTICULO DESCRIPCION,
                               A.ID_ENVASE,
                               A.ID_UNIDAD_MEDIDA,
                               A.ID_MARCA,
                               D.CANTIDAD,
                               A.COD_ARTICULO,
                               A.COD_ORIGEN_ART
                           
                           
                    FROM VTW_PEDIDOS_DETALLE D, STW_ARTICULOS A
                    WHERE D.ID_ARTICULO         = A.ID
                      AND D.ID_EMPRESA          = A.ID_EMPRESA
                      AND D.ID_PEDIDO_CABECERA  = :P628_ID_PEDIDO_2;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P628_JSON_DETALLES:=JSON_DETALLE;
                      EXCEPTION
                      WHEN OTHERS THEN  
                      NULL;
                    
                    END;
                    ```
                itemsToSubmit: P628_ID_PEDIDO_2
                itemsToReturn: P628_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    
                    ```
            }
            execution {
                sequence: 30
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P628_JSON_DETALLES'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    if((json_detalle.DETALLE[i].NUM_ORDEN!=null)){
                    $model.setValue($newRecord, "NRO_ITEM",(json_detalle.DETALLE[i].NUM_ORDEN).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_ARTICULO!=null)){
                    $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_GRUPO_ART!=null)){
                    $model.setValue($newRecord, "ID_GRUPO_ART",(json_detalle.DETALLE[i].ID_GRUPO_ART).toString());
                    }
                    if((json_detalle.DETALLE[i].DESCRIPCION!=null)){
                    $model.setValue($newRecord, "DESC_ARTICULO",(json_detalle.DETALLE[i].DESCRIPCION).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_ENVASE!=null)){
                    $model.setValue($newRecord, "ID_ENVASE",(json_detalle.DETALLE[i].ID_ENVASE).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA!=null)){
                    $model.setValue($newRecord, "ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_MARCA!=null)){
                    $model.setValue($newRecord, "ID_MARCA",(json_detalle.DETALLE[i].ID_MARCA).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].COD_ARTICULO!=null)){
                    $model.setValue($newRecord, "COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].COD_ORIGEN_ART!=null)){
                    $model.setValue($newRecord, "COD_ORIGEN_ART",(json_detalle.DETALLE[i].COD_ORIGEN_ART).toString());
                    }
                    
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 50
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cotizacion-de-compras
            }
            execution {
                sequence: 40
            }
        )

    )

