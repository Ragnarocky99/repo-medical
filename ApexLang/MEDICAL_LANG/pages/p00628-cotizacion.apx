            highlight controlado (
                name: Controlado
                condition {
                    column: @IND_CONTROLADO
                    value: S
                }
                colors {
                    background: #ffd6d2
                }
                execution {
                    sequence: 2.5
                }
            )

            highlight gen-auto-excel (
                name: Gen. Auto Excel
                condition {
                    column: @IND_EXCEL_AUTO
                    value: S
                }
                colors {
                    background: #d0f1cc
                }
                execution {
                    sequence: 5
                }
            )

            highlight gen-automatico (
                name: Gen. Automatico
                condition {
                    column: @INSERT_AUTO
                    value: S
                }
                colors {
                    background: #fff5ce
                }
                execution {
                    sequence: 7.5
                }
            )

            highlight precio-ult-occ (
                name: Precio Ult. OCC
                condition {
                    column: @PRECIO_ULTIMA_OCC
                    operator: isNotEmpty
                }
                highlight {
                    type: cell
                    column: @PRECIO_ULTIMA_OCC
                }
                colors {
                    background: #cce5ff
                }
                execution {
                    sequence: 1.25
                }
            )

            highlight solo-aereo (
                name: Solo Aereo
                condition {
                    column: @IND_SOLO_AEREO
                    value: S
                }
                highlight {
                    type: cell
                    column: @COD_ORIGEN_ART
                }
                colors {
                    background: #d0f1cc
                }
                execution {
                    sequence: 17.5
                }
            )

            highlight solo-mar (
                name: Solo Mar
                condition {
                    column: @IND_SOLO_MAR
                    value: S
                }
                highlight {
                    type: cell
                    column: @COD_ORIGEN_ART
                }
                colors {
                    background: #8cb3dc
                    text: #000000
                }
                execution {
                    sequence: 12.5
                }
            )

            highlight vencimiento-lote-proximo (
                name: Vencimiento Lote Proximo
                condition {
                    column: @IND_VENCE_LOTE
                    value: S
                }
                highlight {
                    type: cell
                    column: @DESC_ARTICULO
                }
                colors {
                    background: #ffffff
                    text: #bf65e9
                }
                execution {
                    sequence: 0.625
                }
            )

        )

