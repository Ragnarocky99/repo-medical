page 194 (
    name: Impresion Plan de Cuentas
    alias: IMPRESION-PLAN-DE-CUENTAS
    title: Impresion Plan de Cuentas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                DECLARE
                vcName PK_JRXML2PDF_TYPES.tName;
                
                l_ReportList PK_JRXML2PDF_TYPES.tReportNameList;
                
                r_Params PK_JRXML2PDF_REPGEN.TPARAMETER;
                l_Params PK_JRXML2PDF_REPGEN.TPARAMLIST;
                
                bl BLOB;
                
                BEGIN
                
                
                vcName := 'PLAN_DE_CUENTAS';
                
                r_Params.vcName := 'P_COD_USUARIO';
                r_Params.vcValue := :APP_USER;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_FECHA';
                r_Params.vcValue := SYSDATE;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                r_Params.vcName := 'P_ID_EMPRESA';
                r_Params.vcValue := :P0_COD_EMPRESA;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                
                
                
                
                
                l_ReportList(1) := vcName;
                
                
                
                bl := PK_JRXML2PDF_REPGEN.FK_RUN(i_lReports=>l_ReportList,
                i_lParams=>l_Params,
                i_bResetPageNumber=>false
                );
                
                PK_JRXML2PDF_REPGEN.PR_SHOW_REPORT(bl);
                APEX_APPLICATION.STOP_APEX_ENGINE;
                
                END;
                ```
        }
    )

)

