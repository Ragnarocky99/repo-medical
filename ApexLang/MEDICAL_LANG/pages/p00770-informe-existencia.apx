page 770 (
    name: Informe Existencia
    alias: INFORME-EXISTENCIA
    title: Informe Existencia
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region informe-existencia (
        name: Informe Existencia
        type: interactiveReport
        source {
            location: localDatabase
            tableName: STWV_EXISTENCIA_ARTICULOS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (COD_ARTICULO = :P770_COD_ARTICULO OR :P770_COD_ARTICULO IS NULL) AND
                (ID_ARTICULO = :P770_ID_ARTICULO OR :P770_ID_ARTICULO IS NULL) AND
                (ID_MARCA = :P770_ID_MARCA OR :P770_ID_MARCA IS NULL) AND
                (ID_SUCURSAL = :P770_ID_SUCURSAL OR :P770_ID_SUCURSAL IS NULL) AND
                ID_SUCURSAL IS NOT NULL
                ```
            pageItemsToSubmit: [
                P770_COD_ARTICULO
                P770_ID_SUCURSAL
                P770_ID_ARTICULO
                P770_ID_MARCA
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 35493255904693128
        }

        column CANT_BLOQUEO (
            type: link
            heading {
                heading: Cant. Bloqueo
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            link {
                target: {
                    page: 646
                    items: {
                        P646_ID: #ID_ARTICULO#
                    }
                }
                linkText: #CANT_BLOQUEO#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column CANT_DISPON (
            type: plainText
            heading {
                heading: Stock
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

