            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column MARCA (
            type: plainText
            heading {
                heading: Marca
                alignment: center
            }
            layout {
                sequence: 13
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column PRESENTACION (
            type: plainText
            heading {
                heading: Presentacion
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column UNIDAD_MEDIDA (
            type: plainText
            heading {
                heading: Unidad Medida
