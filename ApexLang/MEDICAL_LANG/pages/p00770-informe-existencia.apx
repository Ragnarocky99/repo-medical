            layout {
                sequence: 12
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Informe Existencia
        }

        savedReport 354992 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APXWS_CC_001 (
                sequence: 13
            )

            displayColumn CANT_BLOQUEO (
                sequence: 9
            )

            displayColumn CANT_DISPON (
                sequence: 8
            )

            displayColumn CANT_PEND_OCP (
                sequence: 11
            )

            displayColumn CANT_RESERVADA (
                sequence: 12
            )

            displayColumn COD_ARTICULO (
                sequence: 1
            )

            displayColumn COD_FABRICANTE (
                sequence: 2
            )

            displayColumn DESC_ARTICULO (
                sequence: 6
            )

            displayColumn DISPONIBILIDAD (
                sequence: 10
            )

            displayColumn ID_SUCURSAL (
                sequence: 7
            )

            displayColumn MARCA (
                sequence: 5
            )

            displayColumn PRESENTACION (
                sequence: 3
            )

            displayColumn UNIDAD_MEDIDA (
                sequence: 4
            )

        )

    )

    pageItem P770_COD_ARTICULO (
        type: textField
        label {
            label: <p>Cod. Articulo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P770_ID_ARTICULO (
        type: popupLov
        label {
            label: <p>Articulo:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-articulos
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P770_ID_MARCA (
        type: popupLov
        label {
            label: <p>Marca:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-marcas
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P770_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P770_COD_ARTICULO
                P770_ID_SUCURSAL
                P770_ID_ARTICULO
                P770_ID_MARCA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @informe-existencia
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction paginacion (
        name: Paginacion
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @informe-existencia
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       v_sql VARCHAR2(200);
                    BEGIN
                       -- Construct the anonymous PL/SQL block as a string
                       v_sql := 'BEGIN DBMS_MVIEW.REFRESH(''STWMV_EXISTENCIA_ARTICULOS''); END;';
                    
                       -- Execute the PL/SQL block
                       EXECUTE IMMEDIATE v_sql;
                    
                    EXCEPTION
                       WHEN OTHERS THEN
                          RAISE_APPLICATION_ERROR(-20000, 'Error al recalcular el stock: ' || SQLERRM);
                    END;
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @informe-existencia
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

)

