            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button saldos (
        buttonName: saldos
        label: Saldos a una Fecha
        layout {
            sequence: 10
            region: @filtros
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 674
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P156_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P156_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P156_FEC_INI,'/','');
                            conv_fecha := substr(:P156_FEC_INI,1,2)||'/'||
                                                      substr(:P156_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:P156_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P156_FEC_INI := conv_fecha;
                        ELSIF (length(:P156_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P156_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P156_FEC_INI
                itemsToReturn: P156_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha-fin (
        name: CONVERT_FECHA_FIN
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P156_FEC_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P156_FEC_FIN) = 8) then
                    
                            conv_fecha := replace(:P156_FEC_FIN,'/','');
                            conv_fecha := substr(:P156_FEC_FIN,1,2)||'/'||
                                                      substr(:P156_FEC_FIN,3,2)||'/'||
                                                      lpad(substr(:P156_FEC_FIN,5,4),4,'0');
                    
                        :P156_FEC_FIN := conv_fecha;
                        ELSIF (length(:P156_FEC_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P156_FEC_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P156_FEC_FIN
                itemsToReturn: P156_FEC_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @saldos-de-clientes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @saldos-de-clientes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: REFRESH
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P156_CLIENTE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @saldos-de-clientes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @b156-ejecutar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @saldos-de-clientes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 266
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 266
            }
        }
        serverSideCondition {
            whenButtonPressed: @b156-imprimir
        }
    )

)

