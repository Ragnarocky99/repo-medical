    pageItem P156_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            displayExtraValues: false
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P156_FEC_FIN (
        type: datePicker
        label {
            label: <p>Hasta: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
    )

