page 156 (
    name: Saldos de Clientes
    alias: SALDOS-DE-CLIENTES
    title: Saldos de Clientes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region saldos-de-clientes (
        name: Saldos de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SALDO_ID,
                       ID_CLIENTE, 
                       CLIENTE,
                       RUC_EMPRESA,
                       EMPRESA,
                       COD_CLIENTE,
                       FEC_COMPROBANTE,
                       TIPO_COMPROBANTE, 
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE, 
                       FEC_VENCIMIENTO, 
                       fec_vencimiento-trunc(sysdate) as dias_retraso,
                       NRO_CUOTA, 
                       MONTO_CUOTA, 
                       SALDO_CUOTA,
                       MONEDA, 
                       TIPO_CAMBIO,
                       SUCURSAL,
                       NRO_OCC,
                       DOC_CLIENTE
                
                FROM CCWV_SALDOS_CLIENTE
                
                WHERE ID_EMPRESA =:P0_ID_EMPRESA
                    AND (FEC_VENCIMIENTO BETWEEN :P156_FEC_INI AND :P156_FEC_FIN)
                    AND (ID_CLIENTE= :P156_CLIENTE OR :P156_CLIENTE IS NULL)
                    AND (ID_MONEDA = :P156_MONEDA OR :P156_MONEDA IS NULL) 
                   AND ((:P156_IND_SALDO = 1 AND NVL(SALDO_CUOTA,0) != 0) OR
                         (:P156_IND_SALDO = 0 AND NVL(SALDO_CUOTA,0) = 0) OR
                         (:P156_IND_SALDO = 2 ))
                
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P156_FEC_INI
                P156_FEC_FIN
                P156_CLIENTE
                P156_MONEDA
                P156_IND_SALDO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 29699987229315250
        }

