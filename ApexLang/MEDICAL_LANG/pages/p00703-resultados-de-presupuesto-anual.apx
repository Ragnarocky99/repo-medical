    region resultados-de-presupuesto-anual (
        name: Resultados de Presupuesto Anual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  C.COD_CUENTA,
                        C.NOMBRE_CUENTA,
                        NVL(P.PRE_ENERO,0) as Enero_Proyectado,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 1
                        ) as Enero_Real,
                        NVL(P.PRE_FEBRERO,0) AS FEBRERO_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 2
                        ) as Febrero_Real,
                        NVL(P.PRE_MARZO,0) AS MARZO_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 3
                        ) as Marzo_Real,
                        NVL(P.PRE_ABRIL,0) AS ABRIL_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 4
                        ) as Abril_Real,
                        NVL(P.PRE_MAYO,0) AS MAYO_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 5
                        ) as Mayo_Real,
                        NVL(P.PRE_JUNIO,0) AS JUNIO_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 6
                        ) as Junio_Real,
                        NVL(P.PRE_JULIO,0) AS JULIO_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 7
                        ) as Julio_Real,
                        NVL(P.PRE_AGOSTO,0) AS AGOSTO_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 8
                        ) as Agosto_Real,
                        NVL(P.PRE_SEPTIEMBRE,0) AS SEPTIEMPRE_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 9
                        ) as Septiembre_Real,
                        NVL(P.PRE_OCTUBRE,0) AS OCTUBRE_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 10
                        ) as Octubre_Real,
                        NVL(P.PRE_NOVIEMBRE,0) AS NOVIEMBRE_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 11
                        ) as Noviembre_Real,
                        NVL(P.PRE_DICIEMBRE,0) AS DICIEMBRE_PROYECTADO,
                        (select nvl(sum(nvl(b.saldo,0)),0)
                        from cowv_balance_general_prov b
                        where b.id_cuenta = p.id_cuenta and b.cod_ejercicio = :P0_COD_EJERCICIO
                          and extract(month from b.fec_asiento) = 12
                        ) as Diciembre_Real
                FROM INV.COW_PRESUPUESTO_ANUAL P
                JOIN COW_PLAN_CUENTAS C ON C.ID = P.ID_CUENTA
                 AND (C.ID = :P703_ID_CUENTA OR :P703_ID_CUENTA IS NULL)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 39288714685846707
        }

