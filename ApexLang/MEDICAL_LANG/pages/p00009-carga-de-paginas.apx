page 9 (
    name: Carga de Paginas
    alias: CARGA-DE-PAGINAS
    title: Carga de Paginas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-paginas (
        name: Carga de Paginas
        type: form
        source {
            location: localDatabase
            tableName: BSW_FORMAS_PAGINAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P9_COD_MODULO (
        type: popupLov
        label {
            label: <p>Cód. Módulo: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-modulos
        }
        layout {
            sequence: 80
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @carga-de-paginas
            column: ID_MODULO
            dataType: number
        }
    )

    pageItem P9_ICON_IMG (
        type: popupLov
        label {
            label: <p>Ícono: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @iconos
        }
        layout {
            sequence: 70
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-paginas
            column: ICON_IMG
            dataType: varchar2
        }
    )

    pageItem P9_LEVEL (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-paginas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-paginas
            column: LEVEL
            dataType: varchar2
        }
        default {
            type: static
            staticValue: 3
        }
    )

    pageItem P9_MOSTRAR_MENU (
        type: switch
        label {
            label: <p>Mostrar Menú&ensp;</p>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: Si
            offValue: N
            offLabel: NO
        }
        layout {
            sequence: 100
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-paginas
            column: MOSTRAR_MENU
            dataType: varchar2
        }
    )

    pageItem P9_NAV_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-paginas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-paginas
            column: NAV_ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_FORMAS_PAGINAS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_NAV_NAME (
        type: textField
        label {
            label: <p>Nombre: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @carga-de-paginas
            column: NAV_NAME
            dataType: varchar2
        }
    )

    pageItem P9_ORDEN (
        type: numberField
        label {
            label: <p>Orden: &ensp;</p>
            alignment: left
        }
        settings {
            minValue: 1
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @carga-de-paginas
            column: ORDEN
            dataType: number
        }
    )

    pageItem P9_PAGE_NO (
        type: popupLov
        label {
            label: <p>Página: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 SELECT PAGE_NAME || ' (P-' || PAGE_ID || ')' AS d, PAGE_ID AS r
                  FROM apex_application_pages
                 WHERE application_id = :APP_ID;
                ```
        }
        layout {
            sequence: 40
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-paginas
            column: PAGE_NO
            dataType: varchar2
        }
    )

    pageItem P9_PARENT_ID (
        type: hidden
        layout {
            sequence: 60
            region: @carga-de-paginas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-paginas
            column: PARENT_ID
            dataType: number
        }
    )

    pageItem P9_TIPO_FORMAS (
        type: popupLov
        label {
            label: <p>Tipo: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-tipos-formas
        }
        layout {
            sequence: 50
            region: @carga-de-paginas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @carga-de-paginas
            column: TIPO_PAGINA
            dataType: varchar2
        }
        readOnly {
            type: itemIsNotNull
            item: P9_NAV_ID
        }
    )

    pageItem P9_TIPO_PAGINA (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-paginas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-paginas
            column: TIPO_PAGINA
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_NAV_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_NAV_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_NAV_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 5581185403866007
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-paginas (
        name: Initialize form Carga de Paginas
        type: formInitialization
        formRegion: @carga-de-paginas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 5580381012866007
        }
    )

    process process-form-carga-de-paginas (
        name: Process form Carga de Paginas
        type: formAutoRowProcessing
        formRegion: @carga-de-paginas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5580743922866007
        }
    )

    process setear-nivel (
        name: Setear Nivel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                SELECT 
                NAV_ID
                INTO :P9_PARENT_ID
                FROM BSW_FORMAS_PAGINAS
                WHERE id_MODULO=:P9_COD_MODULO AND LEVEL=2 AND TIPO=:P9_TIPO_FORMAS
                START WITH PARENT_ID IS NULL
                CONNECT BY PRIOR  NAV_ID=PARENT_ID;
                
                
                
                :P9_TIPO_PAGINA:=:P9_TIPO_FORMAS;
                
                End;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 5450430323814607
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process setear-nivel-2 (
        name: Setear Nivel_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                SELECT 
                NAV_ID
                INTO :P9_PARENT_ID
                FROM BSW_FORMAS_PAGINAS
                WHERE id_MODULO=:P9_COD_MODULO AND LEVEL=2 AND TIPO=:P9_TIPO_FORMAS
                START WITH PARENT_ID IS NULL
                CONNECT BY PRIOR  NAV_ID=PARENT_ID;
                
                
                
                :P9_TIPO_PAGINA:=:P9_TIPO_FORMAS;
                EXCEPTION WHEN NO_DATA_FOUND THEN
                NULL;
                
                End;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 6768571599161227
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

