    region detalles-de-articulos-remisionados (
        name: Detalles de Articulos Remisionados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rc.fec_ent_sal,
                       rc.ser_ent_sal,
                       rc.num_ent_sal,
                       pe.nombre         as nombre_cliente,
                       nvl(ld.cod_articulo_catalogo, ar.cod_articulo) cod_articulo,
                       ar.cod_origen_art as cod_fabricante,
                       nvl(ld.desc_articulo_catalogo, ar.descripcion)    as desc_articulo,
                       en.descripcion    as presentacion,
                       um.descripcion    as unidad_medida,
                       ru.descripcion    as rubro,
                       ma.descripcion    as marca,
                       rd.cantidad       as cantidad_remisionada,
                       rd.costo_c_iva    as costo_con_iva,
                       rd.total_costo,
                       estado_remision(rc.id) as estado_remision,
                       fc.ser_comprobante as ser_comprobante_ref,
                       fc.nro_comprobante as nro_factura_ref,
                       case nvl(fc.estado,'X') 
                        when 'A' then 'Anulado'
                        else 'Vigente'
                       end as Estado_Factura,
                       rc.nro_occ,
                       nvl(ca.nro_item, ld.nro_item) nro_item
                
                from stw_entsal_det      rd
                join stw_entsal_cab      rc on rc.id = rd.id_entsal_cab
                left join lcw_licitaciones_det ld on ld.id = rd.id_licitacion_det
                join stw_articulos       ar on ar.id = rd.id_articulo
                join stw_envases         en on en.id = nvl(ld.id_presentacion_catalogo, ar.id_envase)
                join stw_unidades_medida um on um.id = nvl(ld.id_unidad_medida_catalogo, ar.id_unidad_medida)
                join stw_rubro           ru on ru.id = ar.id_rubro
                join stw_marcas          ma on ma.id = ar.id_marca
                join ccw_clientes        cl on cl.id = rc.id_cliente
                join bsw_personas        pe on pe.id = cl.id_persona
                left join vtw_comprobantes_detalle fd on fd.id_remision_det = rd.id
                left join vtw_comprobantes_cabecera fc on fc.id = fd.id_comprobante_cabecera
                left join cmw_cotiza_articulos ca on ca.id = rd.id_cotiza_art
                where rc.tip_referencia IN ('PED', 'LIC')--solo remisiones, no entradas/salidas
                  and (cl.id = :P714_ID_CLIENTE or :P714_ID_CLIENTE is null)
                  and (ar.id = :P714_ID_ARTICULO or :P714_ID_ARTICULO is null)
                  and (estado_remision(rc.id) = :P714_ESTADO or :P714_ESTADO is null)
                  and rc.fec_ent_sal between :P714_FEC_INICIO and :P714_FEC_FIN
                
                order by rc.fec_ent_sal desc;
                ```
            pageItemsToSubmit: [
                P714_ID_CLIENTE
                P714_ID_ARTICULO
                P714_ESTADO
                P714_FEC_INICIO
                P714_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
