    region precio-venta (
        name: PRECIO VENTA
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PF.ID,
                       PF.ID_EMPRESA,
                       PF.ID_ARTICULO,
                       PF.ID_PRECIO,
                       PF.FEC_VIGENCIA,
                       PF.ID_MONEDA,
                       PF.PRECIO_FIJO,
                       PF.ACTIVO,
                       PF.ID_UNIDAD_MEDIDA,
                       PF.COD_USUARIO_AUD,
                       PF.TIPO_CAMBIO,
                       PF.PRECIO_FIJO_CIVA,
                       PF.FECHA,
                       PF.COSTO_PROM,
                       PF.COSTO_PROM_CIVA,
                       PF.PORC_PRECIO,
                       PF.FEC_INICIO,
                       PF.FEC_FIN,
                       PF.IND_PROMO,
                       PF.PORC_IVA,
                       PF.ID_FAMILIA,
                       PF.ID_GRUPO_ART,
                       PF.ID_LINEA,
                       PF.ID_MARCA,
                       PF.ID_PROVEEDOR,
                       PF.ID_RUBRO,
                       PF.ID_PRECIO_CAB_BASE,
                       PF.PRECIO_FIJO_BASE_CIVA,
                       PF.IND_PRECIO_MANUAL,
                       PF.IND_MENOR_AL_COSTO,
                       PF.PRECIO_FIJO_ANT,
                       PF.PRECIO_FIJO_CIVA_ANT,
                       PF.FEC_PRECIO_FIJO_ANT,
                       PF.IND_INS_PLANILLA,
                       LP.DESCRIPCION DESC_LISTA_PRECIO,
                       MON.DESCRIPCION DESC_MONEDA
                  from VTW_PRECIOS_FIJOS PF, VTW_LISTAS_PRECIOS_CAB LP, BSW_MONEDAS MON
                  where PF.ID_PRECIO = LP.ID
                  and   PF.ID_MONEDA = MON.ID
                  and (
                (PF.FEC_VIGENCIA >= :P172_FECHA_DESDE OR :P172_FECHA_DESDE is null) and (PF.FEC_VIGENCIA <= :P172_FECHA_HASTA OR :P172_FECHA_HASTA is null)
                  );
                ```
            pageItemsToSubmit: [
                P172_FECHA_DESDE
                P172_FECHA_HASTA
            ]
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h2
                t-ContentBlock--shadowBG
            ]
        }
        masterDetail {
            masterRegion: @artículos
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
