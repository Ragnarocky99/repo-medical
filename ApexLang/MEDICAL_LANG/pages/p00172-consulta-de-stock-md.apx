page 172 (
    name: Consulta de Stock
    alias: CONSULTA-DE-STOCK-MD
    title: Consulta de Stock
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region artículos (
        name: ARTÍCULOS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       DESC_EMPRESA,
                       ID_ARTICULO,
                       COD_ARTICULO,
                       COD_ORIGEN_ART,
                       COD_BARRA_ART,
                       DESC_ARTICULO,
                       DESC_LARGA_ARTICULO,
                       ID_PROVEEDOR_DFLT,
                       COD_PROVEEDOR,
                       NOMB_PROVEEDOR,
                       NOMB_FANTASIA,
                       ID_PERSONA,
                       ID_RUBRO,
                       COD_RUBRO,
                       DESC_RUBRO,
                       ID_FAMILIA,
                       COD_FAMILIA,
                       DESC_FAMILIA,
                       ID_LINEA,
                       COD_LINEA,
                       DESC_LINEA,
                       ID_MARCA,
                       COD_MARCA,
                       DESC_MARCA,
                       ID_ENVASE,
                       COD_ENVASE,
                       DESC_ENVASE,
                       ID_GRUPO_ART,
                       COD_GRUPO_ART,
                       DESC_GRUPO_ART,
                       ID_GRUPO_COMISION,
                       COD_GRUPO_COMISION,
                       DESC_GRUPO_COMISION,
                       ID_ARANCEL,
                       COD_ARANCEL,
                       DESC_ARANCEL,
                       ID_NOM_COMUN,
                       COD_NOM_COMUN_SUR,
                       DESC_NOM_COMUN_SUR,
                       ESTADO,
                       ID_IVA,
                       COD_IVA,
                       DESC_IVA,
                       PORC_IVA_COMPRA,
                       PORC_IVA_VENTA,
                       ID_MONEDA_BASE,
                       COD_MONEDA_BASE,
                       DESC_MONEDA_BASE,
                       PRECIO_BASE,
                       ID_MONEDA_COSTO,
                       COD_MONEDA_COSTO,
                       DESC_MONEDA_COSTO,
                       COSTO_PROM,
                       COSTO_ULTIMO,
                       COSTO_FOB,
                       COSTO_PROM_CIVA,
                       COSTO_ULTIMO_CIVA,
                       COSTO_FOB_CIVA,
                       FEC_ULTIMA_COMP,
                       CANT_X_PAQUETE,
                       ANCHO,
                       ALTO,
                       LARGO,
                       LITRO,
                       PESO_ART,
                       VOLUMEN,
                       PORC_DESCUENTO,
                       IND_MANEJA_STOCK,
                       IND_MODIFICA_PRECIO,
                       IND_VENTA,
                       IND_COMPRA,
                       IND_MANEJA_LOTE,
                       IND_ES_PROMOCION,
                       IND_REGIMEN,
                       IND_REPLICA,
                       ID_PAIS_ORIGEN,
                       COD_PAIS,
                       DESC_PAIS,
                       ID_PARTIDA,
                       COD_PARTIDA,
                       PARTIDA,
                       PORC_PARTIDA_ARANCELARIA,
                       ID_UNIDAD_MEDIDA,
                       COD_UNIDAD_MEDIDA,
                       DESC_UNIDAD_MEDIDA,
                       ID_CUENTA_COSTO,
                       COD_CUENTA_COSTO,
                       NOMBRE_CUENTA_COSTO,
                       ID_CUENTA_GASTO,
                       COD_CUENTA_GASTO,
                       NOMBRE_CUENTA_GASTO,
                       ID_CUENTA_STOCK,
                       COD_CUENTA_STOCK,
                       NOMBRE_CUENTA_STOCK,
                       ID_CUENTA_VENTA,
                       COD_CUENTA_VENTA,
                       NOMBRE_CUENTA_VENTA,
                       SINONIMO,
                       stock_minimo,
                       stock_mayor_minimo
                  from STWV_ARTICULOS
                  where ID_EMPRESA = :P0_COD_EMPRESA
                  and   (COD_ARTICULO = :P172_COD_ARTICULO OR :P172_COD_ARTICULO IS NULL)
                  and   (LOWER(DESC_ARTICULO) LIKE '%'|| LOWER(:P172_DESC_ARTICULO)  ||'%' OR :P172_DESC_ARTICULO IS NULL) 
                  and   (COD_ORIGEN_ART = :P172_COD_ORIGEN_ARTICULO OR :P172_COD_ORIGEN_ARTICULO IS NULL)
                  and   (LOWER(DESC_MARCA) LIKE '%'|| LOWER(:P172_DESC_MARCA)  ||'%' OR :P172_DESC_MARCA IS NULL)
                  and   (NOMB_PROVEEDOR = :P172_NOMB_PROVEEDOR OR :P172_NOMB_PROVEEDOR IS NULL)
                  and   (LOWER(SINONIMO) LIKE '%'|| LOWER(:P172_SINONIMO)  ||'%' OR :P172_SINONIMO IS NULL)
                  and   (stock_mayor_minimo = :P172_IND_SUPERA or :P172_IND_SUPERA is null)
                ```
            pageItemsToSubmit: [
                P0_COD_EMPRESA
                P172_COD_ARTICULO
                P172_DESC_ARTICULO
                P172_COD_ORIGEN_ARTICULO
                P172_DESC_MARCA
                P172_NOMB_PROVEEDOR
                P172_SINONIMO
            ]
        }
        layout {
