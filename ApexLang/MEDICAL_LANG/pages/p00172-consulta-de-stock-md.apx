    dynamicAction cambio-cod-art (
        name: Cambio_Cod_Art
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P172_COD_ARTICULO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ID_ARTICULO
                    from STWV_ARTICULOS
                    where COD_ARTICULO = :P172_COD_ARTICULO
                    ```
            }
            affectedElements {
                selectionType: items
                items: P172_ID_ARTICULO
            }
            execution {
                sequence: 10
            }
        )

