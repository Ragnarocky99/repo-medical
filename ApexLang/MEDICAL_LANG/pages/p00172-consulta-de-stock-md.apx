        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: ARTÍCULOS
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region comandos (
        name: Comandos
        type: staticContent
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            column: 11
            columnSpan: 2
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region costo (
        name: COSTO
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_ARTICULO,
                       COSTO_PROM_ACTUAL,
                       CANT_EXIST_TOTAL,
                       FEC_ULTIMA_COMP,
                       FEC_PROCESO,
                       ID_MONEDA_COSTO,
                       COSTO_MOVIM,
                       CANT_MOVIM,
                       COSTO_PROM_NUEVO,
                       ID_USUARIO,
                       NRO_DESPACHO,
                       ID_COMPROBANTE_COMPRA,
                       ANT_COSTO_FOB,
                       COSTO_ULTIMO,
                       COD_USUARIO_AUD,
                       ID_INVENTARIO_CAB,
                       ID_ENTSAL_CAB,
                       COSTO_FOB_ACT,
                       FEC_PROCESO_BKP,
                       TIPO_CAMBIO_COMPRA,
                       COSTO_FOB_ACT * NVL(TIP_CAMBIO_MONEDA_COSTO, 1) COSTO_FOB_ACT_GS
                
                  from STW_HIST_COSTOS_ART
                  WHERE
                    (
                       (FEC_ULTIMA_COMP >= :P172_FECHA_DESDE OR :P172_FECHA_DESDE is null) and (FEC_ULTIMA_COMP <= :P172_FECHA_HASTA OR :P172_FECHA_HASTA is null)
                    );
                ```
            pageItemsToSubmit: [
                P172_FECHA_DESDE
                P172_FECHA_HASTA
            ]
        }
