    region stock (
        name: STOCK
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EXART.ID,
                       EXART.ID_ARTICULO,
                       EXART.ID_SUCURSAL,
                       EXART.CANT_DISPON AS STOCK,
                       ---EXART.CANT_BLOQUEO,
                       /*NVL((SELECT SUM(B.CANT_BLOQUEO) 
                               FROM STWV_ARTICULOS_BLOQUEO B 
                               WHERE B.ID_EMPRESA  = EXART.ID_EMPRESA 
                                 AND B.ID_ARTICULO = EXART.ID_ARTICULO ),0)CANT_BLOQUEO,*/
                       ---obtener_cantidad_bloqueo(exart.id_articulo, suc.id_sucursal_central, 'S') CANT_BLOQUEO,
                       
                       EXART.FEC_ULTIMO_INVENT,
                       EXART.CANT_MINIMA,
                       EXART.CANT_MAXIMA,
                       EXART.ID_EMPRESA,
                       EXART.SER_ARTICULO,
                       EXART.COD_USUARIO_AUD,
                       EXART.ID_UNIDAD_MEDIDA,
                       EXART.ID_LOTE,
                       SUC.DESCRIPCION DESC_SUC
                  from STW_EXISTENCIA_ART EXART, BSW_SUCURSALES SUC
                  where EXART.ID_SUCURSAL = SUC.ID
                  and (EXART.ID_SUCURSAL=:P172_ID_SUCURSAL OR :P172_ID_SUCURSAL IS NULL)
                  and 
                    (
                       (EXART.FEC_ULTIMO_INVENT >= :P172_FECHA_DESDE OR :P172_FECHA_DESDE is null) and (EXART.FEC_ULTIMO_INVENT <= :P172_FECHA_HASTA OR :P172_FECHA_HASTA is null)
                    )
                ```
            pageItemsToSubmit: [
                P172_ID_SUCURSAL
                P172_FECHA_DESDE
                P172_FECHA_HASTA
            ]
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h2
                t-ContentBlock--shadowBG
            ]
        }
        masterDetail {
            masterRegion: @artículos
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 34252860837625870
        }

