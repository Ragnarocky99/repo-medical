    pageItem P204_ID_SUB_TIPO_TRANS (
        type: selectList
        label {
            label: <p>Subtipo de Transacción</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT '('||SUBTIPO_TRANS||') ' || DESCRIPCION, ID
                FROM BSW_SUBTIPOS_TRANS
                WHERE ID_TIPO_TRANS = :P204_ID_TRANS
                ORDER BY length(SUBTIPO_TRANS), SUBTIPO_TRANS
                ```
        }
        cascadingLov {
            parentItems: P204_ID_TRANS
        }
        layout {
            sequence: 90
            region: @carga-de-formas-de-cobros
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @carga-de-formas-de-cobros
            column: ID_SUB_TIPO_TRANS
            dataType: number
        }
        comments {
            comments: https://stackoverflow.com/questions/16519648/sql-for-ordering-by-number-1-2-3-4-etc-instead-of-1-10-11-12
        }
    )

