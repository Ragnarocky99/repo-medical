    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
             function calculaTotales(){
                var model= apex.region("det").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("MONTO_OCULTO");
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                         console.log('jyyju'+r[v_cantidad]);
                          
                        v_total_cantidad      = v_total_cantidad     + parseFloat(r[v_cantidad].replace(/\./g,''));
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                 $s('P791_TOTAL',v_total_cantidad);
            }
            
