    validation validar-diferencia-cero (
        name: Validar diferencia cero
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: REPLACE(:P791_DIFERENCIA, '.', '') = 0
        }
        error {
            errorMessage: La diferencia debe ser cero
            associatedItem: @P791_DIFERENCIA
        }
    )

    computation p791-nro-cancelacion (
        itemName: P791_NRO_CANCELACION
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                    SELECT NVL(MAX(NRO_CANCELACION),0)+1
                                FROM CCW_CANCELA_CUOTAS DC
                                WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P791_ID
        }
    )

