    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.NRO_CANCELACION,
                       C.NRO_CUOTA,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.IMPORTE,
                       C.TIPO_MOVIMIENTO,
                       C.COD_USUARIO_AUD,
                       C.ID_COMPROBANTE_CAB,
                       C.ID_NOTA_DEBCRED,
                       C.ID_CANCELA_CUOTAS_CAB,
                       C.MONTO_CUOTA,
                       M.DESCRIPCION AS DESC_MONEDA,
                       C.ID_SALDO,
                       (SELECT C1.TIP_COMPROBANTE||'-'||C1.SER_COMPROBANTE||'-'||C1.NRO_COMPROBANTE
                          FROM VTW_COMPROBANTES_CABECERA C1
                         WHERE C1.ID_EMPRESA = C.ID_EMPRESA
                           AND C1.ID = C.ID_COMPROBANTE_CAB) AS REFERENCIA
                  from CCW_CANCELA_CUOTAS_DET C,BSW_MONEDAS M
                  WHERE ID_CANCELA_CUOTAS_CAB = :P791_ID
                  AND M.ID=C.ID_MONEDA
                ```
            pageItemsToSubmit: P791_ID
        }
        layout {
            sequence: 180
            parentRegion: @carga-de-aplicacion-de-notas-de-credito
            slot: regionBody
        }
        appearance {
