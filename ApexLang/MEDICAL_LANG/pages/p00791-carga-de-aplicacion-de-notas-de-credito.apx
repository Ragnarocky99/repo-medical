    dynamicAction setear-tip-cambio (
        name: Setear Tip Cambio
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P791_ID_MONEDA
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    if not :P791_ID_MONEDA is null then
                        return ftipos_cambio(:P791_ID_MONEDA, sysdate, 'F', 'V');
                    end if;
                    ```
                itemsToSubmit: P791_ID_MONEDA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P791_TIP_CAMBIO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction substraction (
        name: substraction
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: [
                P791_TOTAL
                P791_IMPORTE
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var importe = parseFloat($v("P791_IMPORTE").replace(/\./g,''));
                    var total = parseFloat($v("P791_TOTAL").replace(/\./g,''));
                    
                    // Check if both values are not empty and are numeric
                    if (!isNaN(importe) && !isNaN(total)) {
                        // Convert total to positive if it's negative
                        if (total < 0) {
                            total = Math.abs(total);
                        }
                    
                        var diferencia = importe - total;
                        $s("P791_DIFERENCIA", diferencia); // Set the result to another page item named P791_DIFERENCIA
                    } else {
                        //alert("Please enter numeric values for subtraction.");
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

