    dynamicAction carga-referencia (
        name: carga_referencia
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @detalle
            columns: ID_COMPROBANTE_CAB
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: apex.region("det").widget().interactiveGrid("getViews", "grid").model._data.length !== 0
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT C.TIP_COMPROBANTE||'-'||C.SER_COMPROBANTE||'-'||C.NRO_COMPROBANTE
                    ---  INTO :P791_SER_COMPROBANTE
                      FROM VTW_COMPROBANTES_CABECERA C
                     WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                       AND C.ID = :ID_COMPROBANTE_CAB
                    ```
                itemsToSubmit: [
                    ID_COMPROBANTE_CAB
                    REFERENCIA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: REFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

