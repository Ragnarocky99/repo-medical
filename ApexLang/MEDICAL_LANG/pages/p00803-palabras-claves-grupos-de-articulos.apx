page 803 (
    name: Palabras Claves - Grupos de Articulos
    alias: PALABRAS-CLAVES-GRUPOS-DE-ARTICULOS
    title: Palabras Claves - Grupos de Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region palabras-claves-grupos-de-articulos (
        name: Palabras Claves - Grupos de Articulos
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: STW_SINONIMOS_ALERTAS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                ID_GRUPO_ART IS NOT NULL
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 61204532740689090
        }

        savedReport 612050 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @IND_PELIGROSO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID_GRUPO_ART
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 6
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_GRUPO_ART (
            type: popupLov
            heading {
                heading: <p>Grupo Articulo</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-grupos-art
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_GRUPO_ART
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column IND_PELIGROSO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IND_PELIGROSO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Palabras Claves - Grupos de Articulos
        }
    )

    process palabras-claves-grupos-de-articulos-save-interactive-grid-data (
        name: Palabras Claves - Grupos de Articulos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
