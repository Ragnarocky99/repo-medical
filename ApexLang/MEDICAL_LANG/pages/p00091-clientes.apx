page 91 (
    name: Clientes
    alias: CLIENTES
    title: Clientes - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            
            
            
            
            
            /*
            #CLIENTES td[headers=COD]{min-width:30px}
            
            
            
            tr:nth-child(odd) {
                background-color: #f2f2f2;
            }
            */
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region clientes (
        name: Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  C.ID,
                        C.ID_EMPRESA,
                        C.COD_CLIENTE,
                        C.ID_PERSONA,
                        C.ID_VENDEDOR,
                        C.ID_COBRADOR,
                        C.ID_CONDICION_VENTA, 
                        C.COD_USUARIO_AUD,
                        P.NOMBRE,
                        P.NOMB_FANTASIA,
                        P.RUC,
                        P.NRO_CI,
                        C.ID_ZONA,
                        C.ESTADO,
                        C.ID_LISTAS_PRECIOS,
                        PV.NOMBRE NOMBRE_VENDEDOR,
                        PCO.NOMBRE NOMBRE_COBRADOR,
                        C.ID_TIP_CLIENTE,
                        C.ID_SUCURSAL,
                        C.COD_CLIENTE AS EXTRACTO,
                        'fa fa-search' AS EXTRACTO_ICON,
                        C.ID_SOPORTE,
                        C.NIVEL
                from    CCW_CLIENTES C, BSW_PERSONAS P,
                        FVW_VENDEDORES V, BSW_PERSONAS PV,
                        CCW_COBRADORES CO, BSW_PERSONAS PCO
                where   C.ID_PERSONA = P.ID
                    and C.ID_EMPRESA = :P0_COD_EMPRESA
                    and V.ID(+) = C.ID_VENDEDOR
                    and PV.ID(+) = V.ID_PERSONA
                    and CO.ID(+) = C.ID_COBRADOR
                    and PCO.ID(+) = CO.ID_PERSONA
                ORDER BY TO_NUMBER(C.COD_CLIENTE)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: CLIENTES
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 92
                items: {
                    P92_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 11512956395034053
        }

