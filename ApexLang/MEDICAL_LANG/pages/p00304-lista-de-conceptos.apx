page 304 (
    name: Lista  de Conceptos
    alias: LISTA-DE-CONCEPTOS
    title: Lista  de Conceptos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-de-conceptos (
        name: Lista  de Conceptos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_CONCEPTO,
                       DESCRIPCION,
                       PARA_EMPLEADO,
                       TIPO,
                       ID_EMPRESA,
                       COD_USUARIO_AUD,
                       PRIORIDAD,
                       UNI_CANTIDAD,
                       COEFICIENTE,
                       MONTO,
                       ID_GRUPO_CONC,
                       COD_GRUPO_CTA,
                       AFECTA_BASICO,
                       CASE AFECTA_BASICO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_BASICO_ICON,
                       AFECTA_AGUINALDO,
                        CASE AFECTA_AGUINALDO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_AGUINALDO_ICON,
                       AFECTA_IPS,
                       CASE AFECTA_IPS
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_IPS_ICON,
                       AFECTA_EXTRACTO,
                       CASE AFECTA_EXTRACTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_EXTRACTO_ICON,
                       IND_DISCRIMINA_EXENTO,
                       CASE IND_DISCRIMINA_EXENTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END IND_DISCRIMINA_EXENTO_ICON,
                       IND_AFECTA_TIEMPO_TRAB,
                       CASE IND_AFECTA_TIEMPO_TRAB
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END IND_AFECTA_TIEMPO_TRAB_ICON,
                       COD_ASOCIACION,
                       ID_SUCURSAL,
                       AFECTA_PROM_COMIS,
                       CASE AFECTA_PROM_COMIS
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_PROM_COMIS_ICON,
                       DESGLOSAR,
                       ACTIVO,
                       AFECTA_SUELDO_ASIENTO,
                       CASE AFECTA_SUELDO_ASIENTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_SUELDO_ASIENTO_ICON,
                       AFECTA_IVA,
                       CASE AFECTA_IVA
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_IVA_ICON,
                       ID_CONCEP_ASOC,
                       TIPO_CON_COMP,
                       PROVISIONA_AGUINALDO,
                       ES_PREMIO,
                       ES_DEMANDA,
                       ID_CENTRO,
                       USA_CENTRO_SEC,
                       ID_CENTRO_IND,
                       CHEQUE_GLOBAL,
                       ID_CONCEPTO_COMPRA,
                       GENERA_CHEQUE_IND_MOV,
                       GENERA_CHEQUE_GLO_MOV,
                       ID_CUENTA,
                       ORDEN_LIQ_SAL,
                       AFECTA_BONIFICACION,
                        CASE AFECTA_BONIFICACION
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AFECTA_BONIFICACION_ICON
                  from RHW_CONCEPTOS
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 305
                items: {
                    P305_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 9735402407631553
        }

