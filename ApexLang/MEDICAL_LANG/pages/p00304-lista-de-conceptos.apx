    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @lista-de-conceptos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 305
                clearCache: 305
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 20
            region: @lista-de-conceptos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 312
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lista-de-conceptos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-conceptos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go to Page 312
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 312
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

