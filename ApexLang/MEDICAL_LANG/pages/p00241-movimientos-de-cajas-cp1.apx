page 241 (
    name: Movimientos de Cajas-Pagos
    alias: MOVIMIENTOS-DE-CAJAS-CP1
    title: Movimientos de Cajas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region movimientos-de-cajas-cp (
        name: Movimientos de Cajas CP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.NRO_MOV_CAJ,
                       C.FEC_MOV_CAJ,
                       C.ANULADO,
                       C.FEC_ANULACION,
                       C.ID_USUARIO,
                       C.TOT_NRO_MOV_CAJ,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ID_PROVEEDOR,
                       C.COD_USUARIO_AUD,
                       C.ID_ORDEN_PAGO,
                       C.IND_IMPRESION,
                       REPLACE(REPLACE(C.ASIENTOS,'*'),'caja') ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'caja'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_MOV_CAJ)
                          AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTO_ID,
                       C.ID_CENTRO_COSTO,
                       C.NRO_MOV_CAJ_CEN,
                       C.COMENTARIO,
                         CASE ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN ''
                       END AS ANULADO_ICON
                  from CPW_CABECERA_CAJAS C
                  WHERE ID_EMPRESA=:P0_COD_EMPRESA
                  ORDER BY TO_NUMBER(NRO_MOV_CAJ) DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 238
                items: {
                    P238_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 52899837831986250
        }

        column ANULADO (
            type: plainText
            heading {
                heading: Anulado
            }
            layout {
                sequence: 9
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ANULADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ANULADO_ICON (
            type: hidden
            heading {
                heading: Anulado Icon
            }
            layout {
                sequence: 97
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AH
            }
        )

        column ASIENTOS (
            type: link
            heading {
                heading: Asientos
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: center
            }
            link {
                target: {
                    page: 235
                    items: {
                        P235_ID: #ASIENTO_ID#
                    }
                }
                linkText: #ASIENTOS#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column ASIENTO_ID (
