    process procesar-excel (
        name: Procesar Excel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    vid_oferta_cab number(9) := :P679_ID;
                    vid_empresa number(9)   := :P0_ID_EMPRESA;
                    vnro_item varchar2(9);
                    vid_articulo number(9) := W_BUSCA_PARAMETRO(PCOD_MODULO  => 'ST' /*IN VARCHAR2*/,
                                                                 PPARAMETRO  => 'ID_ART_ESTANDAR' /*IN VARCHAR2*/);       
                    vcod_articulo_ref varchar(15); --cod articulo catalogo                                                 
                    vDESC_ARTICULO_REF varchar2(150);
                    vid_unidad_medida number(9);
                    vid_presentacion number(9);
                    vid_marca number(9);
                    vpais_procedencia varchar(30);
                    vid_proveedor number(9);
                    vcosto_unitario_local number(9,2);
                    vcosto_total_local number(9,2);
                    vPORCENTAJE_MARGEN number(3,2);
                    vCantidad number(9);
                    vmargen_total number(9,2);
                    vPRECIO_TOTAL LCW_OFERTAS_DET.PRECIO_TOTAL%type;
                    vCANTIDAD_PRC LCW_OFERTAS_DET.CANTIDAD_PRC%type;
                    vPRECIO_TOTAL_PRC LCW_OFERTAS_DET.PRECIO_TOTAL_PRC%type;
                    vMENOS_25 LCW_OFERTAS_DET.MENOS_25%type;
                    vPAC LCW_OFERTAS_DET.PAC%type;
                    vMAS_15 LCW_OFERTAS_DET.MAS_15%type;
                    vIND_CONVIENE LCW_OFERTAS_DET.IND_CONVIENE%type;
                    
                    vtot_comprobante LCW_OFERTAS_DET.PRECIO_TOTAL_PRC%type := 0;
                    
                
                    VNOMBRE_ARCHIVO     VARCHAR(100);
                    VBANDERA            NUMBER(1);
                BEGIN
                   -- Borra el detalle 
                    IF  APEX_COLLECTION.COLLECTION_EXISTS('OFERTAS_EXCEL') THEN
                        APEX_COLLECTION.TRUNCATE_COLLECTION('OFERTAS_EXCEL');
                    END IF;
                    
                    -- Vuelve a crear el detalle
                    IF NOT APEX_COLLECTION.COLLECTION_EXISTS('OFERTAS_EXCEL') THEN
                        APEX_COLLECTION.CREATE_COLLECTION('OFERTAS_EXCEL');
                    END IF; 
                
                    VNOMBRE_ARCHIVO := :P679_EXCEL;
                    
                    for r1 in (select *  
                                 from apex_application_temp_files f, 
                                      table( apex_data_parser.parse(
                                                p_content                     => f.blob_content,
                                                p_add_headers_row             => 'N',
                                                p_file_name                   => f.filename) 
                                            ) p
                                 where f.name LIKE VNOMBRE_ARCHIVO
                              )
                    LOOP
                        IF NVL(R1.COL001,'NO_DATA') <> 'NO_DATA' THEN
                            /*raise_application_error(-20000,R1.COL001||' '||
                            R1.COL002||' '||
                            R1.COL003||' '||
                            R1.COL004||' '||
                            R1.COL005||' '||
                            R1.COL006||' '||
                            R1.COL007||' '||
                            R1.COL008||' '||
                            R1.COL009);*/
                            /*
                            item, codigo_catalago, desc_ref, um, PRESENTACION, cantidad, marca, procedencia, proveedor, COSTO_UNITARIO_LOCAL
                            costo_local_total, porc_margen, margen_total, precio_total, cantidaD_prc,precio_total_real 
                            */
                            Vnro_item := NVL(TO_NUMBER(REPLACE(R1.COL001, '.', '')), 0)/10;
                            --VID_ARTICULO := BUSCA_ARTICULO(:P0_ID_EMPRESA, NVL(TO_NUMBER(REPLACE(R1.COL002, '.', '')), 0)/10);
                            vcod_articulo_ref := R1.COL002;
                            vDESC_ARTICULO_REF := R1.COL003;
                            vid_unidad_medida := BUSCA_UNI_MED(NVL(TO_NUMBER(REPLACE(R1.COL004 /*IN VARCHAR2*/, '.', '')), 0)/10);
                            vid_presentacion := busca_presentacion(R1.COL005);
                            vCantidad       := NVL(TO_NUMBER(REPLACE(R1.COL006, '.', '')), 0)/10; 
                            vid_marca       := busca_marca(R1.COL007);
                            vpais_procedencia := R1.COL008;
                            vid_proveedor := BUSCA_PROVEEDOR(
                            P_ID_EMPRESA    => :P0_ID_EMPRESA, /*IN NUMBER*/
                            P_COD_PROVEEDOR => NVL(TO_NUMBER(REPLACE(R1.COL009 /*IN VARCHAR2*/, '.', '')), 0)/10
                            );
                            vcosto_unitario_local:= NVL(TO_NUMBER(REPLACE(R1.COL010, '.', '')), 0)/10;
                            vcosto_total_local := NVL(TO_NUMBER(REPLACE(R1.COL011, '.', '')), 0)/10;
                            vPORCENTAJE_MARGEN := NVL(TO_NUMBER(REPLACE(R1.COL012, '.', '')), 0)/10;
                            vmargen_total := NVL(TO_NUMBER(REPLACE(R1.COL013, '.', '')), 0)/10;
                            vprecio_total := NVL(TO_NUMBER(REPLACE(R1.COL014, '.', '')), 0)/10;
                            vCANTIDAD_PRC := NVL(TO_NUMBER(REPLACE(R1.COL015, '.', '')), 0)/10;
                            vPRECIO_TOTAL_PRC := NVL(TO_NUMBER(REPLACE(R1.COL016, '.', '')), 0)/10;
                
                            vtot_comprobante := vtot_comprobante + vPRECIO_TOTAL_PRC;         
                
                            BEGIN
                                insert into lcw_ofertas_det(
                                    ID_OFERTA_CAB,
                                    ID_EMPRESA,
                                    NRO_ITEM,
                                    ID_ARTICULO,
                                    COD_ARTICULO_REF,
                                    ID_UNIDAD_MEDIDA,                    
                                    DESC_ARTICULO_REF,                   
                                    ID_PROVEEDOR,
                                    ID_MARCA,
                                    ID_PRESENTACION,
                                    PAIS_PROCEDENCIA,
                                    COSTO_UNITARIO_LOCAL,
                                    COSTO_TOTAL_LOCAL,
                                    PORCENTAJE_MARGEN,
                                    MARGEN_TOTAL,
                                    PRECIO_TOTAL,
                                    CANTIDAD_PRC,
                                    PRECIO_TOTAL_PRC,
                                    PAC,
                                    IND_CONVIENE,
                                    MENOS_25,
                                    MAS_15
                                )
                                values(
                                            vID_OFERTA_CAB,
                                            vID_EMPRESA,
                                            vNRO_ITEM,
                                            vID_ARTICULO,
                                            vCOD_ARTICULO_REF,
                                            vID_UNIDAD_MEDIDA,
                                            vDESC_ARTICULO_REF,                           
                                            vID_PROVEEDOR,                     
                                            vID_MARCA,
                                            vID_PRESENTACION,
                                            vPAIS_PROCEDENCIA,
                                            vCOSTO_UNITARIO_LOCAL,
                                            vCOSTO_TOTAL_LOCAL,
                                            vPORCENTAJE_MARGEN,
                                            vMARGEN_TOTAL,
                                            vPRECIO_TOTAL,
                                            vCANTIDAD_PRC,
                                            vPRECIO_TOTAL_PRC,
                                            vPAC,
                                            vIND_CONVIENE,
                                            vMENOS_25,
                                            vMAS_15
                                            );
                            EXCEPTION
                                WHEN no_data_found THEN
                                    RAISE_APPLICATION_ERROR(-20999, 'ERROR: al insertar ' || SQLERRM);
                                WHEN OTHERS THEN 
                                    RAISE_APPLICATION_ERROR(-20994, 'Error inesperado al cargar el precio del artículo: ' || R1.COL001 || ' -.ERR: ' || SQLERRM);
                            END;
                
                        END IF;
                        
                    END LOOP; 
                    begin
                        update lcw_ofertas_Cab
                        set tot_resolucion = vtot_comprobante
                        where id = vid_oferta_Cab;
                    exception  
                        when others then 
                         raise_application_error(-20000,'Error al calcular el total comprobante '||sqlerrm);
                    end;
                
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 8842809684143817
        }
        serverSideCondition {
            whenButtonPressed: @excel
        }
    )

