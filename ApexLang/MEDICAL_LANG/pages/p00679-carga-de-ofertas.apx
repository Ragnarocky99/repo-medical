        execution {
            sequence: 150
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles-de-oferta
            columns: [
                CANTIDAD_SISTEMA
                ID_PRESENTACION
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    select to_number(replace(en.descripcion,'.',','))*:CANTIDAD_SISTEMA
                    into :VOLUMEN_SISTEMA
                    from stw_envases en
                    where en.id = :ID_PRESENTACION;
                    END;
                    ```
                itemsToSubmit: [
                    CANTIDAD_SISTEMA
                    ID_PRESENTACION
                ]
                itemsToReturn: VOLUMEN_SISTEMA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

