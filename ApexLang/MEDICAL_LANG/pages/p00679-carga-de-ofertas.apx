    region carga-de-ofertas (
        name: Carga de Ofertas
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NRO_ORDEN,
                       NRO_OFERTA,
                       FEC_OFERTA,
                       NRO_LICITACION,
                       NRO_POLIZA,
                       FEC_POLIZA_INI,
                       FEC_POLIZA_FIN,
                       TOT_RESOLUCION,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       DECIMALES,
                       ID_USUARIO,
                       FEC_ALTA,
                       COD_USU_ANU,
                       ID_CLIENTE,
                       NRO_ID,
                       ESTADO,
                       FEC_ESTADO
                  from LCW_OFERTAS_CAB
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalles-de-oferta (
        name: Detalles de Oferta
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_OFERTA_CAB,
                       NRO_ITEM,       
                       ID_ARTICULO,
                       (select descripcion from stw_articulos where id = ID_ARTICULO) as desc_articulo, -- el artículo sistema
                       COD_ARTICULO_REF, -- cod articulo catálogo
                       ID_UNIDAD_MEDIDA,       
                       ID_PRESENTACION,
                       ID_MARCA,
                       PAIS_PROCEDENCIA, 
                       ID_PROVEEDOR,
                       COSTO_UNITARIO_LOCAL,
                       COSTO_TOTAL_LOCAL,
                       PORCENTAJE_MARGEN,
                       MARGEN_TOTAL,
                       CANTIDAD_PRC,
                       PRECIO_TOTAL_PRC,
                       MENOS_25,
                       PAC,
                       MAS_15,            
                       IND_CONVIENE,       
                       desc_articulo_ref,
                       NRO_LOTE,
                        case 
                         when (100 * ROUND((1+nvl(PORCENTAJE_MARGEN,1)/100) * COSTO_TOTAL_GS,2)/PAC) < 75 
                          then round(100 * ROUND((1+nvl(PORCENTAJE_MARGEN,1)/100) * COSTO_TOTAL_GS)/PAC,2) || '% ❌El total es menor que el 75% del total estimado'
                         when (100 * ROUND((1+nvl(PORCENTAJE_MARGEN,1)/100) * COSTO_TOTAL_GS,2)/PAC) > 115
                          then round((100 * ROUND((1+nvl(PORCENTAJE_MARGEN,1)/100) * COSTO_TOTAL_GS)/PAC),2) || '%. 🟨El total es mayor que el 115% del total estimado'
                         else 
                             round((100 * ROUND((1+nvl(PORCENTAJE_MARGEN,1)/100) * COSTO_TOTAL_GS)/PAC),2) || '%. ✅El total está en el rango 75%-115% del total estimado'
                       end as datos_margen  ,
                       id_licitacion_det,
                       id_licitacion_cab,
                       (select cod_origen_art from stw_articulos where id = d.id_Articulo) as cod_fabricante,
                       volumen_sistema,
                       volumen_catalogo,
                       volumen_sistema-volumen_catalogo as diferencia_volumen,
                       cantidad_Sistema,
                       id_presentacion_catalogo,
                       ID_UNIDAD_MEDIDA_CATALOGO,
                       cantidad_confirmada,
                       ind_se_oferta,
                       id_moneda,
                       tip_cambio,
                       COSTO_TOTAL_GS,
                       ID_TIPO_ENTREGA,
                       (select precio_unitario_estimado
                          from lcw_licitaciones_det k
                          where k.id = d.id_licitacion_det) as precio_unitario_referencial
                  from LCW_OFERTAS_DET d
                  where ID_OFERTA_CAB  = :P679_ID
                ```
            pageItemsToSubmit: P679_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
