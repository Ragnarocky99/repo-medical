        comments {
            comments: "Setea el cambio de la moneda seleccionada  de la factura "
        }

        action cambio (
            name: Cambio
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                    RETURN FTIPOS_CAMBIO(:P679_ID_MONEDA,SYSDATE,'C','V');
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al encontrar el cambio de la moneda');
                    END;
                    ```
                itemsToSubmit: P679_ID_MONEDA
            }
            affectedElements {
                selectionType: items
                items: P679_TIP_CAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
