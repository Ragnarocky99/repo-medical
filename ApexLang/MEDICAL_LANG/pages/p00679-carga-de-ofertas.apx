        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    declare v_user varchar2(20);
                     begin
                     if :P679_ESTADO = 'A' then
                        v_user := :APP_USER;
                        :P679_COD_USU_ANU := v_user;
                      else 
                        v_user := null;
                        :P679_COD_USU_ANU := v_user;
                      end if;
                      end;
                     end;
                    ```
