    dynamicAction calcular-margen (
        name: Calcular Margen
        execution {
            sequence: 140
        }
        when {
            event: keyup
            selectionType: columns
            interactiveGrid: @detalles-de-oferta
            columns: PORCENTAJE_MARGEN
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: ROUND((REPLACE(:PORCENTAJE_MARGEN,'.','')/100) * REPLACE(:COSTO_TOTAL_GS,'.',''))
                itemsToSubmit: [
                    PORCENTAJE_MARGEN
                    COSTO_TOTAL_GS
                ]
            }
            affectedElements {
                selectionType: columns
                columns: MARGEN_TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    ROUND((1+REPLACE(:PORCENTAJE_MARGEN,'.','')/100) * REPLACE(:COSTO_TOTAL_GS,'.',''))
                    
                    ```
                itemsToSubmit: [
                    PORCENTAJE_MARGEN
                    COSTO_TOTAL_GS
                ]
            }
            affectedElements {
                selectionType: columns
                columns: PRECIO_TOTAL_PRC
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare vporcentaje_relativo number(9,2);
                    begin
                    /*raise_application_error(-20000,'
                     porc: '||:PORCENTAJE_MARGEN||'
                     costo: '||:COSTO_TOTAL_GS||'
                     pac: '||:PAC||'
                     ');*/
                     vporcentaje_relativo := 100 * ROUND((1+REPLACE(nvl(:PORCENTAJE_MARGEN,1),'.','')/100) * REPLACE(NVL(:COSTO_TOTAL_GS,-1),'.',''))/REPLACE(:PAC,'.','');
                     
                     if vporcentaje_relativo < 75 then
                      return vporcentaje_relativo || '%. ❌El total es menor que el 75% del total estimado';
                     elsif vporcentaje_relativo > 115 then
                      return vporcentaje_relativo || '%. 🟨El total es mayor que el 115% del total estimado';
                     else 
                       return vporcentaje_relativo || '%. ✅El total está en el rango 75%-115% del total estimado';
                     end if;
                    end;
                    ```
                itemsToSubmit: [
                    PORCENTAJE_MARGEN
                    COSTO_TOTAL_GS
                    PAC
                ]
            }
            affectedElements {
                selectionType: columns
                columns: DATOS_MARGEN
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction el-purete (
        name: El purete
        execution {
            sequence: 200
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles-de-oferta
            columns: [
                COSTO_UNITARIO_LOCAL
                ID_MONEDA
                PORCENTAJE_MARGEN
                CANTIDAD_SISTEMA
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare -- montos a utilizar
                    v_tc number := ftipos_cambio(nvl(:ID_MONEDA,32),sysdate,'C','V');
                    v_total_local number := replace(nvl(:COSTO_UNITARIO_LOCAL,0),'.','') * nvl(:CANTIDAD_SISTEMA,1);
                    v_porc_margen number := replace(nvl(:PORCENTAJE_MARGEN,0),'.','');
                    v_pac number := REPLACE(nvl(:PAC,0),'.','');
                    vporcentaje_relativo number := round(100*(v_total_local +(v_porc_margen/100) * v_total_local)*v_tc/v_pac,3);
                    v_resultado_datos varchar(100);
                    begin
                      -- 1ro, setea el tip_cambio
                      :TIP_CAMBIO := v_tc;  
                     -- 2do, setea el costo total
                     :COSTO_TOTAL_LOCAL := v_total_local;
                     -- 3ro, setea el margen total
                     :MARGEN_TOTAL := ROUND( (v_porc_margen/100) * v_total_local );
                     --4to, el precio_total_prc
                     :PRECIO_TOTAL_PRC := v_total_local + ROUND((v_porc_margen/100) * v_total_local);
                     -- 5to, el costo_total_gs
                     :COSTO_TOTAL_GS := (v_total_local + ROUND((v_porc_margen/100) * v_total_local)) * v_tc;
                     --6to y último, los datos del margen
                     if vporcentaje_relativo < 75 then
                      v_resultado_datos := vporcentaje_relativo || '%. ❌El total es menor que el 75% del total estimado';
                     elsif vporcentaje_relativo > 115 then
                      v_resultado_datos := vporcentaje_relativo || '%. 🟨El total es mayor que el 115% del total estimado';
                     else 
                      v_resultado_datos := vporcentaje_relativo || '%. ✅El total está en el rango 75%-115% del total estimado';
                     end if;
                     :DATOS_MARGEN := v_resultado_datos;
                    end;
                    ```
                itemsToSubmit: [
                    ID_MONEDA
                    COSTO_UNITARIO_LOCAL
                    PORCENTAJE_MARGEN
                    CANTIDAD_SISTEMA
                    PAC
                ]
                itemsToReturn: [
                    TIP_CAMBIO
                    COSTO_TOTAL_LOCAL
                    MARGEN_TOTAL
                    PRECIO_TOTAL_PRC
                    COSTO_TOTAL_GS
                    DATOS_MARGEN
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log('hola');
                    var model = apex.region("Detalles").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    var ind_adjudicado = "";
                    col_amt = model.getFieldKey("COSTO_TOTAL_GS");
                    col_adjudicado = model.getFieldKey("IND_CONVIENE");
                    model.forEach(function(igrow) {
                        //console.log("valor: ",igrow[col_amt]);
                        n_amt = parseInt(igrow[col_amt].replaceAll('.',''), 10);
                        ind_adjudicado = igrow[col_adjudicado];
                        //console.log("parseado: ",n_amt);
                        console.log("adjudicado: ", ind_adjudicado, "del total: ",n_amt);
                        if (!isNaN(n_amt) && ind_adjudicado === "S")  {
                            n_totamt += n_amt;
                        }
                    });
                    console.log("total: ",n_totamt);
                    apex.item("P679_TOT_RESOLUCION").setValue(n_totamt);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P679_TOT_RESOLUCION
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

