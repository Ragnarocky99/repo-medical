page 145 (
    name: Lista de Precios
    alias: LISTA-DE-PRECIOS
    title: Lista de Precios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-precios (
        name: Lista de Precios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_LISTA_PRECIO,
                       DESCRIPCION,
                       ID_MONEDA,
                       ESTADO,
                       CASE
                       WHEN ESTADO ='S' THEN 'fa fa-check u-success-text'
                       WHEN ESTADO ='N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       ABREVIATURA,
                       COD_USUARIO_AUD,
                       COD_LISTA_PRECIO_REF,
                       ID_CANAL_VENTA,
                       ID_CONDICION_VENTA,
                       NRO_CUOTAS,
                       ID_SUBTIPO_TRANS,
                       ID_RUBRO,
                       ID_FAMILIA,
                       ID_MARCA,
                       ID_PROVEEDOR,
                       ID_GRUPO_ART,
                       ID_LINEA,
                       ID_UNIDAD_MEDIDA,
                       ID_ARTICULO,
                       PORC_PRECIO,
                       ID_PRECIO_CAB_BASE,
                       TIPO_CAMBIO
                  from VTW_LISTAS_PRECIOS_CAB
                  WHERE ID_EMPRESA=:P0_COD_EMPRESA
                  
                 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 146
                items: {
                    P146_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 16071025836443943
        }

