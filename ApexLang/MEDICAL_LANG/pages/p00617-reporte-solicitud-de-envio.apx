page 617 (
    name: Reporte Solicitud de Envio
    alias: REPORTE-SOLICITUD-DE-ENVIO
    title: Reporte Solicitud de Envio
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P617_FECHA (
        type: textField
        label {
            label: Fecha
            alignment: left
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P617_ID_SUCURSAL (
        type: textField
        label {
            label: Id Sucursal
            alignment: left
        }
        layout {
            sequence: 50
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P617_ID_SUCURSAL_ENT (
        type: textField
        label {
            label: Id Sucursal Ent
            alignment: left
        }
        layout {
            sequence: 40
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P617_NRO_ENVIO (
        type: textField
        label {
            label: Nro Envio
            alignment: left
        }
        layout {
            sequence: 70
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P617_SER_ENVIO (
        type: textField
        label {
            label: Ser Envio
            alignment: left
        }
        layout {
            sequence: 60
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P617_USUARIO (
        type: textField
        label {
            label: Usuario
            alignment: left
        }
        layout {
            sequence: 80
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          v_nom_empresa varchar2(150);
                        BEGIN
                          SELECT E.DESCRIPCION INTO v_nom_empresa FROM BSW_EMPRESAS E WHERE E.ID = :P0_ID_EMPRESA;
                          xlog (l_proc, 'url (orig):' || l_report_url);
                          
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('Solicitud_Envio'),
                                  p_rep_format          => apex_util.url_encode('pdf'),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                  p_additional_params   => ('P_ID_EMPRESA='||:P0_ID_EMPRESA||'&'||
                                                            'P_FECHA='||:P617_FECHA||'&'||
                                                            'P_ID_SUCURSAL_ENT='||:P617_ID_SUCURSAL_ENT||'&'||
                                                            'P_ID_SUCURSAL='||:P617_ID_SUCURSAL||'&'||
                                                            'P_SER_ENVIO='||:P617_SER_ENVIO||'&'||
                                                            'P_NRO_ENVIO='||:P617_NRO_ENVIO||'&'||
                                                            'P_USUARIO='||:P617_USUARIO||'&'||
                                                            'P_USER='||:APP_USER),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          apex_application.stop_apex_engine();
                
                        exception
                          when apex_application.e_stop_apex_engine then
                            null; -- ok, stop engine raises exception, we can ignore that
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
    )

)

