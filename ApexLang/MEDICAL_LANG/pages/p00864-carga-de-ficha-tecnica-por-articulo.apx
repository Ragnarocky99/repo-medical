    process guardar-imagen (
        name: Guardar  Imagen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                  L_FILENAME                     VARCHAR2(100);
                  L_MIMETYPE                     VARCHAR2(100);
                  L_BLOB                         BLOB;
                  V_ID                          NUMBER(10);
                BEGIN
                
                 IF :P864_ARCHIVO_IMAGEN IS NULL THEN
                   RAISE_APPLICATION_ERROR(-20000,'!No se subio ningun archivo');
                 END IF; 
                
                
                
                    SELECT FILENAME, MIME_TYPE, BLOB_CONTENT
                      INTO L_FILENAME, L_MIMETYPE, L_BLOB
                      FROM APEX_APPLICATION_TEMP_FILES
                     WHERE NAME = :P864_ARCHIVO_IMAGEN;
                
                     INSERT INTO PDW_FICHA_TECNICA_IMG(
                       DESCRIPCION,
                       MIMETYPE,
                       FILENAME,
                       ID_FICHA_TECNICA)
                  VALUES  (NVL(:P864_DESCRIPCION_IMAGEN,L_FILENAME),L_MIMETYPE,L_FILENAME,:P864_ID)
                  RETURNING ID INTO V_ID
                  ;
                
                WRITE_BLOB_TO_FILE(P_DIRECTORY_NAME => 'IMAGENES_FICHA_TECNICA',
                                                     P_FILE_NAME      => :P864_ID || '-' ||
                                                                         V_ID,
                                                     P_BLOB           => L_BLOB);
                  EXCEPTION
                   WHEN OTHERS THEN 
                    RAISE_APPLICATION_ERROR(-20000,'Error en el proceso de guardar imagen: '||SQLERRM);
                
                
                
                END;                                     
                ```
        }
        execution {
            sequence: 260
        }
        advanced {
            executionMappingIdentifier: 7591911254166712
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }
    )

