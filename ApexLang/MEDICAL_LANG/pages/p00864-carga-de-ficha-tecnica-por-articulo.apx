    dynamicAction hacer-consumo-general (
        name: HACER CONSUMO GENERAL
        execution {
            sequence: 210
        }
        when {
            selectionType: columns
            interactiveGrid: @mat-prim
            columns: [
                ANCHO
                LARGO
                PARTES
                BIES_ANCHO
                BIES_LARGO
                GRAMAJE
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF  :ANCHO IS NOT NULL 
                        AND :LARGO IS NOT NULL
                        AND :MOLDES IS NOT NULL
                        AND :BIES_ANCHO IS NOT NULL
                        AND :BIES_LARGO IS NOT NULL
                        AND :GRAMAJE IS NOT NULL THEN
                        :CONSUMO_GRAL := ((
                                    ((REPLACE(:ANCHO,'.','') * (REPLACE(:LARGO,'.','') + 10)) / REPLACE(:MOLDES,'.','') + (REPLACE(:BIES_ANCHO,'.','')) * REPLACE(:BIES_LARGO,'.',''))) * REPLACE(:GRAMAJE,'.','') ) / 10000000;
                        END IF;
                        EXCEPTION
                        WHEN OTHERS THEN
                      raise_application_error(-20000, 'Error al calcular consumo promedio: '||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    ANCHO
                    LARGO
                    MOLDES
                    BIES_ANCHO
                    BIES_LARGO
                ]
                itemsToReturn: CONSUMO_GRAL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hacer-consumo-lineal (
        name: HACER CONSUMO LINEAL
        execution {
            sequence: 170
        }
        when {
            selectionType: columns
            interactiveGrid: @mat-prim
            columns: [
                RENDIMIENTO
                CONSUMO_PROM
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                           IF :RENDIMIENTO IS NOT NULL AND :CONSUMO_PROM IS NOT NULL THEN
                           :CONSUMO_LINEAL := (REPLACE(:RENDIMIENTO,'.','') * REPLACE(:CONSUMO_PROM,'.',''));
                           END IF;
                    EXCEPTION
                            WHEN OTHERS THEN
                            raise_application_error(-20000, 'No fue posible calcular el consumo lineal: '|| sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    RENDIMIENTO
                    CONSUMO_PROM
                ]
                itemsToReturn: CONSUMO_LINEAL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

