    region talles (
        name: Talles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT T.ID,
                       T.ID_EMPRESA,
                       T.ID_TALLE,
                       T.ID_FICHA_TECNICA,
                       CASE NVL(T.IND_GENERADO,'N') 
                       WHEN 'S' THEN 'GENERADO'
                       WHEN 'N' THEN 'PENDIENTE A GENERAR'
                       END AS ESTADO_GENERACION,
                       ORDEN
                FROM PDW_TALLES_ART T
                where T.ID_FICHA_TECNICA = :P864_ID
                
                ```
            pageItemsToSubmit: P864_ID
        }
        layout {
            sequence: 40
            parentRegion: @ficha-tecnica
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Talles
            regionDisplaySelector: true
        }
        readOnly {
            type: item!=value
            item: P864_ESTADO
            value: D
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
            addButtonLabel: Añadir
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 127772852946307338
        }

