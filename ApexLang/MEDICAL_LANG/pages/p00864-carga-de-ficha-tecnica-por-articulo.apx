    dynamicAction anhadir-botones-grillas (
        name: "ANHADIR BOTONES GRILLAS "
        execution {
            sequence: 100
        }
        when {
            event: ready
        }

        action region-curva-de-talles (
            name: Region Curva de Talles
            action: plugin/fosInteractiveGridAddButton
            settings {
                addButtonTo: toolbarAddRowGroup
                label: Cargar Talles
                icon: fa-plus
                actionName: Cargar
                onClick: triggerEvent
                eventName: Cargar
            }
            affectedElements {
                selectionType: region
                region: @curva-de-talles
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM PDW_TALLES_ART
                    WHERE ID_FICHA_TECNICA = :P864_ID
                    AND :P864_ESTADO = 'D'
                    ```
            }
        )

        action region-de-costos-procesos (
            name: Region de Costos Procesos
            action: plugin/fosInteractiveGridAddButton
            settings {
                addButtonTo: toolbarAddRowGroup
                label: Cargar Procesos
                icon: fa-plus
                actionName: CargarProcesos
                onClick: triggerEvent
                eventName: CargarProcesos
            }
            affectedElements {
                selectionType: region
                region: @costos-de-procesos
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: noRowsReturned
                sqlQuery:
                    ```sql
                    select 1
                      from PDW_PROCESOS_FICHA c      
                     where c.id_ficha_tecnica = :P864_ID
                    ```
            }
        )

    )

    dynamicAction calcula-montos (
        name: Calcula Montos
        execution {
            sequence: 260
        }
        when {
            selectionType: columns
            interactiveGrid: @new
            columns: CANTIDAD
        }

        action total (
            name: TOTAL
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: ROUND(:CANTIDAD * REPLACE(:COSTO, '.', ''), MONEDA_DECIMALES(:ID_MONEDA))
                itemsToSubmit: [
                    CANTIDAD
                    COSTO
                    ID_MONEDA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculo-de-consumo-prom (
        name: CALCULO DE CONSUMO_PROM
        execution {
            sequence: 160
        }
        when {
            selectionType: columns
            interactiveGrid: @mat-prim
            columns: [
                ANCHO
                LARGO
                PARTES
                BIES_ANCHO
                BIES_LARGO
                GRAMAJE
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF  :ANCHO IS NOT NULL 
                        AND :LARGO IS NOT NULL
                        AND :MOLDES IS NOT NULL
                        AND :BIES_ANCHO IS NOT NULL
                        AND :BIES_LARGO IS NOT NULL
                        AND :GRAMAJE IS NOT NULL THEN
                        :CONSUMO_PROM := ((
                                    ((REPLACE(:ANCHO,'.','') * (REPLACE(:LARGO,'.','') + 10)) / REPLACE(:MOLDES,'.','') + (REPLACE(:BIES_ANCHO,'.','')) * REPLACE(:BIES_LARGO,'.',''))) * REPLACE(:GRAMAJE,'.','') ) / 10000000;
                        :CONSUMO_GRAL := ((
                                    ((REPLACE(:ANCHO,'.','') * (REPLACE(:LARGO,'.','') + 10)) / REPLACE(:MOLDES,'.','') + (REPLACE(:BIES_ANCHO,'.','')) * REPLACE(:BIES_LARGO,'.',''))) * REPLACE(:GRAMAJE,'.','') ) / 10000000;
                        END IF;
                        EXCEPTION
                        WHEN OTHERS THEN
                      raise_application_error(-20000, 'Error al calcular consumo promedio: '||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    LARGO
                    MOLDES
                    BIES_ANCHO
                    BIES_LARGO
                    GRAMAJE
                    ANCHO
                ]
                itemsToReturn: [
                    CONSUMO_PROM
                    CONSUMO_GRAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction carga-de-procesos (
        name: Carga de Procesos
        execution {
            sequence: 220
        }
        when {
            event: custom
            customEvent: CargarProcesos
            selectionType: region
            region: @costos-de-procesos
        }

        action insercion-de-procesos (
            name: INSERCION de PROCESOS
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var json_detalle = JSON.parse($v('P864_JSON_DETALLES'));
                    
                    
                    
                    
                    
                    console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    var $widget = apex.region("DetallesProcesos").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    $model.setValue($newRecord, "ID_PROCESO_PROD",(json_detalle.DETALLE[i].ID).toString());
                    $model.setValue($newRecord, "COSTO_PROCESO",(json_detalle.DETALLE[i].COSTO).toString());
                    }
                    }
                    ```
            }
            affectedElements {
                selectionType: region
                region: @costos-de-procesos
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @costos-de-procesos
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action preparar-json-detalle (
            name: Preparar Json Detalle
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Con este codigo sacamo un JSON para poder insertar en la grilla interactiva
                    -- ya que con el PL/SQL no se puede interactuar con la grilla
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                      OPEN l_cursor FOR
                        select c.id, to_char(nvl(c.costo_estandar,0)) as costo
                          from inv.pdw_procesos_produccion c
                          order by c.nro_orden desc; --desc porque... se inserta en el orden en el que aparecen
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P864_JSON_DETALLES:=JSON_DETALLE;
                    EXCEPTION 
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el detalle de los talles :'||sqlerrm);
                    END;
                    ```
                itemsToReturn: P864_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction carga-de-talles (
        name: carga de talles
        execution {
            sequence: 110
        }
        when {
            event: custom
            customEvent: Cargar
            selectionType: region
            region: @curva-de-talles
        }

        action insercion-de-talles (
            name: INSERCION de TALLES
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var json_detalle = JSON.parse($v('P864_JSON_DETALLES'));
                    
                    
                    
                    
                    
                    console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    $model.setValue($newRecord, "ID_TALLE",(json_detalle.DETALLE[i].ID_TALLE).toString());
                    
                    }
                    }
                    ```
            }
            affectedElements {
                selectionType: region
                region: @curva-de-talles
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @curva-de-talles
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action preparar-json-de-detalle (
            name: Preparar Json de detalle
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Con este codigo sacamo un JSON para poder insertar en la grilla interactiva
                    -- ya que con el PL/SQL no se puede interactuar con la grilla
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    --RAISE_APPLICATION_ERROR(-20000,'error detalle, id emb: '||:P715_PEDIDOS_EMB);
                    
                    
                      OPEN l_cursor FOR
                        SELECT TA.ID_TALLE, T.DESCRIPCION
                        FROM PDW_TALLES_ART TA
                        JOIN STW_TALLES T ON T.ID = TA.ID_TALLE
                        WHERE TA.ID_FICHA_TECNICA = :P864_ID
                        ORDER BY TO_NUMBER(NVL(T.COD_TALLE,0)) DESC;
                    
                        
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P864_JSON_DETALLES:=JSON_DETALLE;
                    EXCEPTION 
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el detalle de los talles :'||sqlerrm);
                    END;
                    ```
                itemsToSubmit: P864_ID
                itemsToReturn: P864_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

