    dynamicAction setear-datos (
        name: SETEAR DATOS
        execution {
            sequence: 190
        }
        when {
            selectionType: columns
            interactiveGrid: @insumos
            columns: ID_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN 
                        IF :ID_ARTICULO IS NOT NULL THEN
                            SELECT 
                                ART.DESCRIPCION,
                                ART.ID_UNIDAD_MEDIDA,
                                NVL(ART.COSTO_PROM,0) AS COSTO_PROM,
                                ART.ID_MONEDA_COSTO,
                                NVL(ART.TIP_CAMBIO_MONEDA_COSTO,1) AS TIP_CAMBIO_MONEDA_COSTO,
                                ART.ID_FAMILIA
                            INTO 
                                :DESCRIPCION_ART,
                                :ID_UNIDAD_MEDIDA,
                                :COSTO,
                                :ID_MONEDA,
                                :TIP_CAMBIO,
                                :ID_FAMILIA 
                            FROM STW_ARTICULOS ART
                         
                            WHERE ART.ID = :ID_ARTICULO;
                        END IF;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: [
                    DESCRIPCION_ART
                    ID_UNIDAD_MEDIDA
                    COSTO
                    TIP_CAMBIO
                    ID_FAMILIA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

