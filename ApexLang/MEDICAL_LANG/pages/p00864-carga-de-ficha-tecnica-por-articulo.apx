    dynamicAction multiplicacion (
        name: MULTIPLICACION
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @insumos
            columns: [
                CANTIDAD
                COSTO
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :COSTO is null  then
                       :TOTAL := 0;
                    end if;
                    
                    if :TOTAL is null then
                       :TOTAL := 0;
                    end if;
                    
                    :TOTAL := REPLACE(:COSTO,'.','') * REPLACE(:CANTIDAD,'.','');
                    --replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)) * replace(:CANTIDAD, '.', '')) * :PORC_IVA ) / (100 + :PORC_IVA),:P715_DECIMALES);
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    COSTO
                ]
                itemsToReturn: TOTAL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

