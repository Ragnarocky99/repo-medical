    region ficha-tecnica (
        name: Ficha Tecnica
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT A.ID,
                       A.ID_EMPRESA,
                       A.COD_FICHA,
                       A.ARTICULO_DESC,
                       A.COD_USUARIO,
                       A.FECHA_INI,
                       A.FECHA_FIN,
                       A.ID_PAIS,
                       A.ID_RUBRO,
                       A.ID_MARCA,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_IVA,
                       A.ID_MONEDA_COSTO,
                       A.ID_MONEDA_BASE,
                       A.ID_PROVEEDOR,
                       A.ID_GRUPO,
                       A.ID_FAMILIA,
                       A.ID_LINEA,
                       A.ID_ENVASE,
