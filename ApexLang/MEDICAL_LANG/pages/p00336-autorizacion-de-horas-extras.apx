page 336 (
    name: Autorizacion de Horas Extras
    alias: AUTORIZACION-DE-HORAS-EXTRAS
    title: Autorizacion de Horas Extras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region autorización-de-horas-extra (
        name: Autorización de Horas Extra
        type: interactiveReport
        source {
            location: localDatabase
            tableName: RHW_AUTORIZACION_HE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 337
                items: {
                    P337_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 13362318419416831
        }

        column COMENTARIO (
            type: plainText
            heading {
                heading: Comentario
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column FEC_FINAL (
            type: plainText
            heading {
                heading: Fecha Final
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column FEC_INICIAL (
            type: plainText
            heading {
                heading: Fecha Inicial
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column HORAS (
            type: hidden
            heading {
                heading: Horas
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column HORA_ANTES (
            type: plainText
            heading {
                heading: Hora Antes
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column HORA_DESPUES (
            type: plainText
            heading {
                heading: Hora Después
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPLEADO (
            type: plainTextBasedOnLov
            heading {
                heading: Empleado
                alignment: center
            }
            lov {
                lov: @lv-empleados
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_NOVEDAD (
            type: hidden
            heading {
                heading: Id Novedad
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Autorización de Horas Extra
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 137257 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMENTARIO (
                sequence: 6
            )

            displayColumn FEC_FINAL (
                sequence: 3
            )

            displayColumn FEC_INICIAL (
                sequence: 2
            )

            displayColumn HORA_ANTES (
                sequence: 4
            )

            displayColumn HORA_DESPUES (
                sequence: 5
            )

            displayColumn ID_EMPLEADO (
                sequence: 1
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @autorización-de-horas-extra
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 337
                items: {
                    P337_ID: &P337_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction when-dialog-closes (
        name: When dialog closes
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @autorización-de-horas-extra
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @autorización-de-horas-extra
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

