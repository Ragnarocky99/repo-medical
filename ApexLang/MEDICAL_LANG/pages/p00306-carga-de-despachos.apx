    dynamicAction calcular-costos (
        name: Calcular Costos
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmar-costos
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    V_TOT_GASTOS NUMBER;
                    V_TOT_GASTOS_CIVA NUMBER;
                    V_VALOR_FOB NUMBER;
                    V_TIP_CAMBIO_SIVA NUMBER;
                    V_TIP_CAMBIO_CIVA NUMBER;
                    V_FACTOR_SIVA NUMBER;
                    V_FACTOR_CIVA NUMBER;
                    V_TOT_GRAVADAS NUMBER;
                    V_PORC_GRAVADAS NUMBER;
                    V_PORC_GRAVADAS_AD NUMBER;
                    V_TOT_COMPROBANTE NUMBER;
                    V_TOT_COMPROBANTE_ADUANA NUMBER;
                    V_TOT_GRAVADAS_ADUANA NUMBER;
                    
                    
                    begin
                    PRORRATEO_MONTO_BKP(W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P0_ID_EMPRESA,:P306_ID,V_TOT_GASTOS,V_TOT_GASTOS_CIVA,V_VALOR_FOB,V_TIP_CAMBIO_SIVA,V_TIP_CAMBIO_CIVA,
                    V_FACTOR_SIVA,V_FACTOR_CIVA,V_TOT_GRAVADAS,V_PORC_GRAVADAS,V_PORC_GRAVADAS_AD,:P306_TIP_CAMBIO,V_TOT_COMPROBANTE,V_TOT_COMPROBANTE_ADUANA,
                    V_TOT_GRAVADAS_ADUANA);
                    :P306_TIP_CAMBIO_CIVA:=ROUND(V_TIP_CAMBIO_CIVA,0);
                    :P306_TIP_CAMBIO_SIVA:=ROUND(V_TIP_CAMBIO_SIVA,0);
                    :P306_VALOR_FOB:=V_VALOR_FOB;
                    :P306_TOT_GASTOS:=ROUND(V_TOT_GASTOS,2);
                    :P306_TOT_GASTOS_CIVA:=ROUND(V_TOT_GASTOS_CIVA,2);
                    :P306_FACTOR_CIVA:=V_FACTOR_CIVA;
                    :P306_FACTOR_SIVA:=V_FACTOR_SIVA;
                    EXCEPTION 
                    WHEN OTHERS THEN 
                    RAISE_APPLICATION_ERROR(-20000,'Error :'||sqlerrm);
                    rollback;
                    end;
                    ```
                itemsToSubmit: [
                    P306_ID
                    P306_TIP_CAMBIO
                ]
                itemsToReturn: [
                    P306_TIP_CAMBIO_SIVA
                    P306_TIP_CAMBIO_CIVA
                    P306_TOT_GASTOS_CIVA
                    P306_TOT_GASTOS
                    P306_VALOR_FOB
                    P306_FACTOR_SIVA
                    P306_FACTOR_CIVA
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: ring
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P306_FEC_PAGO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P306_FEC_PAGO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P306_FEC_PAGO,'/','');
                            conv_fecha := substr(:P306_FEC_PAGO,1,2)||'/'||
                                                      substr(:P306_FEC_PAGO,3,2)||'/'||
                                                      lpad(substr(:P306_FEC_PAGO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P306_FEC_PAGO := conv_fecha;
                            ELSIF (length(:P306_FEC_PAGO) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P306_FEC_PAGO) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P306_FEC_PAGO
                itemsToReturn: P306_FEC_PAGO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridreportchange
            selectionType: region
            region: @embarques
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :ID_EMBARQUE IS NOT NULL AND :P306_ID IS NOT NULL THEN
                    SELECT E.FEC_EMBARQUE,P.COD_PUERTO,P.DESCRIPCION,PR.NRO_COMPROBANTE
                    INTO :FECHA,:COD_PUERTO,:DESC_PUERTO,:NRO_PROFORMA
                    FROM CMW_EMBARQUES E ,CMW_PUERTOS P,CMW_PROFORMAS_CABECERA PR
                    WHERE E.ID_PUERTO=P.ID(+)
                    AND E.ID_PROFORMA=PR.ID
                    AND E.ID=:ID_EMBARQUE;
                    END IF;
                    ```
                itemsToSubmit: [
                    ID_EMBARQUE
                    P306_ID
                ]
                itemsToReturn: [
                    FECHA
                    COD_PUERTO
                    DESC_PUERTO
                    NRO_PROFORMA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction poner-fecha-confirmacion (
        name: Poner fecha Confirmacion
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P306_CONFIRMADO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P306_CONFIRMADO='S' THEN 
                    :P306_FEC_CONFIRMACION:=SYSDATE;
                    
                         DECLARE
                          VID_EMBARQUE   VARCHAR2(15);
                         BEGIN
                          SELECT A.ID_EMBARQUE
                            INTO VID_EMBARQUE
                            FROM CMW_DESPACHOS_DETALLE A
                           WHERE A.ID_DESPACHO_CAB = :P306_ID;
                    
                            ---RAISE_APPLICATION_ERROR(-20000,'03-NRO EMB '||VID_EMBARQUE||' EMBARQUE'||SQLERRM);
                            UPDATE CMW_COMPRAS_CABECERA A
                              SET A.ESTADO = 'C',
                                  A.FEC_ESTADO = SYSDATE
                             WHERE A.ID_EMPRESA = :P306_ID_EMPRESA
                               AND A.ID_EMBARQUE = VID_EMBARQUE;
                            EXCEPTION 
                              WHEN OTHERS THEN
                               RAISE_APPLICATION_ERROR(-20000,'03-No se pudo confirmar la factura! '||VID_EMBARQUE||' EMBARQUE'||SQLERRM);
                           END;
                    
                    ELSE 
                    :P306_FEC_CONFIRMACION:=NULL;
                    
                          DECLARE
                              VID_EMBARQUE   VARCHAR2(15);
                             BEGIN
                              SELECT A.ID_EMBARQUE
                                INTO VID_EMBARQUE
                                FROM CMW_DESPACHOS_DETALLE A
                               WHERE A.ID_DESPACHO_CAB = :P306_ID;
                    
                                ---RAISE_APPLICATION_ERROR(-20000,'03-NRO EMB '||VID_EMBARQUE||' EMBARQUE'||SQLERRM);
                                UPDATE CMW_COMPRAS_CABECERA A
                                  SET A.ESTADO = 'P'
                                 WHERE A.ID_EMPRESA = :P306_ID_EMPRESA
                                   AND A.ID_EMBARQUE = VID_EMBARQUE;
                                EXCEPTION 
                                  WHEN OTHERS THEN
                                   RAISE_APPLICATION_ERROR(-20000,'No se pudo confirmar la factura! '||VID_EMBARQUE||' EMBARQUE'||SQLERRM);
                               END;
                    END IF;
                    ```
                itemsToSubmit: [
                    P306_CONFIRMADO
                    P306_ID_EMPRESA
                    P306_ID
                ]
                itemsToReturn: P306_FEC_CONFIRMACION
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-cambio-dolar (
        name: Tipo Cambio Dolar
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNull
