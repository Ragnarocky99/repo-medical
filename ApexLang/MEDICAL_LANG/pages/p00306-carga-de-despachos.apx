page 306 (
    name: Carga de Despachos
    alias: CARGA-DE-DESPACHOS
    title: Carga de Despachos
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            .comprobante{
              color: #000000;
              background-color: #e0e0e0;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #a8a8a8;
              pointer-events: none;
            }
            
            .a-danger{
                background-color: #f44336;
            }
            
            .totales{
                text-align: center;
                font-size: medium;
            }
            
            #Detalles_ig_toolbar_m1{
                display: none;
            }
            .ocultar{
                display: none
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region despacho (
        name: Despacho
        type: form
        source {
            location: localDatabase
            tableName: CMW_DESPACHOS_CABECERA
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region embarques (
        name: Embarques
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.ID_DESPACHO_CAB,
                       D.NRO_REFERENCIA,
                       D.BASE_IMPONIBLE,
                       D.COD_USUARIO_AUD,
                       D.ID_EMBARQUE,
                       E.FEC_EMBARQUE,
                       P.COD_PUERTO,
                       P.DESCRIPCION AS DESC_PUERTO,
                       PR.NRO_COMPROBANTE AS NRO_PROFORMA
                  from CMW_DESPACHOS_DETALLE D,CMW_EMBARQUES E,CMW_PUERTOS P,
                  CMW_PROFORMAS_CABECERA PR
                  WHERE ID_DESPACHO_CAB=:P306_ID
                  AND D.ID_EMBARQUE=E.ID
                  AND E.ID_PUERTO=P.ID(+)
                  AND E.ID_PROFORMA=PR.ID
                
                ```
            pageItemsToSubmit: P306_ID
        }
        layout {
            sequence: 220
            parentRegion: @despacho
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        headerAndFooter {
            headerText: <h5>Embarques</h5>
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 20742119047784936
        }

