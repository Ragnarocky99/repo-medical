            }
            affectedElements {
                selectionType: items
                items: P306_TIP_CAMBIO
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p306-nro-despacho (
        itemName: P306_NRO_DESPACHO
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante CMW_DESPACHOS_CABECERA.NRO_DESPACHO%TYPE;
                BEGIN
                IF :P306_NRO_DESPACHO IS  NULL THEN
                SELECT NVL(MAX(NRO_DESPACHO),0)+1
                INTO v_nro_comprobante
                FROM 
                 CMW_DESPACHOS_CABECERA 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P306_NRO_DESPACHO;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
    )

