page 788 (
    name: Detalles de Licitacion - Aprobaciones
    alias: DETALLES-DE-LICITACION-APROBACIONES
    title: Detalles de Licitacion - Aprobaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region detalles-articulos-enviados (
        name: Detalles Articulos Enviados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       NRO_ITEM,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       MARCA,
                       PROVEEDOR,
                       PLAZO_ENTREGA,
                       CONDICION_COMPRA,
                       ID_MONEDA_COSTO,
                       TIP_CAMBIO_COSTO,
                       COSTO_TOTAL_RECARGO_GS,
                       PORC_MARGEN,
                       MARGEN_TOTAL,
                       PRECIO_TOTAL
                  FROM LCWV_RESUMEN_COTIZA_OFERTA
                 WHERE ID_LICITACION_CAB = :P788_ID_LICITACION_CAB
                   AND IND_ENVIO = 'S'
                   AND IND_NO_APLICA_PRECIO = 'N'
                   AND IND_NO_PRESENTADO = 'N'
                ```
            pageItemsToSubmit: P788_ID_LICITACION_CAB
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 47901565600328609
        }

        column COD_ARTICULO (
            type: plainText
            heading {
