page 562 (
    name: Mantenimientos de Mensajes
    alias: MANTENIMIENTOS-DE-MENSAJES
    title: Mantenimientos de Mensajes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mantenimientos-de-mensajes (
        name: Mantenimientos de Mensajes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_MENSAJE,
                       DESCRIPCION,
                       IND_MENSAJE,
                       KIA,
                       GRUPO,
                       CASE IND_MENSAJE
                        WHEN 'I' THEN 'Información'
                        WHEN 'B' THEN 'Bloqueo'
                       END IND_MENSAJE_R
                  from LTW_MENSAJES
                 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 563
                items: {
                    P563_ID: \#ID#\
                    P563_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 90725174710457090
        }

        column COD_MENSAJE (
            type: plainText
            heading {
                heading: <p>Código</p>
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: <p>Descripción</p>
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column GRUPO (
            type: plainText
            heading {
                heading: <p>Grupo</p>
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 0
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column IND_MENSAJE (
            type: plainText
            heading {
                heading: <p>Mensaje</p>
            }
            layout {
                sequence: 24
            }
            columnFormatting {
                htmlExpression: #IND_MENSAJE_R#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column IND_MENSAJE_R (
            type: plainText
            heading {
                heading: Ind Mensaje R
                alignment: center
            }
            layout {
                sequence: 44
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column KIA (
            type: hidden
            heading {
                heading: Kia
            }
            layout {
                sequence: 34
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Mantenimientos de Mensajes
        }

        savedReport 907307 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_MENSAJE (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn GRUPO (
                sequence: 3
            )

            displayColumn IND_MENSAJE (
                sequence: 4
            )

            displayColumn KIA (
                sequence: 5
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @mantenimientos-de-mensajes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 563
                clearCache: 563
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @mantenimientos-de-mensajes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @mantenimientos-de-mensajes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

