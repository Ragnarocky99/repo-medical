    dynamicAction cargar-datos-de-factura (
        name: Cargar datos de Factura
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P807_ID_FACTURA_REF
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                        SELECT E.ID ID_FACTURA_DET,
                               A.COD_ARTICULO,
                               E.DESC_ARTICULO,
                               E.NRO_LOTE,
                               E.CANTIDAD,
                               E.PRECIO_UNITARIO_C_IVA,
                               E.PORC_DESCUENTO,
                               E.MONTO_TOTAL_C_IVA,
                               E.ID_COMPROBANTE_CABECERA ID_FACTURA_CAB
                        FROM   VTW_COMPROBANTES_DETALLE E
                        JOIN   STW_ARTICULOS            A ON A.ID = E.ID_ARTICULO
                        JOIN   STW_LOTES                L ON L.ID = E.ID_LOTE
                        WHERE  ID_COMPROBANTE_CABECERA=:P807_ID_FACTURA_REF
                        AND E.ID_ARTICULO=A.ID;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P807_JSON_DETALLES:=JSON_DETALLE;
                    
                    
                      EXCEPTION 
                      WHEN OTHERS THEN 
                      RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el detalle');
                    
                    END;
                    ```
                itemsToSubmit: P807_ID_FACTURA_REF
                itemsToReturn: P807_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    
                    
                    
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P807_JSON_DETALLES'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    orden=orden+1;
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    if((json_detalle.DETALLE[i].NRO_LOTE!=null)){
                    $model.setValue($newRecord, "NRO_LOTE",(json_detalle.DETALLE[i].NRO_LOTE).toString());
                    }
                    $model.setValue($newRecord, "PRECIO_UNITARIO_C_IVA",(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA).toString().replace(/\./g,','));
                    $model.setValue($newRecord, "DESC_ARTICULO",(json_detalle.DETALLE[i].DESC_ARTICULO).toString().replace(/\./g,','));
                    $model.setValue($newRecord, "COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString().replace(/\./g,','));
                    if((json_detalle.DETALLE[i].ID_FACTURA_DET!=null)){
                    $model.setValue($newRecord, "ID_FACTURA_DET",(json_detalle.DETALLE[i].ID_FACTURA_DET).toString())
                    }
                    if((json_detalle.DETALLE[i].PORC_DESCUENTO!=null)){
                    $model.setValue($newRecord, "PORC_DESCUENTO",(json_detalle.DETALLE[i].PORC_DESCUENTO).toString());
                    }
                    if((json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA!=null)){
                    $model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_FACTURA_CAB!=null)){
                    $model.setValue($newRecord, "ID_FACTURA_CAB",(json_detalle.DETALLE[i].ID_FACTURA_CAB).toString())
                    }
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

