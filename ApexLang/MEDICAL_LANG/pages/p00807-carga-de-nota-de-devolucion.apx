page 807 (
    name: Carga de Nota de Devolucion
    alias: CARGA-DE-NOTA-DE-DEVOLUCION
    title: Carga de Nota de Devolucion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region carga-de-nota-de-devolucion (
        name: Carga de Nota de Devolucion
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       FEC_COMPROBANTE,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_CLIENTE,
                       ID_MOTIVO_DEV,
                       ID_FACTURA_REF,
                       ID_NCR_REF,
                       IND_AUTORIZA_LOG,
                       IND_AUTORIZA_COM,
                       IND_AUTORIZA_ADM,
                       ID_TIPO_COMP,
                       ID_SERIE_COMP,
                       FEC_AUTORIZA_LOG,
                       COD_USUARIO_AUTORIZA_LOG,
                       FEC_AUTORIZA_COM,
                       COD_USUARIO_AUTORIZA_COM,
                       FEC_AUTORIZA_ADM,
                       COD_USUARIO_AUTORIZA_ADM,
                       COD_USUARIO_AUD,
                       FEC_ALTA,
                       COMENTARIO,
                       (SELECT NRO_OCC
                         FROM VTW_COMPROBANTES_CABECERA VC
                        WHERE VC.ID = ID_FACTURA_REF) NRO_OCC,
                       (SELECT TO_CHAR(PC.NRO_COMPROBANTE)
                         FROM VTW_COMPROBANTES_CABECERA VC
                         JOIN VTW_PEDIDOS_CABECERA      PC ON PC.ID = VC.ID_PEDIDO_REF
                        WHERE VC.ID = ID_FACTURA_REF) NRO_PEDIDO
                  from VTW_COMPROBANTES_CABECERA_SOL
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DS.ID,
                       DS.ID_EMPRESA,
                       AR.COD_ARTICULO,
                       VD.DESC_ARTICULO,
                       LO.NRO_LOTE,
                       VD.CANTIDAD,
                       VD.PRECIO_UNITARIO_C_IVA,
                       VD.PORC_DESCUENTO,
                       VD.MONTO_TOTAL_C_IVA,
                       DS.CANT_DEVUELTA,
                       DS.ID_FACTURA_DET,
                       DS.ID_FACTURA_CAB,
                       DS.ID_COMPROBANTE_CAB
                  FROM VTW_COMPROBANTES_DETALLE_SOL DS
                  JOIN VTW_COMPROBANTES_DETALLE     VD ON VD.ID = DS.ID_FACTURA_DET
                  JOIN STW_ARTICULOS                AR ON AR.ID = VD.ID_ARTICULO
                  JOIN STW_LOTES                    LO ON LO.ID = VD.ID_LOTE
                 WHERE DS.ID_COMPROBANTE_CAB = :P807_ID
                ```
            pageItemsToSubmit: P807_ID
        }
        layout {
            sequence: 20
            parentRegion: @carga-de-nota-de-devolucion
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 62142610350119102
        }

