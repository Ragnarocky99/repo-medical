    dynamicAction inicializar (
        name: Inicializar
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    //grid.view$.grid("option", "editable", true);
                    //editable true
                        grid.model.setOption("editable", true);
                        //grid.setEditMode(true);
                    //editable false
                    //grid.model.setOption("editable", false);
                        grid.setEditMode(true);
                    
                    let actions = apex.region("Detalles").call("getActions");
                    //actions.hide("selection-duplicate");
                    //actions.hide("selection-delete");
                    actions.hide("selection-copy-down");
                    actions.hide("selection-copy");
                    actions.hide("selection-refresh"); 
                    actions.hide("selection-revert"); 
                    actions.hide("selection-add-row");
                    actions.hide("selection-fill"); 
                    actions.hide("selection-clear"); 
                    actions.hide("single-row-view");
                    actions.hide("row-add-row");
                    actions.hide("row-duplicate");
                    //actions.hide("row-delete"); 
                    actions.hide("row-refresh");  
                    actions.hide("row-revert");
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validar-cantidad-devuelta (
        name: Validar cantidad devuelta
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @detalles
            plsqlExpression: TO_NUMBER(:CANT_DEVUELTA) <= TO_NUMBER(:CANTIDAD)
        }
        error {
            errorMessage: Cantidad de vuelta no puede ser mayor a la cantidad facturada
            associatedColumn: CANT_DEVUELTA
        }
    )

    computation p807-id-serie-comp (
        itemName: P807_ID_SERIE_COMP
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                SELECT ID
                  FROM BSW_SERIES_COMPROB
                 WHERE TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT', 'TIP_COMPROBANTE_NOTA_DEVOLUCION')
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P807_ID_SERIE_COMP
        }
    )

    computation p807-id-tipo-comp (
        itemName: P807_ID_TIPO_COMP
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT ID
                  FROM BSW_TIPOS_COMPROBANTES
                 WHERE ID_MODULO = TRAE_ID_MODULO('VT')
                   AND TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT', 'TIP_COMPROBANTE_NOTA_DEVOLUCION')
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P807_ID_TIPO_COMP
        }
    )

    computation p807-nro-comprobante (
        itemName: P807_NRO_COMPROBANTE
        execution {
            sequence: 30
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(NRO_COMPROBANTE), 0) + 1
                  FROM VTW_COMPROBANTES_CABECERA_SOL
                 WHERE TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT', 'TIP_COMPROBANTE_NOTA_DEVOLUCION')
                   AND ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P807_ID
        }
    )

