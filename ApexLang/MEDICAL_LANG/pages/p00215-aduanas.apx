page 215 (
    name: Aduanas
    alias: ADUANAS
    title: Aduanas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region aduanas (
        name: Aduanas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ADU.ID,
                       ADU.COD_ADUANA,
                       ADU.DESCRIPCION DESC_ADUANA,
                       ADU.ID_PAIS,
                       ADU.ID_CIUDAD,
                       ADU.COD_USUARIO_AUD,
                       CIU.COD_CIUDAD,
                       CIU.DESCRIPCION DESC_CIUDAD,
                       PA.COD_PAIS,
                       PA.DESCRIPCION DESC_PAIS
                
                  FROM  CMW_ADUANAS ADU, BSW_CIUDADES CIU, BSW_PAISES PA
                  WHERE ADU.ID_CIUDAD = CIU.ID
                  AND   ADU.ID_PAIS = PA.ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 216
                items: {
                    P216_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 27551625137036954
        }

        column COD_ADUANA (
            type: plainText
            heading {
                heading: Cód. Aduana
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column COD_CIUDAD (
            type: plainText
            heading {
                heading: Cód. Ciudad
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COD_PAIS (
            type: plainText
            heading {
                heading: Cód. País
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESC_ADUANA (
            type: plainText
            heading {
                heading: Descripción Aduana
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column DESC_CIUDAD (
            type: plainText
            heading {
                heading: Descripción Ciudad
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESC_PAIS (
            type: plainText
            heading {
                heading: Descripción País
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_CIUDAD (
            type: hidden
            heading {
                heading: Id Ciudad
            }
            layout {
                sequence: 110
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_PAIS (
            type: hidden
            heading {
                heading: Id Pais
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Aduanas
        }

        savedReport 275897 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_ADUANA (
                sequence: 1
            )

            displayColumn COD_CIUDAD (
                sequence: 2
            )

            displayColumn COD_PAIS (
                sequence: 3
            )

            displayColumn DESC_ADUANA (
                sequence: 4
            )

            displayColumn DESC_CIUDAD (
                sequence: 5
            )

            displayColumn DESC_PAIS (
                sequence: 6
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @aduanas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 216
                clearCache: 216
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @aduanas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @aduanas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

