page 704 (
    name: Resumen Remision Licitaciones
    alias: RESUMEN-REMISION-LICITACIONES
    title: Resumen Remision Licitaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region resumen-remision-licitaciones (
        name: Resumen Remision Licitaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.num_ent_sal as nro_remision, a.cod_articulo, d.cantidad
                from stw_entsal_cab c
                join stw_entsal_det d on d.id_entsal_cab = c.id
                join stw_articulos  a on d.id_articulo   = a.id
                where d.id_oferta_lic = :P704_ID_OFERTA_LIC;
                ```
            pageItemsToSubmit: P704_ID_OFERTA_LIC
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 29828660728571310
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod Articulo
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NRO_REMISION (
            type: plainText
            heading {
                heading: Nro Remision
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 298422 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 3
            )

            displayColumn COD_ARTICULO (
                sequence: 2
            )

            displayColumn NRO_REMISION (
                sequence: 1
            )

        )

    )

    pageItem P704_ID_OFERTA_LIC (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

)

