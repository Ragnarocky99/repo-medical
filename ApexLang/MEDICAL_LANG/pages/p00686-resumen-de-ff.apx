    region resumen-de-ff (
        name: RESUMEN DE FF
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NUM_COMPROBANTE,
                       C.REFERENCIA,
                       C.ID_PROVEEDOR,
                       C.FEC_COMPROBANTE,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       D.TOT_PAGADO AS TOT_COMPROBANTE,
                       VAL.NRO_PLANILLA_FF,
                       C.ID_ORDEN_PAGO,
                       (SELECT LISTAGG(DISTINCT(CPD.COMENTARIO), CHR(13))
                           FROM CPW_COMPROBANTES_DETALLE  CPD
                          WHERE CPD.ID_COMPROBANTE = C.ID) COMENTARIO,
                       ROUND(D.TOT_PAGADO * NVL(D.TIP_CAMBIO, 1)) TOT_COMPROBANTE_GS
                  FROM CPW_COMPROBANTES_CABECERA C,
                       CPW_DETALLE_CAJAS         D,
                       CPW_CABECERA_CAJAS        CAJ,
                       CPW_VALORES_CAJAS         VAL
                 WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                   AND VAL.NRO_PLANILLA_FF IS NOT NULL
                   AND C.ID_EMPRESA = D.ID_EMPRESA
                   AND C.ID = D.ID_COMPROBANTE_CPW
                   AND D.ID_MOV_CAJ_CPW = CAJ.ID
                   AND NVL(CAJ.ANULADO,'N') <> 'A'
                   AND VAL.ID_CAB_CAJAS = CAJ.ID
                   ---AND C.NRO_PLANILLA_FF = VAL.NRO_PLANILLA_FF(+)
                   ---AND C.NUM_COMPROBANTE = '294'
                   AND (CAJ.FEC_MOV_CAJ BETWEEN :P686_FEC_DESDE AND :P686_FEC_HASTA)
                   AND (VAL.NRO_PLANILLA_FF = :P686_NRO_PLANILLA OR :P686_NRO_PLANILLA IS NULL)
                 
                 UNION ALL
                
                 SELECT C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.Nro_Comprobante,
                       C.REFERENCIA,
                       C.ID_PROVEEDOR,
                       C.FEC_COMPROBANTE,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       D.TOT_PAGADO AS TOT_COMPROBANTE,
                       VAL.NRO_PLANILLA_FF,
                       NULL as ID_ORDEN_PAGO,
                       'MERCADERIAS',
                       ROUND(D.TOT_PAGADO * NVL(D.TIP_CAMBIO, 1)) TOT_COMPROBANTE_GS
                  FROM CMW_COMPRAS_CABECERA C,
                       CPW_DETALLE_CAJAS    D,
                       CPW_CABECERA_CAJAS   CAJ,
                       CPW_VALORES_CAJAS    VAL
                 WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                   AND VAL.NRO_PLANILLA_FF IS NOT NULL
                   AND C.ID_EMPRESA = D.ID_EMPRESA
                   AND C.ID = D.ID_COMPROBANTE_CM
                   AND D.ID_MOV_CAJ_CPW = CAJ.ID
                   AND NVL(CAJ.ANULADO,'N') <> 'A'
                   AND VAL.ID_CAB_CAJAS = CAJ.ID
                   --AND C.NRO_PLANILLA_FF = VAL.NRO_PLANILLA_FF(+)
                   ---AND C.NRO_COMPROBANTE = '350'
                   AND (CAJ.FEC_MOV_CAJ  BETWEEN :P686_FEC_DESDE AND :P686_FEC_HASTA)
                   AND (VAL.NRO_PLANILLA_FF = :P686_NRO_PLANILLA OR :P686_NRO_PLANILLA IS NULL)
                ```
            pageItemsToSubmit: [
                P686_FEC_DESDE
                P686_FEC_HASTA
                P686_NRO_PLANILLA
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
