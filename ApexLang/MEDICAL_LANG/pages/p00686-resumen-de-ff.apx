                    TO_CHAR(TRAE_MONTO_FONDO(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                             P_NRO_CUENTA => '5',
                                             P_NRO_FONDO  => :P686_NRO_PLANILLA), '999G999G999G999G990D00')
                    ```
                itemsToSubmit: P686_NRO_PLANILLA
                escapeSpecialChars: false
            }
