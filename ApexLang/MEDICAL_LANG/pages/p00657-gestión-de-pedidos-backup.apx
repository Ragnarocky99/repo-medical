            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       C.ID,
                        CASE
                            WHEN ID IS NOT NULL THEN 'fa fa-search u-primary-text'
                       END Presu,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_CLIENTE,
                       C.ID_VENDEDOR,
                       C.ID_CONDICION_VENTA,
                       C.ID_LISTA_PRECIO,
                       C.DESCUENTO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.TOT_COMPROBANTE,
                       C.TOT_GRAVADAS,
                       C.TOT_EXENTAS,
                       C.TOT_IVA,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.ID_USUARIO,
                       C.FEC_ALTA,
                       C.NRO_AUTORIZACION,
                       C.CAMBIO_MONEDA_PRECIO,
                       C.TIP_CAMBIO_COMPRA,
                       C.FEC_VENCIMIENTO,
                       C.NOM_CLIENTE,
                       C.RUC_CLIENTE,
                       C.COMENTARIO,
                       C.COD_USUARIO_AUD,
                       C.ESTADO_FAC,
                       C.IND_CAMBIO_PRECIO,
                       C.IND_LIMITE_CREDITO,
                       C.ENTREGA_INICIAL,
                       C.ID_MEDIO_PAGO,
                       C.ESTADO_CREDITO,
                       C.ID_CANAL_VENTA,
                       C.ID_TIPO_ENTREGA,
                       C.ID_SUCURSAL_CENTRAL,
                       C.IND_ENTREGA_INICIAL,
                       C.ID_CONCEPTO_COMP,
                       C.ID_CORPORACION,
                       C.NRO_OC,
                       C.ESTADO_OC,
                       C.FEC_ESTADO_OC,
                       C.ID_LISTA_BODA_CAB,
                       C.ID_SOLICITUD_CREDITO,
                       C.ID_DEPOSITO_RESGUARDO,
                       C.CONTACTO_NOMBRE,
                       C.CONTACTO_TELEFONO,
                       C.DIRECCION,
                       C.TELEFONO,
                       C.DIREC_ENTREGA,
                       C.LATITUD,
                       C.LONGITUD,
                       C.ID_ZONA,
                       C.AUTORIZA_STOCK,
                       C.AUTORIZA_STOCK_USU,
                       C.AUTORIZA_STOCK_FEC,
                       C.AUTORIZA_CTACTE,
                       C.AUTORIZA_CTACTE_USU,
                       C.AUTORIZA_CTACTE_FEC,
                       C.ID_FACTURA,
                       C.ID_SECTOR_VEN,
                       C.COD_USUARIO_DESPACHANDO,
                       ''ID_PEDIDO_DET
                       /*,
                
                       CASE ESTADO 
                       WHEN
                        'EP' THEN 'EnProceso' 
                        WHEN
                        'CO' THEN 'cotizado' 
                        WHEN
                        'PR' THEN 'presupuestado' 
                        WHEN
                        'CF' THEN 'confirmado' 
                        WHEN
                        'OC' THEN 'OrdenCompra' 
                        WHEN
                        'DE' THEN 'EnDeposito' 
                        WHEN
                        'EN' THEN 'EntregadoCliente' 
                        WHEN
                        'AN' THEN 'anulado'
                        ELSE ''
                        END ESTADO_COLOR*/
                      
                  from VTW_PEDIDOS_CABECERA C
                  WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (C.NRO_COMPROBANTE = :P657_NRO_PEDIDO OR :P657_NRO_PEDIDO IS NULL)
                  AND (C.ID_CLIENTE = :P657_CLIENTE OR :P657_CLIENTE IS NULL)
                  AND (C.ID_SUCURSAL = :P657_SUCURSAL OR :P657_SUCURSAL IS NULL)
                  AND (C.ESTADO = :P657_ESTADO OR :P657_ESTADO IS NULL)
                  AND (C.FEC_COMPROBANTE BETWEEN :P657_FECHA_DESDE AND :P657_FECHA_HASTA)
                  AND EXISTS (
                        SELECT 1 FROM VTW_PEDIDOS_DETALLE D WHERE D.ID_PEDIDO_CABECERA = C.ID
                        and (SELECT SUM (CANT_DISPON) FROM STW_EXISTENCIA_ART E WHERE E.Id_Articulo = D.ID_ARTICULO) - D.CANTIDAD<0
                  )
                
                
                   
                ```
            pageItemsToSubmit: [
                P657_CLIENTE
                P657_ESTADO
                P657_TIPO
                P657_SUCURSAL
                P657_FECHA_DESDE
                P657_FECHA_HASTA
                P657_NRO_PEDIDO
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Pedidos
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 74385267316103449
        }

