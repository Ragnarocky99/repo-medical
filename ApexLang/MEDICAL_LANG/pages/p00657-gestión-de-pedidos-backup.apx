    dynamicAction cargar-despachados (
        name: Cargar despachados
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).ready(function() {
                        // Loop through each row in the Interactive Grid with ID 'Pedidos'
                        $('#Pedidos .a-GV-row').each(function() {
                            var $row = $(this);
                    
                            // Get the text content of the columns using their unique IDs
                            var idUsuario = $row.find('[headers="CARGADO_POR"]').text().trim();
                            var codUsuarioDespachando = $row.find('[headers="DESPACHADO_POR"]').text().trim();
                    
                            // Check if codUsuarioDespachando is not null
                            if (codUsuarioDespachando !== null && codUsuarioDespachando !== '') {
                                // Set the value of DESPACHADO_POR to CARGADO_POR
                                $row.find('[headers="DESPACHADO_POR"]').text(idUsuario);
                            }
                        });
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P657_FECHA_DESDE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P657_FECHA_DESDE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P657_FECHA_DESDE,'/','');
                            conv_fecha := substr(:P657_FECHA_DESDE,1,2)||'/'||
                                                      substr(:P657_FECHA_DESDE,3,2)||'/'||
                                                      lpad(substr(:P657_FECHA_DESDE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P657_FECHA_DESDE := conv_fecha;
                            ELSIF (length(:P657_FECHA_DESDE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P657_FECHA_DESDE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P657_FECHA_DESDE
                itemsToReturn: P657_FECHA_DESDE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P657_FECHA_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P657_FECHA_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P657_FECHA_HASTA,'/','');
                            conv_fecha := substr(:P657_FECHA_HASTA,1,2)||'/'||
                                                      substr(:P657_FECHA_HASTA,3,2)||'/'||
                                                      lpad(substr(:P657_FECHA_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P657_FECHA_HASTA := conv_fecha;
                            ELSIF (length(:P657_FECHA_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P657_FECHA_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P657_FECHA_HASTA
                itemsToReturn: P657_FECHA_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction estado (
        name: Estado
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('td[headers="OPERACION"]').each(function() {
                      var texto = $(this).text();
                      if (texto === 'Confirmado') {
                        $(this).css("color", "green");
                      } else if (texto === 'En Proceso') {
                        $(this).css("color", '#e1ad01');
                      } else if (texto === 'Anulado') {
                        $(this).css("color", "red"); 
                      }
                      else if (texto === 'Cotizado') {
                        $(this).css("color", "green"); 
                      } 
                      else if (texto === 'En Deposito') {
                        $(this).css("color", "blue"); 
                      } 
                      else if (texto === 'Presupuestado') {
                        $(this).css("color", "orange"); 
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P657_NRO_PEDIDO
                P657_ESTADO
