page 657 (
    name: Gestión de Pedidos Backup
    alias: GESTIÓN-DE-PEDIDOS-BACKUP
    title: Gestión de Pedidos Backup
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            .anulado {
                color: red;
            }
            .presupuestado {
                color: orangered;
            }
            .cotizado{
                color: green;
            }
            .confirmado {
                color: #3f46bb;
            }
            .EnDeposito{
                color: brown;
            }
            .EntregadoCliente{
                color: aqua;
            }
            .OrdenCompra{
                color: yellowgreen;
            }
            .EnProceso{
                color: yellow;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region detalles-de-pedido (
        name: Detalles de Pedido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    D.ID,
                    D.ID_EMPRESA,
                    D.ID_PEDIDO_CABECERA,
                    D.ID_ARTICULO,
                    D.CANTIDAD,
                    D.CANTIDAD_FACTURADA,
                    D.PRECIO_UNITARIO,
                    D.MONTO_TOTAL,
                    D.TOTAL_IVA,
                    D.PRECIO_LISTA,
                    D.DESCUENTO,
                    D.IND_FACTURA,
                    D.COD_USUARIO_AUD,
                    D.CANTIDAD_UB,
                    D.ID_UNIDAD_MEDIDA,
                    D.PORC_DESCUENTO,
                    D.IVA,
                    D.PORC_DESC_ESP,
                    D.MONTO_DESC_ESPECIAL,
                    D.ID_LOTE,
                    D.PRECIO_UNITARIO_C_IVA,
                    D.PRECIO_LISTA_C_IVA,
                    D.MONTO_TOTAL_C_IVA,
                    D.DESCUENTO_C_IVA,
                    D.CANT_CUOTA,
                    D.ENTREGA_INICIAL,
                    D.MON_CUOTA,
                    D.PLAZOCUOTA,
                    D.ID_IVA,
                    D.PORC_GRAVADA,
                    D.IND_PROMO,
                    D.DESC_ARTICULO,
                    D.NUM_ORDEN,
                    D.NRO_LOTE,
                    D.IND_ANULADO,
                    D.STOCK,
                    D.OBSERVACION,
                    D.ESTADO,
                    CASE
                        WHEN D.CANTIDAD <= D.STOCK THEN D.CANTIDAD
                        ELSE D.STOCK
                    END AS cantidad_solicitada,
                   (SELECT SUM(CANTIDAD) FROM CMW_COTIZA_ARTICULOS WHERE ID_PEDIDO = D.ID_PEDIDO_CABECERA AND ID_ARTICULO = D.ID_ARTICULO) AS Presupuestado,
                
                   ---(SELECT NVL(SUM(CANTIDAD), 0) FROM CMW_COTIZA_ARTICULOS WHERE ID_PEDIDO = D.ID_PEDIDO_CABECERA AND ID_ARTICULO = D.ID_ARTICULO) AS Presupuestado,
                    ''vacio
                
                FROM
                    VTW_PEDIDOS_DETALLE D
                
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @lista-de-pedidos
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 74452295691103709
        }

