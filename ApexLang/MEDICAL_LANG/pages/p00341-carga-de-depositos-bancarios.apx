    computation p341-asientos-id (
        itemName: P341_ASIENTOS_ID
        execution {
            sequence: 70
        }
        computation {
            sqlQuery:
                ```sql
                select id 
                from cow_diario_cabeceras_prov
                where num_asiento  = to_number(replace(replace(:P341_ASIENTOS,'dep',''),'*',''))
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P341_FEC_COMPROBANTE);
                ```
        }
    )

    computation p341-desc-banc-inc (
        itemName: P341_DESC_BANC_INC
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                select P.NOMBRE
                       
                  from BSW_PERSONAS P, 
                       BSW_SECTORES_ECON SE
                
                 where P.ID_SECTOR = SE.ID
                   and P.ID = :P341_ID_BANCO
                   and P.ID_SECTOR = W_BUSCA_PARAMETRO('BS','COD_SECTOR_BANCARIO')
                   and nvl(P.ES_FISICA,'N')='N'
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    computation p341-desc-cuenta (
        itemName: P341_DESC_CUENTA
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                select cb.referencia
                
                from ccw_cuentas_bancarias cb, 
                     bsw_personas pj, 
                     bsw_monedas mo 
                     
                where cb.id_empresa = :P0_ID_EMPRESA
                  and cb.nro_cuenta = :P341_NRO_CUENTA
                  and cb.id_per_juridica = pj.id
                  and nvl(cb.activo, 'N') <> 'N' 
                  and cb.id_moneda = mo.id
                  and pj.es_fisica = 'N'
                  
                order by cb.id_moneda, ltrim(pj.nombre), cb.nro_cuenta
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    computation p341-desc-cuenta-caja (
        itemName: P341_DESC_CUENTA_CAJA
        execution {
            sequence: 40
        }
        computation {
            sqlQuery:
                ```sql
                select cb.referencia
                
                from ccw_cuentas_bancarias cb, 
                     bsw_personas pj, 
                     bsw_monedas mo 
                     
                where cb.id_empresa = :P0_ID_EMPRESA
                  and cb.nro_cuenta = :P341_NRO_CUENTA
                  and cb.id_per_juridica = pj.id
                  and nvl(cb.activo, 'N') <> 'N' 
                  and cb.id_moneda = mo.id
                  and pj.es_fisica = 'N'
                  
                order by cb.id_moneda, ltrim(pj.nombre), cb.nro_cuenta
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    computation p341-desc-cuenta-cont (
        itemName: P341_DESC_CUENTA_CONT
        execution {
            sequence: 50
        }
        computation {
            sqlQuery:
                ```sql
                select p.nombre_cuenta
                from cow_plan_cuentas p
                where p.id = :P341_ID_CUENTA
                  and p.id_empresa = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    computation p341-desc-moneda (
        itemName: P341_DESC_MONEDA
        execution {
            sequence: 60
        }
        computation {
            sqlQuery:
                ```sql
                select descripcion
                from bsw_monedas
                where id = :P341_ID_MONEDA
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    computation p341-desc-per-juridica (
        itemName: P341_DESC_PER_JURIDICA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                select ltrim(pj.nombre) nom_per_juridica
                       
                from ccw_cuentas_bancarias cb, 
                     bsw_personas pj, 
                     bsw_monedas mo 
                     
                where cb.id_empresa = :P0_ID_EMPRESA
                  and cb.id_per_juridica = :P341_ID_PER_JURIDICA
                  and cb.id_per_juridica = pj.id
                  and nvl(cb.activo, 'N') <> 'N' 
                  and cb.id_moneda = mo.id
                  and pj.es_fisica = 'N'
                  
                order by cb.id_moneda, ltrim(pj.nombre), cb.nro_cuenta
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    computation p341-nro-comprobante (
        itemName: P341_NRO_COMPROBANTE
        execution {
            sequence: 80
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression:
                ```plsql
                trae_ultimo_numero_registro(p_id_empresa => :P0_ID_EMPRESA,
                                            p_nomb_tabla => 'CCW_MOV_VALORES_CAB',
                                            p_columna    => 'NRO_COMPROBANTE',
                                            p_tipo       => 'TIP_COMPROBANTE|'||:P341_TIP_COMPROBANTE,
                                            p_serie      => 'SER_COMPROBANTE|'||:P341_SER_COMPROBANTE)
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P341_ID
        }
    )

