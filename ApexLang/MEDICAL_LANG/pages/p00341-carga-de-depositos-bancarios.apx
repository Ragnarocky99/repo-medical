    dynamicAction set-grid-json (
        name: SET_GRID_JSON
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @b341-buscar-inc-banco
        }

        action calc-total (
            name: CALC_TOTAL
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    calculaTotales();
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P341_TOT_CREDITO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action convert-json (
            name: CONVERT_JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    
                      v_tipo_trans     number;
                      v_subtipo_trans  number;
                      v_modulo         number;
                      v_tip_cambio_cab decimal;
                    
                    BEGIN
                        v_tip_cambio_cab := :P341_TIP_CAMBIO;
                        v_modulo     := trae_modulo_id('CC');
                        v_tipo_trans := trae_id_tipos_trans(:P0_ID_EMPRESA,v_modulo,w_busca_parametro('CC','TIPO_TRANS_CC'));
                        v_subtipo_trans := TRAE_SUBTIPOS_TRANS_ID(:P0_ID_EMPRESA,v_modulo,v_tipo_trans,w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS'));
                    
                    
                        OPEN l_cursor FOR
                            select v_tipo_trans as id_tipo_tras,
                                   v_subtipo_trans as id_sub_tipo_trans, --c.id_subtipo_trans,
                                   c.tip_documento, 
                                   c.ser_documento, 
                                   c.nro_valor, 
                                   replace(to_char(c.FEC_VENCIMIENTO, 'DD/MM/YYYY'), '\','') FEC_VENCIMIENTO,
                                   c.id_per_juridica, 
                                   c.id_moneda,
                                   m.tipo_cambio_dia,
                                   c.id_cuenta_bancaria,
                                   SUM(c.monto_valor) monto_valor,
                                   SUM((c.monto_valor * FTIPOS_CAMBIO(m.id,SYSDATE,'C','F')) / v_tip_cambio_cab) MONTO_NETO, --cálculo astral - no tocar
                                   decode( :P341_INCLUYE, '1', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS	'),
                                                          '2', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS	'),
                                                          w_busca_parametro('CC','CHEQUE_DCHEQ_SUBTIPO_TRANS')) sub_tipo
                                       
                                   from ccw_valores c, bsw_personas j, bsw_monedas m
                    
                                   where 
                                     instr( 'PR',  c.estado_valor, 1, 1 ) > 0
                                     and nvl( c.fec_acobrar, c.fec_vencimiento ) <= :P341_FEC_COMPROBANTE
                                     and c.estado_valor='P'
                                     and ( :P341_INCLUYE is null
                                           or ( :P341_INCLUYE = '1' and c.tip_documento = w_busca_parametro('CC','TIP_DOCUMENTO_CHE')  and c.id_per_juridica =  :P341_ID_PER_JURIDICA )
                                           or ( :P341_INCLUYE = '2' and c.tip_documento = w_busca_parametro('CC','TIP_DOCUMENTO_CHE')  and c.id_per_juridica <> :P341_ID_PER_JURIDICA ) )
                                           
                                     and c.id_moneda       = :P341_ID_MONEDA
                                     and m.id = c.id_moneda
                                     and c.id_per_juridica = j.id
                                     and j.id_sector       = :P341_ID_SECTOR
                                     and ( c.saldo_valor is null or c.monto_valor = c.saldo_valor )
                    
                                     group by v_tipo_trans,
                                              v_subtipo_trans,--c.id_subtipo_trans, 
                                              c.tip_documento, 
                                              c.ser_documento, 
                                              c.nro_valor, 
                                              c.fec_vencimiento, 
                                              c.id_per_juridica, 
                                              c.id_moneda, 
                                              m.tipo_cambio_dia, 
                                              c.id_cuenta_bancaria,
                                              decode( :P341_INCLUYE,'1', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS'),
                                                                    '2', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS'))
                    
                                   order by c.id_per_juridica, c.nro_valor desc;
                                   
                            APEX_JSON.initialize_clob_output;
                    
                            APEX_JSON.open_object;
                            APEX_JSON.write('DETALLE', l_cursor);
                            APEX_JSON.close_object;
                    
                            JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                            :P341_JSON_DETALLES:=JSON_DETALLE;
                    END;
                    ```
                itemsToSubmit: [
                    P341_ID_SECTOR
                    P341_FEC_COMPROBANTE
                    P341_ID_MONEDA
                    P341_INCLUYE
                    P341_ID_PER_JURIDICA
                    P341_TIP_CAMBIO
                ]
                itemsToReturn: P341_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action insert-json-det (
            name: INSERT_JSON_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                      var T = $v("P341_JSON_DETALLES"), J, intento = 0, maxIntentos = 20;
                      var orden = 0;
                    
                      if(!T){ console.warn("P341_JSON_DETALLES vacío. No se carga nada."); return; }
                      try{ J = JSON.parse(T); }
                      catch(e){ console.error("JSON inválido:",e); apex.message.alert("El JSON de detalles no es válido."); return; }
                    
                      function txt(v){ return v===null||v===undefined?"":v.toString(); }
                      function dec(v){ return v===null||v===undefined?"":v.toString().replace(/\./g,","); }
                      function tieneDatos(o){ return o && Object.keys(o).some(k => o[k]!==null && o[k]!==undefined && o[k]!=="" ); }
                      function setCol(model,rec,col,val){
                        if(val===null||val===undefined||val===""){ return; }
                        try{ model.setValue(rec,col,val.toString()); }
                        catch(e){ console.error("Error en columna:",col,"Valor:",val,e);
                          apex.message.alert("Error al cargar la columna "+col+". Verificá si está Read Only, Display Only o Query Only en el IG Detalles.");
                          throw e;
                        }
                      }
                    
                      // Normaliza fecha al formato dd/mm/yyyy
                      function toDDMMYYYY(v){
                        if(!v) return "";
                        if(v.indexOf("T")>0){ // timestamp
                          var d = new Date(v);
                          return d.getDate().toString().padStart(2,"0")+"/"+(d.getMonth()+1).toString().padStart(2,"0")+"/"+d.getFullYear();
                        }
                        if(v.indexOf("-")>0){ // yyyy-mm-dd
                          var parts = v.split("-");
                          return parts[2].padStart(2,"0")+"/"+parts[1].padStart(2,"0")+"/"+parts[0];
                        }
                        return v; // ya viene dd/mm/yyyy
                      }
                    
                      function esperarIG(){
                        var ig$ = apex.region("Detalles").widget();
                        var grid = ig$.interactiveGrid("getCurrentView");
                        grid.setEditMode(true);
                        var model = grid.model;
                        console.log("Intento:",intento,"allowAdd:",model.allowAdd(),"canAdd:",model.check("canAdd"));
                        if(model.allowAdd() && model.check("canAdd")){ cargarDetalles(model,grid); return; }
                        intento++;
                        if(intento<maxIntentos){ setTimeout(esperarIG,300); return; }
                        apex.message.alert("El grid Detalles no permite agregar filas todavía. Revisá si el código se ejecuta antes del refresh del IG o si alguna configuración bloquea Add Row.");
                      }
                    
                      function cargarDetalles(model,grid){
                        try{
                          if(!J || !Array.isArray(J.DETALLE) || J.DETALLE.length===0){ console.log("No hay detalles para cargar."); return; }
                          var filas = J.DETALLE.filter(tieneDatos);
                          if(filas.length===0){ console.log("El JSON no tiene filas con datos."); return; }
                    
                          for(let i=0;i<filas.length;i++){
                            var d = filas[i];
                            if(!model.allowAdd() || !model.check("canAdd")){ throw new Error("El modelo dejó de permitir insertar en la línea "+(i+1)); }
                            var rec = model.getRecord(model.insertNewRecord());
                            orden++;
                    
                            setCol(model,rec,"ID_TIPO_TRANS",txt(d.ID_TIPO_TRANS));
                            setCol(model,rec,"ID_SUB_TIPO_TRANS",txt(d.ID_SUB_TIPO_TRANS));
                            setCol(model,rec,"TIP_DOCUMENTO",txt(d.TIP_DOCUMENTO));
                            setCol(model,rec,"SER_DOCUMENTO",txt(d.SER_DOCUMENTO));
                            setCol(model,rec,"ID_PER_JURIDICA",txt(d.ID_PER_JURIDICA));
                            setCol(model,rec,"NRO_VALOR",txt(d.NRO_VALOR));
                            if(d.FEC_VENCIMIENTO!=null){
                              setCol(model,rec,"FEC_VENCIMIENTO",toDDMMYYYY(d.FEC_VENCIMIENTO));
                            }
                            setCol(model,rec,"ID_CUENTA_BANCARIA",txt(d.ID_CUENTA_BANCARIA));
                            setCol(model,rec,"ID_MONEDA",txt(d.ID_MONEDA));
                            setCol(model,rec,"TIP_CAMBIO",txt(d.TIPO_CAMBIO_DIA));
                            setCol(model,rec,"MONTO_VALOR",txt(d.MONTO_VALOR));
                            setCol(model,rec,"MONTO_NETO",txt(d.MONTO_NETO));
                          }
                    
                          console.log("Carga de detalles finalizada. Filas cargadas:",filas.length);
                    
                          // 🔹 refrescar la vista para que los Select List / Popup LOV muestren el display
                          setTimeout(function(){ grid.view$.grid("refresh"); },300);
                    
                        }catch(e){ console.error("Error cargando detalles:",e); }
                      }
                    
                      setTimeout(esperarIG,300);
                      setTimeout(calculaTotales,300);
                    })();
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action limpiar-detalle (
            name: LIMPIAR_DETALLE
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalles
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction set-sector-onchange (
        name: SET_SECTOR_ONCHANGE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P341_ID_PER_JURIDICA
        }

        action id-sector (
            name: ID_SECTOR
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select SE.ID AS ID_SECTOR
                           
                      from BSW_PERSONAS P, 
                           BSW_SECTORES_ECON SE
                    
                     where P.ID = :P341_ID_PER_JURIDICA
                       and P.ID_SECTOR = SE.ID
                       --and nvl(P.ES_FISICA,'N')='N'
                    ```
                itemsToSubmit: P341_ID_PER_JURIDICA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P341_ID_SECTOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-tip-cambio (
        name: SET_TIP_CAMBIO
        execution {
            sequence: 110
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_MONEDA
        }

        action set-value-cambio (
            name: SET_VALUE_CAMBIO
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                        RETURN FTIPOS_CAMBIO(:ID_MONEDA,SYSDATE,'C','F');
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                RAISE_APPLICATION_ERROR(-20000,'Error al encontrar el cambio de la moneda');
                    END;
                    ```
                itemsToSubmit: ID_MONEDA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: TIP_CAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

