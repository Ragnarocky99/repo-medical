            //document.getElementById("P341_DESC_BANC_INC").readOnly = true;
            document.getElementById("P341_DESC_CUENTA_CAJA").readOnly = true;
            document.getElementById("P341_TOT_CREDITO").readOnly = true;
            document.getElementById("P341_ASIENTOS").readOnly = true;
            
            //DETALLE
            //document.getElementById("#fila-grilla").readOnly = true;
            
            ```
