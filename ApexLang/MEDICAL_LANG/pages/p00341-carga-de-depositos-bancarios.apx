    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: items
            items: P341_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P341_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P341_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P341_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P341_ASIENTOS_ID
                    P341_URL
                ]
                itemsToReturn: P341_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P341_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction calc-monto (
        name: CALC_MONTO
        execution {
            sequence: 130
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: MONTO_VALOR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :MONTO_VALOR is null then
                         :MONTO_NETO := 0;
                    end if;
                    -- Calcula total valorizado por tipo cambio del detalle dividido por tipo cambio de la cabecera.
                    :MONTO_NETO := ( to_number(replace(:MONTO_VALOR, '.', '')) * to_number(replace(:TIP_CAMBIO, '.', ''))) / to_number(replace(:P341_TIP_CAMBIO, '.', ''));
                    
                    ```
                itemsToSubmit: [
                    MONTO_VALOR
                    TIP_CAMBIO
                    P341_TIP_CAMBIO
                ]
                itemsToReturn: MONTO_NETO
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: P341_TOT_CREDITO
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: columns
                columns: MONTO_VALOR
            }
            execution {
                sequence: 40
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 200
        }
        when {
            selectionType: items
            items: P341_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P341_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P341_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P341_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P341_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P341_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P341_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P341_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P341_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P341_FEC_COMPROBANTE
                itemsToReturn: P341_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

