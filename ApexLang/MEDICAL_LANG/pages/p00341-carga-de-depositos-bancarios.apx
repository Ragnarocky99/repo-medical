page 341 (
    name: Carga de Depositos Bancarios
    alias: CARGA-DE-DEPOSITOS-BANCARIOS
    title: Carga de Depositos Bancarios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            
            function calculaTotales(){
                var model = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
            
                // Función auxiliar para convertir valores a número seguro
                function toNumber(val) {
                    if (val === null || val === undefined || val === "") return 0;
                    return Number(val.toString().replace(/\./g,'').replace(',', '.')) || 0;
                }
            
                var v_neto = model.getFieldKey("MONTO_NETO");
                var v_total = 0;
            
                model.forEach(function(r, index, id) {
                    var meta = model.getRecordMetadata(id);
                    if (meta.fields !== undefined && !meta.deleted) {
                        v_total += toNumber(r[v_neto]);
                    }
                });
            
                // Actualizar item en la página
                $s('P341_TOT_CREDITO', v_total.toString().replace('.', ','));
            
                console.log("Total crédito calculado:", v_total);
            }
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
