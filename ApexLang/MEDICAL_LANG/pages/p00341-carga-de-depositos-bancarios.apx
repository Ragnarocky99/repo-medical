    region depositos-bancarios (
        name: Depositos Bancarios
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT VC.ID,
                       VC.ID_EMPRESA,
                       VC.ID_SUCURSAL,
                       VC.TIP_COMPROBANTE,
                       VC.SER_COMPROBANTE,
                       VC.NRO_COMPROBANTE,
                       VC.FEC_COMPROBANTE,
                       VC.REFERENCIA,
                       VC.ID_BANCO, --Cuenta del banco 
                       VC.NRO_CUENTA,
                       VC.NRO_CUENTA_CAJA,
                       VC.ID_PER_JURIDICA,
                       VC.ID_CUENTA, -- Cuenta contable
                       --VC.ENTIDAD
                       VC.ID_MONEDA,
                       VC.TIP_CAMBIO,
                       VC.DESCRIPCION,
                       VC.TOT_CREDITO,
                       REPLACE(REPLACE(VC.ASIENTOS,'dep'),'*') ASIENTOS,
                       VC.COD_USUARIO_AUD,
                       VC.FEC_ALTA,
                       VC.COD_USUARIO_MOD,
                       VC.FEC_MODIFICACION
                       
                FROM CCW_MOV_VALORES_CAB VC
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT VD.ID,
                       VD.ID_EMPRESA,
                       VD.ID_MOV_VALORES_CAB,
                       VD.TIP_COMPROBANTE,
                       VD.SER_COMPROBANTE,
                       VD.NRO_COMPROBANTE,
                       VD.SER_DOCUMENTO,
                       VD.NRO_VALOR,
                       VD.TIP_DOCUMENTO,
                       VD.ID_TIPO_TRANS,
                       VD.ID_SUB_TIPO_TRANS,
                       VD.ID_PER_JURIDICA,
                       VD.NRO_CUENTA,
                       VD.FEC_VENCIMIENTO,
                       VD.ID_MONEDA,
                       VD.TIP_CAMBIO,
                       VD.MONTO_VALOR,
                       --VD.MONTO_VALOR AS CREDITO,
                       VD.MONTO_NETO,
                       VD.COD_USUARIO_AUD,
                       VD.ID_CUENTA_BANCARIA,
                       VD.CONFIRMADO
                       
                FROM CCW_MOV_VALORES_DET VD
                WHERE VD.ID_MOV_VALORES_CAB = :P341_ID
                ```
            pageItemsToSubmit: P341_ID
        }
        layout {
            sequence: 270
            parentRegion: @depositos-bancarios
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-bottom-md
            ]
        }
        advanced {
