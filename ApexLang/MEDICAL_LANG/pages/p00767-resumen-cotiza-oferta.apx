    pageItem P767_ESTADO (
        type: popupLov
        label {
            label: <p>Estado:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT T.ESTADO D, T.ESTADO R
                  FROM (
                      SELECT DISTINCT(LCWF_TRAE_ESTADO_CONVOCATORIA_DET(ID)) ESTADO
                        FROM LCW_LICITACIONES_DET
                       WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  ) T
                ```
            nullDisplayValue: TODOS
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

