    region resumen-cotiza-oferta (
        name: Resumen Cotiza Oferta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       FEC_LICITACION,
                       NRO_LICITACION,
                       NRO_ID_LICITACION,
                       CLIENTE,
                       NRO_ITEM,
                       COD_ARTICULO_CATALOGO,
                       DESC_ARTICULO_CATALOGO,
                       COD_ARTICULO,
                       COD_FABRICANTE,
                       DESC_ARTICULO,
                       MARCA,
                       PRESENTACION,
                       UNIDAD_MEDIDA,
                       PROVEEDOR,
                       PLAZO_ENTREGA,
                       CONDICION_COMPRA,
                       ID_MONEDA_COSTO,
                       TIP_CAMBIO_COSTO,
                       COSTO_UNITARIO,
                       ID_MONEDA_PRESUPUESTO,
                       TIP_CAMBIO_PRESUPUESTO,
                       CANTIDAD,
                       PRECIO_UNITARIO,
                       COSTO_TOTAL,
                       COSTO_UNITARIO_RECARGO,
                       COSTO_TOTAL_RECARGO,
                       PORC_MARGEN,
                       MARGEN_TOTAL,
                       PRECIO_TOTAL,
                       IND_ENVIO,
                       IND_ENVIO_ICON,
                       IND_NO_ENVIO,
                       IND_NO_ENVIO_ICON,
                       IND_GESTION,
                       IND_GESTION_ICON,
                       ESTADO,
                       OBS_COMPRA,
                       COMENTARIO_COMPRAS,
                       ID_LICITACION_DET
                  FROM LCWV_RESUMEN_COTIZA_OFERTA
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                   AND (ID_ARTICULO = :P767_ID_ARTICULO OR :P767_ID_ARTICULO IS NULL)
                   AND (ID_PROVEEDOR = :P767_ID_PROVEEDOR OR :P767_ID_PROVEEDOR IS NULL)
                   AND (ID_CLIENTE = :P767_ID_CLIENTE OR :P767_ID_CLIENTE IS NULL)
                   AND (COD_ARTICULO = :P767_COD_ARTICULO OR :P767_COD_ARTICULO IS NULL)
                   AND (NRO_LICITACION = :P767_NRO_LICITACION OR :P767_NRO_LICITACION IS NULL)
                   AND (NRO_ID_LICITACION = :P767_NRO_ID_LICITACION OR :P767_NRO_ID_LICITACION IS NULL)
                   AND (ESTADO = :P767_ESTADO OR :P767_ESTADO IS NULL)
                   AND FEC_LICITACION BETWEEN :P767_FEC_INI AND :P767_FEC_FIN
                   AND (NRO_ITEM = :P767_NRO_ITEM OR :P767_NRO_ITEM IS NULL)
                ```
            pageItemsToSubmit: [
                P767_ID_ARTICULO
                P767_COD_ARTICULO
                P767_ID_PROVEEDOR
                P767_NRO_LICITACION
                P767_NRO_ID_LICITACION
                P767_ID_CLIENTE
                P767_FEC_INI
                P767_FEC_FIN
                P767_ESTADO
                P767_NRO_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 35080937742181292
        }

