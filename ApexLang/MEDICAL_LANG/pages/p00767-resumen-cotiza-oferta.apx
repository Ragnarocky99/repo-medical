        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P767_ID_PROVEEDOR (
        type: popupLov
        label {
            label: <p>Proveedor:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-proveedores
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P767_NRO_ID_LICITACION (
        type: textField
        label {
            label: <p>Nro. ID:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P767_NRO_ITEM (
        type: numberField
        label {
            label: <p>Nro Item:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P767_NRO_LICITACION (
        type: textField
        label {
            label: <p>Nro. Licitacion:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction agregar-paginacion (
        name: Agregar Paginacion
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @resumen-cotiza-oferta
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P767_ID_ARTICULO
                P767_ID_PROVEEDOR
                P767_COD_ARTICULO
                P767_NRO_LICITACION
                P767_NRO_ID_LICITACION
                P767_ID_CLIENTE
                P767_ESTADO
                P767_NRO_ITEM
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-cotiza-oferta
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-resumen-cotiza-oferta (
        name: Refrescar Resumen Cotiza Oferta
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-cotiza-oferta
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

