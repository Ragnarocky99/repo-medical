page 610 (
    name: Tecnologia
    alias: TECNOLOGIA
    title: Tecnologia
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tecnologia (
        name: Tecnologia
        type: interactiveReport
        source {
            location: localDatabase
            tableName: STW_TECNOLOGIA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 611
                items: {
                    P611_ID: \#ID#\
                    P611_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 10978754813533140
        }

        column ABREVIATURA (
            type: plainText
            heading {
                heading: Abreviatura
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_TECNOLOGIA (
            type: plainText
            heading {
                heading: Código Tecnología
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column IND_REPLICA (
            type: plainText
            heading {
                heading: Replica
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Tecnologia
        }

        savedReport 109847 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ABREVIATURA (
                sequence: 5
            )

            displayColumn COD_TECNOLOGIA (
                sequence: 3
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 7
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ESTADO (
                sequence: 6
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

            displayColumn IND_REPLICA (
                sequence: 8
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @tecnologia
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 611
                clearCache: 611
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tecnologia
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tecnologia
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

