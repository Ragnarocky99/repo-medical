    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P83_COMPROBANTE_REF
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @entrada-salida-de-artículos
