page 83 (
    name: Entrada/Salida de Articulos
    alias: ENTRADA-SALIDA-DE-ARTICULOS
    title: Entrada/Salida de Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Roboto","Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region entrada-salida-de-artículos (
        name: Entrada/Salida de Artículos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.TIP_ENT_SAL,
                       C.SER_ENT_SAL,
                       C.NUM_ENT_SAL,
                       C.FEC_ENT_SAL,
                       C.ID_MOTIVO_ENT_SAL,
                       C.COMENTARIO,
                       C.COD_USUARIO_AUD,
                       C.ID_REFERENCIA,
                       C.ID_PROVEEDOR,
                       C.FAC_REFERENCIA,
                    (SELECT SUM(COSTO_C_IVA) FROM STW_ENTSAL_DET D WHERE D.ID_ENTSAL_CAB=C.ID) AS TOT_COSTO,  -- C.TOT_COSTO,
                    (SELECT SUM(CANTIDAD)    FROM STW_ENTSAL_DET D WHERE D.ID_ENTSAL_CAB=C.ID) AS TOT_CANTIDAD,
                      -- C.TOT_CANTIDAD,
                       REPLACE(REPLACE(C.ASIENTOS,'*'),'stock') ASIENTOS,
                       (SELECT D.ID
                       FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'stock'))
                        AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_ENT_SAL)
                        AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTOS_ID
                  from STW_ENTSAL_CAB C
                  WHERE C.ID_EMPRESA=:P0_COD_EMPRESA
                    AND (C.TIP_ENT_SAL = 'AJS' OR C.TIP_ENT_SAL IS NULL)
                  --  AND (C.ID_COMPROBANTE_REF = :P83_COMPROBANTE_REF OR :P83_COMPROBANTE_REF IS NULL)
                    
                    
                    --AND TIP_ENT_SAL = 'AJS'
                    --AND SER_ENT_SAL = 'A'
                ```
            pageItemsToSubmit: P83_COMPROBANTE_REF
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 171
                items: {
                    P171_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 40050167717233117
        }

        column ASIENTOS (
            type: link
            heading {
                heading: Asientos
                alignment: center
            }
            layout {
                sequence: 210
            }
            link {
                target: {
                    page: 235
                    items: {
                        P235_ID: #ASIENTOS_ID#
                    }
                }
                linkText: #ASIENTOS#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
        )

        column ASIENTOS_ID (
            type: plainText
