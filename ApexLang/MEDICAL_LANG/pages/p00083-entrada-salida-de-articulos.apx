        settings {
            displayAs: modalDialog
            popupWidth: 650
            popupHeight: 650
        }
        lov {
            type: sharedComponent
            lov: @lv-remisiones
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 10
            region: @entrada-salida-de-artículos
