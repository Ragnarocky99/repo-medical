page 217 (
    name: Puertos
    alias: PUERTOS
    title: Puertos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region puertos (
        name: Puertos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PUE.ID,
                       PUE.COD_PUERTO,
                       PUE.DESCRIPCION DESC_PUERTO,
                       PUE.ID_PAIS,
                       PUE.ID_CIUDAD,
                       PUE.COD_USUARIO_AUD,
                       PUE.ID_VIA,
                       CIU.COD_CIUDAD,
                       CIU.DESCRIPCION DESC_CIUDAD,
                       PA.COD_PAIS,
                       PA.DESCRIPCION DESC_PAIS
                
                  FROM  CMW_PUERTOS PUE, BSW_CIUDADES CIU, BSW_PAISES PA 
                  WHERE PUE.ID_CIUDAD = CIU.ID
                  AND   PUE.ID_PAIS = PA.ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 218
                items: {
                    P218_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 27567209069040339
        }

        column COD_CIUDAD (
            type: plainText
            heading {
                heading: Cód. Ciudad
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column COD_PAIS (
            type: plainText
            heading {
                heading: Cód. País
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column COD_PUERTO (
            type: plainText
            heading {
                heading: Cód. Puerto
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESC_CIUDAD (
            type: plainText
            heading {
                heading: Descripción Ciudad
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESC_PAIS (
            type: plainText
            heading {
                heading: Descripción País
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column DESC_PUERTO (
            type: plainText
            heading {
                heading: Descripción Puerto
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 130
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_CIUDAD (
            type: hidden
            heading {
                heading: Id Ciudad
            }
            layout {
                sequence: 170
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID_PAIS (
            type: hidden
            heading {
                heading: Id Pais
            }
            layout {
                sequence: 160
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_VIA (
            type: hidden
            heading {
                heading: Id Via
            }
            layout {
                sequence: 150
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Puertos
        }

        savedReport 275903 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CIUDAD (
                sequence: 3
            )

            displayColumn COD_PAIS (
                sequence: 5
            )

            displayColumn COD_PUERTO (
                sequence: 1
            )

            displayColumn DESC_CIUDAD (
                sequence: 4
            )

            displayColumn DESC_PAIS (
                sequence: 6
            )

            displayColumn DESC_PUERTO (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @puertos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 218
                clearCache: 218
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @puertos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @puertos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

