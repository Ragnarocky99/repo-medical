            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        advanced {
            cssClasses: cambio
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT P.NOMBRE     
                FROM BSW_PERSONAS P    
                WHERE :P94_ID_PERSONA = P.ID
                ```
