    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @persona
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P94_ID_PERSONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @zona
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P94_ID_ZONA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p94-cod-cobrador (
        itemName: P94_COD_COBRADOR
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P94_COD_COBRADOR is null then
                      select nvl(max(to_number(COD_COBRADOR)), 0) + 1
                         into v_numero
                         from CCW_COBRADORES;
                       RETURN v_numero;
                      end if; 
                      RETURN :P94_COD_COBRADOR;
                   exception
                      when no_data_found then
                        :P94_COD_COBRADOR := 1 ;
                        RETURN :P94_COD_COBRADOR;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Cobradores' || sqlerrm ) ;
                   end ;
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
