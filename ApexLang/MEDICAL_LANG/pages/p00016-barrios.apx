page 16 (
    name: Barrios
    alias: BARRIOS
    title: Barrios - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region barrios (
        name: Barrios
        type: interactiveReport
        source {
            location: localDatabase
            tableName: BSW_BARRIOS
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 19
                items: {
                    P19_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 9397978396875203
        }

        column ABREVIATURA (
            type: plainText
            heading {
                heading: Abreviatura
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COD_BARRIO (
            type: plainText
            heading {
                heading: Cód. Barrio
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_CIUDAD (
            type: plainTextBasedOnLov
            heading {
                heading: Ciudad
            }
            lov {
                lov: @lv-ciudades
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_PAIS (
            type: plainTextBasedOnLov
            heading {
                heading: País
            }
            lov {
                lov: @lv-paises
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_PROVINCIA (
            type: plainTextBasedOnLov
            heading {
                heading: Provincia
            }
            lov {
                lov: @lv-provincias
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: D
            }
        )

        column ROWID (
            type: hidden
            heading {
                heading: ROWID
            }
            layout {
                sequence: 70
            }
            source {
                dataType: OTHER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                BARRIOS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 94034 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ABREVIATURA (
                sequence: 6
            )

            displayColumn COD_BARRIO (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 7
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ID_CIUDAD (
                sequence: 5
            )

            displayColumn ID_PAIS (
                sequence: 3
            )

            displayColumn ID_PROVINCIA (
                sequence: 4
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @barrios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 19
                clearCache: 19
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @barrios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @barrios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17281496428193590
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

