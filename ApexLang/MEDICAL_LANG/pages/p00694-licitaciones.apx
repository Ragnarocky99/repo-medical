    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P694_ID_CLIENTE
                P694_NRO_LICITACION
                P694_NRO_ID_LICITACION
                P694_ESTADO_LLAMADO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @licitaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: item!=value
            item: P0_ID_SUCURSAL
            value: 690
        }

        action native-alert (
            action: alert
            settings {
                title: Aviso
                message: Para el correcto funcionamiento del módulo, las cargas deben ser realizadas en la sucursal de Licitaciones.
                style: information
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @licitaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

