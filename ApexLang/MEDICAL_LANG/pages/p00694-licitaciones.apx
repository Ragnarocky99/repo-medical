    region licitaciones (
        name: Licitaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT LC.ID,
                       LC.ID_EMPRESA,
                       LC.ID_SUCURSAL,
                       LC.NRO_LICITACION,
                       LC.FEC_LICITACION,
                       LC.ID_CLIENTE,
                       LC.ID_FORMATO,
                       LC.COD_USUARIO_AUD,
                       LC.FEC_ALTA,
                       LC.NRO_ID_LICITACION,
                       DECODE(LC.ESTADO_LLAMADO, 'PE', 'Pendiente',
                                                 'EV', 'Evaluacion',
                                                 'AD', 'Adjudicado',
                                                 'CA', 'Cancelado',
                                                 'PR', 'Prorroga',
                                                 'PD', 'Perdido',
                                                 'PT', 'Protesta',
                                                 'NA', 'No Aprobado',
                                                 'No definido') ESTADO_LLAMADO,
                       'f?p='||V('APP_ID')||':695:'||V('APP_SESSION')||':IG[Detalles]_'||FL.ALIAS||':::P695_ID:'||LC.ID URL,
                       DECODE(LC.IND_APROBADO, 'N', 'No',
                                               'S', 'Si',
                                               'No definido') IND_APROBADO,
                       CASE
                        WHEN IND_APROBADO = 'S' THEN 'fa fa-check u-success-text'
                        WHEN IND_NO_APROBADO = 'S' THEN 'fa fa-remove u-danger-text'
                       END IND_APROBADO_ICON
                  FROM LCW_LICITACIONES_CAB     LC
                  JOIN LCW_FORMATO_LICITACIONES FL ON FL.ID = LC.ID_FORMATO
                 WHERE ID_SUCURSAL = :P0_ID_SUCURSAL
                   AND LC.FEC_LICITACION BETWEEN :P694_FEC_INI AND :P694_FEC_FIN
                   AND (LC.NRO_LICITACION = :P694_NRO_LICITACION OR :P694_NRO_LICITACION IS NULL)
                   AND (LC.ID_CLIENTE = :P694_ID_CLIENTE OR :P694_ID_CLIENTE IS NULL)
                   AND (LC.NRO_ID_LICITACION = :P694_NRO_ID_LICITACION OR :P694_NRO_ID_LICITACION IS NULL)
                   AND (LC.ESTADO_LLAMADO = :P694_ESTADO_LLAMADO OR :P694_ESTADO_LLAMADO IS NULL)
                ORDER BY lc.NRO_LICITACION DESC
                
                ```
            pageItemsToSubmit: [
                P694_FEC_INI
                P694_FEC_FIN
                P694_ID_CLIENTE
                P694_NRO_LICITACION
                P694_NRO_ID_LICITACION
                P694_ESTADO_LLAMADO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P0_ID_SUCURSAL
            value: 690
        }
        link {
            linkColumn: customTarget
            target: {
                type: url
                url: #URL#
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 12695148983501160
        }

