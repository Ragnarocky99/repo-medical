page 490 (
    name: Carga de Coeficientes de Revaluo
    alias: CARGA-DE-COEFICIENTES
    title: Carga de Coeficientes de Revaluo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 228px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-coeficientes-de-revaluo (
        name: Carga de Coeficientes de Revaluo
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ANIO,
                       MES,
                       COEF_COMPRA,
                       COEF_VENTA,
                       COD_USUARIO_AUD
                from COW_COEFICIENTES
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P490_ANIO (
        type: numberField
        label {
            label: <p>Año: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: ANIO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P490_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P490_COEF_COMPRA (
        type: numberField
        label {
            label: <p>Coef. Compra: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: COEF_COMPRA
            dataType: number
        }
    )

    pageItem P490_COEF_VENTA (
        type: numberField
        label {
            label: <p>Coef. Venta: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: COEF_VENTA
            dataType: number
        }
    )

    pageItem P490_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: COW_COEF_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P490_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 40
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P490_MES (
        type: numberField
        label {
            label: <p>Mes: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: MES
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P490_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P490_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P490_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation val-anio (
        name: VAL_ANIO
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P490_ANIO IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: "Cargar año "
            displayLocation: onErrorPage
            associatedItem: @P490_ANIO
        }
    )

    validation val-coef-compra (
        name: VAL_COEF_COMPRA
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P490_COEF_COMPRA IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Cargar coeficiente de compra
            displayLocation: onErrorPage
            associatedItem: @P490_COEF_COMPRA
        }
    )

    validation val-coef-venta (
        name: VAL_COEF_VENTA
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P490_COEF_VENTA IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: "Cargar coeficiente de venta "
            displayLocation: onErrorPage
            associatedItem: @P490_COEF_VENTA
        }
    )

    validation val-mes (
        name: VAL_MES
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P490_MES IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Cargar el Mes
            displayLocation: onErrorPage
            associatedItem: @P490_MES
        }
    )

    process cerrar-recuadro-de-dialogo (
        name: Cerrar recuadro de Dialogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 60032687840439284
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE, SAVE, DELETE
        }
    )

    process inicializa (
        name: INICIALIZA
        type: formInitialization
        formRegion: @carga-de-coeficientes-de-revaluo
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 74855823239960640
        }
    )

    process procesar-pantalla-de-carga-de-mantenimiento-de-revaluo (
        name: Procesar pantalla de Carga de Mantenimiento de Revaluo
        type: formAutoRowProcessing
        formRegion: @carga-de-coeficientes-de-revaluo
        target {
            targetType: tableView
            tableName: COW_COEFICIENTES
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 60032202748439284
        }
    )

)

