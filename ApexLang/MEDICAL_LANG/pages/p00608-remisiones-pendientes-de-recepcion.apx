page 608 (
    name: Remisiones pendientes de recepcion
    alias: REMISIONES-PENDIENTES-DE-RECEPCION
    title: Remisiones pendientes de recepcion
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    css {
        inline:
            ```css
            p{
                font-family: "Roboto","Arial", serif;
                font-weight: bold;
                font-size:12.5px;
                color:#3f46bb;
            }
            .a-IRR-headerLink{
                font-size: 11px;
            }
            .t-Breadcrumb-label {
                font-size: 20px;
                font-family: "Roboto","Arial", serif;
            }
            .t-Region-title{
                    font-size: 15px;
                font-family: "Roboto","Arial", serif;
                    color:#3f46bb;
            }
            .a-GV-cell{
                font-family: "Roboto","Arial", serif;
                font-weight:normal;
                font-size: 11.5px;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
            cssClasses: titulo
            icon: fa-pencil
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region remisiones (
        name: Remisiones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select R.ID_SUC_SAL,
                       R.DESC_SUC_SAL,
                       R.ID_SUC_ENT,
                       R.DESC_SUC_ENT,
                       R.FEC_ENT_SAL,
                       R.NUM_ENT_SAL,
                       R.TIP_ENT_SAL,
                       R.SER_ENT_SAL,
                       R.ID_EMPRESA,
                       R.COD_SUCURSAL_SAL,
                       R.COD_SUC_ENT,
                       R.TOTAL_ARTICULOS,
                       R.ID_REMISION,
                       'Recepcionar',
                       CASE
                         WHEN (/*C.ID_COMPROBANTE_REF IS NULL OR*/
                              NVL(TRAE_TOTAL_RECEPCIONADO(R.ID_EMPRESA,
                                                       R.ID_SUC_ENT,
                                                       R.ID_REMISION),0) +
                              NVL(TRAE_TOTAL_RECEPCIONADO(R.ID_EMPRESA,
                                                       TRAE_ID_SUCURSAL(W_BUSCA_PARAMETRO('ST','COD_DEPOSITO_VIRTUAL'),:P0_ID_EMPRESA),
                                                       R.ID_REMISION),0) < R.TOTAL_ARTICULOS) THEN
                          '<span aria-hidden="true" class="fa fa-package fam-check fam-is-success"></span>'
                         /*WHEN C.ID_COMPROBANTE_REF IS NOT NULL THEN*/ ELSE
                          '<p> </p>'
                       END AS VER,
                       
                       CASE
                         WHEN TIENE_RECEPCION(R.ID_EMPRESA,R.ID_REMISION)=1 THEN
                          '<span class="fa fa-search" aria-hidden="true"></span>'
                         WHEN TIENE_RECEPCION(R.ID_EMPRESA,R.ID_REMISION)=0 THEN
                          '<p> </p>'
                       END AS VER_ENTSAL,
                       
                 --      C.ID AS ID_ENTSAL,
                       
                       NVL(TRAE_TOTAL_RECEPCIONADO(R.ID_EMPRESA,
                                                   R.ID_SUC_ENT,
                                                   R.ID_REMISION),
                           0) /*(SELECT SUM(D.CANTIDAD)  FROM STW_ENTSAL_CAB C , STW_ENTSAL_DET D WHERE C.ID_COMPROBANTE_REF=R.ID_REMISION
                                     AND D.ID_ENTSAL_CAB=C.ID)*/ AS TOTAL_RECEPCIONADO,
                       CASE
                         WHEN (/*C.ID_COMPROBANTE_REF IS NULL OR**/
                              NVL(TRAE_TOTAL_RECEPCIONADO(R.ID_EMPRESA,
                                                       R.ID_SUC_ENT,
                                                       R.ID_REMISION),0) +
                              NVL(TRAE_TOTAL_RECEPCIONADO(R.ID_EMPRESA,
                                                       TRAE_ID_SUCURSAL(W_BUSCA_PARAMETRO('ST','COD_DEPOSITO_VIRTUAL'),:P0_ID_EMPRESA),
                                                       R.ID_REMISION),0) < R.TOTAL_ARTICULOS) THEN
                          '<span aria-hidden="true" class="fa fa-package fam-information fam-is-warning"></span>'
                         /*WHEN C.ID_COMPROBANTE_REF IS NOT NULL THEN*/ ELSE
                          '<p> </p>'
                       END AS RECEPCION_VIRTUAL,
                       
                     --  C.COMENTARIO,
                       
                       (SELECT NVL(SUM(D.CANTIDAD), 0)
                          FROM STW_ENTSAL_CAB C, STW_ENTSAL_DET D
                         WHERE C.ID_COMPROBANTE_REF = R.ID_REMISION
                           AND D.ID_ENTSAL_CAB = C.ID
                           AND C.ID_SUCURSAL =
                               TRAE_ID_SUCURSAL(W_BUSCA_PARAMETRO('ST','COD_DEPOSITO_VIRTUAL'),
                                                :P0_ID_EMPRESA)) AS TOTAL_VIRTUAL,
                        R.ID_SOLICITUD_REF
                  from REMISIONES_PENDIENTES R
                 -- LEFT JOIN STW_ENTSAL_CAB C
                  --  ON C.ID_COMPROBANTE_REF = R.ID_REMISION
                  -- AND C.ID_SUCURSAL = R.ID_SUC_ENT
                 where R.id_empresa = :P0_ID_EMPRESA
                   AND R.ID_SUC_ENT = :P0_ID_SUCURSAL
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--showIcon
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
            ]
            icon: fa-truck
        }
        masterDetail {
            masterRegion: @solicitudes
        }
        componentAppearance {
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13948397246159703
        }

