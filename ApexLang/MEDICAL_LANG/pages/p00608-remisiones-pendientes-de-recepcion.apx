    region solicitudes (
        name: Solicitudes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_ENVIO,
                       NRO_ENVIO,
                       ID_SUCURSAL,
                       ID_SUCURSAL_ENT,
                       FECHA,
                       ESTADO,
                       (SELECT SUM(CANTIDAD)
                          FROM STW_NOTAS_ENVIO_DET_SOL D
                         WHERE D.ID_NRO_ENVIO_CAB = C.ID) AS SOLICITADO,
                         
                       NVL((SELECT SUM(CANTIDAD)
                             FROM STW_ENTSAL_DET D1, STW_ENTSAL_CAB C1
                            WHERE ID_SOLICITUD_REF = C.ID
                              AND C1.ID = D1.ID_ENTSAL_CAB),
                           0) AS ENVIADO,
                           
                       NVL((SELECT SUM(D1.CANTIDAD)
                             FROM STW_ENTSAL_CAB C1, STW_ENTSAL_CAB C2, STW_ENTSAL_DET D1
                            WHERE C1.ID_SOLICITUD_REF = c.ID
                              AND C1.ID = C2.ID_COMPROBANTE_REF
                              AND C2.ID_SUCURSAL = C.ID_SUCURSAL_ENT
                              AND C2.ID = D1.ID_ENTSAL_CAB),
                           0) AS RECEPCIONADO,
                           
                       NVL((SELECT SUM(D1.CANTIDAD)
                             FROM STW_ENTSAL_CAB C1, STW_ENTSAL_CAB C2, STW_ENTSAL_DET D1
                            WHERE C1.ID_SOLICITUD_REF = c.ID
                              AND C1.ID = C2.ID_COMPROBANTE_REF
                              AND C2.ID_SUCURSAL <> C.ID_SUCURSAL_ENT
                              AND C2.ID = D1.ID_ENTSAL_CAB),
                           0) AS PERDIDO
                           
                  from STW_NOTAS_ENVIO_CAB_SOL C
                 WHERE ID_SUCURSAL_ENT = :P0_ID_SUCURSAL
                   AND ID_EMPRESA = :P0_ID_EMPRESA
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--showIcon
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
            icon: fa-flag-pennant
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 275
        }
        advanced {
            savedReportMappingIdentifier: 13870153390152248
        }

