            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NRO_ENVIO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PERDIDO (
