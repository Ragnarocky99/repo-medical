    dynamicAction cocnvert-fecha (
        name: COCNVERT_FECHA
        execution {
            sequence: 310
        }
        when {
            selectionType: items
            items: P238_FEC_MOV_CAJ
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P238_FEC_MOV_CAJ) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P238_FEC_MOV_CAJ,'/','');
                            conv_fecha := substr(:P238_FEC_MOV_CAJ,1,2)||'/'||
                                                      substr(:P238_FEC_MOV_CAJ,3,2)||'/'||
                                                      lpad(substr(:P238_FEC_MOV_CAJ,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P238_FEC_MOV_CAJ := conv_fecha;
                            ELSIF (length(:P238_FEC_MOV_CAJ) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P238_FEC_MOV_CAJ) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CP','ID_MODULO_CP'),:P238_FEC_MOV_CAJ);
                    end;
                    ```
                itemsToSubmit: P238_FEC_MOV_CAJ
                itemsToReturn: P238_FEC_MOV_CAJ
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

