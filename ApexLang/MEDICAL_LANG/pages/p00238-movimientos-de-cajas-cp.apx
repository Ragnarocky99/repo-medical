    region master (
        name: Master
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region movimientos-de-cajas (
        name: Movimientos de Cajas
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_MOV_CAJ,
                       SER_MOV_CAJ,
                       NRO_MOV_CAJ,
                       ID_SUCURSAL,
                       FEC_MOV_CAJ,
                       ANULADO,
                       FEC_ANULACION,
                       ID_USUARIO,
                       TOT_NRO_MOV_CAJ,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       RECIBOS,
                       ID_PROVEEDOR,
                       IND_ENTREGADO,
                       FEC_ENTREGA,
                       COD_USUARIO_AUD,
                       ID_ORDEN_PAGO,
                       IND_IMPRESION,
                       REPLACE(REPLACE(ASIENTOS,'*'),'caja') ASIENTOS,
                       COMENTARIO
                  from CPW_CABECERA_CAJAS
                ```
        }
        layout {
            sequence: 10
            parentRegion: @master
            slot: subRegions
            columnSpan: 3
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: 115166739402664344
            update: 115982101204089920
            delete: 115982723002100944
        }
    )

