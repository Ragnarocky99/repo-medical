    computation p238-nro-mov-caj (
        itemName: P238_NRO_MOV_CAJ
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_nro_mov_caj  CPW_CABECERA_CAJAS.NRO_MOV_CAJ%TYPE;
                BEGIN
                IF :P238_NRO_MOV_CAJ IS  NULL THEN 
                SELECT to_number(MAX(NRO_MOV_CAJ))+1
                INTO v_nro_mov_caj
                FROM 
                CPW_CABECERA_CAJAS WHERE
                 ID_EMPRESA=:P0_COD_EMPRESA;
                IF v_nro_mov_caj is null then
                v_nro_mov_caj:=1;
                
                end if;
                 END IF;
                RETURN v_nro_mov_caj ;
                exception
                WHEN NO_DATA_FOUND THEN
                v_nro_mov_caj:=1;
                return v_nro_mov_caj;
                WHEN OTHERS THEN
                RAISE_APPLICATION_ERROR(20000,'Error en la tablas de movimientos de cajas'||sqlerrm);
                v_nro_mov_caj:=1;
                return v_nro_mov_caj;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P238_ID
        }
    )

    computation p238-total-cobro (
        itemName: P238_TOTAL_COBRO
