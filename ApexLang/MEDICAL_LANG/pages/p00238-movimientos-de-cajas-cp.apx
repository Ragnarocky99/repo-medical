            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT '('||SUBTIPO_TRANS||') ' || DESCRIPCION, ID
                    FROM BSW_SUBTIPOS_TRANS
                    WHERE ID_TIPO_TRANS = W_BUSCA_PARAMETRO('CP','ID_TRANS_PAGOS')
                    and ID_MODULO=W_BUSCA_PARAMETRO('CP','ID_MODULO_CP')
                    ORDER BY length(SUBTIPO_TRANS), SUBTIPO_TRANS
