    dynamicAction cambiar-montos-comprobantes (
        name: Cambiar montos Comprobantes
        execution {
            sequence: 120
        }
        when {
            selectionType: columns
            interactiveGrid: @comprobantes
            columns: TOT_PAGADO
        }
        comments {
            comments: Cambia los montos del detalle de comprobantes
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                    IF :TOT_PAGADO IS NOT NULL THEN
                    
                        IF :ID_MONEDA = :P238_ID_MONEDA THEN
                            :TOT_VALORIZADO := REPLACE(:TOT_PAGADO, '.', '');
                        ELSE
                            :TOT_VALORIZADO:=ROUND((REPLACE(:TOT_PAGADO,'.','')*NVL(REPLACE(:TIP_CAMBIO,'.',''),1))/REPLACE(:P238_TIP_CAMBIO,'.',''),:P238_DECIMALES);
                        END IF;
                    
                    END IF;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000,'Error al calcular el total valorizado' ||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    TIP_CAMBIO
                    TOT_PAGADO
                    P238_TIP_CAMBIO
                    P238_DECIMALES
                    ID_MONEDA
                    P238_ID_MONEDA
                ]
                itemsToReturn: TOT_VALORIZADO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

