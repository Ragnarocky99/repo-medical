    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 340
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @formas-cobro
            columns: SER_VALOR
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_TALON_CHE_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 290
        }
        when {
            event: click
            selectionType: items
            items: P238_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P238_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P238_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P238_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P238_ASIENTOS_ID
                    P238_URL
                ]
                itemsToReturn: P238_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P238_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction beneficiario-por-defecto (
        name: Beneficiario Por Defecto
        execution {
            sequence: 240
        }
        when {
            event: focusin
            selectionType: items
            items: P238_BENEFICIARIO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PE.NOMBRE FROM 
                    BSW_PERSONAS PE,
                    CMW_PROVEEDORES PR
                    WHERE PR.ID_PERSONA=PE.ID  AND
                    PR.ID=:P238_ID_PROVEEDOR
                    ```
                itemsToSubmit: P238_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P238_BENEFICIARIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P238_BENEFICIARIO
            }
            serverSideCondition {
                type: itemIsNull
                item: P238_ID
            }
        )

    )

    dynamicAction cambiar-lista-de-valores (
        name: Cambiar lista de valores
        execution {
            sequence: 140
        }
        when {
            selectionType: columns
            interactiveGrid: @comprobantes
            columns: TIP_COMPROBANTE
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: TIP_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Oculta el campo de id comprobantes o id recibos dependiendo del tipo de comprobante que se seleccione "
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    gridView = apex.region("Comprobantes").call("getViews").grid;
                     gridView.view$.grid("showColumn", "ID_COMPROBANTE");
                      gridView.view$.grid("hideColumn", "ID_RECIBO");
                     //console.log('mostrar columna de comprobante')
                    ```
            }
            affectedElements {
                selectionType: columns
                columns: ID_COMPROBANTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                column: TIP_COMPROBANTE
                value: REC
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    ocultarColumna();
                    //console.log('mostrar columna de recibo')
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
                value: REC
            }
        )

    )

    dynamicAction cambiar-montos-cobros (
        name: Cambiar Montos Cobros
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @formas-cobro
            columns: TOT_VALOR
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: TOT_VALOR
        }
        comments {
            comments: Cambio los montos en el detalle de forma_cobors
        }

        action importe-cambio (
            name: IMPORTE_CAMBIO
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    begin
                    
                        if :TOT_VALOR IS NOT NULL AND :TIP_CAMBIO IS NOT NULL AND :P238_TIP_CAMBIO IS NOT NULL AND :P238_DECIMALES IS NOT NULL THEN--nvl(replace(:TOT_VALOR,'.',''),0) != 0 or :TOT_VALOR != 'NaN' then 
                            IF :ID_MONEDA_PAGO = :P238_ID_MONEDA THEN
                                RETURN REPLACE(:TOT_VALOR, '.', '');
                            ELSE
                                return round(replace(:TOT_VALOR,'.','')*nvl(REPLACE(:tip_cambio,'.',''),REPLACE(:P238_TIP_CAMBIO,'.',''))/REPLACE(:P238_TIP_CAMBIO,'.',''),:P238_DECIMALES);
                            END IF;
                        end if;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                         RAISE_APPLICATION_ERROR(-20000,'Error al calcular el importe valorizado '||nvl(replace(:TOT_VALOR, 'NaN', 0),0)||' '||sqlerrm);
                    end;
                    ```
                itemsToSubmit: [
                    TIP_CAMBIO
                    TOT_VALOR
                    P238_TIP_CAMBIO
                    P238_DECIMALES
                    ID_MONEDA_PAGO
                    P238_ID_MONEDA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: IMPORTE_CAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF (TO_NUMBER(REPLACE(:TOT_VALOR,'.',''))*NVL(:TIP_CAMBIO,1)>=TO_NUMBER(REPLACE(:P238_TOT_NRO_MOV_CAJ,'.',''))) THEN
                    :TOT_VALOR:=ROUND(replace(:P238_TOT_NRO_MOV_CAJ,'.','')/NVL(:TIP_CAMBIO,1),NVL(:DECIMALES,0));
                    END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al calcular los montos'||sqlerrm);
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    TIP_CAMBIO
                    TOT_VALOR
                    P238_TOT_NRO_MOV_CAJ
                    DECIMALES
                ]
                itemsToReturn: TOT_VALOR
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF (ROUND(TO_NUMBER(REPLACE(:MONTO,'.',''))*NVL(:TIP_CAMBIO,1))>=TO_NUMBER(REPLACE(:P238_TOT_NRO_MOV_CAJ,'.',''))) THEN
                    :IMPORTECAMBIO:=replace(:P238_NRO_MOV_CAJ,'.','');
                    ELSE
                    :IMPORTECAMBIO:=REPLACE(:MONTO,'.','')*NVL(:TIP_CAMBIO,1);
                    END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al calcular los montos'||sqlerrm);
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    TIP_CAMBIO
                    MONTO
                    P238_TOT_NRO_MOV_CAJ
                    DECIMALES
                ]
                itemsToReturn: IMPORTE_CAMBIO
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calcularTotalesCobros();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_monto ccw_formas_cobros.monto%type:=0;
                    begin
                    if  round(replace(:TOT_VALOR,'.','')*nvl(:tip_cambio,1))>=replace(:P238_TOT_NRO_MOV_CAJ,'.','') then
                     v_monto:=replace(:P238_TOT_NRO_MOV_CAJ,'.','');
                     return v_monto;
                    else
                    v_monto:=replace(:TOT_VALOR,'.','')*nvl(:tip_cambio,1);
                    return v_monto;
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    TOT_VALOR
                    TIP_CAMBIO
                    P238_TOT_NRO_MOV_CAJ
                ]
            }
            affectedElements {
                selectionType: columns
                columns: IMPORTE_CAMBIO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_DOCUMENTO
                value: &P238_EFECTIVO_COBRO.
            }
            serverSideCondition {
                type: never
            }
        )

    )

