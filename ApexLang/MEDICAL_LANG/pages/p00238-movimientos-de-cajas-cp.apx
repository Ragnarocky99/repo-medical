    dynamicAction transaccion-predeterminada (
        name: Transaccion Predeterminada
        execution {
            sequence: 190
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @formas-cobro
            columns: ID_SUB_TIPO_TRANS
        }
        comments {
            comments: "Si no se selecciona ningún tipo de sub-transacción  al darse TAB se seleccionara efectivo por defecto "
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_id_sub_tipo_trans bsw_subtipos_trans.id%type;
                    begin
                    SELECT ID
                    into v_id_sub_tipo_trans
                    from bsw_subtipos_trans
                    where SUBTIPO_TRANS=W_BUSCA_PARAMETRO('CP','EFECTIVO_COBRO') AND   
                    ID_MODULO=W_BUSCA_PARAMETRO('CP','ID_MODULO_CP')
                    and id_empresa=:P0_ID_EMPRESA ;
                    return v_id_sub_tipo_trans;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RETURN NULL;
                    WHEN OTHERS THEN
                    RETURN NULL;
                    end;
                    ```
            }
            affectedElements {
                selectionType: columns
                columns: ID_SUB_TIPO_TRANS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: ID_SUB_TIPO_TRANS
            }
        )

    )

    dynamicAction validar-serie (
        name: Validar Serie
        execution {
            sequence: 270
        }
        when {
            selectionType: columns
            interactiveGrid: @formas-cobro
            columns: NUM_VALOR
        }
        serverSideCondition {
            type: never
        }

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró el Nro. de Serie
                style: warning
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P238_BANDERA_VALOR
                value: 0
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera number:=0;
                    
                    BEGIN
                    IF :NUM_VALOR IS NULL THEN
                    RAISE_APPLICATION_ERROR (-20000, 'Ingrese Nro. de Serie');
                    SELECT NVL((SELECT 1 from cpw_valores_cajas
                                where ID_empresa  = :P0_ID_EMPRESA
                                and ID_sucursal = :P238_ID_SUCURSAL
                                and ID_cuenta    = :ID_CUENTA
                                and nvl(anulado,'N') <> 'S'
                                and nvl(ser_valor, 'A')    = nvl(:ser_valor,'A')
                                and num_valor    = :NUM_VALOR),0)
                    AS BANDERA 
                    INTO VBANDERA
                    FROM DUAL;
                    :P238_BANDERA := VBANDERA;
                    END IF;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el Nro. de Serie');
                    END;
                    ```
                itemsToSubmit: NUM_VALOR
                itemsToReturn: P238_BANDERA_VALOR
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

