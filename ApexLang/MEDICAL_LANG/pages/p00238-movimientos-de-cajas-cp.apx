    dynamicAction setear-orden-pago (
        name: Setear Orden Pago
        execution {
            sequence: 280
        }
        when {
            selectionType: items
            items: P238_ID_ORDEN_PAGO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    IF :P238_ID_ORDEN_PAGO IS NOT NULL THEN
                    
                      OPEN l_cursor FOR
                        SELECT OP.ID_ORDEN_PAGO_CAB AS ID_ORDEN_PAGO, 
                               CPW.NUM_COMPROBANTE ID_COMPROBANTE_CP,
                               CM.NRO_COMPROBANTE ID_COMPROBANTE_CM, 
                                OP.NUM_CUOTA, 
                                CP.ID_MONEDA, 
                                CP.TIP_CAMBIO,
                                OP.TOT_ORDEN_PAGO,
                                OP.ID_CUOTA, 
                                NVL(CM.REFERENCIA,CPW.REFERENCIA) AS REFERENCIA,
                                NVL(CM.TIP_COMPROBANTE,CPW.TIP_COMPROBANTE) AS TIP_COMPROBANTE,
                                (OP.TOT_ORDEN_PAGO * CP.TIP_CAMBIO) AS MONTO_VALORIZADO
                        FROM CPW_DETALLE_ORDEN_PAGO    OP, 
                             CPW_CABECERA_ORDEN_PAGO   CP,
                             CPW_COMPROBANTES_CABECERA CPW,
                             CMW_COMPRAS_CABECERA      CM
                        WHERE OP.ID_ORDEN_PAGO_CAB = CP.ID
                          AND OP.ID_ORDEN_PAGO_CAB = :P238_ID_ORDEN_PAGO
                          AND OP.ID_COMPROBANTE_CM = CM.ID(+)
                          AND OP.ID_COMPROBANTE    = CPW.ID(+);
                        
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('CUOTAS', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                    
                      :P238_JSON_DETALLE:=JSON_DETALLE;
                      SELECT C.SUMA_TOTAL INTO :P238_TOT_NRO_MOV_CAJ FROM CPW_CABECERA_ORDEN_PAGO C
                      WHERE C.ID = :P238_ID_ORDEN_PAGO;
                    
                    
                    END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P238_ID_ORDEN_PAGO
                    P238_BANDERA
                ]
                itemsToReturn: [
                    P238_JSON_DETALLE
                    P238_TOT_NRO_MOV_CAJ
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Comprobantes").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    
                    
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P238_ID_ORDEN_PAGO
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var total=0;
                    var json_detalle = JSON.parse($v('P238_JSON_DETALLE'));
                            var $widget = apex.region("Comprobantes").widget();
                            var $grid = $widget.interactiveGrid("getViews", "grid");
                            var $model = $grid.model;     
                    
                    //console.log(json_detalle);
                    
                    
                    
                    if ((Object.keys(json_detalle.CUOTAS).length)!=0){
                    
                    
                        for(let i=0;i<json_detalle.CUOTAS.length;i++){
                    
                           console.log('Codigo ejecutandose ')
                            //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    
                            $grid.setEditMode(true);
                            //insert new record on a model
                            var newRecordId = $model.insertNewRecord();
                            var $newRecord = $model.getRecord(newRecordId);
                    
                            total=total+json_detalle.CUOTAS[i].TOT_ORDEN_PAGO;
                    
                    
                                  $model.setValue($newRecord, "TIP_COMPROBANTE",(json_detalle.CUOTAS[i].TIP_COMPROBANTE).toString());
                                  $model.setValue($newRecord, "REFERENCIA",(json_detalle.CUOTAS[i].REFERENCIA).toString());
                                  $model.setValue($newRecord, "ID_COMPROBANTE",(json_detalle.CUOTAS[i].ID_COMPROBANTE_CP).toString());
                                
                            if((json_detalle.CUOTAS[i].ID_COMPROBANTE_CM)!=null){
                                $model.setValue($newRecord, "ID_COMPROBANTE_CM",(json_detalle.CUOTAS[i].ID_COMPROBANTE_CM).toString());
                            }
                            if((json_detalle.CUOTAS[i].NUM_CUOTA)!=null){
                     
                    
                            $model.setValue($newRecord, "NRO_CUOTA",(json_detalle.CUOTAS[i].NUM_CUOTA).toString());
                            }
                            if((json_detalle.CUOTAS[i].ID_MONEDA)!=null){
                     
                    
                            $model.setValue($newRecord, "ID_MONEDA",(json_detalle.CUOTAS[i].ID_MONEDA).toString());
                            }
                            if((json_detalle.CUOTAS[i].TIP_CAMBIO)!=null){
                     
                            $model.setValue($newRecord, "TIP_CAMBIO",(json_detalle.CUOTAS[i].TIP_CAMBIO).toString());
                            }
                    
                            if((json_detalle.CUOTAS[i].TOT_ORDEN_PAGO)!=null){
                     
                    
                            $model.setValue($newRecord, "TOT_PAGADO",(json_detalle.CUOTAS[i].TOT_ORDEN_PAGO).toString().replace(',','')/*.replace(/\./g, '')*/);
                            }
                            if((json_detalle.CUOTAS[i].ID_CUOTA)!=null){
                     
                    
                            $model.setValue($newRecord, "ID_CUOTA",(json_detalle.CUOTAS[i].ID_CUOTA).toString());
                            }
                            if((json_detalle.CUOTAS[i].MONTO_VALORIZADO)!=null){
                     
                    
                            $model.setValue($newRecord, "TOT_VALORIZADO",(json_detalle.CUOTAS[i].MONTO_VALORIZADO).toString().replace(',','')/*.replace(/\./g, '')*/);
                            }
                      
                            if((json_detalle.CUOTAS[i].ID_PROVEEDOR)!=null){
                     
                    
                            $model.setValue($newRecord, "ID_PROVEEDOR",(json_detalle.CUOTAS[i].ID_PROVEEDOR).toString());
                            }
                            if((json_detalle.CUOTAS[i].ID_ORDEN_PAGO)!=null){
                     
                    
                            $model.setValue($newRecord, "ID_ORDEN_PAGO",(json_detalle.CUOTAS[i].ID_ORDEN_PAGO).toString());
                            }
                        }
                      
                    }
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P238_ID_ORDEN_PAGO
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comprobantes
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

