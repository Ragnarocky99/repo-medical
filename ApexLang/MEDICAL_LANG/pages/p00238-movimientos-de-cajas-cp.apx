        action tot-valor (
            name: TOT_VALOR
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    begin
                        if round((replace(:P238_TOT_NRO_MOV_CAJ,'.','') - REPLACE(NVL(:P238_TOTAL_COBRO, 0), '.', '')), :P238_DECIMALES) != 0 then
                            return round((replace(:P238_TOT_NRO_MOV_CAJ,'.','') - REPLACE(NVL(:P238_TOTAL_COBRO, 0), '.', '')), :P238_DECIMALES);
                        else
                            return replace(:TOT_VALOR, '.', '');
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P238_TOT_NRO_MOV_CAJ
                    P238_TOTAL_COBRO
                    P238_DECIMALES
                    TOT_VALOR
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: TOT_VALOR
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

