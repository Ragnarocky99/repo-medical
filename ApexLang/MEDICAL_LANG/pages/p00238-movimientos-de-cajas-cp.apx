    region formas-cobro (
        name: Formas_Cobro
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CPW_VALORES_CAJAS
            whereClause: ID_CAB_CAJAS=:P238_ID
            orderByClause: ID ASC
            pageItemsToSubmit: P238_ID
        }
        layout {
            sequence: 40
            parentRegion: @master
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: FORMAS_COBRO
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calcularTotalesCobros();
                                    apex.item("P238_CANT_LINEAS").setValue(apex.region("FORMAS_COBRO").widget().interactiveGrid("getViews", "grid").model.getTotalRecords());
                            };   
                    
                        } ;      
                        return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 222508990700272179
        }

