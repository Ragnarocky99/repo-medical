    validation validar-num-serie (
        name: Validar Num Serie
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                --IF :ID_CUENTA IS NOT NULL THEN
                IF :num_valor IS NULL THEN
                	    RAISE_APPLICATION_ERROR (-20000, 'Ingrese Nro. de Serie');
                	elsif :num_valor IS not NULL then
                    declare
                	  	 v_existe varchar2(1):='N' ;
                	  begin
                		        select 'S'
                		        into v_existe
                		        from cpw_valores_cajas
                		        where ID_empresa  = :P0_COD_EMPRESA
                		        and ID_sucursal = :id_SUCURSAL
                		        and ID_cuenta    = :ID_cuenta
                		        and tip_valor    = :tip_valor
                		        and nvl(anulado,'N') <> 'S'
                		        and nvl(ser_valor, 'A')    = nvl(:ser_valor,'A')
                		        and num_valor    = :num_valor
                		        AND ROWNUM=1;
                                     if nvl(v_existe, 'N') = 'S' then
                		        RETURN  TRUE;
                                ELSE 
                                    RETURN FALSE;
                		    end if ;
                		        exception
                		        when no_data_found then 
                		        v_existe := 'N' ;
                                RETURN FALSE;
                		        when others then
                		        v_existe := 'N' ;
                                RETURN TRUE;
                	    end;
                 --   end if;
                    END IF;
                ```
        }
        error {
            errorMessage: El Nro. de Serie ya existe
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    validation validar-num-serie-2 (
        name: Validar Num serie 1
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                v_valor varchar2(100);
                 v_existe varchar2(1):='N' ;
                 begin
                SELECT NUM_VALOr
                into v_valor
                 FROM CPW_VALORES_CAJAS
                WHERE ID=:P238_ID;
                
                --IF :ID_CUENTA IS NOT NULL THEN
                IF :num_valor IS NULL THEN
                	    RAISE_APPLICATION_ERROR (-20000, 'Ingrese Nro. de Serie');
                	elsif :num_valor IS not NULL AND V_VALOR<>:NUM_VALOR  then
                		        select 'S'
                		        into v_existe
                		        from cpw_valores_cajas
                		        where ID_empresa  = :P0_COD_EMPRESA
                		        and ID_sucursal = :id_SUCURSAL
                		        and ID_CUENTA    = :ID_CUENTA
                		        and tip_valor    = :tip_valor
                		        and nvl(anulado,'N') <> 'S'
                		        and nvl(ser_valor, 'A')    = nvl(:ser_valor,'A')
                		        and num_valor    = :num_valor
                		        AND ROWNUM=1;
                                     if nvl(v_existe, 'N') = 'S' then
                		            RETURN  TRUE;
                                ELSE 
                                    RETURN FALSE;
                		            end if ;
                                    ELSE 
                                    RETURN FALSE;
                 end if;
                -- END IF;
                	    end;
                        exception
                		        when no_data_found then 
                		        RETURN FALSE ;
                		        when others then
                		        RAISE_APPLICATION_ERROR(-20000,'Error al validar el numero del cheque');
                ```
        }
        error {
            errorMessage: El Nro. de Serie ya existe
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

