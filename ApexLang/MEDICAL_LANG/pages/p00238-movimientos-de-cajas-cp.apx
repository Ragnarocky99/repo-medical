    process comprobantes-save-interactive-grid-data (
        name: Comprobantes - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @comprobantes
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                
                                 INSERT INTO CPW_DETALLE_CAJAS (ID_EMPRESA,ID_MOV_CAJ_CPW,ID_COMPROBANTE_CPW,ID_PROVEEDOR,NUM_CUOTA,
                                 TOT_PAGADO,ID_MONEDA,TIP_CAMBIO,COD_USUARIO_AUD,TOT_VALORIZADO,ID_CUOTA,ID_COMPROBANTE_CM,ID_ORDEN_PAGO)
                                 VALUES (:P0_COD_EMPRESA,:P238_ID,:ID_COMPROBANTE_CPW,:P238_ID_PROVEEDOR,:NRO_CUOTA,
                                 REPLACE(:TOT_PAGADO,'.',''),
                                 :ID_MONEDA,
                                 :TIP_CAMBIO,:COD_USUARIO_AUD,
                                 REPLACE(:TOT_VALORIZADO,'.',''),
                                 :ID_CUOTA,:ID_COMPROBANTE_CM,:ID_ORDEN_PAGO);
                              
                
                        
                            WHEN 'U' then
                
                             UPDATE CPW_DETALLE_CAJAS
                             SET ID_COMPROBANTE_CPW=:ID_COMPROBANTE_CPW,
                             ID_PROVEEDOR=:P238_ID_PROVEEDOR,
                             NUM_CUOTA=:NUM_CUOTA,
                             TOT_PAGADO=REPLACE(:TOT_PAGADO,'.',''),
                             ID_MONEDA=:ID_MONEDA, 
                             TIP_CAMBIO=:TIP_CAMBIO,
                             COD_USUARIO_AUD=:COD_USUARIO_AUD,
                             TOT_VALORIZADO=REPLACE(:TOT_VALORIZADO,'.',''),
                             ID_CUOTA=:ID_CUOTA,
                             ID_COMPROBANTE_CM=:ID_COMPROBANTE_CM,
                             ID_ORDEN_PAGO=:ID_ORDEN_PAGO
                             WHERE
                             ID=:ID    
                             AND ID_MOV_CAJ_CPW=:P238_ID;
                
                
                           when 'D' then
                
                           DELETE CPW_DETALLE_CAJAS
                           WHERE ID=:ID    
                           AND ID_MOV_CAJ_CPW=:P238_ID;
                    
                              
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 41430622358006576
        }
    )

    process formas-cobro-save-interactive-grid-data (
        name: Formas_Cobro - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @formas-cobro
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                
                                  insert into CPW_VALORES_CAJAS (ID_EMPRESA,ID_SUCURSAL,NRO_MOV_CAJ,SER_VALOR,NUM_VALOR,ID_BANCO,ID_CUENTA,
                                  ID_MONEDA_PAGO,TIP_CAMBIO,BENEFICIARIO,FEC_EMISION,FEC_VENCIMIENTO,TOT_VALOR,ID_USUARIO,ANULADO,NRO_LINEA,
                                  COD_USUARIO_AUD,ID_CAB_CAJAS,ID_SUB_TIPO_TRANS,IMPORTE_CAMBIO,FEC_ANULACION,CONCEPTO,NRO_PLANILLA_FF,
                                  ID_TALON_CHE)
                                  VALUES (:P0_COD_EMPRESA,:P0_COD_SUCURSAL,:P238_NRO_MOV_CAJ,:SER_VALOR,:NUM_VALOR,:ID_BANCO,:ID_CUENTA,
                                  :ID_MONEDA_PAGO,:TIP_CAMBIO,:BENEFICIARIO,:FEC_EMISION,:FEC_VENCIMIENTO,
                                  REPLACE(:TOT_VALOR,'.','')
                                  ,:ID_USUARIO,:ANULADO,:NRO_LINEA,
                                  :COD_USUARIO_AUD,:P238_ID,:ID_SUB_TIPO_TRANS,
                                  REPLACE(:IMPORTE_CAMBIO,'.',''),
                                  :FEC_ANULACION,
                                  :P238_CONCEPTO,:NRO_PLANILLA_FF,
                                  :ID_TALON_CHE);
                
                        
                            WHEN 'U' then  
                         
                                 UPDATE CPW_VALORES_cajas
                                 SET SER_VALOR=:SER_VALOR,
                                 NUM_VALOR=:NUM_VALOR,
                                 ID_BANCO=:ID_BANCO,
                                 ID_CUENTA=:ID_CUENTA,
                                 ID_MONEDA_PAGO=:ID_MONEDA_PAGO,
                                 TIP_CAMBIO=:TIP_CAMBIO,
                                 BENEFICIARIO=:BENEFICIARIO,
                                 FEC_EMISION=:FEC_EMISION,
                                 FEC_VENCIMIENTO=:FEC_VENCIMIENTO,
                                 TOT_VALOR=REPLACE(:TOT_VALOR,'.',''),
                                 ID_USUARIO=:ID_USUARIO,
                                 ANULADO=:ANULADO,
                                 NRO_LINEA=:NRO_LINEA,
                                 COD_USUARIO_AUD=:COD_USUARIO_AUD,
                                 ID_SUB_TIPO_TRANS=:ID_SUB_TIPO_TRANS,
                                 IMPORTE_CAMBIO=REPLACE(:IMPORTE_CAMBIO,'.',''),
                                 FEC_ANULACION=:FEC_ANULACION,
                                 NRO_PLANILLA_FF=:NRO_PLANILLA_FF,
                                 ID_TALON_CHE = :ID_TALON_CHE
                                 where
                                 id=:id    
                                 and ID_CAB_CAJAS=:P238_ID;
                              
                             
                
                           when 'D' then
                               
                               delete cpw_valores_cajas
                               where id=:id    
                               and id_cab_cajas=:P238_ID;
                              
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 41452061247006587
        }
    )

    process imprimir (
        name: Imprimir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proc varchar2(100) := 'show report';
                  l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');--'http://localhost:8090/jri/report';
                BEGIN
                  xlog (l_proc, 'url (orig):' || l_report_url);
                
                  xlib_jasperreports.set_report_url(l_report_url);
                  xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('OrdenPago'),
                          p_rep_format          => apex_util.url_encode('pdf'),
                          p_data_source         => apex_util.url_encode('default'),
                          p_out_filename        => apex_util.url_encode(:P3_out_filename),
                          p_rep_locale          => apex_util.url_encode('es_ES'),
                          p_rep_encoding        => apex_util.url_encode('UTF-8'),
                          p_additional_params   => ('P_ID_CAB_CAJA='||:P238_ID),
                          p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                          p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                          p_print_media         => apex_util.url_encode(:P3_print_media),
                          p_print_copies        => apex_util.url_encode(:P3_print_copies),
                          p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                          p_print_collate       => case when :P3_print_collate='1' then true else false end,
                          p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                          p_save_filename       => apex_util.url_encode(:P3_save_filename),
                          p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                          p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                          );
                  
                  -- this was used before apex 4.1
                  --apex_application.g_unrecoverable_error := true;
                  apex_application.stop_apex_engine();
                
                exception
                  when apex_application.e_stop_apex_engine then
                    null; -- ok, stop engine raises exception, we can ignore that
                  when others then 
                    xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                    raise;
                end;   
                                                     
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 41469571054006598
        }
        serverSideCondition {
            whenButtonPressed: @print
        }
    )

