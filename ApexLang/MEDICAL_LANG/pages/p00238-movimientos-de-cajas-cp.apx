            action: executeJsCode
            settings {
                jsCode: calcularTotales();
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-caja (
        name: Cargar Caja
        execution {
            sequence: 130
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Carga los datos de la caja del usuario que esta conectado actualmente "
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_error exception;
                    BEGIN
                       Select id_caja, nro_habilitacion,id,FEC_HABILITACION,HORA_HABILITACION
                         into :P238_ID_CAJA,:P238_NRO_HABILITACION,:P238_ID_HABILITACION,:P238_FEC_HABILITACION,:P238_HORA_HABILITACION
                         from ccw_habilitaciones
                        where id_empresa = :p0_cod_empresa
                          and id_sucursal = :P0_COD_SUCURSAL
                          and upper(id_usuario) = (SELECT ID FROM BSW_USUARIOS WHERE COD_USUARIO=UPPER(:APP_USER) AND 
                          ID_EMPRESA=:P0_COD_EMPRESA)
                          and fec_cierre IS NULL;
                          
                      EXCEPTION
                        when no_data_found then
                           raise_application_error(-20000,'El usuario  '|| :APP_USER ||' no posee ninguna caja habilitada');
                             --  dbms_output.put_line('hola');
                         -- apex_util.set_session_state('P238_ERROR', 'No se encontro ninguna caja habilitada para el usuario '||:APP_USER);
                         /*apex_error.add_error (
                        p_message          => 'El usuario no posee ninguna caja habilitada!',
                        p_display_location => apex_error.c_inline_in_notification );*/
                        when others then
                          raise_application_error(-20000,'Error en el la tabla de habilitacion de caja'||sqlerrm);
                      END;
                    ```
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemIsNull
                item: P238_ID
            }
            serverSideCondition {
                type: itemIsNull
                item: P238_ID
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    SELECT FEC_HABILITACION,HORA_HABILITACION  
                    INTO :P238_FEC_HABILITACION,:P238_HORA_HABILITACION
                    FROM CCW_HABILITACIONES
                    WHERE ID_CAJA=:P238_ID_CAJA 
                    AND  ID=:P238_ID_HABILITACION;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    ```
            }
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P238_ID
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P238_ID
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_cod_caja CCW_CAJAS.COD_CAJA%TYPE;
                    BEGIN
                    IF :P238_ID_CAJA IS NOT NULL THEN
                    SELECT COD_CAJA 
                    INTO V_COD_CAJA
                    FROM 
                    CCW_CAJAS 
                    WHERE ID=:P238_ID_CAJA;
                    RETURN V_COD_CAJA;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN 
                    RETURN NULL;
                    WHEN OTHERS THEN
                    RETURN NULL;
                    END;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P238_COD_CAJA
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction cargar-comprobante-desde-pantalla-de-factura-o-recibo (
        name: Cargar Comprobante(Desde Pantalla de Factura o Recibo)
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: MP238_ID_COPROBANTE
        }
        clientSideCondition {
            type: itemIsNull
            item: P238_ID
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: Carga los datos del comprobante cuando se llama a la pantalla de movimiento de caja desde la pantalla de carga de comprobantes
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Comprobantes").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    
                    
                    // PRODUCT_ID and ORDER_QUANTITY are column names in IG SQL query
                    //update record values
                    var v_nro_comprobante = $v( "P238_NRO_COMPROBANTE" );
                    var v_id_recibo= $v("P238_ID_RECIBO");
                    var v_id_comprobante=$v("P238_ID_COMPROBANTE");
                    var v_tip_comprobante=$v("P238_TIP_COMPROBANTE");
                    var v_ser_comprobante=$v('P238_SER_COMPROBANTE');
                    var v_moneda=$v("P238_ID_MONEDA");
                    var v_importe=$v('P238_IMPORTE');
                    //var v_importe_cambio=$v('P238_IMPORTE_CAMBIO');
                    var v_tip_cambio=$v('P238_TIP_CAMBIO');
                    var v_nro_cuota=$v('P238_NRO_CUOTA');
                    //console.log($newRecord);
                    
                    
                    if (v_id_comprobante){
                    $model.setValue($newRecord, "ID_COMPROBANTE", v_id_comprobante);
                    }else if(v_id_recibo){
                        $model.setValue($newRecord, "ID_RECIBO", v_id_recibo);
                          let  gridView = apex.region("Comprobantes").call("getViews").grid;
                        gridView.view$.grid("hideColumn", "ID_COMPROBANTE");
                         gridView.view$.grid("showColumn", "ID_RECIBO");
                    }
                    
                    $model.setValue($newRecord, "NRO_COMPROBANTE",v_nro_comprobante);
                    $model.setValue($newRecord, "TIP_COMPROBANTE",v_tip_comprobante);
                    $model.setValue($newRecord, "SER_COMPROBANTE",v_ser_comprobante);
                    $model.setValue($newRecord, "ID_MONEDA",v_moneda);
                    $model.setValue($newRecord, "IMPORTECAMBIO",v_importe);
                    $model.setValue($newRecord, "TOT_COMPROBANTE",v_importe);
                    $model.setValue($newRecord, "TIP_CAMBIO",v_tip_cambio);
                    $model.setValue($newRecord, "NRO_CUOTA",v_nro_cuota);
                    $s("P238_TOT_NRO_MOV_CAJ",v_importe);
                    //console.log(v_moneda);
                    //apex.item( "LISTA_COMPROBANTES" ).setValue(6320,3,false);
                    //FOS.utils.popupLOV.item('ID_COMPROBANTE').setValueByReturn(v_id_saldo);
                    try{
                    
                    
                    if($model.isChanged()){
                        try{
                        $grid.gotoCell(newRecordId,'TIP_COMPROBANTE');
                        $grid.setEditMode(true);
                         }catch(err){
                             //console.error("Error es"+err);
                         }
                    }
                    }catch(err){
                     //console.log("Erroe es"+err);
                    }
                    ```
            }
            execution {
                sequence: 40
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                    BEGIN
                    IF :P238_ID_COMPROBANTE IS NOT NULL THEN
                    SELECT NRO_COMPROBANTE   
                    INTO v_nro_comprobante 
                    FROM VTW_COMPROBANTES_CABECERA 
                    WHERE ID=:P238_ID_COMPROBANTE;
                    return v_nro_comprobante;
                    elsif :P238_ID_RECIBO IS NOT NULL THEN
                    SELECT NRO_RECIBO
                    INTO v_nro_comprobante 
                    FROM CCW_RECIBOS
                    WHERE ID=:P238_ID_RECIBO;
                    RETURN V_NRO_COMPROBANTE; 
                    END IF;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RETURN NULL;
                    WHEN OTHERS THEN 
                    RETURN NULL;
                    END;
                    ```
                itemsToSubmit: [
                    P238_ID_COMPROBANTE
                    P238_ID_RECIBO
                ]
            }
            affectedElements {
                selectionType: items
                items: P238_NRO_COMPROBANTE
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nro_cuota CCW_SALDOS.NRO_CUOTA%TYPE;
                    BEGIN
                    IF :P238_ID_COMPROBANTE IS NOT NULL THEN 
                    SELECT NRO_CUOTA  
                    INTO V_NRO_CUOTA 
                    FROM CCW_SALDOS 
                    WHERE ID_COMPROBANTE=:P238_ID_COMPROBANTE;
                    RETURN v_nro_cuota;
                    ELSIF :P238_ID_RECIBO IS NOT NULL THEN 
                    SELECT NRO_CUOTA 
                    into V_NRO_CUOTA
                    FROM 
                    CCW_DETALLE_RECIBOS
                    WHERE ID_RECIBO=:P238_ID_RECIBO;
                    RETURN v_nro_cuota; 
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN 
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    END;
                    ```
                itemsToSubmit: [
                    P238_ID_COMPROBANTE
                    P238_ID_RECIBO
                ]
            }
            affectedElements {
                selectionType: items
                items: P238_NRO_CUOTA
            }
            execution {
                sequence: 30
            }
        )

    )

