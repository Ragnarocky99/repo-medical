    dynamicAction setear-id-comprobante (
        name: Setear ID Comprobante
        execution {
            sequence: 300
        }
        when {
            selectionType: columns
            interactiveGrid: @comprobantes
            columns: ID_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: DBMS_LOCK.sleep(seconds => 0.1);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    If :BANDERA_TIP_COMPROBANTE IS NOT NULL THEN 
                    DECLARE
                    V_ID_COMPROBANTE NUMBER(10);
                    
                    
                    BEGIN
                    IF :BANDERA_TIP_COMPROBANTE='CP' THEN
                    SELECT ID_COMPROBANTE
                    INTO :ID_COMPROBANTE_CPW
                    FROM CPW_CUOTAS
                    WHERE ID=:ID_COMPROBANTE;
                    --:ID_COMPROBANTE_CPW:=:ID_COMPROBANTE;
                    :ID_COMPROBANTE_CM:=NULL;
                    ELSIF 
                    :BANDERA_TIP_COMPROBANTE='CM' THEN 
                    SELECT ID_COMPROBANTE_CM
                    INTO :ID_COMPROBANTE_CM
                    FROM CPW_CUOTAS
                    WHERE ID=:ID_COMPROBANTE;
                    --:ID_COMPROBANTE_CM:=:ID_COMPROBANTE;
                    :ID_COMPROBANTE_CPW:=NULL;
                    END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al setear el comprobante'||:BANDERA_TIP_COMPROBANTE);
                    END;
                    END IF;
                    
                    
                    
                    ```
                itemsToSubmit: [
                    BANDERA_TIP_COMPROBANTE
                    ID_COMPROBANTE
                ]
                itemsToReturn: [
                    ID_COMPROBANTE_CPW
                    ID_COMPROBANTE_CM
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

