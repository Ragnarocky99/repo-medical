    region comprobantes (
        name: Comprobantes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DC.ID,
                       DC.ID_EMPRESA,
                       DC.ID_MOV_CAJ_CPW,
                       DC.ID_COMPROBANTE_CPW,
                       DC.ID_PROVEEDOR,
                       DC.NUM_CUOTA,
                       DC.TOT_PAGADO,
                       DC.ID_MONEDA,
                       DC.TIP_CAMBIO,
                       DC.COD_USUARIO_AUD,
                       DC.TOT_VALORIZADO,
                       DC.ID_CUOTA,
                       DC.ID_COMPROBANTE_CM,
                       DC.ID_ORDEN_PAGO,
                       CASE  
                       WHEN CM.NRO_COMPROBANTE IS NOT NULL THEN CM.NRO_COMPROBANTE
                       WHEN CP.NUM_COMPROBANTE IS NOT NULL THEN CP.NUM_COMPROBANTE
                       END AS NRO_COMPROBANTE,
                       CASE 
                       WHEN CM.TIP_COMPROBANTE IS NOT NULL THEN CM.TIP_COMPROBANTE 
                       WHEN CP.TIP_COMPROBANTE IS NOT NULL THEN CP.TIP_COMPROBANTE  
                       END AS TIP_COMPROBANTE
                     
                  from CPW_DETALLE_CAJAS DC,
                       CPW_CUOTAS CU,
                       CMW_COMPRAS_CABECERA CM,
                       CPW_COMPROBANTES_CABECERA CP
                 where DC.ID_MOV_CAJ_CPW=:P238_ID
                  and  DC.ID_CUOTA = CU.ID(+) -- se anhadio el (+) 26/12/2304
                  and CU.ID_COMPROBANTE_CM=CM.ID(+)
                 AND  CU.ID_COMPROBANTE=CP.ID(+)
                ```
            pageItemsToSubmit: P238_ID
        }
