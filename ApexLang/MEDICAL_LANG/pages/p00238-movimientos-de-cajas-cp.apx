        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    v_tot_comprobante VTW_COMPROBANTES_CABECERA.TOT_COMPROBANTE%TYPE;
                    BEGIN
                    SELECT TOT_COMPROBANTE
                    into v_tot_comprobante
                    FROM CMW_COMPRAS_CABECERA
                    where id=:id_comprobante_CM;
                    return v_tot_comprobante;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el total del comprobante');
                    return 0;
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error a nivel de sql'||sqlerrm);
                    return 0;
