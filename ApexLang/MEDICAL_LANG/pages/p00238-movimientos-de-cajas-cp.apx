                 var v_importe_comprobantes = model.getFieldKey("TOT_VALORIZADO");
                 var v_tip_comprobantes=model.getFieldKey('TIP_COMPROBANTE');
                 var v_tip_documento=model2.getFieldKey('TIP_DOCUMENTO');
                 var bandera=0; //Bandera para saber si esta realizando un cobro que no sea efectivo;
                 var bandera_notacre=0; //Bandera para saber si es una nota de credito
                 var v_tip_cambio = $v('P238_TIP_CAMBIO');
            
                    //Realizo un bucle para sumar los totales de los comprobantes
              model.forEach(function(r, index, id) { //Bucle para recorrer la grilla de comprobantes
            
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                        if(r[v_tip_comprobantes]==v_tipo_notacre){
                            bandera_notacre=1;
                        }
                         
                                     
                        let total_cmp = /*parseFloat(*/r[v_importe_comprobantes]./*replace(',','.')*/replace(/\./g,'') ;
                         
                    
            
            
              total_comprobantes      = total_comprobantes     + parseFloat(total_cmp.replace(',','.')); //Se obtiene el total de los comprobantes
                        
                        
                    }
                    
                });
               
            
                   
            
             //Realizo un bucle para sumar los totales de las formas de cobro
              model2.forEach(function(r, index, id) {
            
                  
                    var meta = model2.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                         
                       
                  
                     
                    let valorAuxiliar = r[v_importe].replace(/\./g,''); 
            
                    if (Number.isNaN(valorAuxiliar)){
                        parse=0;
                    }
            
                    if(r[v_tip_documento]!=efectivo_cobro){
                        bandera=1;
                    }
            
            
                        total_cobros     = total_cobros     + parseFloat(valorAuxiliar.replace(',','.'));
                        
            
                        
                    }
                    
                });
            
                
            
                //   console.log('Cobros es :'+total_cobros);
              //     console.log('Comprobantes es:'+total_comprobantes);
            
            
            var total_comprobantes = $v('P238_TOT_NRO_MOV_CAJ');
            
            let valorAuxiliar = total_comprobantes.toString().replace(/\./g,'');
             
             console.log('tot: ' + valorAuxiliar);
            
            total_comprobantes= parseFloat(valorAuxiliar.toString().replace(',','.')/*.replace(',','.')*/);
            
            //console.log("Resta es "+(test-total_cobros));
            
            total_a_pagar=total_comprobantes-total_cobros;
            if(bandera_notacre==1){
             total_a_pagar=total_comprobantes;
            $s("P238_TOTAL_A_COBRAR",total_a_pagar.toString().replace('.',',')/*replace(/\./g,',')*/);
