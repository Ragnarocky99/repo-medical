page 79 (
    name: Parametros Generales
    alias: BSPAREME
    title: Parametros Generales - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region parámetros-generales (
        name: Parámetros Generales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.ID,
                       P.PARAMETRO,
                       P.ID_MODULO,
                       P.DESCRIPCION,
                       P.VALOR,
                       P.COD_USUARIO_AUD
                  from BSW_PARAMETROS_GENERALES P,
                       BSW_MODULOS M
                  where (p.parametro like '%' ||UPPER(:P79_PARAMETRO)|| '%' or UPPER(:P79_PARAMETRO) is null)
                    and (p.id_modulo = :P79_MODULO or :P79_MODULO is null)
                    and (UPPER(p.descripcion) like '%' ||UPPER(:P79_DESCRIPCION)|| '%' or UPPER(:P79_DESCRIPCION) is null)
                    and m.id = p.id_modulo
                  order by m.descripcion asc, parametro asc
                  
                ```
            pageItemsToSubmit: [
                P79_PARAMETRO
                P79_MODULO
                P79_DESCRIPCION
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 80
                items: {
                    P80_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            includeActionsMenu: false
        }
        advanced {
            savedReportMappingIdentifier: 10744239145915800
        }

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cód. Usuario Aud.
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_MODULO (
            type: plainTextBasedOnLov
            heading {
                heading: Módulo
                alignment: center
            }
            lov {
                lov: @lv-modulos
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column PARAMETRO (
            type: plainText
            heading {
                heading: Parámetro
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 107498 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ID_MODULO (
                sequence: 2
            )

            displayColumn PARAMETRO (
                sequence: 1
            )

            displayColumn VALOR (
                sequence: 4
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P79_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P79_MODULO (
        type: popupLov
        label {
            label: <p>Modulo:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-modulos
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: null
        }
    )

    pageItem P79_PARAMETRO (
        type: textField
        label {
            label: <p>Parámetro:</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button b79-buscar (
        buttonName: B79_BUSCAR
        label: Buscar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button b79-limpiar (
        buttonName: B79_LIMPIAR
        label: Limpiar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @parámetros-generales
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                clearCache: 80
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @parámetros-generales
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @parámetros-generales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtrar (
        name: FILTRAR
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @b79-buscar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @parámetros-generales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction limpiar (
        name: LIMPIAR
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @b79-limpiar
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P79_PARAMETRO
                    P79_MODULO
                    P79_DESCRIPCION
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @parámetros-generales
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction onchange-filter (
        name: ONCHANGE_FILTER
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P79_PARAMETRO
                P79_MODULO
                P79_DESCRIPCION
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @parámetros-generales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17324995488363650
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

