page 125 (
    name: Usuarios Sucursales
    alias: USUARIOS-SUCURSALES
    title: Usuarios Sucursales - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline: "#IR td[headers=NOMBRE]{min-width:1000px}"
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region usuarios-sucursales (
        name: Usuarios Sucursales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT US_SUC.ID,
                       US_SUC.ID_EMPRESA,
                       US_SUC.ID_USUARIO,
                       US_SUC.ID_SUCURSAL,
                       US_SUC.POR_DEFECTO,
                       CASE US_SUC.POR_DEFECTO 
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END DEFECTO_ICON, 
                       
                       US.COD_USUARIO,
                
                       P.NOMBRE,
                
                       SUC.COD_SUCURSAL,
                       SUC.DESCRIPCION DESC_SUCURSAL
                
                  FROM BSW_USUARIOS_SUCURSALES US_SUC, BSW_USUARIOS US, BSW_PERSONAS P, 
                       BSW_SUCURSALES SUC
                       
                  WHERE US_SUC.ID_USUARIO = US.ID
                    AND US.ID_PERSONA = P.ID
                    AND US_SUC.ID_SUCURSAL = SUC.ID      
                    AND US_SUC.ID_EMPRESA = :P0_COD_EMPRESA
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: IR
        }
        link {
            linkColumn: customTarget
            target: {
                page: 126
                items: {
                    P126_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 15875365339956190
        }

        column COD_SUCURSAL (
            type: plainText
            heading {
                heading: Cód. Sucursal
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column COD_USUARIO (
            type: plainText
            heading {
                heading: Cód. Usuario
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DEFECTO_ICON (
            type: hidden
            heading {
                heading: Defecto Icon
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESC_SUCURSAL (
            type: plainText
            heading {
                heading: Descripción Sucursal
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_SUCURSAL (
            type: hidden
            heading {
                heading: Id Sucursal
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_USUARIO (
            type: hidden
            heading {
                heading: Id Usuario
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column POR_DEFECTO (
            type: plainText
            heading {
                heading: Por Defecto
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #DEFECTO_ICON#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                USUARIOS SUCURSALES
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 158795 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_SUCURSAL (
                sequence: 3
            )

            displayColumn COD_USUARIO (
                sequence: 1
            )

            displayColumn DESC_SUCURSAL (
                sequence: 4
            )

            displayColumn NOMBRE (
                sequence: 2
            )

            displayColumn POR_DEFECTO (
                sequence: 5
            )

            sort (
                column: COD_USUARIO
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @usuarios-sucursales
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 126
                clearCache: 126
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @usuarios-sucursales
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @usuarios-sucursales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17354439586465962
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

