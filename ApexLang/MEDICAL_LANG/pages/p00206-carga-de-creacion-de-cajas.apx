page 206 (
    name: Carga de Creacion de Cajas
    alias: CARGA-DE-CREACION-DE-CAJAS
    title: Carga de Creacion de Cajas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            //document.getElementById("P206_FEC_ALTA").readOnly = true;
            document.getElementById("P206_ALTA_POR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-creacion-de-cajas (
        name: Carga de Creacion de Cajas
        type: form
        source {
            location: localDatabase
            tableName: CCW_CAJAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P206_ALTA_POR (
        type: textField
        label {
            label: <p>Alta Por:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 150
        }
        advanced {
            cssClasses: cambio
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: ALTA_POR
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P206_CIERRA_SIN_PENDIENTES (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-creacion-de-cajas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: CIERRA_SIN_PENDIENTES
            dataType: varchar2
        }
    )

    pageItem P206_COD_CAJA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Caja:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: COD_CAJA
            dataType: varchar2
        }
    )

    pageItem P206_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-creacion-de-cajas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P206_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P206_ESTADO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 60
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: ESTADO
            dataType: varchar2
        }
    )

    pageItem P206_FEC_ALTA (
        type: datePicker
        label {
            label: <p>Fecha Alta:</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            cssClasses: cambio
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: FEC_ALTA
            dataType: date
        }
        default {
            type: functionBody
            plsqlFunctionBody: return to_char(sysdate, 'dd-Mon-yyyy');
        }
        readOnly {
            type: itemIsNotNull
            item: P206_FEC_ALTA
        }
    )

    pageItem P206_ID (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-creacion-de-cajas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: CCW_CAJAS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P206_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 80
            region: @carga-de-creacion-de-cajas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P206_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 100
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: ID_SUCURSAL
            dataType: number
        }
    )

    pageItem P206_ID_USUARIO_ASIG (
        type: popupLov
        label {
            label: <p>Usuario Asig.:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-usuarios
        }
        layout {
            sequence: 50
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: ID_USUARIO_ASIG
            dataType: number
        }
    )

    pageItem P206_IP_POS (
        type: textField
        label {
            label: <p>IP Pos: </p>
            alignment: left
        }
        layout {
            sequence: 120
            region: @carga-de-creacion-de-cajas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @carga-de-creacion-de-cajas
            column: IP_POS
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P206_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P206_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P206_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 24872973300282504
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-creacion-de-cajas (
        name: Initialize form Carga de Creacion de Cajas
        type: formInitialization
        formRegion: @carga-de-creacion-de-cajas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 24872108289282504
        }
    )

    process process-form-carga-de-creacion-de-cajas (
        name: Process form Carga de Creacion de Cajas
        type: formAutoRowProcessing
        formRegion: @carga-de-creacion-de-cajas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24872510942282504
        }
    )

)

