page 152 (
    name: Carga de Subtipos de Transacciones
    alias: CARGA-DE-SUBTIPOS-DE-TRANSACCIONES
    title: Carga de Subtipos de Transacciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-subtipos-de-transacciones (
        name: Carga de Subtipos de Transacciones
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_MODULO,
                       ID_TIPO_TRANS,
                       SUBTIPO_TRANS,
                       DESCRIPCION,
                       USA_DINERO,
                       CONCEPTO,
                       CARGA_VALORES,
                       VERIFICA_VALORES,
                       ID_CUENTA,
                       COD_USUARIO_AUD,
                       AFECTA_IMPONIBLE,
                       ID_AGRUPACION,
                       TIP_DOCUMENTO,
                       CARGA_DEPOSITO,
                       CARGA_OTROS,
                       AFECTA_IVA,
                       AFECTA_RENTA,
                       GASTO_DESPACHO,
                       ABREVIATURA,
                       AFECTA_ASIENTO,
                       TIPO,
                       USA_CUENTA_PROV,
                       IND_FORMA_COBRO,
                       IND_AUTORIZADO,
                       IND_ES_TARJETA_CREDITO,
                       ACTIVO,
                       TIPO_MOVIMIENTO,
                       IND_POS,
                       IND_BILLETERA,
                       ID_CONCEPTO_COMPRA,
                       IND_AFECTA_FLUJO
                  from BSW_SUBTIPOS_TRANS
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

