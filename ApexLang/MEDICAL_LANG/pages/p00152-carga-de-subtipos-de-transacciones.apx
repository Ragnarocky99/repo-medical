                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 150
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @tipo-trans
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P152_ID_TIPO_TRANS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation tarjeta-credito-y-billetera (
        name: Tarjeta Credito y Billetera
        execution {
            sequence: 10
        }
        validation {
            type: plsqlError
            plsqlCodeRaisingError:
                ```plsql
                begin
                IF :P152_IND_ES_TARJETA_CREDITO='S' AND :P152_IND_BILLETERA='S' THEN
                RAISE_APPLICATION_ERROR(-20000,'No se puede marcar tarjeta de credito y billetera la vez');
                END IF;
                end;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: No puede ser billetera y Tarjeta de Credito a la vez!!
            displayLocation: onErrorPage
            associatedItem: @P152_IND_ES_TARJETA_CREDITO
        }
    )

