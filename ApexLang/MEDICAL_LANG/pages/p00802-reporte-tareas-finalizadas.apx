page 802 (
    name: Reporte Tareas Finalizadas
    alias: REPORTE-TAREAS-FINALIZADAS
    title: Reporte Tareas Finalizadas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region reporte-tareas-finalizadas (
        name: Reporte Tareas Finalizadas
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLWV_TAREAS_FINALIZADAS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FEC_FINALIZADO BETWEEN :P802_FEC_INI AND :P802_FEC_FIN
                ```
            pageItemsToSubmit: [
                P802_FEC_INI
                P802_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 60683702384388251
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREADO_POR (
            type: plainText
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DEFINICION (
            type: plainText
            heading {
                heading: Definicion
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESC_ARTICULO (
            type: plainText
            heading {
                heading: Articulo
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column FEC_FINALIZADO (
            type: plainText
            heading {
                heading: Fec. Finalizado
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: dd/MM/yyyy HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column FEC_PROX_EVENTO (
            type: plainText
            heading {
                heading: Fec. Prox. Evento
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            appearance {
                formatMask: dd/MM/yyyy HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 21
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro. PED/LIC
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column NRO_ITEM (
            type: plainText
            heading {
                heading: Nro. Item
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column OBSERVACION (
            type: plainText
            heading {
                heading: Observacion
                alignment: center
            }
            layout {
                sequence: 31
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column RESPONSABLE (
            type: plainText
            heading {
                heading: Responsable
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reporte Tareas Finalizadas
        }

        savedReport 606885 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLIENTE (
                sequence: 6
            )

            displayColumn COD_ARTICULO (
                sequence: 8
            )

            displayColumn CREADO_POR (
                sequence: 12
            )

            displayColumn DEFINICION (
                sequence: 3
            )

            displayColumn DESC_ARTICULO (
                sequence: 9
            )

            displayColumn FEC_FINALIZADO (
                sequence: 11
            )

            displayColumn FEC_PROX_EVENTO (
                sequence: 2
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 5
            )

            displayColumn NRO_ITEM (
                sequence: 7
            )

            displayColumn OBSERVACION (
                sequence: 10
            )

            displayColumn RESPONSABLE (
                sequence: 1
            )

            displayColumn TIPO (
                sequence: 4
            )

        )

    )

    pageItem P802_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P802_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo Finalizacion:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction actualizar-reporte (
        name: Actualizar Reporte
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-tareas-finalizadas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction paginacion (
        name: Paginacion
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @reporte-tareas-finalizadas
            }
            execution {
                sequence: 10
            }
        )

    )

)

