            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region gestion-ocp-renovado (
        name: Gestion OCP Renovado
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CMWV_GESTION_OCP
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                CANT_PENDIENTE > 0 AND
                DISPONIBILIDAD < 0 AND
                CANTIDAD > CANTIDAD_EN_OCP AND
                CANT_PENDIENTE_A_ENTREGAR > CANT_OCP_MAS_STOCK AND
                (FEC_COMPROBANTE BETWEEN :P772_FEC_INI AND :P772_FEC_FIN OR :P772_FEC_INI IS NULL OR :P772_FEC_FIN IS NULL) AND
                (NRO_PEDIDO = :P772_NRO_PEDIDO OR :P772_NRO_PEDIDO IS NULL) AND
                (COD_ARTICULO = :P772_COD_ARTICULO OR :P772_COD_ARTICULO IS NULL) AND
                (ID_ARTICULO = :P772_ID_ARTICULO OR :P772_ID_ARTICULO IS NULL) AND
                (ID_PROVEEDOR = :P772_ID_PROVEEDOR OR :P772_ID_PROVEEDOR IS NULL) AND
                IND_NO_MOSTRAR = :P772_IND_NO_MOSTRAR
                ```
            pageItemsToSubmit: [
                P772_FEC_INI
                P772_FEC_FIN
                P772_COD_ARTICULO
                P772_NRO_PEDIDO
                P772_ID_ARTICULO
                P772_ID_PROVEEDOR
                P772_IND_NO_MOSTRAR
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 35835747951728342
        }

