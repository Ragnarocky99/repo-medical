            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit (
        name: Edit
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P623_ID
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 624
                    items: {
                        P624_ID: &P623_ID.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: P623_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
