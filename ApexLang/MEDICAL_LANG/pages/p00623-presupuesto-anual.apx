            sequence: 10
            region: @presupuesto-anual
            slot: regionBody
        }
    )

    button reporte (
        buttonName: REPORTE
        label: Reporte
        layout {
            sequence: 30
            region: @presupuesto-anual
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 620
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction agregar-botones (
        name: Agregar Botones
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action boton-crear (
            name: Boton Crear
            action: plugin/fosInteractiveGridAddButton
            settings {
                alignment: first
                label: Crear
                icon: fa-plus
                onClick: triggerEvent
                eventName: crear
                extraOptions: toolbarOnlyHot
            }
            affectedElements {
                selectionType: region
                region: @presupuesto-anual
            }
            execution {
                sequence: 10
            }
        )

        action boton-excel (
            name: Boton Excel
            action: plugin/fosInteractiveGridAddButton
            settings {
                alignment: first
                label: Excel
                icon: fa-file-excel-o
                onClick: triggerEvent
                eventName: excel
                extraOptions: toolbarOnlyHot
            }
            affectedElements {
                selectionType: region
                region: @presupuesto-anual
            }
            execution {
                sequence: 20
            }
        )

        action menu-ver (
            name: Menu - Ver
            action: plugin/fosInteractiveGridAddButton
            settings {
                addButtonTo: menuRowActions
                label: Ver
                icon: fa-eye
                onClick: returnPrimaryKeySIntoItem
                pageItem: P623_ID
            }
            affectedElements {
                selectionType: region
                region: @presupuesto-anual
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction crear (
        name: Crear
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: crear
            selectionType: region
            region: @presupuesto-anual
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
