page 451 (
    name: Reporte de liquidacion de saldo
    alias: REPORTE-DE-LIQUIDACION-DE-SALDO
    title: Reporte de liquidacion de saldo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P451_ANIO (
        type: textField
        label {
            label: Anio
            alignment: left
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_CATEGORIA (
        type: textField
        label {
            label: Categoria
            alignment: left
        }
        layout {
            sequence: 110
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_COD_USUARIO (
        type: textField
        label {
            label: Cod Usuario
            alignment: left
        }
        layout {
            sequence: 150
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P451_DEPARTAMENTO (
        type: textField
        label {
            label: Departamento
            alignment: left
        }
        layout {
