        }
        layout {
            sequence: 120
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_PLANILLA (
        type: textField
        label {
            label: Planilla
            alignment: left
        }
        layout {
            sequence: 90
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_SECCION (
        type: textField
        label {
            label: Seccion
            alignment: left
