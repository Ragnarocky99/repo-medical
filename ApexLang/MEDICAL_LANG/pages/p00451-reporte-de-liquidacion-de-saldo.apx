            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');--'http://localhost:8090/jri/report';
                        BEGIN
                        --  RAISE_APPLICATION_ERROR(-20000,:P442_MES||'-'||:P442_ANIO);
                          xlog (l_proc, 'url (orig):' || l_report_url);
                
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('Planilla_sueldo'),
                                  p_rep_format          => apex_util.url_encode('pdf'),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                	              p_additional_params   =>  ('p_id_empresa='||:P0_ID_EMPRESA||'&'||'p_mes='||:P451_MES||'&'||'p_anio='||:P451_ANIO||'&'||'p_id_empleado='||:P451_EMPLEADO||'&'||'p_id_sucursal='||:P451_SUCURSAL||'&'||'p_id_departamento='||:P451_DEPARTAMENTO
                                  ||'&'||'p_planilla='||:P451_PLANILLA||'&'||'p_id_seccion='||:P451_SECCION||'&'||'P_ESTADO_IPS='||:P451_ESTADO_IPS||'&'||'p_cod_tip_empleado='||:P451_CATEGORIA||'&'||'P_TIPO='||:P451_TIPO||'&'||'p_nro_liquid='||:P451_NRO_LIQUIDACION||'&'||'p_ser_liquid='||:P451_SER_LIQUIDACION||'&'||'P_USUARIO='||:APP_USER),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          
                          -- this was used before apex 4.1
                          --apex_application.g_unrecoverable_error := true;
                          apex_application.stop_apex_engine();
                
                        exception
                          when apex_application.e_stop_apex_engine then
                            null; -- ok, stop engine raises exception, we can ignore that
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
    )

)

