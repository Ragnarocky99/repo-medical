        }
        layout {
            sequence: 140
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_ESTADO_IPS (
        type: textField
        label {
            label: Estado Ips
            alignment: left
        }
        layout {
            sequence: 100
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_MES (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 40
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P451_NRO_LIQUIDACION (
        type: textField
