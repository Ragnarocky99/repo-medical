    dynamicAction set-grid-json (
        name: SET_GRID_JSON
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: P84_ID_NOTAS_ENVIO_SOL_REF
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    
                      v_tipo_trans     number;
                      v_subtipo_trans  number;
                      v_modulo         number;
                      v_tip_cambio_cab decimal;
                    
                    BEGIN
                        v_tip_cambio_cab := :P341_TIP_CAMBIO;
                        v_modulo     := trae_modulo_id('CC');
                        v_tipo_trans := trae_id_tipos_trans(:P0_ID_EMPRESA,v_modulo,w_busca_parametro('CC','TIPO_TRANS_CC'));
                        v_subtipo_trans := TRAE_SUBTIPOS_TRANS_ID(:P0_ID_EMPRESA,v_modulo,v_tipo_trans,w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS'));
                    
                    
                        OPEN l_cursor FOR
                            select v_tipo_trans as id_tipo_tras,
                                   v_subtipo_trans as id_sub_tipo_trans, --c.id_subtipo_trans,
                                   c.tip_documento, 
                                   c.ser_documento, 
                                   c.nro_valor, 
                                   replace(to_char(c.FEC_VENCIMIENTO, 'DD/MM/YYYY'), '\','') FEC_VENCIMIENTO,
                                   c.id_per_juridica, 
                                   c.id_moneda,
                                   m.tipo_cambio_dia,
                                   c.id_cuenta_bancaria,
                                   SUM(c.monto_valor) monto_valor,
                                   SUM((c.monto_valor * FTIPOS_CAMBIO(m.id,SYSDATE,'C','F')) / v_tip_cambio_cab) MONTO_NETO, --cálculo astral - no tocar
                                   decode( :P341_INCLUYE, '1', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS	'),
                                                          '2', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS	'),
                                                          w_busca_parametro('CC','CHEQUE_DCHEQ_SUBTIPO_TRANS')) sub_tipo
                                       
                                   from ccw_valores c, bsw_personas j, bsw_monedas m
                    
                                   where 
                                     instr( 'PR',  c.estado_valor, 1, 1 ) > 0
                                     and nvl( c.fec_acobrar, c.fec_vencimiento ) <= :P341_FEC_COMPROBANTE
                                     and c.estado_valor='P'
                                     and ( :P341_INCLUYE is null
                                           or ( :P341_INCLUYE = '1' and c.tip_documento = w_busca_parametro('CC','TIP_DOCUMENTO_CHE')  and c.id_per_juridica =  :P341_ID_PER_JURIDICA )
                                           or ( :P341_INCLUYE = '2' and c.tip_documento = w_busca_parametro('CC','TIP_DOCUMENTO_CHE')  and c.id_per_juridica <> :P341_ID_PER_JURIDICA ) )
                                           
                                     and c.id_moneda       = :P341_ID_MONEDA
                                     and m.id = c.id_moneda
                                     and c.id_per_juridica = j.id
                                     and j.id_sector       = :P341_ID_SECTOR
                                     and ( c.saldo_valor is null or c.monto_valor = c.saldo_valor )
                    
                                     group by v_tipo_trans,
                                              v_subtipo_trans,--c.id_subtipo_trans, 
                                              c.tip_documento, 
                                              c.ser_documento, 
                                              c.nro_valor, 
                                              c.fec_vencimiento, 
                                              c.id_per_juridica, 
                                              c.id_moneda, 
                                              m.tipo_cambio_dia, 
                                              c.id_cuenta_bancaria,
                                              decode( :P341_INCLUYE,'1', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS'),
                                                                    '2', w_busca_parametro('CC','CHEQ_SUBTIPO_TRANS'))
                    
                                   order by c.id_per_juridica, c.nro_valor desc;
                                   
                            APEX_JSON.initialize_clob_output;
                    
                            APEX_JSON.open_object;
                            APEX_JSON.write('DETALLE', l_cursor);
                            APEX_JSON.close_object;
                    
                            JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                            :P341_JSON_DETALLES:=JSON_DETALLE;
                    END;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

