    dynamicAction setear-total (
        name: Setear total
        execution {
            sequence: 180
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: CANTIDAD
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detalles").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("CANTIDAD");
                    model.forEach(function(igrow) {
                        n_amt = parseInt(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P84_TOTALES").setValue(n_totamt);
                    ```
            }
            affectedElements {
                selectionType: items
                items: P84_TOTAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

