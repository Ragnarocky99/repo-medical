    process guardamos-los-detalles-en-una-coleccion (
        name: Guardamos los detalles en una coleccion
        type: executeCode
        editableRegion: @detalles
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VCOLECCION VARCHAR2(30) := 'NOTA_ENVIO_DET';
                BEGIN
                    IF APEX_COLLECTION.collection_member_count(VCOLECCION) = 0 THEN
                        APEX_COLLECTION.create_or_truncate_collection('NOTA_ENVIO_DET');
                    END IF;
                
                    IF :APEX$ROW_STATUS != 'D' THEN
                        APEX_COLLECTION.add_member(p_collection_name => VCOLECCION,
                                                   p_n001            => :ID_ARTICULO,
                                                   p_n002            => :ID_LOTE,
                                                   p_n003            => :CANTIDAD);
                    END IF;
                    
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 21701919240388226
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

