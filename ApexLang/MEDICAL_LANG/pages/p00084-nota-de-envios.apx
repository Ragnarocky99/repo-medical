            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: items
                items: [
                    P84_TOTAL
                    P84_TOTALES
                ]
            }
            execution {
                sequence: 10
            }
        )

