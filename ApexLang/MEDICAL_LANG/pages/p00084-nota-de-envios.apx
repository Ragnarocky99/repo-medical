        column ID_LOTE (
            type: selectList
            heading {
                heading: <p>Lote</p>
                alternativeLabel: Lote
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT L.NRO_LOTE,L.ID 
                      FROM STW_LOTES L,
                           STW_EXISTENCIA_ART E
                    WHERE E.ID_EMPRESA  = L.ID_EMPRESA
                      AND E.ID_ARTICULO = L.ID_ARTICULO
                      AND E.ID_LOTE     = L.ID
                      AND L.ID_ARTICULO = :ID_ARTICULO
                      AND E.ID_SUCURSAL = :P0_ID_SUCURSAL
                      AND E.CANT_DISPON > 0
                      AND :P84_ID IS NULL
                    UNION ALL
                    SELECT L.NRO_LOTE,L.ID 
                      FROM STW_LOTES L,
                           STW_EXISTENCIA_ART E
                    WHERE E.ID_EMPRESA  = L.ID_EMPRESA
                      AND E.ID_ARTICULO = L.ID_ARTICULO
                      AND E.ID_LOTE     = L.ID
                      AND L.ID_ARTICULO = :ID_ARTICULO
                      AND E.ID_SUCURSAL = :P0_ID_SUCURSAL
                      AND :P84_ID IS NOT NULL
                    ```
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: [
                    ID_ARTICULO
                    P84_ID
                ]
            }
            layout {
                sequence: 120
            }
            accessibility {
                valueIdentifiesRow: true
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_LOTE
                dataType: number
            }
            readOnly {
                type: itemIsNotNull
                item: P84_ID
                execute: forEachRow
            }
        )

