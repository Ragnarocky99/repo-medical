    validation validar-fec (
        name: Validar Fec
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                 v_mensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P84_FECHA) 
                       into v_mensaje
                    from dual;
                    return TRUE;
                  exception
                    when no_data_found then
                      v_mensaje := null;
                    when others then
                      v_mensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha fuera de rango
            associatedItem: @P84_FECHA
        }
    )

    validation verifica-si-hay-ubicacion-salida (
        name: Verifica si hay ubicacion salida
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @detalles
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                    l_existe varchar2(1);
                begin
                    begin
                        select 'S'
                          into l_existe
                          from stw_ubic_articulos
                         where id_articulo = :ID_ARTICULO
                           and id_lote     = :ID_LOTE
                           and id_sucursal = :P84_ID_SUCURSAL
                           and rownum = 1
                           and cantidad > 0;
                    exception
                        when others then
                            l_existe := 'N';
                    end;
                
                    if l_existe = 'S' and :ID_UBICACION_SAL is null then
                        return false;
                    end if;
                
                    return true;
                end;
                ```
        }
        error {
            errorMessage: Este articulo tiene ubicacion definida, debe indicar para realizar este envio
            associatedColumn: ID_UBICACION_SAL
        }
    )

    computation p84-nro-envio (
        itemName: P84_NRO_ENVIO
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_nro_envio STW_NOTAS_ENVIO_CAB.NRO_ENVIO%TYPE;
                BEGIN
                IF :P84_NRO_ENVIO IS  NULL THEN
                SELECT NVL(MAX(NRO_ENVIO),0)+1
                INTO v_nro_envio
                FROM
                STW_NOTAS_ENVIO_CAB 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P84_SER_ENVIO=SER_ENVIO;
                RETURN V_NRO_ENVIO;
                END IF;
                 RETURN :P84_NRO_ENVIO;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_ENVIO:=1;
                RETURN V_NRO_ENVIO;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
    )

