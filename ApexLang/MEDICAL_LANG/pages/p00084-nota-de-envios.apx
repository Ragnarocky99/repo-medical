    button marcar-todo (
        buttonName: MARCAR_TODO
        label: Marcar Todos
        layout {
            sequence: 10
            region: @detalles
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--simple
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
            databaseAction: update
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                VBANDERA NUMBER := 0;
                
                BEGIN
                    SELECT NVL((SELECT 1 FROM STW_NOTAS_ENVIO_CAB 
                    WHERE ID_SUCURSAL = :P84_ID_SUCURSAL AND ROWNUM = 1),0)
                    INTO VBANDERA
                    FROM DUAL;
                    :P84_BANDERA1 := VBANDERA;
                    IF :P84_ID_SUCURSAL = :P0_COD_SUCURSAL THEN
                        RETURN FALSE;
                        ELSE IF :P84_ID_SUCURSAL_ENT = :P0_COD_SUCURSAL THEN
                            RETURN TRUE;
                        END IF;
                    END IF;
                END;
                ```
        }
    )

