    region nota-de-envios (
        name: Nota de Envios
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_ENVIO,
                       NRO_ENVIO,
                       ID_SUCURSAL,
                       ID_SUCURSAL_ENT,
                       FECHA,
                       ESTADO,
                       IND_RECEPCION,
                       ID_USUARIO,
                       SER_ENVIO,
                       NO_DESC_STOCK,
                       DESC_SUCUR_ENT,
                       CI,
                       DIRECCION,
                       COD_DIRECCION,
                       COD_USUARIO_AUD,
                       IND_IMPRESO,
                       ID_AUT_RE_IMPRE_POR,
                       FEC_AUT_RE_IMPRE,
                       ID_CLIENTE,
                       OBSERVACION,
                       ID_EMPRESA_ENT,
                       ID_SUCURSAL_CENTRAL,
                       ID_SUCURSAL_ENT_CENTRAL,
                       REFERENCIA,
                       CANT_TOTAL,
                       ID_NOTAS_ENVIO_SOL_REF,
                       FEC_ALTA,
                       COD_USUARIO_MOD,
                       FEC_MODIFICACION
                  from STW_NOTAS_ENVIO_CAB a
                  where a.id_empresa = :P0_ID_EMPRESA
                  and   (a.id_sucursal= :P0_ID_SUCURSAL OR A.ID_SUCURSAL_ENT = :P0_ID_SUCURSAL)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region totales (
        name: Totales
        type: staticContent
        layout {
