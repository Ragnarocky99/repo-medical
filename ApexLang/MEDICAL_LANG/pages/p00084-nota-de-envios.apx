    dynamicAction validar-serie (
        name: Validar Serie
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P84_SER_ENVIO
        }
        serverSideCondition {
            type: never
        }

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró la serie
                style: warning
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P84_BANDERA
                value: 0
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera number:=0;
                    BEGIN 
                    IF :P84_SER_ENVIO IS NOT NULL THEN
                        SELECT NVL((SELECT 1 FROM BSW_SERIES_COMPROB WHERE ID_EMPRESA = :P0_COD_EMPRESA AND
                      --  TIP_COMPROBANTE = 'ENV' AND
                        SER_COMPROBANTE = :P84_SER_ENVIO),0) 
                        AS BANDERA 
                        INTO vbandera
                        FROM DUAL;
                        :P84_BANDERA := VBANDERA;        
                    end if;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(-20000,'No se encontro la serie'||:P84_BANDERA);
                    END;
                    ```
                itemsToSubmit: P84_SER_ENVIO
                itemsToReturn: P84_BANDERA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    validation controla-stock (
        name: controla_stock
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @detalles
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vcantidad number;
                BEGIN
                
                    if :id_articulo is not null and :id_lote is not null then
                      begin
                        select sum(cant_dispon)
                          into vcantidad
                        from stw_existencia_art 
                        where id_empresa = :P0_ID_EMPRESA
                          and id_sucursal = :P0_ID_SUCURSAL
                          and id_articulo = :id_articulo
                          and id_lote = :id_lote;
                      exception
                        when no_data_found then
                          vcantidad := 0;
                        when others then
                          vcantidad := 0;
                          raise_application_error(-20000,'Error al buscar existencia '||sqlerrm);
                      end;
                      if nvl(vcantidad,0) < nvl(to_number(:cantidad),0) then
                        return FALSE;
                      else
                        return TRUE;
                      end if;
                    else
                      return TRUE;
                    end if;
                end;
                ```
        }
        error {
            errorMessage: #COLUMN_HEADER# cantidad &CANTIDAD. supera al stock disponible del lote en la sucursal.
            associatedColumn: ID_LOTE
        }
        serverSideCondition {
            whenButtonPressed: @create
            executionScope: allSubmittedRows
            type: never
        }
    )

    validation controlar-stock (
        name: Controlar Stock
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @detalles
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    VCANTIDAD     NUMBER;
                    VSTOCK        NUMBER;
                    VCOLECCION    VARCHAR2(30) := 'NOTA_ENVIO_DET';
                    VCOD_ARTICULO STW_ARTICULOS.COD_ARTICULO%TYPE;
                BEGIN
                    BEGIN
                        SELECT COD_ARTICULO
                          INTO VCOD_ARTICULO
                          FROM STW_ARTICULOS
                         WHERE ID = :ID_ARTICULO;
                    EXCEPTION
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, 'Error buscando el articulo con ID '||:ID_ARTICULO);
                    END;
                    BEGIN
                        SELECT SUM(N003)
                          INTO VCANTIDAD
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = VCOLECCION
                           AND N001            = :ID_ARTICULO
                           AND N002            = :ID_LOTE;
                    EXCEPTION
                        WHEN OTHERS THEN
                            VCANTIDAD := 0;
                    END;
                
                    BEGIN
                        SELECT SUM(NVL(CANT_DISPON, 0))
                          INTO VSTOCK
                          FROM STW_EXISTENCIA_ART
                         WHERE ID_ARTICULO = :ID_ARTICULO
                           AND ID_LOTE     = :ID_LOTE
                           AND ID_SUCURSAL = :P84_ID_SUCURSAL;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            VSTOCK := 0;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, 'Error recuperando el stock del articulo '||VCOD_ARTICULO);
                    END;
                    
                    IF APEX_COLLECTION.collection_member_count(VCOLECCION) > 0 THEN
                        APEX_COLLECTION.delete_collection(VCOLECCION);
                    END IF; 
                    
                    IF VCANTIDAD > VSTOCK THEN
                        IF (NVL(:IND_RECEPCION, 'N') != 'S' AND :APEX$ROW_STATUS = 'C') OR :APEX$ROW_STATUS = 'C' THEN
                            RAISE_APPLICATION_ERROR(-20000, 'La cantidad del articulo '||VCOD_ARTICULO||' supera al stock del sistema. Cantidad '||VCANTIDAD||' Stock '||VSTOCK);
                        END IF;
                    END IF;
                
                    RETURN NULL;
                    
                END;
                ```
        }
        error {
            associatedColumn: COD_ARTICULO
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

