    region detalles (
        name: detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.TIP_ENVIO,
                       D.ID_NRO_ENVIO_CAB,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.CANTIDAD AS CANTIDAD_COPIA,
                       D.IND_RECEPCION,
                       D.SER_ENVIO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.ID_LOTE,
                       D.CANT_FAC,
                       D.DESC_ARTICULO,
                       D.ID_BARRA,
                       A.Cod_Origen_Art as Cod_Fabricante,
                       (select M.Descripcion from stw_marcas M where A.Id_Marca = M.Id) as Marca,
                       E.Descripcion as Presentacion,
                       L.Fec_Vencimiento,
                       (select nro_estante from stw_existencia_art ea where ea.id_articulo = d.id_articulo and ea.id_lote = d.id_lote and ea.id_sucursal = c.id_sucursal) nro_estante,
                       (select nro_fila from stw_existencia_art ea where ea.id_articulo = d.id_articulo and ea.id_lote = d.id_lote and ea.id_sucursal = c.id_sucursal) nro_fila,
                       D.ID_UBICACION_SAL
                      -- D.ID_UBICACION_ENT
                  from STW_NOTAS_ENVIO_CAB C, STW_NOTAS_ENVIO_DET D, STW_ARTICULOS A, STW_ENVASES E, STW_LOTES L
                 where c.id = d.id_nro_envio_cab
                   and c.nro_envio = :P84_NRO_ENVIO
                   AND d.id_empresa = :P0_ID_EMPRESA 
                   and D.id_nro_envio_cab = :P84_ID
                   AND A.ID = D.ID_ARTICULO
                   and A.Id_Envase = E.ID
                   and D.ID_LOTE = L.ID
                
                ```
            pageItemsToSubmit: [
                P84_ID
                P0_ID_EMPRESA
                P84_NRO_ENVIO
            ]
        }
