    process nota-de-envios-det-save-interactive-grid-data (
        name: Nota de Envios Det - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                                insert into STW_NOTAS_ENVIO_DET
                                (ID_EMPRESA,TIP_ENVIO,ID_NRO_ENVIO_CAB, ID_ARTICULO, DESC_ARTICULO, CANTIDAD, ID_UNIDAD_MEDIDA, 
                                NRO_LOTE, ID_LOTE, IND_RECEPCION,SER_ENVIO, ID_BARRA, ID_UBICACION_SAL)
                                values(:P0_COD_EMPRESA, :P84_TIP_ENVIO, :P84_ID, :ID_ARTICULO, :DESC_ARTICULO, :CANTIDAD, :ID_UNIDAD_MEDIDA,
                                :NRO_LOTE, :ID_LOTE, :IND_RECEPCION, :P84_SER_ENVIO, :ID_BARRA, :ID_UBICACION_SAL);
                            
                            WHEN 'U' then 
                   
                                update STW_NOTAS_ENVIO_DET  d
                                    set D.ID_ARTICULO = :ID_ARTICULO,
                                        D.CANTIDAD       = :CANTIDAD,
                                        D.ID_UNIDAD_MEDIDA     = :ID_UNIDAD_MEDIDA,
                                        D.NRO_LOTE        = :NRO_LOTE,
                                        D.IND_RECEPCION       = :IND_RECEPCION,
                                        D.ID_BARRA = :ID_BARRA,
                                        D.ID_LOTE = :ID_LOTE,
                                        D.ID_UBICACION_SAL = :ID_UBICACION_SAL
                                       
                
                                        
                                where   ID_NRO_ENVIO_CAB = :P84_ID
                                    and d.id = :id;
                             
                            when 'D' then
                                delete STW_NOTAS_ENVIO_DET d     
                                WHERE d.ID_NRO_ENVIO_CAB = :P84_ID
                                           and d.id = :id;  
                    end case;
                    
                                         
                
                END;
                
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Operación correcta
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 5105091348330820
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE,DELETE
        }
    )

)

