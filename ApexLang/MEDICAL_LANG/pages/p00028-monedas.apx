page 28 (
    name: Monedas
    alias: MONEDAS
    title: Monedas - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region monedas (
        name: Monedas
        type: interactiveReport
        source {
            location: localDatabase
            tableName: BSW_MONEDAS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 29
                items: {
                    P29_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 9889179980045595
        }

        column COD_MONEDA (
            type: plainText
            heading {
                heading: Cód. Moneda
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column DECIMALES (
            type: plainText
            heading {
                heading: Decimales
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column FEC_TIPO_CAMBIO (
            type: plainText
            heading {
                heading: Fecha Tipo Cambio
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 130
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_PAIS (
            type: plainTextBasedOnLov
            heading {
                heading: País
            }
            lov {
                lov: @lv-paises
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ROWID (
            type: hidden
            heading {
                heading: ROWID
            }
            layout {
                sequence: 120
            }
            source {
                dataType: OTHER
            }
            advanced {
                endUserAlias: A
            }
        )

        column SIGLAS (
            type: plainText
            heading {
                heading: Siglas
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SIGLAS_TESAKA (
            type: plainText
            heading {
                heading: Siglas Tesaka
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column TIPO_CAMBIO (
            type: plainText
            heading {
                heading: Tipo Cambio
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column TIPO_CAMBIO_COMPRA (
            type: plainText
            heading {
                heading: Tipo Cambio Compra
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column TIPO_CAMBIO_DIA (
            type: plainText
            heading {
                heading: Tipo Cambio Día
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                MONEDAS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 98971 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_MONEDA (
                sequence: 1
            )

            displayColumn DECIMALES (
                sequence: 6
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn FEC_TIPO_CAMBIO (
                sequence: 7
            )

            displayColumn ID_PAIS (
                sequence: 5
            )

            displayColumn SIGLAS (
                sequence: 3
            )

            displayColumn SIGLAS_TESAKA (
                sequence: 10
            )

            displayColumn TIPO_CAMBIO (
                sequence: 8
            )

            displayColumn TIPO_CAMBIO_COMPRA (
                sequence: 9
            )

            displayColumn TIPO_CAMBIO_DIA (
                sequence: 4
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @monedas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 29
                clearCache: 29
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @monedas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @monedas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17296326866270935
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

