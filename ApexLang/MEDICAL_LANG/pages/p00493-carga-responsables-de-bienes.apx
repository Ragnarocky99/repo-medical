    pageItem P493_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 110
            region: @carga-responsables-de-bienes
            slot: regionBody
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    pageItem P493_ID_PERSONA (
