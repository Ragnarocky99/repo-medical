page 493 (
    name: Carga Responsables de Bienes
    alias: CARGA-RESPONSABLES-DE-BIENES
    title: Carga Responsables de Bienes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-responsables-de-bienes (
        name: Carga Responsables de Bienes
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                      COD_RESPONSABLE,
                      ID_PERSONA,
                      DESCRIPCION,
                      ID_SUCURSAL,
                      ID_CENTRO,
                      ID_DEPARTAMENTO,
                      ID_SECCION,
                      ID_EMPRESA,
                      ID
                FROM
                      COW_RESPONSABLES_BIENES;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P493_COD_RESPONSABLE (
        type: textField
        label {
            label: <p><b style="color:red">*</b>Cód. Responsable:</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-responsables-de-bienes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: COD_RESPONSABLE
            dataType: varchar2
        }
    )

    pageItem P493_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-responsables-de-bienes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 125
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P493_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-responsables-de-bienes
            slot: regionBody
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: COW_RESPONSABLES_BIENES_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P493_ID_CENTRO (
        type: popupLov
        label {
            label: <p>Centro:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 700
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-centro-costo
        }
        layout {
            sequence: 100
            region: @carga-responsables-de-bienes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: ID_CENTRO
            dataType: number
        }
    )

    pageItem P493_ID_DEPARTAMENTO (
