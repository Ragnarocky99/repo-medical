            formRegion: @carga-responsables-de-bienes
            column: ID_SECCION
            dataType: number
        }
    )

    pageItem P493_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 700
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
        }
        layout {
            sequence: 50
            region: @carga-responsables-de-bienes
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: ID_SUCURSAL
            dataType: number
        }
    )

    button actualizar (
        buttonName: Actualizar
        label: Actualizar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P493_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button borrar (
        buttonName: Borrar
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P493_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button cancelar (
        buttonName: Cancelar
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P493_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P480_ID_PERSONA IS NULL THEN RETURN FALSE;
                ELSE RETURN TRUE;
                END IF;
                ```
        }
        error {
            errorMessage: Cargar Persona
            displayLocation: onErrorPage
            associatedItem: @P493_ID_PERSONA
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 60248744934840279
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-responsables-de-bienes (
        name: Initialize form Carga Responsables de Bienes
        type: formInitialization
        formRegion: @carga-responsables-de-bienes
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 60247973978840279
        }
    )

    process process-form-carga-responsables-de-bienes (
        name: Process form Carga Responsables de Bienes
        type: formAutoRowProcessing
        formRegion: @carga-responsables-de-bienes
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 60248320827840279
        }
    )

)

