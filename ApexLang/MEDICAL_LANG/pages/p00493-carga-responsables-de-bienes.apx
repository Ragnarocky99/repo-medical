        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 700
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-personas
        }
        layout {
            sequence: 30
            region: @carga-responsables-de-bienes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-responsables-de-bienes
            column: ID_PERSONA
            dataType: number
        }
