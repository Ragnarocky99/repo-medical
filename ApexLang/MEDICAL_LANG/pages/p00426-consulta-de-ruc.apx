page 426 (
    name: Consulta de RUC
    alias: CONSULTA-DE-RUC
    title: Consulta de RUC
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P426_ESTADO").readOnly = true;
            document.getElementById("P426_MENSAJE").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 228px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                margin-bottom-none
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region consulta-de-ruc (
        name: Consulta de RUC
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
                margin-top-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P426_AMBIENTE_EJECUCION (
        type: selectList
        label {
            label: <p>Ambiente Ejecución: &ensp;</p>
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Test;TEST,Produccion;PROD
        }
        layout {
            sequence: 10
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: PKGFE.PARAMETRO(:P0_ID_EMPRESA,'AMBIENTE_SIFEN')
        }
    )

    pageItem P426_COD_ESTADO (
        type: textField
        label {
            label: <p>Estado: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P426_COD_MENSAJE (
        type: textField
        label {
            label: <p>Mensaje: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
            width: 30
        }
    )

    pageItem P426_ESTADO (
        type: textField
        label {
            alignment: left
        }
        layout {
            sequence: 80
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P426_IND_FACT_ELECTRONICO (
        type: textField
        label {
            label: <p>Facturador Electrónico: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 90
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 9
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P426_MENSAJE (
        type: textField
        label {
            alignment: left
        }
        layout {
            sequence: 50
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
            width: 30
        }
    )

    pageItem P426_RAZON_SOCIAL (
        type: textField
        label {
            label: <p>Razón Social: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P426_RUC (
        type: textField
        label {
            label: <p>RUC: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @consulta-de-ruc
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button generar (
        buttonName: GENERAR
        label: Generar
        layout {
            sequence: 30
            region: @consulta-de-ruc
            slot: regionBody
            column: 6
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--gapTop
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction consulta-de-ruc (
        name: Consulta de RUC
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @generar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                        consultar_ruc(:P426_COD_MENSAJE, :P426_RUC, :P0_ID_EMPRESA, :P426_MENSAJE, :P426_RAZON_SOCIAL, :P426_IND_FACT_ELECTRONICO,
                        :P426_COD_ESTADO, :P426_ESTADO, :P426_AMBIENTE_EJECUCION);
                    EXCEPTION
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, '-.ERR: ' || SQLERRM);
                    END;
                    ```
                itemsToSubmit: [
                    P426_AMBIENTE_EJECUCION
                    P426_RUC
                    P426_COD_MENSAJE
                    P426_MENSAJE
                    P426_RAZON_SOCIAL
                    P426_COD_ESTADO
                    P426_ESTADO
                    P426_IND_FACT_ELECTRONICO
                ]
                itemsToReturn: [
                    P426_MENSAJE
                    P426_COD_MENSAJE
                    P426_RAZON_SOCIAL
                    P426_ESTADO
                    P426_IND_FACT_ELECTRONICO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

