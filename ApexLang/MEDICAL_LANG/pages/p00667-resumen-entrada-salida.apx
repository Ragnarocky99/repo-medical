page 667 (
    name: Resumen Entrada-Salida
    alias: RESUMEN-ENTRADA-SALIDA
    title: Resumen Entrada-Salida
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .totales{
                font-weight: bold;
                font-size: large;
            }
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region resumen-entrada-salida (
        name: Resumen Entrada-Salida
        type: interactiveReport
        source {
            location: localDatabase
            tableName: STWV_ENTSAL_RESUMEN
            whereClause:
                ```sql
                (FEC_ENT_SAL BETWEEN :P667_FEC_ENTSAL_DESDE AND :P667_FEC_ENTSAL_HASTA)
                  AND (ID_PROVEEDOR = :P667_PROVEEDOR OR :P667_PROVEEDOR IS NULL)
                  AND (COD_ARTICULO = :P667_ARTICULO OR :P667_ARTICULO IS NULL)
                  AND (NUM_ENT_SAL = :P667_NRO_ENTSAL OR :P667_NRO_ENTSAL IS NULL)
                ```
            pageItemsToSubmit: [
                P667_FEC_ENTSAL_DESDE
                P667_FEC_ENTSAL_HASTA
                P667_ID_PROVEEDOR
                P667_ARTICULO
                P667_NRO_ENTSAL
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 85470263641157489
        }

