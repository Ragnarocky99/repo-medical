    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P667_FEC_ENTSAL_DESDE
                P667_FEC_ENTSAL_HASTA
                P667_ID_PROVEEDOR
                P667_ARTICULO
                P667_NRO_ENTSAL
            ]
        }

        action native-refresh (
