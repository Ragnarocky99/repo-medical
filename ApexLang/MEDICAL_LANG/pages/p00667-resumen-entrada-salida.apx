    pageItem P667_FEC_ENTSAL_DESDE (
        type: datePicker
        label {
            label: <p><b style="color:red;">*</b>Fecha Desde: </p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/'||TO_CHAR(SYSDATE,'MM/YYYY') FROM DUAL;
        }
    )

    pageItem P667_FEC_ENTSAL_HASTA (
        type: datePicker
        label {
