    region código-de-bienes-de-uso (
        name: Código de Bienes de Uso
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT B.ID_SUCURSAL, 
                       B.ID_CENTRO, 
                       B.ID_DEPARTAMENTO, 
                       B.ID_SECCION, 
                       B.ID_RESPONSABLE, 
                       B.MON_COSTO, 
                       B.DESCRIPCION AS BIEN, 
                       B.ID_TIPO_BIEN,
                       T.DESCRIPCION AS TIPO_BIEN, 
                       B.MON_COSTO_EXT AS MONTO_EXTRANJERO,
                       B.FEC_COMPRA, 
                       B.REF_COD_BIEN
                       FROM  COW_BIENES_USO B, COW_TIPOS_BIENES T
                       WHERE B.ID_TIPO_BIEN = T.ID
                             and (B.ID_SUCURSAL = :P581_SUCURSAL OR :P581_SUCURSAL IS NULL)  
                             and (B.ID_CENTRO = :P581_CENTRO OR :P581_CENTRO IS NULL)
                             and (B.ID_DEPARTAMENTO = :P581_DEPARTAMENTO OR :P581_DEPARTAMENTO IS NULL) 
                             AND (B.ID_SECCION = :P581_SECCION OR :P581_SECCION IS NULL) 
                             AND (B.ID_TIPO_BIEN = :P581_TIPO_BIEN OR :P581_TIPO_BIEN IS NULL)
                             AND (B.FEC_COMPRA BETWEEN :P581_FEC_INI AND :P581_FEC_FIN)
                order by B.ID_TIPO_BIEN
                ```
            pageItemsToSubmit: [
                P581_TIPO_BIEN
                P581_SUCURSAL
                P581_DEPARTAMENTO
                P581_CENTRO
                P581_SECCION
                P581_FEC_INI
                P581_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 189393647980093241
        }

