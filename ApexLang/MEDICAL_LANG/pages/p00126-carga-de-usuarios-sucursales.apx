page 126 (
    name: Carga de Usuarios Sucursales
    alias: CARGA-DE-USUARIOS-SUCURSALES
    title: Carga de Usuarios Sucursales
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-usuarios-sucursales (
        name: Carga de Usuarios Sucursales
        type: form
        source {
            location: localDatabase
            tableName: BSW_USUARIOS_SUCURSALES
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 3
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P126_ID (
        type: hidden
        layout {
            sequence: 60
            region: @carga-de-usuarios-sucursales
            slot: regionBody
        }
        source {
            formRegion: @carga-de-usuarios-sucursales
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_USUARIOS_SUC_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P126_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-usuarios-sucursales
            slot: regionBody
        }
        source {
            formRegion: @carga-de-usuarios-sucursales
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P126_ID_SUCURSAL (
        type: popupLov
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Sucursal:</a>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
        }
        layout {
            sequence: 40
            region: @carga-de-usuarios-sucursales
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @carga-de-usuarios-sucursales
            column: ID_SUCURSAL
            dataType: number
        }
    )

    pageItem P126_ID_USUARIO (
        type: popupLov
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Usuario:</a>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @bsw-usuarios-cod-usuario
        }
        layout {
            sequence: 30
            region: @carga-de-usuarios-sucursales
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @carga-de-usuarios-sucursales
            column: ID_USUARIO
            dataType: number
        }
    )

    pageItem P126_POR_DEFECTO (
        type: checkbox
        label {
            label: <p>Por Defecto</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 50
            region: @carga-de-usuarios-sucursales
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-usuarios-sucursales
            column: POR_DEFECTO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P126_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P126_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P126_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 15874675335956189
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-usuarios-sucursales (
        name: Initialize form Carga de Usuarios Sucursales
        type: formInitialization
        formRegion: @carga-de-usuarios-sucursales
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15873800641956189
        }
    )

    process process-form-carga-de-usuarios-sucursales (
        name: Process form Carga de Usuarios Sucursales
        type: formAutoRowProcessing
        formRegion: @carga-de-usuarios-sucursales
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15874217277956189
        }
    )

)

