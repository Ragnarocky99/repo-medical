page 62 (
    name: Carga de Familia
    alias: STFAMARTF
    title: Carga de Familia
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            .mostrar{
                   background-color:#eeeeee;
                width: 171px;
                height: 23px;
              
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-familia (
        name: Carga de Familia
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_FAMILIA,
                       DESCRIPCION,
                       ABREVIATURA,
                       ESTADO,
                       ID_EMPRESA,
                       COD_USUARIO_AUD,
                       IND_REPLICA,
                       PORC_DESCUENTO,
                       VOLUMEN_MAX,
                       ID_SUCURSAL
                  from STW_FAMILIA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P62_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @carga-de-familia
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P62_COD_FAMILIA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Familia:</a>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @carga-de-familia
            column: COD_FAMILIA
            dataType: varchar2
        }
    )

    pageItem P62_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-familia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-familia
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P62_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-familia
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P62_ESTADO (
        type: switch
        label {
            label: <p>Estado:</p>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: A
            onLabel: ACTIVO
            offValue: I
            offLabel: INACTIVO
        }
        layout {
            sequence: 70
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-familia
            column: ESTADO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: A
        }
    )

    pageItem P62_ID (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-familia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-familia
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: STW_FAMILIA_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P62_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-familia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-familia
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P62_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
        }
        layout {
            sequence: 80
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-familia
            column: ID_SUCURSAL
            dataType: number
        }
    )

    pageItem P62_IND_REPLICA (
        type: hidden
        layout {
            sequence: 120
            region: @carga-de-familia
            slot: regionBody
        }
        source {
            formRegion: @carga-de-familia
            column: IND_REPLICA
            dataType: varchar2
        }
    )

    pageItem P62_PORC_DESCUENTO (
        type: numberField
        label {
            label: <p>Porc. Descuento: </p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-familia
            column: PORC_DESCUENTO
            dataType: number
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P62_VOLUMEN_MAX (
        type: numberField
        label {
            label: <p>Volumen Maximo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-familia
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-familia
            column: VOLUMEN_MAX
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P62_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p62-cod-familia (
        itemName: P62_COD_FAMILIA
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_FAMILIA)), 0) + 1
                  FROM STW_FAMILIA
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 10646799477622534
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-stfamartf (
        name: Initialize form STFAMARTF
        type: formInitialization
        formRegion: @carga-de-familia
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10645997430622534
        }
    )

    process process-form-stfamartf (
        name: Process form STFAMARTF
        type: formAutoRowProcessing
        formRegion: @carga-de-familia
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10646342972622534
        }
    )

)

