page 112 (
    name: Carga de Calendarios
    alias: CARGA-DE-CALENDARIOS
    title: Carga de Calendarios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-calendarios (
        name: Carga de Calendarios
        type: form
        source {
            location: localDatabase
            tableName: BSW_CALENDARIOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P112_ACTIVO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 80
            region: @carga-de-calendarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-calendarios
            column: ACTIVO
            dataType: varchar2
        }
    )

    pageItem P112_ACTUALIZADO_POR (
        type: hidden
        layout {
            sequence: 140
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: ACTUALIZADO_POR
            dataType: varchar2
        }
    )

    pageItem P112_ALTA_POR (
        type: hidden
        layout {
            sequence: 120
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: ALTA_POR
            dataType: varchar2
        }
    )

    pageItem P112_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P112_FEC_ACTUAL (
        type: datePicker
        label {
            label: <p>Fecha Actual:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 50
            region: @carga-de-calendarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-calendarios
            column: FEC_ACTUAL
            dataType: date
        }
    )

    pageItem P112_FEC_ACTUALIZADO (
        type: hidden
        layout {
            sequence: 150
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: FEC_ACTUALIZADO
            dataType: date
        }
    )

    pageItem P112_FEC_ALTA (
        type: hidden
        layout {
            sequence: 130
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: FEC_ALTA
            dataType: date
        }
    )

    pageItem P112_FEC_FINAL (
        type: datePicker
        label {
            label: <p>Fecha Final:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 70
            region: @carga-de-calendarios
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-calendarios
            column: FEC_FINAL
            dataType: date
        }
    )

    pageItem P112_FEC_INICIAL (
        type: datePicker
        label {
            label: <p>Fecha Inicial:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 40
            region: @carga-de-calendarios
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-calendarios
            column: FEC_INICIAL
            dataType: date
        }
    )

    pageItem P112_ID (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_CALENDARIOS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P112_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-calendarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-calendarios
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P112_ID_MODULO (
        type: popupLov
        label {
            label: <p>Módulo:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @bsw-modulos-cod-modulo
        }
        layout {
            sequence: 30
            region: @carga-de-calendarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @carga-de-calendarios
            column: ID_MODULO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P112_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P112_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P112_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 15171990403207112
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-calendarios (
        name: Initialize form Carga de Calendarios
        type: formInitialization
        formRegion: @carga-de-calendarios
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15171197729207112
        }
    )

    process process-form-carga-de-calendarios (
        name: Process form Carga de Calendarios
        type: formAutoRowProcessing
        formRegion: @carga-de-calendarios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15171580340207112
        }
    )

)

