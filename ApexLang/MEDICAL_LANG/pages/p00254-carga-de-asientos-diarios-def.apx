    region carga-de-asientos-diarios-definitivos (
        name: Carga de Asientos Diarios Definitivos
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DEF.ID,
                       DEF.ID_EMPRESA,
                       DEF.ID_SUCURSAL,
                       DEF.FEC_ASIENTO,
                       DEF.DESCRIPCION,
                       DEF.ID_MONEDA,
                       DEF.TIPO_CAMBIO,
                       DEF.NUM_ASIENTO,
                       DEF.NUM_ASIENTO_REF,
                       DEF.COD_USUARIO_AUD,
                       DEF.TIP_COMPROBANTE,
                       DEF.SER_COMPROBANTE,
                       DEF.NRO_COMPROBANTE,
                       DEF.ID_EJERCICIO,
                       DEF.ID_MODULO
                from COW_DIARIO_CABECERAS DEF
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DP.ID,
                       DP.ID_PLAN_CUENTA,
                       DP.DESCRIPCION,
                       DP.ID_CENTRO,
                       DP.ID_CENTRO AS CENTRO_DESC,
                       DP.MON_DEBE,
                       DP.MON_HABER,
                       DP.MON_DEBE AS DEBE_COPIA,
                       DP.MON_HABER AS HABER_COPIA,
                       DP.TIP_COMPROBANTE,
                       DP.SER_COMPROBANTE,
                       DP.NRO_COMPROBANTE,
                       DP.ID_MONEDA,
                       DP.TIPO_CAMBIO,
                       DP.MON_ORI,
                       DP.FEC_ASIENTO,
                       DP.ID_EMPRESA,
                       DP.ID_SUCURSAL,
                       DP.NUM_LINEA,
                       DP.COD_USUARIO_AUD,
                       DP.DESCRIPCION AS DESCRIPCION2,
                       DP.ID_EJERCICIO,
                       DP.ID_MODULO
                       
                FROM COW_DIARIO_DETALLES DP
                
                WHERE DP.ID_DIARIO_CAB = :P254_ID
                ```
            pageItemsToSubmit: P254_ID
        }
        layout {
            sequence: 10
            parentRegion: @carga-de-asientos-diarios-definitivos
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
                margin-top-lg
            ]
        }
        advanced {
