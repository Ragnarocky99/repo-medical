            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P254_IND_ASIENTO_APERTURA = 'S' AND :P254_IND_ASIENTO_CIERRE = 'S' OR :P254_IND_ASIENTO_APERTURA = 'N' AND :P254_IND_ASIENTO_CIERRE = 'N' THEN
                        RETURN FALSE;
                    ELSE 
                        RETURN TRUE;
                    END IF; 
                END;
                ```
        }
        error {
            errorMessage: Verifique apertura y cierre de Asiento.
        }
        serverSideCondition {
            type: never
        }
    )

