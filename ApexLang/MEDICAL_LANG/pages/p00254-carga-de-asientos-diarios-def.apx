    pageItem P254_NUM_ASIENTO (
        type: numberField
        label {
            label: <p>Nro. Definitivo: </p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @carga-de-asientos-diarios-definitivos
            slot: regionBody
            alignment: left
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 8
        }
        source {
            formRegion: @carga-de-asientos-diarios-definitivos
            column: NUM_ASIENTO
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Autogenera el número de asiento
                DECLARE
                    v_num_asiento COW_DIARIO_CABECERAS.NUM_ASIENTO%TYPE;
                BEGIN
                    IF :P254_NUM_ASIENTO IS NULL THEN
                        BEGIN
                            SELECT NVL(MAX(NUM_ASIENTO),0)+1
                                INTO v_num_asiento
                            FROM COW_DIARIO_CABECERAS DC, COW_EJERCICIOS EJ
                            WHERE DC.ID_EMPRESA   = :P0_COD_EMPRESA
                                AND EJ.COD_EJERCICIO = :P0_COD_EJERCICIO
                                AND DC.ID_EJERCICIO  = EJ.ID;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    v_num_asiento := 1;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el número de asiento'||sqlerrm);
                        END;
                        :P254_NUM_ASIENTO := v_num_asiento;      
                    END IF;
                    RETURN :P254_NUM_ASIENTO;
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            v_num_asiento:=1;
                    RETURN v_num_asiento;
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
    )

