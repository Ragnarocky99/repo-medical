    dynamicAction cantidad-detalle-cont (
        name: CANTIDAD_DETALLE_CONT
        execution {
            sequence: 40
        }
        when {
            event: apexbeforepagesubmit
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                         var $widget = apex.region("Detalles").widget();
                                   var $grid = $widget.interactiveGrid("getViews", "grid");
                                  var $model = $grid.model;
                                    var cantidadDet= $model.getTotalRecords();
                                    $s('P254_CANTIDAD_DET',cantidadDet);
                    ```
            }
            affectedElements {
                selectionType: items
                items: P254_CANTIDAD_DET
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-desc (
        name: CLICK_DESC
        execution {
            sequence: 100
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @detalles
        }
        comments {
            comments: No tocar, código inflamable. Hace conflicto con COPIA_DESC
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var full_desc;
                    model = this.data.model;
                    if(this.data != null){
                        if(this.data.selectedRecords[0] != null){
                                        //obtiene el valor del campo de la fila seleccionada
                            full_desc = model.getValue(this.data.selectedRecords[0],"DESCRIPCION");
                        }
                    }
                    
                    //Coloca el valor de la columna DESCRIPCION de fila seleccionada
                    
                    apex.item("P254_DESC_DETALLE").setValue(full_desc);
                    ```
            }
            affectedElements {
                selectionType: items
                items: P254_DESC_DETALLE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P254_DESC_DETALLE
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 290
        }
        when {
            selectionType: items
            items: P254_FEC_ASIENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P254_FEC_ASIENTO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P254_FEC_ASIENTO,'/','');
                            conv_fecha := substr(:P254_FEC_ASIENTO,1,2)||'/'||
                                                      substr(:P254_FEC_ASIENTO,3,2)||'/'||
                                                      lpad(substr(:P254_FEC_ASIENTO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P254_FEC_ASIENTO := conv_fecha;
                            ELSIF (length(:P254_FEC_ASIENTO) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P254_FEC_ASIENTO) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P254_FEC_ASIENTO
                itemsToReturn: P254_FEC_ASIENTO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

