    dynamicAction generar-num-asiento (
        name: GENERAR_NUM_ASIENTO
        execution {
            sequence: 220
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    --Autogenera el número de asiento
                    DECLARE
                    v_num_asiento COW_DIARIO_CABECERAS_PROV.NUM_ASIENTO%TYPE;
                    BEGIN
                    IF :P254_NUM_ASIENTO IS  NULL THEN
                    SELECT NVL(MAX(NUM_ASIENTO),0)+1
                    INTO v_num_asiento
                    FROM
                    COW_DIARIO_CABECERAS_PROV 
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID_SUCURSAL=:P0_COD_SUCURSAL
                    AND :P254_TIP_COMPROBANTE=TIP_COMPROBANTE;
                    RETURN v_num_asiento;
                    END IF;
                     RETURN :P254_NUM_ASIENTO;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    v_num_asiento:=1;
                    RETURN v_num_asiento;
                    WHEN OTHERS THEN 
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                    END;
                    EXCEPTION WHEN
                    OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                    ```
                itemsToSubmit: P254_NUM_ASIENTO
            }
            affectedElements {
                selectionType: items
                items: P254_NUM_ASIENTO
            }
            execution {
                sequence: 10
            }
        )

    )

