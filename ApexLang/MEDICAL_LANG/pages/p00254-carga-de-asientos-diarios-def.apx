    computation p254-nro-comprobante (
        itemName: P254_NRO_COMPROBANTE
        execution {
            sequence: 30
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                    v_nro_comprobante COW_DIARIO_CABECERAS.NRO_COMPROBANTE%TYPE;
                BEGIN
                    IF :P254_NRO_COMPROBANTE IS  NULL THEN
                        SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                            INTO v_nro_comprobante
                        FROM COW_DIARIO_CABECERAS 
                        WHERE ID_EMPRESA=:P0_COD_EMPRESA
                            AND :P254_SER_COMPROBANTE=SER_COMPROBANTE
                            AND :P254_TIP_COMPROBANTE=TIP_COMPROBANTE;
                        RETURN V_NRO_COMPROBANTE;
                    END IF;
                    RETURN :P254_NRO_COMPROBANTE;
                     EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            V_NRO_COMPROBANTE:=1;
                        RETURN V_NRO_COMPROBANTE;
                        WHEN OTHERS THEN 
                                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
        comments {
            comments: Calculo para calcular el nro comprobante a guardarse si es qque no se escribio un numero de manera manual
        }
    )

    computation p254-num-asiento (
        itemName: P254_NUM_ASIENTO
        execution {
            sequence: 40
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Autogenera el número de asiento
                DECLARE
                    v_num_asiento COW_DIARIO_CABECERAS.NUM_ASIENTO%TYPE;
                BEGIN
                    IF :P254_NUM_ASIENTO IS NULL THEN
                        BEGIN
                            SELECT NVL(MAX(NUM_ASIENTO),0)+1
                                INTO v_num_asiento
                            FROM COW_DIARIO_CABECERAS DC, COW_EJERCICIOS EJ
                            WHERE DC.ID_EMPRESA   = :P0_COD_EMPRESA
                                AND EJ.COD_EJERCICIO = :P0_COD_EJERCICIO
                                AND DC.ID_EJERCICIO  = EJ.ID;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    v_num_asiento := 1;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el número de asiento'||sqlerrm);
                        END;
                        :P254_NUM_ASIENTO := v_num_asiento;      
                    END IF;
                    RETURN :P254_NUM_ASIENTO;
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            v_num_asiento:=1;
                    RETURN v_num_asiento;
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
    )

    computation p254-ser-comprobante (
        itemName: P254_SER_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Autogenera el número de asiento
                DECLARE
                    v_serie_comp COW_DIARIO_CABECERAS_PROV.SER_COMPROBANTE%TYPE;
                BEGIN
                    IF :P254_SER_COMPROBANTE IS NULL THEN
                        BEGIN
                            SELECT NVL(SER_COMPROBANTE,'FVE')
                                INTO v_serie_comp
                            FROM COW_DIARIO_CABECERAS_PROV
                            WHERE ID_EMPRESA   = :P0_COD_EMPRESA
                                AND ID_EJERCICIO = :P0_COD_EJERCICIO;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    v_serie_comp := 'FVE';
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar la serie del asiento'||sqlerrm);
                        END;
                        :P254_SER_COMPROBANTE := v_serie_comp;      
                    END IF;
                    RETURN :P254_SER_COMPROBANTE;
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            v_serie_comp:='001-001';
                    RETURN v_serie_comp;
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    computation p254-tip-comprobante (
        itemName: P254_TIP_COMPROBANTE
        execution {
            sequence: 50
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Autogenera el número de asiento
                DECLARE
                    v_tip_comp COW_DIARIO_CABECERAS_PROV.TIP_COMPROBANTE%TYPE;
                BEGIN
                    IF :P254_TIP_COMPROBANTE IS NULL THEN
                        BEGIN
                            SELECT NVL(TIP_COMPROBANTE,'FVE')
                                INTO v_tip_comp
                            FROM COW_DIARIO_CABECERAS_PROV
                            WHERE ID_EMPRESA   = :P0_COD_EMPRESA
                                AND ID_EJERCICIO = :P0_COD_EJERCICIO;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    v_tip_comp := 'FVE';
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el número de asiento'||sqlerrm);
                        END;
                        :P254_TIP_COMPROBANTE := v_tip_comp;      
                    END IF;
                    RETURN :P254_TIP_COMPROBANTE;
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            v_tip_comp:='FVE';
                    RETURN v_tip_comp;
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
        serverSideCondition {
            type: never
