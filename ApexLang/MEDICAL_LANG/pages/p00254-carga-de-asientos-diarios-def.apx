    validation validacion-debe-haber-por-fila-def (
        name: VALIDACION_DEBE_HABER_POR_FILA_DEF
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @detalles
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF ( replace(:MON_DEBE, '.', '') > 0 AND replace(:MON_HABER, '.', '') > 0 ) OR ( replace(:MON_DEBE, '.', '') = 0 AND replace(:MON_HABER, '.', '') = 0 )
                    THEN
                        RETURN FALSE;
                
                    ELSE
                        RETURN TRUE;
                    END IF;
                END;
                ```
        }
        error {
            errorMessage: Solo puede cargarse un debe o un haber por fila.
        }
    )

