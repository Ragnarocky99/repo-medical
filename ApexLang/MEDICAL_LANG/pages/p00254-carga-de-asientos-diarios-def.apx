    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                                insert into COW_DIARIO_DETALLES
                                (ID_EMPRESA, FEC_ASIENTO, ID_DIARIO_CAB, DESCRIPCION, ID_PLAN_CUENTA, ID_CENTRO, 
                                MON_DEBE, MON_HABER, COD_USUARIO_AUD, NUM_LINEA, ID_SUCURSAL, 
                                ID_EJERCICIO, NUM_ASIENTO, ID_MODULO, TIP_COMPROBANTE, SER_COMPROBANTE, NRO_COMPROBANTE, 
                                ID_MONEDA, TIPO_CAMBIO, MON_ORI)
                                values(:P0_COD_EMPRESA, SYSDATE, :P254_ID, :DESCRIPCION, :ID_PLAN_CUENTA, :ID_CENTRO,
                                REPLACE(:MON_DEBE,'.',''), REPLACE(:MON_HABER,'.',''), :APP_USER, :NUM_LINEA, :P254_ID_SUCURSAL, 
                                :P0_COD_EJERCICIO, :P254_NUM_ASIENTO, :P254_ID_MODULO, :TIP_COMPROBANTE, :SER_COMPROBANTE, :NRO_COMPROBANTE, 
                                :ID_MONEDA, :TIPO_CAMBIO, REPLACE(:MON_ORI,'.',''));
                            
                            WHEN 'U' then 
                   
                                update COW_DIARIO_DETALLES  d
                                    set ID_CENTRO        = :ID_CENTRO,
                                        DESCRIPCION      = :DESCRIPCION,
                                        ID_PLAN_CUENTA   = :ID_PLAN_CUENTA,
                                        NUM_ASIENTO      = :P254_NUM_ASIENTO,
                                        MON_DEBE         = REPLACE(:MON_DEBE,'.',''),
                                        MON_HABER        = REPLACE(:MON_HABER,'.',''),
                                        TIP_COMPROBANTE  = :TIP_COMPROBANTE,
                                        SER_COMPROBANTE  = :SER_COMPROBANTE,
                                        NRO_COMPROBANTE  = :NRO_COMPROBANTE,
                                        MON_ORI          = REPLACE(:MON_ORI,'.',''),
                                        ID_MONEDA        = :ID_MONEDA,
                                        TIPO_CAMBIO      = REPLACE(:TIPO_CAMBIO,'.','')
                                        
                                where   ID_DIARIO_CAB = :P254_ID
                                    and d.ID = :ID;
                             
                            when 'D' then
                                delete COW_DIARIO_DETALLES d     
                                WHERE d.ID_DIARIO_CAB = :P254_ID
                                           and d.ID = :ID;  
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 59151256341386554
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: B235_GUARDAR,B235_APLICAR
        }
    )

