    dynamicAction calc-diferencia (
        name: CALC_DIFERENCIA
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: [
                P254_TOT_DEBE
                P254_TOT_HABER
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calcDiferencia()
            }
            affectedElements {
                selectionType: items
                items: P254_DIFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-debe-haber (
        name: CALCULAR_DEBE_HABER
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                MON_DEBE
                MON_HABER
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: [
                    P254_TOT_DEBE
                    P254_TOT_HABER
                ]
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MON_DEBE
                itemsToSubmit: MON_DEBE
            }
            affectedElements {
                selectionType: columns
                columns: DEBE_COPIA
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MON_HABER
                itemsToSubmit: MON_HABER
            }
            affectedElements {
                selectionType: columns
                columns: HABER_COPIA
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction cambio (
        name: CAMBIO
        execution {
            sequence: 180
        }
        when {
            selectionType: items
