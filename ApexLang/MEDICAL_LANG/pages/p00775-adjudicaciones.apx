page 775 (
    name: Adjudicaciones
    alias: ADJUDICACIONES
    title: Adjudicaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region adjudicaciones (
        name: Adjudicaciones
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LCWV_ADJUDICACIONES_CATALOGO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P775_ID_CLIENTE OR :P775_ID_CLIENTE IS NULL) AND
                (NRO_ID_LICITACION = :P775_NRO_ID_LICITACION OR :P775_NRO_ID_LICITACION IS NULL) AND
                (NRO_LICITACION = :P775_NRO_LICITACION OR :P775_NRO_LICITACION IS NULL) AND
                (NRO_ITEM = :P775_NRO_ITEM OR :P775_NRO_ITEM IS NULL)
                ```
            pageItemsToSubmit: [
                P775_ID_CLIENTE
                P775_NRO_ID_LICITACION
                P775_NRO_LICITACION
                P775_NRO_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 777
                items: {
                    P777_ID_LICITACION_DET: #ID_LICITACION_DET##ID_OFERTA#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 38536116767174031
        }

