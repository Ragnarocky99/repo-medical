    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    pageItem P775_ID_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 800
            popupHeight: 500
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P775_NRO_ID_LICITACION (
        type: textField
        label {
            label: <p>Nro. ID:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P775_NRO_ITEM (
        type: textField
        label {
            label: <p>Nro. Item:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P775_NRO_LICITACION (
        type: textField
        label {
            label: <p>Nro. Licitacion:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction alerta-nota-de-envio (
        name: Alerta Nota de Envio
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action plugin-com-fos-notifications (
            action: plugin/fosNotifications
            settings {
                action: showInfo
                title: Nota de Envio
                message: Disponible para generar automaticamente.
                overrideDefaults: true
                options: [
                    removeAllNotificationsFirst
                    escapeHtml
                    newestOnTop
                    performClientSideSubstitutions
                    dismissOnNotificationClickTap
                    dismissOnCloseButtonClick
                ]
                icon: fa-car
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                      FROM STWV_ARTICULOS_AUT_NOTA_ENV
                     WHERE ID_LICITACION_CAB IS NOT NULL
                    ```
            }
        )

    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P775_ID_CLIENTE
                P775_NRO_ID_LICITACION
                P775_NRO_LICITACION
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @adjudicaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-adjudicacion (
        name: Refrescar Adjudicacion
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @adjudicaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-region (
        name: Refrescar Region
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @adjudicaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

