page 465 (
    name: Listado de Empleados
    alias: LISTADO-DE-EMPLEADOS
    title: Listado de Empleados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments:
            ```
            Este listado de Empleados utiliza el reporte (RHEMPLEA) 
            pero tambien llama a otros 3 reportes los cuales son rhemple, rhempres, rhemprec
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P465_CENTRO_PAGO (
        type: popupLov
        label {
            label: <P>Centro Pago: </P>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-centro-pago-rh
            nullDisplayValue: ---Sin Seleccionar---
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    pageItem P465_FEC_INI (
        type: datePicker
        label {
            label: <p>Fecha Final: </p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    pageItem P465_SECCION (
        type: popupLov
        label {
            label: <P>Sección: </P>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-secciones
            nullDisplayValue: ---Sin Seleccionar---
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    button ejecutar (
        buttonName: EJECUTAR
        label: Ejecutar
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P465_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P465_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P465_FEC_INI,'/','');
                            conv_fecha := substr(:P465_FEC_INI,1,2)||'/'||
                                                      substr(:P465_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:P465_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P465_FEC_INI := conv_fecha;
                            ELSIF (length(:P465_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P465_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P465_FEC_INI
                itemsToReturn: P465_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 470
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 470
                items: {
                    P470_SECCION: &P465_SECCION.
                    P470_FEC_INI: &P465_FEC_INI.
                    P470_CENTRO_PAGO: &P465_CENTRO_PAGO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @ejecutar
        }
    )

)

