                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P327_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P327_FEC_HOR_ASISTENCIA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P327_FEC_HOR_ASISTENCIA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P327_FEC_HOR_ASISTENCIA,'/','');
                            conv_fecha := substr(:P327_FEC_HOR_ASISTENCIA,1,2)||'/'||
                                                      substr(:P327_FEC_HOR_ASISTENCIA,3,2)||'/'||
                                                      lpad(substr(:P327_FEC_HOR_ASISTENCIA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P327_FEC_HOR_ASISTENCIA := conv_fecha;
                            ELSIF (length(:P327_FEC_HOR_ASISTENCIA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P327_FEC_HOR_ASISTENCIA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P327_FEC_HOR_ASISTENCIA
                itemsToReturn: P327_FEC_HOR_ASISTENCIA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P327_FEC_ASISTENCIA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P327_FEC_ASISTENCIA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P327_FEC_ASISTENCIA,'/','');
                            conv_fecha := substr(:P327_FEC_ASISTENCIA,1,2)||'/'||
                                                      substr(:P327_FEC_ASISTENCIA,3,2)||'/'||
                                                      lpad(substr(:P327_FEC_ASISTENCIA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P327_FEC_ASISTENCIA := conv_fecha;
                            ELSIF (length(:P327_FEC_ASISTENCIA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P327_FEC_ASISTENCIA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P327_FEC_ASISTENCIA
                itemsToReturn: P327_FEC_ASISTENCIA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

