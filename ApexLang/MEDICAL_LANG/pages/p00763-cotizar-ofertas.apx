            readOnly {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT SUM(OA.CANTIDAD * DECODE(OA.TIPO, 'AN', -1, 1)) CANTIDAD
                      FROM LCW_OFERTAS_APROBACIONES OA
                     WHERE OA.ID_OFERTA = :ID
                    GROUP BY OA.ID_OFERTA
                    HAVING SUM(OA.CANTIDAD * DECODE(OA.TIPO, 'AN', -1, 1)) > 0
                    ```
