        column ID_MONEDA_COSTO (
            type: selectList
            heading {
                heading: <p>Moneda Costo</p>
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lv-monedas
                displayNullValue: false
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                databaseColumn: ID_MONEDA_COSTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT SUM(OA.CANTIDAD * DECODE(OA.TIPO, 'AN', -1, 1)) CANTIDAD
                      FROM LCW_OFERTAS_APROBACIONES OA
                     WHERE OA.ID_OFERTA = :ID
                    GROUP BY OA.ID_OFERTA
                    HAVING SUM(OA.CANTIDAD * DECODE(OA.TIPO, 'AN', -1, 1)) > 0
                    ```
                execute: forEachRow
            }
        )

