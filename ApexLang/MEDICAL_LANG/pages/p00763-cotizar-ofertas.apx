    region lcw-licitaciones-det (
        name: LCW_LICITACIONES_DET
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_LICITACION_CAB,
                       NRO_ITEM,
                       DESC_ARTICULO_CATALOGO,
                       MONTO_TOTAL,
                       VOLUMEN,
                       ID_UNIDAD_MEDIDA,
                       IND_NO_PRESENTADO,
                       ESPECIFICACION_TECNICA,
                       PRECIO_UNITARIO_ESTIMADO
                  from LCW_LICITACIONES_DET LD
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P763_ID
        }
    )

    region ofertas (
        name: Ofertas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select O.ID,
                       O.ID_EMPRESA,
                       O.ID_LICITACION_CAB,
                       O.ID_LICITACION_DET,
                       O.ID_ARTICULO,
                       O.ID_PROVEEDOR,
                       O.ID_MONEDA_COSTO,
                       O.COSTO_UNITARIO,
                       O.TIP_CAMBIO_COSTO,
                       O.PRECIO_UNITARIO,
                       O.CANTIDAD,
                       O.COSTO_UNITARIO_RECARGO,
                       O.COSTO_TOTAL_RECARGO,
                       O.ID_TIPO_ENTREGA,
                       O.ID_CONDICION_COMPRA,
                       O.ID_MONEDA_PRESUPUESTO,
                       O.TIP_CAMBIO_PRESUPUESTO,
                       O.PORC_RENTABILIDAD PORC_MARGEN,
                       O.MARGEN_TOTAL,
                       O.PRECIO_TOTAL,
                       O.DECIMALES,
                       O.COSTO_TOTAL,
                       O.DESC_ARTICULO,
                       O.IND_ENVIO,
                       O.IND_NO_ENVIO,
                       O.ID_MARCA,
                       O.ID_ENVASE,
                       O.ID_UNIDAD_MEDIDA,
                       O.IND_HISTORICO_COTIZA,
                       O.IND_HISTORICO_COTIZA_EXCEL,
                       (SELECT A.COD_ARTICULO FROM STW_ARTICULOS A WHERE A.ID = O.ID_ARTICULO) COD_ARTICULO,
                       (SELECT A.COD_ORIGEN_ART FROM STW_ARTICULOS A WHERE A.ID = O.ID_ARTICULO) COD_FABRICANTE,
                       (SELECT DISPONIBILIDAD
                          FROM STWV_ARTICULOS_LICITACION_LV AL
                         WHERE AL.ID_ARTICULO = O.ID_ARTICULO) DISPONIBILIDAD,
                       (NVL(((SELECT DISPONIBILIDAD
                                FROM STWV_ARTICULOS_LICITACION_LV AL
                               WHERE AL.ID_ARTICULO = O.ID_ARTICULO)), 0) - O.CANTIDAD) DIFERENCIA,
                       O.COMENTARIO_COMPRAS,
                       (SELECT NVL(PE.NOMB_FANTASIA, PE.NOMBRE)
                          FROM CMW_PROVEEDORES PR
                          JOIN BSW_PERSONAS    PE ON PE.ID = PR.ID_PERSONA
                         WHERE PR.ID = O.ID_PROVEEDOR) PROVEEDOR,
                       O.ID ORDEN,
                       ROUND(O.COSTO_UNITARIO_RECARGO * O.TIP_CAMBIO_COSTO) COSTO_UNITARIO_RECARGO_GS,
                       ROUND(O.COSTO_UNITARIO_RECARGO * O.TIP_CAMBIO_COSTO * O.CANTIDAD) COSTO_TOTAL_RECARGO_GS,
                       O.IND_GESTION,
                       CASE
                        WHEN TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) IN ('DIR') THEN 'UD'
                        WHEN O.IND_GESTION = 'S' AND O.IND_COTIZAR = 'N' THEN ''
                        WHEN (SELECT SUM(OA.CANTIDAD * DECODE(OA.TIPO, 'AN', -1, 1)) CANTIDAD
                                FROM LCW_OFERTAS_APROBACIONES OA
                               WHERE OA.ID_OFERTA = O.ID
                            GROUP BY OA.ID_OFERTA) >= 0 THEN ''
                        ELSE 'UD'
                       END ROW_OPERATION,
                       O.IND_COTIZAR,
                       O.MOTIVO_RECOTIZACION,
                       O.OBS_COMPRA,
                       O.COD_USUARIO_COTIZA,
                       O.IND_NO_APLICA_PRECIO,
                       O.IND_ALTERNATIVA
                  from LCW_OFERTAS O
                 where ID_EMPRESA        = :P0_ID_EMPRESA AND
                ID_LICITACION_CAB = :P763_ID_LICITACION_CAB AND
                ID_LICITACION_DET = :P763_ID
                ```
            pageItemsToSubmit: [
                P763_ID
                P763_ID_LICITACION_CAB
            ]
        }
        layout {
            sequence: 20
            parentRegion: @lcw-licitaciones-det
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
