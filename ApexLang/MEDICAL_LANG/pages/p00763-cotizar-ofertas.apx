page 763 (
    name: Cotizar Ofertas
    alias: COTIZAR-OFERTAS
    title: Cotizar Ofertas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function refrescarGrillaDetalle(columna){
                var view = apex.region("Ofertas").call("getCurrentView").view$;
                view.grid("lockActive");
            
                setTimeout( function() {
                    view.grid( "setActiveRecordValue", columna ).grid( "unlockActive" );
                }, 100 );
            }
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Times", monospace;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

