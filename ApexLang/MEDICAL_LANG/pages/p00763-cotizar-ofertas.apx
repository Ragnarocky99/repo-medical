    dynamicAction acciones-al-cargar-pagina (
        name: Acciones al cargar pagina
        execution {
            sequence: 180
        }
        when {
            event: ready
        }

        action habilitar-copaiado-read-only (
            name: Habilitar copaiado read only
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.addEventListener('copy', (event) => {
                        const activeElement = $(document.activeElement)[0];
                        const textToCopy = activeElement?.innerText || window.getSelection();
                        event.clipboardData.setData('text/plain', textToCopy);
                        event.preventDefault();
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction calcular-margen (
        name: Calcular % Margen
        execution {
            sequence: 100
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: PRECIO_UNITARIO
        }

        action porc-margen (
            name: PORC_MARGEN
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: ROUND(((REPLACE(:PRECIO_UNITARIO, '.', '') * REPLACE(:TIP_CAMBIO_PRESUPUESTO, '.', '') - NVL(REPLACE(:COSTO_UNITARIO_RECARGO, '.', ''), REPLACE(:COSTO_UNITARIO, '.', '')) * REPLACE(:TIP_CAMBIO_COSTO, '.', '')) / (REPLACE(:PRECIO_UNITARIO, '.', '') * REPLACE(:TIP_CAMBIO_PRESUPUESTO, '.', ''))) * 100, 2)
                itemsToSubmit: [
                    PRECIO_UNITARIO
                    COSTO_UNITARIO_RECARGO
                    COSTO_UNITARIO
                    TIP_CAMBIO_COSTO
                    TIP_CAMBIO_PRESUPUESTO
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: PORC_MARGEN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-margen-total (
        name: Calcular Margen Total
        execution {
            sequence: 110
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: PORC_MARGEN
        }

        action margen-total (
            name: MARGEN_TOTAL
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: ROUND(REPLACE(:PRECIO_UNITARIO, '.', '')/100 * TO_NUMBER(TO_CHAR(:PORC_MARGEN))* REPLACE(:CANTIDAD, '.', ''))
                itemsToSubmit: [
                    PRECIO_UNITARIO
                    PORC_MARGEN
                    CANTIDAD
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: MARGEN_TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

