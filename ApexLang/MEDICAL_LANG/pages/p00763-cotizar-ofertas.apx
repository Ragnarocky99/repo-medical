    dynamicAction setear-datos-articulo (
        name: Setear Datos Articulo
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: ID_ARTICULO
        }

        action bloquear-descripcion-si-no-es-estandar (
            name: Bloquear Descripcion si no es Estandar
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#DESC_ARTICULO").attr('readonly','readonly'); 
                    $("#DESC_ARTICULO").addClass('apex_disabled');
                    
                    $("#ID_MARCA").addClass('apex_disabled').attr('tabindex','-1');
                    ```
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                column: ID_ARTICULO
                value: 813
            }
        )

        action cod-articulo (
            name: COD_ARTICULO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COD_ARTICULO
                      FROM STW_ARTICULOS
                     WHERE ID = :ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: columns
                columns: COD_ARTICULO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action costo-unitario (
            name: COSTO_UNITARIO
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VSALDO_STOCK NUMBER := OBTENER_CANTIDAD_EXISTENTE(:ID_ARTICULO, NULL, 'N');
                    BEGIN
                        IF VSALDO_STOCK > 0 THEN
                            RETURN TRAE_COSTO_PROM_CONIVA(:P0_ID_EMPRESA, :ID_ARTICULO, SYSDATE);
                        END IF;
                    
                        RETURN 0;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: COSTO_UNITARIO
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action desc-articulo (
            name: DESC_ARTICULO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT AR.DESCRIPCION
                      FROM STW_ARTICULOS AR
                     WHERE AR.ID = :ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action habilitar-descripcion-si-es-estandar (
            name: Habilitar Descripcion si es Estandar
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#DESC_ARTICULO").removeAttr('readonly','readonly'); 
                    $("#DESC_ARTICULO").removeClass('apex_disabled');
                    
                    $("#ID_MARCA").removeAttr('readonly','readonly'); 
