    dynamicAction setea-datos-proveedor (
        name: Setea Datos Proveedor
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: ID_PROVEEDOR
        }

        action id-tipo-entrega (
            name: ID_TIPO_ENTREGA
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PR.ID_TIPO_ENTREGA
                      FROM CMW_PROVEEDORES PR
                     WHERE PR.ID = :ID_PROVEEDOR
                       AND EXISTS (
                           SELECT 1
                             FROM STW_ARTICULOS AR
                            WHERE AR.ID = :ID_ARTICULO
                              AND NVL(AR.IND_PELIGROSO, 'N') = 'N'
                       )
                    UNION ALL
                    SELECT PR.ID_TIPO_ENTREGA_PELIGROSO
                      FROM CMW_PROVEEDORES PR
                     WHERE PR.ID = :ID_PROVEEDOR
                       AND EXISTS (
                           SELECT 1
                             FROM STW_ARTICULOS AR
                            WHERE AR.ID = :ID_ARTICULO
                              AND NVL(AR.IND_PELIGROSO, 'N') = 'S'
                       )
                       
                    
                    ```
                itemsToSubmit: [
                    ID_PROVEEDOR
                    ID_ARTICULO
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: ID_TIPO_ENTREGA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action moneda-condicion-proveedor (
            name: Moneda, Condicion, Proveedor
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PR.ID_MONEDA, PR.ID_CONDICION_COMPRA, NVL(PE.NOMB_FANTASIA, PE.NOMBRE)
                      FROM CMW_PROVEEDORES PR
                      JOIN BSW_PERSONAS    PE ON PE.ID = PR.ID_PERSONA
                     WHERE PR.ID = :ID_PROVEEDOR
                    ```
                itemsToSubmit: ID_PROVEEDOR
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: [
                    ID_MONEDA_COSTO
                    ID_CONDICION_COMPRA
                    PROVEEDOR
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-cambio-costo (
        name: Setear Cambio Costo
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: ID_MONEDA_COSTO
        }

        action cambio (
            name: Cambio
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                        RETURN FTIPOS_CAMBIO(:ID_MONEDA_COSTO,SYSDATE,'C','V');
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RAISE_APPLICATION_ERROR(-20000,'Error al encontrar el cambio de la moneda');
                    END;
                    ```
                itemsToSubmit: ID_MONEDA_COSTO
            }
            affectedElements {
                selectionType: columns
                columns: TIP_CAMBIO_COSTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                column: ID_MONEDA_COSTO
            }
        )

    )

