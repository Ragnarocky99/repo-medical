        computation {
            sqlQuery:
                ```sql
                SELECT NVL(SUM(VOLUMEN), 0) - REPLACE(:P763_VOLUMEN, '.', '')
                  FROM LCW_OFERTAS
                 WHERE ID_LICITACION_DET = :P763_ID
                   AND IND_ENVIO = 'S'
