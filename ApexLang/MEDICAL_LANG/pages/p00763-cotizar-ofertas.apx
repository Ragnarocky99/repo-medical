        action ind-historico-cotiza (
            name: IND_HISTORICO_COTIZA
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VEXISTE VARCHAR2(1);
                    BEGIN
                        BEGIN
                            SELECT 'S'
                              INTO VEXISTE
                              FROM CMW_HISTORICO_COTIZA_AUTO H
                             WHERE H.ID_ARTICULO = :ID_ARTICULO
                               AND NVL(H.IND_NO_VIGENTE, 'N') = 'N'
                               AND ROWNUM = 1;
                        EXCEPTION
                            WHEN OTHERS THEN
                                VEXISTE := 'N';
                        END;
                        RETURN VEXISTE;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: IND_HISTORICO_COTIZA
            }
            execution {
                sequence: 120
                fireOnInit: false
            }
        )

    )

