page 757 (
    name: Reporte de Agendamientos
    alias: REPORTE-DE-AGENDAMIENTOS
    title: Reporte de Agendamientos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region reporte-de-agendamientos (
        name: Reporte de Agendamientos
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CLWV_AGENDAMIENTOS
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FECHA BETWEEN :P757_FEC_INI AND :P757_FEC_FIN
                ```
            pageItemsToSubmit: [
                P757_FEC_INI
                P757_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 750
                items: {
                    P750_ID: #ID_AGENDA#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 27720991499495706
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_CLIENTE (
            type: hidden
            heading {
                heading: Cod Cliente
            }
            layout {
                sequence: 37
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COD_VENDEDOR (
            type: hidden
            heading {
                heading: Cod Vendedor
            }
            layout {
                sequence: 57
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CREADO_POR (
            type: plainText
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 77
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column FECHA (
            type: plainText
            heading {
                heading: Fecha
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column HORA (
            type: plainText
            heading {
                heading: Hora
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_AGENDA (
            type: hidden
            heading {
                heading: Id Agenda
            }
            layout {
                sequence: 67
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_CLIENTE (
            type: hidden
            heading {
                heading: Id Cliente
            }
            layout {
                sequence: 27
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 17
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_VENDEDOR (
            type: hidden
            heading {
                heading: Id Vendedor
            }
            layout {
                sequence: 47
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column PARTICIPANTES (
            type: plainText
            heading {
                heading: Participantes
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column VENDEDOR (
            type: plainText
            heading {
                heading: Vendedor
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reporte de Agendamientos
        }

        savedReport 277241 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLIENTE (
                sequence: 2
            )

            displayColumn CREADO_POR (
                sequence: 8
            )

            displayColumn ESTADO (
                sequence: 7
            )

            displayColumn FECHA (
                sequence: 4
            )

            displayColumn HORA (
                sequence: 5
            )

            displayColumn PARTICIPANTES (
                sequence: 6
            )

            displayColumn TIPO (
                sequence: 1
            )

            displayColumn VENDEDOR (
                sequence: 3
            )

        )

    )

    pageItem P757_FEC_FIN (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P757_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-de-agendamientos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

