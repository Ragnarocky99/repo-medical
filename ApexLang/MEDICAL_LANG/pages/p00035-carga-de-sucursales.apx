page 35 (
    name: Carga de Sucursales
    alias: CARGA-DE-SUCURSALES
    title: Carga de Sucursales
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-sucursales (
        name: Carga de Sucursales
        type: form
        source {
            location: localDatabase
            tableName: BSW_SUCURSALES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P35_CASILLA_CORREO (
        type: textField
        label {
            label: <p>Casilla Correo:
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 250
            region: @carga-de-sucursales
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 15
        }
        source {
            formRegion: @carga-de-sucursales
            column: CASILLA_CORREO
            dataType: varchar2
        }
    )

