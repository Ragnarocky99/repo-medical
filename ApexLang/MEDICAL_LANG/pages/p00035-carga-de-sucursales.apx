    pageItem P35_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-sucursales
            slot: regionBody
        }
        source {
            formRegion: @carga-de-sucursales
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_SUCURSALES_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P35_ID_BARRIO (
        type: popupLov
        label {
            label: <p>Barrio:</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION||'('||COD_BARRIO||')',ID FROM BSW_BARRIOS WHERE
                ID_PAIS=:P35_ID_PAIS AND ID_PROVINCIA=:P35_ID_PROVINCIA AND ID_CIUDAD=:P35_ID_CIUDAD
                ```
        }
        cascadingLov {
            parentItems: [
                P35_ID_CIUDAD
                P35_ID_PROVINCIA
                P35_ID_PAIS
            ]
            itemsToSubmit: [
                P35_ID_PAIS
                P35_ID_PROVINCIA
                P35_ID_CIUDAD
            ]
        }
        layout {
            sequence: 180
            region: @carga-de-sucursales
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-sucursales
            column: ID_BARRIO
            dataType: number
        }
    )

