        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Recibos
        }

        savedReport 249926 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ANULADO (
                sequence: 11
            )

            displayColumn ASIENTOS (
                sequence: 10
            )

            displayColumn COMENTARIO (
                sequence: 9
            )

            displayColumn FEC_RECIBO (
                sequence: 3
            )

            displayColumn ID_CLIENTE (
                sequence: 4
            )

            displayColumn ID_COBRADOR (
                sequence: 5
            )

            displayColumn ID_MONEDA (
                sequence: 6
            )

            displayColumn NRO_RECIBO (
                sequence: 2
            )

            displayColumn SER_RECIBO (
                sequence: 1
            )

            displayColumn TIP_CAMBIO (
                sequence: 7
            )

            displayColumn TOT_RECIBO (
                sequence: 8
            )

        )

