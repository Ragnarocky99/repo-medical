    pageItem P162_FEC_FIN (
        type: datePicker
        label {
            label: <p>Fecha Hasta: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
    )

    pageItem P162_FEC_INI (
        type: datePicker
        label {
            label: <p>Fecha desde: </p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/01/'||to_char(sysdate,'YYYY') from dual
        }
    )

    pageItem P162_NRO_RECIBO (
        type: textField
