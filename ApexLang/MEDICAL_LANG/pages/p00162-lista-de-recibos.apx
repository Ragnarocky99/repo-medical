page 162 (
    name: Recibos
    alias: LISTA-DE-RECIBOS
    title: Recibos - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: FILTROS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region recibos (
        name: Recibos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       SER_RECIBO,
                       NRO_RECIBO,
                       FEC_RECIBO,
                       FEC_COBRO,
                       ID_CLIENTE,
                       ID_COBRADOR,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ID_USUARIO,
                       ANULADO,
                       CASE ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       FEC_ANULACION,
                       ID_MOV_CAJ,
                       ESTADO,
                       FEC_ESTADO,
                       TOT_RECIBO,
                       FEC_ANULADO,
                       ACTUALIZADO_POR,
                       COMENTARIO,
                       ID_COBRADOR_ORI,
                       FEC_AUTORIZADO,
                       DIAS_AUTORIZADO,
                       COD_USUARIO_AUD,
                       TIP_RECIBO,
                       IND_IMPRESO,
                       ID_CORPORACION,
                       ID_COMP_REF_MORA,
                       TOTAL_MORA,
                       TOTAL_CARTA,
                       ID_CONCEPTO,
                       ID_TRANSFERENCIA_CLIE,
                       TRANSAC_PRONET,
                       ID_TALONARIO,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       IND_PARA_REPARTO,
                       IND_PLANILLA_ASO,
                       ID_PLANILLA_ASO,
                       ID_HABILITACION,
                
                 TO_NUMBER(REPLACE(REPLACE(ASIENTOS,'*'),'cobros')) ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(ASIENTOS,'*'),'cobros'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(FEC_RECIBO)--V.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = ID_EMPRESA) ASIENTO_ID
                
                  from CCW_RECIBOS
                 where ID_EMPRESA=:P0_COD_EMPRESA
                   AND (FEC_RECIBO BETWEEN :P162_FEC_INI AND :P162_FEC_FIN)
                   AND (ID_SUCURSAL = :P162_SUCURSAL OR :P162_SUCURSAL IS NULL)
                   AND (NRO_RECIBO = :P162_NRO_RECIBO OR :P162_NRO_RECIBO IS NULL)
                
                 ORDER BY NRO_RECIBO DESC
                ```
            pageItemsToSubmit: [
                P162_FEC_INI
                P162_FEC_FIN
                P162_SUCURSAL
                P162_NRO_RECIBO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 170
                items: {
                    P170_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 24974758998743701
        }

