        }
        layout {
            sequence: 60
            slot: body
            alignment: left
            column: 9
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G999G999G990
            width: 30
        }
        advanced {
            cssClasses: totalesp
        }
        sessionState {
            storage: request
        }
    )

    button calculo (
        buttonName: CALCULO
        label: Cálculo de Comisiones
        layout {
            sequence: 10
            region: @filtro
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapLeft
                t-Button--gapTop
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 500
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button consultar (
        buttonName: CONSULTAR
        label: Consultar
        layout {
            sequence: 10
            region: @filtro
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapLeft
                t-Button--gapTop
            ]
            icon: fa-circle-arrow-out-east
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @filtro
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message:
                ```html
                Está a punto de borrar las comisiones del periodo del &P500_FEC_INICIAL. al &P500_FEC_FINAL..<br>
                ¿Está seguro que desea continuar?
                ```
            style: warning
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button print (
        buttonName: PRINT
        label: Imprimir
        layout {
            sequence: 10
            region: @filtro
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapLeft
                t-Button--gapTop
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction calcula-monto (
        name: CALCULA MONTO
        execution {
            sequence: 50
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-de-calculo-de-comisiones
            columns: MONTO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MONTO
                itemsToSubmit: MONTO
            }
            affectedElements {
                selectionType: columns
                columns: MONT_COPIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-total (
        name: CALCULAR_TOTAL
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @consultar
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calculaTotales();
            }
            affectedElements {
                selectionType: items
                items: P502_TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction reaccion-grilla (
        name: Reaccion Grilla
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar (
        name: REFRESCAR
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @consultar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @carga-de-calculo-de-comisiones
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction set-fechas (
        name: set fechas
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P502_PERIODO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT FEC_INICIAL, FEC_FINAL
                    FROM FVW_PERIODOS_COMISION
                    WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    ```
                itemsToSubmit: P502_PERIODO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P502_FEC_INICIAL
                    P502_FEC_FINAL
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-total (
        name: SET TOTAL
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @consultar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT SUM(MONTO)
                    INTO :P502_TOTAL
                    FROM FVW_COMISIONES_VENTAS
                    WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    AND NRO_PERIODO = :P502_PERIODO
                    AND (ID_VENDEDOR = :P502_ID_VENDEDOR OR :P502_ID_VENDEDOR IS NULL);
                    ```
                itemsToSubmit: [
                    P502_PERIODO
                    P502_ID_VENDEDOR
                ]
                itemsToReturn: P502_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction validacion-periodo-vacio (
        name: Validacion Periodo Vacio
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: Debe cargar un periodo
                style: warning
                okLabel: OK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P502_PERIODO
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PRINT
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P502_PERIODO
            }
        )

    )

    computation p502-direccion-ip (
        itemName: P502_DIRECCION_IP
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL
        }
    )

    process borrar (
        name: Borrar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                      delete fvw_comisiones_ventas
                       where  id_empresa = :P0_ID_empresa
                         and  nro_periodo = :P502_periodo
                         and (ID_vendedor = :P502_ID_vendedor or :P502_ID_vendedor is null);
                    EXCEPTION
                      when others then
                        RAISE_APPLICATION_ERROR(-20000, 'No se pudieron borrar las comisiones para el periodo '||sqlerrm);
                    END;
                    commit;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 68968835488116415
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: GO TO PAGE 511
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 511
                items: {
                    P0_ID_EMPRESA: &P0_ID_EMPRESA.
                    P502_ID_VENDEDOR: &P502_ID_VENDEDOR.
                    P502_PERIODO: &P502_PERIODO.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @print
        }
    )

)

