            event: focusin
            selectionType: items
            items: P185_NOMBRE_FANTASIA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    if :P185_NOMBRE is not null and :P185_NOMBRE_FANTASIA is null then
                        :P185_NOMBRE_FANTASIA := :P185_NOMBRE;
                        return :P185_NOMBRE_FANTASIA;
                    end if;
                    return :P185_NOMBRE_FANTASIA;
                    ```
                itemsToSubmit: [
                    P185_NOMBRE
                    P185_NOMBRE_FANTASIA
                ]
            }
            affectedElements {
                selectionType: items
                items: P185_NOMBRE_FANTASIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction validar-ruc (
        name: Validar RUC
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P185_RUC
        }

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró el RUC
                style: warning
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P185_BANDERA
                value: 0
            }
        )

        action native-alert-2 (
            action: alert
            settings {
                title: Atención
                message: &P185_MENSAJE_VALIDACION.
                style: warning
                icon: fa-warning
                okLabel: Aceptar
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P185_MENSAJE_VALIDACION
            }
        )

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P185_CI
                    P185_TIPO_PERSONA
                    P185_NOMBRE
                    P185_NOMBRE_FANTASIA
                    P185_TIPO_CLIENTE
                    P185_DIRECCION
                    P185_TELEFONO
                    P185_VENDEDOR
                ]
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P185_BANDERA
                value: 0
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P185_TIPO_PERSONA
                    P185_NOMBRE
                    P185_NOMBRE_FANTASIA
                    P185_TIPO_CLIENTE
                    P185_DIRECCION
                    P185_TELEFONO
                    P185_VENDEDOR
                ]
            }
            execution {
                sequence: 50
            }
            clientSideCondition {
                type: item=value
                item: P185_BANDERA
                value: 1
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P185_TIPO_PERSONA
                    P185_NOMBRE
                    P185_NOMBRE_FANTASIA
                    P185_TIPO_CLIENTE
                    P185_DIRECCION
                    P185_TELEFONO
                    P185_VENDEDOR
                ]
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P185_BANDERA
                value: 1
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera number:=0;
                    BEGIN 
                    IF :P185_RUC IS NOT NULL THEN
                        SELECT NVL((SELECT 1 FROM CONTRIBUYENTES WHERE RUC||'-'||DV = :P185_RUC),0) 
                        AS BANDERA 
                        INTO vbandera
                        FROM DUAL;
                        :P185_BANDERA := VBANDERA;
                            
                         end if;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(-20000,'No se encontro el RUC'||:P185_BANDERA);
                    END;
                    
                    declare
                    VPERSONA VARCHAR2(200);
                    
                    
                    begin
                    IF :P185_RUC IS NOT NULL THEN
                      SELECT 1
                        INTO VPERSONA
                        FROM BSW_PERSONAS P
                        WHERE P.RUC = :P185_RUC
                        AND ROWNUM=1;
                        IF VPERSONA = 1 THEN
                            RAISE_APPLICATION_ERROR (-20000, 'Este numero de documento ya está asignado a una persona: ' || VPERSONA);
                        END IF;
                    end if ;
                       EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                        NULL;
                    end;
                    ```
                itemsToSubmit: P185_RUC
                itemsToReturn: P185_BANDERA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nombre from contribuyentes c
                    where c.ruc||'-'||c.dv = :P185_RUC
                    ```
                itemsToSubmit: P185_RUC
            }
            affectedElements {
                selectionType: items
                items: P185_NOMBRE
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P185_BANDERA
                value: 1
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nombre from contribuyentes c
                    where c.ruc||'-'||c.dv = :P185_RUC
                    ```
                itemsToSubmit: P185_RUC
            }
            affectedElements {
                selectionType: items
                items: P185_NOMBRE_FANTASIA
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P185_BANDERA
                value: 1
            }
            serverSideCondition {
                type: never
            }
        )

        action validacion-actualizada (
            name: VALIDACION_ACTUALIZADA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vci            VARCHAR2(12);
                        vcontribuyente NUMBER(2):=0;
                        vpersona       NUMBER(2):=0;
                        vnombre_cli    VARCHAR2(200);
                        vestado_ruc    VARCHAR2(100);
                        vmensaje       VARCHAR2(250);
                        --vbandera       NUMBER(2);
                    
                    BEGIN
                        IF :P185_RUC IS NOT NULL AND (instr(:P185_RUC,'-',1) > 0 ) THEN
                    
                            IF length(:P185_RUC) = 7 THEN -- CI DE 5 DÍGITOS
                              
                                vci := SUBSTR(:P185_RUC,1,5);
                                
                            ELSE IF length(:P185_RUC) = 8 THEN -- CI DE 6 DÍGITOS
                              
                                 vci := SUBSTR(:P185_RUC,1,6);
                                 
                                 ELSE IF length(:P185_RUC) = 9 THEN -- CI DE 7 DÍGITOS
                                   
                                      vci := SUBSTR(:P185_RUC,1,7);
                                      
                                      ELSE IF length(:P185_RUC) = 10 THEN -- CI DE 8 DÍGITOS
                                        
                                           vci := SUBSTR(:P185_RUC,1,8);
                                           
                                           END IF;
                               
                                      END IF;
                                 END IF;
                            END IF;
                            
                            :P185_CI := vci;
                            
                            SELECT NVL((SELECT 1 
                                        FROM BSW_PERSONAS P,  CCW_CLIENTES C
                                        WHERE P.RUC = :P185_RUC
                                          AND C.ID_PERSONA = P.ID 
                                          AND C.ESTADO = 'A' 
                                          AND ROWNUM=1
                                        ),0)
                              INTO vpersona
                            FROM DUAL;
                    
                            SELECT NVL((SELECT 1 FROM CONTRIBUYENTES WHERE RUC||'-'||DV = :P185_RUC),0) 
                            AS BANDERA 
                             INTO vcontribuyente
                            FROM DUAL;
                            --:P185_BANDERA:= vcontribuyente;
                            IF vcontribuyente = 1 AND vpersona = 1 THEN
                                vcontribuyente := 0;
                                vpersona := 1;
                            END IF;
                            IF vcontribuyente = 0 AND vpersona = 1 THEN
                              
                                :P185_BANDERA:= vpersona;
                                --:P392_BANDERA_RUC_GUARDADO := 0;
                                
                                SELECT C.ID AS ID_CLI, P.NOMBRE
                                  INTO :P185_ID_CLIENTE, vnombre_cli
                                FROM BSW_PERSONAS P, CCW_CLIENTES C
                                WHERE P.RUC = :P185_RUC
                                  AND C.ID_PERSONA = P.ID
                                  AND C.ESTADO = 'A';
                    
                                :P185_NOMBRE := vnombre_cli;
                                :P185_NOMBRE_FANTASIA := vnombre_cli;              
                    
                            ELSE IF vcontribuyente = 1 AND vpersona = 0 THEN
                                    :P185_BANDERA:= vcontribuyente;
                    
                                    --INSERT
                                    SELECT C.NOMBRE, C.ESTADO
                                      INTO vnombre_cli, vestado_ruc
                                    FROM CONTRIBUYENTES C
                                    WHERE C.RUC||'-'||DV = :P185_RUC;
                    
                                    :P185_NOMBRE := vnombre_cli;
                                    :P185_NOMBRE_FANTASIA := vnombre_cli;
                    
                                    IF vestado_ruc != 'ACTIVO' THEN
                                       vmensaje := 'El RUC se encuentra ' || vestado_ruc || '.';
                                       :P185_MENSAJE_VALIDACION := vmensaje;
                                    END IF;
                                    
                                    --:P392_BANDERA_RUC_GUARDADO := vbandera;
                    
                                 ELSE IF vcontribuyente = 0 AND vpersona = 0 THEN
                                        :P185_BANDERA := 0;
                                      --ELSE
                                        --RAISE_APPLICATION_ERROR(-20000,'No se ha encontrado el RUC: '||:P185_RUC);
                                      END IF;
                                 END IF;
                            END IF;
                        ELSE
                            RAISE_APPLICATION_ERROR(-20000, 'Favor cargar un ruc válido.');
                        END IF;
                        :P185_BANDERA := 1;
                    END;
                    
                    ```
                itemsToSubmit: P185_RUC
                itemsToReturn: [
                    P185_BANDERA
                    P185_MENSAJE_VALIDACION
                    P185_NOMBRE
                    P185_NOMBRE_FANTASIA
                    P185_CI
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation ci-ya-existe (
        name: CI ya existe
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                VPERSONA VARCHAR2 (200);
                
                BEGIN
                IF :P185_CI IS NOT NULL THEN
                    SELECT 1
                    INTO VPERSONA
                    FROM BSW_PERSONAS
                    WHERE NRO_CI = :P185_CI
                    AND ROWNUM=1;
                    IF VPERSONA = 1 THEN
                        RETURN FALSE;
                    ELSE
                        RETURN TRUE;
                    END IF;
                END IF;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: CI ya existe
        }
    )

    validation ruc-existe (
        name: RUC Existe
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                VPERSONA VARCHAR2 (200);
                BEGIN
                IF :P185_RUC IS NOT NULL THEN
                    SELECT 1
                    INTO VPERSONA
                    FROM BSW_PERSONAS P
                    WHERE P.RUC = :P185_RUC
                    AND ROWNUM=1;
                    IF VPERSONA = 1 THEN
                        RETURN FALSE;
                    ELSE
                        RETURN TRUE;
                    END IF;
                END IF;
                exception
                when no_data_found THEN
                RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: RUC ya existe
        }
    )

    validation ruc-invalido (
        name: RUC Invalido
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                VBANDERA NUMBER:=0;
                BEGIN
                IF :P185_RUC IS NOT NULL THEN
                SELECT NVL((SELECT 1 FROM CONTRIBUYENTES WHERE RUC||'-'||DV =:P185_RUC),0) 
                AS BANDERA 
                INTO VBANDERA
                FROM DUAL ;
                IF VBANDERA = 1 THEN 
                RETURN TRUE;
                ELSE 
                RETURN FALSE;
                END IF;
                END IF;
                END;
                ```
        }
        error {
            errorMessage: RUC no es valido
        }
        serverSideCondition {
            type: never
        }
    )

    process crear-cliente (
        name: Crear Cliente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                v_id number;
                
                begin
                
                    IF :P185_RUC IS NOT NULL THEN
                        :P185_TIENE_RUC := 'S';
                    END IF;
                
                    INSERT INTO BSW_PERSONAS(COD_PERSONA, 
                                             NOMBRE, 
                                             NOMB_FANTASIA, 
                                             DIRECCION, 
                                             TELEFONO, 
                                             RUC, 
                                             NRO_CI, 
