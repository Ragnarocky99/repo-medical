    dynamicAction agregar-ci (
        name: Agregar CI
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P185_CI
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P185_TIPO_PERSONA
                    P185_DIRECCION
                    P185_NOMBRE
                    P185_TELEFONO
                    P185_NOMBRE_FANTASIA
                    P185_TIPO_CLIENTE
                    P185_VENDEDOR
                    P185_RUC
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P185_CI
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    VPERSONA VARCHAR2 (200);
                    
                    begin
                    IF :P185_CI IS NOT NULL THEN
                      SELECT 1
                        INTO VPERSONA
                        FROM BSW_PERSONAS 
                        WHERE NRO_CI = :P185_CI
                        AND ROWNUM=1;
                        IF VPERSONA = 1 THEN
                            RAISE_APPLICATION_ERROR (-20000, 'Este numero de documento ya está asignado a una persona: ' || VPERSONA);
                        END IF;
                    end if ;
                       EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                        NULL;
                    end;
                    ```
                itemsToSubmit: P185_CI
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction desactivar (
        name: Desactivar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P185_MENSAJE_VALIDACION
            }
            execution {
                sequence: 10
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P185_TIPO_PERSONA
                    P185_NOMBRE
                    P185_NOMBRE_FANTASIA
                    P185_TIPO_CLIENTE
                    P185_DIRECCION
                    P185_TELEFONO
                    P185_VENDEDOR
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction traer-nombre (
        name: Traer Nombre
        execution {
            sequence: 40
        }
