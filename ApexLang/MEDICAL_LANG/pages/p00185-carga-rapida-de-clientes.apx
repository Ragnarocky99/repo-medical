                                             TIENE_RUC,
                                             DIREC_ELECTRONICA)
                                     VALUES (:P185_COD_PERSONA, 
                                             :P185_NOMBRE, 
                                             :P185_NOMBRE_FANTASIA, 
                                             :P185_DIRECCION, 
                                             :P185_TELEFONO, 
                                             :P185_RUC,
                                             :P185_CI, 
                                             :P185_TIPO_PERSONA, 
                                             :P185_TIENE_RUC,
                                             :P185_EMAIL);
                
                    SELECT ID 
                       INTO v_id
                    FROM bsw_personas
                    WHERE cod_persona = :P185_COD_PERSONA;
                
                    INSERT INTO CCW_CLIENTES(ID, 
                                             ID_EMPRESA, 
                                             COD_CLIENTE, 
                                             ID_PERSONA, 
                                             ID_VENDEDOR,
                                             ESTADO, 
                                             ID_TIP_CLIENTE,
                                             ID_LISTAS_PRECIOS,
                                             ID_CONDICION_VENTA, 
                                             COD_USUARIO_AUD)
                                     VALUES (:P185_ID_CLIENTE, 
                                             :P0_COD_EMPRESA, 
                                             :P185_COD_CLIENTE, 
                                             V_ID,
                                             :P185_VENDEDOR, 
                                             'A', 
                                             :P185_TIPO_CLIENTE, 
                                             TRAE_ID_LISTA_PRECIO(:P0_ID_EMPRESA, '1'),
                                             TRAE_ID_CONDICION_VEN(:P0_ID_EMPRESA,'0'),
                                             :APP_USER);
                END;
