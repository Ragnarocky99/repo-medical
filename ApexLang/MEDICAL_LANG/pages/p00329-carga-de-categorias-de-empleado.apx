page 329 (
    name: Carga de Categorias de Empleado
    alias: CARGA-DE-CATEGORIAS-DE-EMPLEADO
    title: Carga de Categorias de Empleado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-categorias-de-empleado (
        name: Carga de Categorias de Empleado
        type: form
        source {
            location: localDatabase
            tableName: RHW_CATEGORIAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P329_COD_CATEGORIA (
        type: textField
        label {
            label: <p>Código Categoría: </p>
            alignment: left
        }
        layout {
            sequence: 340
            region: @carga-de-categorias-de-empleado
            slot: regionBody
            alignment: left
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-categorias-de-empleado
            column: COD_CATEGORIA
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT MAX(TO_NUMBER(C.COD_CATEGORIA)) + 1 FROM RHW_CATEGORIAS C WHERE C.ID_EMPRESA=:P0_COD_EMPRESA;
        }
    )

    pageItem P329_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 330
            region: @carga-de-categorias-de-empleado
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categorias-de-empleado
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P329_DESCRIPCION (
        type: textarea
        label {
            label: <p>Descripción: </p>
            alignment: left
        }
        layout {
            sequence: 350
            region: @carga-de-categorias-de-empleado
            slot: regionBody
            alignment: left
            column: 4
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-categorias-de-empleado
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P329_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-categorias-de-empleado
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categorias-de-empleado
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P329_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-categorias-de-empleado
            slot: regionBody
        }
        source {
            formRegion: @carga-de-categorias-de-empleado
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P329_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P329_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P329_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 13056142196290140
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-categorias-de-empleado (
        name: Initialize form Carga de Categorias de Empleado
        type: formInitialization
        formRegion: @carga-de-categorias-de-empleado
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13055392172290140
        }
    )

    process process-form-carga-de-categorias-de-empleado (
        name: Process form Carga de Categorias de Empleado
        type: formAutoRowProcessing
        formRegion: @carga-de-categorias-de-empleado
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13055792290290140
        }
    )

)

