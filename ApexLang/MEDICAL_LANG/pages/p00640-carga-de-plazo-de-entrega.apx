page 640 (
    name: Carga de plazo de entrega
    alias: CARGA-DE-PLAZO-DE-ENTREGA
    title: Carga de plazo de entrega
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P640_COD_TIPO_ENTREGA").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 225px;
            height: 23px;
            vertical-align: bottom;
            border-style: dashed;
            font-weight: lighter;
            font-size: 13px;
            text-align: center;
            border-width: thin;
            border-color: #afa9a9;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-plazo-de-entrega (
        name: Carga de plazo de entrega
        type: form
        source {
            location: localDatabase
            tableName: CMW_TIPO_ENTREGA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P640_ACTIVO (
        type: switch
        label {
            label: <p>Activo: </p>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: Si
            offValue: N
            offLabel: No
        }
        layout {
            sequence: 70
            region: @carga-de-plazo-de-entrega
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-plazo-de-entrega
            column: ACTIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P640_COD_TIPO_ENTREGA (
        type: numberField
        label {
            label: <P>Código: </P>
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 30
            region: @carga-de-plazo-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @carga-de-plazo-de-entrega
            column: COD_TIPO_ENTREGA
            dataType: varchar2
        }
    )

    pageItem P640_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: </p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-plazo-de-entrega
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-plazo-de-entrega
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P640_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-plazo-de-entrega
            slot: regionBody
        }
        source {
            formRegion: @carga-de-plazo-de-entrega
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P640_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-plazo-de-entrega
            slot: regionBody
        }
        source {
            formRegion: @carga-de-plazo-de-entrega
            column: ID_EMPRESA
            dataType: number
            primaryKey: true
        }
        default {
            type: item
            item: P0_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P640_NRO_DIAS (
        type: numberField
        label {
            label: <p>Nro Dias</p>
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 60
            region: @carga-de-plazo-de-entrega
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @carga-de-plazo-de-entrega
            column: NRO_DIAS
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P640_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: t-Button--danger
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P640_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P640_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p640-cod-tipo-entrega (
        itemName: P640_COD_TIPO_ENTREGA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT  NVL(MAX(TO_NUMBER(COD_TIPO_ENTREGA)), 0)+1
                FROM CMW_TIPO_ENTREGA
                WHERE ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P640_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 23316077535479821
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-plazo-de-entrega (
        name: Initialize form Carga de plazo de entrega
        type: formInitialization
        formRegion: @carga-de-plazo-de-entrega
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 23315299949479821
        }
    )

    process process-form-carga-de-plazo-de-entrega (
        name: Process form Carga de plazo de entrega
        type: formAutoRowProcessing
        formRegion: @carga-de-plazo-de-entrega
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23315663447479821
        }
    )

)

