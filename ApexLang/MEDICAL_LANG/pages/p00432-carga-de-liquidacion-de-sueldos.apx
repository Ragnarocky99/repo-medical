    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-anio (
        name: SETEAR_ANIO
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P432_FEC_LIQUID
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: TO_NUMBER(TO_CHAR(SYSDATE,'YYYY'))
                itemsToSubmit: P432_FEC_LIQUID
            }
            affectedElements {
                selectionType: items
                items: P432_ANIO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setear-mes (
        name: SETEAR_MES
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P432_FEC_LIQUID
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: TO_NUMBER(TO_CHAR(SYSDATE,'MM'))
                itemsToSubmit: P432_FEC_LIQUID
            }
            affectedElements {
                selectionType: items
                items: P432_MES
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p432-nro-liquid (
        itemName: P432_NRO_LIQUID
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number; 
                   begin
                   if :P432_NRO_LIQUID is null then
                      select nvl(max(NRO_LIQUID), 0) + 1
                         into v_numero
                         from RHW_LIQUIDACIONES;
                       RETURN v_numero;
                      end if; 
                      RETURN :P432_NRO_LIQUID;
                   exception
                      when no_data_found then
                        :P432_NRO_LIQUID  := 1 ;
                        RETURN :P432_NRO_LIQUID;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Tipos de Comprobantes' || sqlerrm ) ;
                   end ;
                ```
        }
    )

