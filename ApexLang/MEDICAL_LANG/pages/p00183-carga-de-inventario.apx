    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P183_FEC_FIN_INVENT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P183_FEC_FIN_INVENT) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P183_FEC_FIN_INVENT,'/','');
                            conv_fecha := substr(:P183_FEC_FIN_INVENT,1,2)||'/'||
                                                      substr(:P183_FEC_FIN_INVENT,3,2)||'/'||
                                                      lpad(substr(:P183_FEC_FIN_INVENT,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P183_FEC_FIN_INVENT := conv_fecha;
                            ELSIF (length(:P183_FEC_FIN_INVENT) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P183_FEC_FIN_INVENT) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P183_FEC_FIN_INVENT
                itemsToReturn: P183_FEC_FIN_INVENT
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

