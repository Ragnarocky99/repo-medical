                    SELECT L.NRO_LOTE,L.ID FROM STW_LOTES L,
                    STW_ARTICULOS A
                    WHERE L.ID_ARTICULO=:ID_ARTICULO
                    AND L.ID_EMPRESA=:P0_COD_EMPRESA 
                    AND A.ID=L.ID_ARTICULO
