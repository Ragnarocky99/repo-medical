    computation p183-num-invent (
        itemName: P183_NUM_INVENT
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_numero number;
                begin
                if :P183_NUM_INVENT IS NULL THEN 
                SELECT nvl(MAX(NUM_INVENT),0)+1  
                into v_numero
                FROM STW_INVENT_CAB
                WHERE ID_EMPRESA=:P0_COD_EMPRESA;
                return v_numero;
                END IF;
                RETURN :P183_NUM_INVENT;
                EXCEPTION 
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(20000,'Error en la tabla de inventario');
                end;
                ```
        }
    )

