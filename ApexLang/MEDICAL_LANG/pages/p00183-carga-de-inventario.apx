    dynamicAction cargar-datos-del-articulo (
        name: Cargar Datos del Articulo
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @inventario
            columns: ID_ARTICULO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ID_UNIDAD_MEDIDA FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA AND
                    ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_UNIDAD_MEDIDA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM 
                    STW_ARTICULOS WHERE
                    ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESCRIPCION
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ID_MONEDA_BASE FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_MONEDA
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value-4 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TRAE_COSTO_PROM(:P0_COD_EMPRESA,:ID_ARTICULO,sysdate)FROM DUAL;
                    
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: COSTO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-5 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ID
                    FROM STW_LOTES
                    WHERE ID_ARTICULO=:ID_ARTICULO
                    AND ID_EMPRESA=:P0_COD_EMPRESA
                    AND ROWNUM=1
