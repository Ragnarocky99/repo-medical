    validation validar-inventario (
        name: Validar Inventario
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare 
                v_bandera number:=0;
                begin
                SELECT 1
                INTO v_bandera
                 FROM STW_INVENT_CAB
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND IND_CERRADO='N'
                AND ID_SUCURSAL=:P0_COD_SUCURSAL
                AND ROWNUM=1;
                IF V_BANDERA=1 THEN
                RETURN FALSE;
                END IF;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                RETURN TRUE;
                END;
                ```
        }
        error {
            errorMessage: "Hay un inventario Activo ! "
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,OPEN
        }
    )

