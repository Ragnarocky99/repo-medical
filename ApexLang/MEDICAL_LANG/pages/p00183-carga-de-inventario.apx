    process realizar-conteo (
        name: Realizar Conteo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR CURSOR_DETALLE IS
                        SELECT I.ID_ARTICULO, I.ID_EMPRESA, I.ID_NUM_INVENT_CAB, SUM(NVL(I.CANT_FISICA,0)) CANT_FISICA,
                               I.COD_USUARIO_AUD, I.ID_LOTE, I.NRO_LOTE, I.LOTE_VENC, I.ID_UNIDAD_MEDIDA,I.ID_MONEDA,
                               I.TIP_CAMBIO
                          FROM STW_INVENT_DET_PROV I
                         WHERE I.ID_EMPRESA=:P0_COD_EMPRESA
                          AND I.ID_NUM_INVENT_CAB=:P183_ID
                        GROUP BY I.ID_ARTICULO,I.ID_LOTE,I.ID_NUM_INVENT_CAB,I.COD_USUARIO_AUD,I.NRO_LOTE,I.LOTE_VENC,
                                 I.ID_UNIDAD_MEDIDA,I.ID_MONEDA,I.TIP_CAMBIO,I.ID_EMPRESA;
                BEGIN
                    FOR ITEM_DETALLE IN CURSOR_DETALLE
                    LOOP
                        BEGIN
                            INSERT INTO STW_INVENT_DET(ID_EMPRESA,ID_NUM_INVENT_CAB,CANT_FISICA,COD_USUARIO_AUD,ID_LOTE,NRO_LOTE,
                                                       LOTE_VENC,ID_UNIDAD_MEDIDA,ID_MONEDA,TIP_CAMBIO,COSTO,ID_ARTICULO,CANT_REAL)
                            VALUES (ITEM_DETALLE.ID_EMPRESA,ITEM_DETALLE.ID_NUM_INVENT_CAB,
                                    ITEM_DETALLE.CANT_FISICA,ITEM_DETALLE.COD_USUARIO_AUD,ITEM_DETALLE.ID_LOTE,ITEM_DETALLE.NRO_LOTE,ITEM_DETALLE.LOTE_VENC,
                                    ITEM_DETALLE.ID_UNIDAD_MEDIDA,ITEM_DETALLE.ID_MONEDA,ITEM_DETALLE.TIP_CAMBIO,TRAE_COSTO_PROM(:P0_COD_EMPRESA,ITEM_DETALLE.ID_ARTICULO,SYSDATE),ITEM_DETALLE.ID_ARTICULO,(SELECT NVL(SUM(CANT_DISPON),0)
                                                                                                                                                                                                               FROM STW_EXISTENCIA_ART
                                                                                                                                                                                                              WHERE ID_LOTE=ITEM_DETALLE.ID_LOTE
                                                                                                                                                                                                                AND ID_ARTICULO=ITEM_DETALLE.ID_ARTICULO
                                                                                                                                                                                                                AND ID_EMPRESA=:P0_ID_EMPRESA
                                                                                                                                                                                                                AND ID_SUCURSAL = :P183_ID_SUCURSAL));
                        EXCEPTION
                            WHEN OTHERS THEN
                                CONTINUE;
                        END;
                    END LOOP;
                EXCEPTION
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000,'ERROR NO SE PUDO REALIZAR EL CONTEO');
                END;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Conteo Realizada de Manera Correcta!
        }
        advanced {
            executionMappingIdentifier: 43298739487153625
        }
        serverSideCondition {
            whenButtonPressed: @count
        }
    )

