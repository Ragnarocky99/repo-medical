    process inventario-det-save-interactive-grid-data (
        name: INVENTARIO_DET - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @inventario
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                             
                         
                
                          
                                insert into STW_INVENT_DET
                                (ID_EMPRESA,ID_NUM_INVENT_CAB,ID_ARTICULO,CANT_REAL,CANT_FISICA,CANT_BLOQUEO,ORDEN,COD_USUARIO_AUD,ID_LOTE,NRO_LOTE,LOTE_VENC,
                                ID_UNIDAD_MEDIDA,CANTIDAD_UB,ID_MONEDA,TIP_CAMBIO,COSTO,OBSERVACION, IND_AJS_LOTE)
                                values(:P0_COD_EMPRESA,:P183_ID,:ID_ARTICULO,:CANT_REAL,:CANT_FISICA,:CANT_BLOQUE,:ORDEN,:APP_USER,:ID_LOTE,:NRO_LOTE,:LOTE_VENC,
                                :ID_UNIDAD_MEDIDA,:CANTIDA_UB,:ID_MONEDA,:TIP_CAMBIO,REPLACE(:COSTO,'.',''),:OBSERVACION, :IND_AJS_LOTE);
                            
                            WHEN 'U' then  
                         
                   
                
                 
                
                                update STW_INVENT_DET D
                                    set  D.ID_ARTICULO=:ID_ARTICULO,
                                         D.CANT_REAL=:CANT_REAL,
                                         D.CANT_FISICA=:CANT_FISICA,
                                         D.CANT_BLOQUEO=:CANT_BLOQUEO,
                                         D.ORDEN=:ORDEN,
                                         D.ID_LOTE=:ID_LOTE,
                                         D.NRO_LOTE=:NRO_LOTE,
                                         D.LOTE_VENC=:LOTE_VENC,
                                         D.ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                                         D.ID_MONEDA=:ID_MONEDA,
                                         D.TIP_CAMBIO=:TIP_CAMBIO,
                                         D.COSTO=REPLACE(:COSTO,'.',''),
                                         D.OBSERVACION=:OBSERVACION,
                                         D.IND_AJS_LOTE=:IND_AJS_LOTE
                                where   D.ID_NUM_INVENT_CAB = :P183_ID
                                    and D.id = :id;
                
                           when 'D' then
                                delete STW_INVENT_DET  d   
                                WHERE d.ID_NUM_INVENT_CAB = :ID_NUM_INVENT_CAB
                                           and d.id = :id;  
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 39369743231123817
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,CREATE
        }
    )

