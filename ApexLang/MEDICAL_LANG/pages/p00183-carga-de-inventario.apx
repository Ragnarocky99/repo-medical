    region inventario-cab (
        name: INVENTARIO_CAB
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NUM_INVENT,
                       FEC_INI_INVENT,
                       FEC_FIN_INVENT,
                       ID_SUCURSAL,
                       IND_CERRADO,
                       COD_USUARIO_AUD,
                       FEC_ALTA,
                       ID_SUCURSAL_CENTRAL
                  from STW_INVENT_CAB
                  WHERE ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region selector (
        name: Selector
        type: regionDisplaySelector
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            includeShowAll: false
            rememberSelection: bySession
        }
    )

