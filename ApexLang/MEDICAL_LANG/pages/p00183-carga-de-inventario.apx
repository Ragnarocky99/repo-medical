page 183 (
    name: Carga de Inventario
    alias: CARGA-DE-INVENTARIO
    title: Carga de Inventario
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var orden=0;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:13.5px;
                color:#3f46bb;
            }
            .mostrar{
                font-weight: bold;
                color: black;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region butones (
        name: Butones
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @inventario-cab
            slot: subRegions
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noUI
            ]
        }
    )

    region conteo-inventario (
        name: Conteo Inventario
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select I.ID,
                       I.ID_EMPRESA,
                       I.ID_NUM_INVENT_CAB,
                       I.ID_ARTICULO,
                       A.DESCRIPCION,
                       I.FEC_ALTA,
                       I.CANT_REAL,
                       I.CANT_FISICA,
                       I.CANT_BLOQUEO,
                       I.ORDEN,
                       I.COD_USUARIO_AUD,
                       I.ID_LOTE,
                       I.NRO_LOTE,
                       I.LOTE_VENC,
                       I.ID_UNIDAD_MEDIDA,
                       I.CANTIDAD_UB,
                       I.ID_MONEDA,
                       I.TIP_CAMBIO,
                       I.COSTO,
                      I.OBSERVACION
                  from STW_INVENT_DET_PROV I,STW_ARTICULOS A
                  WHERE ID_NUM_INVENT_CAB=:P183_ID
                  AND I.ID_ARTICULO=A.ID
                ```
            pageItemsToSubmit: P183_ID
        }
        layout {
            sequence: 20
            parentRegion: @selector
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        readOnly {
            type: item=value
            item: P183_IND_CERRADO
            value: S
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    orden=orden-1;
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                            };    
                       
                       
                                
                
                        } ;      
                        return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 42444295146537207
        }

