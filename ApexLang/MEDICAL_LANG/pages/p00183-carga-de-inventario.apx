    region inventario (
        name: Inventario
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select I.ID,
                       I.ID_EMPRESA,
                       I.ID_NUM_INVENT_CAB,
                       I.ID_ARTICULO,
                       A.DESCRIPCION,
                       A.ID_ENVASE,
                       A.ID_MARCA,
                       A.ID_RUBRO,
                       A.COD_ORIGEN_ART,
                       I.CANT_REAL,
                       I.CANT_FISICA,
                       I.CANT_BLOQUEO,
                       I.ORDEN,
                       I.COD_USUARIO_AUD,
                       I.ID_LOTE,
                       I.NRO_LOTE,
                       I.LOTE_VENC,
                       I.ID_UNIDAD_MEDIDA,
                       I.CANTIDAD_UB,
                       I.ID_MONEDA,
                       I.TIP_CAMBIO,
                       I.COSTO,
                      I.OBSERVACION,
                      (I.CANT_REAL - I.CANT_FISICA) as Diferencia,
                      I.IND_AJS_LOTE
                  from STW_INVENT_DET I,STW_ARTICULOS A
                  WHERE ID_NUM_INVENT_CAB=:P183_ID
                  AND I.ID_ARTICULO=A.ID
                ```
            pageItemsToSubmit: P183_ID
        }
        layout {
            sequence: 10
            parentRegion: @selector
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
