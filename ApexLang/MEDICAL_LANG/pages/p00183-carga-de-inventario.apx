    button count (
        buttonName: COUNT
        label: Confirmar Conteo
        layout {
            sequence: 10
            region: @inventario-cab
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: "Seguro que quiere confimrar el conteo ? "
            style: information
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button create (
        buttonName: CREATE
        label: Guardar
        layout {
            sequence: 10
            region: @botones
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P183_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @botones
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Desea eliminar el registro?
            style: warning
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P183_ID IS NOT NULL AND :P183_IND_CERRADO='S' THEN
                RETURN FALSE;
                ELSIF :P183_ID IS NOT NULL THEN 
                RETURN TRUE;
                END IF;
                ```
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button open (
        buttonName: OPEN
        label: Abrir Inventario
        layout {
            sequence: 20
