    dynamicAction calcular-factura-posible (
        name: Calcular Factura Posible
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: [
                P92_LIMITE_CREDITO
                P92_SALDO_ACTUAL
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: NVL(:P92_FACTURA_POSIBLE, REPLACE(:P92_LIMITE_CREDITO,'.','') - REPLACE(:P92_SALDO_ACTUAL,'.',''))
                itemsToSubmit: [
                    P92_LIMITE_CREDITO
                    P92_SALDO_ACTUAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P92_FACTURA_POSIBLE
            }
            execution {
                sequence: 10
            }
            comments {
                comments:
                    ```
                    https://stackoverflow.com/questions/49305860/apex-dynamic-action-change-field-value-based-on-another-field
                    
                    https://community.oracle.com/tech/developers/discussion/4174322/use-dynamic-action-to-update-a-field-when-another-field-s-is-updated
                    ```
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostrar-seleccion (
        name: mostrar_seleccion_1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P92_ID_PERSONA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT  P.NOMBRE,
                            P.NOMB_FANTASIA,
                            P.RUC,
                            P.NRO_CI,
                            P.TELEFONO,
                            P.DIRECCION
                    FROM BSW_PERSONAS P
                    WHERE P.ID = :P92_ID_PERSONA
                    ```
                itemsToSubmit: P92_ID_PERSONA
            }
            affectedElements {
                selectionType: items
                items: [
                    P92_NOMBRE
                    P92_NOMB_FANTASIA
                    P92_RUC
                    P92_NRO_CI
                    P92_TELEFONO
                    P92_DIRECCION
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultar-causal (
        name: Ocultar Causal
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P92_ESTADO
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                (apex.item('P92_ESTADO').getValue() === 'A' ||
                    apex.item('P92_ESTADO').isEmpty())
                ```
        }
        comments {
            comments:
                ```
                https://www.youtube.com/watch?v=hVvcsjq48qc&ab_channel=PacktVideo
                
                https://www.foxinfotech.in/2020/08/oracle-apex-client-side-condition-javascript-expression-example.html
                ```
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P92_ID_CAUSAL
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P92_ID_CAUSAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

