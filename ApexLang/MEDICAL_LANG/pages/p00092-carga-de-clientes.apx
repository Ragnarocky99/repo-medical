    pageItem P92_SALDO_ACTUAL (
        type: numberField
        label {
            label: <p>Saldo Actual:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @límite-de-crédito
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: 999G999G999G999G999G999G990
            width: 30
        }
        advanced {
            cssClasses: cambio
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT NVL(SUM(SALDO_CUOTA),0) FROM CCW_SALDOS 
                WHERE ID_CLIENTE=:P92_ID
                AND ID_EMPRESA=:P92_ID_EMPRESA
                AND SALDO_CUOTA<>0
                ```
            used: always
        }
    )

