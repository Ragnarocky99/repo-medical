page 92 (
    name: Carga de Clientes
    alias: CARGA-DE-CLIENTES
    title: Carga de Clientes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P92_NOMBRE").readOnly = true;
            document.getElementById("P92_NOMB_FANTASIA").readOnly = true;
            document.getElementById("P92_RUC").readOnly = true;
            document.getElementById("P92_NRO_CI").readOnly = true;
            document.getElementById("P92_TELEFONO").readOnly = true;
            document.getElementById("P92_DIRECCION").readOnly = true;
            document.getElementById("P92_NOMBRE_COBRADOR").readOnly = true;
            document.getElementById("P92_NOMBRE_VENDEDOR").readOnly = true;
            document.getElementById("P92_CREDITO_MINIMO").readOnly = true;
            document.getElementById("P92_SALDO_ACTUAL").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-clientes (
        name: Carga de Clientes
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CL.ID,
                       CL.ID_EMPRESA,
                       CL.COD_CLIENTE,
                       CL.ID_PERSONA,
                       CL.NOMB_FANTASIA,
                       CL.ID_MONEDA_LIMITE,
                       CL.LIMITE_CREDITO,
                       CL.ID_COBRADOR,
                       CL.ID_VENDEDOR,
                       CL.DIAS_COBRO,
                       CL.PLAZO,
                       CL.ID_ZONA,
                       CL.ESTADO,
                       CL.ID_USUARIO,
                       CL.FEC_ALTA,
                       CL.ENCARGADO,
                       CL.ID_JERARQUIA,
                       CL.ID_TIP_DOCUMENTO,
                       CL.ID_TIP_CLIENTE,
                       CL.FEC_ESTADO,
                       CL.COMENTARIO,
                       CL.TIPO_IMPUESTO,
                       CL.FEC_ULTIMA_COMPRA,
                       CL.ID_VENDEDOR_ORI,
                       CL.FEC_CVEND_ORI,
                       CL.CREDITO_MINIMO,
                       CL.RUTA_FIRMA,
                       CL.ID_CUENTA,
                       CL.CUENTAS_BANCARIAS,
                       CL.COD_USUARIO_AUD,
                       CL.ID_CONDICION_VENTA,
                       CL.ID_CAUSAL,
                       CL.ID_CORPORACION,
                       CL.NUM_DOCUMENTO,
                       CL.ID_SUBCUENTA,
                       CL.ID_CUENTA_US,
                       CL.IND_ES_SUCURSAL,
                       CL.IND_DEBITO_AUT,
                       CL.ID_ASOCIACION,
                       CL.IND_ASOCIACION,
                       CL.CAT_CLIENTE,
                       CL.ID_CALIFICACION,
                       CL.ID_SUCURSAL,
                       CL.IND_INFORMCONF,
                       CL.IND_LISTA_NEGRA,
                       CL.FAJA,
                       CL.IND_FRAUDE,
                       CL.IND_CRE_PREAPR,
                       CL.ID_RUBRO_CONTABLE,
                       CL.IND_COMISION,
                       CL.ID_ANTERIOR,
                       CL.LATITUD,
                       CL.LONGITUD,
                       CL.IMAGEN_FIRMA,
                       CL.MIMETYPE,
                       CL.FILENAME,
                       CL.ID_LISTAS_PRECIOS,
                	   (SELECT P1.NOMBRE FROM BSW_PERSONAS P1
                	   WHERE P1.ID=CO.ID_PERSONA) AS NOMBRE_COBRADOR,
                	   (SELECT P2.NOMBRE FROM BSW_PERSONAS P2 
                	   WHERE P2.ID=VE.ID_PERSONA) AS NOMBRE_VENDEDOR,
                       CL.IND_PROVEEDOR_ESTADO,
                       CL.ID_SOPORTE,
                       CL.NIVEL,
                       CL.POTENCIAL
                 from ccw_clientes CL
                left join CCW_COBRADORES CO ON CL.ID_COBRADOR=CO.ID
                left join FVW_VENDEDORES VE ON VE.ID=CL.ID_VENDEDOR
                INNER JOIN BSW_PERSONAS PE ON PE.ID=CL.ID_PERSONA 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

