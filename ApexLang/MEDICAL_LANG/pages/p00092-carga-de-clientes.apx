    computation p92-cod-cliente (
        itemName: P92_COD_CLIENTE
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_CLIENTE)),0)+1 
                FROM CCW_CLIENTES WHERE ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P92_ID
        }
    )

