    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @cheques-emitidos-en-caja
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cheques-emitidos-en-caja
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @cheques-emitidos-en-caja
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*$('td[headers="OPERACION"]').each(function() {
                      if ($(this).text() == 'Entregado') {
                        $(this).css({"color": "green"});
                      }
                    });*/
                    $('td[headers="OPERACION"]').each(function() {
                      var texto = $(this).text();
                      if (texto === 'Entregado') {
                        $(this).css("color", "green");
                      } else if (texto === 'Pendiente') {
                        $(this).css("color", "yellow");
                      } else if (texto === 'Anulado') {
                        $(this).css("color", "red");
                      }
                    });
                    
                    
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_2
