    region cheques-emitidos-en-caja (
        name: Cheques Emitidos  en Caja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                C.ID,
                C.ID_BANCO,
                C.SER_VALOR,
                C.NUM_VALOR,
                C.FEC_EMISION,
                C.FEC_VENCIMIENTO,
                C.TOT_VALOR,
                C.BENEFICIARIO,
                C.ESTADO,
                C.NRO_CUENTA,
                c.id_empresa,
                s.descripcion subtipo,
                CASE 
                        WHEN C.ANULADO = 'S' THEN 'Anulado'
                        WHEN C.IND_CONCILIADO = 'S' THEN 'Entregado'              
                        ELSE 'Pendiente'
                    END AS Estados,
                
                
                
                C.FEC_ANULACION
                
                
                
                from cpw_valores_cajas c, BSW_SUBTIPOS_TRANS S, BSW_TIPOS_TRANS T 
                WHERE C.ID_SUB_TIPO_TRANS = S.ID
                AND C.ID_EMPRESA = S.ID_EMPRESA
                AND S.TIP_DOCUMENTO = 'CHE'
                AND T.ID_EMPRESA = S.ID_EMPRESA
                AND S.ID_TIPO_TRANS  = T.ID
                AND T.TIPO_TRANS = w_busca_PARAMETRO('CP','COD_TRAN_PA')
                
                AND (C.ID_BANCO = :P594_BANCO OR :P594_BANCO IS NULL)
                
                AND (C.FEC_VENCIMIENTO >= :P594_PERIODO_VENCI_INI OR :P594_PERIODO_VENCI_INI IS NULL)
                AND (C.FEC_VENCIMIENTO <= :P594_PERIODO_VENCI_FIN OR :P594_PERIODO_VENCI_FIN IS NULL)
                AND (C.FEC_EMISION >= :P594_PERIODO_EMI_INI OR :P594_PERIODO_EMI_INI IS NULL)
                AND (C.FEC_EMISION <= :P594_PERIODO_EMI_FIN OR :P594_PERIODO_EMI_FIN IS NULL)
                
                --AND (C.ESTADO = :P594_ESTADO OR :P594_ESTADO IS NULL)
                AND (C.NUM_VALOR = :P594_NRO_CHEQUE OR :P594_NRO_CHEQUE IS NULL)
                AND (S.ID = :P594_SUBTIPO_TRANS or :P594_SUBTIPO_TRANS IS NULL)
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 595
                items: {
                    P595_ID: \#ID#\
                    P595_ID_EMPRESA: \#ID_EMPRESA#\
                    P595_BENEFICIARIO: \#BENEFICIARIO#\
                    P595_FEC_EMISION: \#FEC_EMISION#\
                    P595_FEC_VENCIMIENTO: \#FEC_VENCIMIENTO#\
                    P595_ESTADO: \#ESTADO#\
                    P595_NRO_CUENTA: \#NRO_CUENTA#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
