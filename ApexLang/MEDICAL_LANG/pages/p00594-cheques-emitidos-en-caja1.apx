                sequence: 10
            }
        )

    )

    branch (
        name: Go to Page 596
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 596
                items: {
                    P596_BANCO: &P594_BANCO.
                    P596_ESTADO: &P594_ESTADO.
                    P596_NRO_CHEQUE: &P594_NRO_CHEQUE.
                    P596_PERIODO_EMI_FIN: &P594_PERIODO_EMI_FIN.
                    P596_PERIODO_EMI_INI: &P594_PERIODO_EMI_INI.
                    P596_PERIODO_VENCI_FIN: &P594_PERIODO_VENCI_FIN.
                    P596_PERIODO_VENCI_INI: &P594_PERIODO_VENCI_INI.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

