page 284 (
    name: Ordenes de Pago
    alias: ORDENES-DE-PAGO
    title: Ordenes de Pago
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: FILTROS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region ordenes-de-pago (
        name: Ordenes de Pago
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.SER_ORDEN_PAGO,
                       C.NUM_ORDEN_PAGO,
                       C.FEC_EMISION,
                       C.FEC_VENCIMIENTO,
                       C.ID_USUARIO_AUTORIZ,
                       C.AUTORIZADO,
                       CASE C.AUTORIZADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AUTORIZADO_ICON,
                       C.ESTADO,
                       C.RETENIDO,
                       C.COD_USUARIO_AUD,
                       C.PORC_RET_IVA,
                       C.TOT_RET_IVA,
                       C.IND_PAGO_ADELANTADO,
                       C.GRAVADAS,
                       C.IVA,
                       C.ID_MOV_CAJ,
                       C.ID_PROVEEDOR,
                       C.FEC_AUTORIZADO,
                       C.IND_CAJA_CHICA,
                       C.ID_CUENTA_BANCARIA,
                       C.ID_CONSIGNACION,
                       C.ID_MONEDA,
                       C.ID_SUCURSAL,
                       C.TIP_CAMBIO,
                       C.SUMA_TOTAL,
                        CASE C.ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON
                  from CPW_CABECERA_ORDEN_PAGO C
                  join CMW_PROVEEDORES         P on P.ID = C.ID_PROVEEDOR
                  WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (nvl(FEC_EMISION,sysdate) BETWEEN :P284_FEC_INI AND :P284_FEC_HASTA)
                   AND C.ID_SUCURSAL = :P0_ID_SUCURSAL
                   AND P.IND_PERMITIR_VISUALIZAR = 'S'
                   AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'N'
                   AND NOT EXISTS (
                      SELECT 1
                        FROM CPW_DETALLE_ORDEN_PAGO D
                       WHERE D.ID_ORDEN_PAGO_CAB = C.ID
                         AND D.TIP_COMPROBANTE IN ('SAP', 'DIV')
                  )
                UNION ALL
                select C.ID,
                       C.ID_EMPRESA,
                       C.SER_ORDEN_PAGO,
                       C.NUM_ORDEN_PAGO,
                       C.FEC_EMISION,
                       C.FEC_VENCIMIENTO,
                       C.ID_USUARIO_AUTORIZ,
                       C.AUTORIZADO,
                       CASE C.AUTORIZADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AUTORIZADO_ICON,
                       C.ESTADO,
                       C.RETENIDO,
                       C.COD_USUARIO_AUD,
                       C.PORC_RET_IVA,
                       C.TOT_RET_IVA,
                       C.IND_PAGO_ADELANTADO,
                       C.GRAVADAS,
                       C.IVA,
                       C.ID_MOV_CAJ,
                       C.ID_PROVEEDOR,
                       C.FEC_AUTORIZADO,
                       C.IND_CAJA_CHICA,
                       C.ID_CUENTA_BANCARIA,
                       C.ID_CONSIGNACION,
                       C.ID_MONEDA,
                       C.ID_SUCURSAL,
                       C.TIP_CAMBIO,
                       C.SUMA_TOTAL,
                        CASE C.ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON
                  from CPW_CABECERA_ORDEN_PAGO C
                  join CMW_PROVEEDORES         P on P.ID = C.ID_PROVEEDOR
                  WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (nvl(FEC_EMISION,sysdate) BETWEEN :P284_FEC_INI AND :P284_FEC_HASTA)
                   AND C.ID_SUCURSAL = :P0_ID_SUCURSAL
                   AND W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS') = 'S'
                order by 4 desc
                ```
            pageItemsToSubmit: [
                P284_FEC_INI
                P284_FEC_HASTA
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 272
                items: {
                    P272_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 65238254332250262
        }

