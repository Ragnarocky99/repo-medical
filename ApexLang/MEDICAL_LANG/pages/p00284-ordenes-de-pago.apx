    region órdenes-de-pago (
        name: Órdenes de Pago
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P284_FEC_HASTA (
        type: datePicker
        label {
            label: <p>Fecha Hasta: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
    )

    pageItem P284_FEC_INI (
        type: datePicker
        label {
            label: <p>Fecha desde: </p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/01/'||to_char(sysdate,'YYYY') from dual
        }
    )

    button create (
