    dynamicAction limpia-items (
        name: LIMPIA ITEMS
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @clear
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P764_EXCEL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar-sesión (
        name: "Limpiar sesión "
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 33975441522660101
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: UPLOAD,CLEAR
        }
    )

    process proceso (
        name: Proceso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VID_ARTICULO        NUMBER(10);
                    vIdUM   NUMBER(10);
                    VDESC_ARTICULO      VARCHAR2(200);
                    VNRO_LOTE           VARCHAR(50);
                    VID_LOTE            NUMBER(10); 
                    VNOMBRE_ARCHIVO     VARCHAR(100);
                    VBANDERA            NUMBER(1);
                
                    vPrecioFijo         VTW_PRECIOS_FIJOS.PRECIO_FIJO_CIVA%TYPE;
                    vFechaVigencia      VTW_PRECIOS_FIJOS.FEC_VIGENCIA%TYPE;
                    vIdMoneda           VTW_PRECIOS_FIJOS.ID_MONEDA%TYPE;
                    vIdListaPrecio      VTW_PRECIOS_FIJOS.ID_PRECIO%TYPE;
                    vFechaAlta          VTW_PRECIOS_FIJOS.FECHA%TYPE;
                
                BEGIN
                
                    vIdListaPrecio  := :P764_ID_LISTA_PRECIO;
                    vFechaVigencia  := :P764_FECHA_VIGENCIA;
                    vIdMoneda       := W_BUSCA_PARAMETRO('BS','ID_MONEDA_BASE');
                    vFechaAlta      := TO_DATE(TO_CHAR(SYSDATE,'DD/MM/YYYY HH24:MI:SS'),'DD/MM/YYYY HH24:MI:SS');
                    --vIdUM           := TRAE_ID_UNIDAD_MEDIDA('1');
                
                    VNOMBRE_ARCHIVO := :P764_EXCEL ;
                    
                    for r1 in (select *  
                                 from apex_application_temp_files f, 
                                      table( apex_data_parser.parse(
                                                p_content                     => f.blob_content,
                                                p_add_headers_row             => 'N',
                                                p_file_name                   => f.filename) 
                                            ) p
                                 where f.name LIKE VNOMBRE_ARCHIVO
                              )
                    LOOP
                        IF NVL(R1.COL001,'NO_DATA') <> 'NO_DATA' THEN
                
                            --Busca id del articulo
                            VID_ARTICULO:=BUSCA_ARTICULO(:P0_ID_EMPRESA,R1.COL001);
                            vIdUM       :=BUSCA_UNI_MED(NULL, VID_ARTICULO);
                
                            vPrecioFijo   := NVL(TO_NUMBER(REPLACE(r1.col002,'.',',')), 0);
                            
                            -- Desactivamos el precio fijo del articulo si existe.
                            BEGIN
                                UPDATE VTW_PRECIOS_FIJOS
                                   SET ACTIVO = 'N'
                                 WHERE ID_ARTICULO = VID_ARTICULO
                                   AND ID_PRECIO = vIdListaPrecio;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    NULL;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000, 'Error desactivando la lista de precio. Err '||SQLERRM);
                            END;
                            BEGIN
                
                                INSERT INTO VTW_PRECIOS_FIJOS(ID_EMPRESA,
                                                              ID_ARTICULO,
                                                              ID_PRECIO,
                                                              FEC_VIGENCIA,
                                                              ID_MONEDA,
                                                              PRECIO_FIJO_CIVA,
                                                              ACTIVO,
                                                              ID_UNIDAD_MEDIDA,
                                                              COD_USUARIO_AUD,
                                                              TIPO_CAMBIO,
                                                              FECHA)
                                                       VALUES(:P0_ID_EMPRESA,
                                                              VID_ARTICULO,
                                                              vIdListaPrecio,
                                                              vFechaVigencia,
                                                              vIdMoneda,
                                                              vPrecioFijo,
                                                              'S',
                                                              vIdUM,
                                                              :APP_USER,
                                                              1,
                                                              vFechaAlta);
                
                            EXCEPTION
                                WHEN no_data_found THEN
                                    RAISE_APPLICATION_ERROR(-20999, 'ERROR: al insertar ' || SQLERRM);
                                WHEN OTHERS THEN 
                                    RAISE_APPLICATION_ERROR(-20994, 'Error inesperado al cargar el precio del artículo: ' || R1.COL001 || ' -.ERR: ' || SQLERRM);
                            END;
                
                        END IF;
                        
                    END LOOP; 
                
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Se han creado los registros.
        }
        advanced {
            executionMappingIdentifier: 33974639986660098
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: UPLOAD
        }
    )

)

