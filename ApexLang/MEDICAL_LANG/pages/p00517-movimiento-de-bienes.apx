page 517 (
    name: Movimiento de Bienes
    alias: MOVIMIENTO-DE-BIENES
    title: Movimiento de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region movimiento-de-bienes (
        name: Movimiento de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.FEC_COMPROBANTE, 
                       C.TIP_COMPROBANTE, 
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_DEPARTAMENTO,
                       C.ID_RESPONSABLE,
                       C.MON_COSTO AS TOTAL_COMPROBANTE
                       FROM COW_MOV_BIENES_CAB C  
                       WHERE C.TIP_COMPROBANTE = 'INV'
                 ORDER BY C.FEC_COMPROBANTE desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 505
                items: {
                    P505_ID: #ID#
                }
            }
            linkIcon:
                ```
                <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
                
                ```
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 74088701943443214
        }

        column FEC_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Fec. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 15
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 65
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_DEPARTAMENTO (
            type: plainTextBasedOnLov
            heading {
                heading: Departamento
                alignment: center
            }
            lov {
                lov: @lv-departamentos-rrhh
            }
            layout {
                sequence: 75
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_RESPONSABLE (
            type: plainTextBasedOnLov
            heading {
                heading: Responsable
                alignment: center
            }
            lov {
                lov: @lv-responsables-bien
            }
            layout {
                sequence: 85
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Nro. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column SER_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Ser. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TIP_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Tip. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column TOTAL_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Total Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 55
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Movimiento de Bienes
        }

        savedReport 741013 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FEC_COMPROBANTE (
                sequence: 1
            )

            displayColumn ID_DEPARTAMENTO (
                sequence: 5
            )

            displayColumn ID_RESPONSABLE (
                sequence: 6
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 4
            )

            displayColumn SER_COMPROBANTE (
                sequence: 3
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 2
            )

            displayColumn TOTAL_COMPROBANTE (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @movimiento-de-bienes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 505
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

)

