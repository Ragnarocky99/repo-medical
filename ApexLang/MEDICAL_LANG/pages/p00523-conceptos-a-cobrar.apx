page 523 (
    name: Conceptos a Cobrar
    alias: CONCEPTOS-A-COBRAR
    title: Lista conceptos a Cobrar
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .readOnly{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-concepto-a-cobrar (
        name: Lista concepto a cobrar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ID,
                       A.COD_ARTICULO,
                       A.DESCRIPCION,
                       A.ID_IVA,
                       A.ESTADO,
                       A.IND_MODIFICA_PRECIO,
                       A.IND_ALQUILERES,
                       A.IND_GASTO_GARANTIA   
                  from STW_ARTICULOS A
                  WHERE A.ID_EMPRESA = :P0_ID_EMPRESA
                  and A.IND_ALQUILERES IS NOT NULL
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 535
                items: {
                    P535_ID: #ID#
                    P535_COD_ARTICULO: #COD_ARTICULO#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 59644773826550826
        }

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Código
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 240
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_IVA (
            type: plainTextBasedOnLov
            heading {
                heading: Iva
                alignment: center
            }
            lov {
                lov: @lv-iva
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column IND_ALQUILERES (
            type: plainText
            heading {
                heading: Alquileres
                alignment: center
            }
            layout {
                sequence: 490
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column IND_GASTO_GARANTIA (
            type: plainText
            heading {
                heading: Ind Gasto Garantia
                alignment: center
            }
            layout {
                sequence: 500
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column IND_MODIFICA_PRECIO (
            type: plainText
            heading {
                heading: Modifica Precio
                alignment: center
            }
            layout {
                sequence: 280
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Lista concepto a cobrar
        }

        savedReport 831587 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_ARTICULO (
                sequence: 2
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ESTADO (
                sequence: 5
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_IVA (
                sequence: 4
            )

            displayColumn IND_ALQUILERES (
                sequence: 7
            )

            displayColumn IND_MODIFICA_PRECIO (
                sequence: 6
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @lista-concepto-a-cobrar
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 535
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lista-concepto-a-cobrar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-concepto-a-cobrar
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

