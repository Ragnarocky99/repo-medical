page 716 (
    name: Carga de Planillas de Reparto para Repartidores
    alias: CARGA-DE-PLANILLAS-DE-REPARTO-PARA-REPARTIDORES
    title: Carga de Planillas de Reparto para Repartidores
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("TOT_COMPROBANTE_COPIA");
                var v_total_cantidad     = 0;
                
                model.forEach(function(r, index, id) {
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){  
                        v_total_cantidad  += parseFloat(r[v_cantidad].replace(/\./g,'')) || 0;
                    }
                });
            
            
                 $s('P675_TOTALES',v_total_cantidad.toString().replace('.', ','));
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P675_TOTALES").readOnly = true;
            
            document.getElementById("P675_NRO_PLANILLA").readOnly = true;
            document.getElementById("P675_ID_USUARIO").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
