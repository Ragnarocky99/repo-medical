                    ```plsql
                    BEGIN
                    SELECT 'FAC-'||C.SER_COMPROBANTE||'-'||C.NRO_COMPROBANTE,PR.ID, nvl(PE.DIRECCION,'No especificada')
                    INTO :NRO_COMPROBANTE, :ID_PROVEEDOR, :DIRECCION_ENVIO
                    FROM CMW_COMPRAS_CABECERA C
                    JOIN CMW_PROVEEDORES      PR ON PR.ID = C.ID_PROVEEDOR
                    JOIN BSW_PERSONAS         PE ON PE.ID = PR.ID_PERSONA
                    WHERE C.ID = :ID_FACTURA_CM;
                    END;
                    ```
                itemsToSubmit: ID_FACTURA_CM
