    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 160
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @detalles
            columns: NRO_COMPROBANTE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_REM_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
                value: REM
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: $('#ID_FVE_lov_btn').click();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
                value: FVE
            }
        )

        action native-javascript-code-3 (
            action: executeJsCode
            settings {
                jsCode: $('#ID_REC_lov_btn').click();
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
                value: REC
            }
        )

        action native-javascript-code-4 (
            action: executeJsCode
            settings {
                jsCode: $('#ID_FACOMP_lov_btn').click();
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
                value: FAC
            }
        )

        action native-javascript-code-5 (
            action: executeJsCode
            settings {
                jsCode: $('#ID_OCP_lov_btn').click();
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
                value: OCP
            }
        )

        action native-javascript-code-6 (
            action: executeJsCode
            settings {
                jsCode: $('#ID_NEN_lov_btn').click();
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
