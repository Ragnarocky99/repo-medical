        column ID_OCP (
            type: popupLov
            heading {
                heading: Id Ocp
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 'OCP-'||C.SER_COMPROBANTE||'-'||C.NRO_COMPROBANTE||' de '||PE.NOMBRE, C.ID
                    FROM CMW_PEDIDOS_CABECERA C
                    JOIN CMW_PROVEEDORES      PR ON PR.ID = C.ID_PROVEEDOR
                    JOIN BSW_PERSONAS         PE ON PE.ID = PR.ID_PERSONA
                    ORDER BY C.ID DESC
                    ```
            }
            layout {
                sequence: 320
            }
            source {
                databaseColumn: ID_OCP
                dataType: number
