        column ID_RECIBO (
            type: popupLov
            heading {
                heading: Id Recibo
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'REC'||'-'||rec.ser_recibo||'-'||rec.nro_recibo||' de '||per.nombre, rec.id
                    from ccw_recibos rec
                    join ccw_clientes   cli on cli.id = rec.id_cliente
                    join bsw_personas   per on per.id = cli.id_persona
                    order by rec.id desc
                    ```
            }
            layout {
