    computation p716-nro-planilla (
        itemName: P716_NRO_PLANILLA
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vNroPlanilla  INV.RPW_REPARTO_CABECERA.NRO_PLANILLA%TYPE;
                
                BEGIN
                    BEGIN
                        SELECT NVL(MAX(TO_NUMBER(P.NRO_PLANILLA)),0) + 1
                          INTO vNroPlanilla
                        FROM RPW_REPARTO_CABECERA P
                        WHERE P.ID_EMPRESA = :P0_ID_EMPRESA;
                    EXCEPTION
                        WHEN OTHERS THEN
                            vNroPlanilla := 1;
                    END;
                
                    RETURN vNroPlanilla;
                
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P716_ID
        }
    )

    process initialize-form-planilla-de-reparto (
        name: Initialize form Planilla de Reparto
        type: formInitialization
        formRegion: @planilla-de-reparto
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 67635275217379778
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare vtotal number(10);
                begin
                
                 select sum(d.id_empresa)
                   into vtotal
                   from rpw_reparto_detalle d 
                   where d.id_reparto_cabecera = :P716_ID;
                  
                  update rpw_reparto_cabecera c    
                     set c.ID_PLANILLA_INGRESO = vtotal
                   where c.id = :P716_ID;
                 
                 exception 
                   when others then 
                    raise_application_error(-20000,sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 67651067857379803
        }
        serverSideCondition {
            whenButtonPressed: @guardar
            type: never
        }
    )

    process process-cab (
        name: PROCESS CAB
        type: formAutoRowProcessing
        formRegion: @planilla-de-reparto
        target {
            targetType: tableView
            tableName: RPW_REPARTO_CABECERA
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 67635634753379779
        }
    )

