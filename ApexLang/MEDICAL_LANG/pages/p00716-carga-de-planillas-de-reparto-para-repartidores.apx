    region planilla-de-reparto (
        name: Planilla de Reparto
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  ID,
                        ID_EMPRESA,
                        NRO_PLANILLA,
                        FEC_PLANILLA,
                        ID_REPARTIDOR,
                        ID_VEHICULO,
                        ID_SUCURSAL,
                        ESTADO,
                        ID_USUARIO,
                        ID_ZONA,
                        FEC_VENCIMIENTO,
                        COD_USUARIO_AUD,
                        ID_PLANILLA_INGRESO,
                        ID_SUCURSAL_CENTRAL,
                        ID_REPARTIDOR_AYUDANTE,
                        HORA_SALIDA,
                        HORA_VUELTA,
                        KM_INICIAL,
                        KM_FINAL,
                        ID_VENDEDOR,
                        OBSERVACION,
                        COD_USU_ESTADO,
                        ESTADO_FEC,
                        ID_MOTIVO_REPARTO
                FROM RPW_REPARTO_CABECERA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

