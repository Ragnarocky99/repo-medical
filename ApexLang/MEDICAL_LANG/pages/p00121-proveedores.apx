page 121 (
    name: Proveedores
    alias: PROVEEDORES
    title: Proveedores
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region proveedores (
        name: Proveedores
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region proveedores-2 (
        name: Proveedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_PROVEEDOR,
                       ID_PERSONA,
                       PLAZO,
                       ESTADO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       ID_MONEDA,
                       EXENTO,
                       CASE EXENTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END EXENTO_ICON,
                       COD_CUENTA_CONTABLE,
                       DIRECTO,
                       CASE DIRECTO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END DIRECTO_ICON,
                       CASUAL,
                       CASE CASUAL
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END CASUAL_ICON,
                       ID_CUENTA,
                       ID_SECTOR,
                       COD_USUARIO_AUD,
                       ID_CONDICION_COMPRA,
                       IND_RET_IVA,
                       CASE IND_RET_IVA
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END IND_RET_IVA_ICON,
                       ID_CUENTA_CONTABLE,
                       CUENTAS_BANCARIAS,
                       ID_PER_JURIDICA,
                       NRO_CUENTA,
                       COD_PROVEEDOR_REF,
                       IND_REPLICA,
                       ID_BENEFICIARIO,
                       ID_REPRESENTANTE_LEGAL,
                       ID_CLASE_PROVEEDOR,
                       IND_EXTERIOR,
                       CASE IND_EXTERIOR
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END IND_EXTERIOR_ICON
                  from CMW_PROVEEDORES
                  WHERE
                  ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 122
                items: {
                    P122_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 14458269658126462
        }

