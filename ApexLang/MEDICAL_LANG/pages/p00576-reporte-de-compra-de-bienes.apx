    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P576_FEC_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P576_FEC_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P576_FEC_FIN,'/','');
                            conv_fecha := substr(:P576_FEC_FIN,1,2)||'/'||
                                                      substr(:P576_FEC_FIN,3,2)||'/'||
                                                      lpad(substr(:P576_FEC_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P576_FEC_FIN := conv_fecha;
                            ELSIF (length(:P576_FEC_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P576_FEC_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P576_FEC_FIN
                itemsToReturn: P576_FEC_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P576_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P576_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P576_FEC_INI,'/','');
                            conv_fecha := substr(:P576_FEC_INI,1,2)||'/'||
                                                      substr(:P576_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:P576_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P576_FEC_INI := conv_fecha;
                            ELSIF (length(:P576_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P576_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P576_FEC_INI
                itemsToReturn: P576_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P576_TIPO_BIEN
                P576_SUCURSAL
                P576_DEPARTAMENTO
                P576_CENTRO
                P576_SECCION
                P576_FEC_INI
                P576_FEC_FIN
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reporte-de-compra-de-bienes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go to page 577
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: 577
                items: {
                    P576_TIPO_BIEN: &P576_TIPO_BIEN.
                    P576_SUCURSAL: &P576_SUCURSAL.
                    P576_DEPARTAMENTO: &P576_DEPARTAMENTO.
                    P576_CENTRO: &P576_CENTRO.
                    P576_SECCION: &P576_SECCION.
                    P576_FEC_INI: &P576_FEC_INI.
                    P576_FEC_FIN: &P576_FEC_FIN.
                }
            }
        }
    )

)

