    region reporte-de-compra-de-bienes (
        name: Reporte de Compra de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT MC.ID_SUCURSAL, 
                       MC.ID_CENTRO, 
                       MC.ID_DEPARTAMENTO, 
                       MC.ID_SECCION, 
                       MC.ID_RESPONSABLE, 
                       MD.MON_COSTO, 
                       MD.ID_BIEN, 
                       B.DESCRIPCION AS BIEN, 
                       B.ID_TIPO_BIEN,
                       T.DESCRIPCION AS TIPO_BIEN, 
                       MD.MON_COSTO_EXT AS MONTO_EXTRANJERO,
                       MC.FEC_COMPROBANTE
                       FROM  COW_MOV_BIENES_CAB MC, COW_MOV_BIENES_DET MD, COW_BIENES_USO B, COW_TIPOS_BIENES T
                       WHERE MC.ID = MD.ID_MOVBIEN_CAB
                         AND B.ID_TIPO_BIEN = T.ID
                         and B.id_empresa = MD.id_empresa
                         and B.id = MD.id_bien
                         AND MC.TIP_COMPROBANTE = 'FAC'
                         and (MC.ID_SUCURSAL = :P576_SUCURSAL OR :P576_SUCURSAL IS NULL)  
                         and (MC.ID_CENTRO = :P576_CENTRO OR :P576_CENTRO IS NULL)
                         and (MC.ID_DEPARTAMENTO = :P576_DEPARTAMENTO OR :P576_DEPARTAMENTO IS NULL) 
                         and (MC.ID_SECCION = :P576_SECCION OR :P576_SECCION IS NULL) 
                         and (T.ID = :P576_TIPO_BIEN OR :P576_TIPO_BIEN IS NULL)
                         and (MC.FEC_COMPROBANTE BETWEEN :P576_FEC_INI AND :P576_FEC_FIN)   
                order by B.ID_TIPO_BIEN
                ```
            pageItemsToSubmit: [
                P576_TIPO_BIEN
                P576_SUCURSAL
                P576_DEPARTAMENTO
                P576_CENTRO
                P576_SECCION
                P576_FEC_INI
                P576_FEC_FIN
            ]
        }
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 98779578065760281
        }

