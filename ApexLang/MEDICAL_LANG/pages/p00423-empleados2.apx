page 423 (
    name: empleados2
    alias: EMPLEADOS2
    title: empleados2
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline: "td[headers=\"Foto\"] img { width: 20%; } "
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region empleados (
        name: Empleados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select E.ID AS ID_EMPLEADO,
                       E.ID_EMPRESA,
                       E.COD_EMPLEADO,
                       P.NOMBRE,
                       P.NRO_CI,
                       P.TELEFONO,
                       E.TIP_PERSONAL,
                       E.NRO_IPS,
                       E.FEC_INGRESO,
                       E.FEC_SALIDA,
                       E.ID_MOTIVO_SALIDA,
                       E.ACTIVO,
                       CASE E.ACTIVO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END ACTIVO_ICON,
                       E.ID_HORARIO,
                       E.ID_CONCEPTOS,
                       E.ID_DEPARTAMENTO,
                       E.SUB_CUENTA,
                       E.NRO_CUENTA,
                       E.FEC_CONTRATO,
                       E.ID_CARGO,
                       E.ID_SUCURSAL,
                       P.ID,
                       sys.dbms_lob.getlength(e.foto_empleado)
                  from RHW_EMPLEADOS E, BSW_PERSONAS P
                  where E.id_empresa = :P0_ID_EMPRESA
                  AND E.ID_PERSONA = P.ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 424
                items: {
                    P424_ID: #ID_EMPLEADO#
                    P424_ID_1: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 35285459581081519
        }

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 230
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ACTIVO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        column ACTIVO_ICON (
            type: hidden
            heading {
                heading: Activo Icon
            }
            layout {
                sequence: 1200
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: DY
            }
        )

