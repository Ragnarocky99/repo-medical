    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @empleados
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 424
                items: {
                    P424_ID: &P424_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction when-dialog-closes (
        name: When dialog closes
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @empleados
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @empleados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

