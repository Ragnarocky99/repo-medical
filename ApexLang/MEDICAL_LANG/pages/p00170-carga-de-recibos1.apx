            affectedElements {
                selectionType: columns
                columns: ORDEN
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction set-row-num (
        name: set row_num
        execution {
            sequence: 90
        }
        when {
            event: apexbeforepagesubmit
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var j = 1;
                    var model = apex.region("det").widget().interactiveGrid("getViews", "grid").model;
                    model.forEach(function(r) {
                        try{
                            model.setValue(r,"ORDEN", j.toString());
                            console.log("j: ",j);
                    	    j+=1;
                        }
                        catch(err){
                        console.log("Registro eliminado");
                        }
                    });
                    ```
            }
            affectedElements {
                selectionType: region
                region: @detalles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            security {
                authorizationScheme: @derechos-actualizar-2
            }
            comments {
                comments:
                    ```
                    https://www.foxinfotech.in/2020/03/oracle-apex-loop-through-interactive-grid-records.html
                    
                    https://stackoverflow.com/questions/68280257/oracle-apex-get-interactive-grid-row-count
                    
                    https://stackoverflow.com/questions/67803266/set-the-column-value-from-page-item-by-using-javascript-oracle-apex-interactive
                    
                    https://orclqa.com/question/add-row-item-in-interactive-grid/
                    
                    https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/try...catch
                    
                    https://community.oracle.com/tech/developers/discussion/4486769/javascript-model-setvalue-is-not-saving-data-when-updating-an-ig-column
                    ```
            }
        )

    )

    dynamicAction traer-cambio (
        name: Traer Cambio
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P170_ID_MONEDA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT TIPO_CAMBIO_DIA
                    FROM BSW_MONEDAS
                    WHERE ID = :P170_ID_MONEDA
                    ```
                itemsToSubmit: P170_ID_MONEDA
            }
