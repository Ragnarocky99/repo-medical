page 170 (
    name: Carga de Recibos
    alias: CARGA-DE-RECIBOS1
    title: Carga de Recibos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var i = 0;
            function calculaTotales(){
                var model= apex.region("det").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("MONTO_CUOTA");
                var v_total_cantidad     = 0.00;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                         console.log('jyyju'+r[v_cantidad]);
                          
                        v_total_cantidad      = v_total_cantidad   + parseFloat(r[v_cantidad].toString().replace(/\./g,'').replace(',','.'));//replace(/\./g,''));
                    }                      
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
                console.log("total: "+v_total_cantidad/*.toString().replace('.', '').replace(',', '.')*/);
                 $s('P170_TOTAL',v_total_cantidad/*.toString().replace(".","").replace(',','.')*/);
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            //Este script es para hacer que los elementos sea de solo lectura y no se pueden escribir en ellos 
            document.getElementById("P170_ASIENTOS").readOnly = true;
            
            document.getElementById("P170_TOT_RECIBO").readOnly = true;
            document.getElementById("P170_TOTAL").readOnly = true;
            document.getElementById("P170_SER_RECIBO").readOnly = true;
            //document.getElementById("P170_TIP_CAMBIO").readOnly = true;
            //document.getElementById("P170_IMPORTE").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
