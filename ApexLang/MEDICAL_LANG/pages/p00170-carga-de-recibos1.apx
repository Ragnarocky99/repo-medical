    dynamicAction traer-info-saldo (
        name: Traer info saldo
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_SALDO
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select id_comprobante, 
                           tipo_comprobante, 
                           ser_comprobante, 
                           nro_comprobante,
                           nro_cuota, 
                           fec_vencimiento,
                           --replace(SALDO_CUOTA - NVL(REC_PENDIENTES, 0), '.',',') as SALDO, 
                           SALDO_CUOTA - NVL(REC_PENDIENTES, 0) as SALDO,
                           id_moneda_cuota, 
                         case id_moneda_cuota  
                         when 32 then
                         1
                         else
                         NVL(TO_NUMBER(REPLACE(:P170_TIP_CAMBIO,'.','')),FTIPOS_CAMBIO(id_moneda_cuota,fec_vencimiento,'C','V') ) 
                         end
                         as tip_cambio
                    from ccw_saldos
                    where id = :ID_SALDO
                    
                    ```
                itemsToSubmit: [
                    ID_SALDO
                    TIP_CAMBIO
                    P170_TIP_CAMBIO
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: [
                    ID_FACTURA_REF
                    TIPO_COMPROBANTE
                    SER_COMPROBANTE
                    NRO_COMPROBANTE
                    NRO_CUOTA
                    FEC_VENCIMIENTO
                    MONTO_CUOTA
                    ID_MONEDA_CUOTA
                    TIP_CAMBIO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation cliente-tiene-saldos-pendientes (
        name: cliente tiene saldos pendientes
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from ccw_saldos s
                where s.ID_CLIENTE = :P170_ID_CLIENTE
                AND S.SALDO_CUOTA - NVL(S.REC_PENDIENTES, 0)  > 0
                ```
        }
        error {
            errorMessage: Este cliente no cuenta con saldos pendientes
            associatedItem: @P170_ID_CLIENTE
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-fecha-modulo (
        name: Validar Fecha Modulo
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(500);
                  begin
                    select length(ver_fecha(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CC','ID_MODULO_CC'),TO_DATE(:P170_FEC_RECIBO))) 
                       into vmensaje
                    from dual;
                  IF vmensaje IS NULL THEN 
                  RETURN TRUE; 
                  ELSE 
                  RETURN FALSE;
                  END IF;
                end;
                ```
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P170_FEC_RECIBO
        }
        serverSideCondition {
            type: never
        }
    )

    computation p170-asientos-id (
        itemName: P170_ASIENTOS_ID
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                select id 
                from cow_diario_cabeceras_prov
                where num_asiento  = TO_NUMBER(REPLACE(REPLACE(:P170_ASIENTOS,'*'),'cobros'))
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P170_FEC_RECIBO);
                ```
        }
    )

    computation p170-cantidad-lineas (
        itemName: P170_CANTIDAD_LINEAS
        execution {
            sequence: 40
        }
        computation {
            sqlQuery:
                ```sql
                SELECT COUNT(1)
                  FROM CCW_DETALLE_RECIBOS
                 WHERE ID_RECIBO = :P170_ID
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P170_ID
        }
    )

    computation p170-ser-recibo (
        itemName: P170_SER_RECIBO
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_ser varchar2(7);
                
                BEGIN
                select SER_TIMBRADO
                INTO v_ser
                 from BSW_SERIES_COMPROB t 
                 WHERE
                ID_EMPRESA=:P0_COD_EMPRESA AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                AND TIP_COMPROBANTE=W_BUSCA_PARAMETRO(NULL,'TIPO_COMPROBANTE_RECIBO');
                RETURN v_ser;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                return null;
                WHEN OTHERS THEN
                 RETURN null; 
                END;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

