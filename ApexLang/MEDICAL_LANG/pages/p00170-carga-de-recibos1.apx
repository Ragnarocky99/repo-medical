                background-color:#eeeeee;
                width: 100px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            .a-GV-rowLabel{display:none;}
            
            .Numeros{
                font-weight: bold;
            }
            .Numeros1{
                font-weight: bold;
                background-color: #f4f9f2;
            }
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #f13c0f;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region carga-de-recibos (
        name: Carga de Recibos
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       SER_RECIBO,
                       NRO_RECIBO,
                       FEC_RECIBO,
                       FEC_COBRO,
                       ID_CLIENTE,
                       ID_COBRADOR,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ID_USUARIO,
                       ANULADO,
                       FEC_ANULACION,
                       --USUARIO_ANU,
                       ID_MOV_CAJ,
                       ESTADO,
                       FEC_ESTADO,
                       TOT_RECIBO,
                       FEC_ANULADO,
                       ACTUALIZADO_POR,
                       COMENTARIO,
                       ID_COBRADOR_ORI,
                       FEC_AUTORIZADO,
                       DIAS_AUTORIZADO,
                       COD_USUARIO_AUD,
                       TIP_RECIBO,
                       REPLACE(REPLACE(ASIENTOS,'*'),'cobros') ASIENTOS,
                       IND_IMPRESO,
                       ID_CORPORACION,
                       ID_COMP_REF_MORA,
                       TOTAL_MORA,
                       TOTAL_CARTA,
                       ID_CONCEPTO,
                       ID_TRANSFERENCIA_CLIE,
                       TRANSAC_PRONET,
                       ID_TALONARIO,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       IND_PARA_REPARTO,
                       IND_PLANILLA_ASO,
                       ID_PLANILLA_ASO,
                       ID_HABILITACION
                  from CCW_RECIBOS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
                margin-bottom-sm
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: 87620664968913866
            update: 88436026770339442
            delete: 88436648568350466
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_RECIBO,
                       C.ID_SUB_TIPO_TRANS,
                       C.ID_FACTURA_REF,
                       C.NRO_CUOTA,
                       TO_DATE(C.FEC_VENCIMIENTO,'DD/MM/YYYY') AS FEC_VENCIMIENTO,
                       C.MONTO_CUOTA,
                       C.ID_MONEDA_CUOTA,
                       C.TIP_CAMBIO,
                       C.COD_USUARIO_AUD,
                       C.ID_NOTAS_DEB,
                       C.ID_RECIBO_REF,
                       C.ID_SALDO,
                       C.MONTO_CUOTA AS SALDO_COPIA,
                       C.TIPO_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.MON_INTERES,
                       C.ID_COMP_REF_MORA,
                       C.IND_EXONERACION,
                       C.ID_USUARIO_EXO,
                       C.MON_EXONERADO,
                       C.FEC_EXONERADO,
                       C.DIAS_ATRASO,
                       C.MON_CARTA,
                       C.MON_INTERES_ORI,
                       C.ID_CLIENTE,
                       C.ORDEN
                  from CCW_DETALLE_RECIBOS C
                 where C.ID_RECIBO = :P170_ID
                
                ```
            pageItemsToSubmit: P170_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                margin-top-none
            ]
        }
        advanced {
            htmlDomId: det
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: Aún no se ha seleccionado ningun saldo
        }
        toolbar {
            controls: [
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 148513069801136586
        }

