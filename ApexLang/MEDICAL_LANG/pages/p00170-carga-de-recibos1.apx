        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: i += 1;
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: i
