    dynamicAction set-orden (
        name: set orden
        execution {
            sequence: 80
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detalles
        }
        clientSideCondition {
            type: itemColumnIsNull
