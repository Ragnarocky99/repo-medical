    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: items
            items: P170_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P170_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P135_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P170_ASIENTOS_ID',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P170_URL
                    P170_ASIENTOS_ID
                ]
                itemsToReturn: P170_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P170_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction aud-anulacion (
        name: AUD_ANULACION
        execution {
            sequence: 190
        }
        when {
            selectionType: items
            items: P170_ANULADO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vuser VARCHAR2(20);
                    BEGIN
                        IF NVL(:P170_ANULADO,'N') = 'S'  THEN
                            vuser := :APP_USER;
                     /*   ELSE
                            vuser := NULL;*/
                        END IF;
                        RETURN vuser;
                    END;
                    ```
                itemsToSubmit: P170_ANULADO
                escapeSpecialChars: false
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P170_USUARIO_ANU
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P170_ANULADO
                value: S
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vuser VARCHAR2(20);
                    BEGIN
                        IF NVL(:P170_ANULADO,'N') = 'N'  THEN
                            vuser := NULL;
                       
                        END IF;
                        RETURN vuser;
                    END;
                    ```
                itemsToSubmit: P170_USUARIO_ANU
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P170_USUARIO_ANU
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P170_ANULADO
                value: N
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vfec VARCHAR2(20);
                    BEGIN
                        IF NVL(:P170_ANULADO,'N') = 'S' THEN
                            vfec := SYSDATE/*TO_CHAR(SYSDATE,'DD/MM/YYYY HH:MM:SS')*/;
                        /*ELSE
                            vfec := NULL;*/
                        END IF;
                        RETURN vfec;
                    END;
                    ```
                itemsToSubmit: P170_ANULADO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P170_FEC_ANULACION
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P170_ANULADO
                value: S
            }
        )

        action native-set-value-4 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vfec VARCHAR2(20);
                    BEGIN
                        IF NVL(:P170_ANULADO,'N') = 'N' THEN
                            vfec := NULL;
                        /*ELSE
                            vfec := NULL;*/
                        END IF;
                        RETURN vfec;
                    END;
                    ```
                itemsToSubmit: P170_FEC_ANULACION
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P170_FEC_ANULACION
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P170_ANULADO
                value: N
            }
        )

    )

    dynamicAction cargar-saldos-seleccionados (
        name: Cargar Saldos Seleccionados
        execution {
            sequence: 230
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action actualizar-coleccion (
            name: Actualizar Coleccion
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        FOR I IN (
                            SELECT SEQ_ID FROM APEX_COLLECTIONS WHERE COLLECTION_NAME = 'SALDOS_CLIENTE_SELECCION' AND C001 = 'N'
                        )
                        LOOP
                            APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (
                                p_collection_name   => 'SALDOS_CLIENTE_SELECCION',
                                p_seq               => I.SEQ_ID,
                                p_attr_number       => 1,
                                p_attr_value        => 'S');
                        END LOOP;
                    END;
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action cargar-detalle (
            name: Cargar detalle
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var total=0;
                    var json_detalle = JSON.parse($v('P170_JSON_DETALLE'));
                    
                    
                    if ((Object.keys(json_detalle.SALDOS).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.SALDOS.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("det").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    
                    total=total+json_detalle.SALDOS[i].SALDO_CUOTA;
                    
                    $model.setValue($newRecord, "ID_SALDO",(json_detalle.SALDOS[i].ID).toString());
                    $model.setValue($newRecord, "TIPO_COMPROBANTE",(json_detalle.SALDOS[i].TIPO_COMPROBANTE).toString());
                    $model.setValue($newRecord, "SER_COMPROBANTE",(json_detalle.SALDOS[i].SER_COMPROBANTE).toString());
                    if((json_detalle.SALDOS[i].FEC_VENCIMIENTO)!=null && json_detalle.SALDOS[i].FEC_VENCIMIENTO !== undefined){
                     
                    
                    $model.setValue($newRecord, "FEC_VENCIMIENTO",(json_detalle.SALDOS[i].FEC_VENCIMIENTO).toString());
                    }
                    $model.setValue($newRecord, "NRO_COMPROBANTE",(json_detalle.SALDOS[i].NRO_COMPROBANTE).toString());
                    $model.setValue($newRecord, "MONTO_CUOTA",(json_detalle.SALDOS[i].SALDO_CUOTA).toString().replace('.', ','));
                    $model.setValue($newRecord, "NRO_CUOTA",(json_detalle.SALDOS[i].NRO_CUOTA).toString());
                    $model.setValue($newRecord, "ID_MONEDA_CUOTA",(json_detalle.SALDOS[i].ID_MONEDA_CUOTA).toString());
                    $model.setValue($newRecord, "ID_SUB_TIPO_TRANS",(json_detalle.SALDOS[i].TRANSACCION).toString());
                    $model.setValue($newRecord, "TIP_CAMBIO",(json_detalle.SALDOS[i].TIP_CAMBIO).toString().replace('.', ','));
                    if (json_detalle.SALDOS[i].ID_COMPROBANTE !== null && json_detalle.SALDOS[i].ID_COMPROBANTE !== undefined) {
                        $model.setValue($newRecord, "ID_FACTURA_REF", json_detalle.SALDOS[i].ID_COMPROBANTE.toString());
                    }
                    $model.setValue($newRecord, "SALDO_COPIA",(json_detalle.SALDOS[i].SALDO_CUOTA).toString().replace('.', ','));
                    $model.setValue($newRecord, "ORDEN",(json_detalle.SALDOS[i].ORDEN).toString());
                    }
                    var total_actual=$v('P170_TOT_RECIBO');
                    if(isNaN(parseFloat(total_actual))){
                    total=total+0;
                    }else{
                    total=total+parseFloat(total_actual);
                    }
                    
                    
                    $s('P170_TOTAL',total);
                    }
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action cargar-detalle_1 (
            name: Cargar detalle
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                      var T = $v("P170_JSON_DETALLE"), J, intento = 0, maxIntentos = 20, total = 0;
                      if(!T){ console.warn("P170_JSON_DETALLE vacío. No se carga nada."); return; }
                      try{ J = JSON.parse(T); }
                      catch(e){ console.error("JSON inválido:",e); apex.message.alert("El JSON de saldos no es válido."); return; }
                    
                      function txt(v){ return v===null||v===undefined?"":v.toString(); }
                      function dec(v){ return v===null||v===undefined?"":v.toString().replace(/\./g,","); }
                      function tieneDatos(o){ return o && Object.keys(o).some(k => o[k]!==null && o[k]!==undefined && o[k]!=="" ); }
                      function setCol(model,rec,col,val){
                        if(val===null||val===undefined||val===""){ return; }
                        try{ model.setValue(rec,col,val.toString()); }
                        catch(e){ console.error("Error en columna:",col,"Valor:",val,e);
                          apex.message.alert("Error al cargar la columna "+col+". Verificá si está Read Only, Display Only o Query Only en el IG det.");
                          throw e;
                        }
                      }
                    
                      function esperarIG(){
                        var ig$ = apex.region("det").widget();
                        var grid = ig$.interactiveGrid("getCurrentView");
                        grid.setEditMode(true);
                        var model = grid.model;
                        console.log("Intento:",intento,"allowAdd:",model.allowAdd(),"canAdd:",model.check("canAdd"));
                        if(model.allowAdd() && model.check("canAdd")){ cargarSaldos(model); return; }
                        intento++;
                        if(intento<maxIntentos){ setTimeout(esperarIG,300); return; }
                        apex.message.alert("El grid det no permite agregar filas todavía. Revisá si el código se ejecuta antes del refresh del IG o si alguna configuración bloquea Add Row.");
                      }
                    
                      function cargarSaldos(model){
                        try{
                          if(!J || !Array.isArray(J.SALDOS) || J.SALDOS.length===0){ console.log("No hay saldos para cargar."); return; }
                          var saldos = J.SALDOS.filter(tieneDatos);
                          if(saldos.length===0){ console.log("El JSON no tiene saldos con datos."); return; }
                    
                          for(let i=0;i<saldos.length;i++){
                            console.log('Iteracion ' + i);
                            var s = saldos[i];
                            if(!model.allowAdd() || !model.check("canAdd")){ throw new Error("El modelo dejó de permitir insertar en la línea "+(i+1)); }
                            var rec = model.getRecord(model.insertNewRecord());
                    
                            total += parseFloat(s.SALDO_CUOTA) || 0;
                    
                            setCol(model,rec,"ID_SALDO",txt(s.ID));
                            setCol(model,rec,"TIPO_COMPROBANTE",txt(s.TIPO_COMPROBANTE));
                            setCol(model,rec,"SER_COMPROBANTE",txt(s.SER_COMPROBANTE));
                            if(s.FEC_VENCIMIENTO!=null){ setCol(model,rec,"FEC_VENCIMIENTO",txt(s.FEC_VENCIMIENTO)); }
                            setCol(model,rec,"NRO_COMPROBANTE",txt(s.NRO_COMPROBANTE));
                            setCol(model,rec,"MONTO_CUOTA",dec(s.SALDO_CUOTA));
                            setCol(model,rec,"NRO_CUOTA",txt(s.NRO_CUOTA));
                            setCol(model,rec,"ID_MONEDA_CUOTA",txt(s.ID_MONEDA_CUOTA));
                            setCol(model,rec,"ID_SUB_TIPO_TRANS",txt(s.TRANSACCION));
                            setCol(model,rec,"TIP_CAMBIO",dec(s.TIP_CAMBIO));
                            if(s.ID_COMPROBANTE!=null){ setCol(model,rec,"ID_FACTURA_REF",txt(s.ID_COMPROBANTE)); }
                            setCol(model,rec,"SALDO_COPIA",dec(s.SALDO_CUOTA));
                            setCol(model,rec,"ORDEN",txt(s.ORDEN));
                          }
                    
                          // sumar al total actual del item
                          var total_actual = $v('P170_TOT_RECIBO');
                          if(!isNaN(parseFloat(total_actual))){
                            total += parseFloat(total_actual);
                          }
                    
                          $s('P170_TOTAL', total.toString().replace(/\./g,','));
                          console.log("Carga de saldos finalizada. Total:", total);
                    
                        }catch(e){ console.error("Error cargando saldos:",e); }
                      }
                    
                      setTimeout(esperarIG,300);
                    })();
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action cargar-json (
            name: Cargar JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                        IF APEX_COLLECTION.COLLECTION_EXISTS('SALDOS_CLIENTE_SELECCION') THEN 
                            OPEN l_cursor FOR
                              SELECT    S.NRO_COMPROBANTE,
                                        S.TIPO_COMPROBANTE,
                                        S.SER_COMPROBANTE,
                                        S.ID,
                                        S.NRO_CUOTA,
                                        to_char(S.FEC_VENCIMIENTO,'DD/MM/YYYY') FEC_VENCIMIENTO,
                                        S.ID_MONEDA_CUOTA,
                                        S.SALDO_CUOTA,
                                        S.ID_CLIENTE,
                                        S.MONTO_CUOTA,
                                        (W_BUSCA_PARAMETRO('CC', 'ID_COBRO_CUOTA')) TRANSACCION,
                                        NVL(S.TIP_CAMBIO, NVL(V.TIP_CAMBIO, NVL(AC.TIP_CAMBIO, FTIPOS_CAMBIO(S.ID_MONEDA_CUOTA, NVL(V.FEC_COMPROBANTE, AC.FEC_COMPROBANTE), 'F', 'V')))) TIP_CAMBIO,
                                        S.ID_COMPROBANTE,
                                        (SELECT SEQ_ID FROM APEX_COLLECTIONS WHERE COLLECTION_NAME = 'SALDOS_CLIENTE_SELECCION' AND N001 = S.ID) ORDEN
                              FROM      CCW_SALDOS S
                              LEFT JOIN VTW_COMPROBANTES_CABECERA   V ON V.ID  = S.ID_COMPROBANTE
                              LEFT JOIN CCW_ANTICIPOS_CLIENTES_CAB AC ON AC.ID = S.ID_ANTICIPO
                              WHERE   S.ID IN (SELECT N001 FROM APEX_COLLECTIONS WHERE COLLECTION_NAME = 'SALDOS_CLIENTE_SELECCION' AND C001 = 'N');
                    
                            APEX_JSON.initialize_clob_output;
                            APEX_JSON.open_object;
                            APEX_JSON.write('SALDOS', l_cursor);
                            APEX_JSON.close_object;
                    
                            JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                            :P170_JSON_DETALLE:=JSON_DETALLE;
                        END IF;
                    END;
                    ```
                itemsToReturn: P170_JSON_DETALLE
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

