page 454 (
    name: Recibos emitidos no cobrados
    alias: RECIBOS-EMITIDOS-NO-COBRADOS
    title: Recibos emitidos no cobrados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region recibos (
        name: Recibos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.ser_recibo,
                r.id_cobrador,
                r.id_sucursal,
                r.nro_recibo,
                r.fec_recibo,
                r.fec_cobro,
                r.id_cliente,
                r.id_mov_caj,
                r.estado,
                r.tot_recibo
                from ccw_recibos r
                WHERE r.ID_EMPRESA  = :P0_ID_EMPRESA
                AND r.ID_SUCURSAL  = :P0_ID_SUCURSAL
                
                AND (r.ID_COBRADOR= :P454_COBRADOR OR :P454_COBRADOR IS NULL)
                AND (r.ID_SUCURSAL = :P454_COD_SUCURSAL OR :P454_COD_SUCURSAL IS NULL)
                ```
            pageItemsToSubmit: [
                P454_COD_SUCURSAL
                P0_ID_EMPRESA
                P454_COBRADOR
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 9276698130297141
        }

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column FEC_COBRO (
            type: plainText
            heading {
                heading: Fec Cobro
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column FEC_RECIBO (
            type: plainText
            heading {
                heading: Fec Recibo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_CLIENTE (
            type: plainText
            heading {
                heading: Id Cliente
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_COBRADOR (
            type: hidden
            heading {
                heading: Id Cobrador
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_MOV_CAJ (
            type: plainText
            heading {
                heading: Id Mov Caj
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_SUCURSAL (
            type: hidden
            heading {
                heading: Id Sucursal
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column NRO_RECIBO (
            type: plainText
            heading {
                heading: Nro Recibo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column SER_RECIBO (
            type: plainText
            heading {
                heading: Ser Recibo
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOT_RECIBO (
            type: plainText
            heading {
                heading: Tot Recibo
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Recibos
        }

        savedReport 94085 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ESTADO (
                sequence: 7
            )

            displayColumn FEC_COBRO (
                sequence: 4
            )

            displayColumn FEC_RECIBO (
                sequence: 3
            )

            displayColumn ID_CLIENTE (
                sequence: 5
            )

            displayColumn ID_MOV_CAJ (
                sequence: 6
            )

            displayColumn NRO_RECIBO (
                sequence: 2
            )

            displayColumn SER_RECIBO (
                sequence: 1
            )

            displayColumn TOT_RECIBO (
                sequence: 8
            )

        )

    )

    pageItem P454_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                margin-right-lg
            ]
            width: 30
        }
    )

    pageItem P454_COBRADOR (
        type: popupLov
        label {
            label: <p>Cobrador: </p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-cobradores
            nullDisplayValue: --Sin Seleccionar---
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P454_COD_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal: </p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P454_FECHA_FINAL (
        type: datePicker
        label {
            label: <p>Fecha final: </p>
            alignment: left
        }
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem P454_FEC_INICIAL (
        type: datePicker
        label {
            label: <p>Fecha inicial: </p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    button imprimir (
        buttonName: imprimir
        label: Imprimir
        layout {
            sequence: 80
            region: @filtro
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            icon: fa-file-text-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refrescar (
        buttonName: Refrescar
        label: Refrescar
        layout {
            sequence: 90
            region: @filtro
            slot: regionBody
            column: 1
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-consultar
        }
    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P454_FEC_INICIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P454_FEC_INICIAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P454_FEC_INICIAL,'/','');
                            conv_fecha := substr(:P454_FEC_INICIAL,1,2)||'/'||
                                                      substr(:P454_FEC_INICIAL,3,2)||'/'||
                                                      lpad(substr(:P454_FEC_INICIAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P454_FEC_INICIAL := conv_fecha;
                            ELSIF (length(:P454_FEC_INICIAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P454_FEC_INICIAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P454_FEC_INICIAL
                itemsToReturn: P454_FEC_INICIAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha-final (
        name: CONVERT_FECHA_FINAL
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P454_FECHA_FINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P454_FECHA_FINAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P454_FECHA_FINAL,'/','');
                            conv_fecha := substr(:P454_FECHA_FINAL,1,2)||'/'||
                                                      substr(:P454_FECHA_FINAL,3,2)||'/'||
                                                      lpad(substr(:P454_FECHA_FINAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P454_FECHA_FINAL := conv_fecha;
                            ELSIF (length(:P454_FECHA_FINAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P454_FECHA_FINAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P454_FECHA_FINAL
                itemsToReturn: P454_FECHA_FINAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: go to page 455
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 455
                items: {
                    P454_COD_SUCURSAL: &P454_COD_SUCURSAL.
                    P454_COBRADOR: &P454_COBRADOR.
                    P454_CLIENTE: &P454_CLIENTE.
                    P454_FEC_INICIAL: &P454_FEC_INICIAL.
                    P454_FECHA_FINAL: &P454_FECHA_FINAL.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

