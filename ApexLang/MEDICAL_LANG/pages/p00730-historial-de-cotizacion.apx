    dynamicAction acciones-al-cargar-pagina (
        name: Acciones al cargar pagina
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action boton-agregar-plazo (
            name: Boton Agregar Plazo
            action: plugin/interactiveGridExtendToolbar
            settings {
                toolbarGroup: 6AddRowGroup
                label: Definir Plazos
                hot: true
                icon: fa-calendar-plus-o
                triggerAction: plazo
            }
            affectedElements {
                selectionType: region
                region: @historial-cotizacion
            }
            execution {
                sequence: 40
            }
        )

        action boton-excel (
            name: Boton Excel
            action: plugin/interactiveGridExtendToolbar
            settings {
                toolbarGroup: 7ResetGroup
                groupPosition: start
                label: Excel
                hot: true
                icon: fa-file-excel-o
                triggerAction: excel
            }
            affectedElements {
                selectionType: region
                region: @historial-cotizacion
            }
            execution {
                sequence: 30
            }
        )

        action habilita-copiar-la-grilla-en-modo-lectura (
            name: Habilita copiar la grilla en modo lectura
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.addEventListener('copy', (event) => {
                        const activeElement = $(document.activeElement)[0];
                        const textToCopy = activeElement?.innerText || window.getSelection();
                        event.clipboardData.setData('text/plain', textToCopy);
                        event.preventDefault();
                    });
                    ```
            }
            execution {
                sequence: 20
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @historial-cotizacion
            }
            execution {
                sequence: 50
            }
        )

        action poner-grilla-modo-edicion (
            name: Poner grilla modo edicion
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Hist").call("getViews").grid;
                    grid.model.setOption("editable", true);
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P730_COD_ARTICULO
                P730_ID_PROVEEDOR
                P730_IND_EXCEL
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @historial-cotizacion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar-fila (
        name: Inicializar fila
        execution {
            sequence: 70
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @historial-cotizacion
        }

        action ind-no-vigente (
            name: IND_NO_VIGENTE
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: columns
                columns: IND_NO_VIGENTE
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: IND_NO_VIGENTE
            }
        )

    )

    dynamicAction ir-a-definicion-de-plazos (
        name: Ir a Definicion de Plazos
        execution {
            sequence: 60
        }
        when {
            event: custom
            customEvent: plazo
            selectionType: region
