page 730 (
    name: Historial de Cotizacion
    alias: HISTORIAL-DE-COTIZACION
    title: Historial de Cotizacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @historial-cotizacion
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region historial-cotizacion (
        name: Historial Cotizacion
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ar.id, hc.id_articulo, hc.cantidad, hc.id_proveedor, hc.id_moneda, ftipos_cambio(hc.id_moneda,sysdate,'C','V') cambio,
                       hc.id_condicion_compra, hc.costo, hc.ind_no_vigente, ar.cod_articulo,
                       hc.nro_pedido, hc.fec_pedido, ar.id_marca, ar.id_envase, ar.cod_origen_art, ar.id_unidad_medida, hc.id_pedido,
                       hc.id_tipo_entrega, (nvl((select plazo from cmw_historico_cotiza_auto_plazos hp where hp.id_proveedor = hc.id_proveedor), 15) - trunc(sysdate - hc.fec_pedido)) dias_restante
                  from cmw_historico_cotiza_auto hc
                  join stw_articulos ar on ar.id = hc.id_articulo
                 where /*trunc(hc.fec_pedido) between :P730_FEC_INI and :P730_FEC_FIN
                   and */(ar.cod_articulo = :P730_COD_ARTICULO or :P730_COD_ARTICULO is null)
                   and (hc.id_proveedor = :P730_ID_PROVEEDOR or :P730_ID_PROVEEDOR is null)
                   and (nvl(hc.ind_excel, 'N') = :P730_IND_EXCEL or :P730_IND_EXCEL is null)
                ```
            pageItemsToSubmit: [
                P730_COD_ARTICULO
                P730_ID_PROVEEDOR
                P730_IND_EXCEL
            ]
        }
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Hist
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 10385980991498104
        }

