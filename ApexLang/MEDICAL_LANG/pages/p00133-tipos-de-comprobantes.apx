page 133 (
    name: Tipos de Comprobantes
    alias: TIPOS-DE-COMPROBANTES
    title: Tipos de Comprobantes - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tipos-de-comprobantes (
        name: Tipos de Comprobantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       ID_MODULO,
                       DESCRIPCION,
                       ABREVIATURA,
                       LINEAS,
                       SALDOS,
                       STOCK,
                       CAJA,
                       ID_TIP_TALONARIO,
                       DESC_TALONARIO,
                       IND_HECHAUKA,
                       COD_USUARIO_AUD,
                       COMP_HECHAUKA,
                       IND_TESAKA,
                       IND_INTERNO,
                       IND_GENERA_CREDITO,
                       ESTADO,
                       CASE
                       WHEN ESTADO ='S' THEN 'fa fa-check u-success-text'
                       WHEN ESTADO ='N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       IVA_INCLUIDO,
                       CASE
                       WHEN IVA_INCLUIDO ='S' THEN 'fa fa-check u-success-text'
                       WHEN IVA_INCLUIDO ='N' THEN 'fa fa-remove u-danger-text'
                       END IVA_INCLUIDO_ICON,
                       LIBRO_IVA,
                       CASE
                       WHEN LIBRO_IVA ='S' THEN 'fa fa-check u-success-text'
                       WHEN LIBRO_IVA ='N' THEN 'fa fa-remove u-danger-text'
                       END LIBRO_IVA_ICON,
                       IND_ASIENTOS,
                       CASE
                       WHEN IND_ASIENTOS ='S' THEN 'fa fa-check u-success-text'
                       WHEN IND_ASIENTOS ='N' THEN 'fa fa-remove u-danger-text'
                       END IND_ASIENTOS_ICON,
                       CODIGO,
                       IND_RES_90,
                       CASE
                       WHEN IND_RES_90 ='S' THEN 'fa fa-check u-success-text'
                       WHEN IND_RES_90 ='N' THEN 'fa fa-remove u-danger-text'
                       END IND_RES_90_ICON
                  from BSW_TIPOS_COMPROBANTES
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 134
                items: {
                    P134_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 15142769519180126
        }

