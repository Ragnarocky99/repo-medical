            column: 12
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapBottom
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P392_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
