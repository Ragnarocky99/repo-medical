                     CCW_TIPOS_CUENTAS TP
                
                WHERE CB.NRO_CUENTA = :P392_NRO_CUENTA
                  AND CB.ID_PER_JURIDICA = P.ID 
                  AND TP.ID = CB.ID_TIP_CUENTA 
                  AND CB.ID_MONEDA = M.ID
                  AND CB.ACTIVO = 'S'
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P392_ID
        }
    )

