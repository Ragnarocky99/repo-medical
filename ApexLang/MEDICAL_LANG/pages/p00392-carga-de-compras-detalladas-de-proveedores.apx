    dynamicAction set-timbrado-ser (
        name: SET_TIMBRADO_SER
        execution {
            sequence: 140
        }
        when {
            selectionType: items
            items: P392_SER_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: Nunca fue necesario...
        }

        action busca-timbrado (
            name: Busca_timbrado
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera NUMBER := 0;
                    BEGIN 
                    IF :P392_SER_COMPROBANTE IS NOT NULL THEN
                        SELECT NVL((SELECT 1 
                                    FROM BSW_SERIES_COMPROB 
                                    WHERE ID_EMPRESA      = :P0_ID_EMPRESA
                                     AND SER_COMPROBANTE  = :P392_SER_COMPROBANTE
                                     AND TIP_COMPROBANTE  = :P392_TIP_COMPROBANTE
                                     AND (:P392_FEC_COMPROBANTE BETWEEN FEC_INICIO AND FEC_VENCIMIENTO)
                                     /*AND FEC_VENCIMIENTO  > :P392_FEC_COMPROBANTE
                                     AND FEC_INICIO       < :P392_FEC_COMPROBANTE*/
                                     AND IND_ACTIVO = 'S'),0) AS BANDERA 
                          INTO vbandera
                        FROM DUAL;
                        :P392_TIMBRADO_BANDERA := vbandera;
                            
                         end if;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(-20000,'El vencimiento del timbrado ha caducado o ya no está activo');
                    END;
                    
                    ```
                itemsToSubmit: [
                    P392_SER_COMPROBANTE
                    P392_TIP_COMPROBANTE
                    P392_FEC_COMPROBANTE
                    P0_ID_EMPRESA
                ]
                itemsToReturn: P392_TIMBRADO_BANDERA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró el nro. de timbrado actualizado.
                style: danger
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P392_TIMBRADO_BANDERA
                value: 0
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P392_RUC
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P392_TIMBRADO_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT S.NRO_TIMBRADO FROM BSW_SERIES_COMPROB S
                    WHERE S.TIP_COMPROBANTE = :P392_TIP_COMPROBANTE
                      AND S.ID_EMPRESA      = :P0_ID_EMPRESA
                      AND S.SER_COMPROBANTE = :P392_SER_COMPROBANTE
                      --AND :P392_FEC_COMPROBANTE BETWEEN S.FEC_INICIO AND S.FEC_VENCIMIENTO
                      AND S.IND_ACTIVO = 'S'
