        action generar-json (
            name: GENERAR_JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P392_TOT_COMPROBANTE IS NOT NULL THEN
                      
                            DECLARE
                              TMP_CUOTAS_CP_PRO CONSTANT VARCHAR2(255) :='CUOTAS';
                              
                              vdias      NUMBER(18) := 0;
                              vindice    NUMBER(13);
                              vtot_cuota NUMBER(20,3);
                              vtotal     NUMBER(20,3);
                              vfec_venc  DATE;
                              vdia_sem   VARCHAR2(12);
                              v1er_reg   VARCHAR2(11) := 'S';
                              vperiodo   VARCHAR2(5);
                              vTotParcial      number(18,3);
                              v_id_prove NUMBER(10)   := :P392_ID_PROVEEDOR;
                              
                            BEGIN
                          
                                vfec_venc := TO_DATE(:P392_FEC_COMPROBANTE, 'DD/MM/YYYY') + :P392_DIAS_CUOTA;
                                vtot_cuota := round( nvl( REPLACE(:P392_TOT_COMPROBANTE,'.',''), 0 ) /
                                               nvl( :P392_CANT_CUOTAS, 1 ), :P392_DECIMALES);
                                
                                IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_CUOTAS_CP_PRO) THEN
                                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_CUOTAS_CP_PRO);
                                END IF;
                    
                                APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_CUOTAS_CP_PRO);
                                :P392_CTOT_SALDO := 0;  
                                :P392_CTOT_CUOTA := 0;  
                    
                                FOR vindice IN 1..:P392_CANT_CUOTAS LOOP
                               
                                    IF NVL(:P392_INTERVALO_CUOTA,0) = 30 THEN
                                       vfec_venc := add_months(TO_DATE(:P392_FEC_COMPROBANTE, 'DD/MM/YYYY'), vindice );
                                    ELSE
                                       vfec_venc := vfec_venc + :P392_INTERVALO_CUOTA;
                                    END IF;
                    
                                    vperiodo := :P392_INTERVALO_CUOTA;
                                    vdia_sem := TO_CHAR( TO_DATE( vfec_venc ),'DAY' );
                                    vtotal   := nvl( vtotal, 0 ) + nvl( vtot_cuota, 0 );
                                    vdias    := vdias + :P392_INTERVALO_CUOTA;
                    
                                    IF nvl( vindice, 0 ) = nvl( :P392_CANT_CUOTAS, 1 ) THEN
                                    --    IF nvl( vtotal, 0 ) < nvl( REPLACE(:P392_TOT_COMPROBANTE,'.',''), 0 ) THEN
                                              vTotParcial :=  round((REPLACE(:P392_TOT_COMPROBANTE,'.','')/:P392_CANT_CUOTAS),:P392_DECIMALES);
                                              vtotal := round(REPLACE(:P392_TOT_COMPROBANTE,'.','')-(vTotParcial * (:P392_CANT_CUOTAS-1)) ,:P392_DECIMALES);
                                            --vtotal := round( nvl( REPLACE(:P392_TOT_COMPROBANTE,'.',''), 0 ) - nvl( vtotal, 0 ), :P392_DECIMALES );
                                          --  vtot_cuota := vtot_cuota + vtotal;
                                          vtot_cuota:=vtotal;
                                      --  END IF;
                                    END IF;
                                    
                                    IF NVL(:P392_TIP_SALDO,'N') = 'R' THEN
                                        vtot_cuota := vtotal * -1;
                                        --:P392_CTOT_SALDO := vtotal * -1;
                                    END IF;
                    
                             
                                    APEX_COLLECTION.ADD_MEMBER(
                                        p_collection_name => TMP_CUOTAS_CP_PRO,
                                        p_c001 => vindice,      --num_cuota
                                        p_c002 => vperiodo,     --periodo
                                        p_c003 => vfec_venc,    --fec_venc
                                        p_c004 => vdia_sem,     --dias
                                        p_N001 => vtot_cuota,   --total_cuota
                                        p_N002 => vtot_cuota,   
                                        p_c007 => v_id_prove    
                                    );
                    
                                END LOOP;
                            END;
                        
                        --END IF;
                    ELSE
                        RAISE_APPLICATION_ERROR(-20000,'Para generar la cuota debe cargar el comprobante.');    
                    END IF;
                    
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                      
                        OPEN l_cursor FOR
                        SELECT  C001 AS NRO_CUOTA,
                                C002 AS PERIODO,
                                C003 AS VENCIMIENTO,
                                C004 AS DIAS,
                                N001 AS TOT_CUOTA,
                                N002 AS TOT_SALDO,
                                C007 AS ID_PROVEEDOR
                        FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'CUOTAS'
                        ORDER BY TO_NUMBER(C001) DESC;
                    
                      APEX_JSON.initialize_clob_output;
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P392_JSON_CUOTA:=JSON_DETALLE;
                    END;
                    ```
                itemsToSubmit: [
                    P392_TOT_COMPROBANTE
                    P392_CTOT_CUOTA
                    P392_CTOT_SALDO
                    P392_CANT_CUOTAS
                    P392_DIAS_CUOTA
                    P392_JSON_CUOTA
                    P392_INTERVALO_CUOTA
                    P392_TIP_COMPROBANTE
                    P392_FEC_COMPROBANTE
                    P392_DECIMALES
                    P392_TIP_SALDO
                ]
                itemsToReturn: [
                    P392_JSON_CUOTA
                    P392_CTOT_SALDO
                    P392_CTOT_CUOTA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action generar-json-bkp (
            name: GENERAR_JSON_BKP
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P392_TOT_COMPROBANTE IS NOT NULL THEN
                      
                            DECLARE
                              TMP_CUOTAS_CP_PRO CONSTANT VARCHAR2(255) :='CUOTAS';
                              
                              vdias      NUMBER(18) := 0;
                              vindice    NUMBER(13);
                              vtot_cuota NUMBER(20,3);
                              vtotal     NUMBER(20,3);
                              vfec_venc  DATE;
                              vdia_sem   VARCHAR2(12);
