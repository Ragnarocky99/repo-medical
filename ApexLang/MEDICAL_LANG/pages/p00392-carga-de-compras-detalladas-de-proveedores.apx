    dynamicAction set-montos (
        name: SET_MONTOS
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                MONTO_TOTAL_C_IVA
                PORC_IVA
            ]
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: MONTO_TOTAL_C_IVA
        }

        action calc-iva (
            name: CALC_IVA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P392_TIP_COMPROBANTE <> 'IDE' THEN
                        IF NVL(:PORC_IVA,0) = 10 THEN
                            :TOTAL_IVA   := nvl(ROUND( TO_NUMBER(REPLACE(:MONTO_TOTAL_C_IVA, '.', '')) / 11, :P392_DECIMALES),0);-- ( to_number(replace(11, ',', '')) / 100)),0);
                        ELSIF NVL(:PORC_IVA,0) = 5 THEN
                            :TOTAL_IVA   := nvl(ROUND( TO_NUMBER(REPLACE(:MONTO_TOTAL_C_IVA, '.', '')) / 21, :P392_DECIMALES),0);--
                        ELSIF NVL(:PORC_IVA,0) = 0 THEN
                            --:TOTAL_IVA := nvl(ROUND( TO_NUMBER(REPLACE(:MONTO_TOTAL_C_IVA, '.', ''))),0);
                            :TOTAL_IVA   := 0;
                        END IF;
                    
                        :MONTO_TOTAL := ROUND(TO_NUMBER(REPLACE(:MONTO_TOTAL_C_IVA, '.', '')) - TO_NUMBER(REPLACE(:TOTAL_IVA, '.', '')),:P392_DECIMALES);
                    ELSE
                        :MONTO_TOTAL := 0;
                    END IF;
                    ```
                itemsToSubmit: [
                    PORC_IVA
                    P392_TIP_COMPROBANTE
                    TOTAL_IVA
                    MONTO_TOTAL_C_IVA
                    P392_DECIMALES
                ]
                itemsToReturn: [
                    TOTAL_IVA
                    MONTO_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

