    computation p392-num-comprobante (
        itemName: P392_NUM_COMPROBANTE
        execution {
            sequence: 50
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_num_comp_cp  CPW_COMPROBANTES_CABECERA.NUM_COMPROBANTE%TYPE;
                BEGIN
                    IF :P392_NUM_COMPROBANTE IS  NULL THEN 
                        SELECT to_number(MAX(CP.NUM_COMPROBANTE))+1
                          INTO v_num_comp_cp
                        FROM CPW_COMPROBANTES_CABECERA CP
                        WHERE TIP_COMPROBANTE = :P392_TIP_COMPROBANTE
                          AND SER_COMPROBANTE = :P392_SER_COMPROBANTE
                          AND ID_EMPRESA=:P0_COD_EMPRESA;
                
                        IF v_num_comp_cp is null then
                            v_num_comp_cp:=1;
                        END IF;
                    END IF;
                    RETURN v_num_comp_cp;
                    exception
                        WHEN NO_DATA_FOUND THEN
                            v_num_comp_cp:=1;
                            return v_num_comp_cp;
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(20000,'Error al generar el nro. de comprobante'||sqlerrm);
                            v_num_comp_cp:=1;
                            return v_num_comp_cp;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P392_ID
        }
    )

