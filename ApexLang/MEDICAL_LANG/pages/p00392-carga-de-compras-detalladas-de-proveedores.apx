    dynamicAction relacionar-factura (
        name: RELACIONAR_FACTURA
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @b392-rel-fact
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_PROVEEDOR CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_PROVEEDOR) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_PROVEEDOR);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_PROVEEDOR);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_PROVEEDOR,
                        p_c001 => :P268_ID_PROVEEDOR,
                        p_C002 => replace(:P268_TOT_COMPROBANTE,'.','')*-1,
                        p_c003 => :P268_ID_MONEDA,
                        p_c004 => :P268_ID
                         );
                    END;
                    ```
                itemsToReturn: URL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction separar-ci-ruc (
        name: SEPARAR_CI_RUC
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P392_RUC
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: Funciona, pero se optimizó. Se agregó en la acción "BUSCA_RUC"
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vci  varchar(12);
                        
                    BEGIN
                        IF :P392_RUC IS NOT NULL AND (instr(:P392_RUC,'-',1) > 0 ) THEN
                            IF length(:P392_RUC) = 7 THEN -- CI DE 5 DÍGITOS
                              
                                vci := SUBSTR(:P392_RUC,1,5);
                                
                            ELSE IF length(:P392_RUC) = 8 THEN -- CI DE 6 DÍGITOS
                              
                                 vci := SUBSTR(:P392_RUC,1,6);
                                 
                                 ELSE IF length(:P392_RUC) = 9 THEN -- CI DE 7 DÍGITOS
                                   
                                      vci := SUBSTR(:P392_RUC,1,7);
                                      
                                      ELSE IF length(:P392_RUC) = 10 THEN -- CI DE 8 DÍGITOS
                                        
                                           vci := SUBSTR(:P392_RUC,1,8);
                                           
                                           END IF;
                               
                                      END IF;
                                 END IF;
                            END IF;
                            
                        else
                    
                            raise_application_error(-20000, 'Favor cargar un ruc válido.');
                        
                        END IF;
                        :P392_CI_PRO := vci;
                    END;
                    
                    ```
                itemsToSubmit: P392_RUC
                itemsToReturn: P392_CI_PRO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

