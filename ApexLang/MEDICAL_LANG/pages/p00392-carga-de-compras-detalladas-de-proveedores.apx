        action insert-json-det (
            name: INSERT_JSON_DET
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                      var T = $v("P392_JSON_CUOTA"), J, intento = 0, maxIntentos = 20;
                      if(!T){ console.warn("P392_JSON_CUOTA vacío. No se carga nada."); return; }
                      try{ J = JSON.parse(T); }
                      catch(e){ console.error("JSON inválido:",e); apex.message.alert("El JSON de cuotas no es válido."); return; }
                    
                      function txt(v){ return v===null||v===undefined?"":v.toString(); }
                      function dec(v){ return v===null||v===undefined?"":v.toString().replace(/\./g,","); }
                      function num(v){
                        if(v===null||v===undefined||v===""){ return 0; }
                        var s=v.toString().trim();
                        if(s.indexOf(",")>=0){ s=s.replace(/\./g,"").replace(",","."); }
                        return Number(s)||0;
                      }
                      function tieneDatos(o){ return o && Object.keys(o).some(k => o[k]!==null && o[k]!==undefined && o[k]!=="" ); }
                      function setCol(model,rec,col,val){
                        if(val===null||val===undefined||val===""){ return; }
                        try{ model.setValue(rec,col,val.toString()); }
                        catch(e){ console.error("Error en columna:",col,"Valor:",val,e);
                          apex.message.alert("Error al cargar la columna "+col+". Verificá si está Read Only, Display Only o Query Only en el IG Cuotas.");
                          throw e;
                        }
                      }
                    
                      function esperarIG(){
                        var ig$ = apex.region("Cuotas").widget();
                        var grid = ig$.interactiveGrid("getCurrentView");
                        grid.setEditMode(true);
                        var model = grid.model;
                        console.log("Intento:",intento,"allowAdd:",model.allowAdd(),"canAdd:",model.check("canAdd"));
                        if(model.allowAdd() && model.check("canAdd")){ cargarCuotas(model); return; }
                        intento++;
                        if(intento<maxIntentos){ setTimeout(esperarIG,300); return; }
                        apex.message.alert("El grid Cuotas no permite agregar filas todavía. Revisá si el código se ejecuta antes del refresh del IG o si alguna configuración bloquea Add Row.");
                      }
                    
                      function toApexDate(v){
                            if(!v) return "";
                        // Si viene como yyyy-mm-dd
                        if(v.indexOf("-") > 0){
                            var parts = v.split("-");
                            return parts[2].padStart(2,"0") + "/" + parts[1].padStart(2,"0") + "/" + parts[0];
                        }
                        // Si viene como timestamp tipo 2026-08-24T00:00:00
                        if(v.indexOf("T") > 0){
                            var d = new Date(v);
                            return d.getDate().toString().padStart(2,"0") + "/" +
                                (d.getMonth()+1).toString().padStart(2,"0") + "/" +
                                d.getFullYear();
                        }
                        // Si ya viene como dd/mm/yyyy lo dejamos igual
                        return v;
                      }
                    
                    
                    
                      function cargarCuotas(model){
                        try{
                          if(!J || !Array.isArray(J.DETALLE) || J.DETALLE.length===0){ console.log("No hay cuotas para cargar."); return; }
                          var cuotas = J.DETALLE.filter(tieneDatos);
                          if(cuotas.length===0){ console.log("El JSON no tiene cuotas con datos."); return; }
                    
                          for(let i=0;i<cuotas.length;i++){
                            var c = cuotas[i];
                            if(!model.allowAdd() || !model.check("canAdd")){ throw new Error("El modelo dejó de permitir insertar en la línea "+(i+1)); }
                            var rec = model.getRecord(model.insertNewRecord());
                    
                            setCol(model,rec,"NUM_CUOTA",txt(c.NRO_CUOTA));
                            setCol(model,rec,"PERIODO_DIAS",txt(c.PERIODO));
                            setCol(model, rec, "FEC_VENCIMIENTO", toApexDate(c.VENCIMIENTO));
                            setCol(model,rec,"TOT_CUOTA",dec(c.TOT_CUOTA));
                            setCol(model,rec,"TOT_SALDO",dec(c.TOT_SALDO));
                            setCol(model,rec,"TOT_CUOTA_COPIA",dec(c.TOT_CUOTA));
                            setCol(model,rec,"TOT_SALDO_COPIA",dec(c.TOT_SALDO));
                          }
                          console.log("Carga de cuotas finalizada. Filas cargadas:",cuotas.length);
                        }catch(e){ console.error("Error cargando cuotas:",e); }
                      }
                    
                      setTimeout(esperarIG,300);
                    
                      // 🔹 recalcular totales después de que el IG procese las filas
                      setTimeout(calculaTotCuotas, 300);
                    })();
                    ```
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

