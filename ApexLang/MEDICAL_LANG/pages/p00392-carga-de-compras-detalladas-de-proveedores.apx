    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 300
        }
        when {
            selectionType: items
            items: P392_FEC_CAJA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P392_FEC_CAJA) = 8) then
                    
                            conv_fecha := replace(:P392_FEC_CAJA,'/','');
                            conv_fecha := substr(:P392_FEC_CAJA,1,2)||'/'||
                                                      substr(:P392_FEC_CAJA,3,2)||'/'||
                                                      lpad(substr(:P392_FEC_CAJA,5,4),4,'0');
                    
                        :P392_FEC_CAJA := conv_fecha;
                            ELSIF (length(:P392_FEC_CAJA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P392_FEC_CAJA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P392_FEC_CAJA
                itemsToReturn: P392_FEC_CAJA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

