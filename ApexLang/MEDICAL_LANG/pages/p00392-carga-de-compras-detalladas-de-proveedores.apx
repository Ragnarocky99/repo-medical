                       C.NOM_PROVEEDOR,
                       C.RUC_REF,
                       C.NOM_PROVEEDOR_REF,
                       C.ID_PROVEEDOR,
                       C.ID_PROVEEDOR_REF,
                       C.NRO_TIMBRADO,
                       C.FEC_TIMBRADO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ID_CUENTA,
                       C.ID_CENTRO_COSTO,
                       C.IND_GENERA_ASIENTO,
                       C.IVA_INCLUIDO,
                       C.IND_SALDO_CLIENTE,
                       C.REFERENCIA,
                       C.ID_DESPACHO,
                       C.NRO_DESPACHO,
                       C.NRO_DESPACHO_EX,
                       C.DESTINO,
                       --C.FEC_CAJA,
                       C.NRO_PLANILLA_FF,
                       C.NRO_CUENTA,
                       C.COD_USUARIO_AUD,
                       C.ID_USUARIO,
                       C.ID_USUARIO_MOD,
                       C.FEC_CARGA,
                       C.CANT_CUOTAS,
                       C.TOT_IVA,
                       C.FEC_CAJA,
                       --C.SUBTOTAL,
                       C.TOT_COMPROBANTE,
                       C.ID_ORDEN_PAGO,
                       C.FOTO_COMPROBANTE, 
                       c.referencia_nc,
                       C.IND_TIPO_COMPROBANTE,
                       C.FEC_ULT_CARGA,
                       C.ID_LICITACION_CAB,
                       C.TIPO_POLIZA,
                       C.FEC_VIGENCIA_POLIZA,
                       C.TIPO_CAMBIO,
                       C.ID_PEDIDO_CAB_REF
                FROM CPW_COMPROBANTES_CABECERA C
                ```
