    validation validar-fact (
        name: VALIDAR_FACT
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare vcant number (10);
                        vcant1 number (10);
                        vexiste exception;
                begin
                  IF :P392_REFERENCIA IS NULL AND nvl(:P392_IVA_INCLUIDO,'N') = 'S' THEN
                    raise_application_error(-20000,'Debe ingresar el número de comprobante del proveedor.');
                    return false;
                  END IF;
                
                IF :P392_TIP_COMPROBANTE <> 'FEX' THEN 
                  if (length(:P392_REFERENCIA) > 6 and length(:P392_REFERENCIA) < 14) 
                      and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or
                           :P392_TIP_COMPROBANTE IN  ('RTI'))  then
                    :P392_REFERENCIA := replace(:P392_REFERENCIA,'-','');
                    :P392_REFERENCIA := substr(:P392_REFERENCIA,1,3)||'-'||
                                              substr(:P392_REFERENCIA,4,3)||'-'||
                                              lpad(substr(:P392_REFERENCIA,7,7),7,'0');
                  end if;
                  
                  if (length(:P392_REFERENCIA) > 15  and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or
                           :P392_TIP_COMPROBANTE = 'RTI') AND :P392_TIP_COMPROBANTE != 'IDE' AND :P392_TIP_COMPROBANTE != 'DES' ) then
                    raise_application_error(-20000,'No puede exeder los 15 digitos para el nro de factura 999-999-9999999');
                    return false;
                  end if;
                  
                  
                  if (length(:P392_REFERENCIA) != 15  and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or
                           :P392_TIP_COMPROBANTE IN ('RTI')) AND :P392_TIP_COMPROBANTE != 'IDE' AND :P392_TIP_COMPROBANTE != 'DES' )  then
                    raise_application_error(-20000,'El nro de factura no puede ser diferente a 15 digitos. 999-999-9999999');
                    return false;
                  end if;
                  
                  if ( ( SUBSTR(:P392_REFERENCIA,4,1) != '-' or  SUBSTR(:P392_REFERENCIA, 8,1) != '-' )  and (nvl(:P392_IVA_INCLUIDO,'N') = 'S'  or
                           :P392_TIP_COMPROBANTE IN ('RTI'))  AND :P392_TIP_COMPROBANTE != 'IDE' AND :P392_TIP_COMPROBANTE != 'DES' )  then
                      raise_application_error(-20000,'El nro de factura debe tener el siguiente formato 999-999-9999999');
                      return false;
                  end if;
                ELSE
                    NULL;
                 END IF; 
                /*
                ----------------------------------
                if nvl(:variables.PERMITE_DUPLICAR , 'N') = 'N' THEN
                    begin
                        if :P392_REFERENCIA is not null then
                            begin
                              select count(referencia)
                                into vcant
                                from cm_compras_cabecera
                               where referencia     = :b_cabecera.referencia 
                                 and cod_proveedor  = :b_cabecera.cod_proveedor_ref 
                                 and cod_timbrado   = :b_cabecera.nro_timbrado;
                                exception
                                    when no_data_found then
                                        vcant := 0;
                                    when others then
                                        mensaje('Error al Validar la Factura '||sqlerrm);
                                        raise form_trigger_failure;
                            end;
                            begin
                                select count(referencia)
                                  into vcant1
                                  from cp_comprobantes_cabecera
                                 where referencia = :b_cabecera.referencia 
                                   and cod_proveedor = :b_cabecera.cod_proveedor_ref
                                   and NRO_timbrado  = :b_Cabecera.nro_timbrado;
                                exception
                                    when no_data_found then
                                        vcant := 0;
                                    when others then
                                        mensaje('Error al Validar la Factura '||sqlerrm);
                                        form_trigger_failure;
                            end;
                            if (nvl(vcant, 0) + nvl(vcant1, 0)) > 0 then
                               raise vexiste;
                            end if;
                        else
                            IF NVL(:b_cabecera.imprime_iva,'n') = 'S' THEN
                                mensaje_ex('Debe ingresar el Nº de Factura', 1);
                                raise form_trigger_failure;     
                            end if;
                                end if;
                                    exception
                                        when vexiste then
                                            mensaje_ex('Esta factura ya se encuentra ingresada', 1);
                                            raise form_trigger_failure;
                    end;
                ELSE
                    NULL;
                END IF;*/
                --------------------------------
                return TRUE;
                end;
                ```
        }
        error {
            errorMessage: "Error al validar la factura. "
        }
    )

