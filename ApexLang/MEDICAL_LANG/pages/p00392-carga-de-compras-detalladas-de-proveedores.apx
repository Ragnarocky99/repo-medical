    validation cuota-contado (
        name: CUOTA_CONTADO
        execution {
            sequence: 60
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P392_TIP_COMPROBANTE = 'CO' AND :P392_CANT_CUOTAS = 1 THEN
                    RETURN TRUE;
                ELSE IF :P392_TIP_COMPROBANTE <> 'CO' AND :P392_CANT_CUOTAS > 1 THEN
                        RETURN TRUE;
                     ELSE
                        RETURN FALSE;
                     END IF;
                END IF;
                ```
        }
        error {
            errorMessage: La cantidad de cuota no corresponde a un Tip. Comprobante Contado.
            displayLocation: onErrorPage
        }
        serverSideCondition {
            type: never
        }
    )

    validation valida-proveedor-factura (
        name: VALIDA PROVEEDOR-FACTURA
        execution {
            sequence: 70
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vBandera NUMBER(1);
                  
                BEGIN
                    BEGIN
                        SELECT 1
                          INTO vBandera
                        FROM CPW_COMPROBANTES_CABECERA C
                        WHERE /*C.ID_PROVEEDOR  = :P392_ID_PROVEEDOR 
                         ---- AND*/ C.ID_PROVEEDOR_REF  = :P392_ID_PROVEEDOR_REF
                          AND C.REFERENCIA    = :P392_REFERENCIA
                          AND C.TIP_COMPROBANTE = :P392_TIP_COMPROBANTE;
                    EXCEPTION 
                          WHEN NO_DATA_FOUND THEN
                               vBandera := 0;
                    END;
                    
                    IF vBandera = 1 THEN
                       RETURN FALSE;
                    ELSIF vBandera = 0 THEN
                       RETURN TRUE;
                    END IF;
                    
                END;
                ```
        }
        error {
            errorMessage: Ya existe una factura cargada con este Proveedor.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: B392_GUARDAR
        }
    )

