        action url-carga-persona (
            name: URL_CARGA_PERSONA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P392_URL_CARGA_PERSONA:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:180:'||l_session||'::NO::P180_CI,P180_RUC,P180_NOMBRE:&P392_CI_PRO.,&P392_RUC.,&P392_NOM_PROVEEDOR.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P392_RUC
                    P392_URL_CARGA_PERSONA
