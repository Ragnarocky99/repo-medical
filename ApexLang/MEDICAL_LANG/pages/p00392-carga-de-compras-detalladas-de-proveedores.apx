        action desc-comp (
            name: DESC_COMP
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT T.DESCRIPCION
                    FROM BSW_TIPOS_COMPROBANTES T
                    WHERE T.TIP_COMPROBANTE = :P392_TIP_COMPROBANTE
                      AND T.ID_EMPRESA      = :P0_ID_EMPRESA
                      AND T.ID_MODULO       = TRAE_MODULO_ID('CP')
                    ```
                itemsToSubmit: [
                    P392_TIP_COMPROBANTE
                    P0_ID_EMPRESA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P392_DESC_COMPROBANTE
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action ind-asiento (
            name: IND_ASIENTO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL((SELECT 'S'
                                FROM BSW_TIPOS_COMPROBANTES T
                                WHERE T.TIP_COMPROBANTE = :P392_TIP_COMPROBANTE
                                  AND T.ID_EMPRESA      = :P0_ID_EMPRESA
                                  AND T.ID_MODULO       = TRAE_MODULO_ID('CP')
                                  AND (T.IND_ASIENTOS      = 'S')),'N') GENERA_ASIENTO
                    -- INTO :P392_IND_GENERA_ASIENTO
                    FROM DUAL;
                    ```
                itemsToSubmit: [
                    P392_TIP_COMPROBANTE
                    P0_ID_EMPRESA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P392_IND_GENERA_ASIENTO
