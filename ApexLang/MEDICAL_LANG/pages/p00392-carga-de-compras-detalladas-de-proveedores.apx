            }
        )

    )

    dynamicAction validar-ruc-ref (
        name: VALIDAR_RUC_REF
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: P392_RUC_REF
        }

        action busca-ruc-ref (
            name: BUSCA_RUC_REF
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        CPWP_VALIDA_RUC_PROVEEDOR(
                                            p_empresa       => :P0_ID_EMPRESA,
                                            p_ruc           => :P392_RUC_REF,
                                            p_cod_usuario   => :APP_USER,
                                            p_ci            => :P392_CI_PRO_REF,
                                            p_ruc_ban       => :P392_BANDERA_RUC_REF,
                                            p_ruc_saved_ban => :P392_BANDERA_RUC_GUARDADO_REF,
                                            p_id_prov       => :P392_ID_PROVEEDOR_REF,
                                            p_nombre_prov   => :P392_NOM_PROVEEDOR_REF,
                                            p_mensaje       => :P392_MENSAJE_RUC_REF
                                        );
                    END;
                    
                    ```
                itemsToSubmit: [
                    P392_RUC_REF
                    P392_ID_EMPRESA
                ]
                itemsToReturn: [
                    P392_CI_PRO_REF
                    P392_BANDERA_RUC_REF
                    P392_ID_PROVEEDOR_REF
                    P392_NOM_PROVEEDOR_REF
                    P392_MENSAJE_RUC_REF
                    P392_BANDERA_RUC_GUARDADO_REF
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-alert (
            action: alert
            settings {
                title: Advertencia
                message: No se encontró el RUC.
                style: danger
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P392_BANDERA_RUC
                value: 0
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nombre from contribuyentes c
                    where c.ruc||'-'||c.dv = :P392_RUC_REF
                    ```
                itemsToSubmit: P392_RUC_REF
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P392_NOM_PROVEEDOR_REF
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nombre from contribuyentes c
                    where c.ruc||'-'||c.dv = :P392_RUC_REF
                    ```
                itemsToSubmit: P392_RUC_REF
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P392_NOM_PROVEEDOR_REF
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

