    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            
            //CALCULA SUBTOTAL
            function calculaSubtotales(){
            
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
            
                var v_montotal = model.getFieldKey("MONTO_COPIA") || 0;
                
                var v_subtotal  = 0;
            
                var v_moniva = model.getFieldKey("TOTAL_IVA_COPIA") || 0;
                
                var v_subiva  = 0;
                
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                        let vcl_montotal = r[v_montotal].replace(/\./g,'');
                        let vcl_moniva   = r[v_moniva].replace(/\./g,'');
            
                        v_subtotal = v_subtotal + parseFloat(vcl_montotal.replace(',','.')); //Reemplazamos la coma por punto y calculamos
                        v_subiva = v_subiva     + parseFloat(vcl_moniva.replace(',','.'));   //Reemplazamos la coma por punto y calculamos
                       
                    }
                    
                    
                });
            
                $s('P392_SUBTOTAL',v_subtotal.toString().replace(/\./g,','));
                $s('P392_TOT_IVA',v_subiva.toString().replace(/\./g,','));
            
            
            
            }
            
            //Total Comprobante
            function calculaTotalComp() {
                var v_tot_comp, v_subtot, v_totiva;
                
                v_subtot   = $v("P392_SUBTOTAL").replace(/\./g,'') || 0;
                v_totiva   = $v("P392_TOT_IVA").replace(/\./g,'')  || 0; 
            
                
                v_tot_comp = ( parseFloat(v_subtot.replace(',','.')) + parseFloat(v_totiva.replace(',','.'))||0 );  
            
                console.log('los subtotales son: ' + v_subtot + " | " + v_totiva);
                console.log('el total: ' + v_tot_comp);
            
                
                $s("P392_TOT_COMPROBANTE", v_tot_comp.toString().replace(/\./g,',') || 0);
            
            }
            
            
            function calculaTotCuotas(){
                var model = apex.region("Cuotas").widget().interactiveGrid("getCurrentView").model;
                var cant_registros = model.getTotalRecords();
            
                var v_cuota = model.getFieldKey("TOT_CUOTA");
                var v_saldo = model.getFieldKey("TOT_SALDO");
            
                var v_totcuota = 0;
                var v_totsaldo = 0;
            
                model.forEach(function(r, index, id) {
                    var meta = model.getRecordMetadata(id);
            
                    if (meta && !meta.deleted) {
                        // Evitar null/undefined
                        let vcl_cuota = r[v_cuota] || "0";
                        let vcl_saldo = r[v_saldo] || "0";
            
                        // Normalizar a número
                        vcl_cuota = vcl_cuota.toString().replace(/\./g,'').replace(',','.');
                        vcl_saldo = vcl_saldo.toString().replace(/\./g,'').replace(',','.');
            
                        v_totcuota += parseFloat(vcl_cuota) || 0;
                        v_totsaldo += parseFloat(vcl_saldo) || 0;
            
                        console.log("----detalle total de saldo n. " + cant_registros + ": " + vcl_saldo + " cuota: " + vcl_cuota);
                    }
                });
            
                console.log("total saldo: " + v_totsaldo + ", total cuota: " + v_totcuota);
            
                $s('P392_CTOT_CUOTA', v_totcuota.toString().replace(/\./g,','));
                $s('P392_CTOT_SALDO', v_totsaldo.toString().replace(/\./g,','));
            }
            
            
            function calculaTotCuotasCopia(){
                var model = apex.region("Cuotas").widget().interactiveGrid("getCurrentView").model;
                var cant_registros = model.getTotalRecords();
            
                var v_cuota = model.getFieldKey("TOT_CUOTA_COPIA");
                var v_saldo = model.getFieldKey("TOT_SALDO_COPIA");
            
                var v_totcuota = 0;
                var v_totsaldo = 0;
            
                model.forEach(function(r, index, id) {
                    var meta = model.getRecordMetadata(id);
            
                    if (meta && !meta.deleted) {
                        // APEX 26.1 puede devolver null o número directamente
                        let vcl_cuota = r[v_cuota] || "0";
                        let vcl_saldo = r[v_saldo] || "0";
            
                        // Normalizar a string y limpiar separadores
                        vcl_cuota = vcl_cuota.toString().replace(/\./g,'').replace(',','.');
                        vcl_saldo = vcl_saldo.toString().replace(/\./g,'').replace(',','.');
            
                        v_totcuota += parseFloat(vcl_cuota) || 0;
                        v_totsaldo += parseFloat(vcl_saldo) || 0;
            
                        console.log("----detalle total de saldo n. " + cant_registros + ": " + vcl_saldo + " cuota: " + vcl_cuota);
                    }
                });
            
                console.log("total saldo: " + v_totsaldo + ", total cuota: " + v_totcuota);
            
                // Enviar valores al formulario
                $s('P392_CTOT_CUOTA', v_totcuota.toString().replace(/\./g,','));
                $s('P392_CTOT_SALDO', v_totsaldo.toString().replace(/\./g,','));
            }
            ```
