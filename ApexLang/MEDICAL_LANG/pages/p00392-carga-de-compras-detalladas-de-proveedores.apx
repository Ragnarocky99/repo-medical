            plsqlFunctionBody:
                ```plsql
                IF :P392_RUC IS NOT NULL THEN 
                    RETURN TRUE;
                ELSE 
                    RETURN FALSE;
                END IF;
                ```
        }
        error {
            errorMessage: Debe cargar cargar RUC para guardar.
            displayLocation: onErrorPage
            associatedItem: @P392_RUC
        }
        serverSideCondition {
            whenButtonPressed: @b392-guardar
        }
