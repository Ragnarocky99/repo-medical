    dynamicAction convert-fact-referencia (
        name: CONVERT_FACT_REFERENCIA
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P392_REFERENCIA
        }

        action convierte-fact-nro (
            name: CONVIERTE_FACT_NRO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fact varchar2(20);
                    
                    begin
                        if :P392_TIP_COMPROBANTE is not null AND :P392_TIP_COMPROBANTE <> 'FEX' then
                            if (length(:P392_REFERENCIA) > 6 and length(:P392_REFERENCIA) < 14) 
                                and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))  then
                    
                                conv_fact := replace(:P392_REFERENCIA,'-','');
                                conv_fact := substr(:P392_REFERENCIA,1,3)||'-'||
                                                          substr(:P392_REFERENCIA,4,3)||'-'||
                                                          lpad(substr(:P392_REFERENCIA,7,7),7,'0');
                    
                                if ( ( SUBSTR(conv_fact,4,1) != '-' or  SUBSTR(conv_fact, 8,1) != '-' )  and (nvl(:P392_IVA_INCLUIDO,'N') = 'S'  or
                                    :P392_TIP_COMPROBANTE IN ('RTI'))  AND :P392_TIP_COMPROBANTE != 'IDE' AND :P392_TIP_COMPROBANTE != 'DES' )   then
                    
                                    raise_application_error(-20000,'El nro. de factura debe tener el siguiente formato 999-999-9999999');
                    
                                end if;
                            
                            elsif NVL(:P392_IVA_INCLUIDO,'N') = 'N' OR :P392_TIP_COMPROBANTE = 'IDE' OR :P392_TIP_COMPROBANTE = 'DES' THEN
                    
                                conv_fact := :P392_REFERENCIA;
                    
                            else
                                raise_application_error(-20000,'Cargar el nro. de factura solo con números');
                            end if;
                    
                        elsif :P392_TIP_COMPROBANTE = 'FEX' THEN
                    
                            conv_fact := :P392_REFERENCIA;
                            
                        else
                            raise_application_error(-20000,'Completar el tipo de comprobante para continuar con el nro. factura.');
                        end if;
                        :P392_REFERENCIA := conv_fact;
                    end;
                    ```
                itemsToSubmit: [
                    P392_REFERENCIA
                    P392_IVA_INCLUIDO
                    P392_TIP_COMPROBANTE
                ]
                itemsToReturn: P392_REFERENCIA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare 
                        conv_fact varchar2(20);
                    
                    begin
                    
                      if (length(:P392_REFERENCIA) > 6 and length(:P392_REFERENCIA) < 14) 
                          and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' /*or :P392_TIP_COMPROBANTE IN  ('RTI')*/) then
                    
                        conv_fact := replace(:P392_REFERENCIA,'-','');
                        conv_fact := substr(:P392_REFERENCIA,1,3)||'-'||
                                                  substr(:P392_REFERENCIA,4,3)||'-'||
                                                  lpad(substr(:P392_REFERENCIA,7,7),7,'0');
                    
                        if ( ( SUBSTR(conv_fact,4,1) != '-' or  SUBSTR(conv_fact, 8,1) != '-' )  and (nvl(:P392_IVA_INCLUIDO,'N') = 'S'  or
                            :P392_TIP_COMPROBANTE IN ('RTI'))  AND :P392_TIP_COMPROBANTE != 'IDE')  then
                    
                            raise_application_error(-20000,'El nro de factura debe tener el siguiente formato 999-999-9999999');
                    
                          end if;
                      end if;
                    
                      
                    /*
                    ----------------------------------
                    if nvl(:variables.PERMITE_DUPLICAR , 'N') = 'N' THEN
                        begin
                            if :P392_REFERENCIA is not null then
                                begin
                                  select count(referencia)
                                    into vcant
                                    from cm_compras_cabecera
                                   where referencia     = :b_cabecera.referencia 
                                     and cod_proveedor  = :b_cabecera.cod_proveedor_ref 
                                     and cod_timbrado   = :b_cabecera.nro_timbrado;
                                    exception
                                        when no_data_found then
                                            vcant := 0;
                                        when others then
                                            mensaje('Error al Validar la Factura '||sqlerrm);
                                            raise form_trigger_failure;
                                end;
                                begin
                                    select count(referencia)
                                      into vcant1
                                      from cp_comprobantes_cabecera
                                     where referencia = :b_cabecera.referencia 
                                       and cod_proveedor = :b_cabecera.cod_proveedor_ref
                                       and NRO_timbrado  = :b_Cabecera.nro_timbrado;
                                    exception
                                        when no_data_found then
                                            vcant := 0;
                                        when others then
                                            mensaje('Error al Validar la Factura '||sqlerrm);
                                            form_trigger_failure;
                                end;
                                if (nvl(vcant, 0) + nvl(vcant1, 0)) > 0 then
                                   raise vexiste;
                                end if;
                            else
                                IF NVL(:b_cabecera.imprime_iva,'n') = 'S' THEN
                                    mensaje_ex('Debe ingresar el Nº de Factura', 1);
                                    raise form_trigger_failure;     
                                end if;
                                    end if;
                                        exception
                                            when vexiste then
                                                mensaje_ex('Esta factura ya se encuentra ingresada', 1);
                                                raise form_trigger_failure;
                        end;
                    ELSE
                        NULL;
                    END IF;*/
                    --------------------------------
                    return conv_fact;
                    end;
                    ```
                itemsToSubmit: [
                    P392_TIP_COMPROBANTE
                    P392_REFERENCIA
                ]
                escapeSpecialChars: false
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P392_REFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
            comments {
                comments:
                    ```
                    Funciona, pero funciona mejor con el Exe Serverside code
                    -RP.
                    ```
            }
        )

