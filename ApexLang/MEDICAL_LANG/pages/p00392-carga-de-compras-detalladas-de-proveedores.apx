    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.ID_COMPROBANTE,
                       C.NRO_ORDEN,
                       C.ID_CUENTA,
                       --C.COD_CUENTA,
                       C.ID_PROVEEDOR,
                       C.ID_CENTRO,
                       C.COMENTARIO,
                       C.ID_IVA,
                       I.PORC_IVA_COMPRA AS PORC_IVA,
                       C.ID_CONCEPTO_COMPRA,
                       C.TOTAL_IVA,
                       C.TOTAL_IVA AS TOTAL_IVA_COPIA,
                       C.MONTO_TOTAL,
                       C.MONTO_TOTAL_C_IVA,
                       C.MONTO_TOTAL AS MONTO_COPIA,
                       C.MONTO_TOTAL_C_IVA AS MONTO_TOTAL_C_IVA_COPIA,
                       C.OBSERVACION,
                       C.IND_PELIGROSO,
                       C.IND_PRORRATEO
                       
                FROM CPW_COMPROBANTES_DETALLE C
                LEFT JOIN STW_IVA I ON I.ID = C.ID_IVA
                WHERE C.ID_COMPROBANTE = :P392_ID
                ```
            pageItemsToSubmit: P392_ID
        }
        layout {
            sequence: 150
            parentRegion: @carga-de-compras-detalladas-de-proveedores
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calculaSubtotales();
                                    calculaTotalComp();
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    calculaSubtotales();
                                    calculaTotalComp();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    calculaSubtotales();
                                    calculaTotalComp();
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    calculaSubtotales();
                                    calculaTotalComp();
                            };    
                       
                       
                                
                
                        } ;      
                        return config;
                }
                
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 98683088442115113
        }

