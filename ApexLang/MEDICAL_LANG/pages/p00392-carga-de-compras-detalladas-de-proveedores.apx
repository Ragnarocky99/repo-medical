        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT CB.COD_TIP_CUENTA,
                           CB.NRO_PLANILLA_FF,--,
                           CB.ID_CUENTA,
                           NVL(CB.ID_SUCURSAL, :P0_ID_SUCURSAL),
                           :P392_FEC_COMPROBANTE
                           INTO
                           :P392_TIP_CUENTA_BANC,
                           :P392_NRO_PLANILLA_FF,--,
                           :P392_ID_CUENTA,
                           :P392_ID_SUCURSAL,
                           :P392_FEC_CAJA
                    
                    FROM CCW_CUENTAS_BANCARIAS CB, 
                         BSW_PERSONAS P, 
                         BSW_MONEDAS M, 
                         CCW_TIPOS_CUENTAS TP
                    
                    WHERE CB.NRO_CUENTA = :P392_NRO_CUENTA
                      AND CB.ID_PER_JURIDICA = P.ID 
                      AND TP.ID = CB.ID_TIP_CUENTA 
                      AND CB.ID_MONEDA = M.ID
                      AND CB.ACTIVO = 'S';
                    ```
