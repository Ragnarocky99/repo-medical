    region coutas-detalle (
        name: Coutas Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_COMPROBANTE,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_PROVEEDOR,
                       C.ID_EMPRESA,
                       C.NUM_CUOTA,
                       C.PERIODO_DIAS,
                       C.FEC_VENCIMIENTO,
                       TO_CHAR(C.FEC_VENCIMIENTO, 'DAY') AS DIAS,
                       C.TOT_CUOTA,
                       C.TOT_SALDO,
                       C.TOT_CUOTA AS TOT_CUOTA_COPIA,
                       C.TOT_SALDO AS TOT_SALDO_COPIA,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.COD_USUARIO_AUD
                
                FROM CPW_CUOTAS C
                WHERE C.ID_COMPROBANTE = :P392_ID
                
                ```
            pageItemsToSubmit: P392_ID
        }
        layout {
            sequence: 250
            parentRegion: @carga-de-compras-detalladas-de-proveedores
            slot: regionBody
            column: 1
            columnSpan: 8
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
