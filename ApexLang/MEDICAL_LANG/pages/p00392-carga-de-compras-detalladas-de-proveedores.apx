    validation valida-tot-comp-tot-cuot (
        name: VALIDA_TOT_COMP_TOT_CUOT
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF ABS(REPLACE(:P392_TOT_COMPROBANTE, '.', '')) = ABS(REPLACE(:P392_CTOT_CUOTA, '.', '')) THEN
                    RETURN NULL;
                ELSE
                 IF NVL(:P392_IND_SALDO_CLIENTE, 'N') = 'S' THEN
                    RETURN 'El total de la cuota no coincide con el total del comprobante.';
                 ELSE
                   RETURN NULL;
                 END IF;
                END IF;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: B392_ACTUALIZAR,B392_GUARDAR
        }
        comments {
            comments: Valida que el total del comprobante sea igual al total de la cuota.
        }
    )

