    process elimina-cuota-y-detalle (
        name: ELIMINA_CUOTA_Y_DETALLE
        type: executeCode
        editableRegion: @detalles
        source {
            plsqlCode:
                ```plsql
                DELETE CPW_COMPROBANTES_DETALLE D
                WHERE D.ID_COMPROBANTE  = :P392_ID;
                
                DELETE CPW_CUOTAS C
                WHERE C.ID_COMPROBANTE  = :P392_ID;
                
                
                IF :P392_TIP_COMPROBANTE = 'AAP' THEN
                 
                  DELETE CPW_CUOTAS C
                   WHERE C.ID_EMPRESA = :P392_ID_EMPRESA
                     AND C.TIP_COMPROBANTE = 'AAC'
                     AND C.SER_COMPROBANTE = :P392_SER_COMPROBANTE
                     AND C.NRO_COMPROBANTE = :P392_NUM_COMPROBANTE
                   ;
                  
                  BEGIN
                   DELETE CPW_COMPROBANTES_DETALLE D
                  WHERE D.ID_COMPROBANTE IN (
                      SELECT ID
                        FROM CPW_COMPROBANTES_CABECERA 
                       WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND TIP_COMPROBANTE = 'AAC'
                       AND SER_COMPROBANTE = :P392_SER_COMPROBANTE
                       AND NUM_COMPROBANTE = :P392_NUM_COMPROBANTE
                  );
                  EXCEPTION
                    WHEN OTHERS THEN
                         RAISE_APPLICATION_ERROR( -20000,'8-No pudo borrar detalle del AAC ' || SQLERRM );
                  END;
                  BEGIN
                    DELETE CPW_COMPROBANTES_CABECERA
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA
                       AND TIP_COMPROBANTE = 'AAC'
                       AND SER_COMPROBANTE = :P392_SER_COMPROBANTE
                       AND NUM_COMPROBANTE = :P392_NUM_COMPROBANTE;
                  EXCEPTION
                    WHEN OTHERS THEN
                         RAISE_APPLICATION_ERROR( -20000,'8-No pudo borrar el AAC ' || SQLERRM );
                  END;
                
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 55071364108435467
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: B392_BORRAR
        }
    )

