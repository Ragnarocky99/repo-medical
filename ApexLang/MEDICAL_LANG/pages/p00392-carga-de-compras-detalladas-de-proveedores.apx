        action valida-tip-comp-existe (
            name: VALIDA_TIP_COMP_EXISTE
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera number:=0;
                    BEGIN 
                    IF :P392_TIP_COMPROBANTE IS NOT NULL THEN
                        SELECT NVL((SELECT 1 
                                    FROM BSW_TIPOS_COMPROBANTES 
                                    WHERE ID_EMPRESA  = :P0_ID_EMPRESA
                                     AND ID_MODULO    = TRAE_MODULO_ID('CP')
                                     AND TIP_COMPROBANTE  = :P392_TIP_COMPROBANTE
                                     /*AND FEC_VENCIMIENTO  > :P392_FEC_COMPROBANTE
                                     AND FEC_INICIO       < :P392_FEC_COMPROBANTE*/
                                     AND ESTADO = 'S'),0) AS BANDERA 
                          INTO vbandera
                        FROM DUAL;
                        :P392_BANDERA_TIP_COMP := vbandera;
                            
                         end if;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(-20000,'El tipo de comprobante ya no se encuentra activo 
                                                o no existe dentro del módulo CP '||:P392_BANDERA_TIP_COMP);
                    END;
                    
                    
                    declare
                    vtimbrado VARCHAR2(200);
                    
                    begin
                    IF :P392_TIP_COMPROBANTE IS NOT NULL THEN
                        SELECT NVL((SELECT 1 
                                    FROM BSW_TIPOS_COMPROBANTES
                                    WHERE ID_EMPRESA      = :P0_ID_EMPRESA
                                      AND TIP_COMPROBANTE  = :P392_TIP_COMPROBANTE
                                      AND ID_MODULO        = TRAE_MODULO_ID('CP')
                                      AND ESTADO = 'S'),0) AS TIMBRADO_BAND
                         /*AND FEC_VENCIMIENTO  > :P392_FEC_COMPROBANTE
                         AND FEC_INICIO       < :P392_FEC_COMPROBANTE*/
                         /*AND ROWNUM=1*/
                           INTO vtimbrado
                         FROM DUAL;
                        IF vtimbrado = 0 THEN
                            RAISE_APPLICATION_ERROR (-20000, 'No se encontró el tipo de comprobante: ' || :P392_TIP_COMPROBANTE || ' o ya no está activo.');
                        END IF;
                    end if ;
                       EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                        NULL;
                    end;
                    
                    ```
                itemsToSubmit: [
                    P392_TIP_COMPROBANTE
                    P0_ID_EMPRESA
                ]
                itemsToReturn: P392_BANDERA_TIP_COMP
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

