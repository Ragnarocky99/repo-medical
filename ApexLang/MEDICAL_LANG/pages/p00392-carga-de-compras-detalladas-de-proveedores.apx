    process inserta-anticipo-pendiente (
        name: inserta_anticipo_pendiente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                DECLARE
                  VEXISTE   VARCHAR2(5);
                  -- Call the procedure
                    BEGIN
                    ---AGREGADO POR QUE GENERA UN AAC CADA VEZ QUE SE REALIZA UNA MODIFICACION
                       SELECT 'S'
                         into VEXISTE
                         FROM CPW_COMPROBANTES_CABECERA A
                        WHERE A.TIP_COMPROBANTE = 'AAC'
                          AND A.SER_COMPROBANTE = :P392_SER_COMPROBANTE
                          AND A.NUM_COMPROBANTE = :P392_NUM_COMPROBANTE
                          and rownum = 1;
                    EXCEPTION 
                       WHEN OTHERS THEN
                         VEXISTE := 'N';
                      
                
                      if :P392_TIP_COMPROBANTE = 'AAP' and nvl(VEXISTE,'N') <> 'S' then
                          CP_ANTICIPO_PENDIENTE(p_id_empresa => :P0_ID_EMPRESA,
                                                p_id_comprobante => :P392_ID);
                      END IF;
                  END;
                
                exception
                   when others then
                     raise_application_error(-20000,'Error Anticipo Pendiente '||sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 55096281119435481
        }
    )

    process inserta-mov-caj (
        name: INSERTA_MOV_CAJ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VTOT_COMPROBANTE    NUMBER(10);
                    vid_cuota           number(10);
                
                BEGIN
                    
                    if :P392_NRO_CUENTA is not null and :P392_CANT_CUOTAS = 1 then
                
                        SELECT CU.ID
                            INTO vid_cuota
                        FROM CPW_CUOTAS CU
                        WHERE CU.ID_COMPROBANTE = :P392_ID
                        and rownum = 1;
                        VTOT_COMPROBANTE := REPLACE(:P392_TOT_COMPROBANTE,'.','');
                        
                                             
                        insert_mov_cajas( 
                                          :P0_ID_EMPRESA,
                                          :P0_ID_SUCURSAL,
                                          :P392_ID,
                                          :P392_ID_USUARIO,
                                          :P392_FEC_CAJA,
                                          :P392_FEC_COMPROBANTE,
                                          VTOT_COMPROBANTE, --MONTO DETALLE
                                          :P392_ID_MONEDA,
                                          --:P392_ID_ORDEN_PAGO,
                                          :P392_ID_PROVEEDOR,
                                          :P392_NOM_PROVEEDOR_REF,
                                          :P392_TIP_CUENTA_BANC,
                                          vid_cuota,
                                          :P392_CANT_CUOTAS,
                                          VTOT_COMPROBANTE, --MONTO ORDEN PAGO
                                          :P392_NRO_CUENTA,
                                          TO_CHAR(:P392_NRO_PLANILLA_FF),
                                          :P392_REFERENCIA,
                                          :APP_USER
                                        );                           
                     
                    end if;
                END;
                
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 55097482008435481
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: B392_ACTUALIZAR,B392_GUARDAR
        }
    )

