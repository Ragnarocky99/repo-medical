    region reporte-de-autoriza-occ (
        name: Reporte de Autoriza OCC
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT distinct P.COD_SUCURSAL,
                       P.SUCURSAL DESC_SUCURSAL,
                       P.ESTADO,
                       P.TIP_COMPROBANTE,
                       P.SER_COMPROBANTE,
                       P.NRO_COMPROBANTE,
                       P.NRO_OCC,
                       P.FEC_COMPROBANTE,
                       P.NOMBRE NOMBRE_CLIENTE,
                       P.COD_ARTICULO,
                       P.COD_FACBRICANTE,
                       P.DESC_ARTICULO,
                       P.PRESENTACION,
                       P.UNIDAD_MEDIDA,
                       P.MARCA,
                       P.CANTIDAD_A_ENTREGAR,
                       P.AUTORIZA_STOCK,
                       P.AUTORIZA_CTACTE,
                       --P.NRO_LOTE,
                       --P.FEC_VENCIMIENTO
                       lo2.nro_lote,
                       lo2.fec_vencimiento,
                       ex.cant_dispon as Cantidad_en_lote,
                       su.descripcion       
                  FROM
                (SELECT PD.ID,
                       PD.ID_EMPRESA,
                       PD.ID_SUCURSAL,
                       SU.COD_SUCURSAL,
                       SU.DESCRIPCION SUCURSAL,
                       NVL(PD.ESTADO,'EP') ESTADO,
                       PD.TIP_COMPROBANTE,
                       PD.SER_COMPROBANTE,
                       PD.NRO_COMPROBANTE,
                       CA.NRO_OCC,
                      --- PD.FEC_COMPROBANTE,   
                       PD.AUTORIZA_STOCK_FEC FEC_COMPROBANTE,  
                       PD.ID_CLIENTE,
                       PER.NOMBRE ,
                       CA.ID_ARTICULO,
                       AR.COD_ARTICULO,
                       AR.COD_ORIGEN_ART COD_FACBRICANTE,
                       AR.DESCRIPCION DESC_ARTICULO,
                       AR.ID_ENVASE,
                       EN.DESCRIPCION PRESENTACION,
                       UM.DESCRIPCION UNIDAD_MEDIDA,
                       AR.ID_MARCA,
                       MC.DESCRIPCION MARCA,
                       CA.CANTIDAD_A_ENTREGAR,
                       DET.NRO_LOTE,
                       LT.FEC_VENCIMIENTO,
                       PD.AUTORIZA_STOCK,
                       PD.AUTORIZA_CTACTE,
                
                       nvl((select 'N' 
                        from vtw_pedidos_detalle pdd
                        where pdd.id_pedido_cabecera = pd.id
                          AND PDD.ID_ARTICULO IN ( SELECT E.ID_ARTICULO
                                                        FROM STW_EXISTENCIA_ART E
                                                        WHERE E.CANT_DISPON > 0)
                        group by 'S'),'S') ind_sin_stock,
                        
                        nvl((select 'S' 
                        from cmw_cotiza_articulos cca
                        where cca.id_pedido = pd.id
                          and (cca.nro_occ = '0' OR cca.nro_occ IS NULL) 
                        group by 'S'),'N')ind_sin_occ,
                        
                        (SELECT COUNT(*)
                          FROM CMW_COTIZA_ARTICULOS Z
                         WHERE Z.ID_PEDIDO = pd.id
                           AND (Z.NRO_OCC <> '0' OR Z.NRO_OCC IS NULL)) CANT_PEND_OCC,
                         
                         (SELECT COUNT(*)
                          FROM CMW_COTIZA_ARTICULOS Z1
                         WHERE Z1.ID_PEDIDO = pd.id
                           AND (Z1.NRO_OCC <> '0' OR Z1.NRO_OCC IS NOT NULL)) CANT_COT_OCC,
                           
                         (SELECT SUM(Z2.CANT_ANULADA)
                            FROM CMW_COTIZA_ARTICULOS Z2
                           WHERE Z2.ID_PEDIDO = PD.ID) CANT_ANULADA
                
                FROM VTW_PEDIDOS_CABECERA PD,
                     VTW_PEDIDOS_DETALLE  DET,
                     CCW_CLIENTES         CL,
                     BSW_PERSONAS         PER,
                     BSW_SUCURSALES       SU,
                     CMW_COTIZA_ARTICULOS CA,
                     STW_ARTICULOS        AR,
                     STW_UNIDADES_MEDIDA  UM,
                     STW_ENVASES          EN,
                     STW_MARCAS           MC,
                     STW_LOTES            LT
                WHERE PD.ID_EMPRESA = DET.ID_EMPRESA
                  --AND PD.ID = DET.ID_PEDIDO_CABECERA
                  AND PD.ID_CLIENTE = CL.ID
                  AND CL.ID_PERSONA =  PER.ID
                  AND PD.ID_EMPRESA = SU.ID_EMPRESA
                  AND PD.ID_SUCURSAL = SU.ID
                  AND PD.ID = CA.ID_PEDIDO
                  AND DET.ID = CA.ID_PEDIDO_DET
                  AND CA.ID_ARTICULO = AR.ID
                  AND AR.ID_UNIDAD_MEDIDA = UM.ID
                  AND AR.ID_ENVASE = EN.ID
                  AND AR.ID_MARCA = MC.ID
                  AND DET.ID_ARTICULO = LT.ID_ARTICULO
                  --AND DET.ID_LOTE = LT.ID
                  --AND PD.NRO_COMPROBANTE = 1018
                  --AND AR.COD_ARTICULO = 1356
                  ORDER BY PD.ID DESC
                ) P,
                stw_existencia_art ex,
                stw_lotes lo2,
                bsw_sucursales su
                where ex.id_articulo = p.id_articulo
                  and ex.cant_dispon > 0
                  and lo2.id = ex.id_lote
                  and su.id = ex.id_sucursal
                
                
                  and P.IND_SIN_STOCK ='N'
                  ---AND   P.ind_sin_occ = 'N'
                  AND   P.ID IN (SELECT C1.ID_PEDIDO
                                    FROM CMW_COTIZA_ARTICULOS C1
                                   WHERE obtener_cantidad_pendiente(C1.ID_PEDIDO,C1.ID_ARTICULO,C1.ID_EMPRESA,C1.id) > 0)
                
                                    ---PARA EL CONTROL DE QUE TENGA OCC LO HAGA POR ARTICULO Y NO POR PEDIDO 
                  --AND P.CANT_PEND_OCC <> 0  
                  --AND P.CANT_COT_OCC > 0
                  AND P.AUTORIZA_STOCK  = 'S'
                  AND P.AUTORIZA_CTACTE = 'S'
                  AND P.CANTIDAD_A_ENTREGAR>0
                  AND P.Nro_Occ is not null
                  AND NVL(P.CANT_ANULADA,0) < NVL(P.CANT_PEND_OCC,0)
                  and ex.id_articulo = p.id_articulo
                  and ex.cant_dispon > 0
                  and lo2.id = ex.id_lote
                  and su.id = ex.id_sucursal
                ---having sum(ex.cant_dispon,0) 
                ```
        }
