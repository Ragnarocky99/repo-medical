    dynamicAction cargar-id (
        name: Cargar Id
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @cuotas
            columns: AUTORIZAR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_collection_name CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => l_collection_name) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => l_collection_name);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => l_collection_name);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => l_collection_name,
                        p_c001 => :P273_ID_CUOTAS
                         );
                    END;
                    ```
                itemsToSubmit: P273_ID_CUOTAS
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if(id_cuotas.length>1){
                        $s('P273_ID_CUOTAS',id_cuotas);
                        id_cuotas='';
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    IF :AUTORIZAR = 'S' THEN
                    RETURN :P273_ID_CUOTAS||:ID||',';
                    ELSE 
                    RETURN REPLACE (:P273_ID_CUOTAS,:ID||',','');
                    END IF;
                    ```
                itemsToSubmit: [
                    ID
                    P273_ID_CUOTAS
                    AUTORIZAR
                ]
            }
            affectedElements {
                selectionType: items
                items: P273_ID_CUOTAS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

