    computation p273-orden-seleccionadas (
        itemName: P273_ORDEN_SELECCIONADAS
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                nombre varchar2(255):=WWV_FLOW.G_INSTANCE;
                V_ORDEN_SELECCION varchar(500);
                BEGIN
                Select /* SUBSTR(c002, 0, LENGTH(c002) - 1) as */NVL(c002,0)
                into V_ORDEN_SELECCION
                From APEX_COLLECTIONS
                Where COLLECTION_NAME = nombre
                AND SEQ_ID = 1;
                
                APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => nombre);
                return V_ORDEN_SELECCION;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                RAISE_APPLICATION_ERROR(-20000,sqlerrm);
                
                RETURN 0;
                WHEN OTHERS THEN
                RETURN 0;
                END;
                ```
        }
    )

    computation p273-permiso-carga-salarios (
        itemName: P273_PERMISO_CARGA_SALARIOS
        execution {
            sequence: 30
        }
        computation {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, 392, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER), 'CARGA_SALARIOS')
        }
    )

    computation p273-prov-param (
        itemName: P273_PROV_PARAM
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                nombre varchar2(255):=WWV_FLOW.G_INSTANCE;
                v_id_proveedor varchar(500);
                BEGIN
                Select  NVL(c001,0)
                into v_id_proveedor
                From APEX_COLLECTIONS
                Where COLLECTION_NAME = nombre
                AND SEQ_ID = 1;
                return v_id_proveedor;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                RETURN 0;
                WHEN OTHERS THEN
                RETURN 0;
                END;
                
                ```
        }
    )

