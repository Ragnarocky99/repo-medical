    region cuotas (
        name: Cuotas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_COMPROBANTE,
                       C.ID_PROVEEDOR,
                       C.NUM_CUOTA,
                       C.FEC_VENCIMIENTO,
                       ---C.TOT_CUOTA,
                       case c.tip_comprobante
                        when 'NCP' then 0-NVL(C.TOT_CUOTA,0) + NVL( C.MONTO_EN_OP,0)
                        else NVL(C.TOT_CUOTA,0) - NVL( C.MONTO_EN_OP,0)
                       end as tot_cuota,
                       --NVL(C.TOT_CUOTA,0) -NVL( C.MONTO_EN_OP,0) TOT_CUOTA,
                       CASE C.TIP_cOMPROBANTE
                        WHEN 'NCP' THEN (-1)*C.TOT_SALDO
                        ELSE C.TOT_SALDO
                       END AS TOT_SALDO,
                       --C.TOT_SALDO,
                       C.IMPRIMIR,
                       C.ID_MONEDA,
                       C.NUM_COMPROBANTE_REF,
                       C.IMPRIME_REPORTE,
                       C.COD_USUARIO_AUD,
                       C.MONTO_EN_OP,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_COMPROBANTE_CM,
                       C.ID_EXTRACTO_INICIAL,
                       C.TIP_CAMBIO,
                       C.COD_USUARIO,
                       C.FEC_ORIGEN,
                       C.FEC_CARGA,
                       C.ID_SUCURSAL,
                       nvl(cp.referencia, cm.referencia) AS NRO_REFERENCIA,
                       nvl(cp.nro_despacho, dc.nro_despacho) as NRO_DESPACHO
                  from CPW_CUOTAS C
                  join CMW_PROVEEDORES P on P.ID = C.ID_PROVEEDOR
                  left join cpw_comprobantes_cabecera cp on cp.id = c.id_comprobante
                  left join cmw_compras_cabecera      cm on cm.id = c.id_comprobante_cm
                  left join cmw_despachos_detalle     dd on dd.id = cm.id_embarque
                  left join cmw_despachos_cabecera    dc on dc.id = dd.id_despacho_cab
                  WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                  AND C.TOT_SALDO <> 0
                  AND C.ID_PROVEEDOR = NVL(:P273_PROV_PARAM,0)
                  
                  AND NVL(C.MONTO_EN_OP,0) <> NVL(C.TOT_CUOTA,0) 
                  AND (C.TIP_COMPROBANTE IN ('SAP', 'DIV') AND :P273_PERMISO_CARGA_SALARIOS = 'S' OR C.TIP_COMPROBANTE  NOT IN ('SAP', 'DIV'))
                  AND (P.IND_PERMITIR_VISUALIZAR = 'N' AND :P273_PERMISO_CARGA_SALARIOS = 'S' OR P.IND_PERMITIR_VISUALIZAR = 'S')
                  AND C.ID NOT  IN (SELECT TO_NUMBER (column_value)
                		              FROM XMLTABLE (:P273_ORDEN_SELECCIONADAS))
                ```
            pageItemsToSubmit: [
                P273_ORDEN_SELECCIONADAS
                P273_PROV_PARAM
            ]
        }
