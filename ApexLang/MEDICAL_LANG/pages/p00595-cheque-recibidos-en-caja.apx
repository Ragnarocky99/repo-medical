page 595 (
    name: Cheque recibidos en caja
    alias: CHEQUE-RECIBIDOS-EN-CAJA
    title: Cheque recibidos en caja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cheque-recibidos-en-caja (
        name: Cheque recibidos en caja
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                C.ID,
                C.ID_BANCO,
                C.NUM_VALOR,
                C.FEC_EMISION,
                C.FEC_VENCIMIENTO,
                C.TOT_VALOR,
                C.BENEFICIARIO,
                C.ESTADO,
                C.NRO_CUENTA,
                c.id_empresa,
                s.descripcion subtipo,
                C.OBSERVACION,
                V.ID ID_CAJAS,
                V.FEC_ENTREGA, 
                V.IND_ENTREGADO,
                C.IND_CONCILIADO
                
                from cpw_valores_cajas c, BSW_SUBTIPOS_TRANS S, CPW_CABECERA_CAJAS V
                WHERE C.ID_SUB_TIPO_TRANS = S.ID
                AND C.ID_EMPRESA = S.ID_EMPRESA
                AND C.ID_CAB_CAJAS = V.ID
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

