    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P595_ESTADO
        }
        clientSideCondition {
            type: itemIsNull
            item: P595_ESTADO
        }

        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    begin
                    
                    
                      
                                    update CPW_VALORES_CAJAS C
                                        set  C.ESTADO = 'P'
                                             
                                             where id= :P595_ID;
                                    --where 
                                          
                    
                    EXCEPTION
                    when no_data_found then
                    RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar ');
                    WHEN OTHERS THEN 
                    RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar ');
                    
                    end;
                    ```
                itemsToSubmit: P595_ESTADO
                itemsToReturn: P595_ESTADO
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-4 (
        name: New_3
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P595_FEC_ENTREGA
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                       IF :P595_FEC_ENTREGA < :P595_FEC_EMISION THEN
                        RAISE_APPLICATION_ERROR(-20000, 'La fecha de entrega no puede ser mayor que la fecha de emisión.');
                    END IF;
                    
                    end;
                    ```
                itemsToSubmit: P595_FEC_ENTREGA
                itemsToReturn: P595_FEC_ENTREGA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                
                   IF :P595_FEC_ENTREGA > :P595_FEC_EMISION THEN
                    RAISE_APPLICATION_ERROR(-20000, 'La fecha de entrega no puede ser mayor que la fecha de emisión.');
                END IF;
                --RETURN :P595_FEC_ENTREGA;
                end;
                ```
        }
        error {
            associatedItem: @P595_FEC_ENTREGA
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
