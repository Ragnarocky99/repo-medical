    process initialize-form-cheque-recibidos-en-caja (
        name: Initialize form Cheque recibidos en caja
        type: formInitialization
        formRegion: @cheque-recibidos-en-caja
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13566866806960495
        }
    )

    process process-form-cheque-recibidos-en-caja (
        name: Process form Cheque recibidos en caja
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                  
                                update CPW_CABECERA_CAJAS C
                                    set  C.FEC_ENTREGA    = :P595_FEC_ENTREGA, 
                                         C.IND_ENTREGADO  = :P595_IND_ENTREGADO,
                                         C.ID_CHEQUES_AUD = :P595_ID
                                         
                                         where id= :P595_ID_CAJAS;
                                --where 
                                      
                
                EXCEPTION
                when no_data_found then
                RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar ');
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar ');
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13567241635960495
        }
    )

    process process-from-observacion (
        name: Process from observacion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                
                  
                                update CPW_VALORES_CAJAS V
                                    set V.OBSERVACION = :P595_OBSERVACION,
                                        V.FEC_VENCIMIENTO = :P595_FEC_VENCIMIENTO
                                        where  ID = :P595_ID;
                                        --id= :P595_ID_CAJAS;
                                --where 
                                      
                
                EXCEPTION
                when no_data_found then
                RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar ');
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20999,'ERROR: al insertar ');
                
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14551245402562934
        }
    )

)

