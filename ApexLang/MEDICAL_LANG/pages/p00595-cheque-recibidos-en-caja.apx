        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P595_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: items
            items: P595_IND_ENTREGADO
        }
        clientSideCondition {
            type: item=value
            item: P595_IND_ENTREGADO
            value: S
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P595_FEC_ENTREGA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select sysdate from dual;
                itemsToSubmit: P595_FEC_ENTREGA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P595_FEC_ENTREGA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

