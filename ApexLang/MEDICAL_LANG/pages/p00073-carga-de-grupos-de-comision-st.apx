            formRegion: @carga-de-grupos-de-comision-st
            column: COD_GRUPO_COMISION
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(COD_GRUPO_COMISION)), 0) + 1 FROM STW_GRUPOS_COMISION WHERE ID_EMPRESA=:P0_ID_EMPRESA;
        }
    )

