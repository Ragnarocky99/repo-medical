    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P104_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P104_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction asigna-dueno (
        name: Asigna dueno
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P104_ID_PER_DUENO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT NOMBRE FROM BSW_PERSONAS WHERE ID=:P104_ID_PER_DUENO
                itemsToSubmit: P104_ID_PER_DUENO
            }
            affectedElements {
                selectionType: items
                items: P104_DUENO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction asigna-res-legal (
        name: Asigna Res Legal
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P104_ID_PER_REPRES_LEGAL
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT NOMBRE FROM BSW_PERSONAS WHERE ID=:P104_ID_PER_REPRES_LEGAL
                itemsToSubmit: P104_ID_PER_REPRES_LEGAL
            }
            affectedElements {
                selectionType: items
                items: P104_REPRESENTANTE_LEGAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction asignar-ruc (
        name: Asignar RUC
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P104_ID_PER_CONTADOR
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    V_ID_PERSONA VARCHAR2(10000);
                    
                    BEGIN
                    SELECT RUC INTO  V_ID_PERSONA  FROM BSW_PERSONAS WHERE ID=:P104_ID_PER_CONTADOR; 
                    RETURN V_ID_PERSONA;
                    END;
                    ```
                itemsToSubmit: P104_ID_PER_CONTADOR
            }
            affectedElements {
                selectionType: items
                items: P104_RUC_CONTADOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT NOMBRE FROM BSW_PERSONAS WHERE ID=:P104_ID_PER_CONTADOR
                itemsToSubmit: P104_ID_PER_CONTADOR
            }
            affectedElements {
                selectionType: items
                items: P104_CONTADOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 13531284624259125
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-ejercicios (
        name: Initialize form Carga de Ejercicios
        type: formInitialization
        formRegion: @carga-de-ejercicios
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13530488240259125
        }
    )

    process process-form-carga-de-ejercicios (
        name: Process form Carga de Ejercicios
        type: formAutoRowProcessing
        formRegion: @carga-de-ejercicios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13530823824259125
        }
    )

)

