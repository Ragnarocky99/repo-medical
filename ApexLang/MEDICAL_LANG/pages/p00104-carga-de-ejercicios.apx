page 104 (
    name: Carga de Ejercicios
    alias: CARGA-DE-EJERCICIOS
    title: Carga de Ejercicios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P104_REPRESENTANTE_LEGAL").readOnly = true;
            document.getElementById("P104_CONTADOR").readOnly = true;
            document.getElementById("P104_RUC_CONTADOR").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-ejercicios (
        name: Carga de Ejercicios
        type: form
        source {
            location: localDatabase
            tableName: COW_EJERCICIOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P104_COD_EJERCICIO (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Ejercicio:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-ejercicios
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-ejercicios
            column: COD_EJERCICIO
            dataType: varchar2
        }
    )

    pageItem P104_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 180
            region: @carga-de-ejercicios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-ejercicios
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P104_CONTADOR (
        type: textField
        label {
            label: <p>Contador:</p>
            alignment: left
        }
        layout {
            sequence: 100
            region: @carga-de-ejercicios
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            cssClasses: cambio
        }
        source {
            formRegion: @carga-de-ejercicios
            column: CONTADOR
            dataType: varchar2
        }
    )

    pageItem P104_ESTADO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: A
            uncheckedValue: I
        }
        layout {
            sequence: 160
            region: @carga-de-ejercicios
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-ejercicios
            column: ESTADO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: A
        }
    )

    pageItem P104_FEC_FINAL (
        type: datePicker
        label {
            label: <p>Fecha Final:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 60
            region: @carga-de-ejercicios
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-ejercicios
            column: FEC_FINAL
            dataType: date
        }
    )

    pageItem P104_FEC_INICIO (
        type: datePicker
        label {
            label: <p>Fecha Inicio:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 50
            region: @carga-de-ejercicios
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-ejercicios
            column: FEC_INICIO
            dataType: date
        }
    )

    pageItem P104_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-ejercicios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-ejercicios
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: COW_EJERCICIOS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P104_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
