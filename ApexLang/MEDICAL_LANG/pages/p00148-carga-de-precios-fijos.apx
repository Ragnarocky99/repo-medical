    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-precio-existente (
        name: VALIDA_PRECIO_EXISTENTE
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vBandera  NUMBER(1);
                    vCount    NUMBER(2);
                
                BEGIN 
                    vBandera := 0;
                    vCount   := 0;
                
                    SELECT (SELECT 1
                            FROM VTW_PRECIOS_FIJOS A
                            WHERE A.ID_ARTICULO  = :P148_ID_ARTICULO
                              AND A.ID_PRECIO    = :P148_ID_PRECIO
                              AND TO_DATE(A.FEC_VIGENCIA, 'DD/MM/YYYY') = TO_DATE(:P148_FEC_VIGENCIA, 'DD/MM/YYYY')
                              AND A.ACTIVO = 'S')
                        INTO vBandera
                    FROM DUAL;
                
                    SELECT (SELECT COUNT(*)
                            FROM VTW_PRECIOS_FIJOS A
                            WHERE A.ID_ARTICULO  = :P148_ID_ARTICULO
                              AND A.ID_PRECIO    = :P148_ID_PRECIO
                              AND TO_DATE(A.FEC_VIGENCIA, 'DD/MM/YYYY') = TO_DATE(:P148_FEC_VIGENCIA, 'DD/MM/YYYY')
                              AND A.ACTIVO = 'S')
                        INTO vCount
                    FROM DUAL;
                
                    IF vBandera = 1  THEN
                        RETURN 'Ya existe ' || vCount || ' precio fijo para este artículo con misma fecha de vigencia';
                    ELSE IF vBandera = 0 THEN
                            RETURN NULL;
                         END IF;
                    END IF;
                END;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
