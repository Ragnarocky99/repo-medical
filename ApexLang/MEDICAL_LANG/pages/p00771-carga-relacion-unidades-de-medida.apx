    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @carga-relacion-unidades-de-medida
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 769
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Guardar
        layout {
            sequence: 40
            region: @carga-relacion-unidades-de-medida
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
