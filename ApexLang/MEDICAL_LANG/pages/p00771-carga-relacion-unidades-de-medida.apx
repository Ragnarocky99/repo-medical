        }
        serverSideCondition {
            type: itemIsNotNull
            item: P771_ID
        }
    )

    dynamicAction inicializar-fila (
        name: Inicializar Fila
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @detalles
        }

        action por-defecto (
            name: POR_DEFECTO
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: columns
                columns: POR_DEFECTO
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: POR_DEFECTO
            }
        )

    )

    computation p771-cod-relacion-um (
        itemName: P771_COD_RELACION_UM
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_RELACION_UM)), 0) + 1
                  FROM STW_RELACIONES_CAB
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P771_ID
        }
    )

    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
