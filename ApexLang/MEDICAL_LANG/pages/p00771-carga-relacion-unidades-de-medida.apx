            sequence: 40
            region: @carga-relacion-unidades-de-medida
            slot: regionBody
        }
        source {
            formRegion: @carga-relacion-unidades-de-medida
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P771_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-relacion-unidades-de-medida
            slot: regionBody
        }
        source {
