        }
    )

    process unir-cabecera-detalle (
        name: Unir Cabecera Detalle
        type: executeCode
        editableRegion: @detalles
        source {
            plsqlCode: :ID_UNIDAD_REL := :P771_ID;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 34459043781288842
        }
    )

)

