page 771 (
    name: Carga Relacion Unidades de Medida
    alias: CARGA-RELACION-UNIDADES-DE-MEDIDA
    title: Carga Relacion Unidades de Medida
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region carga-relacion-unidades-de-medida (
        name: Carga Relacion Unidades de Medida
        type: form
        source {
            location: localDatabase
            tableName: STW_RELACIONES_CAB
        }
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: STW_RELACIONES_DET
            whereClause: ID_UNIDAD_REL = :P771_ID
            pageItemsToSubmit: P771_ID
        }
        layout {
            sequence: 10
            parentRegion: @carga-relacion-unidades-de-medida
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-lg
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 34458091215288832
        }

        savedReport 345272 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_RELACION_UM
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_UNIDAD_REL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @MUL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @DIVISOR
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @POR_DEFECTO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DIVISOR (
            type: numberField
            heading {
                heading: <p>Divisor</p>
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: DIVISOR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_RELACION_UM (
            type: popupLov
            heading {
                heading: <p>Unidad Medida</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-unidades-medida
                displayNullValue: false
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_RELACION_UM
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_UNIDAD_REL (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_UNIDAD_REL
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MUL (
            type: numberField
            heading {
                heading: <p>Multiplicador</p>
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: MUL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column POR_DEFECTO (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: POR_DEFECTO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detalles
        }
    )

    pageItem P771_ACTIVO (
