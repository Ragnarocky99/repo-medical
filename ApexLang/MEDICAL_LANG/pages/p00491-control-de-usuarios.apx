    region usuarios (
        name: Usuarios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_USUARIO,
                       ID_PERSONA,
                       CLAVE,
                       ID_GRUPO,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ESTADO,
                       ID_AREA,
                       SUCURSAL_NCR,
                       ID_SECTOR_VEN,
                       IND_VERIFICA_MENU,
                       PUEDE_FACTURAR,
                       SUCURSAL_DEB,
                       ID_VENDEDOR,
                       E_MAIL,
                       COD_USUARIO_AUD,
                       TIPO_MENU,
                       TIPO_PERFIL,
                       COLOR_MENU,
                       TEMA_MENU,
                       DASHBOARD,
                       ID_CUSTODIO,
                       AUTORIZA_STOCK,
                       AUTORIZA_CTACTE,
                       DARK_MENU,
                       TIPO_DASHBOARD,
                       IND_ANALIZA_CREDITOS,
                       IND_REFERENCISTA,
                       IND_CAJERO,
                       MONTO_APROBACION,
                       TELEFONO,
                       USA_APP,
                       CARGO,
                       ID_GRUPO AS ID_GRUPO_2
                  from BSW_USUARIOS
                  WHERE ID_EMPRESA=:P0_ID_EMPRESA
                  
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
