    process quitar-permisos (
        name: Quitar Permisos
        type: executeCode
        editableRegion: @control-de-accesos
        source {
            plsqlCode:
                ```plsql
                --Script que se ejecuta para quitar los permisos de un modulo a un grupo de usuario 
                
                DECLARE 
                	li_contador_formularios       INTEGER	:= 0;
                    li_contador_general      INTEGER	:= 0;
                    li_contador_modulo       INTEGER	:= 0;
                    vParent_ID_TIPO varchar2(100);
                    vParent_ID_MODULO varchar2(100);
                BEGIN
                IF :APEX$ROW_STATUS='D' THEN
                IF:PAGINA_ID!=1 THEN 
                --Busca el id de la entrada de menu del tipo de formulario
                SELECT PARENT_ID
                into vParent_ID_TIPO 
                from BSW_FORMAS_PAGINAS WHERE
                NAV_ID=:PAGINA_ID; 
                
                --Busca el id de la entrada de menu del modulo 
                SELECT PARENT_ID 
                into vParent_ID_MODULO
                FROM BSW_FORMAS_PAGINAS 
                WHERE NAV_ID=vParent_ID_TIPO;
                
                
                --Valida si aun tiene permisos a otros formularios 
                SELECT COUNT(1)
                INTO li_contador_formularios
                FROM (BSW_ACCESO_POR_GRUPOS_APEX A),(BSW_FORMAS_PAGINAS C)
                WHERE  C.NAV_ID=A.PAGINA_ID  AND
                A.ID_GRUPO=:ID_GRUPO  AND C.PARENT_ID=vParent_ID_TIPO ;
                
                
                
                -- Revisa los accesos totales al modulo
                SELECT COUNT(1)
                INTO li_contador_general
                FROM BSW_ACCESO_POR_GRUPOS_APEX WHERE
                ID_GRUPO=:ID_GRUPO AND ID_MODULO=:ID_MODULO;
                
                --Revisa si tiene acceso al modulo 
                SELECT COUNT(1)
                INTO li_contador_modulo
                FROM  BSW_ACCESO_POR_GRUPOS_APEX  WHERE
                PAGINA_ID=vParent_ID_MODULO AND nvl(ID_GRUPO,0)=:ID_GRUPO; 
                
                
                -- Solo se ejecuta cuando el grupo de usuario ya no tiene permisos a un modulo
                 if li_contador_modulo=1 and li_contador_formularios=1 AND li_contador_general=3
                then 
                
                --Borra el acceso al tipo de formulario
                DELETE FROM BSW_ACCESO_POR_GRUPOS_APEX WHERE
                :ID_GRUPO=nvl(ID_GRUPO,0) AND PAGINA_ID=vParent_ID_TIPO;
                --Borra el acceso al modulo
                DELETE FROM BSW_ACCESO_POR_GRUPOS_APEX WHERE 
                :ID_GRUPO=nvl(ID_GRUPO,0) AND PAGINA_ID=vParent_ID_MODULO;
                
                
                --Elimina el acceso a un tipo de formulario cuando ya no quedan accesos 
                elsif li_contador_formularios=1  and li_contador_modulo=1
                then
                DELETE FROM BSW_ACCESO_POR_GRUPOS_APEX WHERE
                :ID_GRUPO=nvl(ID_GRUPO,0) AND PAGINA_ID=vParent_ID_TIPO;
                
                
                
                COMMIT;
                ELSE
                NULL;
                END IF;
                ELSE 
                NULL;
                  END IF;
                END IF;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                raise_application_error(-20999,'Error de aplicacion'||sqlerrm);
                
                --Funcion de debug para ver si se cargan bien los datos
                APEX_DEBUG.ENABLE(apex_debug.c_log_level_info);
                   apex_debug.message(p_message => 'Los valores son'||vParent_ID_TIPO||vParent_ID_MODULO);
                END;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 60251950912847622
        }
    )

