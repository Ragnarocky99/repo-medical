page 491 (
    name: Control de Usuarios
    alias: CONTROL-DE-USUARIOS
    title: Control de Usuarios
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            .fact{
                font-weight: bold;
                font-size: large;
                   color: #5c5c5c;
              background-color: #f0f0f0;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #526fac;
            }
            
            
            .a-danger{
                background-color: #f44336;
            }
            
            .totales{
                text-align: center;
                font-size: medium;
            }
            h3{
                font-weight: bold;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region control-de-accesos (
        name: Control de Accesos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ID_ACCESO,
                       A.ID_GRUPO,
                       A.PAGINA_ID,
                       A.PERMISO,
                       A.PUEDE_INSERTAR,
                       A.PUEDE_ACTUALIZAR,
                       A.PUEDE_BORRAR,
                       A.PUEDE_CONSULTAR,
                       A.ID_MODULO
                  from BSW_ACCESO_POR_GRUPOS_APEX A,BSW_FORMAS_PAGINAS F WHERE
                   A.PAGINA_ID=F.NAV_ID AND F.PAGE_NO IS NOT NULL
                ```
        }
        layout {
            sequence: 20
            parentRegion: @usuarios
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @usuarios
        }
        headerAndFooter {
            headerText: <h3>Control de Accesos</h3>
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 60042789342450838
        }

