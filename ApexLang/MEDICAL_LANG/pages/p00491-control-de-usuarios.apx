    process control-de-accesos-save-interactive-grid-data (
        name: Control de Accesos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @control-de-accesos
        target {
            targetType: tableView
            tableName: BSW_ACCESO_POR_GRUPOS_APEX
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 60251741042847620
        }
    )

    process crear-permisos (
        name: Crear Permisos
        type: executeCode
        editableRegion: @control-de-accesos
        source {
            plsqlCode:
                ```plsql
                --Se hace un script para agregar los permisos para el modulo y tipo de pagina  correspondiente
                
                DECLARE 
                	li_count_1       INTEGER	:= 0;
                    li_count_2       INTEGER	:= 0;
                    li_count_3       INTEGER	:= 0;
                    vParent_ID_TIPO varchar2(100);
                    vParent_ID_MODULO varchar2(100);
                BEGIN
                IF :APEX$ROW_STATUS='C' OR  :APEX$ROW_STATUS='U' THEN
                
                IF :PAGINA_ID!=1 THEN
                
                
                --Carga el id del tipo de pagina
                SELECT PARENT_ID
                into vParent_ID_TIPO 
                from BSW_FORMAS_PAGINAS WHERE
                NAV_ID=:PAGINA_ID; 
                
                --Carga el id del modulo de la pagina 
                SELECT PARENT_ID 
                into vParent_ID_MODULO
                FROM BSW_FORMAS_PAGINAS 
                WHERE NAV_ID=vParent_ID_TIPO;
                
                
                
                
                
                -- Se Revisa si ya tiene permiso en el tipo de pagina
                SELECT COUNT(1)
                INTO li_count_2
                FROM BSW_ACCESO_POR_GRUPOS_APEX  WHERE
                PAGINA_ID=vParent_ID_TIPO AND :ID_GRUPO=nvl(ID_GRUPO,0);
                
                --Se revisa si ya tiene permiso en el modulo 
                SELECT COUNT(1)
                INTO li_count_3
                FROM  BSW_ACCESO_POR_GRUPOS_APEX  WHERE
                PAGINA_ID=vParent_ID_MODULO AND :ID_GRUPO=nvl(ID_GRUPO,0); 
                
                
                -- Si no tiene permisos entonces se crean los permisos 
                 if li_count_2=0 and li_count_3=0
                then 
                --Se crea el permiso para el tipo de formulario 
                INSERT INTO BSW_ACCESO_POR_GRUPOS_APEX (ID_ACCESO,ID_GRUPO,PAGINA_ID,PERMISO,ID_MODULO) VALUES
                (NULL,:ID_GRUPO,vParent_ID_MODULO,1,:ID_MODULO);
                
                --Se crea el permiso para el modulo 
                INSERT INTO BSW_ACCESO_POR_GRUPOS_APEX (ID_ACCESO,ID_GRUPO,PAGINA_ID,PERMISO,ID_MODULO) VALUES
                (NULL,:ID_GRUPO,vParent_ID_TIPO,1,:ID_MODULO);
                
                --Si ya tiene permiso para el modulo entonces solo da permiso para el tipo de formulario
                ELSIF li_count_2=0
                THEN
                INSERT INTO BSW_ACCESO_POR_GRUPOS_APEX (ID_ACCESO,ID_GRUPO,PAGINA_ID,PERMISO,ID_MODULO) VALUES
                (NULL,:ID_GRUPO,vParent_ID_TIPO,1,:ID_MODULO);
                END IF;
                ELSE 
                NULL;
                  END IF;
                END IF;
                
                
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                raise_application_error(-20999,'Error de aplicacion'||sqlerrm);
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 60251851762847621
        }
    )

