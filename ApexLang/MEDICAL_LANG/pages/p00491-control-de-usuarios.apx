            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID_ACCESO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_GRUPO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_GRUPO
                dataType: number
            }
            masterDetail {
                masterColumn: @ID_GRUPO_2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_MODULO (
            type: popupLov
            heading {
                heading: <p>Modulo</p>
                alignment: center
                alternativeLabel: Modulo
            }
            lov {
                type: sharedComponent
                lov: @lv-modulos
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: ID_MODULO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column PAGINA_ID (
            type: popupLov
            heading {
                heading: <p>Pagina</p>
                alignment: center
                alternativeLabel: Pagina
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT F.NAV_NAME||'('||F.PAGE_no||')',F.NAV_ID FROM BSW_FORMAS_PAGINAS F WHERE PAGE_NO IS NOT NULL
                    AND ID_MODULO=:ID_MODULO OR NAV_ID=1
                    ```
            }
            cascadingLov {
                parentColumns: ID_MODULO
                itemsToSubmit: ID_MODULO
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: PAGINA_ID
                dataType: number
            }
        )

