    region extracto-del-cliente-del-loteamiento (
        name: Extracto del Cliente del Loteamiento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.NRO_COMPROBANTE, 
                       C.ID_FRACCION, 
                       C.ID_MANZANA, 
                       C.ID_LOTE,
                       CL.ID_CLIENTE, 
                       P.NOMBRE, 
                       --CCL.nombre,
                       CUO.NRO_CUOTA, 
                       CUO.FEC_VENCIMIENTO,
                       nvl((select kd.monto_total_c_iva 
                            from VTW_COMPROBANTES_DETALLE kd, VTW_COMPROBANTES_CABECERA kc --, LTW_CUOTAS CUO
                            where KD.ID_EMPRESA         = CUO.ID_EMPRESA
                            AND   KD.ID_COMPROBANTE_CABECERA = KC.ID
                            and   kd.id_cuota_lote = cuo.id
                        ),
                        cuo.tot_cuota +NVL( CUO.TOT_IVA,0)) TOT_CUOTA ,
                        CUO.TOT_SALDO,
                      TO_NUMBER(
                       lt_retorna_datos_interes(p_cod_empresa     => CUO.ID_EMPRESA,
                                               --p_tip_comprobante => CUO.tipO_comprobante,
                                               --p_ser_comprobante => CUO.ser_comprobante,
                                               --p_nro_comprobante => CUO.nro_comprobante,
                                               p_nro_cuota       => CUO.nro_cuota)) INTERES_COBRADO,
                       NVL( lt_retorna_datos_cobro(p_id_empresa     => CUO.ID_EMPRESA,
                                               p_id_contrato        => CUO.ID_CONTRATO,
                                               --p_tip_comprobante => CUO.tipO_comprobante,
                                               --p_ser_comprobante => CUO.ser_comprobante,
                                               --p_nro_comprobante => CUO.nro_comprobante,
                                               p_id_cuota       => CUO.ID), 
                     TO_CHAR(cuo.fec_cobro,'DD/MM/YYYY') ) DATOS_COBRO, 
                     c.fec_comprobante,
                     lt_retorna_fco_interes(p_id_empresa     => CUO.ID_EMPRESA,
                                            p_id_contrato        => CUO.ID_CONTRATO,
                                            --p_tip_comprobante => CUO.tipO_comprobante,
                                            --p_ser_comprobante => CUO.ser_comprobante,
                                            --p_nro_comprobante => CUO.nro_comprobante,
                                            p_id_cuota       => CUO.ID) datos_INTERES_COBRADO
                                            
                FROM   LTW_CONTRATOS          C,
                       LTW_CLIENTES_CONTRATOS CL,
                       LTW_CUOTAS             CUO,
                       CCW_CLIENTES           CCL, 
                       BSW_PERSONAS           P, 
                       BSW_EMPRESAS           E
                       
                WHERE E.ID = C.ID_EMPRESA 
                  AND CL.ID_CONTRATO    = C.ID
                
                  AND CL.ID_CLIENTE     = CCL.ID
                  AND CCL.ID_PERSONA    = P.ID
                  AND CL.IND_DEFECTO    = 'S'
                  AND CUO.ID_CONTRATO   = C.ID
                  AND C.ID_EMPRESA         = :P0_ID_EMPRESA
                  AND (C.TIP_COMPROBANTE    = :P579_TIP_COMPROBANTE OR :P579_TIP_COMPROBANTE IS NULL)
                  AND (C.SER_COMPROBANTE    = :P579_SER_COMPROBANTE OR :P579_SER_COMPROBANTE IS NULL)
                  AND (C.NRO_COMPROBANTE    = :P579_NRO_COMPROBANTE OR :P579_NRO_COMPROBANTE IS NULL)
                  AND (C.ID_FRACCION       = :P579_FRACCION    OR :P579_FRACCION    IS NULL)
                  AND (C.ID_MANZANA        = :P579_MANZANA     OR :P579_MANZANA     IS NULL)
                  AND (C.ID_LOTE           = :P579_LOTE        OR :P579_LOTE        IS NULL)
                  AND (CL.ID_CLIENTE       = :P579_CLIENTE     OR :P579_CLIENTE     IS NULL)
                  AND (C.FEC_COMPROBANTE  BETWEEN :P579_FEC_INICIAL AND :P579_FEC_FINAL)
                order by c.nro_comprobante, cuo.nro_cuota
                ```
            pageItemsToSubmit: [
                P579_FEC_INICIAL
                P579_FEC_FINAL
                P579_TIP_COMPROBANTE
                P579_SER_COMPROBANTE
                P579_NRO_COMPROBANTE
                P579_FRACCION
                P579_MANZANA
                P579_LOTE
                P579_CLIENTE
            ]
        }
        layout {
            sequence: 20
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 8696985282853795
        }

