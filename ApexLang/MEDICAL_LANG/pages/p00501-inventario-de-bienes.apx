page 501 (
    name: Inventario de Bienes
    alias: INVENTARIO-DE-BIENES
    title: Inventario de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region inventario-de-bienes (
        name: Inventario de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT COD_BIEN, 
                       DESCRIPCION, 
                       CANTIDAD, 
                       ID_TIPO_BIEN, 
                       MON_COSTO, 
                       MON_COSTO_EXT, 
                       FEC_COMPRA, 
                       REFERENCIA, 
                       NVL(ESTADO, 'N') ESTADO,
                       CASE ESTADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       REF_COD_BIEN,
                       ID 
                       FROM COW_BIENES_USO
                       WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 486
                items: {
                    P486_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 63147117802224476
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: <p>Cantidad</p>
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_BIEN (
            type: plainText
            heading {
                heading: <p>Cod. Bien</p>
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: <p>Descripción</p>
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 39
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ESTADO_ICON (
            type: hidden
            heading {
                heading: Estado Icon
            }
            layout {
                sequence: 29
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column FEC_COMPRA (
            type: plainText
            heading {
                heading: <p>Fec. de Compra</p>
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 9
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_TIPO_BIEN (
            type: plainText
            heading {
                heading: <p>Tipo Bien</p>
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column MON_COSTO (
            type: plainText
            heading {
                heading: <p>Costo Nacional</p>
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column MON_COSTO_EXT (
            type: plainText
            heading {
                heading: <p>Costo Extranjero</p>
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column REFERENCIA (
            type: plainText
            heading {
                heading: <p>Referencia</p>
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column REF_COD_BIEN (
            type: plainText
            heading {
                heading: <p>Ref. Cod. Bien</p>
                alignment: center
            }
            layout {
                sequence: 49
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Inventario de Bienes
        }

        savedReport 631543 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 3
            )

            displayColumn COD_BIEN (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn ESTADO (
                sequence: 9
            )

            displayColumn FEC_COMPRA (
                sequence: 7
            )

            displayColumn ID_TIPO_BIEN (
                sequence: 4
            )

            displayColumn MON_COSTO (
                sequence: 5
            )

            displayColumn MON_COSTO_EXT (
                sequence: 6
            )

            displayColumn REF_COD_BIEN (
                sequence: 8
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @inventario-de-bienes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 486
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction editar-informe-cuadro-de-diálogo-cerrado (
        name: "Editar Informe: Cuadro de Diálogo Cerrado "
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @inventario-de-bienes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @inventario-de-bienes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

