page 325 (
    name: Carga Motivos de Estado
    alias: CARGA-MOTIVOS-DE-ESTADO
    title: Carga Motivos de Estado
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P325_COD_MOTIVO").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-motivo-de-estado (
        name: Carga Motivo de Estado
        type: form
        source {
            location: localDatabase
            tableName: RHW_MOTIVOS
            whereClause: id_empresa = :P0_ID_EMPRESA
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P325_COD_MOTIVO (
        type: textField
        label {
            label: <P>Código: &ensp;</P>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-motivo-de-estado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 5
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: COD_MOTIVO
            dataType: varchar2
        }
    )

    pageItem P325_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 70
            region: @carga-motivo-de-estado
            slot: regionBody
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P325_COMPENSAR (
        type: hidden
        layout {
            sequence: 100
            region: @carga-motivo-de-estado
            slot: regionBody
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: COMPENSAR
            dataType: varchar2
        }
    )

    pageItem P325_DEDUCIR (
        type: checkbox
        label {
            label: <p>Descontar</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 60
            region: @carga-motivo-de-estado
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 8
            columnSpan: 5
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                margin-left-md
            ]
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: DEDUCIR
            dataType: varchar2
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P325_DESCRIPCION (
        type: textField
        label {
            label: <P>Descripción: &ensp;</P>
            alignment: left
        }
        settings {
            textCase: upper
        }
        layout {
            sequence: 40
            region: @carga-motivo-de-estado
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 65
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P325_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-motivo-de-estado
            slot: regionBody
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P325_ID_CONCEPTO (
        type: popupLov
        label {
            label: <p>Concepto: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @rhw-conceptos
            nullDisplayValue: --Sin Seleccionar--
        }
        layout {
            sequence: 50
            region: @carga-motivo-de-estado
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: ID_CONCEPTO
            dataType: number
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P325_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-motivo-de-estado
            slot: regionBody
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: P0_COD_EMPRESA
        }
    )

    pageItem P325_TODO_EXTRAS (
        type: hidden
        layout {
            sequence: 90
            region: @carga-motivo-de-estado
            slot: regionBody
        }
        source {
            formRegion: @carga-motivo-de-estado
            column: TODO_EXTRAS
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P325_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P325_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P325_ID
        }
        security {
            authorizationScheme: @derechos-actualizar
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p325-cod-motivo (
        itemName: P325_COD_MOTIVO
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery: select nvl(max(cod_motivo), 0)+1 from RHW_MOTIVOS WHERE ID_EMPRESA = :P0_ID_EMPRESA
        }
        serverSideCondition {
            type: itemIsNull
            item: P325_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12087879369446142
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-motivos-de-estado (
        name: Initialize form Carga Motivos de Estado
        type: formInitialization
        formRegion: @carga-motivo-de-estado
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12085786979446121
        }
    )

    process process-form-carga-de-motivos-de-estado (
        name: Process form Carga de motivos de estado
        type: formAutoRowProcessing
        formRegion: @carga-motivo-de-estado
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12087786092446141
        }
    )

)

