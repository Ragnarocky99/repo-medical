    pageItem P691_COD_EJERCICIO (
        type: popupLov
        label {
            label: <p>Ejercicio:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT TO_NUMBER(COD_EJERCICIO) D, TO_NUMBER(COD_EJERCICIO) R
                  FROM COW_EJERCICIOS
                ORDER BY TO_NUMBER(COD_EJERCICIO) DESC
                ```
        }
        layout {
            sequence: 10
            region: @filtros
