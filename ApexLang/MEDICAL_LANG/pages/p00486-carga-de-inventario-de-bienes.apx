    region imagenes-grilla (
        name: Imagenes Grilla
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT "ID",
                       "FILENAME",
                       "MIMETYPE",
                          /*'<Img src="/i/IMAGENES_APEX/'
                       || ID_LOCAL||'-'||ID
                       || '.jpg" alt="Smiley face" height="40" width="40">'
                          AS img,*/
                          descripcion,
                          ID_BIEN||'-'||ID  AS IMAGE,
                          ID_EMPRESA,
                          ID_BIEN
                  FROM COW_IMG_BIENES_USO
                  WHERE ID_BIEN=:P486_ID
                ```
            pageItemsToSubmit: P486_ID
        }
        layout {
            sequence: 10
            parentRegion: @imagenes
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
                margin-left-lg
                margin-right-lg
            ]
        }
        advanced {
            htmlDomId: IMG
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 88843481381312322
        }

        savedReport 899529 (
