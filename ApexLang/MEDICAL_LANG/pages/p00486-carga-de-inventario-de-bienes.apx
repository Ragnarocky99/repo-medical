    pageItem P486_NETO_FISCAL (
        type: textField
        label {
            label: <p>Neto Fiscal:</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @valores-de-procesos-anuales
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT R.MON_NETO 
                FROM COW_REVALUO R, COW_BIENES_USO B 
                WHERE B.ID = R.ID_BIEN AND B.ID = :P486_ID
                
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P486_ID
        }
        readOnly {
            type: itemIsNotNull
            item: P486_ID
        }
    )

