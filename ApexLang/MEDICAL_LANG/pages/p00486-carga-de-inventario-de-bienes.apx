page 486 (
    name: Carga de Inventario de Bienes
    alias: CARGA-DE-INVENTARIO-DE-BIENES
    title: Carga de Inventario de Bienes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 214px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: left;
                border-width: thin;
                border-color: #afa9a9;
            }
            canvas#image-preview{  
            text-align: center;  
            margin-left: 100px;  
            margin-top: 30px;  
            border: 1px solid black; 
             width: 240px !important;
            }
            
            td[headers="Mostrar"] img {   width: 74px; } 
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bien (
        name: Bien
        type: staticContent
        layout {
            sequence: 280
            parentRegion: @carga-de-inventario-de-bienes
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
