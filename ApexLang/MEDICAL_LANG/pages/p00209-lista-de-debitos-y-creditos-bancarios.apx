    region lista-de-debitos-y-creditos-bancarios (
        name: Lista de Debitos y Creditos Bancarios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.REFERENCIA,
                       C.FEC_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.ID_PER_JURIDICA,
                       C.ID_CUENTA,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ID_TIPO_TRANS,
                       C.ID_SUB_TIPO_TRANS,
                       C.CONCEPTO,
                       C.IMPORTE,
                       C.ASIENTOS,
                       C.IND_IMPORTACION,
                       C.ID_PROVEEDOR,
                       C.ID_CENTRO_COSTO,
                       C.REF_COMPROBANTE,
                       CASE C.IND_CONCILIADO
                         WHEN 'S' THEN 'CONCILIADO'
                         ELSE 'PENDIENTE'
                       END AS ESTADO_CONCILIACION,
                        
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'deb'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTO_ID
                  from CCW_DEBCRED_BANCARIOS C
                  where ID_EMPRESA = :P0_COD_EMPRESA
                  --AND ID_SUCURSAL = :P0_COD_SUCURSAL
                  AND TIP_COMPROBANTE != 'TRB'
                
                 ORDER BY C.FEC_COMPROBANTE DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
