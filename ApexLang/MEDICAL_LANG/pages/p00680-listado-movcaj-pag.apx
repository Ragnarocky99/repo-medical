    pageItem P680FEC_DESDE (
        type: datePicker
        label {
            label: <p>Fecha Desde: </p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @listado
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT '01/01/'||to_char(sysdate,'YYYY') from dual
        }
    )

    pageItem P680_FEC_HASTA (
        type: datePicker
        label {
            label: <p>Fecha Hasta: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @listado
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(trunc(sysdate)) from dual
        }
    )

    button ejecutar (
        buttonName: Ejecutar
