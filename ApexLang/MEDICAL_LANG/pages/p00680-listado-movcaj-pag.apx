page 680 (
    name: Listado Movimientos de Caja Pag
    alias: LISTADO-MOVCAJ-PAG
    title: Listado Movimientos de Caja Pag
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            .anulado {
                color: red;
            }
            .presupuestado {
            color: orangered;
            }
            .cotizado{
                color: green;
            }
            .confirmado {
                color: #3f46bb;
            }
            .EnDeposito{
                color: brown;
            }
            .EntregadoCliente{
                color: aqua;
            }
            .OrdenCompra{
                color: yellowgreen;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region listado (
        name: Listado
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region listado-movcaj-pag (
        name: listado_movcaj_pag
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_EMPRESA,
                       C.ID_SUCURSAL,
                       C.TIP_MOV_CAJ,
                       C.SER_MOV_CAJ,
                       C.NRO_MOV_CAJ,
                       C.FEC_MOV_CAJ,
                       C.TOT_NRO_MOV_CAJ,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ID_PROVEEDOR,
                       C.ID_ORDEN_PAGO,
                       V.ID_BANCO,
                       V.NUM_VALOR,
                       V.FEC_EMISION,
                       V.FEC_VENCIMIENTO,
                       V.ID_SUB_TIPO_TRANS
                  FROM CPW_CABECERA_CAJAS C,
                       CPW_DETALLE_CAJAS  D,
                       CPW_VALORES_CAJAS  V
                 WHERE C.ID_EMPRESA = D.ID_EMPRESA
                   AND C.ID = D.ID_MOV_CAJ_CPW
                   AND C.ID_EMPRESA = V.ID_EMPRESA
                   AND C.ID = V.ID_CAB_CAJAS
                   AND (C.FEC_MOV_CAJ BETWEEN :P680FEC_DESDE AND :P680_FEC_HASTA)
                ```
            pageItemsToSubmit: [
                P680FEC_DESDE
                P680_FEC_HASTA
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 60846259539348828
        }

        savedReport 608467 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
