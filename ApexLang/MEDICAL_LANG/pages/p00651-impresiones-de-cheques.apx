    dynamicAction impresion (
        name: Impresion
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @imprimir
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 654
                }
                options: [
                    submitPageItemsBeforeRedirect
                    executePlSqlBeforeRedirect
                ]
                executePlSql:
                    ```plsql
                    APEX_UTIL.SET_SESSION_STATE('P654_TIP_VALOR',:P651_TIP_VALOR);
                    APEX_UTIL.SET_SESSION_sTATE('P654_SER_VALOR',:P651_SER_VALOR);
                    APEX_UTIL.SET_SESSION_sTATE('P654_ID_CUENTA',:P651_ID_CUENTA);
                    APEX_UTIL.SET_SESSION_sTATE('P654_NRO_INI',:P651_NRO_INICIAL);
                    APEX_UTIL.SET_SESSION_STATE('P654_NRO_FIN',:P651_NRO_FINAL);
                    APEX_UTIL.SET_SESSION_sTATE('P654_FECHA_INI',:P651_FEC_DESDE);
                    APEX_UTIL.SET_SESSION_sTATE('P654_FECHA_FIN',:P651_FEC_HASTA);
                    APEX_UTIL.SET_SESSION_sTATE('P654_ES_DIFERIDO',:P651_TIPO_IMPRESION);
                    ```
                pageItemsToSubmit: [
                    P651_ID_CUENTA
                    P651_FEC_DESDE
                    P651_FEC_HASTA
                    P651_TIP_VALOR
                    P651_SER_VALOR
                    P651_NRO_INICIAL
                    P651_NRO_FINAL
                    P651_TIPO_IMPRESION
                ]
                openTargetInNewWindow: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @buscar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalle
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction traer-nro-inicial-y-final (
        name: Traer Nro Inicial y Final
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P651_SER_VALOR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P651_SER_VALOR IS NOT NULL THEN
                    	BEGIN
                    		SELECT MIN(NUM_VALOR)
                    		  INTO :P651_NRO_INICIAL
                    		FROM CPW_VALORES_CAJAS
                    		WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    		  AND ID_SUB_TIPO_TRANS = :P651_TIP_VALOR
                    		  AND SER_VALOR = :P651_SER_VALOR
                    		  AND ID_CUENTA = :P651_ID_CUENTA
                    		  AND FEC_EMISION BETWEEN TO_DATE(:P651_FEC_DESDE,'DD/MM/YYYY') AND TO_DATE(:P651_FEC_HASTA,'DD/MM/YYYY');
                    	EXCEPTION
                    		WHEN NO_DATA_FOUND THEN
                    		  RAISE_APPLICATION_ERROR(-20000,'No se encuentra valores con estos parametros');
                    		  --raise form_trigger_failure;
                    		WHEN OTHERS THEN
                    		  RAISE_APPLICATION_ERROR(-20000,'Error al buscar los nro a imprimir '||sqlerrm);
                    		  --raise form_trigger_failure;
                    	END;
                    	BEGIN
                    		SELECT MAX(NUM_VALOR)
                    		  INTO :P651_NRO_FINAL
                    		FROM CPW_VALORES_CAJAS
                    		WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    		  AND ID_SUB_TIPO_TRANS = :P651_TIP_VALOR
                    		  AND SER_VALOR = :P651_SER_VALOR
                    		  AND ID_CUENTA = :P651_ID_CUENTA
                    		  AND FEC_EMISION BETWEEN TO_DATE(:P651_FEC_DESDE,'DD/MM/YYYY') AND TO_DATE(:P651_FEC_HASTA,'DD/MM/YYYY');
                    	EXCEPTION
                    		WHEN NO_DATA_FOUND THEN
                    		  RAISE_APPLICATION_ERROR(-20000,'No se encuentra valores con estos parametros');
                    		  --raise form_trigger_failure;
                    		WHEN OTHERS THEN
                    		  RAISE_APPLICATION_ERROR(-20000,'Error al buscar los nro a imprimir '||sqlerrm);
                    		  --raise form_trigger_failure;
                    	END;
                    end if;
                    ```
                itemsToSubmit: [
                    P651_SER_VALOR
                    P651_TIP_VALOR
                    P651_ID_CUENTA
                    P651_FEC_DESDE
                    P651_FEC_HASTA
                ]
                itemsToReturn: [
                    P651_NRO_INICIAL
                    P651_NRO_FINAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

