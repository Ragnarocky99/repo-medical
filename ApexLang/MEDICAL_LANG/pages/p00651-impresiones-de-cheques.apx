    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
              const input = document.getElementById('P651_FEC_DESDE');
              const input2 = document.getElementById('P651_FEC_HASTA');
            
              input.addEventListener('change', function() {
                formatDate(this);
              });
            
              function formatDate(input) {
                let val = input.value.replace(/\D/g, '');
                if (val.length > 2) {
                  val = val.substring(0, 2) + '/' + val.substring(2);
                }
                if (val.length > 5) {
                  val = val.substring(0, 5) + '/' + val.substring(5, 9);
                }
                input.value = val;
              }
              
              input2.addEventListener('change', function() {
                formatDate(this);
              });
            
              function formatDate(input) {
                let val = input.value.replace(/\D/g, '');
                if (val.length > 2) {
                  val = val.substring(0, 2) + '/' + val.substring(2);
                }
                if (val.length > 5) {
                  val = val.substring(0, 5) + '/' + val.substring(5, 9);
                }
                input.value = val;
              }
            ```
    }
