    region detalle (
        name: Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT T.SUBTIPO_TRANS,O.SER_VALOR,O.NUM_VALOR,O.FEC_EMISION,O.BENEFICIARIO,O.TOT_VALOR
                FROM CPW_VALORES_cAJAS o 
                JOIN BSW_SUBTIPOs_TRANS T ON O.ID_SUB_TIPO_TRANS = T.ID
                where o.ID_empresa     = :P0_ID_empresa --P_ID_EMPRESA
                and o.id_sub_tipo_trans     = :P651_TIP_VALOR --P_ID_SUB_TIPO_TRANS
                and o.ser_valor     = :P651_SER_VALOR  --P_SER_VALOR
                and o.id_cuenta  = :P651_ID_CUENTA  and --P_ID_CUENTA
                nvl( o.anulado, 'X' ) <> 'S' 
                and id_sub_tipo_trans in (SELECT a.ID
                		FROM BSW_subtipos_trans a
                        join bsw_tipos_trans t on a.id_tipo_trans = t.id
                		where a.id_empresa   = :P0_ID_EMPRESA --P_ID_EMPRESA
                		  and a.tip_documento = 'CHE'
                                  and t.tipo_trans  = '10')
                                                          --P_NRO_INICIAL                  --P_NRO_FINAL                
                and to_number(num_valor) between to_number(:P651_NRO_INICIAL) and to_number(:P651_NRO_FINAL) 
                                                --P_FEC_DESDE                              --P_FEC_HASTA
                and fec_emision between TO_DATE(:P651_FEC_DESDE,'DD/MM/YYYY') and TO_DATE(:P651_FEC_HASTA,'DD/MM/YYYY')
                ```
            pageItemsToSubmit: [
                P651_TIP_VALOR
                P651_SER_VALOR
                P651_ID_CUENTA
                P651_NRO_INICIAL
                P651_NRO_FINAL
                P651_FEC_DESDE
                P651_FEC_HASTA
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
