    dynamicAction cargar-remision (
        name: Cargar Remision
        execution {
            sequence: 290
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @remision
        }

        action generar-json (
            name: GENERAR JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                        SELECT e.ID_ARTICULO AS "ID_ARTICULO",
                               e.CANTIDAD AS "CANTIDAD",
                               CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND(E.COSTO_C_IVA-(E.COSTO_C_IVA/11),M.DECIMALES)
                               WHEN 5  THEN ROUND(E.COSTO_C_IVA-(E.COSTO_C_IVA/21),M.DECIMALES)
                               WHEN 0  THEN E.COSTO_C_IVA END AS PRECIO_UNITARIO,--e.PRECIO_UNITARIO AS "PRECIO_UNITARIO",
                               A.COD_ARTICULO AS "COD_ARTICULO",
                               0 AS DESCUENTO,--E.DESCUENTO,
                               
                               /*CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND((E.COSTO_C_IVA-(E.COSTO_C_IVA/11))*E.CANTIDAD,M.DECIMALES)
                               WHEN 5  THEN ROUND((E.COSTO_C_IVA-(E.COSTO_C_IVA/21))*E.CANTIDAD,M.DECIMALES)
                               WHEN 0  THEN E.COSTO_C_IVA*E.CANTIDAD END  AS MONTO_TOTAL,--E.MONTO_TOTAL,
                               CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND(((E.COSTO_C_IVA/11))*E.CANTIDAD,M.DECIMALES)
                               WHEN 5  THEN ROUND(((E.COSTO_C_IVA/21))*E.CANTIDAD,M.DECIMALES)
                               WHEN 0  THEN 0  END  AS TOTAL_IVA,*/--E.TOTAL_IVA,
                               
                               CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND((COT.PRECIO_UNITARIO-(COT.PRECIO_UNITARIO/11))*E.CANTIDAD,M.DECIMALES)
                               WHEN 5  THEN ROUND((COT.PRECIO_UNITARIO-(COT.PRECIO_UNITARIO/21))*E.CANTIDAD,M.DECIMALES)
                               WHEN 0  THEN COT.PRECIO_UNITARIO*E.CANTIDAD END  AS MONTO_TOTAL,--E.MONTO_TOTAL,
                               CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND(((COT.PRECIO_UNITARIO/11))*E.CANTIDAD,M.DECIMALES)
                               WHEN 5  THEN ROUND(((COT.PRECIO_UNITARIO/21))*E.CANTIDAD,M.DECIMALES)
                               WHEN 0  THEN 0  END  AS TOTAL_IVA,--E.TOTAL_IVA,
                                 
                    
                               SUM(1) OVER (ORDER BY E.ID) AS NUM_ORDEN,--0E.NUM_ORDEN,
                               E.CANTIDAD_UB,
                               E.ID_UNIDAD_MEDIDA,
                               E.NRO_LOTE,
                               I.PORC_IVA_VENTA AS IVA,--E.IVA,
                               E.ID_LOTE,
                               ---E.COSTO_C_IVA AS PRECIO_UNITARIO_C_IVA,--E.PRECIO_UNITARIO_C_IVA,
                               COT.PRECIO_UNITARIO AS PRECIO_UNITARIO_C_IVA,
                               0 AS DESCUENTO_C_IVA,--E.DESCUENTO_C_IVA,
                               'N' AS IND_MUEVE_STOCK,--E.IND_MUEVE_STOCK,
                               E.ID_IVA,
                               ---E.COSTO_C_IVA*CANTIDAD AS MONTO_TOTAL_C_IVA,--E.MONTO_TOTAL_C_IVA,
                               ----COT.PRECIO_TOTAL AS MONTO_TOTAL_C_IVA,
                               
                              ( CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND((COT.PRECIO_UNITARIO-(COT.PRECIO_UNITARIO/11))*E.CANTIDAD,M.DECIMALES)
                               WHEN 5  THEN ROUND((COT.PRECIO_UNITARIO-(COT.PRECIO_UNITARIO/21))*E.CANTIDAD,M.DECIMALES)
                               WHEN 0  THEN COT.PRECIO_UNITARIO*E.CANTIDAD END  +
                               CASE I.PORC_IVA_VENTA
                               WHEN 10 THEN ROUND(((COT.PRECIO_UNITARIO/11))*E.CANTIDAD,M.DECIMALES)
                               WHEN 5  THEN ROUND(((COT.PRECIO_UNITARIO/21))*E.CANTIDAD,M.DECIMALES)
                               WHEN 0  THEN 0  END)  AS MONTO_TOTAL_C_IVA,
                               
                               E.DESC_ARTICULO,
                               A.COD_ARTICULO,
                               E.CANTIDAD CANTIDAD_REMISIONADA,
                               E.ID_PEDIDO_DETALLE,
                               E.ID_PEDIDO,
                               C.ID AS ID_REMISION,
                               C.SER_ENT_SAL AS SER_REF_REM,
                               C.NUM_ENT_SAL AS NRO_REF_REM
                               
                        FROM   STW_ENTSAL_CAB C,STW_ENTSAL_DET E,BSW_MONEDAS M,STW_ARTICULOS A,STW_IVA I,
                               CMW_COTIZA_ARTICULOS COT 
                        WHERE E.ID_ARTICULO=A.ID
                        AND E.ID_IVA = I.ID 
                        AND C.ID = E.ID_ENTSAL_CAB
                        AND M.ID = C.ID_MONEDA
                        
                        AND E.ID_ARTICULO = COT.ID_ARTICULO
                        AND E.Id_Pedido = COT.ID_PEDIDO
                        AND E.ID_PEDIDO_DETALLE = COT.ID_PEDIDO_DET
                    
                        AND C.ID IN (SELECT TO_NUMBER(C001) FROM APEX_COLLECTIONS WHERE COLLECTION_NAME = 'TMP_REMISIONES');
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P135_JSON_REMISIONES:=JSON_DETALLE;
                    
                    
                      EXCEPTION 
                      WHEN OTHERS THEN 
                      RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el detalle');
                    
                    END;
                    ```
                itemsToReturn: P135_JSON_REMISIONES
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM APEX_COLLECTIONS
                        WHERE COLLECTION_NAME = 'TMP_REMISIONES'
                    ```
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P135_JSON_REMISIONES'));
                    
                    
                    
                    
                    console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    orden=orden+1;
                    $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO).toString());
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    $model.setValue($newRecord, "CANTIDAD_UB",(json_detalle.DETALLE[i].CANTIDAD_UB).toString());
                    $model.setValue($newRecord, "DESCUENTO",(json_detalle.DETALLE[i].DESCUENTO).toString());
                    $model.setValue($newRecord, "DESCUENTO_C_IVA",(json_detalle.DETALLE[i].DESCUENTO_C_IVA).toString());
                    $model.setValue($newRecord, "ID_IVA",(json_detalle.DETALLE[i].ID_IVA).toString());
                    if((json_detalle.DETALLE[i].ID_LOTE!=null)){
                    $model.setValue($newRecord, "ID_LOTE",(json_detalle.DETALLE[i].ID_LOTE).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA!=null)){
                    $model.setValue($newRecord, "ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA).toString());
                    }
                    $model.setValue($newRecord, "IND_MUEVE_STOCK",(json_detalle.DETALLE[i].IND_MUEVE_STOCK).toString());
                    $model.setValue($newRecord, "MONTO_TOTAL",(json_detalle.DETALLE[i].MONTO_TOTAL).toString());
                    if((json_detalle.DETALLE[i].NRO_LOTE!=null)){
                    $model.setValue($newRecord, "NRO_LOTE",(json_detalle.DETALLE[i].NRO_LOTE).toString());
                    }
                    $model.setValue($newRecord, "PRECIO_UNITARIO",(json_detalle.DETALLE[i].PRECIO_UNITARIO).toString());
                    $model.setValue($newRecord, "PRECIO_UNITARIO_C_IVA",(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA).toString());
                    $model.setValue($newRecord, "TOTAL_IVA",(json_detalle.DETALLE[i].TOTAL_IVA).toString());
                    $model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA).toString());
                    $model.setValue($newRecord, "PORC_IVA",(json_detalle.DETALLE[i].IVA).toString());
                    $model.setValue($newRecord, "NUM_ORDEN",(json_detalle.DETALLE[i].NUM_ORDEN).toString());
                    $model.setValue($newRecord, "DESC_ARTICULO",(json_detalle.DETALLE[i].DESC_ARTICULO).toString());
                    $model.setValue($newRecord, "COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString());
                    $model.setValue($newRecord, "CANTIDAD_REMISIONADA",(json_detalle.DETALLE[i].CANTIDAD_REMISIONADA).toString());
                    $model.setValue($newRecord, "ID_PEDIDO_DETALLE",(json_detalle.DETALLE[i].ID_PEDIDO_DETALLE).toString());
                    $model.setValue($newRecord, "ID_PEDIDO",(json_detalle.DETALLE[i].ID_PEDIDO).toString());
                    $model.setValue($newRecord, "ID_REMISION",(json_detalle.DETALLE[i].ID_REMISION).toString());
                    $model.setValue($newRecord, "SER_REF_REM",(json_detalle.DETALLE[i].SER_REF_REM).toString());
                    $model.setValue($newRecord, "NRO_REF_REM",(json_detalle.DETALLE[i].NRO_REF_REM).toString());
                    
                    
                    
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction conv-fecha (
        name: CONV_FECHA
        execution {
            sequence: 310
        }
        when {
            selectionType: items
            items: P135_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P135_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P135_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P135_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P135_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P135_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P135_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P135_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P135_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('VT','ID_MODULO_VT'),:P135_FEC_COMPROBANTE);
                    end;
                    ```
                itemsToSubmit: P135_FEC_COMPROBANTE
                itemsToReturn: P135_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

