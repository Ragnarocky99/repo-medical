    dynamicAction descuento-por-detalle (
        name: Descuento por Detalle
        execution {
            sequence: 80
            eventScope: dynamic
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detalles
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :PORC_DESCUENTO IS NOT NULL AND NVL(:PORC_DESCUENTO,0)<>0 THEN 
                    :P135_DESCUENTO_V:=REPLACE(NVL(:PRECIO_UNITARIO_C_IVA,0),'.','')-REPLACE(NVL(:DESCUENTO_C_IVA,0),'.','');
                    ELSE 
                    :P135_DESCUENTO_V:='';
                    END IF;
                    ```
                itemsToSubmit: [
                    DESCUENTO_C_IVA
                    PORC_IVA
                    PRECIO_UNITARIO_C_IVA
                    PORC_DESCUENTO
                ]
                itemsToReturn: P135_DESCUENTO_V
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

