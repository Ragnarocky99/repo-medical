    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                               IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                              :DESCUENTO:=(NVL(:DESCUENTO_C_IVA,0))-(NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0))));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              END IF;
                
                                insert into VTW_COMPROBANTES_DETALLE 
                                (ID_ARTICULO,ID_COMPROBANTE_CABECERA,CANTIDAD,ID_IVA,TOTAL_IVA,MONTO_TOTAL_C_IVA,
                                PRECIO_UNITARIO_C_IVA,NUM_ORDEN,PRECIO_UNITARIO,ID_UNIDAD_MEDIDA,COD_USUARIO_AUD,MONTO_TOTAL,IVA,PORC_DESCUENTO
                                ,ID_LOTE,NRO_LOTE,DESCUENTO_C_IVA,DESCUENTO,DESC_ARTICULO, ID_BARRA,ID_EMPRESA, CANTIDAD_REMISIONADA, ID_PEDIDO_DETALLE, ID_PEDIDO
                                ,ID_REMISION, SER_REF_REM, NRO_REF_REM, ID_SUCURSAL, TIP_COMPROBANTE,TRIPTICO,FEC_TRIPTICO, IND_MUEVE_STOCK)
                                values(:ID_ARTICULO,:P135_ID,:CANTIDAD,:ID_IVA,REPLACE(:TOTAL_IVA,'.',''),
                                REPLACE(:MONTO_TOTAL_C_IVA,'.',''),REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),:NUM_ORDEN,
                                :PRECIO_UNITARIO,:ID_UNIDAD_MEDIDA,:COD_USUARIO_AUD,
                                REPLACE(:MONTO_TOTAL,'.',''),:PORC_IVA,:PORC_DESCUENTO,
                                :ID_LOTE,:NRO_LOTE,:DESCUENTO_C_IVA,:DESCUENTO,:DESC_ARTICULO, :ID_BARRA,:P0_ID_EMPRESA, :CANTIDAD_REMISIONADA, :ID_PEDIDO_DETALLE, :ID_PEDIDO
                                ,:ID_REMISION, :SER_REF_REM, :NRO_REF_RE,:ID_SUCURSAL, :TIP_COMPROBANTE,:TRIPTICO,:FEC_TRIPTICO, :IND_MUEVE_STOCK);
                            
                            WHEN 'U' then  
                         
                                IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                             :DESCUENTO:=NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0)));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              END IF;
                 
                
                                update VTW_COMPROBANTES_DETALLE  d
                                    set  ID_ARTICULO = :ID_ARTICULO,
                                         cantidad     = :cantidad,
                                         precio_unitario_c_iva       = REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                         id_iva     = :ID_IVA,
                                         TOTAL_IVA    = REPLACE(:TOTAL_IVA,'.',''),
                                         monto_total  = REPLACE(:MONTO_TOTAL,'.',''),
                                         MONTO_TOTAL_C_IVA      = REPLACE(:MONTO_TOTAL_C_IVA,'.',''),
                                         PRECIO_UNITARIO=REPLACE(:PRECIO_UNITARIO,'.',''),
                                         ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                                         IVA=:IVA,
                                         PORC_DESCUENTO=:PORC_DESCUENTO,
                                         ID_LOTE=:ID_LOTE,
                                         NRO_LOTE=:NRO_LOTE,
                                         DESCUENTO_C_IVA=:DESCUENTO_C_IVA,
                                         DESCUENTO=:DESCUENTO,
                                         NUM_ORDEN=:NUM_ORDEN,
                                         DESC_ARTICULO=:DESC_ARTICULO,
                                         ID_BARRA = :ID_BARRA,
                                         CANTIDAD_REMISIONADA = :CANTIDAD_REMISIONADA,
                                         ID_PEDIDO = :ID_PEDIDO,
                                         ID_PEDIDO_DETALLE = :ID_PEDIDO_DETALLE,
                                         ID_REMISION = :ID_REMISION,
                                         TRIPTICO = :TRIPTICO,
                                         FEC_TRIPTICO = :FEC_TRIPTICO,
                                         IND_MUEVE_STOCK = :IND_MUEVE_STOCK
                
                                where   d.ID_COMPROBANTE_CABECERA = :P135_ID
                                    and d.id = :id;
                
                           when 'D' then
                                delete VTW_COMPROBANTES_DETALLE d     
                                WHERE d.ID_COMPROBANTE_CABECERA = :ID_COMPROBANTE_CABECERA
                                           and d.id = :id;  
                    end case;
                 EXCEPTION WHEN OTHERS THEN
                 RAISE_APPLICATION_ERROR(-20000,SQLERRM);
                END;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 23403489021179379
        }
        comments {
            comments: "Proceso para guardar, actualizar, eliminar los detalles de la factura "
        }
    )

