    validation controla-stock (
        name: controla_stock
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @detalles
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vcantidad number;
                BEGIN
                
                    IF NVL(:P135_PERMISO_FACTURA_NEGATIVO,'N') = 'S'or NVL(:IND_MUEVE_STOCK,'S') = 'N' THEN
                      RETURN TRUE;
                    END IF;
                    if :id_articulo is not null and :id_lote is not null then
                      begin
                        select sum(cant_dispon)
                          into vcantidad
                        from stw_existencia_art 
                        where id_empresa = :P0_ID_EMPRESA
                          and id_sucursal = :P0_ID_SUCURSAL
                          and id_articulo = :id_articulo
                          and id_lote = :id_lote;
                      exception
                        when no_data_found then
                          vcantidad := 0;
                        when others then
                          vcantidad := 0;
                          raise_application_error(-20000,'Error al buscar existencia '||sqlerrm);
                      end;
                      if nvl(vcantidad,0) < nvl(:cantidad,0) then
                        return FALSE;
                      else
                        return TRUE;
                      end if;
                    else
                      return TRUE;
                    end if;
                end;
                ```
        }
        error {
            errorMessage: #COLUMN_HEADER# cantidad super al stock.
            associatedColumn: CANTIDAD
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('VT','ID_MODULO_VT'),:P135_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha fuera de rango
            associatedItem: @P135_FEC_COMPROBANTE
        }
    )

    validation validar-limite-de-credito (
        name: Validar Limite de Credito
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                IF :P135_ID_CONDICION_VENTA = trae_id_condicion_ven(:P0_ID_EMPRESA,'0') THEN
                RETURN FALSE;
                ELSIF NVL(REPLACE(:P135_SALDO,'.',''),0)+NVL(REPLACE(:P135_TOT_COMPROBANTE,'.',''),0)>
                NVL(REPLACE(:P135_LIMITE_CREDITO,'.',''),0)  THEN
                RETURN TRUE;
                END IF;
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Error el cliente supero su limite de credito
            associatedItem: @P135_FACTURA_POSIBLE
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Valida que el cliente no supere su limite de credito al cargar una nueva factura "
        }
    )

    validation validar-lineas (
