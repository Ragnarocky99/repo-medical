    computation p135-iva (
        itemName: P135_IVA_5
        execution {
            sequence: 80
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_COMPROBANTES_DETALLE
                    WHERE :P135_ID=ID_COMPROBANTE_CABECERA;
                    item_detalle VTW_COMPROBANTES_DETALLE%rowtype;
                    v_total_iva_5    VTW_COMPROBANTES_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P135_ID
        }
    )

