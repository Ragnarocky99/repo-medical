    computation p135-nro-comprobante (
        itemName: P135_NRO_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P135_NRO_COMPROBANTE IS  NULL THEN
                SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                INTO v_nro_comprobante
                FROM
                VTW_COMPROBANTES_CABECERA 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND SER_COMPROBANTE = :P135_SER_COMPROBANTE
                AND /*:P135_TIP_COMPROBANTE=*/TIP_COMPROBANTE in ('FVE');
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P135_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P135_NRO_COMPROBANTE
        }
        comments {
            comments: "Para calcular el nro comprobante a guardarse si es que no se escribió un numero de manera manual "
        }
    )

