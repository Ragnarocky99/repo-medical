    computation p135-id-serie-comp (
        itemName: P135_ID_SERIE_COMP
        execution {
            sequence: 130
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_ser varchar2(7);
                V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                    SELECT owa_util.get_cgi_env('REMOTE_ADDR') INTO V_IP_MAQUINA FROM DUAL;
                    select ID
                      INTO v_ser
                    from BSW_SERIES_COMPROB t 
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA 
                      AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                      AND TERMINAL=V_IP_MAQUINA
                      AND TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT','TIPO_COMPROBANTE_VENTA')
                      AND IND_ACTIVO='S';
                    RETURN v_ser;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            return null;
                        WHEN OTHERS THEN
                            RETURN null; 
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P135_ID
        }
    )

