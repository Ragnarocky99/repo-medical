    dynamicAction abrir-lista-de-valores (
        name: Abrir Lista de Valores
        execution {
            sequence: 190
            eventScope: once
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P135_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P135_LV_TALONARIOS_lov_btn").click();
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                    vnro_ini  NUMBER(8);
                    V_IP_MAQUINA VARCHAR(200);
                    
                    BEGIN
                    
                    
                      
                    
                    SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                    
                        select count(*)
                          into vnro_ini
                          from BSW_series_comprob s
                         where S.ID_EMPRESA   = :P0_ID_EMPRESA
                           and S.TIP_COMPROBANTE = W_BUSCA_PARAMETRO('VT', 'TIPO_COMPROBANTE_VENTA')
                           and S.ID_SUCURSAL  = :P0_ID_SUCURSAL
                           and nvl( S.IND_ACTIVO, 'S' ) <> 'N'
                           and S.TERMINAL = V_IP_MAQUINA;
                        -- and t.cod_empresa   = s.cod_empresa
                        -- and t.tip_talonario = s.tip_comprobante
                        -- and t.serie         = s.ser_comprobante;
                        -- and nvl(s.terminal,vterminal) = vterminal ;
                    --     and s.terminal      = vterminal ;
                    
                        IF nvl( vnro_ini, 0 ) > 1 THEN
                            RETURN TRUE;
                        END IF;
                    
                      END;
                    
                    ```
            }
        )

    )

