    computation p135-carga-precio (
        itemName: P135_CARGA_PRECIO
        execution {
            sequence: 120
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  V_PERMISO VARCHAR2(1);
                BEGIN
                  SELECT 'S'
                    INTO V_PERMISO
                    FROM BSW_PERMISOS_FORMAS F, BSW_PERMISOS_OPCIONES O
                   WHERE F.ID_PERMISO = O.ID
                     AND F.ID_PAGINA = :APP_PAGE_ID
                     AND F.ID_EMPRESA = O.ID_EMPRESA
                     AND F.ID_EMPRESA = :P0_ID_EMPRESA
                     AND F.ID_USUARIO = TRAE_ID_USUARIO(:P0_ID_EMPRESA, UPPER(:APP_USER))
                     AND O.PARAMETRO = 'CARGA_PRECIOS';
                  RETURN V_PERMISO;
                EXCEPTION
                  WHEN OTHERS THEN
                    RETURN 'N';
                END;
                
                ```
        }
    )

