    dynamicAction alerta-triptico (
        name: Alerta Triptico
        execution {
            sequence: 340
        }
        when {
            event: ready
        }

        action p135-ind-requiere-triptico (
            name: P135_IND_REQUIERE_TRIPTICO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    VTWP_REQUIERE_TRIPTICO(P_TIP_COMPROBANTE => 'FVE',
                                           P_ID_COMPROBANTE  => :P135_ID,
                                           P_IND_REQUIERE    => :P135_IND_REQUIERE_TRIPTICO,
                                           P_MENSAJE         => :P135_MENSAJE_TRIPTICO);
                    ```
                itemsToSubmit: P135_ID
                itemsToReturn: [
                    P135_IND_REQUIERE_TRIPTICO
                    P135_MENSAJE_TRIPTICO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action plugin-com-fos-notifications (
            action: plugin/fosNotifications
            settings {
                action: showWarning
                message: &P135_MENSAJE_TRIPTICO!RAW.
                overrideDefaults: true
                options: [
                    preventDuplicates
                    newestOnTop
                    performClientSideSubstitutions
                    dismissOnNotificationClickTap
                    dismissOnCloseButtonClick
                ]
                icon: fa-warning
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: item=value
                item: P135_IND_REQUIERE_TRIPTICO
                value: S
            }
        )

    )

    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 220
        }
        when {
            event: click
            selectionType: items
            items: P135_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P135_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P135_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P135_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P135_URL
                    P135_ASIENTOS_ID
                ]
                itemsToReturn: P135_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P135_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 100
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    NVL(A.ESTADO,'N')='S'
                    AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.cod_articulo
                    INTO :cod_articulo
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: COD_ARTICULO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P135_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-montos (
        name: CALCULAR_MONTOS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
                PORC_DESCUENTO
            ]
        }
        comments {
            comments: Aqui se van calculando los totales correspondientes  (Monto total con iva , monto total , total iva ,descuentos)
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :PORC_DESCUENTO IS NULL THEN
                    :PORC_DESCUENTO:=0 ;
                    END IF;
                    
                    :DESCUENTO_C_IVA:=ROUND(REPLACE(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_DESCUENTO/100),NVL(:P135_DECIMALES,0));
                    
                    ```
                itemsToSubmit: [
                    PORC_DESCUENTO
                    PRECIO_UNITARIO_C_IVA
                    P135_DECIMALES
                ]
                itemsToReturn: DESCUENTO_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :CANTIDAD is null then
                         :CANTIDAD := 1;
                    end if;
                    
                    if :PRECIO_UNITARIO_C_IVA is null THEN
                        :PRECIO_UNITARIO_C_IVA    := 0;
                        :TOTAL_IVA := 0;
                        END IF;
                    
                        IF :DESCUENTO_C_IVA IS NULL THEN
                        :DESCUENTO_C_IVA:=0;
                    end if;
                    
                    :MONTO_TOTAL_C_IVA := ROUND(replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)), NVL(:P135_DECIMALES,0));
                    IF :DESCUENTO_C_IVA IS NOT NULL AND :DESCUENTO_C_IVA!=0 THEN 
                        :P135_DESCUENTO_V:=ROUND(replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0),NVL(:P135_DECIMALES,0));
                    END IF;
                    --:MONTO_TOTAL_C_IVA:=:CANTIDAD * :PRECIO_UNITARIO_C_IVA;
                    
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    CANTIDAD
                    DESCUENTO_C_IVA
                    P135_DECIMALES
                ]
                itemsToReturn: [
                    MONTO_TOTAL
                    MONTO_TOTAL_C_IVA
                    P135_DESCUENTO_V
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null  then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    if :TOTAL_IVA is null then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    :TOTAL_IVA := round(((((replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)) * replace(:CANTIDAD, '.', '')) * :PORC_IVA ) / (100 + :PORC_IVA)),NVL(:P135_DECIMALES,0));
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    DESCUENTO_C_IVA
                    P135_DECIMALES
                ]
                itemsToReturn: TOTAL_IVA
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-4 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :MONTO_TOTAL is null  then
                       :MONTO_TOTAL:= 0;
                    end if;
                    
                    
                    --:MONTO_TOTAL :=:MONTO_TOTAL_C_IVA -:IVA;
                    :MONTO_TOTAL := round((replace(:MONTO_TOTAL_C_IVA, '.', '') - replace(:TOTAL_IVA, '.', '')),NVL(:P135_DECIMALES,0));
                    ```
                itemsToSubmit: [
                    MONTO_TOTAL_C_IVA
                    TOTAL_IVA
                    P135_DECIMALES
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-5 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_precio_unitario number;
                    begin
                    IF :PRECIO_UNITARIO IS NULL THEN
                    :PRECIO_UNITARIO:=0;
                    END IF;
                    
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_IVA/(100+:PORC_IVA)),NVL(:P135_DECIMALES,0));
                     :PRECIO_UNITARIO:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,NVL(:P135_DECIMALES,0));
                     end;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    P135_DECIMALES
                ]
                itemsToReturn: PRECIO_UNITARIO
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-caja (
        name: Cargar Datos Caja
        execution {
            sequence: 270
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                     Select H.NRO_HABILITACION,C.COD_CAJA
                     INTO :P135_NRO_HABILITACION,:P135_COD_CAJA
                         from ccw_habilitaciones H,CCW_CAJAS C
                        where H.id_empresa = :p0_cod_empresa
                          and H.id_sucursal = :P0_COD_SUCURSAL
                          AND H.ID_CAJA=C.ID
                          AND H.ID_EMPRESA=C.ID_EMPRESA
                          and upper(id_usuario) = (SELECT ID FROM BSW_USUARIOS WHERE COD_USUARIO=UPPER(:APP_USER) AND 
                          ID_EMPRESA=:P0_COD_EMPRESA)
                          and fec_cierre IS NULL;
                          EXCEPTION WHEN OTHERS THEN
                          NULL;
                    end;
                    ```
                itemsToReturn: [
                    P135_NRO_HABILITACION
                    P135_COD_CAJA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

