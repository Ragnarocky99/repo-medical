    dynamicAction refrescar-region (
        name: Refrescar region
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @listado-de-cheques-recibidos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @listado-de-cheques-recibidos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go to Page 590
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 590
                items: {
                    P590_BANCO: &P583_BANCO.
                    P590_CLIENTE: &P583_CLIENTE.
                    P590_ESTADO: &P583_ESTADO.
                    P590_NRO_CHEQUE: &P583_NRO_CHEQUE.
                    P590_PERIODO_EMI_FIN: &P583_PERIODO_EMI_FIN.
                    P590_PERIODO_EMI_INI: &P583_PERIODO_EMI_INI.
                    P590_PERIODO_VENCI_INI: &P583_PERIODO_VENCI_INI.
                    P590_PERIODO_VENCI_FIN: &P583_PERIODO_VENCI_FIN.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

