page 583 (
    name: Cheques Recibidos en Caja
    alias: CHEQUES-RECIBIDOS-EN-CAJA
    title: Cheques Recibidos en Caja
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region listado-de-cheques-recibidos (
        name: Listado de cheques recibidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       V.ID_PER_JURIDICA,
                       V.NRO_VALOR,
                       V.FEC_EMISION,
                       V.FEC_VENCIMIENTO,
                       V.MONTO_VALOR,
                       V.ID_CLIENTE,   
                       V.NRO_CUENTA,
                       V.ESTADO_VALOR,
                       S.DESCRIPCION,
                 CASE V.estado_VALOR
                           WHEN 'A' THEN 'A Depositar'
                           WHEN 'P' THEN 'Pendiente'
                           WHEN 'D' THEN 'Depositado'
                           WHEN 'R' THEN 'Rechazando '
                           WHEN 'C' THEN 'Canjeado'
                           ELSE ''
                       END AS estado_valorr,
                       v.id,
                       (SELECT VD.NRO_COMPROBANTE
                          FROM CCW_MOV_VALORES_DET VD
                         WHERE VD.TIP_COMPROBANTE = 'DEP'
                           AND VD.ID_CUENTA_BANCARIA = V.ID_CUENTA_BANCARIA
                           AND VD.NRO_VALOR = V.NRO_VALOR) NRO_DEPOSITO,
                       (SELECT VD.ID_MOV_VALORES_CAB
                          FROM CCW_MOV_VALORES_DET VD
                         WHERE VD.TIP_COMPROBANTE = 'DEP'
                           AND VD.ID_CUENTA_BANCARIA = V.ID_CUENTA_BANCARIA
                           AND VD.NRO_VALOR = V.NRO_VALOR) ID_MOV_VALORES_CAB
                 
                  from CCW_VALORES V,  BSW_SUBTIPOS_TRANS S
                  WHERE
                  V.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (V.ID_CLIENTE = :P583_CLIENTE OR :P583_CLIENTE IS NULL)
                  AND (V.ID_PER_JURIDICA = :P583_BANCO OR :P583_BANCO IS NULL)
                
                  AND (V.FEC_VENCIMIENTO >= :P583_PERIODO_VENCI_INI OR :P583_PERIODO_VENCI_INI IS NULL)
                  AND (V.FEC_VENCIMIENTO <= :P583_PERIODO_VENCI_FIN OR :P583_PERIODO_VENCI_FIN IS NULL)
                  AND (V.FEC_EMISION >= :P583_PERIODO_EMI_INI OR :P583_PERIODO_EMI_INI IS NULL)
                  AND (V.FEC_EMISION <= :P583_PERIODO_EMI_FIN OR :P583_PERIODO_EMI_FIN IS NULL)
                
                  AND (V.ESTADO_VALOR = :P583_ESTADO OR :P583_ESTADO IS NULL)
                  AND (V.NRO_VALOR = :P583_NRO_CHEQUE OR :P583_NRO_CHEQUE IS NULL)
                  AND V.ID_SUBTIPO_TRANS = S.ID
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 593
                items: {
                    P593_ID_CLIENTE: #ID_CLIENTE#
                    P593_ID_PER_JURIDICA: #ID_PER_JURIDICA#
                    P593_NRO_CUENTA: #NRO_CUENTA#
                    P593_NRO_VALOR: #NRO_VALOR#
                    P593_FEC_EMISION: #FEC_VENCIMIENTO#
                    P593_MONTO_VALOR: #MONTO_VALOR#
                    P593_ESTADO_VALOR: #ESTADO_VALOR#
                    P593_FEC_VENCIMIENTO: #FEC_VENCIMIENTO#
                    P593_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 97343304876546218
        }

