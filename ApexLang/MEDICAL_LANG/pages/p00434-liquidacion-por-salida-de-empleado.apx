page 434 (
    name: Liquidacion por Salida de Empleado
    alias: LIQUIDACION-POR-SALIDA-DE-EMPLEADO
    title: Liquidacion por Salida de Empleado
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region liquidacion-por-salida-de-empleado (
        name: Liquidacion por Salida de Empleado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID, C.SER_LIQUID, C.NRO_LIQUID, C.FEC_LIQUID,
                C.MES, C.ANIO, C.ID_EMPLEADO, C.ID_MOTIVO_SALIDA, C.SUELDO_BASE, C.DIAS,
                C.SUELDO_FINAL, C.SUELDO_PROMEDIO, C.TIP_LIQUID, C.MONTO, C.COD_USUARIO_AUD
                FROM RHW_CABECERA_LIQ C
                WHERE C.ID_EMPRESA=:P0_ID_EMPRESA
                AND C.IND_LIQ_FINAL='S'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 414
                items: {
                    P414_ID: #ID#
                    P414_NRO_LIQUID: #NRO_LIQUID#
                    P414_SER_LIQUID: #SER_LIQUID#
                    P414_ID_EMPRESA: #ID_EMPLEADO#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-insertar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 37448643316096596
        }

        column ANIO (
            type: plainText
            heading {
                heading: Año
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DIAS (
            type: plainText
            heading {
                heading: Días
                alignment: center
            }
            layout {
