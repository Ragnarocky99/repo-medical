        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region detalles-de-inventario (
        name: Detalles de Inventario
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select --A.ID,
                       A.Cod_Articulo as Cod_Articulo,
                       A.Cod_Origen_Art as Cod_Fabricante,
                       A.Descripcion,
                       --A.Id_Envase as Presentacion,
                       EN.Descripcion as Presentacion,
                       U.Descripcion /*A.Id_Unidad_Medida*/ as Unidad_de_Medida,
                       M.Descripcion /*A.Id_Marca*/ as Marca,
                       R.Descripcion /*A.Id_Rubro*/ as Categoria_de_Producto,
                       L.NRO_LOTE as Lote,
                       L.Fec_Vencimiento as Fecha_Vencimiento,--A.Ind_Maneja_Lote as Lote,
                       S.Descripcion /*E.ID_SUCURSAL*/ as Sucursal,
                       sum(E.Cant_Dispon) as Stock,
                       e.nro_estante,
                       e.nro_fila
                from stw_articulos A,
                     stw_existencia_art E,
                     stw_lotes L,
                     stw_unidades_medida U,
                     stw_marcas M,
                     stw_rubro R,
                     bsw_sucursales S,
                     stw_envases EN
                where E.ID_ARTICULO = A.ID
                and   L.Id_Articulo = A.ID
                and   A.Id_Unidad_Medida = U.ID(+)
                and   A.Id_Marca = M.ID(+)
                and   A.Id_Rubro = R.ID(+)
                and   E.Id_Sucursal = S.ID
                and   A.Id_Envase = EN.ID(+)
                and   E.Id_Lote = L.id(+)
                --and   A.Cod_Articulo = 103
                
                group by A.ID, 
                         A.Cod_Articulo,
                         A.Cod_Origen_Art,
                         A.Descripcion,
                         EN.Descripcion,
                         U.Descripcion,
                         M.Descripcion,
                         R.Descripcion,
                         L.NRO_LOTE,
                         L.Fec_Vencimiento,
                         S.Descripcion,
                         e.nro_estante,
                         e.nro_fila
                         --E.Cant_Dispon
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
