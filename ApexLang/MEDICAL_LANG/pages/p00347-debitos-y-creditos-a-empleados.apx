    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P347_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P347_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P347_HASTA,'/','');
                            conv_fecha := substr(:P347_HASTA,1,2)||'/'||
                                                      substr(:P347_HASTA,3,2)||'/'||
                                                      lpad(substr(:P347_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P347_HASTA := conv_fecha;
                            ELSIF (length(:P347_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P347_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P347_HASTA
                itemsToReturn: P347_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P347_PERIODO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P347_PERIODO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P347_PERIODO,'/','');
                            conv_fecha := substr(:P347_PERIODO,1,2)||'/'||
                                                      substr(:P347_PERIODO,3,2)||'/'||
                                                      lpad(substr(:P347_PERIODO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P347_PERIODO := conv_fecha;
                            ELSIF (length(:P347_PERIODO) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P347_PERIODO) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P347_PERIODO
                itemsToReturn: P347_PERIODO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: REFRESH
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @débitos-y-créditos-a-empleados
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @débitos-y-créditos-a-empleados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process limpiar (
        name: Limpiar
        type: clearSessionState
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21729950859810842
        }
        serverSideCondition {
            whenButtonPressed: @limpiar
        }
    )

    branch (
        name: Go To Page 350
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 350
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

