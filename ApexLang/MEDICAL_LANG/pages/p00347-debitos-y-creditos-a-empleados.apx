    region débitos-y-créditos-a-empleados (
        name: Débitos y Créditos a Empleados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.ID_CONCEPTO,
                       D.SER_DEBCRED,
                       D.NRO_DEBCRED,
                       D.FEC_DEBCRED,
                       D.ID_EMPLEADO,
                       D.TIPO,
                       D.CANTIDAD,
                       D.MONTO,
                       D.ORIGEN,
                       D.ANIO,
                       D.MES,
                       D.TIP_LIQUID,
                       D.OBSERVACION,
                       D.UNIDAD,
                       D.COEFICIENTE,
                       D.COD_USUARIO_AUD
                  from RHW_DEBCRED D
                  where D.ID_EMPRESA=:P0_ID_EMPRESA
                and 
                    (
                       (D.ANIO = :P347_ANIO OR :P347_ANIO is null) and (D.MES = :P347_MES OR :P347_MES is null)
                    )
                and 
                    (
                       (D.FEC_DEBCRED >= :P347_PERIODO OR :P347_PERIODO is null) and (D.FEC_DEBCRED <= :P347_HASTA OR :P347_HASTA is null)
                    )
                and (D.ESTADO = :P347_ESTADO OR :P347_ESTADO IS NULL)
                and (D.ID_CONCEPTO = :P347_CONCEPTO OR :P347_CONCEPTO IS NULL)
                and (D.ID_EMPLEADO = :P347_EMPLEADO OR :P347_EMPLEADO IS NULL)
                order by D.ID DESC;
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 348
                items: {
                    P348_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 19468535084294240
        }

