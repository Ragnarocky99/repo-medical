page 24 (
    name: Empresas
    alias: EMPRESAS
    title: Empresas - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline: "td[headers=\"Logo\"] img {   width: 74px; } "
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region empresas (
        name: Empresas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_EMPRESA,
                       ID_MONEDAS,
                       REFERENCIA_RUBRO,
                       TITULO_REPORTES,
                       DESCRIPCION,
                       COD_USUARIO_AUD,
                       ID_PERSONA,
                       USA_CALENDARIO,
                       RUC_EMPRESA,
                       DIRECCION,
                       ACTIVIDAD,
                       NRO_PATRONAL,
                       LOCALIDAD,
                       DEPARTAMENTO,
                       IND_MANEJA_SECTORES,
                       IND_MANEJA_CUSTODIOS,
                       IND_MANEJA_LOTES,
                       IND_BONIFICACION_PORC,
                       IND_STOCK_NEGATIVO,
                       IND_MANEJA_DEPOSITOS,
                       COLOR_LINEA_REPORTES,
                       TELEFONO,
                       MONTO_BONIF_FLIAR,
                       IND_LOTES_AUTOMATICOS,
                       ID_CLIENTE,
                       PATH,
                       COEFICIENTE_VENTAS,
                      sys.dbms_lob.getlength(lOGO_COMPROBANTE) ,
                      sys.dbms_lob.getlength( LOGO_REPORTE),
                      sys.dbms_lob.getlength( IMPRESION_RECIBO)
                  from BSW_EMPRESAS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 25
                items: {
                    P25_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 9694017138800175
        }

