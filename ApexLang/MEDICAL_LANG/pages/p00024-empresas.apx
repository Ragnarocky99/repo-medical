        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                EMPRESAS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 97088 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVIDAD (
                sequence: 8
            )

            displayColumn COD_EMPRESA (
                sequence: 1
            )

            displayColumn DEPARTAMENTO (
                sequence: 11
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn DIRECCION (
                sequence: 7
            )

            displayColumn ID_CLIENTE (
                sequence: 13
            )

            displayColumn ID_MONEDAS (
                sequence: 2
            )

            displayColumn ID_PERSONA (
                sequence: 5
            )

            displayColumn LOCALIDAD (
                sequence: 10
            )

            displayColumn NRO_PATRONAL (
                sequence: 9
            )

            displayColumn RUC_EMPRESA (
                sequence: 6
            )

            displayColumn "SYS.DBMS_LOB.GETLENGTH(LOGO_COMPROBANTE)" (
                sequence: 14
            )

            displayColumn "SYS.DBMS_LOB.GETLENGTH(LOGO_REPORTE)" (
                sequence: 15
            )

            displayColumn TELEFONO (
                sequence: 12
            )

            displayColumn TITULO_REPORTES (
                sequence: 3
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @empresas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                clearCache: 25
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @empresas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @empresas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17285520929218062
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

