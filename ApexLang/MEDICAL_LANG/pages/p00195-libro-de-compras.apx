    pageItem PC_FEC_FIN (
        type: datePicker
        label {
            label: <p>Hasta la fecha: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select last_day(trunc(sysdate)) from dual
                
                ```
        }
    )

    pageItem PC_FEC_INI (
        type: datePicker
        label {
            label: <p>Desde la fecha: </p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    pageItem PC_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursales: </p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            displayExtraValues: false
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: --SIN SELECCIONAR--
        }
    )

    button b-ejecutar (
        buttonName: B_EJECUTAR
        label: Ejecutar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button b-print (
        buttonName: B_PRINT
        label: Imprimir
        layout {
            sequence: 20
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction convert (
        name: CONVERT
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: PC_FEC_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:PC_FEC_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:PC_FEC_FIN,'/','');
                            conv_fecha := substr(:PC_FEC_FIN,1,2)||'/'||
                                                      substr(:PC_FEC_FIN,3,2)||'/'||
                                                      lpad(substr(:PC_FEC_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :PC_FEC_FIN := conv_fecha;
                            ELSIF (length(:PC_FEC_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:PC_FEC_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: PC_FEC_FIN
                itemsToReturn: PC_FEC_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: PC_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:PC_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:PC_FEC_INI,'/','');
                            conv_fecha := substr(:PC_FEC_INI,1,2)||'/'||
                                                      substr(:PC_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:PC_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :PC_FEC_INI := conv_fecha;
                            ELSIF (length(:PC_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:PC_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: PC_FEC_INI
                itemsToReturn: PC_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 198
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 198
            }
        }
        serverSideCondition {
            whenButtonPressed: @b-print
        }
    )

)

