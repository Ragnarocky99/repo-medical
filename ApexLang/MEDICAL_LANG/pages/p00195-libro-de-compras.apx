        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reporte de Compras
        }

        savedReport 450307 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESC_EMPRESA (
                sequence: 7
            )

            displayColumn DESC_SUCURSAL (
                sequence: 9
            )

            displayColumn FEC_COMPROBANTE (
