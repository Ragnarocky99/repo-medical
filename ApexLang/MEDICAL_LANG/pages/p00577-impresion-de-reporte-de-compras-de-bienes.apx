page 577 (
    name: Impresion de Reporte de Compras de Bienes
    alias: IMPRESION-DE-REPORTE-DE-COMPRAS-DE-BIENES
    title: Impresion de Reporte de Compras de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    branch (
        name: Brach To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                          l_proc varchar2(100) := 'show report';
                          l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                          v_nom_empresa varchar2(150);
                          /*v_sucursal varchar2(150);
                          v_centro varchar2(150);
                          v_seccion varchar2(150);
                          v_tipo varchar2(150);
                          v_departamento varchar2(150);*/
                        BEGIN
                          SELECT E.DESCRIPCION INTO v_nom_empresa FROM BSW_EMPRESAS E WHERE E.ID = :P0_ID_EMPRESA;
                          /*begin
                            SELECT DESCRIPCION INTO v_sucursal FROM BSW_SUCURSALES WHERE ID = :P576_SUCURSAL;
                          EXCEPT
                            WHEN NO_DATA_FOUND THEN
                            v_sucursal := 'TODAS';
                          end;
                          begin
                            SELECT DESCRIPCION INTO v_centro FROM COW_CENTRO_COSTOS WHERE ID = :P576_CENTRO;
                          EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                            v_centro := 'TODOS';
                          end;
                          begin
                            SELECT DESCRIPCION INTO v_seccion FROM rhw_secciones WHERE ID = :P576_SECCION;
                          EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                            v_seccion := 'TODAS';
                          end;
                          begin
                            SELECT DESCRIPCION INTO v_tipo FROM COW_TIPOS_BIENES WHERE ID = :P576_TIPO_BIEN;
                          EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                            v_tipo := 'TODOS';
                          end;
                          begin
                            SELECT DESCRIPCION INTO v_departamento FROM rhw_departamentos WHERE ID = :P576_DEPARTAMENTO;
                          EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                            v_departamento := 'TODAS';
                          end;*/
                          xlog (l_proc, 'url (orig):' || l_report_url);
                          xlib_jasperreports.set_report_url(l_report_url);
                          xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('CompraBienes'),
                                  p_rep_format          => apex_util.url_encode('pdf'),
                                  p_data_source         => apex_util.url_encode('default'),
                                  p_out_filename        => apex_util.url_encode(:P3_out_filename),
                                  p_rep_locale          => apex_util.url_encode('es_ES'),
                                  p_rep_encoding        => apex_util.url_encode('UTF-8'),
                                  p_additional_params   => ('p_sucursal='||:P576_SUCURSAL||'&'||
                                                            'p_centro='||:P576_CENTRO||'&'||
                                                            'fec_ini='||:P576_FEC_INI||'&'||
                                                            'fec_fin='||:P576_FEC_FIN||'&'||
                                                            'p_seccion='||:P576_SECCION||'&'||
                                                            'p_tipo_bien='||:P576_TIPO_BIEN||'&'||
                                                            'p_departamento='||:P576_DEPARTAMENTO||'&'||
                                                            'p_usuario='||:APP_USER),
                                  p_print_is_enabled    => case when :P3_print_is_enabled='1' then true else false end,
                                  p_print_printer_name  => apex_util.url_encode(:P3_print_printer_name),
                                  p_print_media         => apex_util.url_encode(:P3_print_media),
                                  p_print_copies        => apex_util.url_encode(:P3_print_copies),
                                  p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                                  p_print_collate       => case when :P3_print_collate='1' then true else false end,
                                  p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                                  p_save_filename       => apex_util.url_encode(:P3_save_filename),
                                  p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                                  p_print_job_name      => apex_util.url_encode(:P3_print_job_name)
                                  );
                          apex_application.stop_apex_engine();
                        exception
                          when apex_application.e_stop_apex_engine then
                            null;
                          when others then 
                            xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                            raise;
                        end;
                ```
        }
    )

)

