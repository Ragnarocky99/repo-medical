page 578 (
    name: Impresión Contrato Loteamiento
    alias: IMPRESIÓN-CONTRATO-LOTEAMIENTO
    title: Impresión Contrato Loteamiento
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P578_ID_CONTRATO (
        type: textField
        label {
            label: Id Contrato
            alignment: left
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    branch (
        name: Impresion del Reporte
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                declare
                  l_proc varchar2(100) := 'show report';
                  l_report_url varchar2(32767 char) := W_BUSCA_PARAMETRO('BS','URL_REPORT');
                BEGIN
                  xlog (l_proc, 'url (orig):' || l_report_url);
                
                  xlib_jasperreports.set_report_url(l_report_url);
                  xlib_jasperreports.show_report (p_rep_name => apex_util.url_encode('LTCONTRA'),
                          p_rep_format          => apex_util.url_encode('pdf'),
                          p_data_source         => apex_util.url_encode('default'),
                          p_out_filename        => apex_util.url_encode(null),
                          p_rep_locale          => apex_util.url_encode('es_ES'),
                          p_rep_encoding        => apex_util.url_encode('UTF-8'),
                          p_additional_params   => ('P_ID_EMPRESA='||:P0_ID_EMPRESA||'&'||'P_ID_CONTRATO='||:P578_ID_CONTRATO),
                          p_print_is_enabled    => false,
                          p_print_printer_name  => apex_util.url_encode(null),
                          p_print_media         => apex_util.url_encode(null),
                          p_print_copies        => apex_util.url_encode(null),
                          p_print_duplex        => false,
                          p_print_collate       => false,
                          p_save_is_enabled     => false,
                          p_save_filename       => apex_util.url_encode(null),
                          p_rep_time_zone       => apex_util.url_encode(null),
                          p_print_job_name      => apex_util.url_encode(null)
                          );
                  -- this was used before apex 4.1
                  --apex_application.g_unrecoverable_error := true;
                  apex_application.stop_apex_engine();
                
                exception
                  when apex_application.e_stop_apex_engine then
                    null; -- ok, stop engine raises exception, we can ignore that
                  when others then 
                    xlog(l_proc, substr(dbms_utility.format_error_backtrace,1,3500), 'ERROR');
                    raise;
                end;   
                                                     
                ```
        }
    )

)

