        action set-activo (
            name: SET_ACTIVO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                           NVL(BG.SALDO,0) SALDO
                    
                    FROM COW_TMP_BALANCE_PROV BG
                    
                    WHERE BG.ID_EMPRESA       = :P0_ID_EMPRESA
                          AND BG.COD_EJERCICIO= :P0_COD_EJERCICIO
                          --AND BG.TIPO_CUENTA  = 'A' 
                          AND BG.COD_CUENTA  = '1'
                          --AND BG.SALDO IS NOT NULL
                          --AND (BG.COD_CUENTA   BETWEEN :P250_G_COD_CUENTA_INI AND :P250_G_COD_CUENTA_FIN  OR (:P250_G_COD_CUENTA_INI IS NULL OR :P250_G_COD_CUENTA_FIN IS NULL))
                          --AND (BG.COD_CENTRO   BETWEEN :P250_G_CENTRO_COSTO_INI AND :P250_G_CENTRO_COSTO_FIN OR (:P250_G_CENTRO_COSTO_INI IS NULL OR :P250_G_CENTRO_COSTO_FIN IS NULL))
                          AND BG.IP_MAQUINA   = :P250_IP_MAQUINA--(SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL) 
                          /*Bueno, qué pasa con este select... Esto permite comparar lo que se procesó por
                           la ip de la máquina, para ver con más detalle fijarse en el Procedimiento de 
                           base de datos COW_BALANCE_GENERAL_PROV*/
                          
                    ORDER BY /*D.FEC_ASIENTO ASC, */regexp_replace(
                          regexp_replace(
                            regexp_replace(
                              BG.COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                              ),
                            '(^|\.)(\d{2})','\1 0\2'
                          ),
                          '(^|\.)(\d)','\1 00\2'
                        )
                    ;
                    ```
                itemsToSubmit: [
                    P0_COD_EMPRESA
                    P0_COD_EJERCICIO
                    P250_G_COD_CUENTA_INI
                    P250_G_COD_CUENTA_FIN
                    P250_G_CENTRO_COSTO_INI
                    P250_G_CENTRO_COSTO_FIN
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P250_G_ACTIVO
            }
            execution {
                sequence: 140
            }
        )

