                    V_MENSAJE,V_NUM_ASIENTO_INI,V_NUM_ASIENTO_FIN);
                    :P250_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                    :P250_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
