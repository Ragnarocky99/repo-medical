    region mayor (
        name: Mayor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       CASE
                            WHEN C.ID IS NOT NULL THEN 'fa fa-search u-primary-text'
                       END ASIENTO_BUSCAR,
                       P.ID_EMPRESA,
                       C.FEC_ASIENTO,
                       C.NUM_ASIENTO,
                       C.DESCRIPCION AS DESC_ASIENTO,
                       P.COD_CUENTA,
                       P.NOMBRE_CUENTA,
                       SUM(NVL(D.MON_DEBE,0)) MON_DEBE,
                       SUM(NVL(D.MON_HABER,0)) MON_HABER,         
                        
                       --SA.SALDO_ANT,
                
                       /*SUM(CASE P.TIPO_CUENTA
                               WHEN 'A' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_debe,0)  -   NVL(D.mon_haber,0)
                               WHEN 'H' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_haber,0) -   NVL(D.mon_debe,0)
                               WHEN 'P' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_haber,0) -   NVL(D.mon_debe,0)
                               WHEN 'D' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_debe,0)  -   NVL(D.mon_haber,0)
                            END) SALDO_TIP_CUENTA,
                        
                        */
                       
                       trae_saldo_ant_co(EM.ID, P.COD_CUENTA, E.COD_EJERCICIO, D.ID, C.FEC_ASIENTO)SALDO_ANT, -- mod
                       trae_saldo_act_co(EM.ID, P.COD_CUENTA, E.COD_EJERCICIO, D.ID, C.FEC_ASIENTO)SALDO, -- mod
                       C.ID_SUCURSAL,
                       S.DESCRIPCION SUCURSAL_DESC,
                       P.TIPO_CUENTA
                
                
                       
                FROM   COW_DIARIO_DETALLES_PROV  D,
                       COW_DIARIO_CABECERAS_PROV C,
                       COW_PLAN_CUENTAS          P,
                       BSW_MONEDAS               M,
                       BSW_SUCURSALES            S,
                       COW_EJERCICIOS            E,
                       BSW_EMPRESAS              EM
                       
                       
                WHERE EM.ID = :P0_COD_EMPRESA
                  AND P.ID_EMPRESA = EM.ID
                  AND (C.FEC_ASIENTO BETWEEN :P250_MAYOR_FEC_INI AND :P250_MAYOR_FEC_FIN)
                  --AND (P.COD_CUENTA BETWEEN :P274_M_COD_CUENTA_INI AND :P274_M_COD_CUENTA_FIN OR (:P274_M_COD_CUENTA_INI IS NULL AND :P274_M_COD_CUENTA_FIN IS NULL))
                  --AND (P.COD_CUENTA    = :P250_MAYOR_COD_CUENTA_INI OR (:P250_MAYOR_COD_CUENTA_INI IS NULL))
                  AND P.COD_CUENTA    = :P250_MAYOR_COD_CUENTA_INI
                  AND (D.ID_SUCURSAL  = :P250_MAYOR_SUCURSAL OR :P250_MAYOR_SUCURSAL IS NULL)
                  AND E.COD_EJERCICIO = :P0_COD_EJERCICIO
                  AND D.ID_EJERCICIO  = E.ID
                  AND C.ID_EJERCICIO  = D.ID_EJERCICIO
                  AND C.NUM_ASIENTO   = D.NUM_ASIENTO
                  AND C.ID_SUCURSAL   = d.ID_SUCURSAL
                  AND P.ID_EMPRESA    = d.ID_EMPRESA
                  AND P.ID            = D.ID_PLAN_CUENTA
                  AND P.ID_MONEDA     = m.ID(+)
                  AND S.ID_EMPRESA    = c.ID_EMPRESA  
                  AND S.ID            = c.ID_SUCURSAL
                
                GROUP BY 
                       D.ID,
                       C.ID,
                       P.ID_EMPRESA,
                       C.FEC_ASIENTO,
                       C.NUM_ASIENTO,
                       C.DESCRIPCION,
                       E.COD_EJERCICIO,
                       P.COD_CUENTA,
                       P.NOMBRE_CUENTA,
                       --D.MON_DEBE,
                       --D.MON_HABER,
                       --SA.SALDO_ANT,
                       C.ID_SUCURSAL,
                       S.DESCRIPCION,
                       P.TIPO_CUENTA
                       
                       
                ORDER BY C.FEC_ASIENTO ASC
                
                ```
            pageItemsToSubmit: [
                P250_MAYOR_FEC_INI
                P250_MAYOR_FEC_FIN
                P250_MAYOR_COD_CUENTA_INI
                P250_MAYOR_SUCURSAL
                P250_MAYOR_DESC_CUENTA
                P0_COD_EMPRESA
                P0_COD_EJERCICIO
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
