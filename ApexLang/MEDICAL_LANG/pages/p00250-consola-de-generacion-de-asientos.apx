                    V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    begin
                    co_asiento_cobro_smg(:P0_ID_EMPRESA,NULL,NULL,NULL,:P250_FECHA_INICIAL,:P250_FECHA_FINAL,
                    V_MENSAJE,V_NUM_ASIENTO_INI,V_NUM_ASIENTO_FIN);
                    :P250_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                    :P250_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
                    :P250_ASIENTO_NRO_FIN:=V_NUM_ASIENTO_FIN;
                    EXCEPTION
                    WHEN OTHERS THEN
                    ROLLBACK;
                    :P250_MENSAJE_PROCEDIMIENTO:=SQLERRM;
                    end;
                    ```
