page 250 (
    name: Consola de Generacion de Asientos
    alias: CONSOLA-DE-GENERACION-DE-ASIENTOS
    title: Consola de Generacion de Asientos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function calcResultadoBalance() {
                var v_tot_activo, v_tot_pasivo, v_tot_pneto;
                var v_tot_haber, v_tot_debe;
                var v_resumen_tot_1, v_resumen_tot_2;
            
                v_tot_activo = 0;
                v_tot_pasivo = 0;
                v_tot_pneto = 0;
                v_tot_haber = 0;
                v_tot_debe = 0;
                v_resumen_tot_1 = 0;
                v_resumen_tot_2 = 0;
                
                //resultado 1
                v_tot_activo = parseFloat($v("P250_G_ACTIVO").replace(/\./g,''));
                
                v_tot_pasivo = parseFloat($v("P250_G_PASIVO").replace(/\./g,'')); 
            
                v_tot_pneto = parseFloat($v("P250_G_PATRIMONIO_NETO").replace(/\./g,'')); 
                
                v_resumen_tot_1 = ( v_tot_activo - v_tot_pasivo - v_tot_pneto);  
            
                //resultado 2
                v_tot_haber = parseFloat($v("P250_G_HABER").replace(/\./g,'')); 
            
                v_tot_debe = parseFloat($v("P250_G_DEBE").replace(/\./g,'')); 
            
                v_resumen_tot_2 = (v_tot_haber - v_tot_debe);
            
                //inserta resultados en items
                $s("P250_G_RESULTADO_UNO", parseInt(v_resumen_tot_1)||0);
                $s("P250_G_RESULTADO_DOS", parseInt(v_resumen_tot_2)||0);
            
            
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            //GENERACION DE BALANCE
            document.getElementById("P250_G_ACTIVO").readOnly = true;
            document.getElementById("P250_G_PASIVO").readOnly = true;
            document.getElementById("P250_G_PATRIMONIO_NETO").readOnly = true;
            document.getElementById("P250_G_DEBE").readOnly = true;
            document.getElementById("P250_G_HABER").readOnly = true;
            document.getElementById("P250_G_RESULTADO_UNO").readOnly = true;
            document.getElementById("P250_G_RESULTADO_DOS").readOnly = true;
            
            
            //MAYOR
            document.getElementById("P250_MAYOR_DESC_CUENTA").readOnly = true;
            document.getElementById("P250_SALDO_ANT").readOnly = true;
            ```
    }
