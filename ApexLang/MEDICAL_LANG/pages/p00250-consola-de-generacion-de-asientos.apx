    button b250-g-ejecutar (
        buttonName: B250_G_EJECUTAR
        label: Ejecutar
        layout {
            sequence: 20
            region: @filtros-2
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: Al procesar se utilizaba este botón para que ejecute los cambios dentro de la pantalla. Se desabilitó porque se logró que el boton procesar haga todo en uno.
        }
    )

