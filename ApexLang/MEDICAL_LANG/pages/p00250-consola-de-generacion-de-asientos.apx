    region asientos-con-diferencia (
        name: Asientos con Diferencia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  'IR_ASIENTO',
                       ID_EMPRESA,
                       ID_EJERCICIO,
                       FEC_ASIENTO,
                       NUM_ASIENTO,
                       DIFERENCIA,
                       ID
                       
                
                  from COWV_ASIENTOS_PROV_DIF
                 where ID_EMPRESA=:P0_ID_EMPRESA AND     
                (FEC_ASIENTO BETWEEN :P250_FECHA_INICIAL AND :P250_FECHA_FINAL)
                ```
            pageItemsToSubmit: [
                P250_FECHA_INICIAL
                P250_FECHA_FINAL
            ]
        }
        layout {
            sequence: 50
            parentRegion: @generación-de-asientos
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText:
                ```html
                <h5 style="text-align:center;color:#3f46bb">Asientos con Diferencia</h5>
                
                ```
