    dynamicAction calcular-asientos-pendientes (
        name: Calcular Asientos Pendientes
        execution {
            sequence: 180
        }
        when {
            selectionType: items
            items: [
                P250_FECHA_INICIAL
                P250_FECHA_FINAL
            ]
        }

        action calcular-asientos-pendientes-cobros (
            name: Calcular Asientos Pendientes Cobros
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select sum(a.contador) contador 
                        from 
                        (/*select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    ccw_recibos re,  
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where re.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                                and re.id_empresa = c.id_empresa
                                and re.id_mov_caj=c.id
                                and nvl( re.anulado, 'H') <> 'S'
                                and c.id_moneda = m.id
                                and c.asientos is null
                                and re.id_empresa  = s.id_empresa
                                and re.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona
                          union all*/
                             select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    vtw_comprobantes_cabecera vt, 
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where vt.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                                and vt.id_empresa = c.id_empresa
                                and vt.id_mov_caj = c.id
                                and vt.tip_comprobante in ('FVE','NCR')
                                and nvl( vt.estado, 'H') <> 'A'
                                and c.id_moneda = m.id
                                and c.asientos is null
                                and vt.id_empresa  = s.id_empresa
                                and vt.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona) a
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_COBRO
            }
            execution {
                sequence: 50
            }
        )

        action calcular-asientos-pendientes-compras (
            name: Calcular Asientos Pendientes Compras
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                      SELECT COUNT(*)
                        from cmw_compras_cabecera cc, 
                             bsw_tipos_comprobantes tc, 
                             bsw_sucursales su
                      where cc.ID_empresa = :P0_ID_EMPRESA
                                  and cc.fec_comprobante between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                                  and nvl( cc.estado, 'H' ) = 'C'
                                  and nvl( cc.tip_comprobante_ref, 'DFL' ) <> 'EMB'
                                  ----and ser_comprobante    <> bs_busca_parametro('CM','SERIE_FACTURA_IMP')
                                  and cc.ID_empresa     = tc.ID_empresa
                                  and cc.tip_comprobante = tc.tip_comprobante
                                --  and nvl( tc.stock, 'N' ) = 'S'
                                 -- and cc.cod_empresa = se.cod_empresa(+)
                                 -- and cc.ID_sector  = se.ID(+)
                                  and cc.asientos is null
                                  -----and ( cc.asientos IS NULL OR instr( cc.asientos,'*compras*', 1, 1 ) = 0 )
                                  and cc.ID_empresa  = su.ID_empresa
                                  and cc.ID_sucursal = su.ID
                    
                          
                    
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_COMPRAS_CM
            }
            execution {
                sequence: 40
            }
        )

        action calcular-asientos-pendientes-debcred (
            name: Calcular Asientos Pendientes DebCred
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                        select count(*)
                        from ccw_debcred_bancarios d
                        where d.id_empresa = :P0_ID_EMPRESA
                          --and d.fec_comprobante between :b_rvenci.fec_desde and :b_rvenci.fec_hasta
                          and /*decode(d.sub_tipo_trans,'105',trunc(d.fec_comprobante),'106',trunc(d.fec_comprobante),
                               '110',trunc(d.fec_comprobante),'107',trunc(d.fec_comprobante),trunc(d.fec_confirmacion))*/
                                d.fec_comprobante between :P250_FECHA_INICIAL 
                               and :P250_FECHA_FINAL
                          and d.asientos is null; 
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_DEBCRED
            }
            execution {
                sequence: 20
            }
        )

