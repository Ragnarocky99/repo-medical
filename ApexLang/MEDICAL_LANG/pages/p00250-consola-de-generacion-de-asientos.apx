        action calcular-asientos-pendientes-pagos (
            name: Calcular Asientos Pendientes Pagos
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                       select count(*)
                        from cpw_cabecera_cajas cc
                        where cc.id_empresa      = 121
                          and (CC.FEC_MOV_CAJ between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                          and nvl(cc.anulado,'N') <> 'S'
                       --   and nvl(cc.pagado, 'N') = 'S'
                          and asientos is null) or
                             (nvl(anulado,'N') = 'S'
                          and fec_anulacion between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                          and asientos not like('%anul%'));
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_PAGOS
            }
            execution {
                sequence: 10
            }
        )

        action calcular-asientos-pendientes-rh (
            name: Calcular Asientos Pendientes RH
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    /*select count(*)
                                from rhw_cabecera_liq cl, rhw_empleados e
                                where cl.id_empresa = :P0_ID_EMPRESA
                                and  cl.fec_liquid   between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                               -- and (cl.tip_liquid   =  p_tip_comprobante or p_tip_comprobante is null )
                               -- and (cl.ser_liquid   =  p_ser_comprobante or p_ser_comprobante is null )
                              --  and (cl.nro_liquid   =  p_nro_comprobante or p_nro_comprobante is null )
                                and cl.asientos      is null
                                and cl.id_empresa   = e.id_empresa
                                and cl.id_empleado  = e.id*/
                      SELECT count(*)
                        FROM BSW_EMPRESAS
                        ;
                               
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_RH
            }
            execution {
                sequence: 80
            }
        )

        action calcular-asientos-pendientes-stock (
            name: Calcular Asientos Pendientes Stock
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(a.contador) cantidad from 
                    (select count(*) contador
                    
                           from stw_entsal_cab cc,
                                stw_entsal_det cd,
                                cow_param_contables_st ps,
                                stw_articulos ar,
                                bsw_tipos_comprobantes tc,
                                bsw_sucursales su,
                                bsw_monedas    mn,
                                stw_motivo_ent_sal mo
                                
                          where  cc.ID_empresa   =      :P0_ID_EMPRESA
                           and  cc.fec_ent_sal  between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                    
                            ---and  nvl( cc.anulado, 'N') = 'N' REVISAR 
                            ---and  nvl(cc.tip_ent_sal,'ENT') = 'REM'
                            and cc.id_motivo_ent_sal = mo.id
                            and  nvl(cc.tip_ent_sal,'AJS') = 'AJS'
                            and mo.cod_motivo_ent_sal = w_busca_parametro('ST', 'COD_ENT_STOCK')
                            
                            and  cc.ID_empresa  = tc.ID_empresa
                            and  cc.tip_ent_sal = tc.tip_comprobante
                            and cc.id_moneda    = mn.id
                            and  cc.ID_empresa  = cd.ID_empresa
                            and  cc.ID_sucursal = cd.ID_sucursal
                            AND CC.ID=CD.ID_ENTSAL_CAB
                            and  nvl(ar.ind_maneja_stock,'S') = 'S'
                            and  cd.ID_empresa  = ar.ID_empresa
                            and  cd.ID_articulo = ar.ID
                            and (cc.asientos is null or instr(cc.asientos, '*stock*', 1,1) = 0)
                            and  cc.ID_empresa  = ps.ID_empresa
                            and  ar.id_familia  = ps.id_grupo
                            and  cc.ID_empresa  = su.ID_empresa
                            and  cc.ID_sucursal = su.ID
                            
                          group by cc.id,
                                cc.id_empresa,
                                cc.ID_sucursal,
                                su.cod_sucursal,
                                su.descripcion,
                                cc.fec_ent_sal,
                                cc.ID_proveedor,
                                ps.ID_cuenta_venta,
                                ps.ID_cuenta_costo,
                                ps.ID_cuenta_stock,
                                ps.ID_cuenta_venta_obs,
                                ps.ID_cuenta_costo_obs,
                                ps.ID_cuenta_stock_obs,
                                ps.ID_cuenta_fondo_obs,
                                nvl(ar.ind_maneja_stock,'S'),
                                cc.id_moneda,
                                mn.tipo_cambio,
                                cc.tip_referencia, 
                                cc.ser_referencia, 
                                cc.num_referencia,
                                cc.tip_ent_sal,
                                cc.ser_ent_sal,
                                cc.num_ent_sal
                    
                    union all
                    select  count(*) contador
                    
                    
                           from stw_entsal_cab         cc,
                                stw_entsal_det         cd,
                                cow_param_contables_st ps,
                                stw_articulos          ar,
                                bsw_tipos_comprobantes tc,
                                bsw_sucursales         su,
                                stw_motivo_ent_sal     mo,
                                bsw_monedas            mn
                          where  cc.id_empresa       = :P0_ID_EMPRESA
                            and (cc.fec_ent_sal      between :P250_FECHA_INICIAL and :P250_FECHA_FINAL)
                            and nvl( cc.estado, 'N') = 'N'
                            and cc.id_motivo_ent_sal = mo.id
                            and  nvl(cc.tip_ent_sal,'AJS') = 'AJS'
                            and mo.cod_motivo_ent_sal= w_busca_parametro('ST', 'COD_SAL_STOCK')
                            and cc.id_moneda   =  mn.id
                            and cc.id_empresa  = tc.id_empresa
                            and cc.tip_ent_sal = tc.tip_comprobante
                            ---and  nvl(tc.stock,'N')  = 'S'
                            and cc.id_empresa    = cd.id_empresa
                            and cc.id    = cd.id_entsal_cab
                            and nvl(ar.ind_maneja_stock,'S') = 'S'
                            and cd.id_empresa    = ar.id_empresa
                            and cd.id_articulo   = ar.id
                            and (cc.asientos is null or instr(cc.asientos, '*stock*', 1,1) = 0)
                            --PA and  cc.id_sucursal   = ps.cod_sucursal
                            and cc.id_empresa  = ps.id_empresa
                            and ar.id_familia    = ps.ID_grupo   --PA and  ar.cod_rubro      = ps.cod_grupo
                            and cc.id_sucursal = su.id) a
                           
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_STOCK
            }
            execution {
                sequence: 70
            }
        )

        action calcular-asientos-pendientes-ventas (
            name: Calcular Asientos Pendientes Ventas
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                      select count(*)
                        from vtw_comprobantes_cabecera
                        where id_empresa = :P0_COD_EMPRESA
                          and fec_comprobante between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                          and nvl(estado,'N') != 'A'
                          and asientos is null
                          and nvl(tot_comprobante,0) > 0--Agregue tot_comprobante porque en pfannl existen cabeceras sin detalle y este campo es cargado a traves del detalle --DN 22/01/2020
                    
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_VTA
            }
            execution {
                sequence: 60
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    V_HOLA VARCHAR2(200);
                    
                    
                    BEGIN
                    
                    IF TO_DATE(:P250_FECHA_INICIAL,'DD/MM/YYYY') NOT BETWEEN TO_DATE(:P0_FEC_INICIAL_EJERCICIO,'DD/MM/YYYY')
                     AND TO_DATE(:P0_FEC_FINAL_EJERCICIO,'DD/MM/YYYY') THEN
                    
                    
                    
                    RAISE_APPLICATION_ERROR(-20000,'Rango de fecha fuera del ejercicio actual');
                    
                    
                    
                    end if;
                    END;
                    ```
                itemsToSubmit: P250_FECHA_INICIAL
                itemsToReturn: P250_FECHA_INICIAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
        )

    )

