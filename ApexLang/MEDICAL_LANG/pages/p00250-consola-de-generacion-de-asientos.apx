    dynamicAction generar-asiento-depositos (
        name: GENERAR_ASIENTO_DEPOSITOS
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @depositos
        }

        action calcular-asientos-pendientes-debcred (
            name: Calcular Asientos Pendientes DebCred
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                        select count(*)
                        from ccw_mov_valores_cab d
                        where d.id_empresa = :P0_ID_EMPRESA
                          --and d.fec_comprobante between :b_rvenci.fec_desde and :b_rvenci.fec_hasta
                          and /*decode(d.sub_tipo_trans,'105',trunc(d.fec_comprobante),'106',trunc(d.fec_comprobante),
                               '110',trunc(d.fec_comprobante),'107',trunc(d.fec_comprobante),trunc(d.fec_confirmacion))*/
                                d.fec_comprobante between :P250_FECHA_INICIAL 
                               and :P250_FECHA_FINAL
                          and d.asientos is null; 
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_DEPOSITOS
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-alert (
            action: alert
            settings {
                title: Operación Concluida
                message:
                    ```html
                    &P250_MENSAJE_PROCEDIMIENTO.
                    
                    ```
                style: information
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                    V_MENSAJE VARCHAR(4000);
                    V_NUM_ASIENTO_INI NUMBER(10);
                    V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    begin
                    cow_asiento_deposito(:P0_ID_EMPRESA,'DEP',NULL,NULL,:P250_FECHA_INICIAL,:P250_FECHA_FINAL,
                                        V_MENSAJE,
                                        V_NUM_ASIENTO_INI,
                                        V_NUM_ASIENTO_FIN);
                                        
                    :P250_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                    :P250_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
                    :P250_ASIENTO_NRO_FIN:=V_NUM_ASIENTO_FIN;
                    EXCEPTION 
                    WHEN OTHERS THEN
                    ROLLBACK;
                    :P250_MENSAJE_PROCEDIMIENTO:=SQLERRM;
                    end;
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                itemsToReturn: [
                    P250_MENSAJE_PROCEDIMIENTO
                    P250_ASIENTO_NRO_INI
                    P250_ASIENTO_NRO_FIN
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: dualRing
                spinnerColor: #647edc
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction generar-asiento-stock (
        name: GENERAR_ASIENTO_STOCK
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @stock-2
        }

        action calcular-asientos-pendientes-stock (
            name: Calcular Asientos Pendientes Stock
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(a.contador) cantidad from 
                    (select count(*) contador
                    
                           from stw_entsal_cab cc,
                                stw_entsal_det cd,
                                cow_param_contables_st ps,
                                stw_articulos ar,
                                bsw_tipos_comprobantes tc,
                                bsw_sucursales su,
                                bsw_monedas    mn,
                                stw_motivo_ent_sal mo
                                
                          where  cc.ID_empresa   =      :P0_ID_EMPRESA
                           and  cc.fec_ent_sal  between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                    
                            ---and  nvl( cc.anulado, 'N') = 'N' REVISAR 
                            ---and  nvl(cc.tip_ent_sal,'ENT') = 'REM'
                            and cc.id_motivo_ent_sal = mo.id
                            and  nvl(cc.tip_ent_sal,'AJS') = 'AJS'
                            and mo.cod_motivo_ent_sal = w_busca_parametro('ST', 'COD_ENT_STOCK')
                            
                            and  cc.ID_empresa  = tc.ID_empresa
                            and  cc.tip_ent_sal = tc.tip_comprobante
                            and cc.id_moneda    = mn.id
                            and  cc.ID_empresa  = cd.ID_empresa
                            and  cc.ID_sucursal = cd.ID_sucursal
                            AND CC.ID=CD.ID_ENTSAL_CAB
                            and  nvl(ar.ind_maneja_stock,'S') = 'S'
                            and  cd.ID_empresa  = ar.ID_empresa
                            and  cd.ID_articulo = ar.ID
                            and (cc.asientos is null or instr(cc.asientos, '*stock*', 1,1) = 0)
                            and  cc.ID_empresa  = ps.ID_empresa
                            and  ar.id_familia  = ps.id_grupo
                            and  cc.ID_empresa  = su.ID_empresa
                            and  cc.ID_sucursal = su.ID
                            
                          group by cc.id,
                                cc.id_empresa,
                                cc.ID_sucursal,
                                su.cod_sucursal,
                                su.descripcion,
                                cc.fec_ent_sal,
                                cc.ID_proveedor,
                                ps.ID_cuenta_venta,
                                ps.ID_cuenta_costo,
                                ps.ID_cuenta_stock,
                                ps.ID_cuenta_venta_obs,
                                ps.ID_cuenta_costo_obs,
                                ps.ID_cuenta_stock_obs,
                                ps.ID_cuenta_fondo_obs,
                                nvl(ar.ind_maneja_stock,'S'),
                                cc.id_moneda,
                                mn.tipo_cambio,
                                cc.tip_referencia, 
                                cc.ser_referencia, 
                                cc.num_referencia,
                                cc.tip_ent_sal,
                                cc.ser_ent_sal,
                                cc.num_ent_sal
                    
                    union all
                    select  count(*) contador
                    
                    
                           from stw_entsal_cab         cc,
                                stw_entsal_det         cd,
                                cow_param_contables_st ps,
                                stw_articulos          ar,
                                bsw_tipos_comprobantes tc,
                                bsw_sucursales         su,
                                stw_motivo_ent_sal     mo,
                                bsw_monedas            mn
                          where  cc.id_empresa       = :P0_ID_EMPRESA
                            and (cc.fec_ent_sal      between :P250_FECHA_INICIAL and :P250_FECHA_FINAL)
                            and nvl( cc.estado, 'N') = 'N'
                            and cc.id_motivo_ent_sal = mo.id
                            and  nvl(cc.tip_ent_sal,'AJS') = 'AJS'
                            and mo.cod_motivo_ent_sal= w_busca_parametro('ST', 'COD_SAL_STOCK')
                            and cc.id_moneda   =  mn.id
                            and cc.id_empresa  = tc.id_empresa
                            and cc.tip_ent_sal = tc.tip_comprobante
                            ---and  nvl(tc.stock,'N')  = 'S'
                            and cc.id_empresa    = cd.id_empresa
                            and cc.id    = cd.id_entsal_cab
                            and nvl(ar.ind_maneja_stock,'S') = 'S'
                            and cd.id_empresa    = ar.id_empresa
                            and cd.id_articulo   = ar.id
                            and (cc.asientos is null or instr(cc.asientos, '*stock*', 1,1) = 0)
                            --PA and  cc.id_sucursal   = ps.cod_sucursal
                            and cc.id_empresa  = ps.id_empresa
                            and ar.id_familia    = ps.ID_grupo   --PA and  ar.cod_rubro      = ps.cod_grupo
                            and cc.id_sucursal = su.id) a
                           
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_STOCK
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action native-alert (
            action: alert
            settings {
                title: Operación Concluida
                message:
                    ```html
                    &P250_MENSAJE_PROCEDIMIENTO.
                    
                    ```
                style: information
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                    V_MENSAJE VARCHAR(4000);
                    V_NUM_ASIENTO_INI NUMBER(10);
                    V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    begin
                    cow_asiento_stock(:P0_ID_EMPRESA,NULL,NULL,NULL,:P250_FECHA_INICIAL,:P250_FECHA_FINAL,
                                        V_MENSAJE,
                                        V_NUM_ASIENTO_INI,
                                        V_NUM_ASIENTO_FIN);
                                        
                    :P250_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                    :P250_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
                    :P250_ASIENTO_NRO_FIN:=V_NUM_ASIENTO_FIN;
                    EXCEPTION 
                    WHEN OTHERS THEN 
                    :P250_MENSAJE_PROCEDIMIENTO:=SQLERRM;
                    ROLLBACK;
                    end;
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
                itemsToReturn: [
                    P250_MENSAJE_PROCEDIMIENTO
                    P250_ASIENTO_NRO_INI
                    P250_ASIENTO_NRO_FIN
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: dualRing
                spinnerColor: #647edc
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction generar-asientos-cobro (
        name: Generar Asientos Cobro
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @cuentasacobrar
        }

        action agregar-icono-de-carga (
            name: Agregar Icono de Carga
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: dualRing
                spinnerColor: #647edc
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-cobros (
            name: Calcular Asientos Pendientes Cobros
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select sum(a.contador) contador 
                        from 
                        (/*select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    ccw_recibos re,  
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where re.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                                and re.id_empresa = c.id_empresa
                                and re.id_mov_caj=c.id
                                and nvl( re.anulado, 'H') <> 'S'
                                and c.id_moneda = m.id
                                and c.asientos is null
                                and re.id_empresa  = s.id_empresa
                                and re.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona
                          union all*/
                             select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    vtw_comprobantes_cabecera vt, 
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where vt.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P250_FECHA_INICIAL and :P250_FECHA_FINAL
                                and vt.id_empresa = c.id_empresa
                                and vt.id_mov_caj = c.id
                                and vt.tip_comprobante in ('FVE','NCR')
                                and nvl( vt.estado, 'H') <> 'A'
                                and c.id_moneda = m.id
                                and c.asientos is null
                                and vt.id_empresa  = s.id_empresa
                                and vt.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona) a
                    ```
                itemsToSubmit: [
                    P250_FECHA_INICIAL
                    P250_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_CONT_COBRO
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action ejecutar-procedimiento-de-asiento (
            name: Ejecutar Procedimiento de Asiento
            action: executeServerSideCode
