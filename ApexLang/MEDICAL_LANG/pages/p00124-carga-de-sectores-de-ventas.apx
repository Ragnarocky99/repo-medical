page 124 (
    name: Carga de Sectores de Ventas
    alias: CARGA-DE-SECTORES-DE-VENTAS
    title: Carga de Sectores de Ventas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-sectores-de-ventas (
        name: Carga de Sectores de Ventas
        type: form
        source {
            location: localDatabase
            tableName: VTW_SECTOR_VENTAS
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 2
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P124_COD_SECTOR_VEN (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Sector Ventas:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-sectores-de-ventas
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: COD_SECTOR_VEN
            dataType: varchar2
        }
    )

    pageItem P124_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 30
            region: @carga-de-sectores-de-ventas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P124_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @carga-de-sectores-de-ventas
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P124_ESTADO (
        type: hidden
        layout {
            sequence: 80
            region: @carga-de-sectores-de-ventas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: ESTADO
            dataType: varchar2
        }
    )

    pageItem P124_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-sectores-de-ventas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: VTW_SECTOR_VENTAS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P124_ID_CENTRO_COSTO (
        type: popupLov
        label {
            label: <p>Centro de Costo:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-centro-costo
        }
        layout {
            sequence: 60
            region: @carga-de-sectores-de-ventas
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: ID_CENTRO_COSTO
            dataType: number
        }
    )

    pageItem P124_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-sectores-de-ventas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-sectores-de-ventas
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button centro-costo (
        buttonName: CENTRO_COSTO
        label: Centro Costo
        layout {
            sequence: 70
            region: @carga-de-sectores-de-ventas
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 82
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P124_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @centro-costo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P124_ID_CENTRO_COSTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 15527229017290539
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-sectores-de-ventas (
        name: Initialize form Carga de Sectores de Ventas
        type: formInitialization
        formRegion: @carga-de-sectores-de-ventas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15526460903290539
        }
    )

    process process-form-carga-de-sectores-de-ventas (
        name: Process form Carga de Sectores de Ventas
        type: formAutoRowProcessing
        formRegion: @carga-de-sectores-de-ventas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15526810915290539
        }
    )

)

