page 348 (
    name: Carga de Debitos y Creditos a Empleados
    alias: CARGA-DE-DEBITOS-Y-CREDITOS-A-EMPLEADOS
    title: Carga de Debitos y Creditos a Empleados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads: document.getElementById("P348_TIPO").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-debitos-y-creditos-a-empleados (
        name: Carga de Debitos y Creditos a Empleados
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_CONCEPTO,
                       SER_DEBCRED,
                       NRO_DEBCRED,
                       FEC_DEBCRED,
                       ID_EMPLEADO,
                       TIPO,
                       MONTO,
                       CANTIDAD,
                       SER_LIQUID_AFECTO,
                       NRO_LIQUID_AFECTO,
                       UNIDAD,
                       ANIO,
                       MES,
                       FRECUENCIA_LIQUID,
                       COD_USUARIO_AUD,
                       SUELDO_FINAL,
                       TIP_LIQUID,
                       OBSERVACION,
                       ORIGEN,
                       ID_USUARIO_CARGA,
                       FEC_CARGA,
                       ID_USUARIO_MODIF,
                       FEC_ULTIMA_MODIF,
                       ID_SUCURSAL,
                       ESTADO,
                       DIRECCION_IP, --SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL
                       COEFICIENTE,
                       ID_EMPLEADO AS ID_EMPLEADO_2
                  from RHW_DEBCRED
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region datos-de-carga (
        name: Datos de Carga
        type: staticContent
        layout {
            sequence: 300
            parentRegion: @carga-de-debitos-y-creditos-a-empleados
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P348_ID
        }
    )

