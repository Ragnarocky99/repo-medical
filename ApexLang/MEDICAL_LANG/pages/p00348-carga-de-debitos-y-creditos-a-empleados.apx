    dynamicAction calculo-hora-extra (
        name: Calculo Hora Extra
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P348_CANTIDAD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    sueldoh number(18);
                    vcoef number(18,3); --COEFICIENTE DE CONCEPTO
                    sueldo_hora number(18);
                    vtotal number(18);
                    vhora_extra_130 VARCHAR2(50)  := W_BUSCA_PARAMETRO ('RH', 'RH_HORA_EXTRA_130');
                    vhora_extra_100 VARCHAR2(50)  := W_BUSCA_PARAMETRO ('RH', 'RH_HORA_EXTRA_100');
                    vhora_extra_50 VARCHAR2(50)  := W_BUSCA_PARAMETRO ('RH', 'RH_HORA_EXTRA_50');
                    vhora_extra_30 VARCHAR2(50)  := W_BUSCA_PARAMETRO ('RH', 'RH_HORA_EXTRA_30');
                    vhora_extra_260 VARCHAR2(50)  := W_BUSCA_PARAMETRO ('RH', 'RH_HORA_EXTRA_260');
                    begin
                    IF TO_CHAR(:P348_ID_CONCEPTO) in (vhora_extra_130, vhora_extra_100, vhora_extra_50, 
                        vhora_extra_30, vhora_extra_260) THEN
                        begin
                            SELECT E.SUELDO_BASE 
                            INTO SUELDOH
                            FROM RHW_EMPLEADOS E
                            WHERE E.ID_EMPRESA = :P0_ID_EMPRESA
                              AND E.ID = :P348_ID_EMPLEADO;
                        end;
                                BEGIN
                                    SELECT C.COEFICIENTE
                                    INTO vcoef 
                                    From rhw_conceptos C
                                        WHERE C.ID_EMPRESA = :P348_ID_EMPRESA
                                        AND C.ID = :P348_ID_CONCEPTO;
                                END;
                                begin
                                   sueldo_hora := round((sueldoh / 30) / 8, 3);
                                      -- RAISE_APPLICATION_ERROR(-20000, 'OLA ' || sueldo_hora);
                                   vtotal := (sueldo_hora * vcoef) * :P348_CANTIDAD;
                                   :P348_MONTO := replace(VTOTAL, '.', '');
                                end;
                            END IF;
                    end;
                    ```
                itemsToSubmit: [
                    P348_CANTIDAD
                    P348_ID_CONCEPTO
                    P348_ID_EMPRESA
                    P348_ID_EMPLEADO
                    P348_MONTO
                ]
                itemsToReturn: P348_MONTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

