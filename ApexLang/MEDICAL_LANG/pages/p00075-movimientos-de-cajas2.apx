    dynamicAction subtipo-trans (
        name: SUBTIPO_TRANS
        execution {
            sequence: 160
        }
        when {
            selectionType: columns
            interactiveGrid: @formas-cobro
            columns: ID_SUB_TIPO_TRANS
        }
        comments {
            comments: "Carga el tipo de documento al cargarse un sub tipo de transacción "
        }

        action cuenta-dftl (
            name: Cuenta DFTL
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      V_IND_POS VARCHAR2(1);
                    
                    BEGIN
                      BEGIN
                        SELECT NVL(IND_POS, 'N')
                          INTO V_IND_POS
                          FROM BSW_SUBTIPOS_TRANS
                         WHERE ID = :ID_SUB_TIPO_TRANS;
                      EXCEPTION
                        WHEN OTHERS THEN
                          V_IND_POS := 'N';
                      END;
                    
                      BEGIN
                        IF V_IND_POS = 'S' THEN
                          SELECT ID_PER_JURIDICA,ID
                            INTO :ID_PER_JURIDICA,:NRO_CUENTA
                            FROM CCW_CUENTAS_BANCARIAS C
                           WHERE NRO_CUENTA =
                                 W_BUSCA_PARAMETRO('CC', 'NRO_CUENTA_BANCARIA_POS')
                             AND ID_EMPRESA=:P0_ID_EMPRESA;
                        END IF;
                      EXCEPTION
                        WHEN OTHERS THEN
                          RAISE_APPLICATION_ERROR(-20000,
                                                  'No se encontro la cuenta utilizada para el POS');
                      END;
                    
                    END;
                    
                    ```
                itemsToSubmit: ID_SUB_TIPO_TRANS
                itemsToReturn: [
                    ID_PER_JURIDICA
                    NRO_CUENTA
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: columns
                columns: FEC_VENCIMIENTO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_DOCUMENTO
                value: &P75_EFECTIVO_COBRO.
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: columns
                columns: FEC_VENCIMIENTO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn!=value
                column: TIP_DOCUMENTO
                value: &P75_EFECTIVO_COBRO.
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_tipo_documento  BSW_SUBTIPOS_TRANS.TIP_DOCUMENTO%TYPE;
                    begin
                    SELECT tip_documento
                    into v_tipo_documento
                    from bsw_subtipos_trans 
                    where id=:id_sub_tipo_trans;
                    return v_tipo_documento;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RETURN NULL;
                    WHEN OTHERS THEN
                    RETURN NULL;
                    end;
                    ```
                itemsToSubmit: ID_SUB_TIPO_TRANS
            }
            affectedElements {
                selectionType: columns
                columns: TIP_DOCUMENTO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

