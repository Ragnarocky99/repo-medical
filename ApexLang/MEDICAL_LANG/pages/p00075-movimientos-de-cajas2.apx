    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 210
        }
        when {
            event: click
            selectionType: items
            items: P75_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P75_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P75_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P75_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P75_URL
                    P75_ASIENTOS_ID
                ]
                itemsToReturn: P75_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P75_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction boton-pos (
        name: Boton POS
        execution {
            sequence: 220
        }
        when {
            event: click
            selectionType: button
            button: @llamarpos
        }

        action native-confirm (
            action: confirm
            settings {
                title: POS
                message:
                    ```html
                    Desea llamar al POS
                    
                    ```
                style: information
                confirmLabel: Si
                cancelLabel: No
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P75_BANDERA_POS
                value: S
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_MONTO CONSTANT VARCHAR2(255) := 'MONTO_POS';
                    BEGIN
                    :P75_MENSAJE_POS:=NULL;
                      IF :P75_ID_SUB_TIPO_TRANS IS NULL OR :P75_ID_SUB_TIPO_TRANS = '' THEN
                        RAISE_APPLICATION_ERROR(-20000, 'Eliga una forma de cobro');
                      END IF;
                    
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_MONTO) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_MONTO);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_MONTO);
                    
                      APEX_COLLECTION.ADD_MEMBER(p_collection_name => TMP_MONTO,
                                                 p_c001            => REPLACE(:P75_MONTO_POS,
                                                                              '.',
                                                                              ''));
                      -- Se realiza un APEX COLLECTIONS para guardar el monto ya que para poder enviar los datos al Modal de cuando
                      -- La forma de pago es en tarjeta de credito 
                    
                      IF :P75_ID_HABILITACION IS NOT NULL THEN
                        BEGIN
                          SELECT NVL(IND_POS, 'N'), NVL(IND_ES_TARJETA_CREDITO, 'N')
                            INTO :P75_BANDERA_POS, :P75_IND_ES_TARJETA_CREDITO
                            FROM BSW_SUBTIPOS_TRANS
                           WHERE ID = :P75_ID_SUB_TIPO_TRANS;
                        
                        EXCEPTION
                          WHEN OTHERS THEN
                            APEX_UTIL.SET_SESSION_STATE('P75_BANDERA_POS', 'N');
                        END;
                       -- Si tiene habilitado POS se revisa si es tarjeta de credito para preguntar si quiere pagar en cuotas 
                       --o en un solo Pago
                        BEGIN
                          IF :P75_BANDERA_POS = 'S' THEN
                            SELECT NVL(IND_ES_TARJETA_CREDITO, 'N'),NVL(IND_BILLETERA,'N')
                              INTO :P75_IND_ES_TARJETA_CREDITO,:P75_IND_BILLETERA
                              FROM BSW_SUBTIPOS_TRANS
                             WHERE ID = :P75_ID_SUB_TIPO_TRANS;
                          END IF;
                        EXCEPTION
                          WHEN OTHERS THEN
                            :P75_IND_ES_TARJETA_CREDITO := 'N';
                        END;
                      
                      ELSE
                        APEX_UTIL.SET_SESSION_STATE('P75_BANDERA_POS', 'N');
                      END IF;
                    
                      IF :P75_BANDERA_POS = 'N' OR :P75_BANDERA_POS IS NULL THEN
                        RAISE_APPLICATION_ERROR(-20000,
                                                'Este sub tipo de transaccion no esta habilitado para POS');
                      END IF;
                    
                      DBMS_LOCK.SLEEP(0.5);
                    EXCEPTION
                      WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000, sqlerrm);
                    END;
                    
                    ```
                itemsToSubmit: [
                    P75_ID_SUB_TIPO_TRANS
                    P75_ID_HABILITACION
                    P75_MONTO_POS
                ]
                itemsToReturn: [
                    P75_BANDERA_POS
                    P75_IND_ES_TARJETA_CREDITO
                    P75_IND_BILLETERA
                    P75_MENSAJE_POS
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      V_NRO_BOLETA    VARCHAR2(12);
                      V_MENSAJE       VARCHAR2(200);
                      V_SUBTIPO_TRANS VARCHAR2(30);
                      V_VUELTO        NUMBER(12);
                      V_NRO_MOV_CAJ   NUMBER(8);
                    BEGIN
                      BEGIN
                        SELECT SUBTIPO_TRANS
                          INTO V_SUBTIPO_TRANS
                          FROM BSW_SUBTIPOS_TRANS
                         WHERE ID = :P75_ID_SUB_TIPO_TRANS;
                      EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                          NULL;
                        WHEN OTHERS THEN
                          NULL;
                      END;
                    
                      BEGIN
                        SELECT MAX(NRO_MOV_CAJ) + 1
                          INTO V_NRO_MOV_CAJ
                          FROM CCW_MOVIMIENTOS_CAJAS
                         WHERE ID_EMPRESA = :P0_ID_EMPRESA
                           AND ID_SUCURSAL = :P0_ID_SUCURSAL;
                           EXCEPTION
                           WHEN OTHERS THEN
                           RAISE_APPLICATION_ERROR(-20000,'Error al traer el numero de caja');
                      END;
                    
                      IF TO_NUMBER(REPLACE(:P75_MONTO_POS,'.','')) <0 THEN
                      RAISE_APPLICATION_ERROR(-20000,'Monto Invalido');
                      END IF;
                    
                    
                      IF :P75_BANDERA_POS = 'S' AND
                         V_SUBTIPO_TRANS = W_BUSCA_PARAMETRO('CC', 'COD_PAGO_QR') THEN
                        VENTA_QR_POS(NVL(:P75_NRO_MOV_CAJ, V_NRO_MOV_CAJ),
                                     REPLACE(:P75_MONTO_POS, '.', ''),
                                     :P75_IP_POS,
                                     V_NRO_BOLETA,
                                     V_MENSAJE);
                        :P75_NRO_BOLETA := V_NRO_BOLETA;
                        :P75_MENSAJE_POS:=V_MENSAJE;
                      ELSIF :P75_BANDERA_POS = 'S'  AND 
                       V_SUBTIPO_TRANS <> W_BUSCA_PARAMETRO('CC','COD_PAGO_QR') THEN
                        VENTA_CONTADO_POS(NVL(:P75_NRO_MOV_CAJ, V_NRO_MOV_CAJ),
                                          REPLACE(:P75_MONTO_POS, '.', ''),
                                          :P75_IP_POS,
                                          V_NRO_BOLETA,
                                          V_MENSAJE,
                                          V_VUELTO);
                        :P75_NRO_BOLETA := V_NRO_BOLETA;
                        :P75_VUELTO_POS := V_VUELTO*-1;
                        :P75_MENSAJE_POS:=V_MENSAJE;
                    
                      END IF;
                      
                    
                    
                    :P75_VUELTO_POS:=V_VUELTO*-1;
                    :P75_MONTO_POS:=REPLACE(:P75_MONTO_POS,'.','')+ABS(V_VUELTO);
                    :P75_BANDERA_POS:='N';
                      :P75_ID_SUB_TIPO_TRANS := NULL;
                      :P75_IND_ES_TARJETA_CREDITO:='N';
                    EXCEPTION WHEN OTHERS THEN
                    :P75_MENSAJE_POS:=SQLERRM;
                    
                    END;
                    
                    ```
                itemsToSubmit: [
                    P75_BANDERA_POS
                    P75_MONTO_POS
                    P75_NRO_MOV_CAJ
                    P75_IP_POS
                    P75_ID_SUB_TIPO_TRANS
                ]
                itemsToReturn: [
                    P75_NRO_BOLETA
                    P75_BANDERA_POS
                    P75_ID_SUB_TIPO_TRANS
                    P75_VUELTO_POS
                    P75_IND_ES_TARJETA_CREDITO
                    P75_MONTO_POS
                    P75_MENSAJE_POS
                ]
                showProcessing: true
            }
            execution {
                sequence: 70
                fireOnInit: false
                stopExecutionOnError: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try{
                    var $widget = apex.region("FORMAS_COBRO").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var grid2$ = apex.region( "FORMAS_COBRO" ).call( "getCurrentView" ).view$;
                    var $model = $grid.model;
                    var monto_pos;
                    var id_sub_tipo_trans;
                    
                    id_sub_tipo_trans=$model.getRecordValue(filaActual[0][0],"ID_SUB_TIPO_TRANS");
                    monto_pos=$model.getRecordValue(filaActual[0][0],"IMPORTECAMBIO");
                    
                    $s('P75_ID_SUB_TIPO_TRANS',id_sub_tipo_trans.v);
                    $s('P75_MONTO_POS',monto_pos);
                    
                    }catch(e){
                     
                    }
                    ```
            }
