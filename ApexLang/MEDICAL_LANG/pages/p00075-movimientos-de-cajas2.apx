    region formas-cobro (
        name: Formas_Cobro
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ID_MOV_CAJ,
                       NRO_SECUENCIA,
                       ID_TRANS,
                       ID_SUB_TIPO_TRANS,
                       ID_PER_JURIDICA,
                       NRO_VALOR,
                       ID_MONEDA_COBRO,
                       TIP_CAMBIO,
                       MONTO,
                       FEC_EMISION,
                       FEC_VENCIMIENTO,
                       ID_USUARIO,
                       NRO_VALE,
                       COD_USUARIO_AUD,
                       IMPORTECAMBIO,
                       ESVUELTO,
                       ID_CUENTA_BANCARIA,
                       TIP_DOCUMENTO,
                       ID_CUENTA_CONTABLE,
                       ID_CUENTA,
                       FECHA_ALTA,
                       ID_USUARIO_ALTA,
                       ID_CLIENTE,
                       ID_CORPORACION,
                       ID_AUTORIZACION,
                       TRANSAC_PRONET,
                       NRO_TARJETA,
                       ID_TRANS_CLIE,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       NRO_CUENTA,
                       'BANDERA_POS' AS "BANDERA_POS"
                  from CCW_FORMAS_COBROS
                 where ID_MOV_CAJ=:P75_ID
                ```
        }
        layout {
            sequence: 40
            parentRegion: @master
            slot: subRegions
        }
        appearance {
            template: @content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-ContentBlock--shadowBG
                t-Region--removeHeader js-removeLandmark
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: FORMAS_COBRO
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calcularTotalesCobros();
                            };   
                    
                        } ;      
                        return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 95231015388477826
        }

