    validation poner-cta-recaudacion (
        name: Poner cta. recaudacion
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @formas-cobro
            type: columnIsNotNull
            column: NRO_CUENTA
        }
        error {
            errorMessage: Esta transacción requiere la cuenta recaudaciones a depositar
            associatedColumn: NRO_CUENTA
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                    if :ID_SUB_TIPO_TRANS in (538, 577, 539) then
                        return true;
                    end if;
                
                    return false;    
                end;
                ```
        }
        comments {
