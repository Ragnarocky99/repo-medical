    dynamicAction cambiar-montos-cobros (
        name: Cambiar Montos Cobros
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @formas-cobro
            columns: MONTO
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: MONTO
        }
        comments {
            comments: Cambio los montos en el detalle de forma_cobors
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF (TO_NUMBER(REPLACE(:MONTO,'.',''))*NVL(:TIP_CAMBIO,1)>=TO_NUMBER(REPLACE(:P75_TOT_NRO_MOV_CAJ,'.',''))) THEN
                    :MONTO:=ROUND(replace(:P75_TOT_NRO_MOV_CAJ,'.','')/NVL(:TIP_CAMBIO,1),NVL(:DECIMALES,0));
                    END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al calcular los montos'||sqlerrm);
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    TIP_CAMBIO
                    MONTO
                    P75_TOT_NRO_MOV_CAJ
                    DECIMALES
                ]
                itemsToReturn: MONTO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_DOCUMENTO
                value: &P75_EFECTIVO_COBRO.
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF (ROUND(TO_NUMBER(REPLACE(:MONTO,'.',''))*NVL(:TIP_CAMBIO,1))>=TO_NUMBER(REPLACE(:P75_TOT_NRO_MOV_CAJ,'.',''))) THEN
                    :IMPORTECAMBIO:=replace(:P75_NRO_MOV_CAJ,'.','');
                    ELSE
                    :IMPORTECAMBIO:=REPLACE(:MONTO,'.','')*NVL(:TIP_CAMBIO,1);
                    END IF;
                    EXCEPTION
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al calcular los montos'||sqlerrm);
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    TIP_CAMBIO
                    MONTO
                    P75_TOT_NRO_MOV_CAJ
                    DECIMALES
                ]
                itemsToReturn: IMPORTECAMBIO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: calcularTotalesCobros();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: replace(:monto,'.','')*nvl(:tip_cambio,1)
                itemsToSubmit: [
                    MONTO
                    TIP_CAMBIO
                ]
            }
            affectedElements {
                selectionType: columns
                columns: IMPORTECAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_monto ccw_formas_cobros.monto%type:=0;
                    begin
                    if  round(replace(:monto,'.','')*nvl(:tip_cambio,1))>=replace(:P75_TOT_NRO_MOV_CAJ,'.','') then
                     v_monto:=replace(:P75_TOT_NRO_MOV_CAJ,'.','');
                     return v_monto;
                    else
                    v_monto:=replace(:monto,'.','')*nvl(:tip_cambio,1);
                    return v_monto;
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    MONTO
                    TIP_CAMBIO
                    P75_TOT_NRO_MOV_CAJ
                ]
            }
            affectedElements {
                selectionType: columns
                columns: IMPORTECAMBIO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_DOCUMENTO
                value: &P75_EFECTIVO_COBRO.
            }
        )

    )

