    dynamicAction cerrar-ventana-tc-billetera (
        name: Cerrar Ventana TC/Billetera
        execution {
            sequence: 240
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @llamarpos
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    nombre varchar2(30):='BOLETA_POS';
                    V_NRO_BOLETA  VARCHAR2(13);
                    V_ERROR EXCEPTION;
                    BEGIN
                    Select c001
                    into V_NRO_BOLETA
                    From APEX_COLLECTIONS
                    Where COLLECTION_NAME = 'BOLETA_POS'
                    AND SEQ_ID = 1;
                    
                    :P75_NRO_BOLETA:=V_NRO_BOLETA;
                    
                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => 'BOLETA_POS');
                    
                    
                    EXCEPTION 
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de la boleta 1');
                    END;
                    ```
                itemsToReturn: P75_NRO_BOLETA
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try{
                    var $widget = apex.region("FORMAS_COBRO").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var grid2$ = apex.region( "FORMAS_COBRO" ).call( "getCurrentView" ).view$;
                    var $model = $grid.model;
                    
                    console.log('Despues de insertar');
                    $model.setValue(filaActual[0],"NRO_VALOR",$v('P75_NRO_BOLETA'));
                    }catch(e){
                    apex.message.alert('Error al cargar el numero de boleta 2');
                    }
                    ```
            }
