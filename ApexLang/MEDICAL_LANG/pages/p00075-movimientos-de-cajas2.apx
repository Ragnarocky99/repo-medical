        action native-javascript-code-3 (
            action: executeJsCode
            settings {
                jsCode: console.log('hola?');
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TIP_COMPROBANTE
