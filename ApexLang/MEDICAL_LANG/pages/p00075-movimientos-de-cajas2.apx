            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: calcularTotales();
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

