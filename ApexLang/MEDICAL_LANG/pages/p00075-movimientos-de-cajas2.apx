    process formas-cobro-save-interactive-grid-data (
        name: Formas_Cobro - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @formas-cobro
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                
                                    IF :TIP_DOCUMENTO=W_BUSCA_PARAMETRO('CC','TIP_DOCUMENTO_CHE') THEN
                               IF to_date(:FEC_VENCIMIENTO,'dd/mm/yyyy')<to_date(:FEC_EMISION,'dd/mm/yyyy') THEN 
                             ---  IF :FEC_VENCIMIENTO<:FEC_EMISION THEN 
                               RAISE_APPLICATION_ERROR(-20000,'La fecha de vencimiento no puede ser menor a la fecha de emision');
                               end if;
                               end if;
                
                             
                             INSERT INTO CCW_FORMAS_COBROS
                             (ID,ID_MOV_CAJ,ID_EMPRESA,ID_SUCURSAL,ID_MONEDA_COBRO,TIP_CAMBIO,MONTO,IMPORTECAMBIO
                             ,ID_CLIENTE,ID_TRANS,ID_SUB_TIPO_TRANS,FEC_EMISION,FEC_VENCIMIENTO,ID_PER_JURIDICA,
                             NRO_VALOR,FECHA_ALTA,TIP_DOCUMENTO,NRO_CUENTA,ID_CUENTA_BANCARIA)
                             VALUES (:ID,:P75_ID,:P0_COD_EMPRESA,:P0_COD_SUCURSAL,:ID_MONEDA_COBRO,:TIP_CAMBIO,
                              REPLACE(:MONTO,'.',''),
                             REPLACE(:IMPORTECAMBIO,'.',''),:P75_ID_CLIENTE,:ID_TRANS,:ID_SUB_TIPO_TRANS
                             ,:FEC_EMISION,:FEC_VENCIMIENTO,:ID_PER_JURIDICA,:NRO_VALOR,SYSDATE,:TIP_DOCUMENTO,:NRO_CUENTA,
                             :ID_CUENTA_BANCARIA);
                
                              
                
                        
                            WHEN 'U' then  
                         
                              UPDATE CCW_FORMAS_COBROS
                              SET ID_MONEDA_COBRO=:ID_MONEDA_COBRO,
                              TIP_CAMBIO=:TIP_CAMBIO,
                              MONTO=REPLACE(:MONTO,'.',''),
                              IMPORTECAMBIO=REPLACE(:IMPORTECAMBIO,'.',''),
                              ID_CLIENTE=:P75_ID_CLIENTE,
                              ID_TRANS=:ID_TRANS ,
                              ID_SUB_TIPO_TRANS=:ID_SUB_TIPO_TRANS, 
                              FEC_EMISION=:FEC_EMISION,
                              FEC_VENCIMIENTO=:FEC_VENCIMIENTO,
                              ID_PER_JURIDICA=:ID_PER_JURIDICA,
                              NRO_VALOR=:NRO_VALOR,
                              NRO_CUENTA=:NRO_CUENTA,
                              TIP_DOCUMENTO=:TIP_DOCUMENTO
                              WHERE ID=:ID  AND 
                              ID_MOV_CAJ=:P75_ID; 
                              
                             
                
                           when 'D' then
                           DELETE CCW_FORMAS_COBROS 
                           WHERE ID=:ID  AND 
                           ID_MOV_CAJ=:P75_ID;
                              
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 51430322433118362
        }
    )

    process impresion-comprobante (
        name: IMPRESION COMPROBANTE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                v_id_serie_comp number(10);
                v_autoimpresion varchar2(1);
                v_autoimpresion_ticket varchar2(1);
                
                begin
                
                 select C.ID_SERIE_COMP
                 into v_id_serie_comp
                 from vtw_comprobantes_cabecera C
                 where id = :P75_ID_COMPROBANTE;
                
                  select t.ind_auto_impresion, t.ind_auto_impresion_ticket
                    into v_autoimpresion, v_autoimpresion_ticket
                    from BSW_SERIES_COMPROB t
                    where ID = v_id_serie_comp;
                
                  if v_autoimpresion = 'S' then
                    APEX_UTIL.SET_SESSION_STATE('P_ID_COMPROBANTE_75',:P75_ID_COMPROBANTE);
                  elsif v_autoimpresion_ticket = 'S' then
                    APEX_UTIL.SET_SESSION_STATE('P_ID_COMPROBANTE_75',:P75_ID_COMPROBANTE);
                  else
                  APEX_UTIL.SET_SESSION_STATE('P_ID_COMPROBANTE_75',NULL);
                  end if;
                
                
                
                
                 EXCEPTION 
                  WHEN OTHERS THEN
                   APEX_UTIL.SET_SESSION_STATE('P_ID_COMPROBANTE_75',NULL);
                end;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 51449306805118371
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

