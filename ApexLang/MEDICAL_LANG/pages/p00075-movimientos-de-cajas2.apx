    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var filaActual = [];
            var procesando= 0 ;
            
            //La funcion se encarga de calcular el monto restante a pagar cada vez que se añade una forma de cobro y dependiendo de la forma 
            // de cobro realiza diferentes calculos
            function recalculaImporte(nuevoRecord) {
                var model = apex.region("Comprobantes").widget().interactiveGrid("getViews", "grid").model //Se  llama a la grilla de comprobantes;
                var model2 = apex.region("FORMAS_COBRO").widget().interactiveGrid("getViews", "grid").model; //Se llama a la grilla de cobors
                var model3 = apex.region("FORMAS_COBRO").widget().interactiveGrid("getCurrentView").model;
                var efectivo_cobro = $v("P75_EFECTIVO_COBRO");
                var v_tipo_notacre = $v("P75_TIP_NOTACRE");
            
            
            
                var total_comprobantes = 0;
                var total_cobros = 0;
                var total_a_pagar = 0;
                var v_importe = model3.getFieldKey("IMPORTECAMBIO");
                var v_importe_comprobantes = model.getFieldKey("IMPORTECAMBIO");
                var v_tip_comprobantes = model.getFieldKey('TIP_COMPROBANTE');
                var v_tip_documento = model2.getFieldKey('TIP_DOCUMENTO');
                var bandera = 0; //Bandera para saber si esta realizando un cobro que no sea efectivo;
                var bandera_notacre = 0; //Bandera para saber si es una nota de credito
            
                //Realizo un bucle para sumar los totales de los comprobantes
                model.forEach(function(r, index, id) { //Bucle para recorrer la grilla de comprobantes
            
            
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)) {
            
                        if (r[v_tip_comprobantes] == v_tipo_notacre) {
                            bandera_notacre = 1;
                        }
            
            
                        total_comprobantes = total_comprobantes + parseFloat(r[v_importe_comprobantes].replace(/\./g, '')); //Se obtiene el total de los comprobantes
            
            
                    }
            
                });
            
            
            
            
                //Realizo un bucle para sumar los totales de las formas de cobro
                model2.forEach(function(r, index, id) {
            
            
                    var meta = model2.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)) {
            
                        console.log(r[v_importe]);
            
            
                        let parse = parseFloat(r[v_importe].replace(/\./g, ''));
            
                        if (Number.isNaN(parse)) {
                            parse = 0;
                        }
            
                        if (r[v_tip_documento] != efectivo_cobro) {
                            bandera = 1;
                        }
            
            
                        total_cobros = total_cobros + parse;
            
            
            
                    }
            
                });
            
            
            
                //   console.log('Cobros es :'+total_cobros);
                //     console.log('Comprobantes es:'+total_comprobantes);
            
            
                var tot_mov_caj = $v('P75_TOT_NRO_MOV_CAJ');
            
                tot_mov_caj = parseFloat(tot_mov_caj.replace(/\./g, ''));
            
                //console.log("Resta es "+(tot_mov_caj-total_cobros));
            
                total_a_pagar = tot_mov_caj - total_cobros;
                if (bandera_notacre == 1) {
                    total_a_pagar = tot_mov_caj;
                    $s("P75_TOTAL_A_COBRAR", total_a_pagar);
                    return;
                }
            
                //Cuando el total de cobros supera el total de comprobantes y la forma de pagar sea efectivo entonces ya no realiza mas calculos 
                if (total_cobros >= tot_mov_caj && bandera == 0) {
                    total_a_pagar = 0;
                    $s("P75_TOTAL_A_COBRAR", total_a_pagar) //Guardo el total en un item de la pagina;
                } else {
                    $s("P75_TOTAL_A_COBRAR", total_a_pagar);
                }
            
            
            
            
            }
            // Calcula el total de los comprobantes a pagar 
            function calcularTotales() {
                // llamo a la region de detalle donde se encuentra los comprobantes
                var model = apex.region("Comprobantes").widget().interactiveGrid("getViews", "grid").model;
                // Obtengo los indices de los datos que voy a necesitar y inicializo las variables de totales
                var v_importe = model.getFieldKey("IMPORTECAMBIO");
                var v_total = 0;
            
                //Realizo un bucle a traves del detallle de comprobantes para ir sumando los totales 
                model.forEach(function(r, index, id) {
            
            
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)) {
            
            
                        console.log(r[v_importe])
                        v_total = v_total + parseFloat(r[v_importe].replace(/\./g, ''));
            
            
                    }
            
                });
            
            
                $s('P75_TOT_NRO_MOV_CAJ', v_total.toString().replace('.', ':'));
            
            
            }
            // Calcula el total de las formas de cobro que se van añadiendo
            function calcularTotalesCobros() {
                // Con esto llamo a la region del detalle de formas de cobro 
                var model3 = apex.region("FORMAS_COBRO").widget().interactiveGrid("getCurrentView").model;
            
            
                // Obtengo el indice de los valores que voy a necesitar  y
                // Inicializo las variables que voy a necesitar 
                var v_importe = model3.getFieldKey("IMPORTECAMBIO");
                var tip_documento = model3.getFieldKey("TIP_DOCUMENTO");
                var bandera = 0;
                var v_total = 0;
                var efectivo_cobro = $v('P75_EFECTIVO_COBRO');
                
            
                // Realizo un bucle a traves del detalle de formas para ir sumando los totales
                model3.forEach(function(r, index, id) {
            
            
                    var meta = model3.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)) {
            
            
                        if (r[tip_documento] != efectivo_cobro) {
                            bandera = 1
                            
                        }
            
                        try {
            
                            v_total = v_total + parseFloat(r[v_importe].replace(/\./g, ''));
                        } catch (e) {
                            console.log(e);
                        }
            
            
            
            
                    }
            
                });
            
            
            
            
                //Guardo el total del comprobante en una variable 
                var total_comprobante = parseFloat($v('P75_TOT_NRO_MOV_CAJ').replace(/\./g, ''));
                //var total_cobro = parseFloat($v('P75_TOTAL_COBRO').replace(/\./g,''));
                var vuelto = 0;
                // Si se realiza  el pago en efectivo entonces se realiza el calculo para el vuelto
                if (v_total > total_comprobante && bandera == 0) {
                    vuelto = Math.abs(v_total - total_comprobante);
                    v_total = total_comprobante;
                }
                //Seteo los campos de totales y vuelto
                $s('P75_TOTAL_COBRO', v_total.toString().replace('.', ':'));
                $s('P75_VUELTO', vuelto.toString().replace('.', ':'));
            
            
            }
            // Funcion para ocultar la columna de comprobante y mostrar la de recibo en la grilla de comprobantes
            function ocultarColumna() {
                gridView = apex.region("Comprobantes").call("getViews").grid;
            
                gridView.view$.grid("hideColumn", "ID_COMPROBANTE");
                gridView.view$.grid("showColumn", "ID_RECIBO");
            
            
            
            }
            
            function validarFecha() {
                var model3 = apex.region("FORMAS_COBRO").widget().interactiveGrid("getCurrentView").model;
                var fec_vencimiento = model3.getFieldKey('FEC_VENCIMIENTO');
                var fec_emision = model3.getFieldKey('FEC_EMISION');
            
                apex.message.clearErrors();
                var array = model3.getSelectedRecords();
            
            
            
                var date1 = (array[0][fec_vencimiento]).split('/')
                var newDate = date1[1] + '/' + date1[0] + '/' + date1[2];
            
                var fec_ven = new Date(newDate);
            
                date1 = (array[0][fec_emision]).split('/')
                newDate = date1[1] + '/' + date1[0] + '/' + date1[2];
            
                var fec_emi = new Date(newDate);
            
                console.log('fecha vencimiento' + fec_ven);
                console.log('fecha emision es' + fec_emi);
            
            
            
            
                if (fec_ven < fec_emi) {
                    errorDetails = {
                        type: "error",
                        location: ["page"],
                        message: "Fecha de vencimiento no puede ser menor a fecha de emision.",
                        unsafe: false
                    };
                    apex.message.showErrors(errorDetails);
                    model3.refresh;
                } else {
                    apex.message.clearErrors();
                }
            
            }
            
            function refrescarColumna(region, columna){
                var grid$ = apex.region( region ).call( "getCurrentView" ).view$;
                grid$.grid("lockActive");
                setTimeout( function() {
                // the grid model is not updated so call setActiveRecordValue
                grid$.grid( "setActiveRecordValue", columna )
                .grid( "unlockActive" );
                }, 100 );
            }
            
            ```
