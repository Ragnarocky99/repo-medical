    dynamicAction cargar-caja (
        name: Cargar Caja
        execution {
            sequence: 120
        }
        when {
            event: ready
        }
        comments {
            comments: "Carga los datos de la caja del usuario que esta conectado actualmente "
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_error exception;
                    BEGIN
                       Select id_caja, nro_habilitacion,id,FEC_HABILITACION,HORA_HABILITACION
                         into :P75_ID_CAJA,:P75_NRO_HABILITACION,:P75_ID_HABILITACION,:P75_FEC_HABILITACION,:P75_HORA_HABILITACION
                         from ccw_habilitaciones
                        where id_empresa = :p0_cod_empresa
                          and id_sucursal = :P0_COD_SUCURSAL
                          and upper(id_usuario) = (SELECT ID FROM BSW_USUARIOS WHERE COD_USUARIO=UPPER(:APP_USER) AND 
                          ID_EMPRESA=:P0_COD_EMPRESA)
                          and fec_cierre IS NULL;
                          
                      EXCEPTION
                        when no_data_found then
                           raise_application_error(-20000,'El usuario  '|| :APP_USER ||' no posee ninguna caja habilitada');
                             --  dbms_output.put_line('hola');
                         -- apex_util.set_session_state('P75_ERROR', 'No se encontro ninguna caja habilitada para el usuario '||:APP_USER);
                         /*apex_error.add_error (
                        p_message          => 'El usuario no posee ninguna caja habilitada!',
                        p_display_location => apex_error.c_inline_in_notification );*/
                        when others then
                          raise_application_error(-20000,'Error en el la tabla de habilitacion de caja'||sqlerrm);
                      END;
                    ```
                itemsToReturn: [
                    P75_ID_CAJA
                    P75_NRO_HABILITACION
                    P75_FEC_HABILITACION
                    P75_HORA_HABILITACION
                    P75_ID_HABILITACION
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemIsNull
                item: P75_ID
            }
            serverSideCondition {
                type: itemIsNull
                item: P75_ID
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    SELECT FEC_HABILITACION,HORA_HABILITACION  
                    INTO :P75_FEC_HABILITACION,:P75_HORA_HABILITACION
                    FROM CCW_HABILITACIONES
                    WHERE ID_CAJA=:P75_ID_CAJA 
                    AND  ID=:P75_ID_HABILITACION;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    ```
                itemsToSubmit: [
                    P75_ID_CAJA
                    P75_ID_HABILITACION
                ]
                itemsToReturn: [
                    P75_FEC_HABILITACION
                    P75_HORA_HABILITACION
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P75_ID
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P75_ID
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_cod_caja CCW_CAJAS.COD_CAJA%TYPE;
                    BEGIN
                    IF :P75_ID_CAJA IS NOT NULL THEN
                    SELECT COD_CAJA 
                    INTO V_COD_CAJA
                    FROM 
                    CCW_CAJAS 
                    WHERE ID=:P75_ID_CAJA;
                    RETURN V_COD_CAJA;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN 
                    RETURN NULL;
                    WHEN OTHERS THEN
                    RETURN NULL;
                    END;
                    ```
                itemsToSubmit: P75_ID_CAJA
            }
            affectedElements {
                selectionType: items
                items: P75_COD_CAJA
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction cargar-comprobante-desde-pantalla-de-factura-o-recibo (
        name: Cargar Comprobante(Desde Pantalla de Factura o Recibo)
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P75_ID_COMPROBANTE
        }
        clientSideCondition {
            type: itemIsNull
            item: P75_ID
        }
        comments {
            comments: Carga los datos del comprobante cuando se llama a la pantalla de movimiento de caja desde la pantalla de carga de comprobantes
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Comprobantes").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    
                    
                    // PRODUCT_ID and ORDER_QUANTITY are column names in IG SQL query
                    //update record values
                    var v_nro_comprobante = $v( "P75_NRO_COMPROBANTE" );
                    var v_id_recibo= $v("P75_ID_RECIBO");
                    var v_id_comprobante=$v("P75_ID_COMPROBANTE");
                    var v_tip_comprobante=$v("P75_TIP_COMPROBANTE");
                    var v_ser_comprobante=$v('P75_SER_COMPROBANTE');
                    var v_moneda=$v("P75_ID_MONEDA");
                    var v_importe=$v('P75_IMPORTE');
                    var v_tip_cambio=$v('P75_TIP_CAMBIO');
                    var v_nro_cuota=$v('P75_NRO_CUOTA');
                    
                    if (v_id_comprobante){
                    $model.setValue($newRecord, "ID_COMPROBANTE", v_id_comprobante);
                    }else if(v_id_recibo){
                        $model.setValue($newRecord, "ID_RECIBO", v_id_recibo);
                    }
                    
                    $model.setValue($newRecord, "NRO_COMPROBANTE",v_nro_comprobante);
                    $model.setValue($newRecord, "TIP_COMPROBANTE",v_tip_comprobante);
                    $model.setValue($newRecord, "SER_COMPROBANTE",v_ser_comprobante);
                    $model.setValue($newRecord, "ID_MONEDA",v_moneda);
                    $model.setValue($newRecord, "IMPORTECAMBIO",v_importe);
                    $model.setValue($newRecord, "TOT_COMPROBANTE",v_importe);
                    $model.setValue($newRecord, "TIP_CAMBIO",v_tip_cambio);
                    $model.setValue($newRecord, "NRO_CUOTA",v_nro_cuota);
                    $s("P75_TOT_NRO_MOV_CAJ",v_importe);
                    ;
                    try{
                    
                    
                    if($model.isChanged()){
                        try{
                        $grid.gotoCell(newRecordId,'TIP_COMPROBANTE');
                        $grid.setEditMode(true);
                         }catch(err){
                             console.error("Error es"+err);
                         }
                    }
                    }catch(err){
                     console.log("Erroe es"+err);
                    }
                    ```
            }
            execution {
                sequence: 40
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                    BEGIN
                    IF :P75_ID_COMPROBANTE IS NOT NULL THEN
                    SELECT NRO_COMPROBANTE   
                    INTO v_nro_comprobante 
                    FROM VTW_COMPROBANTES_CABECERA 
                    WHERE ID=:P75_ID_COMPROBANTE;
                    return v_nro_comprobante;
                    elsif :P75_ID_RECIBO IS NOT NULL THEN
                    SELECT NRO_RECIBO
                    INTO v_nro_comprobante 
                    FROM CCW_RECIBOS
                    WHERE ID=:P75_ID_RECIBO;
                    RETURN V_NRO_COMPROBANTE; 
                    END IF;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RETURN NULL;
                    WHEN OTHERS THEN 
                    RETURN NULL;
                    END;
                    ```
                itemsToSubmit: [
                    P75_ID_COMPROBANTE
                    P75_ID_RECIBO
                ]
            }
            affectedElements {
                selectionType: items
                items: P75_NRO_COMPROBANTE
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nro_cuota CCW_SALDOS.NRO_CUOTA%TYPE;
                    BEGIN
                    IF :P75_ID_COMPROBANTE IS NOT NULL THEN 
                    SELECT NRO_CUOTA  
                    INTO V_NRO_CUOTA 
                    FROM CCW_SALDOS 
                    WHERE ID_COMPROBANTE=:P75_ID_COMPROBANTE;
                    RETURN v_nro_cuota;
                    ELSIF :P75_ID_RECIBO IS NOT NULL THEN 
                    SELECT NRO_CUOTA 
                    into V_NRO_CUOTA
                    FROM 
                    CCW_DETALLE_RECIBOS
                    WHERE ID_RECIBO=:P75_ID_RECIBO;
                    RETURN v_nro_cuota; 
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN 
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    END;
                    ```
                itemsToSubmit: [
                    P75_ID_COMPROBANTE
                    P75_ID_RECIBO
                ]
            }
            affectedElements {
                selectionType: items
                items: P75_NRO_CUOTA
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction cargar-datos-anticipo (
        name: Cargar datos Anticipo
        execution {
            sequence: 280
        }
        when {
            selectionType: columns
            interactiveGrid: @comprobantes
            columns: ID_ANTICIPO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    IF :ID_ANTICIPO IS NOT NULL THEN 
                      SELECT CAB.NRO_COMPROBANTE,
                             CAB.SER_COMPROBANTE,
                             CAB.ID_MONEDA,
                             CAB.ID_MONEDA,
                             SAL.NRO_CUOTA,
                             SAL.SALDO_CUOTA,
                             SAL.SALDO_CUOTA
                        INTO :NRO_COMPROBANTE,
                             :SER_COMPROBANTE,
                             :ID_MONEDA,
                             :P75_ID_MONEDA,
                             :NRO_CUOTA,
                             :TOT_COMPROBANTE,
                             :IMPORTECAMBIO
                        FROM CCW_ANTICIPOS_CLIENTES_CAB CAB
                        JOIN CCW_SALDOS SAL
                          ON CAB.ID = SAL.ID_COMPROBANTE_ANT
                       WHERE CAB.ID = :ID_ANTICIPO
                         AND SAL.TIPO_COMPROBANTE = 'ADC';
                        END IF;                        
                    
                    EXCEPTION
                      WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000,
                                                'No se pudo cargar los datos del anticipo: ' ||
                                                sqlerrm);
                    END;
                    
                    ```
                itemsToSubmit: ID_ANTICIPO
                itemsToReturn: [
                    NRO_COMPROBANTE
                    ID_MONEDA
                    P739_ID_MONEDA
                    NRO_CUOTA
                    TOT_COMPROBANTE
                    IMPORTECAMBIO
                    SER_COMPROBANTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

