    process comprobantes-save-interactive-grid-data (
        name: Comprobantes - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @comprobantes
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                              IF :ID_COMPROBANTE IS NOT NULL THEN
                              SELECT ID 
                              INTO :ID_SALDOS
                              FROM
                              CCW_SALDOS WHERE ID_COMPROBANTE=:ID_COMPROBANTE;
                              END IF;
                
                           
                
                          
                             
                              INSERT INTO CCW_MOVIMIENTOS_COMP
                               (ID,ID_EMPRESA,ID_MOV_CAJ,ID_COMPROBANTE,ID_MONEDA,TIP_CAMBIO,
                              TOT_COMPROBANTE,TIP_COMPROBANTE,IMPORTECAMBIO,ID_SALDOS,ID_CLIENTE,FECHA_ALTA,SER_COMPROBANTE,NRO_COMPROBANTE,
                              FECHA_COBRO,ID_RECIBO,COD_USUARIO_AUD,NRO_CUOTA)
                              VALUES(:ID,:ID_EMPRESA,:P75_ID,:ID_COMPROBANTE,:ID_MONEDA,:TIP_CAMBIO,
                              REPLACE(:TOT_COMPROBANTE,'.',''),:TIP_COMPROBANTE,REPLACE(:IMPORTECAMBIO,'.',''),:ID_SALDOS,:P75_ID_CLIENTE,SYSDATE,:SER_COMPROBANTE,
                              :NRO_COMPROBANTE,:FECHA_COBRO,:ID_RECIBO,:COD_USUARIO_AUD,:NRO_CUOTA);
                
                              
                
                        
                            WHEN 'U' then  
                
                             IF :ID_COMPROBANTE IS NOT NULL THEN
                              SELECT ID 
                              INTO :ID_SALDOS
                              FROM
                              CCW_SALDOS WHERE ID_COMPROBANTE=:ID_COMPROBANTE;
                              END IF;
                         
                             UPDATE CCW_MOVIMIENTOS_COMP 
                             SET ID_COMPROBANTE=:ID_COMPROBANTE,
                               ID_MONEDA=:ID_MONEDA,
                             TIP_CAMBIO=:TIP_CAMBIO,  
                             TOT_COMPROBANTE=REPLACE(:TOT_COMPROBANTE,'.',''),
                              TIP_COMPROBANTE = :TIP_COMPROBANTE,
                              IMPORTECAMBIO=REPLACE(:IMPORTECAMBIO,'.',''),
                             ID_SALDOS=:ID_SALDOS, 
                              ID_CLIENTE=:P75_ID_CLIENTE,
                              NRO_COMPROBANTE=:NRO_COMPROBANTE
                             WHERE ID=:ID    
                             AND ID_MOV_CAJ=:P75_ID
                             AND ID_EMPRESA=:P0_COD_EMPRESA;
                
                           when 'D' then
                          DELETE CCW_MOVIMIENTOS_COMP 
                          WHERE ID=:ID 
                          AND ID_MOV_CAJ=:ID_MOV_CAJ;
                              
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 51412589458118354
        }
    )

