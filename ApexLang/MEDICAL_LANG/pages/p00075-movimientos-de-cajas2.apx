    region comprobantes (
        name: Comprobantes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_MOV_CAJ,
                       ID_COMPROBANTE,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       TOT_COMPROBANTE,
                       COD_USUARIO_AUD,
                       ID_RECIBO,
                       TIP_COMPROBANTE,
                       IMPORTECAMBIO,
                       ESCOMPROBANTE,
                       ID_NOTAS_DEBCRED,
                       IND_TIPO,
                       ID_SALDOS,
                       FECHA_ALTA,
                       ID_USUARIO_ALTA,
                       FECHA_COMPROBANTE,
                       FECHA_COBRO,
                       TRANSAC_PRONET,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       ID_CLIENTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       NRO_CUOTA,
                       ID_ANTICIPO,
                       PREPARA_URL_CARGA(P_ID_EMPRESA      => :P0_ID_EMPRESA,
                                         P_TIP_COMPROBANTE => TIP_COMPROBANTE,
                                         P_ID              => DECODE(TIP_COMPROBANTE, 'REC', ID_RECIBO, ID_COMPROBANTE)) URL_REGISTRO
                  from CCW_MOVIMIENTOS_COMP
                 where ID_MOV_CAJ=:P75_ID
                ```
            pageItemsToSubmit: P75_ID
        }
