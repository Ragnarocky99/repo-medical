        column ID_SUB_TIPO_TRANS (
            type: selectList
            heading {
                heading: <p>Trans</p>
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT '('||SUBTIPO_TRANS||') ' || DESCRIPCION, ID
                    FROM BSW_SUBTIPOS_TRANS
                    WHERE ID_TIPO_TRANS = :ID_TRANS
                      AND ID_EMPRESA    = :P0_ID_EMPRESA
                    ORDER BY length(SUBTIPO_TRANS), SUBTIPO_TRANS
                    ```
            }
            cascadingLov {
                parentColumns: ID_TRANS
                itemsToSubmit: [
                    ID_TRANS
                    P0_ID_EMPRESA
                ]
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_SUB_TIPO_TRANS
                dataType: number
            }
        )

