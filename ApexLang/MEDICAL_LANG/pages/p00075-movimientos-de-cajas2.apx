    region master (
        name: Master
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region movimientos-de-cajas (
        name: Movimientos de Cajas
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       NRO_MOV_CAJ,
                       ID_SUCURSAL,
                       FEC_MOV_CAJ,
                       ID_CAJA,
                       NRO_HABILITACION,
                       NUM_ASIENTO,
                       ANULADO,
                       FEC_ANULACION,
                       ID_USUARIO,
                       NUM_ASIENTO_ANUL,
                       TOT_NRO_MOV_CAJ,
                       ID_MONEDA,
                       TIPO_CAMBIO,
                       TIP_CAMBIO,
                       FEC_ALTA,
                       VUELTO,
                       ID_CORPORACION,
                       COD_USUARIO_AUD,
                       ID_CLIENTE,
                       REPLACE(REPLACE(ASIENTOS,'*'),'cobros') ASIENTOS,
                       TRANSAC_PRONET,
                       ID_HABILITACION,
                       NRO_TRANS_PM,
                       NRO_PAGO_EXPRESS,
                       IND_GEN_AUTO
                  from CCW_MOVIMIENTOS_CAJAS
                ```
        }
        layout {
            sequence: 10
            parentRegion: @master
            slot: subRegions
            columnSpan: 3
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: 30056522717249581
            update: 30871884518675157
            delete: 30872506316686181
        }
    )

