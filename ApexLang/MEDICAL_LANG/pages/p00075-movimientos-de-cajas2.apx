            settings {
                jsCode:
                    ```javascript-browser
                    try{
                    var $widget = apex.region("FORMAS_COBRO").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var grid2$ = apex.region( "FORMAS_COBRO" ).call( "getCurrentView" ).view$;
                    var $model = $grid.model;
                    var vuelto_pos = $v('P75_VUELTO_POS');
                    var monto_actual=$model.getRecordValue(filaActual[0][0],"IMPORTECAMBIO");
                    var monto_total=$v('P75_MONTO_POS');
                    $s('P75_MONTO_POS',0);
                    
                    
                    console.log('Despues de insertar'+$v('P75_NRO_BOLETA'));
                    $model.setValue(filaActual[0],"NRO_VALOR",$v('P75_NRO_BOLETA'));
                    if ( vuelto_pos!= 0 && vuelto_pos){
                        console.log('Insertando Fila');
                    $model.setValue(filaActual[0],"IMPORTECAMBIO",monto_total);
                    $model.setValue(filaActual[0],"MONTO",monto_total);
                        var newRecordId = $model.insertNewRecord();
                       var $newRecord = $model.getRecord(newRecordId)
                       $model.setValue($newRecord,"MONTO",vuelto_pos);
                       $model.setValue($newRecord,"IMPORTECAMBIO",vuelto_pos);
                    
                         $model.setValue($newRecord,"TIP_DOCUMENTO",'EFE',true)
                         $model.setValue($newRecord,"ID_SUB_TIPO_TRANS",538,true);
                         $model.setValue($newRecord,"TIP_CAMBIO",1,true);  
                    }
                    }catch(e){
                       console.log(e);
                    }
                    $s('P75_MONTO_POS',0);
                    $s('P75_VUELTO_POS',0);
                    ```
            }
