    validation validar-totales (
        name: Validar Totales
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                begin
                IF :P75_TOT_NRO_MOV_CAJ!=:P75_TOTAL_COBRO THEN
                RETURN false;
                else 
                return true;
                END IF; 
                end;
                ```
        }
        error {
            errorMessage: Los totales del comprobante y pago deben ser iguales
            associatedItem: @P75_TOTAL_COBRO
        }
    )

    computation p75-asientos-id (
        itemName: P75_ASIENTOS_ID
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                select id 
                from cow_diario_cabeceras_prov
                where num_asiento  = to_number(replace(replace(:P75_ASIENTOS,'*'),'cobros'))
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P75_FEC_MOV_CAJ);
                ```
        }
    )

    computation p75-ip-pos (
        itemName: P75_IP_POS
        execution {
            sequence: 40
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                V_IP_POS VARCHAR2(100);
                BEGIN
                Select IP_POS
                     into V_IP_POS
                     from ccw_habilitaciones h,ccw_cajas c 
                    where h.id_empresa = :p0_cod_empresa
                      and h.id_sucursal = :P0_COD_SUCURSAL
                      and upper(id_usuario) = (SELECT ID FROM BSW_USUARIOS WHERE COD_USUARIO=UPPER(:APP_USER) AND 
                      ID_EMPRESA=:P0_COD_EMPRESA)
                      and fec_cierre IS NULL
                      and c.id=h.id_caja;
                      RETURN V_IP_POS;
                   EXCEPTION
                      WHEN OTHERS THEN
                      RETURN NULL;
                END;
                ```
        }
    )

    computation p75-nro-mov-caj (
        itemName: P75_NRO_MOV_CAJ
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_nro_mov_caj  CCW_MOVIMIENTOS_CAJAS.NRO_MOV_CAJ%TYPE;
                BEGIN
                IF :P75_NRO_MOV_CAJ IS  NULL THEN 
                SELECT to_number(MAX(NRO_MOV_CAJ))+1
                INTO v_nro_mov_caj
                FROM 
                CCW_MOVIMIENTOS_CAJAS WHERE
                ID_CAJA=:P75_ID_CAJA
                AND ID_EMPRESA=:P0_COD_EMPRESA;
                IF v_nro_mov_caj is null then
                v_nro_mov_caj:=1;
                end if;
                 END IF;
                RETURN v_nro_mov_caj;
                exception
                WHEN NO_DATA_FOUND THEN
                v_nro_mov_caj:=1;
                return v_nro_mov_caj;
                WHEN OTHERS THEN
                RAISE_APPLICATION_ERROR(20000,'Error en la tablas de movimientos de cajas'||sqlerrm);
                v_nro_mov_caj:=1;
                return v_nro_mov_caj;
                END;
                ```
        }
        error {
            errorMessage:
                ```
                HOLA
                
                ```
        }
    )

    computation p75-total-cobro (
        itemName: P75_TOTAL_COBRO
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_total number(18,2);
                begin
                SELECT TOT_NRO_MOV_CAJ
                INTO v_total
                 FROM
                CCW_MOVIMIENTOS_CAJAS 
                WHERE ID=:P75_ID;
                return v_total;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                RETURN NULL;
                WHEN OTHERS THEN
                RETURN NULL; 
                end;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P75_ID
        }
    )

