        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region nota-de-credito-compra (
        name: Nota de Credito-Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_PROVEEDOR,
                       C.ID_CONDICION_COMPRA,
                       C.TIP_COMPROBANTE_REF,
                       C.SER_COMPROBANTE_REF,
                       C.NRO_COMPROBANTE_REF,
                       C.TOT_COMPROBANTE,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.REFERENCIA,
                       C.NOM_PROVEEDOR,
                       C.NRO_TIMBRADO,
                       REPLACE(REPLACE(C.ASIENTOS,'*'),'nct') ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'nct'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTOS_ID
                
                
                  from CMW_COMPRAS_CABECERA C
                  WHERE ID_EMPRESA= :P0_ID_EMPRESA
                 AND  TIP_COMPROBANTE=W_BUSCA_PARAMETRO('CM','TIPO_NOTACRE_CM')
                  ORDER BY FEC_COMPROBANTE
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 268
                items: {
                    P268_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
