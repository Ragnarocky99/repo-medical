    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @filtros
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: REFRESCAR
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-anticipo-a-cliente
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p652-comprobante (
        itemName: P652_COMPROBANTE
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                select  s.ser_comprobante
                from    bsw_series_comprob s
                where   tip_comprobante = 'ADC'
                ```
        }
    )

    computation p652-fecha-fin (
        itemName: P652_FECHA_FIN
        execution {
            sequence: 40
        }
        computation {
            sqlQuery: select last_day(trunc(sysdate)) from dual
        }
        serverSideCondition {
            type: itemIsNull
            item: P652_FECHA_FIN
        }
    )

    computation p652-fecha-ini (
        itemName: P652_FECHA_INI
        execution {
            sequence: 30
        }
        computation {
            sqlQuery: select '01/'||to_char(sysdate,'MM/YYYY') from dual;
        }
        serverSideCondition {
            type: itemIsNull
            item: P652_FECHA_INI
        }
    )

    computation p652-tipo-comprobante (
        itemName: P652_TIPO_COMPROBANTE
        execution {
            sequence: 10
        }
        computation {
            type: staticValue
            staticValue: ADL
        }
    )

)

