        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region lista-anticipo-a-cliente (
        name: Lista Anticipo a Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  TIP_COMPROBANTE,
                        SER_COMPROBANTE,
                        NRO_COMPROBANTE,
                        FEC_COMPROBANTE,
                        ID_CLIENTE,
                        ID_MONEDA,
                        TIP_CAMBIO,
                        MONTO_TOTAL,
                        SALDO,
                        ACTIVO,
                        case ACTIVO
                            when 'S' then 'fa fa-check u-success-text'
                            when 'N' then 'fa fa-remove u-danger-text'
                        end ACTIVO_ICON,
                        ID_SUCURSAL,
                        COD_USUARIO,
                        COD_CLIENTE_REF,
                        ID_MODULO,
                        ID_CUENTA,
                        ID,
                        ID_TIPO_COMP,
                        ID_SERIE_COMP
                  from  CCW_ANTICIPOS_CLIENTES_CAB
                  where nvl(tip_comprobante, 'ADC') = :P652_TIPO_COMPROBANTE
                  and   nvl(ser_comprobante, 'A')   = :P652_COMPROBANTE
                  and   (nro_comprobante = :P652_NRO_COMPROBANTE or :P652_NRO_COMPROBANTE is null)
                  and   fec_comprobante between :P652_FECHA_INI and :P652_FECHA_FIN
                  and   (id_cliente = :P652_CLIENTE or :P652_CLIENTE is null)
                ```
            pageItemsToSubmit: [
                P652_TIPO_COMPROBANTE
                P652_COMPROBANTE
                P652_FECHA_INI
                P652_FECHA_FIN
                P652_CLIENTE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 653
                items: {
                    P653_ACTIVO: #ACTIVO#
                    P653_COD_USUARIO: #COD_USUARIO#
                    P653_FEC_COMPROBANTE: #FEC_COMPROBANTE#
                    P653_ID: #ID#
                    P653_ID_CLIENTE: #ID_CLIENTE#
                    P653_ID_CUENTA: #ID_CUENTA#
                    P653_ID_EMPRESA: &P0_ID_EMPRESA.
                    P653_ID_MONEDA: #ID_MONEDA#
                    P653_ID_SERIE_COMP: #ID_SERIE_COMP#
                    P653_ID_SUCURSAL: #ID_SUCURSAL#
                    P653_ID_TIPO_COMP: #ID_TIPO_COMP#
                    P653_MONTO_TOTAL: #MONTO_TOTAL#
                    P653_NRO_COMPROBANTE: #NRO_COMPROBANTE#
                    P653_SALDO: #SALDO#
                    P653_TIP_CAMBIO: #TIP_CAMBIO#
                    P653_TIP_COMPROBANTE: #TIP_COMPROBANTE#
                    P653_SER_COMPROBANTE: #SER_COMPROBANTE#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 121423645006406386
        }

