    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P330_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P330_FEC_COMPROBANTE
        }
    )

    validation validar-total (
        name: Validar Total
        execution {
            sequence: 10
