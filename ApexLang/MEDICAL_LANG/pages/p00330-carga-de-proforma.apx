    pageItem P330_ID_USUARIO (
        type: hidden
        layout {
            sequence: 300
            region: @pro-forma
            slot: regionBody
        }
        source {
            formRegion: @pro-forma
            column: ID_USUARIO
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_id_usuario number;
                BEGIN
                SELECT ID 
                into v_id_usuario
                FROM BSW_USUARIOS
                WHERE upper(COD_USUARIO)=upper(:APP_USER);
                return v_id_usuario;
                exception 
                when no_data_found then
                return null;
                when others then
                return null;
                END;
                ```
        }
    )

