    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 170
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P330_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-montos (
        name: CALCULAR_MONTOS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
            ]
        }
        comments {
            comments: Aqui se van calculando los totales correspondientes  (Monto total con iva , monto total , total iva ,descuentos)
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :CANTIDAD is null then
                         :CANTIDAD := 1;
                    end if;
                    
                    if :PRECIO_UNITARIO_C_IVA is null THEN
                        :PRECIO_UNITARIO_C_IVA    := 0;
                        :TOTAL_IVA := 0;
                        END IF;
                    
                    
                    
                    
                    :MONTO_TOTAL_C_IVA :=round(replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')),:P330_DECIMALES);
                    
                    --:MONTO_TOTAL_C_IVA:=:CANTIDAD * :PRECIO_UNITARIO_C_IVA;
                    
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    CANTIDAD
                    P330_DECIMALES
                ]
                itemsToReturn: [
                    MONTO_TOTAL
                    MONTO_TOTAL_C_IVA
                    P330_DESCUENTO_V
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null  then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    if :TOTAL_IVA is null then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    :TOTAL_IVA := round((((replace(:PRECIO_UNITARIO_C_IVA, '.', '')) * replace(:CANTIDAD, '.', '')) * :PORC_IVA ) / (100 + :PORC_IVA),:P330_DECIMALES);
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    P330_DECIMALES
                ]
                itemsToReturn: TOTAL_IVA
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :MONTO_TOTAL is null  then
                       :MONTO_TOTAL:= 0;
                    end if;
                    
                    
                    --:MONTO_TOTAL :=:MONTO_TOTAL_C_IVA -:IVA;
                    :MONTO_TOTAL := round((replace(:MONTO_TOTAL_C_IVA, '.', '') - replace(:TOTAL_IVA, '.', '')),:P330_DECIMALES);
                    ```
                itemsToSubmit: [
                    MONTO_TOTAL_C_IVA
                    TOTAL_IVA
                    P330_DECIMALES
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-4 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_precio_unitario number;
                    begin
                    IF :PRECIO_UNITARIO IS NULL THEN
                    :PRECIO_UNITARIO:=0;
                    END IF;
                    
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_IVA/(100+:PORC_IVA)),:P330_DECIMALES);
                     :PRECIO_UNITARIO:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,:P330_DECIMALES);
                     end;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                ]
                itemsToReturn: PRECIO_UNITARIO
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

    dynamicAction cambiar-factura-proveedor (
        name: Cambiar Factura Proveedor
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: [
                P330_VALOR3
                P330_VALOR2
                P330_VALOR1
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    nvl(:P330_VALOR1,'001')||'-'||nvl(:P330_VALOR2,'001')
                    	                        ||'-'||LPAD(:P330_VALOR3,7,'0')
                    ```
                itemsToSubmit: [
                    P330_VALOR1
                    P330_VALOR2
                    P330_VALOR3
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P330_REFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-proveedor (
        name: Cargar Datos Proveedor
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P330_ID_PROVEEDOR
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nombre_proveedor  BSW_PERSONAS.NOMBRE%TYPE;
                    BEGIN
                    select ltrim(p.nombre) nombre
                    INTO v_nombre_proveedor
                     from bsw_personas p, cmw_proveedores v 
                     where v.id_empresa = :P0_COD_EMPRESA
                     and v.id_persona = p.ID 
                     AND V.ID=:P330_ID_PROVEEDOR;
                    RETURN v_nombre_proveedor;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    return null;
                    when others then
                    raise_application_error(-20000,'Error en la tabla de proveedores'||sqlerrm);
                    return null;
                    END;
                    ```
                itemsToSubmit: P330_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P330_NOM_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT EXENTO FROM CMW_PROVEEDORES
                    WHERE ID=:P330_ID_PROVEEDOR
                    ```
                itemsToSubmit: P330_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P330_IND_EXENTO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-detalle (
        name: Cargar Detalle
        execution {
            sequence: 250
        }
        when {
            selectionType: items
            items: P330_REFERENCIA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: dbms_lock.sleep(0.3);
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P330_JSON_DETALLE'));
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    orden=orden+1;
                    $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO).toString());
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    //$model.setValue($newRecord, "CANTIDAD_UB",(json_detalle.DETALLE[i].CANTIDAD_UB).toString());
                    //$model.setValue($newRecord, "DESCUENTO",(json_detalle.DETALLE[i].DESCUENTO).toString());
                    //$model.setValue($newRecord, "DESCUENTO_C_IVA",(json_detalle.DETALLE[i].DESCUENTO_C_IVA).toString());
                    //$model.setValue($newRecord, "ID_IVA",(json_detalle.DETALLE[i].ID_IVA).toString());
                    //if((json_detalle.DETALLE[i].ID_LOTE!=null)){
                    //$model.setValue($newRecord, "ID_LOTE",(json_detalle.DETALLE[i].ID_LOTE).toString
                    //}
                    if((json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA!=null)){
                    $model.setValue($newRecord, "ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA).toString());
                    }
                    //$model.setValue($newRecord, "IND_MUEVE_STOCK",(json_detalle.DETALLE[i].IND_MUEVE_STOCK).toString());
                    //$model.setValue($newRecord, "MONTO_TOTAL",(json_detalle.DETALLE[i].MONTO_TOTAL).toString());
                    //$model.setValue($newRecord, "PRECIO_UNITARIO",(json_detalle.DETALLE[i].PRECIO_UNITARIO).toString());
                    //$model.setValue($newRecord, "PRECIO_UNITARIO_C_IVA",(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA).toString().replace(/\./g,','));
                    $model.setValue($newRecord, "PRECIO_UNITARIO_C_IVA",(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA).toString());
                    //$model.setValue($newRecord, "TOTAL_IVA",(json_detalle.DETALLE[i].TOTAL_IVA).toString());
                    //$model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA).toString().replace(/\./g,','));
                    $model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA).toString().replaceAll(',','.'));
                    console.log(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA.toString());
                    console.log(json_detalle.DETALLE[i].CANTIDAD.toString());
                    let x = parseFloat(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA.toString().replaceAll(',','.'));
                    let y = parseFloat(json_detalle.DETALLE[i].CANTIDAD.toString());
                    console.log(x*y);
                    console.log(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA.toString().replaceAll(',','.'));
                    //$model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA).toString());
                    $model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(x*y).toString().replaceAll('.',','));
                    //$model.setValue($newRecord, "PORC_IVA",(.DETALLE[i].IVA).toString());
                    //$model.setValue($newRecord, "NUM_ORDEN",(.DETALLE[i].UN).toString());
                    $model.setValue($newRecord, "DESC_ARTICULO",(json_detalle.DETALLE[i].DESC_ARTICULO).toString());
                    $model.setValue($newRecord, "COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString());
                    $model.setValue($newRecord, "ID_OCP",(json_detalle.DETALLE[i].ID_OCP).toString());
                    $model.setValue($newRecord, "TIP_OCP",(json_detalle.DETALLE[i].TIP_OCP).toString());
                    $model.setValue($newRecord, "SER_OCP",(json_detalle.DETALLE[i].SER_OCP).toString());
                    $model.setValue($newRecord, "NRO_OCP",(json_detalle.DETALLE[i].NRO_OCP).toString());
                    $model.setValue($newRecord, "ID_OCP_DET",(json_detalle.DETALLE[i].ID_OCP_DET).toString());
                    $model.setValue($newRecord, "ID_ENVASE",(json_detalle.DETALLE[i].ID_ENVASE).toString());
                    $model.setValue($newRecord, "COD_ORIGEN_ART",(json_detalle.DETALLE[i].COD_ORIGEN_ART).toString());
                    
                    }
                    recalculaImporte();
                    }
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action preparar-json (
            name: Preparar JSON
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                      OPEN l_cursor FOR
                        SELECT E.ID,
                               E.ID_PEDIDO_CAB,
                               E.ID_ARTICULO,
                               E.ID_UNIDAD_MEDIDA,
                               E.ID_IVA,
                               A.ID_ENVASE,
                               A.COD_ORIGEN_ART,
                               REPLACE(E.CANTIDAD,'.',',')-nvl((select sum(dd.cantidad)
                                                                from cmw_compras_detalle dd
                                                                where dd.id_articulo = e.id_Articulo
                                                                and   dd.id_pedido_det = e.id),0) CANTIDAD, --E.CANTIDAD
                                REPLACE(E.CANTIDAD_CONFIRMADA,'.',',') CANTIDAD_CONFIRMADA, --E.CANTIDAD_CONFIRMADA
                               replace(E.PRECIO_UNITARIO,'.',',') PRECIO_UNITARIO, --E.PRECIO_UNITARIO
                               E.IVA,
                               --REPLACE(E.MONTO_TOTAL_C_IVA,'.',',') MONTO_TOTAL_C_IVA, --E.MONTO_TOTAL_C_IVA
                               (REPLACE(E.CANTIDAD,'.',',')-nvl((select sum(dd.cantidad)
                                                                from cmw_compras_detalle dd
                                                                where dd.id_articulo = e.id_Articulo
                                                                and   dd.id_pedido_det = e.id),0)) * replace(E.PRECIO_UNITARIO,'.',',') MONTO_TOTAL_C_IVA,
                               REPLACE(E.PRECIO_UNITARIO_C_IVA,'.',',') PRECIO_UNITARIO_C_IVA, --E.PRECIO_UNITARIO_C_IVA
                               A.COD_ARTICULO,
                               NVL(E.CANTIDAD_UB,0),
                               A.DESCRIPCION AS DESC_ARTICULO,
                               -----DATOS PARA RELACIONAR VARIAS OCP A LA PROFORMA----
                               C.ID AS ID_OCP,
                               C.TIP_COMPROBANTE AS TIP_OCP,
                               C.SER_COMPROBANTE AS SER_OCP,
                               C.NRO_COMPROBANTE AS NRO_OCP,
                               E.ID AS ID_OCP_DET
                        FROM   CMW_PEDIDOS_CABECERA C,
                               CMW_PEDIDOS_DETALLE E,
                               STW_ARTICULOS A
                       WHERE   C.ID = E.ID_PEDIDO_CAB
                         AND   E.ID_PEDIDO_CAB = :P330_REFERENCIA
                         AND   E.ID_ARTICULO = A.ID
                         AND   E.CANTIDAD != NVL(E.CANTIDAD_ANULADA,0)
                         AND   (E.ID_ARTICULO,E.ID,E.CANTIDAD) NOT IN (SELECT D1.ID_ARTICULO,
                                                                   D1.ID_OCP_DET, D1.CANTIDAD
                                                              FROM CMW_PROFORMAS_CABECERA C1,
                                                                   CMW_PROFORMAS_DETALLE  D1
                                                             WHERE C1.ID_EMPRESA = D1.ID_EMPRESA
                                                               AND C1.ID = D1.ID_PROFORMA_CABECERA
                                                               AND D1.ID_OCP = C.ID);
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P330_JSON_DETALLE:=JSON_DETALLE;
                    
                    END;
                    ```
                itemsToSubmit: P330_REFERENCIA
                itemsToReturn: P330_JSON_DETALLE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 260
        }
        when {
            selectionType: items
            items: P330_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P330_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P330_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P330_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P330_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P330_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P330_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P330_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P330_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P330_FEC_COMPROBANTE
                itemsToReturn: P330_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

