    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       A.COD_ORIGEN_ART,
                       A.ID_ENVASE,
                       D.CANTIDAD,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.MONTO_TOTAL_C_IVA,
                    --   D.IND_STOCK,
                       D.ID_PROFORMA_CABECERA,
                       D.PRECIO_UNITARIO_C_IVA,
                   --    D.PORC_DESCUENTO
                 --      D.DESCUENTO
                     --  D.DESCUENTO_C_IVA
                  --     D.PORC_GRAVADA,
                  --     D.IVA
                    --   D.EXENTO,
                    --   D.GRAVADA,
                      -- D.TOTAL_EXENTO,
                      -- D.TOTAL_GRAVADA
                       A.DESCRIPCION AS DESC_ARTICULO,
                       -----DATOS PARA RELACIONAR VARIAS OCP A LA PROFORMA----
                       D.ID_OCP,
                       D.TIP_OCP,
                       D.SER_OCP,
                       D.NRO_OCP,
                       D.ID_OCP_DET
                  from CMW_PROFORMAS_DETALLE D,STW_ARTICULOS A
                 where ID_PROFORMA_CABECERA=:P330_ID
                 AND A.ID=D.ID_ARTICULO
                ```
            pageItemsToSubmit: P330_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-Form--noPadding
                t-Form--labelsAbove
            ]
        }
