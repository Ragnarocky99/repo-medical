    computation p330-iva (
        itemName: P330_IVA_5
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                    WHERE :P330_ID=ID_COMPRAS_CAB;
                    item_detalle CMW_COMPRAS_DETALLE%rowtype;
                    v_total_iva_5    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P330_ID
        }
    )

