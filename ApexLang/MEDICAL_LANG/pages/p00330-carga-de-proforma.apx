    process recálculo-de-suma (
        name: Recálculo de suma
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update cmw_proformas_cabecera
                set tot_comprobante = (
                    select sum(MONTO_TOTAL_C_IVA)
                    from cmw_proformas_Detalle
                    where id_proforma_cabecera = :P330_ID
                )
                where id = :P330_ID;
                ```
        }
        execution {
            sequence: 50
        }
