    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                    case :APEX$ROW_STATUS
                            when 'C' then
                             
                             
                             --SELECT REPLACE(:TOTAL_IVA,'.','') INTO :TOTAL_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL_C_IVA,'.','') INTO :MONTO_TOTAL_C_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL,'.','') INTO :MONTO_TOTAL  FROM DUAL;
                
                                insert into CMW_PROFORMAS_DETALLE 
                                (ID_ARTICULO,ID_PROFORMA_CABECERA,CANTIDAD,TOTAL_IVA,MONTO_TOTAL_C_IVA,
                                 PRECIO_UNITARIO_C_IVA,PRECIO_UNITARIO,ID_UNIDAD_MEDIDA,COD_USUARIO_AUD,
                                 MONTO_TOTAL,ID_EMPRESA,ID_PEDIDO_REF,ID_OCP,TIP_OCP,SER_OCP,NRO_OCP,ID_OCP_DET 
                                )
                                values(:ID_ARTICULO,:P330_ID,:CANTIDAD,REPLACE(:TOTAL_IVA,'.',''),
                                REPLACE(:MONTO_TOTAL_C_IVA,'.',''),REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                :PRECIO_UNITARIO,:ID_UNIDAD_MEDIDA,:COD_USUARIO_AUD,
                                REPLACE(:MONTO_TOTAL,'.',''),:P0_ID_EMPRESA,:P330_REFERENCIA,
                                :ID_OCP,:TIP_OCP,:SER_OCP,:NRO_OCP,:ID_OCP_DET);
                            
                            WHEN 'U' then  
                         
                                update CMW_PROFORMAS_DETALLE  d
                                    set  ID_ARTICULO = :ID_ARTICULO,
                                         cantidad     = :cantidad,
                                         precio_unitario_c_iva       = REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                         --id_iva     = :ID_IVA,
                                         TOTAL_IVA    = REPLACE(:TOTAL_IVA,'.',''),
                                         monto_total  = REPLACE(:MONTO_TOTAL,'.',''),
                                         MONTO_TOTAL_C_IVA      = REPLACE(:MONTO_TOTAL_C_IVA,'.',''),
                                         PRECIO_UNITARIO=REPLACE(:PRECIO_UNITARIO,'.',''),
                                         ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                                         ID_PEDIDO_REF=:P330_REFERENCIA,
                                         --IVA=:IVA
                                        --ID_LOTE=:ID_LOTE
                                         --NRO_LOTE=:NRO_LOTE,
                                         ID_OCP = :ID_OCP,
                                         TIP_OCP = :TIP_OCP,
                                         SER_OCP = :SER_OCP,
                                         NRO_OCP = :NRO_OCP,
                                         ID_OCP_DET = :ID_OCP_DET
                
                                where   d.ID_PROFORMA_CABECERA = :P330_ID
                                    and d.id = :id;
                
                           when 'D' then
                                delete CMW_PROFORMAS_DETALLE d     
                                WHERE /*d.ID_PROFORMA_CABECERA = :ID_PEDIDO_CAB
                                           and*/ d.id = :id;  
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 15579980086990684
        }
        comments {
            comments: "Proceso para guardar, actualizar, eliminar los detalles de la factura "
        }
    )

