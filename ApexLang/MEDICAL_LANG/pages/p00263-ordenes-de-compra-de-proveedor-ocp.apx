        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 7
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button ejecutar (
        buttonName: EJECUTAR
        label: Ejecutar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P263_PROVEEDOR
                P263_NRO_ORDEN
                P263_FEC_DESDE
                P263_FEC_HASTA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ordenes-de-compra
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

