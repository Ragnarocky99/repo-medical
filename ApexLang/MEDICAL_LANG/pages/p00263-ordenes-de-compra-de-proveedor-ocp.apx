    region ordenes-de-compra (
        name: Ordenes de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.ID,
                       P.ID_EMPRESA,
                       P.TIP_COMPROBANTE,
                       P.SER_COMPROBANTE,
                       P.NRO_COMPROBANTE,
                       P.ID_SUCURSAL,
                       P.FEC_COMPROBANTE,
                       P.ID_PROVEEDOR,
                       P.ID_CONDICION_COMPRA,
                       P.TOT_COMPROBANTE,
                       P.TOT_GRAVADAS,
                       P.TOT_EXENTAS,
                       P.TOT_IVA,
                       P.DESCUENTO,
                       P.ID_MONEDA,
                       P.TIP_CAMBIO,
                       P.VERIFICADORA,
                       P.TRANSPORTE,
                       P.ID_VIA,
                       P.FEC_EMBARQUE,
                       P.FEC_CONFIRMACION,
                       ----P.ESTADO,
                       /*CASE
                        WHEN P.ESTADO = 'C' AND NVL(P.ANULADO,'N') != 'S' THEN
                          'CERRADO'
                        WHEN nvl(P.ESTADO,'P') = 'P' AND NVL(P.ANULADO,'N') != 'S' THEN
                          'PENDIENTE'
                        WHEN P.ANULADO = 'S' THEN
                         'ANULADO'
                        WHEN P.ESTADO IS NULL AND NVL(P.ANULADO,'N') != 'S' THEN
                         'PARCIAL'
                     end as estado,*/
                       
                       OBTENER_ESTADO_OCP(P.ID) ESTADO,
                       P.FEC_ESTADO,
                       P.ID_USUARIO,
                       P.FEC_ALTA,
                       CASE P.ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       ICONO_ANULADO,
                       P.CAMBIO_MONEDA_PRECIO,
                       P.TIP_COMPROBANTE_REF,
                       P.SER_COMPROBANTE_REF,
                       P.NRO_COMPROBANTE_REF,
                       P.REFERENCIA,
                       P.ID_PROVEEDOR_REF,
                       P.COD_USUARIO_AUD,
                       P.ID_ENTSAL_CAB,
                       P.FAC_REFERENCIA,
                       P.ID_SUCURSAL_CENTRAL,
                       P.COMENTARIO,
                       P.FEC_ANULACION,
                       P.ANULADO,
                      CASE P.TIPO 
                      WHEN 'IMP' THEN 'IMPORTACION'
                      WHEN 'LOC' THEN 'LOCAL'
                      END AS TIPO_PEDIDO,
                      sys.dbms_lob.getlength(P.FOTO_COMPROBANTE),
                      P.PROFORMA
                  from CMW_PEDIDOS_CABECERA P
                 where P.ID_EMPRESA      = :P0_ID_EMPRESA
                   AND P.ID_SUCURSAL = :P0_ID_SUCURSAL
                   AND (P.ID_PROVEEDOR    = :P263_PROVEEDOR OR :P263_PROVEEDOR IS NULL)
                   AND (P.FEC_COMPROBANTE  BETWEEN :P263_FEC_DESDE AND  :P263_FEC_HASTA)
                   AND (P.NRO_COMPROBANTE = :P263_NRO_ORDEN OR :P263_NRO_ORDEN IS NULL)
                   AND P.IND_TIPO_OC = 'ST'
                 ORDER BY NRO_COMPROBANTE DESC
                ```
            pageItemsToSubmit: [
                P263_PROVEEDOR
                P263_NRO_ORDEN
                P263_FEC_DESDE
                P263_FEC_HASTA
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
