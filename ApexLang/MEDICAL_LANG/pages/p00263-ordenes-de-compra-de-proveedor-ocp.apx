    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            try {
              var model = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
              var v_nro_occ = model.getFieldKey("NRO_OCC");
               
              
              var numeroIngre = $v('P628_NRO_OCC');
            
              model.forEach(function(r, index, id) {
                var meta = model.getRecordMetadata(id);
                if ((meta.fields !== undefined) && (!meta.deleted)) {
            
                  model.setValue(r, v_nro_occ, numeroIngre);
                }
              });
            
            } catch (e) {
              // Manejar errores aquí
              console.error("Se produjo un error:", e);
            }
            
            function calculaTotal(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("PRECIO_TOTAL_COPIA");
                var v_cantidad_aprobada = model.getFieldKey("CANTIDAD_APROBADA_COPIA") || ("CANTIDAD_COPIA");
            
                var v_total_cantidad          = 0;
                var v_total_cant_aprobado     = 0;
            
                model.forEach(function(r, index, id) {
                        v_total_cantidad           = v_total_cantidad     + parseFloat(r[v_cantidad].replace(/\./g,''));
                        v_total_cant_aprobado      = v_total_cant_aprobado     + parseFloat(r[v_cantidad_aprobada].replace(/\./g,''));
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
               
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
                 if(isNaN(v_total_cant_aprobado)){
                     v_total_cant_aprobado=1;
                 }
            
                 $s('P628_TOTAL_GENERAL',v_total_cantidad);
                 $s('P628_CANTIDAD_TOTAL',v_total_cant_aprobado);
            
            
            }
            
            ```
    }
