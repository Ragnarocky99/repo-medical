page 103 (
    name: Ejercicios
    alias: EJERCICIOS
    title: Ejercicios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region ejercicios (
        name: Ejercicios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_EJERCICIO,
                       FEC_INICIO,
                       FEC_FINAL,
                       ID_PER_DUENO,
                       ID_PER_REPRES_LEGAL,
                       ID_PER_CONTADOR,
                       NUM_FORMULARIO,
                       NUM_ORDEN,
                       ESTADO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       REPRESENTANTE_LEGAL,
                       CONTADOR,
                       RUC_CONTADOR,
                       ID_PLAN_CUENTA,
                       COD_USUARIO_AUD
                  from COW_EJERCICIOS
                 where ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 104
                items: {
                    P104_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 13532389764259126
        }

        column COD_EJERCICIO (
            type: plainText
            heading {
                heading: Cód. Ejercicio
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Usuario Auditor
            }
            layout {
                sequence: 43
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column CONTADOR (
            type: hidden
            heading {
                heading: Contador
            }
            layout {
                sequence: 53
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 12
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ESTADO_ICON (
            type: plainText
            heading {
                heading: Estado Icon
                alignment: center
            }
            layout {
                sequence: 113
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        column FEC_FINAL (
            type: plainText
            heading {
                heading: Fecha Final
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column FEC_INICIO (
            type: plainText
            heading {
                heading: Fecha Inicio
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: plainText
            heading {
                heading: Id Empresa
                alignment: center
            }
            layout {
                sequence: 63
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_PER_CONTADOR (
            type: plainText
            heading {
                heading: Id Per Contador
                alignment: center
            }
            layout {
                sequence: 93
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: U
            }
        )

        column ID_PER_DUENO (
            type: plainText
            heading {
                heading: Id Per Dueno
                alignment: center
            }
            layout {
                sequence: 73
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column ID_PER_REPRES_LEGAL (
            type: plainText
            heading {
                heading: Id Per Repres Legal
                alignment: center
            }
            layout {
                sequence: 83
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: T
            }
        )

        column ID_PLAN_CUENTA (
            type: plainText
            heading {
                heading: Id Plan Cuenta
                alignment: center
            }
            layout {
                sequence: 103
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: V
            }
        )

        column NUM_FORMULARIO (
            type: plainText
            heading {
                heading: Nro. Formulario
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column NUM_ORDEN (
            type: plainText
            heading {
                heading: Nro. Orden
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column REPRESENTANTE_LEGAL (
            type: plainText
            heading {
                heading: Representante Legal
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column RUC_CONTADOR (
            type: plainText
            heading {
                heading: RUC Contador
            }
            layout {
                sequence: 33
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                EJERCICIOS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 135419 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_EJERCICIO (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 8
            )

            displayColumn ESTADO (
                sequence: 9
            )

            displayColumn FEC_FINAL (
                sequence: 3
            )

            displayColumn FEC_INICIO (
                sequence: 2
            )

            displayColumn NUM_FORMULARIO (
                sequence: 5
            )

            displayColumn NUM_ORDEN (
                sequence: 6
            )

            displayColumn REPRESENTANTE_LEGAL (
                sequence: 7
            )

            displayColumn RUC_CONTADOR (
                sequence: 4
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @ejercicios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 104
                clearCache: 104
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ejercicios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ejercicios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17377160182575120
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

