    dynamicAction setear-cantidad-y-valores (
        name: setear cantidad y valores
        execution {
            sequence: 110
        }
        when {
            event: click
            selectionType: button
            button: @cargar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Get the selected value from the Popup LOV Page Item
                    var selectedValue = $v("P632_PROVEEDOR"); // Replace with your Page Item name
                    
                    // Get a reference to the Interactive Grid region
                    var igRegion = apex.region("Detalles"); // Replace with your Interactive Grid Static ID
                    
                    // Get the model for the Interactive Grid
                    var model = igRegion.widget().interactiveGrid("getViews", "grid").model;
                    
                    // Get the specific column you want to update (replace "proveedorgrid" with the actual column name)
                    var columnKey = model.getFieldKey("ID_PROVEEDOR");
                    
                    // Loop through the selected rows and set the value in the column
                    var selectedRecords = model.getSelectedRecords();
                    selectedRecords.forEach(function (record) {
                        model.setValue(record,'ID_PROVEEDOR', selectedValue);
                    });
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Get the selected value from the Popup LOV Page Item
                    var selectedValue = $v("P632_MONEDA"); // Replace with your Page Item name
                    
                    // Get a reference to the Interactive Grid region
                    var igRegion = apex.region("Detalles"); // Replace with your Interactive Grid Static ID
                    
                    // Get the model for the Interactive Grid
                    var model = igRegion.widget().interactiveGrid("getViews", "grid").model;
                    
                    // Get the specific column you want to update (replace "proveedorgrid" with the actual column name)
                    var columnKey = model.getFieldKey("ID_MONEDA");
                    
                    // Loop through the selected rows and set the value in the column
                    var selectedRecords = model.getSelectedRecords();
                    selectedRecords.forEach(function (record) {
                        model.setValue(record,'ID_MONEDA', selectedValue);
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-3 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try{
                    var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                        var id_proveedor              = $v('P632_PROVEEDOR');
                        var id_condicion_compra       = $v('P632_CONDICION');
                        var v_moneda                  = $v('P632_MONEDA');
                    
                        model.forEach(function(r, index, id) {
                    
                            var meta = model.getRecordMetadata(id);
                            if ((meta.fields != undefined) && (!meta.deleted)){
                                model.setValue(r,'ID_PROVEEDOR',id_proveedor);  
                                model.setValue(r,'ID_MONEDA',v_moneda);
                                model.setValue(r,'ID_CONDICION_COMPRA',id_condicion_compra);
                    
                            }
                            
                        });
                    
                        
                    
                    }catch(e){
                    
                    }
                    
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression: $( "Detalles" ).grid( "focus" );
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

