                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: [
                    ID_MONEDA_COSTO
                    ID_CONDICION_COMPRA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

