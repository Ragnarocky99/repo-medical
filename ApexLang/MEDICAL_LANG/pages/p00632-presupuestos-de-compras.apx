        action native-javascript-code-3 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden=0;
                    var json_detalle=JSON.parse($v('P632_JSON_DETALLES'));
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    var $widget= apex.region("Detalles").widget();
                    var $grid= $widget.interactiveGrid("getViews","grid");
                    var $model = $grid.model;
                    $grid.setEditMode(true);
                    var newRecordId=$model.insertNewRecord();
                    var $newRecord=$model.getRecord(newRecordId);
                    orden=orden+1;
                    if((json_detalle.DETALLE[i].NUM_ORDEN!=null)){
                    $model.setValue($newRecord,"NRO_ITEM",(json_detalle.DETALLE[i].NUM_ORDEN).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_ARTICULO!=null)){
                    $model.setValue($newRecord,"ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                    $model.setValue($newRecord,"CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].DESCRIPCION!=null)){
                    $model.setValue($newRecord,"DESC_ARTICULO",(json_detalle.DETALLE[i].DESCRIPCION).toString());
                    }
                    if((json_detalle.DETALLE[i].DESC_ARTICULO_STD!=null)){
                    $model.setValue($newRecord,"DESC_ARTICULO_STD",(json_detalle.DETALLE[i].DESC_ARTICULO_STD).toString());
                    }
                    
                    
                    $model.setValue($newRecord,"ID_ENVASE",(json_detalle.DETALLE[i].ID_ENVASE).toString());
                    
                    
                    $model.setValue($newRecord,"ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA).toString());
                    
                    if((json_detalle.DETALLE[i].ID_MARCA!=null)){
                    $model.setValue($newRecord,"ID_MARCA",(json_detalle.DETALLE[i].ID_MARCA).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                    $model.setValue($newRecord,"CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].COD_ARTICULO!=null)){
                    $model.setValue($newRecord,"COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].COD_ORIGEN_ART!=null)){
                    $model.setValue($newRecord,"COD_ORIGEN_ART",(json_detalle.DETALLE[i].COD_ORIGEN_ART).toString());
                    }
                    if((json_detalle.DETALLE[i].ID!=null)){
                    $model.setValue($newRecord,"ID_PEDIDO_DET",(json_detalle.DETALLE[i].ID).toString());
                    }
                    
                    $model.setValue($newRecord,"ID_RUBRO",(json_detalle.DETALLE[i].ID_RUBRO).toString());
                    
                    if((json_detalle.DETALLE[i].OBS_COMPRA!=null)){
                    $model.setValue($newRecord,"OBS_COMPRA",(json_detalle.DETALLE[i].OBS_COMPRA).toString());
                    }
                    if((json_detalle.DETALLE[i].COMENTARIO_PED!=null)){
                    $model.setValue($newRecord,"COMENTARIO_PED",(json_detalle.DETALLE[i].COMENTARIO_PED).toString());
                    }
                    $model.setValue($newRecord, "IND_GESTION","S");
                    $model.setValue($newRecord,"IND_CLIENTE","N");
                    if((json_detalle.DETALLE[i].ID_PROVEEDOR!=null)){
                    $model.setValue($newRecord,"ID_PROVEEDOR",{v:(json_detalle.DETALLE[i].ID_PROVEEDOR).toString(),d:(json_detalle.DETALLE[i].NOMBRE_PROVEEDOR).toString()});
                    }
                    if((json_detalle.DETALLE[i].ID_MONEDA!=null)){
                    $model.setValue($newRecord,"ID_MONEDA",(json_detalle.DETALLE[i].ID_MONEDA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_TIPO_ENTREGA!=null)){
                    $model.setValue($newRecord,"ID_TIPO_ENTREGA",(json_detalle.DETALLE[i].ID_TIPO_ENTREGA).toString());
                    }
                    if((json_detalle.DETALLE[i].COSTO_UNITARIO!=null)){
                    $model.setValue($newRecord,"PRECIO",(json_detalle.DETALLE[i].COSTO_UNITARIO).toString().replaceAll('.',','));
                    }
                    if((json_detalle.DETALLE[i].COSTO_TOTAL !=null)){
                    $model.setValue($newRecord,"MON_COSTO",(json_detalle.DETALLE[i].COSTO_TOTAL).toString().replaceAll('.',','));
                    }
                    if((json_detalle.DETALLE[i].TIP_CAMBIO !=null)){
                    $model.setValue($newRecord,"CAMBIO",(json_detalle.DETALLE[i].TIP_CAMBIO).toString());
                    }
                    if((json_detalle.DETALLE[i].IND_CLIENTE !=null)){
                    $model.setValue($newRecord,"IND_CLIENTE",(json_detalle.DETALLE[i].IND_CLIENTE).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_CONDICION_COMPRA !=null)){
                    $model.setValue($newRecord,"ID_CONDICION_COMPRA",(json_detalle.DETALLE[i].ID_CONDICION_COMPRA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_OFERTA_LIC !=null)){
                    $model.setValue($newRecord,"ID_OFERTA_LIC",(json_detalle.DETALLE[i].ID_OFERTA_LIC).toString());
                    }
                    }
                    }
                    ```
            }
            execution {
                sequence: 70
            }
