    process cambio (
        name: CAMBIO
        type: executeCode
        editableRegion: @presupuestos-de-compras
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  IF :CAMBIO IS NULL THEN
                     SELECT TIP_CAMBIO , TIP_CAMBIO
                     INTO   :CAMBIO , :TIP_CAMBIO_MONEDA_PRECIO
                     FROM VTW_PEDIDOS_CABECERA WHERE ID = :ID_PEDIDO;
                     
                  END IF ;
                
                EXCEPTION
                 WHEN OTHERS THEN 
                 NULL;
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 74069194741590823
        }
    )

    process cotiza-auto (
        name: Cotiza auto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    vid_cotiza cmw_cotiza_articulos.id%type;
                begin
                    select ca.id
                      into vid_cotiza
                      from cmw_cotiza_articulos ca
                     where ca.id_pedido = :P632_ID_PEDIDO
                    order by ca.id desc
                    fetch first 1 row only;
                
                    CMPW_COTIZA_ARTICULO_IA(
                            p_id_empresa    => :P0_ID_EMPRESA,
                            p_id_sucursal   => :P0_ID_SUCURSAL,
                            p_id_pedido_cab => NULL,
                            p_id_cotiza     => vid_cotiza);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 11499159331128913
        }
        serverSideCondition {
            type: never
        }
    )

