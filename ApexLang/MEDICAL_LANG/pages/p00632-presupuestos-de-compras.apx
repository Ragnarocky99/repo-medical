            type: itemColumnIsNotNull
            column: ID_PROVEEDOR
        }

        action id-tipo-entrega (
            name: ID_TIPO_ENTREGA
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PR.ID_TIPO_ENTREGA
                      FROM CMW_PROVEEDORES PR
                     WHERE PR.ID = :ID_PROVEEDOR
                       AND EXISTS (
                           SELECT 1
                             FROM STW_ARTICULOS AR
                            WHERE AR.ID = :ID_ARTICULO
                              AND NVL(AR.IND_PELIGROSO, 'N') = 'N'
                       )
                    UNION ALL
                    SELECT PR.ID_TIPO_ENTREGA_PELIGROSO
                      FROM CMW_PROVEEDORES PR
                     WHERE PR.ID = :ID_PROVEEDOR
                       AND EXISTS (
                           SELECT 1
                             FROM STW_ARTICULOS AR
                            WHERE AR.ID = :ID_ARTICULO
                              AND NVL(AR.IND_PELIGROSO, 'N') = 'S'
                       )
                       
                    
                    ```
                itemsToSubmit: [
                    ID_PROVEEDOR
                    ID_ARTICULO
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: ID_TIPO_ENTREGA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action moneda-condicion-proveedor (
            name: Moneda, Condicion, Proveedor
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PR.ID_MONEDA, PR.ID_CONDICION_COMPRA
                      FROM CMW_PROVEEDORES PR
                      JOIN BSW_PERSONAS    PE ON PE.ID = PR.ID_PERSONA
                     WHERE PR.ID = :ID_PROVEEDOR
                    ```
