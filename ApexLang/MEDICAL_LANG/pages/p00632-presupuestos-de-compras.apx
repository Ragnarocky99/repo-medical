    region licitacion (
        name: Licitacion
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID ID_LICITACION_CAB,
                       NRO_LICITACION,
                       NRO_ID_LICITACION,
                       ID_CLIENTE ID_CLIENTE_LIC,
                       COD_USUARIO_DESPACHANDO COD_USUARIO_DESPACHANDO_LIC
                  FROM LCW_LICITACIONES_CAB
                ```
        }
        layout {
            sequence: 30
            parentRegion: @carga-de-gestion-de-pedido
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P632_ID_LICITACION_CAB
        }
    )

    region nº-solicitud (
        name: Nº Solicitud
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID
                from CMW_COTIZA_ARTICULOS
                where :P632_ID = :ID
                ```
