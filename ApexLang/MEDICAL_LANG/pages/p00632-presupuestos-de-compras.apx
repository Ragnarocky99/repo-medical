        action id-proveedor (
            name: ID_PROVEEDOR
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VSALDO_STOCK  NUMBER := OBTENER_CANTIDAD_EXISTENTE(:ID_ARTICULO, NULL, 'N');
                        VID_PROVEEDOR CMW_PROVEEDORES.ID%TYPE;
                    BEGIN
                        IF VSALDO_STOCK > 0 THEN
                            BEGIN
                                SELECT ID
                                  INTO VID_PROVEEDOR
                                  FROM CMW_PROVEEDORES
                                 WHERE COD_PROVEEDOR = W_BUSCA_PARAMETRO('CM', 'COD_PROVEEDOR_EMPRESA')
                                   AND ID_EMPRESA = :P0_ID_EMPRESA;
                            END;
                        END IF;
                    
                        RETURN VID_PROVEEDOR;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: ID_PROVEEDOR
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

