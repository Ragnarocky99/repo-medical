                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region ofertas (
        name: Ofertas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT OL.ID,
                       OL.ID_EMPRESA,
                       OL.ID_ARTICULO,
                       OL.ID_LICITACION_CAB,
                       OL.ID_LICITACION_DET,
                       OL.ID_PROVEEDOR,
                       LD.NRO_ITEM,
                       AR.COD_ARTICULO,
                       AR.COD_ORIGEN_ART,
                       OL.DESC_ARTICULO,
                       OL.ID_MARCA,
                       OL.ID_ENVASE,
                       OL.ID_UNIDAD_MEDIDA,
                       OL.ID_TIPO_ENTREGA,
                       OL.ID_CONDICION_COMPRA,
                       OL.ID_MONEDA_COSTO,
                       OL.TIP_CAMBIO_COSTO,
                       OL.COSTO_UNITARIO,
                       OL.CANTIDAD,
                       OL.COSTO_TOTAL,
                       OL.IND_COTIZAR,
                       OL.IND_GESTION,
                       OL.ID_MONEDA_PRESUPUESTO,
                       OL.TIP_CAMBIO_PRESUPUESTO,
                       LD.ESPECIFICACION_TECNICA,
                       OL.OBS_COMPRA,
                       OL.COMENTARIO_COMPRAS,
                       CASE
                        WHEN OL.IND_GESTION = 'S' AND OL.IND_COTIZAR = 'N' THEN 'UD'
                        WHEN NVL((SELECT SUM(OA.CANTIDAD * DECODE(OA.TIPO, 'AN', -1, 1)) CANTIDAD
                                   FROM LCW_OFERTAS_APROBACIONES OA
                                  WHERE OA.ID_OFERTA = OL.ID
                                 GROUP BY OA.ID_OFERTA), 0) > 0 THEN ''
                        ELSE ''
                       END ROW_OPERATION,
                       OL.IND_ALTERNATIVA,
                       OL.COD_USUARIO_COTIZA,
                       OL.IND_REEMPLAZO
                     FROM LCW_OFERTAS          OL
                     JOIN STW_ARTICULOS        AR ON AR.ID = OL.ID_ARTICULO
                     JOIN LCW_LICITACIONES_DET LD ON LD.ID = OL.ID_LICITACION_DET
                LEFT JOIN CMW_PROVEEDORES      PR ON PR.ID = OL.ID_PROVEEDOR
                LEFT JOIN BSW_PERSONAS         PP ON PP.ID = PR.ID_PERSONA
                    WHERE OL.ID_LICITACION_CAB = :P632_ID_LICITACION_CAB
                ```
        }
        layout {
            sequence: 10
            parentRegion: @licitacion
            slot: subRegions
        }
