    dynamicAction setear-id-licitacion-det (
        name: Setear ID_LICITACION_DET
        execution {
            sequence: 380
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: NRO_ITEM
        }

        action id-licitacion-det (
            name: ID_LICITACION_DET
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        VID_LICITACION_DET LCW_LICITACIONES_DET.ID%TYPE;
                    BEGIN
                        SELECT ID
                          INTO VID_LICITACION_DET
                          FROM LCW_LICITACIONES_DET
                         WHERE ID_LICITACION_CAB = :P632_ID_LICITACION_CAB
                           AND NRO_ITEM = :NRO_ITEM;
                        
                        RETURN VID_LICITACION_DET;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RAISE_APPLICATION_ERROR(-20000, 'No existe el numero de item '||:NRO_ITEM);
                        WHEN TOO_MANY_ROWS THEN
                            RAISE_APPLICATION_ERROR(-20000, 'Se encontró varios nro. de item '||:NRO_ITEM||'. Seleccione el item haciendo doble click.');
                        WHEN OTHERS THEN
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    ```
                itemsToSubmit: [
                    P632_ID_LICITACION_CAB
                    NRO_ITEM
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: ID_LICITACION_DET
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction verificar-errores-antes-redir (
        name: Verificar errores antes redir
        execution {
            sequence: 250
        }
        when {
            event: region/interactiveGrid/interactivegridsave
            selectionType: region
            region: @presupuestos-de-compras
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.page.validate(function (valid) {
                        if (valid) {
                            // Validation passed, proceed with the default save operation.
                            apex.page.submit('SAVE');
                            window.location.href = 'f?p=&APP_ID.:50:&SESSION.';
                        } else {
                            // Validation failed, show error messages in the standard alert box.
                            apex.message.showErrors();
                        }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation validar-cotizacion (
        name: Validar Cotizacion
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @presupuestos-de-compras
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  IF replace(:PRECIO,'.','') > 0 AND :IND_CLIENTE = 'S'  THEN
                    IF :ID_PROVEEDOR IS NULL OR :ID_TIPO_ENTREGA IS NULL OR :ID_MONEDA IS NULL
                       OR :ID_CONDICION_COMPRA IS NULL  THEN
                         return False;
                    END IF;
                   ELSIF replace(:PRECIO,'.','') = 0  OR replace(:PRECIO,'.','') IS NULL AND :IND_CLIENTE = 'S'  THEN
                     RETURN TRUE;
                  END IF;
                END;
                ```
        }
        error {
            errorMessage: No puede Enviar sin antes completar los campos requeridos!!!
            associatedColumn: IND_CLIENTE
        }
    )

