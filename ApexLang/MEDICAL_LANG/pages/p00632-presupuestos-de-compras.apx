    region pedido (
        name: Pedido
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @carga-de-gestion-de-pedido
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P632_ID_PEDIDO
        }
    )

    region presupuestos-de-compras (
        name: Presupuestos de compras
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       c.ID_SUCURSAL,
                       C.ID_ARTICULO,
                       C.ID_PROVEEDOR,
                       C.ID_MONEDA,
                       C.PRECIO,
                       C.PRECIO*C.cantidad AS mon_costo,
                       C.PRECIO AS mon_costo_copia,
                       C.APROBADO,
                       C.TIPO_IVA,
                       C.PORCENTAJE_DESCUENTO,
                       C.CANTIDAD,
                       C.COD_ARTICULO_REF,
                       C.NRO_ITEM,
                       C.SALDO,
                       C.OBSERVACION,
                       C.COTIZA,
                       C.COD_USUARIO_APRO,
                       C.CAMBIO,
                       C.TIP_CAMBIO_MONEDA_PRECIO,
                       C.ID_CONDICION_COMPRA,
                       C.IND_GENERA_OC,
                       C.IND_ORDEN,
                       A.ID_ENVASE,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MARCA,
                       A.COD_ARTICULO,
                       A.COD_ORIGEN_ART,
                       C.DESC_ARTICULO,--nvl(C.DESC_ARTICULO, a.descripcion) AS DESC_ARTICULO,
                       --C.DESC_ARTICULO_STD,
                       (SELECT DESC_ARTICULO_STD
                          FROM VTW_PEDIDOS_DETALLE 
                         WHERE ID = C.ID_PEDIDO_DET) AS DESC_ARTICULO_STD,
                       C.ID_PEDIDO,
                       C.ID_TIPO_ENTREGA,
                       C.ID_USUARIO,
                       A.ID_GRUPO_ART,
                       C.ID_PEDIDO_DET,
                       A.ID_RUBRO,
                       C.IND_GESTION,
                       C.OBS_COMPRA,
                       C.COMENTARIO_PED,
                       ''VACIO/*,
                       CASE
                        WHEN A.COD_ARTICULO = 1 THEN '1' -- Read-only for COD_ARTICULO = 1
                        ELSE 'Y' -- Editable for other rows
                    END AS READ_ONLY_FLAG*/
                       ,DECODE (C.ID_ARTICULO,726,'X','UD') as EDITABLE,
                       C.IND_CLIENTE,
                       C.FEC_RESPUESTA,
                       c.id_oferta_lic,
                       C.INSERT_AUTO,
                       C.COMENTARIO_A_COMPRA,
                       C.OBSERVACION_AUTO,
                       C.IND_EXCEL_AUTO,
                       C.IND_ALTERNATIVA,
                       C.MOTIVO_RECOTIZACION,
                       C.VENCIMIENTO_PRODUCTO,
                       C.COD_USUARIO_COTIZA,
                       C.IND_REEMPLAZO
                  from CMW_COTIZA_ARTICULOS C, STW_ARTICULOS A-----, STW_EXISTENCIA_ART E --, VTW_PEDIDOS_CABECERA PC, VTW_PEDIDOS_DETALLE PD
                  WHERE A.ID           = C.ID_ARTICULO
                  AND   A.ID_EMPRESA   = C.ID_EMPRESA
                 ----- AND   C.ID_ARTICULO  = E.ID_ARTICULO(+)
                  --AND (E.CANT_DISPON IS NULL OR E.CANT_DISPON = 0)
                  AND   C.ID_EMPRESA   = :P0_ID_EMPRESA
                  AND   C.ID_PEDIDO    = :P632_ID_PEDIDO
                  and nvl(a.ind_maneja_stock,'S') != 'N'
                
                  ---AND   NVL( C.IND_CLIENTE,'S') = 'N'
                  ----AND   C.ID_PROVEEDOR IS NOT NULL
                
                  --- funciona con los pedidos cargados desde 
                  --- la fecha 06/03/2024,se agrego para tener control de los art que pasan por gestion y no genere duplicados
                  AND c.ID  IN (SELECT NVL(B.ID,0)
                                     FROM CMW_COTIZA_ARTICULOS B
                                    WHERE B.ID_PEDIDO = C.Id_Pedido
                                      AND B.ID_PEDIDO_DET = C.id_pedido_det
                                      AND NVL(B.IND_GESTION,'N') = 'S'
                                      AND NVL(B.FEC_OCC,'06/03/2024') >= '06/03/2024')
                
                
                  
                
                  --AND   C.ID_PEDIDO  = PC.ID
                  --AND   PC.ID  = PD.ID_PEDIDO_CABECERA
                
                  --AND   C.ID = :P632_ID
                 -- AND   C.ID_PEDIDO = :P632_ID_PEDIDO
                  --AND C.ID_PEDIDO = CB.ID
                  -----------AND CB.ID = :P632_ID_PEDIDO
                  --AND CB.ID = VD.ID_PEDIDO_CABECERA
                  --AND CB.ID = C.ID_PEDIDO
                
                ```
            pageItemsToSubmit: [
                P632_ID_PEDIDO
                P632_ID_PEDIDO_DET
                P0_ID_EMPRESA
            ]
        }
        layout {
            sequence: 10
            parentRegion: @pedido
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        readOnly {
            type: expression
            plsqlExpression: NVL(:P632_COD_USUARIO_DESPACHANDO, 0) != TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER)
        }
