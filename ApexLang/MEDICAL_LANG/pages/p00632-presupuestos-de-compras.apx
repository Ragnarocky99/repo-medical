                jsCode:
                    ```javascript-browser
                    //variables
                    var v_tipcomp = $v("#COD_ARTICULO");
                    var igRegion = apex.region("Detalles");
                    var ig = igRegion.call("getViews", "grid");
                    var records = ig.getSelectedRecords();
                    if (v_tipcomp == "1"){
                        var cellValue = records[0].get("COD_ARTICULO");
                    
                        // Now, cellValue contains the value of the specified column in the selected row.
                        console.log("Cell Value: " + cellValue);
                        //Set readonly
                        $("#CANTIDAD").prop('readonly', true);
                        $("#PRECIO").prop('readonly', true);
                        $("#COD_ARTICULO").prop('readonly', true);    
                        //Add/Remove CSS
                        
                    
                    }else {
                    
                        //Set readonly
                        $("#CANTIDAD").prop('readonly', false);
                        $("#PRECIO").prop('readonly', false);
                        $("#COD_ARTICULO").prop('readonly', false);
                    
                        //Add/Remove CSS
                        
                    
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

