    dynamicAction actualizar-totales (
        name: Actualizar totales
        execution {
            sequence: 390
        }
        when {
            selectionType: columns
            interactiveGrid: @ofertas
            columns: CANTIDAD
        }

        action costo-total (
            name: COSTO_TOTAL
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: ROUND(REPLACE(:COSTO_UNITARIO, '.', '') * :CANTIDAD, MONEDA_DECIMALES(:ID_MONEDA_COSTO))
                itemsToSubmit: [
                    COSTO_UNITARIO
                    CANTIDAD
                    ID_MONEDA_COSTO
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: COSTO_TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction aud-respuesta (
        name: aud_respuesta
        execution {
            sequence: 270
        }
        when {
            selectionType: columns
            interactiveGrid: @presupuestos-de-compras
            columns: IND_CLIENTE
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vfec VARCHAR2(20);
                    BEGIN
                        IF NVL(:IND_CLIENTE,'N') = 'S' THEN
                            vfec := /*SYSDATE*/TO_CHAR(SYSDATE,'DD/MM/YYYY HH24:MI');
                        ELSE
                            vfec := NULL;        
                        END IF;
                        RETURN vfec;
                    END;
                    ```
                itemsToSubmit: IND_CLIENTE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: FEC_RESPUESTA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @presupuestos-de-compras
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    NVL(A.ESTADO,'N')='S'
                    AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P632_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calc-total (
        name: CALC_TOTAL
        execution {
            sequence: 70
        }
        when {
            selectionType: columns
            interactiveGrid: @presupuestos-de-compras
            columns: MON_COSTO
        }
        serverSideCondition {
            type: never
        }

        action calcular-totales (
            name: Calcular Totales
            action: executeJsCode
            settings {
                jsCode: calculaTotalBienes();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MON_COSTO
                itemsToSubmit: MON_COSTO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: MON_COSTO_COPIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cambiar-montos (
        name: Cambiar Montos
        execution {
            sequence: 90
        }
        when {
            selectionType: columns
            interactiveGrid: @presupuestos-de-compras
            columns: CANTIDAD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :CANTIDAD IS NULL THEN 
                    :CANTIDAD:=1;
                    END IF;
                    
                    IF :PRECIO IS NULL THEN
                    :PRECIO:=0;
                    END IF;
                    
                    
                    :MON_COSTO:=:CANTIDAD*replace(:PRECIO,'.','');
                    
                    
                    
                    
                    
                    
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO
                ]
                itemsToReturn: MON_COSTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    recalculaTotales();
                    
                    ```
            }
            affectedElements {
                selectionType: columns
                columns: MON_COSTO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: columns
                columns: MON_COSTO_COPIA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-detalles (
        name: Cargar Detalles
        execution {
            sequence: 130
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P632_ID_PEDIDO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                      OPEN l_cursor FOR
                      --CUANDO SE CARGA EL PEDIDO NO CONSIDERA EXISTENCIA EN BLOQUEO PERO SI CUANDO COTIZAN ???????????????????????????????????????????
                      --EN LA CARGA DE PEDIDOS GUARDAN LA DIFERENCIA QUE HUBO EN ESE MOMENTO QUE ES LO QUE TENDRIA QUE TRAER EN ESTA PANTALLA
                      --PERO NO TRAE YA QUE AL CONSIDERAR EXISTENCIA BLOQUEADA TRAE UNA MAYOR CANTIDAD YA QUE EL SISTEMA CONSIDERA QUE SE NECESITA COMPRAR 
                      --MAS ARTICULOS.
                      --SELECT ORIGINAL CONSIDERANDO BLOQUEO
                    
                    
                    --SELECT DONDE TRAIGO LA DIFERENCIA QUE SE GUARDO EN ESE MOMENTO
                        SELECT D.NUM_ORDEN,
                               D.ID_ARTICULO,
                               ---A.ID_GRUPO_ART,
                               D.DESC_ARTICULO DESCRIPCION,
                               A.ID_ENVASE,
                               A.ID_UNIDAD_MEDIDA,
                               A.ID_MARCA,
                               ---D.CANTIDAD,
                                ABS(D.DIFERENCIA) AS CANTIDAD,
                               A.COD_ARTICULO,
                               A.COD_ORIGEN_ART, 
                               D.ID,
                               A.ID_RUBRO,
                               D.OBSERVACION AS COMENTARIO_PED,
                               'S' IND_GESTION
                           
                    FROM VTW_PEDIDOS_DETALLE D
                    JOIN STW_ARTICULOS A ON D.ID_ARTICULO = A.ID AND D.ID_EMPRESA = A.ID_EMPRESA
                    WHERE D.DIFERENCIA < 0 
                      AND D.ID_PEDIDO_CABECERA = :P632_ID_PEDIDO
                       
                      AND D.ID NOT IN (SELECT NVL(C.ID_PEDIDO_DET,0)
                                         FROM CMW_COTIZA_ARTICULOS C
                                        WHERE C.ID_PEDIDO = D.ID_PEDIDO_CABECERA
                                          AND C.ID_PEDIDO_DET = D.ID
                                          AND NVL(C.IND_GESTION,'N') = 'S'
                                          AND  NVL(C.FEC_OCC,'06/03/2024') >= '06/03/2024')--- funciona con los pedidos cargados desde 
                                                                            --- la fecha 06/03/2024,se agrego para tener control de los art que pasan por gestion y no genere duplicados
                    
                      ORDER BY D.NUM_ORDEN DESC;
                      
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P632_JSON_DETALLES:=JSON_DETALLE;
                      EXCEPTION
                      WHEN OTHERS THEN  
                      RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el detalle');
                      ---NULL;
                    
                    END;
                    
                    ```
                itemsToSubmit: P632_ID_PEDIDO
                itemsToReturn: P632_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: never
            }
            comments {
                comments:
                    ```
                    DEJO EL SELECT ORIGINAL ACA
                      /*SELECT    D.NUM_ORDEN,
                               D.ID_ARTICULO,
                               ---A.ID_GRUPO_ART,
                               D.DESC_ARTICULO DESCRIPCION,
                               A.ID_ENVASE,
                               A.ID_UNIDAD_MEDIDA,
                               A.ID_MARCA,
                               ---D.CANTIDAD,
                              CASE WHEN abs(D.CANTIDAD - nvl((
                                   SELECT SUM(CANT_DISPON) FROM STW_EXISTENCIA_ART WHERE ID_ARTICULO = D.ID_ARTICULO
                               )-NVL((SELECT SUM(CANT_BLOQUEO) FROM STWV_ARTICULOS_BLOQUEO AB
                                          WHERE AB.ID_ARTICULO = D.ID_ARTICULO
                                            /*AND AB.ID_LOTE = E.ID_LOTE*/),0),0)) > D.CANTIDAD THEN D.CANTIDAD
                                            ELSE abs(D.CANTIDAD - nvl((
                                   SELECT SUM(CANT_DISPON) FROM STW_EXISTENCIA_ART WHERE ID_ARTICULO = D.ID_ARTICULO
                               )-NVL((SELECT SUM(CANT_BLOQUEO) FROM STWV_ARTICULOS_BLOQUEO AB
                                          WHERE AB.ID_ARTICULO = D.ID_ARTICULO
                                            /*AND AB.ID_LOTE = E.ID_LOTE*/),0),0)) 
                                            
                                            END AS CANTIDAD,
                               A.COD_ARTICULO,
                               A.COD_ORIGEN_ART, 
                               D.ID,
                               A.ID_RUBRO*/
                    ```
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                      OPEN l_cursor FOR
                      --CUANDO SE CARGA EL PEDIDO NO CONSIDERA EXISTENCIA EN BLOQUEO PERO SI CUANDO COTIZAN ???????????????????????????????????????????
                      --EN LA CARGA DE PEDIDOS GUARDAN LA DIFERENCIA QUE HUBO EN ESE MOMENTO QUE ES LO QUE TENDRIA QUE TRAER EN ESTA PANTALLA
                      --PERO NO TRAE YA QUE AL CONSIDERAR EXISTENCIA BLOQUEADA TRAE UNA MAYOR CANTIDAD YA QUE EL SISTEMA CONSIDERA QUE SE NECESITA COMPRAR 
                      --MAS ARTICULOS.
                      --SELECT ORIGINAL CONSIDERANDO BLOQUEO
                    
                    
                    --SELECT DONDE TRAIGO LA DIFERENCIA QUE SE GUARDO EN ESE MOMENTO
                        SELECT D.NUM_ORDEN,
                               D.ID_ARTICULO,
                               ---A.ID_GRUPO_ART,
                               D.DESC_ARTICULO DESCRIPCION,
                               D.DESC_ARTICULO_STD AS DESC_ARTICULO_STD,
                               A.ID_ENVASE,
                               A.ID_UNIDAD_MEDIDA,
                               A.ID_MARCA,
                               ---D.CANTIDAD,
                                ABS(D.DIFERENCIA) AS CANTIDAD,
                               A.COD_ARTICULO,
                               A.COD_ORIGEN_ART, 
                               D.ID,
                               A.ID_RUBRO,
                               D.OBSERVACION AS COMENTARIO_PED,
                               'S' IND_GESTION,
                               'N' IND_CLIENTE,
                               OD.Id_Proveedor,
                               od.id_moneda,
                               od.id_tipo_entrega,
                               nvl(od.costo_unitario_local, 0) as costo_unitario,
                               nvl(od.costo_total_local, 0) as costo_total,
                               nvl(od.tip_cambio, 1) tip_cambio,
                               pe.nombre as nombre_proveedor,
                               nvl(pr.id_condicion_compra,61) id_condicion_compra,
                               od.id as ID_OFERTA_LIC            
                                           
                    FROM VTW_PEDIDOS_DETALLE D
                    JOIN VTW_PEDIDOS_CABECERA C ON C.ID = D.ID_PEDIDO_CABECERA
                    JOIN STW_ARTICULOS A ON D.ID_ARTICULO = A.ID AND D.ID_EMPRESA = A.ID_EMPRESA
                    --LEFT JOIN LCW_DETALLES_PED_OFR POD ON D.ID_DETALLE_PED_OFR = POD.ID
                    LEFT JOIN LCW_OFERTAS_DET OD ON d.ID_OFERTA_LIC = OD.ID
                    LEFT JOIN CMW_PROVEEDORES PR ON PR.ID = OD.ID_PROVEEDOR
                    LEFT JOIN BSW_PERSONAS    PE ON PE.ID = PR.ID_PERSONA
                    --WHERE --existencia_actual(C.ID_SUCURSAL,d.Id_Articulo,d.id_empresa,'S')-obtener_cantidad_bloqueo(d.Id_Articulo,C.ID_SUCURSAL, 'S','S') - d.cantidad< 0
                    WHERE CMWK_COTIZACIONES.TRAE_RESERVA_DISPONIBLE(P_ID_EMPRESA  => :P0_ID_EMPRESA,
                                                                    P_ID_ARTICULO => d.id_articulo,
                                                                     P_ID_SUCURSAL => /*c.id_sucursal*/null) - nvl(d.cantidad, 0) < 0
                    -- nvl(D.DIFERENCIA, 0) < 0 
                    and nvl(a.ind_maneja_stock,'S') != 'N'
                      AND D.ID_PEDIDO_CABECERA = :P632_ID_PEDIDO
                       
                      AND D.ID NOT IN (SELECT NVL(C.ID_PEDIDO_DET,0)
                                         FROM CMW_COTIZA_ARTICULOS C
                                        WHERE C.ID_PEDIDO = D.ID_PEDIDO_CABECERA
                                          AND C.ID_PEDIDO_DET = D.ID
                                          AND NVL(C.IND_GESTION,'N') = 'S'
                                          AND  NVL(C.FEC_OCC,'06/03/2024') >= '06/03/2024')--- funciona con los pedidos cargados desde 
                                                                            --- la fecha 06/03/2024,se agrego para tener control de los art que pasan por gestion y no genere duplicados
                    
                      ORDER BY D.NUM_ORDEN DESC;
                      
                    
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P632_JSON_DETALLES:=JSON_DETALLE; 
                    
                      EXCEPTION
                      WHEN OTHERS THEN  
                      RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el detalle-'||sqlerrm);
                      ---NULL;
                    
                    END;
                    
                    ```
                itemsToSubmit: P632_ID_PEDIDO
                itemsToReturn: P632_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 30
            }
            comments {
                comments:
