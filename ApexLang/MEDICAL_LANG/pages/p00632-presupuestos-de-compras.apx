page 632 (
    name: Presupuestos de compras
    alias: PRESUPUESTOS-DE-COMPRAS
    title: Presupuestos de compras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            // Funcion  para calcular los totales del detalle  
            function recalculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_costo   = model.getFieldKey("PRECIO");
                var v_cantidad       = model.getFieldKey("MON_COSTO_COPIA");
                var v_total_costos     = 0;
                var v_total_cantidad =0;
            
            
                
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                         
                          
                        v_total_costos      = v_total_costos     + parseFloat(r[v_costo].replace(/\./g,''));
                        v_total_cantidad  = v_total_cantidad + parseFloat(r[v_cantidad].replace(/\./g,''));
                       
                    }
                    
                });
                   
            
            
                 if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                ///$s('P245_TOTAL_COSTOS',  v_total_costos.toString().replace('.', ''));
                ///$s('P245_TOTAL_CANTIDAD',v_total_cantidad);
            
            
            
            }
            
            //function readonly(){
            //    var detalleModel = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
            //
            //    detalleModel.forEach(function(r, index, id){
            //        var meta = model.getRecordMetadata(id);
            //
            //        if ((meta.fields != undefined) && (!meta.deleted)) {
            //            if meta
            //        }
            //    }
            //}
            
            
            
            
            
            
            
            ```
        executeWhenPageLoads: ///document.getElementById("P632_NUM_SOLICITUD_COMPRA").readOnly = true;
