    dynamicAction redirigir-al-guardar (
        name: Redirigir Al guardar
        execution {
            sequence: 240
        }
        when {
            event: region/interactiveGrid/interactivegridsave
            selectionType: region
            region: @presupuestos-de-compras
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var unattendedErrors = $('.t-Form-error').filter(function() {
                        return !$(this).closest('.t-Form-item').find('.t-Form-errorIcon').is(':visible');
                    });
                    
                    if (unattendedErrors.length === 0) {
                        // No unattended errors found, proceed with the redirect
                        setTimeout(function() {
                            window.location.href = 'f?p=&APP_ID.:621:&SESSION.';
                        }, 2000);
                    } else {
                        // Unattended errors found, you can handle them as needed
                        alert('Corrija los errores por favor');
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            comments {
                comments: window.location.href = 'f?p=&APP_ID.:621:&SESSION.';
            }
        )

    )

