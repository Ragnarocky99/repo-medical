        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var igRegion = apex.region("Detalles").widget();
                    var Bandera1 = false;
                    
                    // Listen for the "interactivegriddatarowadd" event to detect when a new row is added
                    igRegion.on("selection-add-row", function(event, ui) {
                        // Get the model for the grid
                        var model = ui.model;
                        
                        // Replace "COLUMN_NAME" with the actual column name(s) you want to remove the class from
                        var columnsToModify = ["ID_ENVASE", "COLUMN_NAME_2"];
                    
                        // Loop through the new rows and remove the "is-readonly" class from the specified columns
                        model.forEach(function(record, index, id) {
                            if (record.type === "APEX$ROW") {
                                columnsToModify.forEach(function(columnName) {
                                    var cell = model.getFieldDisplayText(record, columnName);
                                    cell.classList.remove("is-readonly");
                                    cell.findColumn("COD_ARTICULO").element.css("pointer-events", "auto");
                                });
                            }
                        });
                    });
                    
                    
                    
                    apex.region( "Detalles" ).widget().interactiveGrid( "getActions" ).invoke( "selection-add-row" );
                    Bandera1 = true;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction new-3 (
        name: New_3
        execution {
            sequence: 230
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @presupuestos-de-compras
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Iterate through each row in the grid
                    $(".a-IRR-table tr").each(function(index, row) {
                        // Find the cell with the "COD_ARTICULO" value in the current row
                        var codArticuloCell = $(row).find("td[headers='Codigo']");
                        var codArticuloValue = codArticuloCell.text().trim();
                    
                        // Find the cells that you want to set as readonly (e.g., CANTIDAD and PRECIO)
                        var cantidadCell = $(row).find("td[headers='Cantidad']");
                        var precioCell = $(row).find("td[headers='Costo Unitario']");
                        console.log("CodArticulo Header Value: " + codArticuloCell.text().trim());
                        if (codArticuloValue === "1") {
                            // If COD_ARTICULO is 1, set the cells as readonly}
                            codArticuloCell.prop("readonly", true);
                            cantidadCell.prop("readonly", true);
                            precioCell.prop("readonly", true);
                        } else {
                            // If COD_ARTICULO is not 1, remove the readonly attribute
                            cantidadCell.prop("readonly", false);
                            precioCell.prop("readonly", false);
                        }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

