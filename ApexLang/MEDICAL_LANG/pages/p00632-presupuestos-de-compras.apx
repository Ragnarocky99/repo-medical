    dynamicAction setear-datos-pedido (
        name: Setear Datos Pedido
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P632_ID_PEDIDO
        }

        action datos-pedido (
            name: Datos Pedido
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT CL.NIVEL, CL.COMENTARIO, PC.NOMB_FANTASIA CLIENTE, PV.NOMB_FANTASIA VENDEDOR
                      FROM VTW_PEDIDOS_CABECERA PC
                      JOIN CCW_CLIENTES         CL ON CL.ID = PC.ID_CLIENTE
                      JOIN BSW_PERSONAS         PC ON PC.ID = CL.ID_PERSONA
                      JOIN FVW_VENDEDORES       VE ON VE.ID = PC.ID_VENDEDOR
                      JOIN BSW_PERSONAS         PV ON PV.ID = VE.ID_PERSONA
                     WHERE PC.ID = :P632_ID_PEDIDO
                    ```
                itemsToSubmit: P632_ID_PEDIDO
            }
            affectedElements {
                selectionType: items
                items: [
                    P632_NIVEL_CLIENTE
                    P632_COMENTARIO_CLIENTE
                    P632_CLIENTE
                    P632_VENDEDOR
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

