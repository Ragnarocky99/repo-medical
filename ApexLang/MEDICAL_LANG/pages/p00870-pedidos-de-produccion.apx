                heading: Fec Pedido
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_CLIENTE (
            type: plainText
            heading {
                heading: Id Cliente
                alignment: end
