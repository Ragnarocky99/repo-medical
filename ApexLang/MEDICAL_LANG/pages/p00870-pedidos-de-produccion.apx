            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column IND_CONFIRMACION (
            type: plainText
            heading {
                heading: Ind Confirmacion
            }
            layout {
                sequence: 11
            }
            source {
