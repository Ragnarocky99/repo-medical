page 870 (
    name: Pedidos de Produccion
    alias: PEDIDOS-DE-PRODUCCION
    title: Pedidos de Produccion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @pedidos-de-produccion
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region pedidos-de-produccion (
        name: Pedidos de Produccion
        type: interactiveReport
        source {
            location: localDatabase
            tableName: PDW_PEDIDO_PROD_CAB
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 14693152183172341
        }

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 57
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column FECHA_CONFIRMA (
            type: plainText
            heading {
                heading: Fecha Confirma
            }
            layout {
                sequence: 13
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: M
            }
        )

        column FEC_ALTA (
            type: plainText
            heading {
                heading: Fec Alta
            }
            layout {
                sequence: 87
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: X
            }
        )

        column FEC_ENTREGA (
