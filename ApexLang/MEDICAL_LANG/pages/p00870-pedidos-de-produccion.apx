            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FECHA_CONFIRMA (
                sequence: 8
            )

            displayColumn FEC_ENTREGA (
                sequence: 5
            )

            displayColumn FEC_PEDIDO (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_COLOR (
                sequence: 12
            )

            displayColumn IND_CAJAS_GENERADAS (
                sequence: 11
            )

            displayColumn IND_CONFIRMACION (
                sequence: 6
            )

            displayColumn IND_DET_GENERADO (
                sequence: 10
            )

            displayColumn NRO_PEDIDO (
                sequence: 2
            )

            displayColumn NRO_PEDIDO_CLIENTE (
                sequence: 3
            )

            displayColumn NRO_PRENDAS (
                sequence: 9
            )

            displayColumn USUARIO_CONFIRMA (
                sequence: 7
            )

        )

    )

    pageItem P870_FEC_FIN (
        type: datePicker
        label {
            label: <p>Periodo Pedido:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P870_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo Pedido:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    pageItem P870_ID_CLIENTE (
        type: popupLov
        label {
            label: <p>Cliente:&ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            manualEntry: true
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P870_NRO_PEDIDO (
        type: numberField
        label {
            label: <p>Nro. Pedido:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P870_NRO_PEDIDO_CLIENTE (
        type: textField
        label {
            label: <p>Nro. Pedido Cliente:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 20
            region: @pedidos-de-produccion
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 872
            }
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 50
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }

        triggerAction refrescar-reporte (
            name: Refrescar Reporte
            action: refresh
            affectedElements {
                selectionType: region
                region: @pedidos-de-produccion
            }
            execution {
                sequence: 10
            }
        )

    )

)

