page 10 (
    name: Personas
    alias: PERSONA
    title: Personas - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region personas (
        name: Personas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       TO_NUMBER(COD_PERSONA) AS COD_PERSONA , 
                       ES_FISICA,
                       CASE ES_FISICA
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                        END ES_FISICA_ICON,
                       NOMBRE,
                       NOMB_FANTASIA,
                       COD_USUARIO_AUD,
                       ID_ESTADO_CIVIL,
                       SEXO,
                       PRIMER_APELLIDO,
                       SEGUNDO_APELLIDO,
                       PRIMER_NOMBRE,
                       SEGUNDO_NOMBRE,
                       ID_PROFESION,
                       ID_CONYUGUE,
                       NACIONALIDAD,
                       ID_SECTOR,
                       DIREC_ELECTRONICA,
                       ES_MAL_DEUDOR,
                       ID_NIVEL_ESTUDIOS,
                       NUM_HIJOS,
                       NUM_DEPENDIENTES,
                       TOTAL_INGRESOS,
                       ID_PAIS,
                       ID_ALTA_POR,
                       ID_ACTUALIZADO_POR,
                       ES_REPRES_LEGAL,
                       FEC_ACTUALIZACION,
                       FEC_NACIMIENTO,
                       FEC_ALTA,
                       ID_TIPO_SOCIEDAD,
                       NOM_COMERCIAL,
                       RAZON_SOCIAL,
                       LUCRATIVA,
                       ESTATAL,
                       PAGINA_WED,
                       CONYUGUE,
                       ID_SECTOR_VENTA,
                       TIENE_RUC,
                       IND_VIVIENDA,
                       RELIGION,
                       GRUPO_SANGUINEO,
                       ESPECIALIDAD,
                       PERIODO_VISITA,
                       CLUB,
                       COD_ZONAL,
                       REFERENCIA,
                       FEC_FUNDACION,
                       TIEMPO_RESIDENCIA,
                       ID_SECTOR_TRAB,
                       DIRECCION_TRAB,
                       TELEFONO_TRAB,
                       CARGO,
                       ANTIGUEDAD,
                       ES_UNIPERSONAL,
                       APE_PERSONA,
                       NOM_PERSONA,
                       RUC,
                       DIRECCION,
                       TELEFONO,
                       FEC_VENC_REGISTRO,
                       NRO_REGISTRO,
                       RECOMENDACION,
                       NRO_CASA,
                       PAGINA_WEB,
                       DIRECCION_IP,
                       NOMBRE_CONYUGE,
                       DIRECCION_CONYUGE,
                       COD_CIUDAD_CONYUGE,
                       FEC_NAC_CONYUGE,
                       CI_CONYUGE,
                       TELEFONO_CONYUGE,
                       CELULAR_CONYUGE,
                       COD_PAIS_CONYUGE,
                       PROFESION_CONYUGE,
                       EMPLEADOR_CONYUGE,
                       DIR_LABORAL_CONYUGE,
                       ANTIGUEDAD_CONYUGE,
                       TEL_LABORAL_CONYUGE,
                       DEPTO_LABORAL_CONYUGE,
                       CARGO_CONYUGE,
                       INGRESOS_CONYUGE,
                       OTROS_INGRESOS_CONYUGE,
                       GASTOS_FAM_CONYUGE,
                       OTROS_GASTOS_CONYUGE,
                       NOMBRE_GARANTE,
                       DIRECCION_GARANTE,
                       TELEFONO_GARANTE,
                       CI_GARANTE,
                       COD_ESTADO_CIVIL_GARANTE,
                       COD_CASA_PROPIA_GARANTE,
                       PROFESION_GARANTE,
                       CALLE1_GAR,
                       CALLE2_GAR,
                       CALLE3_GAR,
                       CALLE4_GAR,
                       CALLE5_GAR,
                       REF_CROQUIS_GAR,
                       CELULAR_GARANTE,
                       FEC_NAC_GARANTE,
                       NUM_HIJOS_GARANTE,
                       MONTO_ALQUILER_GARANTE,
                       INGRESOS_GARANTE,
                       OTROS_INGRESOS_GARANTE,
                       GASTOS_FAM_GARANTE,
                       OTROS_EGRESOS_GARANTE,
                       EMPRESA_GARANTE,
                       DIRECCION_LABORAL_GARANTE,
                       TELEFONO_LABORAL_GARANTE,
                       ANTIGUEDAD_GARANTE,
                       CARGO_GARANTE,
                       DEPTO_LABORAL_GARANTE,
                       DONDE_COBRAR,
                       NOM_REF_COM,
                       TELE_REF_COM,
                       ID_BANCO_REF,
                       COD_BANCO_REF,
                       NRO_CI,
                       COD_PAIS,
                       ID_CIUDAD,
                       ID_DEPARTAMENTO,
                       ID_BARRIO,
                       ID_DISTRITO,
                       DOC_EXT,
                       sys.dbms_lob.getlength(IMAGEN_CEDULA) AS 
                       IMAGEN_CEDULA,
                       ID_TRABAJO_PER
                
                  from BSW_PERSONAS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 11
                items: {
                    P11_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 6453187044274615
        }

