        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                PERSONAS
                ```
        }
        pageFooter {
            fontSize: 8
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 65019 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_PERSONA (
                sequence: 1
            )

            displayColumn DIREC_ELECTRONICA (
                sequence: 8
            )

            displayColumn ES_FISICA (
                sequence: 9
            )

            displayColumn ID_PAIS (
                sequence: 11
            )

            displayColumn ID_SECTOR (
                sequence: 10
            )

            displayColumn ID_TRABAJO_PER (
                sequence: 4
            )

            displayColumn NOMBRE (
                sequence: 2
            )

            displayColumn NOMB_FANTASIA (
                sequence: 3
            )

            displayColumn NRO_CI (
                sequence: 5
            )

            displayColumn RUC (
                sequence: 6
            )

            displayColumn TELEFONO (
                sequence: 7
            )

            sort (
                column: COD_PERSONA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @personas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @personas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @personas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17254680923022304
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

