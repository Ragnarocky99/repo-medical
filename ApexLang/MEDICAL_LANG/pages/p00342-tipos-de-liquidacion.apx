page 342 (
    name: Tipos de Liquidacion
    alias: TIPOS-DE-LIQUIDACION
    title: Tipos de Liquidacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tipos-de-liquidación (
        name: Tipos de Liquidación
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID, TIP_LIQUID, DESCRIPCION, ID_EMPRESA, ID_SUCURSAL, COD_USUARIO_AUD
                FROM RHW_TIP_LIQUIDACION
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                AND ID_SUCURSAL=:P0_ID_SUCURSAL
                ORDER BY ID;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 343
                items: {
                    P343_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 15372989119727041
        }

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cód. Usuario Aud.
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 130
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_SUCURSAL (
            type: hidden
            heading {
                heading: Sucursal
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column TIP_LIQUID (
            type: plainText
            heading {
                heading: Tipo Liquidación
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Tipos de Liquidación
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 161744 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ID_EMPRESA (
                sequence: 1
            )

            displayColumn ID_SUCURSAL (
                sequence: 4
            )

            displayColumn TIP_LIQUID (
                sequence: 2
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @tipos-de-liquidación
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 343
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tipos-de-liquidación
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tipos-de-liquidación
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

