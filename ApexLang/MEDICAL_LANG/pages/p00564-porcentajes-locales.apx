        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                Porcentajes_Locales
                Inmueble:&P564_INMUEBLE.
                ```
        }
    )

    pageItem P564_INMUEBLE (
        type: displayOnly
        label {
            label: <p>Inmueble</p>
            alignment: left
        }
        settings {
            basedOn: lov
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION , ID FROM ACW_INMUEBLES
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
    )

    button volver (
        buttonName: VOLVER
        label: Volver
        layout {
            sequence: 10
            region: @breadcrumb
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo-arrow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 558
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process empresa (
        name: EMPRESA
        type: executeCode
        editableRegion: @porcentajes-locales
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS='C' THEN
                :ID_EMPRESA:=:P0_ID_EMPRESA;
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 91275700714695004
        }
    )

    process porcentajes-locales-save-interactive-grid-data (
        name: Porcentajes_Locales - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @porcentajes-locales
        execution {
            sequence: 20
        }
        advanced {
