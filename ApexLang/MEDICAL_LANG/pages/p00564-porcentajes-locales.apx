        column ID_LOCAL (
            type: popupLov
            heading {
                heading: <p>Unidad</p>
                alignment: center
                alternativeLabel: Unidad
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION,ID FROM ACW_LOCALES
                    WHERE ID_EMPRESA=:P0_ID_EMPRESA
                    AND ID_INMUEBLE=:P564_INMUEBLE;
                    ```
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_LOCAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
