page 733 (
    name: Consulta Auditoria
    alias: CONSULTA-AUDITORIA
    title: Consulta Auditoria
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region auditoria (
        name: Auditoria
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  COD_USUARIO,
                        COD_MODULO,
                        OPERACION,
                        FEC_OCURRENCIA,
                        NRO_OPERACION,
                        COD_EMPRESA,
                        NOM_TABLA,
                        DATOS_VIEJOS,
                        DATOS_NUEVOS,
                        PROGRAM_MODULE
                  from  AUDITORIA
                where   (COD_USUARIO = :P733_COD_USUARIO or :P733_COD_USUARIO is null)
                and     (OPERACION   = :P733_OPERACION or :P733_OPERACION is null)
                and     (NOM_TABLA   = :P733_TABLA or :P733_TABLA is null)
                and     (UPPER(DATOS_VIEJOS) like '%'||UPPER(:P733_BUSCAR)||'%' or UPPER(DATOS_NUEVOS) like '%'||UPPER(:P733_BUSCAR)||'%' or :P733_BUSCAR is null)
                and     trunc(FEC_OCURRENCIA) between :P733_FECHA_INI and :P733_FECHA_FIN
                ```
            pageItemsToSubmit: [
                P733_COD_USUARIO
                P733_FECHA_INI
                P733_FECHA_FIN
                P733_TABLA
                P733_OPERACION
                P733_BUSCAR
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 109065505515294199
        }

        savedReport 835945 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @PROGRAM_MODULE
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @COD_USUARIO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @COD_MODULO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @OPERACION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @FEC_OCURRENCIA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @NRO_OPERACION
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @COD_EMPRESA
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @NOM_TABLA
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DATOS_VIEJOS
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @DATOS_NUEVOS
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 1
                }
            )

            sort (
                column: @FEC_OCURRENCIA
                sort {
                    direction: desc
                    nulls: last
                    sequence: 1
                }
            )

            sort (
                column: @NRO_OPERACION
                sort {
                    direction: desc
                    nulls: last
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
            serverSideCondition {
                type: never
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            settings {
                enableMultiSelect: false
            }
            layout {
                sequence: 10
            }
        )

        column COD_EMPRESA (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: COD_EMPRESA
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column COD_MODULO (
            type: textField
            heading {
                heading: <p>Módulo</p>
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                maxLength: 2
            }
            source {
                databaseColumn: COD_MODULO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column COD_USUARIO (
            type: textField
            heading {
                heading: <p>Usuario</p>
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: COD_USUARIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DATOS_NUEVOS (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: DATOS_NUEVOS
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DATOS_VIEJOS (
