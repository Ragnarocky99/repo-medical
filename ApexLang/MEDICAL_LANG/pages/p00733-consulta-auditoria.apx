                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Inserción;I,Modificación;U,Borrado;D,N/A
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: OPERACION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column PROGRAM_MODULE (
            type: textField
            heading {
                heading: <p>Program Module</p>
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: PROGRAM_MODULE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Auditoria
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region datos (
        name: Datos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  c001 columna,
                        c002 datos_viejos,
                        c003 datos_nuevos,
                        nvl(c004, 'N') diferencia
                from    apex_collections
                where   collection_name = w_busca_parametro('BS', 'NOMBRE_COLECCION_AUDITORIA')
                order by c004 desc
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 128579443720914401
        }

        column COLUMNA (
            type: plainText
            heading {
                heading: Columna
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DATOS_NUEVOS (
            type: plainText
            heading {
