                heading: <p>Fecha</p>
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI:SS
            }
            source {
                databaseColumn: FEC_OCURRENCIA
                dataType: date
            }
        )

        column NOM_TABLA (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: NOM_TABLA
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NRO_OPERACION (
            type: numberField
            heading {
                heading: <p>Nro. Operacion</p>
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: NRO_OPERACION
                dataType: number
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

        column OPERACION (
            type: selectList
            heading {
