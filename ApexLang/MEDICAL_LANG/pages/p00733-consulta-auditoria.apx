            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Datos
        }

        savedReport 1069207 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COLUMNA (
                sequence: 1
            )

            displayColumn DATOS_NUEVOS (
                sequence: 3
            )

            displayColumn DATOS_VIEJOS (
                sequence: 2
            )

            sort (
                column: DIFERENCIA
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            highlight ir-condition (
                condition {
                    column: DIFERENCIA
                    value: S
                }
                colors {
                    background: #fff5ce
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    pageItem P733_BUSCAR (
        type: textField
        label {
            label: <p>Buscar:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P733_COD_USUARIO (
        type: popupLov
        label {
            label: <p>Usuario:&ensp;</p>
            alignment: left
        }
        settings {
            manualEntry: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cod_usuario d, cod_usuario r
                from   bsw_usuarios
                ```
            nullDisplayValue: --TODOS--
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P733_FECHA_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Fecha Fin
        }
    )

    pageItem P733_FECHA_INI (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Fecha Inicio
        }
    )

    pageItem P733_NOMB_TABLA (
        type: displayOnly
        label {
            label: <p>Tabla</p>
            alignment: left
        }
        settings {
            basedOn: lov
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nom_tabla_usuario, nom_tabla
                  from bsw_auditoria_tablas_ref
                ```
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P733_NRO_OPERACION (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P733_OPERACION (
        type: radioGroup
        label {
            label: <p>Operación:&ensp;</p>
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Inserción;I,Modificación;U,Borrado;D
            nullDisplayValue: Todos
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
    )

    pageItem P733_OPERACION_H (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P733_TABLA (
        type: popupLov
        label {
            label: <p>Tabla:&ensp;</p>
            alignment: left
        }
        settings {
            manualEntry: true
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-nom-tablas-usuario
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button recuperar (
        buttonName: Recuperar
        label: Recuperar
        layout {
            sequence: 20
            region: @datos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refrescar (
        buttonName: REFRESCAR
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: change
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P733_COD_USUARIO
                P733_TABLA
                P733_OPERACION
                P733_BUSCAR
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @auditoria
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-recuperar (
        name: Click - Recuperar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @recuperar
        }

        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode: bsw_recupera_registro_auditoria(:P733_NRO_OPERACION);
                itemsToSubmit: P733_NRO_OPERACION
                successMessage: Recuperación Exitosa
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-auditoria (
        name: Refrescar Auditoria
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @auditoria
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction selection-change-auditoria (
        name: Selection Change - Auditoria
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @auditoria
        }

        action carga-datos (
            name: Carga datos
            action: plugin/fosInteractiveGridProcessRows
            settings {
                action: processSelectedRows
                plSqlCode: bsw_almacena_datos_auditoria(:NOM_TABLA, :NRO_OPERACION, :OPERACION, :DATOS_VIEJOS, :DATOS_NUEVOS);
                itemsToSubmit: [
                    NOM_TABLA
                    NRO_OPERACION
                    OPERACION
                    DATOS_VIEJOS
                    DATOS_NUEVOS
                ]
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            affectedElements {
                selectionType: region
                region: @auditoria
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @datos
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action setear-items (
            name: Setear Items
            action: plugin/fosInteractiveGridProcessRows
            settings {
                action: processSelectedRows
                plSqlCode:
                    ```plsql
                    begin
                        select  NOM_TABLA_USUARIO
                        into    :P733_NOMB_TABLA
                        from    bsw_auditoria_tablas_ref
                        where   nom_tabla = :NOM_TABLA;
                    exception
                        when others then
                            :P733_NOMB_TABLA := :NOM_TABLA;
                    end;
                    
                    :P733_NRO_OPERACION := :NRO_OPERACION;
                    :P733_OPERACION_H   := :OPERACION;
                    ```
                itemsToSubmit: [
                    NOM_TABLA
                    NRO_OPERACION
                    OPERACION
                ]
                itemsToReturn: [
                    P733_NOMB_TABLA
                    P733_OPERACION_H
                    P733_NRO_OPERACION
                ]
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            affectedElements {
                selectionType: region
                region: @auditoria
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process auditoria-save-interactive-grid-data (
        name: Auditoria - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @auditoria
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12795312961367778
        }
    )

)

