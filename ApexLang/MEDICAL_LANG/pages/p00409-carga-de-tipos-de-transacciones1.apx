page 409 (
    name: Carga de Tipos de Transacciones
    alias: CARGA-DE-TIPOS-DE-TRANSACCIONES1
    title: Carga de Tipos de Transacciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tipos-de-transacciones (
        name: Carga de Tipos de Transacciones
        type: form
        source {
            location: localDatabase
            tableName: FEW_TIPOS_TRANSACCIONES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P409_DESCRIPCION (
        type: textarea
        label {
            label: <p>Descripción:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P409_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P409_TIP_TRANSACCION (
        type: textField
        label {
            label: <p>Tipo de Transacción:&ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
            disabled: true
        }
        layout {
            sequence: 20
            region: @carga-de-tipos-de-transacciones
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-tipos-de-transacciones
            column: TIP_TRANSACCION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P409_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P409_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P409_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p409-tip-transaccion (
        itemName: P409_TIP_TRANSACCION
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT MAX(TO_NUMBER(TIP_TRANSACCION)) + 1 FROM FEW_TIPOS_TRANSACCIONES;
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 23588651085884150
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tipos-de-transacciones (
        name: Initialize form Carga de Tipos de Transacciones
        type: formInitialization
        formRegion: @carga-de-tipos-de-transacciones
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 23587815344884148
        }
    )

    process process-form-carga-de-tipos-de-transacciones (
        name: Process form Carga de Tipos de Transacciones
        type: formAutoRowProcessing
        formRegion: @carga-de-tipos-de-transacciones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23588201820884148
        }
    )

)

