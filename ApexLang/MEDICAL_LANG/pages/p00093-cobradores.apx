page 93 (
    name: Cobradores
    alias: COBRADORES
    title: Cobradores - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cobradores (
        name: Cobradores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.COD_COBRADOR,
                       C.ID_PERSONA,
                       C.ACTIVO,
                       CASE C.ACTIVO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON,
                       C.ID_ZONA,
                       C.IND_VENDEDOR,
                       C.IND_ZONA,
                       C.CANT_DIAS,
                       C.COD_USUARIO_AUD,
                       C.IND_MANEJA_RECLA,
                       C.ID_GRUP_TELEC,
                       C.CLAVE_CRM,
                       C.ID_SUCURSAL,
                       P.NOMBRE,
                       P.COD_PERSONA
                
                  from CCW_COBRADORES C, BSW_PERSONAS P             
                  where C.ID_PERSONA = P.ID
                    and C.ID_EMPRESA = :P0_COD_EMPRESA
                    order by C.ID DESC;       
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 94
                items: {
                    P94_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 11949900694489068
        }

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ACTIVO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ACTIVO_ICON (
            type: hidden
            heading {
                heading: Activo Icon
            }
            layout {
                sequence: 190
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column CANT_DIAS (
            type: hidden
            heading {
                heading: Cant. Dias
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column CLAVE_CRM (
            type: hidden
            heading {
                heading: Clave Crm
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column COD_COBRADOR (
            type: plainText
            heading {
                heading: Cód. Cobrador
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COD_PERSONA (
            type: plainText
            heading {
                heading: Cód. Persona
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 170
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
