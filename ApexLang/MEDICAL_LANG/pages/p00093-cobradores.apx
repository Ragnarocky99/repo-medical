                alignment: center
            }
            lov {
                lov: @bsw-zonas-geograficas-cod-zona
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column IND_MANEJA_RECLA (
            type: hidden
            heading {
                heading: Ind Maneja Recla
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column IND_VENDEDOR (
            type: hidden
            heading {
                heading: Ind Vendedor
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column IND_ZONA (
            type: hidden
            heading {
                heading: Ind Zona
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
                alignment: center
