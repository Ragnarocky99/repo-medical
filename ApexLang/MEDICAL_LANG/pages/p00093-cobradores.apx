            }
            layout {
                sequence: 150
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID_PERSONA (
            type: hidden
            heading {
                heading: ID Persona
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_SUCURSAL (
            type: hidden
            heading {
                heading: Id Sucursal
            }
            layout {
                sequence: 180
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column ID_ZONA (
            type: plainTextBasedOnLov
            heading {
