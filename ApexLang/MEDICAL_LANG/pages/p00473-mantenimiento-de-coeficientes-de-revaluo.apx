page 473 (
    name: Mantenimiento de Coeficientes de Revaluo
    alias: MANTENIMIENTO-DE-COEFICIENTES-DE-REVALUO
    title: Mantenimiento de Coeficientes de Revaluo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region mantenimiento-de-coeficientes-de-revaluo (
        name: Mantenimiento de Coeficientes de Revaluo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select anio, 
                       to_char(to_date(mes ,'MM'),'Month') as mes, 
                       coef_compra, 
                       coef_venta, 
                       id
                       from cow_coeficientes where id_empresa = :P0_ID_EMPRESA
                ```
            pageItemsToSubmit: P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 490
                items: {
                    P490_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No se ha encontrado ningún dato.
            whenMoreDataFound: El recuento máximo de filas de este informe es #MAX_ROW_COUNT# filas. Aplique un filtro para reducir el número de registros de la consulta.
        }
        advanced {
            savedReportMappingIdentifier: 59998057679196242
        }

        column ANIO (
            type: plainText
            heading {
                heading: Año
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column COEF_COMPRA (
            type: plainText
            heading {
                heading: Coef. Compra
                alignment: center
            }
            layout {
                sequence: 34
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column COEF_VENTA (
            type: plainText
            heading {
                heading: Coef. Venta
                alignment: center
            }
            layout {
                sequence: 44
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 14
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column MES (
            type: plainText
            heading {
                heading: Mes
                alignment: center
            }
            layout {
                sequence: 54
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Mantenimiento de Coeficientes de Revaluo
        }

        savedReport 600008 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ANIO (
                sequence: 1
            )

            displayColumn COEF_COMPRA (
                sequence: 4
            )

            displayColumn COEF_VENTA (
                sequence: 3
            )

            displayColumn MES (
                sequence: 2
            )

        )

    )

    region ruta-de-navegación (
        name: "Ruta de Navegación "
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: "Crear "
        layout {
            sequence: 10
            region: @mantenimiento-de-coeficientes-de-revaluo
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 490
                items: {
                    P490_ID: &P490_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction editar-informe-cuadro-de-diálogo-cerrado (
        name: "Editar Informe: Cuadro de Diálogo Cerrado "
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @mantenimiento-de-coeficientes-de-revaluo
        }

        action refresh (
            name: Refresh
            action: refresh
            affectedElements {
                selectionType: region
                region: @mantenimiento-de-coeficientes-de-revaluo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

