page 282 (
    name: Reporte de Mayor de Cuentas Provisorio
    alias: REPORTE-DE-MAYOR-DE-CUENTAS-PROVISORIO
    title: Reporte de Mayor de Cuentas Provisorio
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
