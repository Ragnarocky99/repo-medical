    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region reporte (
        name: Reporte
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT --D.ID AS ID_DET,
                       --EM.ID AS ID_EMP,
                       --P.ID AS ID_PLAN_CUENTA,
                       P.ID_EMPRESA,
                       --C.FEC_ASIENTO,
                       E.COD_EJERCICIO,
                       P.COD_CUENTA,
                       P.NOMBRE_CUENTA,
                       SUM(NVL(D.MON_DEBE,0)) MON_DEBE,
                       SUM(NVL(D.MON_HABER,0)) MON_HABER,         
                        
                       --SA.SALDO_ANT,
                
                       /*SUM(CASE P.TIPO_CUENTA
                               WHEN 'A' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_debe,0)  -   NVL(D.mon_haber,0)
                               WHEN 'H' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_haber,0) -   NVL(D.mon_debe,0)
                               WHEN 'P' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_haber,0) -   NVL(D.mon_debe,0)
                               WHEN 'D' THEN NVL(SA.SALDO_ANT,0) + NVL(D.mon_debe,0)  -   NVL(D.mon_haber,0)
                            END) SALDO_TIP_CUENTA,
                        
                        */
                       --sum(trae_saldo_ant_co(em.id, p.cod_cuenta, e.cod_ejercicio, d.id, :P282_M_FEC_INI))saldo_ant,
                       --sum(trae_saldo_act_co(em.id, p.cod_cuenta, e.cod_ejercicio, d.id, :P282_M_FEC_INI))saldo,
                       C.ID_SUCURSAL,
                       S.DESCRIPCION SUCURSAL_DESC,
                       P.TIPO_CUENTA
                
                
                       
                FROM   COW_DIARIO_DETALLES_PROV  D,
                       COW_DIARIO_CABECERAS_PROV C,
                       COW_PLAN_CUENTAS          P,
                       BSW_MONEDAS               M,
                       BSW_SUCURSALES            S,
                       COW_EJERCICIOS            E,
                       BSW_EMPRESAS              EM
                       
                       
                WHERE EM.ID = :P0_COD_EMPRESA
                  AND P.ID_EMPRESA = EM.ID
                  AND (C.FEC_ASIENTO BETWEEN :P282_M_FEC_INI AND :P282_M_FEC_FIN)
                  AND (P.COD_CUENTA BETWEEN :P282_M_COD_CUENTA_INI AND :P282_M_COD_CUENTA_FIN OR (:P282_M_COD_CUENTA_INI IS NULL AND :P282_M_COD_CUENTA_FIN IS NULL))
                  AND E.COD_EJERCICIO = :P0_COD_EJERCICIO
                  AND D.ID_EJERCICIO  = E.ID
                  AND C.ID_EJERCICIO  = D.ID_EJERCICIO
                  AND C.NUM_ASIENTO   = D.NUM_ASIENTO
                  AND C.ID_SUCURSAL   = d.ID_SUCURSAL
                  AND P.ID_EMPRESA    = d.ID_EMPRESA
                  AND P.ID            = D.ID_PLAN_CUENTA
                  AND P.ID_MONEDA     = m.ID(+)
                  AND S.ID_EMPRESA    = c.ID_EMPRESA  
                  AND S.ID            = c.ID_SUCURSAL
                
                GROUP BY 
                       P.ID_EMPRESA,
                       --D.FEC_ASIENTO,
                       E.COD_EJERCICIO,
                       P.COD_CUENTA,
                       P.NOMBRE_CUENTA,
                       --D.MON_DEBE,
                       --D.MON_HABER,
                       --SA.SALDO_ANT,
                       C.ID_SUCURSAL,
                       S.DESCRIPCION,
                       P.TIPO_CUENTA
                       
                       
                ORDER BY regexp_replace(
                      regexp_replace(
                        regexp_replace(
                          P.COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                          ),
                        '(^|\.)(\d{2})','\1 0\2'
                      ),
                      '(^|\.)(\d)','\1 00\2'
                    );
                
                ```
            pageItemsToSubmit: [
                P282_M_FEC_INI
                P282_M_FEC_FIN
                P282_M_COD_CUENTA_INI
                P282_M_COD_CUENTA_FIN
                P0_COD_EMPRESA
                P0_COD_EJERCICIO
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 66681885391485102
        }

