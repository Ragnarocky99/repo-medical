page 370 (
    name: Generación de Liquidaciones
    alias: GENERACION-DE-LIQUIDACIONES
    title: Generación de Liquidaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 190px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: left;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region generación-de-liquidaciones (
        name: Generación de Liquidaciones
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select L.ID,
                L.ID_EMPRESA,
                L.SER_LIQUID,
                L.NRO_LIQUID,
                L.TIP_LIQUID,
                L.FEC_LIQUID,
                L.FEC_DESDE,
                L.FEC_HASTA,
                L.FEC_PROCESO,
                L.ID_TIP_LIQUID,
                L.IND_VACACIONES,
                L.IND_LIQ_FINAL,
                L.DIAS_VACACIONES,
                L.ID_CENTRO_PAGO,
                L.TIP_CAMBIO_US,
                L.TIPO_LIQ,
                L.FEC_PAGO,
                L.CERRADO,
                L.FEC_CIERRE,
                L.COMENTARIO,
                L.ID_SUCURSAL,
                L.COD_USUARIO_AUD,
                L.ID_EMPLEADO
                FROM RHW_LIQUIDACIONES L
                WHERE L.ID_EMPRESA=:P0_ID_EMPRESA
                ORDER BY ID DESC;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region variables (
        name: Variables
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P370_ANIO (
        type: textField
        label {
            label: <p>Año: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 280
            region: @generación-de-liquidaciones
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

