    button execute (
        buttonName: EXECUTE
        label: Generar Liquidacion
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P370_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction tip-cambio-us (
        name: TIP_CAMBIO_US
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     begin
                      Select tipo_cambio_dia
                        into :P370_TIP_CAMBIO_US
                        from BSW_monedas
                       where cod_moneda = '3' ;
                     exception
                      when others then
                           :P370_TIP_CAMBIO_US := 1;
                      end ;
                     EXCEPTION 
                     	WHEN OTHERS THEN
                     	 RAISE_APPLICATION_ERROR(-20000,'ERROR ' || sqlerrm);
                    
                    ```
                itemsToReturn: P370_TIP_CAMBIO_US
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p370-nro-liquid (
        itemName: P370_NRO_LIQUID
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: "SELECT NVL(MAX(TO_NUMBER(NRO_LIQUID)), 0) + 1 FROM RHW_LIQUIDACIONES;  "
        }
        serverSideCondition {
            type: itemIsNull
            item: P370_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 21991963446439184
        }
        serverSideCondition {
            type: never
        }
    )

    process ejecutar (
        name: Ejecutar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                 --break;
                  IF :P370_CERRADO = 'S' THEN
                 RAISE_APPLICATION_ERROR(-20000, 'LA LIQUIDACION SELECCIONADA YA SE ENCUENTRA CERRADA, FAVOR VALIDAR');
                 END IF;
                  if nvl(:P370_NRO_LIQUID,0) <= 0 then
                   BEGIN
                    Select max( nro_liquid )
                      into :P370_NRO_LIQUID
                      from rhw_cabecera_liq
                     where id_empresa = :P0_ID_EMPRESA
                       and ser_liquid  = :P370_SER_LIQUID;
                
                    :P370_NRO_LIQUID := nvl( :P370_NRO_LIQUID, 0 ) + 1;
                    
                   EXCEPTION
                    when others then
                      :P370_NRO_LIQUID := 1;
                   END;
                  end if;
                  declare vencontro varchar2(1) ;
                  begin  
                     vencontro := 'N' ;
                     Select 'S'
                       into vencontro 
                       from rhw_liquidaciones 
                      where id_empresa = :P0_ID_EMPRESA
                        and ser_liquid = :P370_SER_LIQUID
                        and nro_liquid = :P370_NRO_LIQUID ;
                     if vencontro = 'S' then
                        update rhw_liquidaciones
                           set fec_proceso = sysdate,
                               fec_liquid = :P370_FEC_LIQUID,
                               tip_cambio_us = :P370_TIP_CAMBIO_US,
                               fec_pago   = :P370_FEC_PAGO,
                               fec_desde  = :P370_FEC_DESDE,
                               fec_hasta  = :P370_FEC_HASTA,
                               id_centro_pago = :P370_ID_CENTRO_PAGO,
                               id_sucursal = :P370_ID_SUCURSAL,
                               tip_liquid   = :P370_TIP_LIQUID
                         where id_empresa = :P0_ID_EMPRESA
                           and ser_liquid = :P370_SER_LIQUID
                           and nro_liquid = :P370_NRO_LIQUID ;    
                     end if;  
                  exception
                     when no_data_found then
                          insert into rhw_liquidaciones ( ID_EMPRESA, SER_LIQUID, NRO_LIQUID,
                                                         FEC_LIQUID,FEC_PROCESO, TIP_CAMBIO_US,
                                                         fec_pago, fec_desde, fec_hasta, id_centro_pago,
                                                         id_sucursal, tip_liquid )
                                                values ( :P0_ID_EMPRESA, :P370_SER_LIQUID, :P370_NRO_LIQUID,
                                                         :P370_FEC_LIQUID, sysdate, :P370_TIP_CAMBIO_US,
                                                         :P370_FEC_LIQUID, :P370_FEC_DESDE, :P370_FEC_HASTA,
                                                         :P370_ID_CENTRO_PAGO, :P0_ID_SUCURSAL, :P370_TIP_LIQUID ) ;
                     when others then 
                          RAISE_APPLICATION_ERROR(-20000, 'Error en la tabla de liquidaciones' || sqlerrm );
                  end ;
                end;
                
                declare
                   vmarca_Reloj   varchar2 ( 1 ) ;
                   vacumula_hor   varchar2 ( 1 ) ;
                   vsereno        varchar2 ( 1 ) ;
                BEGIN
                	verif_existencia_liquidacion( :P0_ID_EMPRESA, :P370_TIPO_LIQ, :P370_TIP_LIQUID, :P370_FEC_LIQUID) ;
                  BEGIN
                    select nvl(s.monto, 0) 
                      into :P370_SALARIO_MINIMO
                      from rhw_salario_minimo s
                     where s.id_empresa = :P0_ID_EMPRESA
                       and nvl(s.estado, 'T') = 'P'
                		       and s.fec_vigencia = ( select max( sa.fec_vigencia )
                		                                from rhw_salario_minimo sa
                		                               where sa.id_empresa = s.id_empresa
                		                                 and nvl(sa.estado, 'T') = 'P' 
                		                                 and to_char( fec_vigencia, 'yyyymm' ) <= :P370_ANIO || :P370_MES ) ;
                  EXCEPTION
                    when others then
                       :P370_SALARIO_MINIMO := 0 ;
                       RAISE_APPLICATION_ERROR(-20000, 'Error en el proceso de captura de sueldo minimo ' || sqlerrm);
                  END ;
                  :P370_LIMITE_BONIF := to_number( ltrim( rtrim( w_busca_parametro( 'RH', 'RH_LIMITE_BONIF' ) ) ) );-- parche 25/05/2018 FME
                  :P370_LIMITE_BONIF := nvl( :P370_SALARIO_MINIMO, 0 ) * nvl( :P370_LIMITE_BONIF, 0 ) ;
                IF   :P370_NRO_LIQUID IS NULL THEN
                  BEGIN
                    Select max( nro_liquid )
                      into :P370_NRO_LIQUID
                      from rhw_cabecera_liq
                     where id_empresa  = :P0_ID_EMPRESA
                       and id_sucursal = :P0_ID_SUCURSAL
                       and ser_liquid   = :P370_SER_LIQUID;
                
                    :P370_NRO_LIQUID := nvl( :P370_NRO_LIQUID, 0 ) + 1;
                  EXCEPTION
                    when others then
                      :P370_NRO_LIQUID := 1;
                  END;
                END IF;
                  declare 
                    vencontro varchar2(1) ;
                  begin  
                     vencontro := 'N' ;
                     Select 'S'
                       into vencontro 
                       from rhw_liquidaciones 
                      where id_empresa  = :P0_ID_EMPRESA
                        and id_sucursal = :P0_ID_SUCURSAL
                        and ser_liquid   = :P370_SER_LIQUID
                        and nro_liquid   = :P370_NRO_LIQUID ;
                     if vencontro = 'S' then
                        update rhw_liquidaciones
                           set fec_proceso = sysdate,
                               fec_liquid  = :P370_FEC_LIQUID,
                               tip_cambio_us = :P370_TIP_CAMBIO_US
                         where id_empresa   = :P0_ID_EMPRESA
                           and id_sucursal  = :P0_ID_SUCURSAL 
                           and ser_liquid    = :P370_SER_LIQUID
                           and nro_liquid    = :P370_NRO_LIQUID ;    
                     end if;  
                  exception
                     when no_data_found then
                          insert into rhw_liquidaciones ( id_empresa, id_sucursal, ser_liquid, nro_liquid,
                                                         fec_liquid,fec_proceso, tip_cambio_us, tipo_liq, tip_liquid )
                                                values ( :P0_ID_EMPRESA, :P0_ID_SUCURSAL, :P370_SER_LIQUID, :P370_NRO_LIQUID,
                                                         :P370_FEC_LIQUID, sysdate, :P370_TIP_CAMBIO_US, :P370_TIPO_LIQ, '28' ) ;
                     when others then 
                          RAISE_APPLICATION_ERROR(-20000, 'Error en la tabla de liquidaciones' || sqlerrm )  ;
                  end ;
                 
                   ------------------------------------------------
                  -- Hace el calculo de provision de vacaciones --
                  --   en caso que la liquidacion sea mensual   --
                  ------------------------------------------------
                  IF :P370_TIP_LIQUID = 'M' THEN
                    actualiza_vacaciones(:P370_ID_EMPRESA, :P0_ID_SUCURSAL, :P370_ID_EMPLEADO, :P370_FEC_LIQUID, :P370_NRO_LIQUID,
                    :P370_SER_LIQUID);
                    --actualiza_vacaciones_reales;
                   NULL;
                  END IF;
                  LIQUID_EMPLEADO(:P0_ID_EMPRESA, :P370_ID_EMPLEADO, :P370_ID_SUCURSAL, :P370_CENTRO_COSTO,
                  :P370_CONC_SUELDO, :P370_FEC_DESDE, :P370_FEC_HASTA, :P370_TIP_LIQUID, :P370_FEC_LIQUID,
                  :P370_CONC_ASOCIACION, :P370_ANIO, :P370_MES, :P370_ID_CENTRO_PAGO, :P370_CANTAFBAS,
                  :P370_MONTAFBAS, :P370_CREO_CABECERA, :P370_SALARIO_MINIMO, :P370_TIPO_LIQ, :P370_NRO_LIQUID,
                  :P370_SER_LIQUID, :P370_TOT_EMPLEADO, :P370_MONTO_1, :P370_MONTO_2, :P370_TOT_HABER_IPS, 
                  :P370_CONC_HONORARIOS, :P370_CONC_HONORARIOS_SIN_IVA, :P370_CONC_EN_USS, :P370_TOTAL_HABER,
                  :P370_COMPL_SUELDO, :P370_CONC_AGUIN, :P370_CONC_BONIF, :P370_JORNAL_MES, :P370_PORC_BONIF,
                  :P370_LIMITE_BONIF, :P370_PORC_IPS, :P370_TOT_HABER_PARA_DEMANDA, :P370_TIP_CAMBIO_US, 
                  :P370_PLAN_CONCEPTOS, :P370_TOTAL_SALDO_ROJO, :P370_CONC_IPS, :P370_PORC_IVA, :P370_CONC_IVA,
                  :P370_PORC_RETENCION, :P370_PORC_RETENCION, :P370_CONC_REDON, :APP_USER, :P370_ID) ;  
                  BORRA_CAB;
                EXCEPTION
                  when others then
                    RAISE_APPLICATION_ERROR (-20000, 'Error en el proceso  '|| sqlerrm);
                    rollback;
                END;
                
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 47292027535787220
        }
        serverSideCondition {
            whenButtonPressed: @execute
        }
    )

