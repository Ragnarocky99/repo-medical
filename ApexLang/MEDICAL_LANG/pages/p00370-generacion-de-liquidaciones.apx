    process parametros (
        name: PARAMETROS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P370_CONC_SUELDO := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro('RH', 'RH_CONC_SUELDO'));
                :P370_CONC_BONIF := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_BONIF' ));
                --:variables.ips_defecto              := Busca_parametro( 'RH', 'RH_SIN_ESTADO_IPS' );
                :P370_PORC_RETENCION           := W_Busca_parametro( 'CP', 'PORC_RET_IVA' );
                :P370_porc_bonif               := W_Busca_parametro( 'RH', 'RH_PORC_BONIF' );
                --:VARIABLES.activo_ips               := Busca_parametro( 'RH', 'RH_IPS_ENTRADA' );
                --:VARIABLES.conc_comple              := Busca_parametro( 'RH', 'RH_CONC_COMPLEMENTO' );
                :P370_conc_asociacion          := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_Busca_parametro( 'RH', 'RH_CONC_ASOCIACION' ));
                :P370_conc_ips                 := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_Busca_parametro( 'RH', 'RH_CONC_IPS' ));
                :P370_porc_ips                 := W_Busca_parametro( 'RH', 'RH_PORC_IPS' );
                :P370_conc_iva                 := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_Busca_parametro( 'RH', 'RH_CONC_IVA' ));
                :P370_porc_iva                 := W_Busca_parametro( 'RH', 'RH_PORC_IVA' );
                :P370_conc_redon               := W_Busca_parametro( 'RH', 'RH_CONC_REDON' );
                --:P370_conc_he_noips            := Busca_parametro( 'RH', 'RH_CONC_HOR_EXT'  );
                --:P370_conc_comis               := Busca_parametro( 'RH', 'RH_CONC_COMIS'  );
                :P370_conc_aguin               := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_Busca_parametro( 'RH', 'RH_CONC_AGUIN' ));
                :P370_limite_bonif             := to_number( ltrim( rtrim( W_Busca_parametro( 'RH', 'RH_LIMITE_BONIF' ) ) ) );
                :P370_jornal_mes               := to_number( ltrim( rtrim( W_Busca_parametro( 'RH', 'RH_JORNAL_MES' ) ) ) );
                --:P370_jornalero                := busca_parametro( 'RH', 'JORNALERO') ;
                :P370_conc_honorarios          := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro( 'RH', 'RH_CONC_HONORARIOS')) ;
                --:P370_conc_superior            := busca_parametro( 'RH', 'RH_CONC_SUPERIOR') ;
                :P370_plan_conceptos           := W_busca_parametro ( 'RH', 'PLA_P_CALC_SAL_ROJ_A' );
                :P370_conc_honorarios_sin_iva  := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro ( 'RH', 'RH_PROF_SIN_IVA' ));
                :P370_conc_en_uss              := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_busca_parametro ( 'RH', 'RH_CONC_USS' ));
                --:P370_procesar_pagos           := W_busca_per_forma( :variables.cod_empresa, user, 'PERMITE_REPROCESAR_PAGOS', :variables.cod_forma );
                :P370_compl_sueldo             := W_busca_parametro( 'RH', 'RH_CONC_COMPL') ;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44250885919144029
        }
    )

)

