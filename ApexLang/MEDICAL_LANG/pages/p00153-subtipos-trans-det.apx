page 153 (
    name: Subtipos de Transacciones Detalle
    alias: SUBTIPOS-TRANS-DET
    title: Subtipos de Transacciones Detalle
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cuentas-bancarias-por-sucursal (
        name: Cuentas Bancarias por Sucursal
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region subtipos-de-transacciones-detalle (
        name: Subtipos de Transacciones Detalle
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       ST.ID_MODULO,
                       ST.ID_TIPO_TRANS,
                       D.ID_SUBTIPO_TRANS,
                       ST.SUBTIPO_TRANS,
                       ST.DESCRIPCION,
                       D.ID_SUCURSAL,
                       D.ID_MONEDA,
                       D.ID_CUENTA,
                       D.COD_USUARIO_AUD
                  from BSW_SUBTIPOS_TRANS_DET D, BSW_SUBTIPOS_TRANS ST
                  where D.ID_SUBTIPO_TRANS = ST.ID
                        and D.ID_SUBTIPO_TRANS = :P153_P151_ID_SUBTIPO_TRANS
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: SUB
        }
        link {
            linkColumn: customTarget
            target: {
                page: 154
                items: {
                    P154_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 18185998925878637
        }

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_CUENTA (
            type: plainTextBasedOnLov
            heading {
                heading: Cuenta
            }
            lov {
                lov: @cow-plan-cuentas-cod-cuenta
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_MODULO (
            type: plainTextBasedOnLov
            heading {
                heading: Módulo
                alignment: center
            }
            lov {
                lov: @bsw-modulos-cod-modulo
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_MONEDA (
            type: plainTextBasedOnLov
            heading {
                heading: Moneda
            }
            lov {
                lov: @lv-monedas
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_SUBTIPO_TRANS (
            type: plainText
            heading {
                heading: ID Subtipo de Transacción
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_TIPO_TRANS (
            type: plainTextBasedOnLov
            heading {
                heading: Tipo
                alignment: center
            }
            lov {
                lov: @lv-tipos-trans
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column SUBTIPO_TRANS (
            type: plainText
            heading {
                heading: Subtipo
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Subtipos de Transacciones Detalle
        }

        savedReport 182023 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ID_CUENTA (
                sequence: 7
            )

            displayColumn ID_MODULO (
                sequence: 1
            )

            displayColumn ID_MONEDA (
                sequence: 6
            )

            displayColumn ID_SUCURSAL (
                sequence: 5
            )

            displayColumn ID_TIPO_TRANS (
                sequence: 2
            )

            displayColumn SUBTIPO_TRANS (
                sequence: 3
            )

        )

    )

    pageItem P153_INFO (
        type: hidden
        layout {
            sequence: 20
            region: @cuentas-bancarias-por-sucursal
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                 select  M.DESCRIPCION ||' ('|| M.COD_MODULO ||'), '||
                        TT.DESCRIPCION ||' ('|| TT.TIPO_TRANS ||'), '||
                        ST.DESCRIPCION||' ('|| ST.SUBTIPO_TRANS ||') '
                  from BSW_SUBTIPOS_TRANS ST, BSW_TIPOS_TRANS TT, BSW_MODULOS M
                  where ST.ID_MODULO = M.ID
                       AND ST.ID_TIPO_TRANS = TT.ID
                        and ST.ID = :P153_P151_ID_SUBTIPO_TRANS
                ```
        }
    )

    pageItem P153_P151_ID_SUBTIPO_TRANS (
        type: hidden
        layout {
            sequence: 10
            region: @cuentas-bancarias-por-sucursal
            slot: regionBody
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @subtipos-de-transacciones-detalle
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 154
                items: {
                    P154_ID_SUBTIPO_TRANS: &P153_P151_ID_SUBTIPO_TRANS.
                    P154_SUBTIPO_DESCRIPCION: &P153_P151_ID_SUBTIPO_TRANS.
                }
                clearCache: 154
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @subtipos-de-transacciones-detalle
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @subtipos-de-transacciones-detalle
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

