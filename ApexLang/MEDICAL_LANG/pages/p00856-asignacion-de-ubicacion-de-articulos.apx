        }
    )

    region existencia (
        name: Existencia
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: STW_EXISTENCIA_ART
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA
                AND CANT_DISPON > 0
                AND (ID_ARTICULO = :P856_ID_ARTICULO OR :P856_ID_ARTICULO IS NULL)
                AND (ID_SUCURSAL = :P856_ID_SUCURSAL OR :P856_ID_SUCURSAL IS NULL)
                ```
            pageItemsToSubmit: [
                P856_ID_SUCURSAL
                P856_ID_ARTICULO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 105166070763679816
        }

