    pageItem P235_NUM_ASIENTO (
        type: numberField
        label {
            label: <p>Nro. Asiento: </p>
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 90
            region: @carga-de-asientos-diarios-provisorios
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            cssClasses: no-pointer
            width: 30
        }
        advanced {
            cssClasses: comprobante
        }
        source {
            formRegion: @carga-de-asientos-diarios-provisorios
            column: NUM_ASIENTO
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Autogenera el número de asiento
                DECLARE
                    vNumAsiento COW_DIARIO_CABECERAS_PROV.NUM_ASIENTO%TYPE;
                    
                BEGIN
                
                        BEGIN
                            SELECT NVL(MAX(NUM_ASIENTO),0)+1
                                INTO vNumAsiento
                            FROM COW_DIARIO_CABECERAS_PROV DC, 
                                 COW_EJERCICIOS EJ
                            WHERE DC.ID_EMPRESA      = :P0_COD_EMPRESA
                                AND EJ.COD_EJERCICIO = :P0_COD_EJERCICIO
                                AND DC.ID_EJERCICIO  = EJ.ID;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    vNumAsiento := 1;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el número de asiento'||sqlerrm);
                        END;
                
                    RETURN vNumAsiento;
                
                END;
                
                ```
        }
    )

