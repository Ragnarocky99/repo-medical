page 235 (
    name: Carga de Asientos Diarios Provisorios
    alias: CARGA-DE-ASIENTOS-DIARIOS-PROVISORIOS
    title: Carga de Asientos Diarios Provisorios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            // Monto debe, monto haber
            
            function totalDebe(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cant_debe  = model.getFieldKey("MON_DEBE_COPIA");
                var v_mon_debe   = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                        let v_debe     = r[v_cant_debe].replace(/\./g,'');
                          
                        v_mon_debe     = v_mon_debe  + parseFloat(v_debe.replace(',','.')) || 0;
            
                       //console.log("DEBE NRO. " + index + ": " + v_debe);
                    }
                    
                    
                });
            
                 $s('P235_TOT_DEBE',v_mon_debe.toString().replace('.', ','));
            
                 //console.log("Total debe: " + v_mon_debe);
            
            }
            
            
            function totalHaber(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cant_haber = model.getFieldKey("MON_HABER_COPIA");
                var v_mon_haber  = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
            
                        let v_haber    = r[v_cant_haber].replace(/\./g,'');
                          
                        v_mon_haber    = v_mon_haber + parseFloat(v_haber.replace(',','.')) || 0;
            
                        //console.log("HABER NRO. " + index + ": " + v_haber);
                       
                    }
                    
                    
                });
            
                 $s('P235_TOT_HABER',v_mon_haber.toString().replace('.', ','));
            
                 //console.log("Total haber: " + v_mon_haber);
            
            }
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            //Totales
            document.getElementById("P235_TOT_DEBE").readOnly = true;
            document.getElementById("P235_TOT_HABER").readOnly = true;
            document.getElementById("P235_TIPO_CAMBIO").readOnly = true;
            document.getElementById("P235_DIFERENCIA").readOnly = true;
            
            //Descripcion
            document.getElementById("P235_DESCRIPCION_CUENTA").readOnly = true;
            document.getElementById("P235_DESCRIPCION_DETALLADA").readOnly = true;
            
            //Cabecera
            document.getElementById("P235_NUM_ASIENTO").readOnly = true;
            
            ```
