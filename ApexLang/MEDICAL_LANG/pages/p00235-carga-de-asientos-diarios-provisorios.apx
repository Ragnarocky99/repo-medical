    dynamicAction calcula-diferencia-haber (
        name: CALCULA DIFERENCIA HABER
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P235_TOT_HABER
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vTotDebe    NUMBER(20,2);
                        vTotHaber   NUMBER(20,2);
                        vDiferencia NUMBER(20,2);
                    
                    BEGIN
                        DBMS_LOCK.SLEEP(0.3);
                        /*Inicializa variables*/
                        vTotDebe         := REPLACE(NVL(:P235_TOT_DEBE, 0),'.','');
                        vTotHaber        := REPLACE(NVL(:P235_TOT_HABER,0),'.','');
                    
                        vDiferencia      := ABS(vTotDebe - vTotHaber);
                    
                        :P235_DIFERENCIA := vDiferencia;
                    END;
                    ```
                itemsToSubmit: [
                    P235_TOT_HABER
                    P235_TOT_DEBE
                ]
                itemsToReturn: P235_DIFERENCIA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction descripcion-detallada (
