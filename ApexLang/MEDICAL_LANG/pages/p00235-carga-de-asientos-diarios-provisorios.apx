    region carga-de-asientos-diarios-provisorios (
        name: Carga de Asientos Diarios Provisorios
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.ID,
                       C.ID_EMPRESA,
                       C.ID_EJERCICIO,
                       C.NUM_ASIENTO,
                       C.ID_SUCURSAL,
                       C.ID_MODULO,
                       C.FEC_ASIENTO,
                       C.DESCRIPCION,
                       C.EJERCICIO_CERRADO,
                       C.IND_MAYORIZADO,
                       C.ID_MONEDA,
                       C.TIPO_CAMBIO,
                       C.ASIENTO_AUTOMATICO,
                       C.IND_ASIENTO_CIERRE,
                       C.IND_ASIENTO_APERTURA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.IND_ASIENTO_MANUAL,
                       C.FEC_ALTA,
                       C.COD_USUARIO_AUD,
                       C.ID_USUARIO,
                       C.ID_USUARIO_MOD,
                       C.FEC_MODIFICACION,
                       C.FEC_CARGA
                FROM COW_DIARIO_CABECERAS_PROV C
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT D.ID,
                       D.ID_EMPRESA,
                       D.ID_SUCURSAL,
                       D.ID_EJERCICIO,
                       D.NUM_ASIENTO,
                       D.NUM_LINEA,
                       D.ID_DIARIO_CAB,
                       D.ID_PLAN_CUENTA,
                       D.ID_CENTRO,
                       D.DESCRIPCION,
                       D.DESCRIPCION AS DESCRIPCION_COPIA,
                       D.MON_DEBE,
                       D.MON_HABER,
                       D.MON_DEBE AS MON_DEBE_COPIA,
                       D.MON_HABER AS MON_HABER_COPIA,
                       D.MON_ORI,
                       D.FEC_ASIENTO,
                       D.TIPO_CAMBIO,
                       D.ID_MONEDA,
                       D.ID_SUBGRUPO_CUENTA,
                       D.ID_COMPROBANTE,
                       D.TIP_COMPROBANTE,
                       D.SER_COMPROBANTE,
                       D.NRO_COMPROBANTE,
                       D.NRO_COMPROBANTE_REAL,
                       D.ID_USUARIO_MOD,
                       D.ID_USUARIO,
                       D.FEC_MODIFICACION,
                       D.FEC_CARGA,
                       D.ID_SUBCUENTA,
                       D.ID_CONCEPTO_COMP,
                       D.COD_USUARIO_AUD
                FROM COW_DIARIO_DETALLES_PROV D
                WHERE D.ID_DIARIO_CAB = :P235_ID
                ```
            pageItemsToSubmit: P235_ID
        }
