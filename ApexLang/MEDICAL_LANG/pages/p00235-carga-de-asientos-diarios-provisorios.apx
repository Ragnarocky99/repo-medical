    computation p235-num-asiento (
        itemName: P235_NUM_ASIENTO
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Autogenera el número de asiento
                DECLARE
                    vNumAsiento COW_DIARIO_CABECERAS_PROV.NUM_ASIENTO%TYPE;
                BEGIN
                        BEGIN
                            SELECT NVL(MAX(NUM_ASIENTO),0)+1
                                INTO vNumAsiento
                            FROM COW_DIARIO_CABECERAS_PROV DC, 
                                 COW_EJERCICIOS EJ
                            WHERE DC.ID_EMPRESA      = :P0_COD_EMPRESA
                                AND EJ.COD_EJERCICIO = :P0_COD_EJERCICIO
                                AND DC.ID_EJERCICIO  = EJ.ID;
                            EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                    vNumAsiento := 1;
                                WHEN OTHERS THEN
                                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar el número de asiento'||sqlerrm);
                        END;
                
                    RETURN vNumAsiento;
                
                END;
                
                ```
        }
        error {
            errorMessage: No se pudo auto-generar el Nro. de Asiento.
        }
        serverSideCondition {
            type: itemIsNull
            item: P235_ID
        }
    )

    computation p235-tot-debe (
        itemName: P235_TOT_DEBE
        execution {
            sequence: 30
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE 
                VTOT NUMBER :=0;
                BEGIN
                SELECT NVL(SUM(D.MON_DEBE),0)
                INTO VTOT
                FROM COW_DIARIO_DETALLES_PROV D
                WHERE D.ID_DIARIO_CAB = :P235_ID;
                RETURN VTOT;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P235_ID
        }
    )

