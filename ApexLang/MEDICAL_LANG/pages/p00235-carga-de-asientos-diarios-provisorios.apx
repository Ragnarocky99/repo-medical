    validation validar-diferencia (
        name: VALIDAR_DIFERENCIA
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF REPLACE(:P235_DIFERENCIA,'.','') = 0 THEN
                        RETURN true;
                    ELSE
                        return false;
                    END IF; 
                END;
                ```
        }
        error {
            errorMessage: El monto debe y haber deben tener una diferencia igual a 0.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GUARDAR,APLICAR
        }
    )

    validation validar-totales-cero (
        name: VALIDAR_TOTALES_CERO
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vMensajeError VARCHAR2(200);
                    vTotalDebe    NUMBER(20,2);
                    vTotalHaber   NUMBER(20,2);
                
                BEGIN
                    /*Inicialización de variables*/
                    vTotalDebe := NVL(REPLACE(:P235_TOT_DEBE,'.',''), 0);
                    vTotalHaber := NVL(REPLACE(:P235_TOT_HABER,'.',''), 0);
                
                    IF vTotalDebe = 0 AND vTotalHaber = 0 THEN
                        RETURN 'Los totales no pueden quedar en 0.';
                    ELSE
                        RETURN NULL;
                    END IF;
                END;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GUARDAR,APLICAR
        }
    )

