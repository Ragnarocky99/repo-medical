page 288 (
    name: Contactos
    alias: CONTACTOS
    title: Contactos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region contactos (
        name: Contactos
        type: interactiveReport
        source {
            location: restSource
            restSource: @Contactos
        }
        localPostProcessing {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       NAME,
                       PHONE,
                        (SELECT LISTAGG(NAME,',') FROM WH_GRUPOS WHERE ID IN (SELECT  TO_NUMBER(COLUMN_VALUE) 
                  FROM XMLTABLE( (regexp_replace(dbms_lob.substr("groups", 32000, 1 ),'\[|\]|"',''))))) AS GRUPOS
                  from #APEX$SOURCE_DATA#
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 280
                items: {
                    P280_ID: #ID#
                    P280_NOMBRE: #NAME#
                    P280_NUMERO: #PHONE#
                }
            }
            linkIcon: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 67259143452340001
        }

        column GRUPOS (
            type: plainTextBasedOnLov
            heading {
                heading: Grupos
                alignment: center
            }
            lov {
                lov: @lv-grupos-contactos
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PHONE (
            type: plainText
            heading {
                heading: Telefono
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Contactos
        }

        savedReport 672607 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn GRUPOS (
                sequence: 3
            )

            displayColumn NAME (
                sequence: 1
            )

            displayColumn PHONE (
                sequence: 2
            )

        )

        parameter (
            name: @limit
            value {
                type: staticValue
                staticValue: 100
            }
        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @contactos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 280
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @crear
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @contactos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-luego-de-borrado (
        name: Refrescar luego de borrado
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @contactos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @contactos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

