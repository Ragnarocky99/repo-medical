    dynamicAction cargar-datos-empleados (
        name: Cargar Datos Empleados
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P827_ID_PERSONA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                       SELECT NRO_CI,
                              NVL(PE.PRIMER_NOMBRE||DECODE(PE.SEGUNDO_NOMBRE, NULL, NULL, ' '||PE.SEGUNDO_NOMBRE), PE.NOMBRE) NOMBRES,
                              PE.PRIMER_APELLIDO||DECODE(PE.SEGUNDO_APELLIDO, NULL, NULL, ' '||PE.SEGUNDO_APELLIDO) APELLIDOS,
                              FEC_NACIMIENTO,
                              DIRECCION,
                              CI.DESCRIPCION CIUDAD,
                              BA.DESCRIPCION BARRIO,
                              TELEFONO,
                              VEHICULO,
                              CHAPA
                         FROM BSW_PERSONAS PE
                    LEFT JOIN BSW_CIUDADES CI ON CI.ID = PE.ID_CIUDAD
                    LEFT JOIN BSW_BARRIOS  BA ON BA.ID = PE.ID_BARRIO
                     WHERE PE.ID = :P827_ID_PERSONA
                    ```
                itemsToSubmit: P827_ID_PERSONA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: [
                    P827_NRO_CI
                    P827_NOMBRES
                    P827_APELLIDOS
                    P827_FEC_NACIMIENTO
                    P827_DIRECCION
                    P827_CIUDAD
                    P827_BARRIO
                    P827_TELEFONO
                    P827_VEHICULO
                    P827_CHAPA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p827-cod-empleado (
        itemName: P827_COD_EMPLEADO
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_EMPLEADO)), 0) + 1
                  FROM RHW_EMPLEADOS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P827_ID_EMPLEADO
        }
    )

