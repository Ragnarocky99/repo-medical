page 149 (
    name: Tipos de Transacciones
    alias: TIPOS-DE-TRANSACCIONES
    title: Tipos de Transacciones - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tipos-de-transacciones (
        name: Tipos de Transacciones
        type: interactiveReport
        source {
            location: localDatabase
            tableName: BSW_TIPOS_TRANS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 150
                items: {
                    P150_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 17157343084799765
        }

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column CONTABILIZA (
            type: plainText
            heading {
                heading: Contabiliza
                alignment: center
            }
            layout {
                sequence: 53
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column COSTO_X_SERVIC (
            type: plainText
            heading {
                heading: Costo por Servicio
                alignment: center
            }
            layout {
                sequence: 63
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
            }
            layout {
                sequence: 43
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 83
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_MODULO (
            type: plainTextBasedOnLov
            heading {
                heading: Módulo
            }
            lov {
                lov: @bsw-modulos-cod-modulo
            }
            layout {
                sequence: 23
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: D
            }
        )

        column IMPRIME_COMPROB (
            type: plainText
            heading {
                heading: Imprime Comprobante
                alignment: center
            }
            layout {
                sequence: 73
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ROWID (
            type: hidden
            heading {
                heading: ROWID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: OTHER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TIPO_TRANS (
            type: plainText
            heading {
                heading: Tipo de Transacción
            }
            layout {
                sequence: 33
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                TIPOS DE TRANSACCIONES
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 171763 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ID_MODULO (
                sequence: 1
            )

            displayColumn TIPO_TRANS (
                sequence: 2
            )

            sort (
                column: ID_MODULO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: TIPO_TRANS
                sort {
                    sequence: 2
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @tipos-de-transacciones
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 150
                clearCache: 150
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tipos-de-transacciones
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tipos-de-transacciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17357420440492770
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

