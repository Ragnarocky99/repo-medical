                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region revaluo (
        name: Revaluo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RE.ID,
                       TB.DESCRIPCION AS DESCRIPCION_TB,
                       RE.ID_BIEN,
                       BU.DESCRIPCION,
                       BU.FEC_COMPRA,
                       BU.MON_COSTO,
                       RE.COEFICIENTE,
                       TB.PORC_VALOR_RESIDUAL,
                       RE.VALOR_RESIDUAL,
                       RE.VIDA_UTIL,
                       RE.ANIO_RESTO_VIDA,
                       RE.MON_NETO_ANTERIOR,
                       RE.MON_REV,
                       RE.MON_DEP_ACUMULADO_ANT,
                       RE.MON_DEP,
                       RE.MON_DEP_ACUMULADO,
                       RE.MON_NETO,--fin de los fiscales
                       RE.VALOR_RESIDUAL_CONT,
                       RE.VIDA_UTIL_CONT,
                       RE.ANIO_RESTO_VIDA_CONT,
                       RE.MON_NETO_ANTERIOR_CONT,
                       RE.MON_REV_CONT,
                       RE.MON_DEP_ACUMULADO_ANT_CONT,
                       RE.MON_DEP_CONT,
                       RE.MON_DEP_ACUMULADO_CONT,
                       RE.MON_NETO_CONT,--fin de los contables
                       RE.ID_EMPRESA,
                       RE.ANIO,
                       RE.MES,
                       RE.COEFICIENTE_ANT,
                       RE.COEF_VENTA,
                       RE.COEF_COMPRA,
                       RE.IND_DEPRECIAR,
                       RE.MON_REV_ACUMULADO,
                       RE.MON_REV_ACUMULADO_CONT
                
                from COW_REVALUO RE, COW_BIENES_USO BU, COW_TIPOS_BIENES TB
                WHERE RE.ANIO = TO_CHAR(:P497_ANIO)
                AND BU.ID = RE.ID_BIEN
                AND TB.ID = RE.ID_TIPO_BIEN
                ```
            pageItemsToSubmit: P497_ANIO
        }
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: Revaluo
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 63349760132052617
        }

