    button ejecutar (
        buttonName: EJECUTAR
        label: Ejecutar
        layout {
            sequence: 10
            region: @botones
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-dynamic-content
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 20
            region: @botones
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-buttom (
        name: REFRESH_BUTTOM
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @ejecutar
        }

        action native-alert (
            action: alert
            settings {
                title: Atención
                message: &P497_MENSAJE_PROCEDIMIENTO.
                style: information
                icon: fa-info-circle
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P497_MENSAJE_PROCEDIMIENTO
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        vmensaje varchar2(500);
                        
                    begin
                        afw_busca_datos_bienes(p_empresa => :P0_ID_EMPRESA
                                              ,p_sucursal => :P0_ID_SUCURSAL
                                              ,p_anio => TO_CHAR(:P497_ANIO)
                                              ,p_mes => TO_CHAR(:P497_MES)
                                              ,pmensaje_error => vmensaje);
                        commit;
                        --:P497_MENSAJE_PROCEDIMIENTO := vmensaje;
                    /*exception
                       when others then
                          raise_application_error(-20000,'Error inesperado al ejecutar desde la aplicación');*/
                    end;
                    ```
                itemsToSubmit: [
                    P497_ANIO
                    P0_ID_EMPRESA
                    P0_ID_SUCURSAL
                    P497_MES
                ]
                itemsToReturn: P497_MENSAJE_PROCEDIMIENTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @revaluo
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh (
            name: Refresh
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Revaluo").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P497_ANIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @revaluo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

