        }

        action refresh (
            name: Refresh
            action: refresh
            affectedElements {
                selectionType: region
                region: @revaluo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 521
                items: {
                    P497_REVALUO_CONT: &P497_REVALUO_CONT.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

