    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @propietario-fracciones
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                IF :P565_SUMA_FRACC <> 100 THEN
                RAISE_APPLICATION_ERROR(-20000,'LA SUMA TOTAL DEL % FRACCION DEBE SER IGUAL A 100 ');
                --RETURN FALSE;
                ELSE 
                --RETURN TRUE;
                RAISE_APPLICATION_ERROR(-20000,'aqui ');
                NULL;
                END IF; 
                
                END;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

