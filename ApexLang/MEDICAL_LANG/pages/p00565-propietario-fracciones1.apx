page 565 (
    name: Propietario Fracciones
    alias: PROPIETARIO-FRACCIONES1
    title: Propietario Fracciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
             function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("TOTAL_COPIA");
                var v_porcentaje = 0;
            
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                        try{
                        v_porcentaje = parseFloat(r[v_cantidad].replace(/\./g,''));
                        v_total_cantidad      = v_total_cantidad  + v_porcentaje;
            
                             if (v_total_cantidad > 100){
                                apex.message.alert('El total del % fraccion no puede ser mayor a 100 ');
                               model.setValue(r,'PORC_FRACCION',0) ;
                               model.setValue(r,'TOTAL_COPIA',0) ;
                                v_total_cantidad      = v_total_cantidad - v_porcentaje;
            
                            }  
            
                        }  catch(e){
                            
                        }  
            
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                 
            
                 $s('P565_SUMA_FRACC',v_total_cantidad);
            }
            ```
    }
