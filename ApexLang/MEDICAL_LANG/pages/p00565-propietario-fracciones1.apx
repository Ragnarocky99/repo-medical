        name: Propietario Fracciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_FRACCION,
                       NRO_ORDEN,
                       ID_CLIENTE,
                       PORC_FRACCION,
                       PORC_FRACCION AS TOTAL_COPIA,
                       PORC_COM_ADMINIST,
                       IND_PROP,
                       IND_DIST,
                       IND_DEFECTO,
                       IND_RETENCION,
                       IND_RETENCION_30,
                       CUOTA_COMISION_DESDE,
                       CUOTA_COMISION_HASTA
                  from LTW_PROPIETARIO_FRACCIONES
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  AND ID_FRACCION = :P565_FRACCION
                  --AND ID_CLIENTE = :P565_CLIENTE
                ```
