    process setear (
        name: Setear
        type: executeCode
        editableRegion: @propietario-fracciones
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS='C'  THEN 
                :id_empresa := :P0_ID_EMPRESA;
                :ID_FRACCION := :P565_FRACCION;
                ----:ID_CLIENTE := :P556_CLIENTE;
                END IF;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 91887273201411701
        }
    )

    process suma (
        name: Suma
        type: executeCode
        editableRegion: @propietario-fracciones
        source {
            plsqlCode:
                ```plsql
                :P565_SUMA_FRACC:=NVL(:P565_SUMA_FRACC,0)+:PORC_FRACCION;
                :P565_FILA      := nvl(:P565_FILA,0)+1;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 91241389663492913
        }
        serverSideCondition {
            executionScope: allSubmittedRows
        }
    )

    process suma-de-porcentaje-fracciones (
        name: Suma de porcentaje fracciones
        type: executeCode
        editableRegion: @propietario-fracciones
        source {
            plsqlCode:
                ```plsql
                declare
                v_total number(18,3);
                begin
                if  :P565_FILA = 1  then
                    SELECT SUM(PORC_FRACCION)
                    INTO V_TOTAL
                    FROM LTW_PROPIETARIO_FRACCIONES
                    WHERE ID_FRACCION=:P565_FRACCION;
                end if;
                
                    IF :APEX$ROW_STATUS<>'D'  THEN 
                            IF (:P565_SUMA_FRACC + nvl(V_TOTAL,0) <> 100) THEN
                            RAISE_APPLICATION_ERROR(-20000,'El total del porcentaje de fraccion no puede ser diferente a 100, favor validar ');
                            END IF;
                    ELSE 
                        SELECT SUM(PORC_FRACCION)
                        INTO V_TOTAL
                        FROM LTW_PROPIETARIO_FRACCIONES
                        WHERE ID_FRACCION=:P565_FRACCION;
                
                        if nvl(V_TOTAL,0)<> 0 and nvl(V_TOTAL,0)<> 100 then
                            RAISE_APPLICATION_ERROR(-20001,'El total del porcentaje de fraccion no puede ser diferente a 100, favor validar');
                        end if;
                    END IF;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 91241436083492914
        }
        serverSideCondition {
            executionScope: allSubmittedRows
        }
    )

)

