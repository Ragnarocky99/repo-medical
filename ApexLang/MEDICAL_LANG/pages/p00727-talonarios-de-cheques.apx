page 727 (
    name: Talonarios de Cheques
    alias: TALONARIOS-DE-CHEQUES
    title: Talonarios de Cheques
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region talonarios-de-cheques (
        name: Talonarios de Cheques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select tc.ID,
                       tc.ID_EMPRESA,
                       tc.ID_CUENTA_BANCARIA,
                       tc.NRO_TALONARIO,
                       tc.SERIE,
                       tc.NUMERO_INICIAL,
                       tc.NUMERO_FINAL,
                       decode(tc.activo, 'S', 'SI', 'NO') as ACTIVO,
                       tc.COD_USUARIO_AUD,
                       decode(tc.tipo, 'V', 'Vista', 'D', 'Diferido') as TIPO,
                       cb.referencia
                  from CCW_TALONARIOS_CHEQUES tc
                  join CCW_CUENTAS_BANCARIAS  cb on cb.id = tc.id_cuenta_bancaria
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derecho-pagina-3
        }
        link {
            linkColumn: customTarget
            target: {
                page: 728
                items: {
                    P728_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 70890768807710290
        }

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_CUENTA_BANCARIA (
            type: plainTextBasedOnLov
            heading {
                heading: Cuenta Bancaria
                alignment: end
            }
            lov {
                lov: @ccw-cuentas-bancarias-talon
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID_EMPRESA (
            type: plainText
            heading {
                heading: Id Empresa
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column NRO_TALONARIO (
            type: plainText
            heading {
                heading: Nro Talonario
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NUMERO_FINAL (
            type: plainText
            heading {
                heading: Numero Final
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column NUMERO_INICIAL (
            type: plainText
            heading {
                heading: Numero Inicial
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column REFERENCIA (
            type: plainText
            heading {
                heading: Referencia
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column SERIE (
            type: plainText
            heading {
                heading: Serie
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Talonarios de Cheques
        }

        savedReport 708977 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVO (
                sequence: 7
            )

            displayColumn ID_CUENTA_BANCARIA (
                sequence: 1
            )

            displayColumn NRO_TALONARIO (
                sequence: 3
            )

            displayColumn NUMERO_FINAL (
                sequence: 6
            )

            displayColumn NUMERO_INICIAL (
                sequence: 5
            )

            displayColumn REFERENCIA (
                sequence: 2
            )

            displayColumn SERIE (
                sequence: 4
            )

            displayColumn TIPO (
                sequence: 8
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @talonarios-de-cheques
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 728
                clearCache: 728
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @talonarios-de-cheques
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @talonarios-de-cheques
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

