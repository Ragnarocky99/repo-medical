    region ranking-de-clientes (
        name: Ranking de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CC.COD_CLIENTE,
                       P.NOMBRE,
                       M.DECIMALES,
                       CL.DESCRIPCION AS TIP_CLIENTE,
                SUM(DECODE(TC.SALDOS, 'R', NVL(D.CANTIDAD,0)*-1, NVL(D.CANTIDAD,0))) CANTIDAD,
                
                CL.DESCRIPCION DESC_TIP_CLIENTE,
                
                       /*SUM( DECODE( LTRIM( RTRIM(  M.COD_MONEDA ) ), LTRIM( RTRIM( PG.VALOR ) ),
                            DECODE( TC.SALDOS, 'R', NVL( D.MONTO_TOTAL+TOTAL_IVA, 0 ) * -1, NVL( D.MONTO_TOTAL+TOTAL_IVA, 0 ) ),
                            ROUND( DECODE( TC.SALDOS, 'R', ( NVL( D.MONTO_TOTAL+TOTAL_IVA, 0 ) ) * -1
                            * ( NVL( C.TIP_CAMBIO, 1 ) / NVL( C.CAMBIO_MONEDA_PRECIO, 1 ) ),
                            NVL( D.MONTO_TOTAL+TOTAL_IVA, 0 ) * NVL( C.TIP_CAMBIO, 1 ) / NVL( C.CAMBIO_MONEDA_PRECIO, 1 ) ), NVL( M.DECIMALES, 0 ) ) ) )  TOTALES*/
                     /*  SUM( DECODE( LTRIM( RTRIM(  C.COD_MONEDA ) ), LTRIM( RTRIM( PG.VALOR ) ),
                            DECODE( TC.SALDOS, 'R', NVL( D.DESCUENTO, 0 ) * -1, NVL( D.DESCUENTO ,0 )  ),
                            ROUND( DECODE( TC.SALDOS, 'R', ( NVL( D.DESCUENTO, 0 ) ) * -1
                            * ( NVL( C.TIP_CAMBIO, 1 ) / NVL( C.CAMBIO_MONEDA_PRECIO, 1 ) ),
                            NVL( D.DESCUENTO, 0 )  *  NVL( C.TIP_CAMBIO, 1 ) / NVL( C.CAMBIO_MONEDA_PRECIO, 1 ) ), NVL( M.DECIMALES, 0 ) ) ) ) DESCUENTO,
                            COUNT( DISTINCT( DECODE( TC.SALDOS, 'R', NULL, C.TIP_COMPROBANTE || C.SER_COMPROBANTE || TO_CHAR( C.NRO_COMPROBANTE ) ) ) ) CANTIDAD*/
                        SUM((NVL(D.MONTO_TOTAL,0)+NVL(D.TOTAL_IVA,0)) * DECODE(TC.SALDOS,'R',-1,1)) totales
                   
                   FROM VTW_COMPROBANTES_CABECERA C,
                        BSW_TIPOS_COMPROBANTES TC,
                        BSW_PARAMETROS_GENERALES PG,
                        BSW_MONEDAS M,
                        VTW_COMPROBANTES_DETALLE D,
                        STW_ARTICULOS ART,
                        BSW_PERSONAS P,
                        CCW_CLIENTES CC,
                        CCW_TIPO_CLIENTE CL,
                        BSW_EMPRESAS E
                   WHERE C.ID_EMPRESA         = :P0_ID_EMPRESA
                     AND ( C.ID_SUCURSAL      = :P422_ID_SUCURSAL OR :P422_ID_SUCURSAL IS NULL        )
                     AND ( C.ID_VENDEDOR      = :P422_ID_VENDEDOR OR :P422_ID_VENDEDOR IS NULL        )
                     AND ( :P422_ID_RUBRO        IS NULL OR ART.ID_RUBRO     = :P422_ID_RUBRO      )
                     AND ( :P422_ID_FAMILIA      IS NULL OR ART.ID_FAMILIA   = :P422_ID_FAMILIA       )
                     AND ( :P422_ID_LINEA       IS NULL OR ART.ID_LINEA     = :P422_ID_LINEA       )
                     AND ( :P422_ID_MARCA        IS NULL OR ART.ID_MARCA     = :P422_ID_MARCA         )
                     AND ( :P422_COD_ARTICULO_DES IS NULL OR ART.COD_ARTICULO    >= :P422_COD_ARTICULO_DES )
                     AND ( :P422_COD_ARTICULO_HAS IS NULL OR ART.COD_ARTICULO    <= :P422_COD_ARTICULO_HAS)
                     AND ( :P422_FEC_INICIAL      IS NULL OR C.FEC_COMPROBANTE >= :P422_FEC_INICIAL      )
                     AND ( :P422_FEC_FINAL        IS NULL OR C.FEC_COMPROBANTE <= :P422_FEC_FINAL     )
                     AND C.ID_EMPRESA     = CC.ID_EMPRESA
                     AND C.ID_CLIENTE     = CC.ID
                     AND CC.ID_TIP_CLIENTE    =CL.ID(+)
                     -- AGREGADO --
                     AND (CC.ID = :P422_ID_CLIENTE OR :P422_ID_CLIENTE IS NULL)
                     AND (CC.ID_CORPORACION = :P422_ID_CORPORACION OR :P422_ID_CORPORACION IS NULL)
                     ---------------------
                     AND CC.ID_PERSONA    = P.ID(+)
                     AND C.ID_EMPRESA     = TC.ID_EMPRESA
                     AND C.TIP_COMPROBANTE = TC.TIP_COMPROBANTE
                     AND ( C.ESTADO IS NULL OR C.ESTADO <> 'A' )
                     AND C.ID_EMPRESA     = D.ID_EMPRESA
                     AND C.ID=D.ID_COMPROBANTE_CABECERA
                     /*
                     AND C.TIP_COMPROBANTE = D.TIP_COMPROBANTE
                     AND C.SER_COMPROBANTE = D.SER_COMPROBANTE
                     AND C.NRO_COMPROBANTE = D.NRO_COMPROBANTE
                     */
                     AND D.ID_EMPRESA     = ART.ID_EMPRESA
                     AND D.ID_ARTICULO    = ART.ID
                     AND PG.PARAMETRO      = 'COD_MONEDA_PREC'
                     AND LTRIM( RTRIM( PG.VALOR ) ) = LTRIM( RTRIM( M.COD_MONEDA ) )
                     AND C.ID_EMPRESA=E.ID
                   having SUM((NVL(D.MONTO_TOTAL,0)+NVL(D.TOTAL_IVA,0)) * DECODE(TC.SALDOS,'R',-1,1))!=0
                   GROUP BY CC.COD_CLIENTE, P.NOMBRE, M.DECIMALES,CC.ID_TIP_CLIENTE, CL.COD_TIP_CLIENTE, CL.DESCRIPCION,C.ID_EMPRESA,E.TITULO_REPORTES
                   ORDER BY 7  desc
                ```
            pageItemsToSubmit: [
                P422_ID_SUCURSAL
                P422_ID_LINEA
                P422_ID_CLIENTE
                P422_ID_MARCA
                P422_ID_CORPORACION
                P422_COD_ARTICULO_DES
                P422_ID_VENDEDOR
                P422_COD_ARTICULO_HAS
                P422_ID_RUBRO
                P422_FEC_INICIAL
                P422_FEC_FINAL
                P422_ID_FAMILIA
                P422_TIPO_REPORTE
                P422_PRIMEROS
                P422_TIPO
            ]
        }
