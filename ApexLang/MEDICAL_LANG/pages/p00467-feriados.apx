page 467 (
    name: Feriados
    alias: FERIADOS
    title: Feriados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region feriados (
        name: Feriados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT F.ID,
                       F.FERIADO,
                       F.DESCRIPCION,
                       F.COD_USUARIO_AUD
                FROM BSW_FERIADOS F
                WHERE TO_CHAR(F.FERIADO, 'YYYY') = :P467_ANIO
                  AND (TO_CHAR(F.FERIADO, 'MM')   = :P467_MES OR :P467_MES IS NULL)
                ```
            pageItemsToSubmit: [
                P467_ANIO
                P467_MES
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 466
                items: {
                    P466_ID: #ID#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
        }
        advanced {
            savedReportMappingIdentifier: 56404981947149414
        }

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FERIADO (
            type: plainText
            heading {
                heading: Feriado
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Feriados
        }

        savedReport 574124 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_USUARIO_AUD (
                sequence: 4
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn FERIADO (
                sequence: 2
            )

            displayColumn ID (
                sequence: 1
            )

        )

    )

    pageItem P467_ANIO (
        type: textField
        label {
            label: <p>Año:</p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @feriados
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 3
            columnSpan: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT TO_CHAR(SYSDATE,'YYYY') FROM DUAL;
        }
    )

    pageItem P467_MES (
        type: textField
        label {
            label: <p>Mes:</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @feriados
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @feriados
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 466
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 30
            region: @feriados
            slot: regionBody
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close-cancel-dialog (
        name: CLOSE_CANCEL_DIALOG
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @feriados
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @feriados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtro (
        name: FILTRO
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @feriados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filtros-text (
        name: FILTROS_TEXT
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P467_MES
                P467_ANIO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @feriados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

