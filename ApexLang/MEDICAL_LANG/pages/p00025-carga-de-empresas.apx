page 25 (
    name: Carga de Empresas
    alias: CARGA-DE-EMPRESAS
    title: Carga de Empresas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-empresas (
        name: Carga de Empresas
        type: form
        source {
            location: localDatabase
            tableName: BSW_EMPRESAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P25_ACTIVIDAD (
        type: textField
        label {
            label: <p>Actividad:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @carga-de-empresas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @carga-de-empresas
            column: ACTIVIDAD
            dataType: varchar2
        }
    )

    pageItem P25_CASA_CAMBIOS (
        type: radioGroup
        label {
            label: <p>Casa de Cambios:</p>
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @lv-casas-cambios
            displayNullValue: false
        }
        layout {
            sequence: 230
            region: @carga-de-empresas
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-empresas
            column: IND_CASA_CAMBIOS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: M
        }
    )

    pageItem P25_COD_EMPRESA (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Empresa:</a>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-empresas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-empresas
            column: COD_EMPRESA
            dataType: varchar2
        }
    )

