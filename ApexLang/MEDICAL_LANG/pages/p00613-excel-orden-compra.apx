    pageItem P613_DECIMALES (
        type: hidden
        layout {
            sequence: 200
            region: @ordenes-de-compra-cab
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_decimales number(10):=0;
                BEGIN
                SELECT DECIMALES
                into v_decimales
                 FROM BSW_MONEDAS
                WHERE ID=:P613_ID_MONEDA;
                return v_decimales;
                exception 
                when no_data_found then
                return 0;
                END;
                ```
        }
    )

