    dynamicAction setear-cambio (
        name: Setear Cambio
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P613_ID_MONEDA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                    RETURN FTIPOS_CAMBIO(:P613_ID_MONEDA,SYSDATE,'C','V');
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al encontrar el cambio de la moneda');
                    END;
                    ```
                itemsToSubmit: P613_ID_MONEDA
            }
            affectedElements {
                selectionType: items
                items: P613_TIP_CAMBIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DECIMALES FROM BSW_MONEDAS
                    WHERE ID=:P613_ID_MONEDA
                    ```
                itemsToSubmit: P613_ID_MONEDA
            }
            affectedElements {
                selectionType: items
                items: P613_DECIMALES
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    computation p613-nro-comprobante (
        itemName: P613_NRO_COMPROBANTE
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(D.NRO_COMPROBANTE)), 0)+1
                from CMW_PEDIDOS_CABECERA D
                WHERE D.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

    process eliminar-collection (
        name: ELIMINAR COLLECTION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF  APEX_COLLECTION.COLLECTION_EXISTS('DETALLE_EXCEL') THEN
                
                    APEX_COLLECTION.TRUNCATE_COLLECTION('DETALLE_EXCEL');
                
                END IF;  
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 12541813095089632
        }
        serverSideCondition {
            whenButtonPressed: @clear
        }
    )

    process guardar-en-cmw-pedidos-detalle (
        name: Guardar en CMW_PEDIDOS_DETALLE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     insert into CMW_PEDIDOS_DETALLE (ID_PEDIDO_CAB, ID_ARTICULO, CANTIDAD, id_unidad_medida)
                            values(:P613_ID, :C006, :C003, :C007);                               
                EXCEPTION
                    when no_data_found then
                        RAISE_APPLICATION_ERROR(-20998,'ERROR: al insertar'|| SQLERRM );
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20995,'ERROR: al insertar arti'||:C006||'- err '|| SQLERRM);
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 12828930617067807
        }
        serverSideCondition {
            type: never
        }
    )

    process initialize-form-pagina-de-prueba (
        name: Initialize form pagina de prueba
        type: formInitialization
        formRegion: @ordenes-de-compra-cab
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12495678314949828
        }
    )

    process limpiar-sesión (
        name: "Limpiar sesión "
        type: clearSessionState
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 12495522624949827
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: UPLOAD,CLEAR
        }
    )

    process new (
        name: New_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_codigo_articulo VARCHAR2(50) := ':id_articulo';
                  v_id NUMBER;
                BEGIN
                  SELECT id INTO v_id
                  FROM stw_articulos
                  WHERE cod_articulo = v_codigo_articulo;
                  
                  -- Haces algo con el ID encontrado, por ejemplo, lo imprimes
                  DBMS_OUTPUT.PUT_LINE('El ID del artículo con código ' || v_codigo_articulo || ' es ' || v_id);
                EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                    DBMS_OUTPUT.PUT_LINE('El artículo con código ' || v_codigo_articulo || ' no fue encontrado.');
                  WHEN OTHERS THEN
                    DBMS_OUTPUT.PUT_LINE('Error al buscar el artículo.');
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11182240106174131
        }
        serverSideCondition {
            type: never
        }
    )

    process new-2 (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  FOR i IN 1..APEX_APPLICATION.G_F01.COUNT LOOP
                    APEX_COLLECTION.ADD_MEMBER(
                      p_collection_name => 'DETALLE',
                      p_c001            => APEX_APPLICATION.G_F01(i), -- Columna 1 del formulario
                      p_c002            => APEX_APPLICATION.G_F02(i), -- Columna 2 del formulario
                      -- Agrega más columnas según la cantidad de datos que quieras cargar
                      p_c003            => APEX_APPLICATION.G_F03(i)  -- Columna 3 del formulario
                    );
                  END LOOP;
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 11182077107174129
        }
        serverSideCondition {
            type: never
        }
    )

    process proceso (
        name: "PROCESO "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VID_ARTICULO       NUMBER(10);
                    VID_UNIDAD_MEDIDA  NUMBER(10);
                    VID_IVA            NUMBER(10);
                    VTOT_ARTI          NUMBER(20) := 0;
                    VDESC_ARTICULO     VARCHAR2(200);
                    VCOD_IVA           VARCHAR(50) :=0;
                    VEXENTO            VARCHAR(10) := 0;--.-W_BUSCA_PARAMETRO('CM','ID_IVA_EXENTA');
                    VTOT_COMPROBANTE NUMBER(20) := 0;
                begin
                    --Borra el detalle 
                    IF  APEX_COLLECTION.COLLECTION_EXISTS('DETALLE_EXCEL') THEN
                        APEX_COLLECTION.TRUNCATE_COLLECTION('DETALLE_EXCEL');
                    END IF;
                    --Vuelve a crear el detalle
                    IF NOT APEX_COLLECTION.COLLECTION_EXISTS('DETALLE_EXCEL') THEN
                        APEX_COLLECTION.CREATE_COLLECTION('DETALLE_EXCEL');
                    END IF; 
                    for r1 in (select *  
                                 from apex_application_temp_files f, 
                                      table( apex_data_parser.parse(
                                                p_content                     => f.blob_content,
                                                p_add_headers_row             => 'N',
                                                -- p_store_profile_to_collection => 'FILE_PROV_CASH',
                                                p_file_name                   => f.filename) 
                                            ) p
                                 where f.name = :P613_EXCEL 
                              )
                        loop
                        --Consultamos los datos del articulo
                        BEGIN
                            SELECT A.ID, A.DESCRIPCION, A.ID_UNIDAD_MEDIDA, A.ID_IVA, I.PORC_IVA_COMPRA
                              INTO VID_ARTICULO, VDESC_ARTICULO, VID_UNIDAD_MEDIDA, VEXENTO, VCOD_IVA
                              FROM STW_ARTICULOS A,STW_IVA I
                             WHERE A.COD_ARTICULO = r1.col001
                               AND A.ID_EMPRESA   = :P0_ID_EMPRESA
                               AND A.ID_IVA       = I.ID;
                        END;
                        VTOT_ARTI := r1.col003 * r1.col004;
                        /*   APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'DETALLE_EXCEL',
                                                      p_C001            => r1.col001, --cod articulos
                                                      p_c002            => VDESC_ARTICULO, --desc articulo
                                                      P_C003            => r1.col003, --cantidad
                                                      p_c004            => r1.col004, --precio
                                                      p_c005            => VID_IVA,   --ID DEL IVA
                                                      p_c006            => VID_ARTICULO, --id articulo
                                                      p_c007            => VID_UNIDAD_MEDIDA, 
                                                      p_c008            => VTOT_ARTI,
                                                      p_c009            => :P613_SER_COMPROBANTE,
                                                      p_c010            => :P613_NRO_COMPROBANTE
                                            );*/
                        begin
                            insert into CMW_PEDIDOS_DETALLE (ID_PEDIDO_CAB,
                                                             ID_ARTICULO,
                                                             CANTIDAD, 
                                                             id_unidad_medida, 
                                                             PRECIO_UNITARIO_C_IVA,
                                                             ID_IVA,
                                                             MONTO_TOTAL, 
                                                             MONTO_TOTAL_C_IVA,
                                                             IVA,
                                                             TOTAL_IVA,
                                                             PRECIO_UNITARIO)
                                                     values (:P613_ID, 
                                                             VID_ARTICULO, 
                                                             r1.col003, 
                                                             VID_UNIDAD_MEDIDA, 
                                                             r1.col004,
                                                             64,---VEXENTO, 
                                                             VTOT_ARTI, 
                                                             VTOT_ARTI,
                                                             0,
                                                             0,
                                                             r1.col004
                                                             ); 
                             -- Actualizar el total del comprobante en cada iteración del bucle
                            VTOT_COMPROBANTE := VTOT_COMPROBANTE + VTOT_ARTI; 
                
                        EXCEPTION
                            when no_data_found then
                                RAISE_APPLICATION_ERROR(-20998,'ERROR: al insertar'|| SQLERRM );
                            WHEN OTHERS THEN 
                                RAISE_APPLICATION_ERROR(-20995,'ERROR: al insertar arti'||:C006||'- err '|| SQLERRM);
                        end;
                        VTOT_ARTI := 0;
                    END LOOP; 
                        -- Actualizar el total del comprobante en la tabla CMW_PEDIDOS_CABECERA
                            UPDATE CMW_PEDIDOS_CABECERA
                            SET TOT_COMPROBANTE = VTOT_COMPROBANTE
                            WHERE ID = :P613_ID;
                
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 11541494569791508
        }
    )

    process proceso-de-inserción (
        name: "PROCESO DE INSERCIÓN "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                
                
                CURSOR C2 IS
                
                
                
                SELECT C001, C002, C003, C004, C005, C006,
                
                       C007, C008, C009, C010, C011, C012,
                
                       C013, C014, C015, c016
                       
                
                       
                
                FROM APEX_COLLECTIONS 
                
                WHERE
                
                COLLECTION_NAME = 'Collection_name';
                
                
                
                BEGIN
                
                
                
                FOR I IN C2
                
                LOOP
                
                INSERT INTO CMW_PEDIDOS_DETALLE
                
                (
                
                
                ID,	  --All table column
                
                ID_PEDIDO_CAB,	
                
                ID_ARTICULO,
                
                CANTIDAD,
                
                PRECIO_UNITARIO,
                
                MONTO_TOTAL	,
                
                TOTAL_IVA	,
                
                CANTIDAD_UB	,
                
                ID_UNIDAD_MEDIDA,
                
                IND_STOCK,
                
                CANTIDAD_INGRESADA,
                
                PRECIO_UNITARIO_C_IVA,
                
                MONTO_TOTAL_C_IVA,
                
                IVA,
                
                ID_IVA
                
                )
                
                VALUES(
                
                        I.C001,   --collection data
                
                        I.C003, 
                
                        I.C004, 
                
                        I.C005,
                
                        I.C006,
                
                        I.C007,    
                
                        I.C008,
                
                        I.C009, 
                
                        I.C010,
                        
                        I.c011,
                
                        I.c012,
                
                        I.c013,
                
                        I.c014,
                
                        I.c015,
                
                        I.c016   
                
                );
                
                END LOOP;
                
                END;
                
                
                ```
        }
