    process save-excel (
        name: save excel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VID_ARTICULO       NUMBER(10);
                    VID_IVA            NUMBER(10);
                    VID_UNIDAD_MEDIDA  NUMBER(10);
                    VDESC_ARTICULO     VARCHAR2(200);
                BEGIN
                    FOR I IN (SELECT C001 AS CODIGO_ARTICULO, C002 AS ID_PEDIDO_CAB, C003 AS CANTIDAD, C004 AS TOTAL, C005 AS ID_ARTICULO
                              FROM APEX_COLLECTIONS
                              WHERE COLLECTION_NAME = 'DETALLE_EXCEL') LOOP
                
                        -- Obtener datos adicionales desde STW_ARTIC ULOS
                        SELECT ID, ID_IVA, ID_UNIDAD_MEDIDA, DESCRIPCION
                        INTO   VID_ARTICULO, VID_IVA, VID_UNIDAD_MEDIDA, VDESC_ARTICULO
                        FROM STW_ARTICULOS
                        WHERE COD_ARTICULO = I.CODIGO_ARTICULO
                       --- AND   ID = I.ID_ARTICULO
                        AND ID_EMPRESA = :P0_ID_EMPRESA;
                
                        -- Insertar datos en una nueva colección APEX_COLLECTION
                        APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('COLECCION_CON_DATOS_ADICIONALES');
                        IF I.CODIGO_ARTICULO IS NOT NULL THEN 
                            APEX_COLLECTION.ADD_MEMBER(
                                p_collection_name => 'COLECCION_CON_DATOS_ADICIONALES',
                                p_c001 => I.CODIGO_ARTICULO,
                                p_c002 => I.ID_PEDIDO_CAB,
                                p_c003 => I.CANTIDAD,
                                p_c004 => I.TOTAL,
                                p_c005 => VID_ARTICULO
                                -- Insertar los demás valores que necesitas obtener desde otras tablas
                                -- p_c006 => valor_obtenido_de_otra_tabla,
                                -- p_c007 => valor_obtenido_de_otra_tabla,
                                -- ...
                                --p_cnn => 'MY_COLLECTION'
                            );
                            RAISE_APPLICATION_ERROR(-20000, 'Emtro al menos '||I.CODIGO_ARTICULO);
                        END IF;
                    END LOOP;
                END;
                
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 12541691246089630
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

