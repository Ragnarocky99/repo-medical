    region ordenes-de-compra-cab (
        name: Ordenes de compra cab
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       FEC_COMPROBANTE,
                       ID_PROVEEDOR,
                       ID_CONDICION_COMPRA,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ID_USUARIO,
                       CAMBIO_MONEDA_PRECIO,
                       REFERENCIA,
                       COD_USUARIO_AUD ,
                       TIPO,
                       TIP_COMPROBANTE
                  from CMW_PEDIDOS_CABECERA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

