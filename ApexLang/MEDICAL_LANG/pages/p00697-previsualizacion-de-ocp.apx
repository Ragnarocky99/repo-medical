page 697 (
    name: Previsualizacion de OCP
    alias: PREVISUALIZACION-DE-OCP
    title: Previsualizacion de OCP
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region previsualizacion-de-ocp (
        name: Previsualizacion de OCP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d.id_proveedor,
                C.NRO_LICITACION, 
                 D.NRO_LOTE,
                 D.NRO_ITEM, 
                 D.ID_ARTICULO, 
                 AR.DESCRIPCION,
                 AR.ID_ENVASE,
                 AR.ID_UNIDAD_MEDIDA,
                 D.CANTIDAD_SISTEMA,
                 D.CANTIDAD_OCP,cantidad_confirmada
                FROM lcw_ofertas_det d
                JOIN STW_ARTICULOS AR ON D.Id_Articulo = AR.ID      
                JOIN LCW_OFERTAS_CAB C ON C.ID = D.ID_OFERTA_CAB
                WHERE d.id_oferta_cab = :P697_ID_OFERTA_CAB
                AND nvl(d.ind_conviene,'N') = 'S'
                AND nvl(d.cantidad_ocp,0) > 0
                and cantidad_sistema - cantidad_confirmada > 0;
                
                ```
            pageItemsToSubmit: P697_ID_OFERTA_CAB
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 27246698130256923
        }

        column CANTIDAD_CONFIRMADA (
            type: plainText
            heading {
                heading: Cantidad Confirmada
                alignment: end
            }
            layout {
                sequence: 33
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column CANTIDAD_OCP (
            type: plainText
            heading {
                heading: Cantidad Ocp
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column CANTIDAD_SISTEMA (
            type: plainText
            heading {
                heading: Cantidad Sistema
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_ARTICULO (
            type: plainTextBasedOnLov
            heading {
                heading: Articulo
                alignment: end
            }
            lov {
                lov: @lv-articulos
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_ENVASE (
            type: plainTextBasedOnLov
            heading {
                heading: Envase
                alignment: end
            }
            lov {
                lov: @lv-envases
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID_PROVEEDOR (
            type: plainTextBasedOnLov
            heading {
                heading: Proveedor
                alignment: end
            }
            lov {
                lov: @lv-proveedores
            }
            layout {
                sequence: 23
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID_UNIDAD_MEDIDA (
            type: plainTextBasedOnLov
            heading {
                heading: Unidad Medida
                alignment: end
            }
            lov {
                lov: @lv-unidades-medida
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column NRO_ITEM (
            type: plainText
            heading {
                heading: Nro Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column NRO_LICITACION (
            type: plainText
            heading {
                heading: Nro Licitacion
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column NRO_LOTE (
            type: plainText
            heading {
                heading: Nro Lote
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Previsualizacion de OCP
        }

        savedReport 272615 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD_CONFIRMADA (
                sequence: 9
            )

            displayColumn CANTIDAD_OCP (
                sequence: 10
            )

            displayColumn CANTIDAD_SISTEMA (
                sequence: 8
            )

            displayColumn DESCRIPCION (
                sequence: 5
            )

            displayColumn ID_ARTICULO (
                sequence: 4
            )

            displayColumn ID_ENVASE (
                sequence: 6
            )

            displayColumn ID_PROVEEDOR (
                sequence: 11
            )

            displayColumn ID_UNIDAD_MEDIDA (
                sequence: 7
            )

            displayColumn NRO_ITEM (
                sequence: 3
            )

            displayColumn NRO_LICITACION (
                sequence: 1
            )

            displayColumn NRO_LOTE (
                sequence: 2
            )

            controlBreak (
                column: ID_PROVEEDOR
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P697_ID_OFERTA_CAB (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    button generarocp (
        buttonName: GenerarOCP
        label: Generar OCP
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            requiresConfirmation: true
        }
        confirmation {
            message:
                ```html
                ¿Está seguro? Esta operación creará OCP's y un pedido.
                
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from lcw_ofertas_det
                      where ind_conviene = 'S'
                        and id_oferta_cab = :P697_ID_OFERTA_CAB
                        and cantidad_sistema - cantidad_confirmada > 0
                        AND NVL(cantidad_ocp,0) > 0
                        and :P0_ID_SUCURSAL = 690
                ```
        }
    )

    dynamicAction generar (
        name: Generar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @generarocp
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    LCW_GENERA_ORDEN_COMPRA(p_id_oferta_cab => :P697_ID_OFERTA_CAB,
                                              P_USUARIO => :APP_USER,
                                              P_ID_EMPRESA => :P0_ID_EMPRESA,
                                              P_ID_SUCURSAL => :P0_ID_SUCURSAL);
                    end;
                    ```
                itemsToSubmit: P697_ID_OFERTA_CAB
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 263
                }
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

