page 3 (
    name: Carga de  Grupos de Usuarios
    alias: CARGA-DE-GRUPOS-DE-USUARIOS
    title: Carga de  Grupos de Usuarios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-grupos-de-usuarios (
        name: Carga de  Grupos de Usuarios
        type: form
        source {
            location: localDatabase
            tableName: BSW_GRUPOS_USUARIOS
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 3
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P3_COD_GRUPO (
        type: textField
        label {
            label: <p>Cód. Grupo: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @carga-de-grupos-de-usuarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 6
        }
        source {
            formRegion: @carga-de-grupos-de-usuarios
            column: COD_GRUPO
            dataType: varchar2
        }
    )

    pageItem P3_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-grupos-de-usuarios
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 40
        }
        source {
            formRegion: @carga-de-grupos-de-usuarios
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P3_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-grupos-de-usuarios
            slot: regionBody
        }
        source {
            formRegion: @carga-de-grupos-de-usuarios
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        advanced {
            htmlDomId: CREAR
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @botones
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @botones
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process cargar-permisos-por-defecto (
        name: Cargar_Permisos_Por_Defecto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                v_id_grupo varchar2(10);
                
                Begin
                
                SELECT ID  into v_id_grupo FROM BSW_GRUPOS_USUARIOS  where cod_grupo=:P3_COD_GRUPO; 
                
                INSERT INTO BSW_ACCESO_POR_GRUPOS_APEX(ID_ACCESO,COD_GRUPO,PAGINA_ID,PERMISO) 
                VALUES (NULL,v_id_grupo,1,1);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6766984689161211
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process cerrar-recuadro-de-diálogo (
        name: Cerrar Recuadro de Diálogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 5217500626342046
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process inicializar-pantalla-carga-de-grupos-de-usuarios (
        name: Inicializar pantalla Carga de  Grupos de Usuarios
        type: formInitialization
        formRegion: @carga-de-grupos-de-usuarios
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 5216706032342046
        }
    )

    process procesar-pantalla-carga-de-grupos-de-usuarios (
        name: Procesar pantalla Carga de  Grupos de Usuarios
        type: formAutoRowProcessing
        formRegion: @carga-de-grupos-de-usuarios
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5217178679342046
        }
    )

)

