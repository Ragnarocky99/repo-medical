    dynamicAction crear-devolucion (
        name: Crear Devolucion
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @create-devolucion
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        VID_CAB NUMBER := STW_ENTSAL_CAB_ID_SEQ.NEXTVAL;
                        VID_MOTIVO_ENTSAL NUMBER := TRAE_ID_MOTIVO_ENTSAL(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('LC', 'COD_MOTIVO_ENTSAL_DEVOLUCION_NOTA_ENTREGA'));
                        VTIP_ENTSAL VARCHAR2(30) := W_BUSCA_PARAMETRO('LC', 'TIP_COMPROBANTE_DEVOLUCION_NOTA_ENTREGA');
                    BEGIN
                        INSERT INTO STW_ENTSAL_CAB(ID, ID_EMPRESA, ID_SUCURSAL, NUM_ENT_SAL, FEC_ENT_SAL, ID_MOTIVO_ENT_SAL,
                                                       ID_MONEDA, FEC_INICIO, COD_USUARIO_AUD, ESTADO, ID_SUCURSAL_CENTRAL,
                                                       ID_CLIENTE, FEC_ALTA, SER_ENT_SAL, TIP_ENT_SAL,
                                                       ID_LICITACION_CAB, ID_ENTSAL_REF)
                            VALUES(VID_CAB, :P0_ID_EMPRESA, :P786_ID_SUCURSAL, :P786_NUM_ENT_SAL, SYSDATE, VID_MOTIVO_ENTSAL,
                                   :P786_ID_MONEDA, SYSDATE, :APP_USER, 'N', :P786_ID_SUCURSAL,
                                   :P786_ID_CLIENTE, SYSDATE, 'A', VTIP_ENTSAL,
                                   :P786_ID_LICITACION_CAB, :P786_ID);
                        :P786_ID_1 := VID_CAB;
                    END;
                    ```
                itemsToSubmit: [
                    P786_ID
                    P786_ID_MONEDA
                    P786_ID_CLIENTE
                    P786_NUM_ENT_SAL
                    P786_ID_LICITACION_CAB
                    P786_ID_SUCURSAL
                ]
                itemsToReturn: P786_ID_1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction imprimir (
        name: Imprimir
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 786
                    items: {
                        P786_IND_IMPRIMIR: S
                        P786_ID: &P786_ID.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: P786_ID
                openTargetInNewWindow: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar-fila (
        name: Inicializar Fila
        execution {
            sequence: 40
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @devoluciones
        }

        action datos-de-la-linea (
            name: Datos de la Linea
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ED.ID_LICITACION_DET,
                           ED.ID_APROBACION_LIC,
                           ED.ID_ARTICULO,
                           ED.ID_IVA,
                           ED.ID_LOTE,
                           ED.ID_UNIDAD_MEDIDA,
                           AR.COD_ARTICULO,
                           ED.DESC_ARTICULO,
                           ED.NRO_LOTE,
                           ED.COSTO_C_IVA
                      FROM STW_ENTSAL_DET ED
                      JOIN STW_ARTICULOS  AR ON AR.ID = ED.ID_ARTICULO
                     WHERE ED.ID = :ID_ENTSAL_DET_REF
                    ```
                itemsToSubmit: ID_ENTSAL_DET_REF
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: [
                    ID_LICITACION_DET
                    ID_APROBACION_LIC
                    ID_ARTICULO
                    ID_IVA
                    ID_LOTE
                    ID_UNIDAD_MEDIDA
                    COD_ARTICULO
                    DESC_ARTICULO
                    NRO_LOTE
                    COSTO_C_IVA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process actualiza-totales (
        name: Actualiza Totales
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE STW_ENTSAL_CAB
                   SET TOT_CANTIDAD = (SELECT SUM(ED.CANTIDAD) FROM STW_ENTSAL_DET ED WHERE ED.ID_ENTSAL_CAB = :P786_ID_1),
