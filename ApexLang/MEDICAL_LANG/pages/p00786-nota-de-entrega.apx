    region devolucion (
        name: Devolucion
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.ID,
                       EC.ID_EMPRESA,
                       EC.ID_SUCURSAL,
                       EC.NUM_ENT_SAL,
                       EC.FEC_ENT_SAL,
                       EC.ID_MOTIVO_ENT_SAL,
                       EC.COD_USUARIO_AUD,
                       EC.ID_CLIENTE,
                       EC.FEC_ALTA,
                       EC.TIP_ENT_SAL,
                       EC.ID_MONEDA,
                       EC.ID_ENTSAL_REF
                  FROM STW_ENTSAL_CAB EC
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P786_ID_ENTSAL_REF
        }
    )

    region devoluciones (
        name: Devoluciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ED.ID,
                       ED.ID_ENTSAL_CAB,
                       ED.ID_EMPRESA,
                       ED.ID_SUCURSAL,
                       ED.ID_LICITACION_DET,
                       ED.ID_ARTICULO,
                       ED.ID_IVA,
                       ED.ID_LOTE,
                       AR.COD_ARTICULO,
                       ED.DESC_ARTICULO,
                       ED.ID_UNIDAD_MEDIDA,
                       ED.NRO_LOTE,
                       ED.CANTIDAD,
                       ED.COSTO_C_IVA,
                       ED.ID_ENTSAL_DET_REF,
                       ED.COD_USUARIO_AUD,
                       ED.FEC_ALTA,
                       ED.ID_APROBACION_LIC,
                       ED.TOTAL_COSTO,
                       ED.ID_OFERTA_LIC
                  FROM STW_ENTSAL_DET       ED
                  JOIN STW_ARTICULOS        AR ON AR.ID = ED.ID_ARTICULO
                ```
        }
        layout {
            sequence: 10
            parentRegion: @devolucion
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        masterDetail {
            masterRegion: @detalles
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM STW_ENTSAL_DET
                 WHERE ID_ENTSAL_CAB = :P786_ID
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 107410064333640996
        }

