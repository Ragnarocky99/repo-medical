page 786 (
    name: Nota de Entrega
    alias: NOTA-DE-ENTREGA
    title: Nota de Entrega
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ED.ID,
                       AR.COD_ARTICULO,
                       ED.DESC_ARTICULO,
                       ED.NRO_LOTE,
                       ED.CANTIDAD,
                       ED.COSTO_C_IVA,
                       AR.ID_ENVASE,
                       AR.ID_UNIDAD_MEDIDA,
                       AR.ID_MARCA,
                       AR.COD_ORIGEN_ART,
                       LO.FEC_VENCIMIENTO,
                       LD.NRO_ITEM,
                       ED.TOTAL_COSTO,
                       ED.ID_OFERTA_LIC
                  FROM STW_ENTSAL_DET       ED
                  JOIN STW_ARTICULOS        AR ON AR.ID = ED.ID_ARTICULO
                  JOIN STW_LOTES            LO ON LO.ID = ED.ID_LOTE
                  JOIN LCW_OFERTAS          LO ON LO.ID = ED.ID_OFERTA_LIC
                  JOIN LCW_LICITACIONES_DET LD ON LD.ID = LO.ID_LICITACION_DET
                 WHERE ED.ID_ENTSAL_CAB = :P786_ID
                ```
            pageItemsToSubmit: P786_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: item=value
            item: P786_ESTADO
            value: A
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 44659484807578825
        }

