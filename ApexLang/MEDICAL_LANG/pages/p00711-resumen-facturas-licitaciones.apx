page 711 (
    name: Resumen Facturas Licitaciones
    alias: RESUMEN-FACTURAS-LICITACIONES
    title: Resumen Facturas Licitaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region resumen-facturas-licitaciones (
        name: Resumen Facturas Licitaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nro_comprobante as nro_factura, a.cod_articulo, d.cantidad
                from vtw_comprobantes_cabecera c
                join vtw_comprobantes_detalle  d on d.id_comprobante_cabecera = c.id
                join stw_articulos        a on d.id_articulo                  = a.id
                where d.id_oferta_lic = :P711_ID_OFERTA_LIC
                ```
            pageItemsToSubmit: P711_ID_OFERTA_LIC
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 29831085990579226
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod Articulo
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NRO_FACTURA (
            type: plainText
            heading {
                heading: Nro Factura
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 298410 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 3
            )

            displayColumn COD_ARTICULO (
                sequence: 2
            )

            displayColumn NRO_FACTURA (
                sequence: 1
            )

        )

    )

    pageItem P711_ID_OFERTA_LIC (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

)

