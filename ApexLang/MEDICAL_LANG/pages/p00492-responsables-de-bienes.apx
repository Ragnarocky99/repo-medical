page 492 (
    name: Responsables de Bienes
    alias: RESPONSABLES-DE-BIENES
    title: Responsables de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region responsables-de-bienes (
        name: Responsables de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                      COD_RESPONSABLE,
                      ID_PERSONA,
                      DESCRIPCION,
                      ID_SUCURSAL,
                      ID_CENTRO,
                      ID_DEPARTAMENTO,
                      ID_SECCION,
                      ID
                
                FROM
                      COW_RESPONSABLES_BIENES
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 493
                items: {
                    P493_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 59508002649969615
        }

        column COD_RESPONSABLE (
            type: plainText
            heading {
                heading: Código Responsable
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_CENTRO (
            type: plainTextBasedOnLov
            heading {
                heading: Centro
                alignment: center
            }
            lov {
                lov: @lv-centro-costo
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_DEPARTAMENTO (
            type: plainTextBasedOnLov
            heading {
                heading: Departamento
                alignment: center
            }
            lov {
                lov: @lv-departamentos-rrhh
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_PERSONA (
            type: plainTextBasedOnLov
            heading {
                heading: Persona
                alignment: center
            }
            lov {
                lov: @lv-personas
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_SECCION (
            type: plainTextBasedOnLov
            heading {
                heading: Sección
                alignment: center
            }
            lov {
                lov: @lv-secciones
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Responsables de Bienes
        }

        savedReport 602323 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_RESPONSABLE (
                sequence: 1
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ID (
                sequence: 8
            )

            displayColumn ID_CENTRO (
                sequence: 5
            )

            displayColumn ID_DEPARTAMENTO (
                sequence: 6
            )

            displayColumn ID_PERSONA (
                sequence: 2
            )

            displayColumn ID_SECCION (
                sequence: 7
            )

            displayColumn ID_SUCURSAL (
                sequence: 4
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @responsables-de-bienes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 493
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @responsables-de-bienes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @responsables-de-bienes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

