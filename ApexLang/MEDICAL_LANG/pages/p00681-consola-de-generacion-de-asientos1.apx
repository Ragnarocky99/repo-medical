    dynamicAction agregar-paginacion (
        name: Agregar Paginacion
        execution {
            sequence: 330
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total número de filas:
                titleOfFirstPage: Primera página
                titleOfLastPage: Última página
            }
            affectedElements {
                selectionType: region
                region: @asientos-diario
            }
            execution {
                sequence: 10
            }
        )

        action plugin-ir-pagination-2 (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total número de filas:
                titleOfFirstPage: Primera página
                titleOfLastPage: Última página
            }
            affectedElements {
                selectionType: region
                region: @mayor
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction calcular-asientos-pendientes (
        name: Calcular Asientos Pendientes
        execution {
            sequence: 210
            type: debounce
            time: 200
        }
        when {
            selectionType: items
            items: [
                P681_FECHA_INICIAL
                P681_FECHA_FINAL
            ]
        }

        action calcular-asientos-pendientes-cobros (
            name: Calcular Asientos Pendientes Cobros
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select sum(a.contador) contador 
                        from 
                        (select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    ccw_recibos re,  
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where re.id_empresa = :P0_ID_EMPRESA
                                and re.fec_recibo between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                                and re.id_empresa = c.id_empresa
                                and re.id_mov_caj=c.id
                                and nvl( re.anulado, 'H') <> 'S'
                                and c.id_moneda = m.id
                                --and c.asientos is null
                                and re.asientos is null
                                and re.id_empresa  = s.id_empresa
                                and re.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona
                                AND :P0_COD_EJERCICIO = TO_CHAR(re.fec_recibo, 'yyyy')
                          /*union all
                             select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    vtw_comprobantes_cabecera vt, 
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where vt.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                                and vt.id_empresa = c.id_empresa
                                and vt.id_mov_caj = c.id
                                and vt.tip_comprobante in ('FVE','NCR')
                                and nvl( vt.estado, 'H') <> 'A'
                                and c.id_moneda = m.id
                                and c.asientos is null
                                and vt.id_empresa  = s.id_empresa
                                and vt.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona*/) a
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_COBRO
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-compras-importacion (
            name: Calcular Asientos Pendientes Compras Importacion
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COUNT(*)
                    from cmw_compras_cabecera cc, 
                         bsw_tipos_comprobantes tc, 
                         bsw_sucursales su
                    where cc.ID_empresa = :P0_ID_EMPRESA
                      and cc.fec_comprobante between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                      and nvl( cc.estado, 'H' ) = 'C'
                      and nvl( cc.tip_comprobante_ref, 'DFL' ) = 'EMB' --26/09/2023
                      and cc.ID_empresa     = tc.ID_empresa
                      and cc.tip_comprobante = tc.tip_comprobante
                      and cc.asientos is null
                      and cc.ID_empresa  = su.ID_empresa
                      and cc.ID_sucursal = su.ID
                      AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy')
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_COMPRAS_IMPORT
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-compras-locales (
            name: Calcular Asientos Pendientes Compras Locales
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                      SELECT COUNT(*)
                        from cmw_compras_cabecera cc, 
                             bsw_tipos_comprobantes tc, 
                             bsw_sucursales su
                      where cc.ID_empresa = :P0_ID_EMPRESA
                                  and cc.fec_comprobante between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                                  and nvl( cc.estado, 'H' ) = 'C'
                                  and nvl( cc.tip_comprobante_ref, 'DFL' ) <> 'EMB' --22/09/2023 RP
                                  and cc.ID_empresa     = tc.ID_empresa
                                  and cc.tip_comprobante = tc.tip_comprobante
                                  and cc.asientos is null
                                  -----and ( cc.asientos IS NULL OR instr( cc.asientos,'*compras*', 1, 1 ) = 0 )
                                  and cc.ID_empresa  = su.ID_empresa
                                  and cc.ID_sucursal = su.ID
                                  AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy')
                                   and cc.id not in (2914,2673)
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_COMPRAS_CM
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-debcred (
            name: Calcular Asientos Pendientes DebCred
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                        select count(*)
                        from ccw_debcred_bancarios d
                        where d.id_empresa = :P0_ID_EMPRESA
                          --and d.fec_comprobante between :b_rvenci.fec_desde and :b_rvenci.fec_hasta
                          and /*decode(d.sub_tipo_trans,'105',trunc(d.fec_comprobante),'106',trunc(d.fec_comprobante),
                               '110',trunc(d.fec_comprobante),'107',trunc(d.fec_comprobante),trunc(d.fec_confirmacion))*/
                                d.fec_comprobante between :P681_FECHA_INICIAL 
                               and :P681_FECHA_FINAL
                          and d.asientos is null
                          AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy'); 
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_DEBCRED
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-depositos (
            name: Calcular Asientos Pendientes Depositos
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                        select count(*)
                        from ccw_mov_valores_cab d
                        where d.id_empresa = :P0_ID_EMPRESA
                          --and d.fec_comprobante between :b_rvenci.fec_desde and :b_rvenci.fec_hasta
                          and /*decode(d.sub_tipo_trans,'105',trunc(d.fec_comprobante),'106',trunc(d.fec_comprobante),
                               '110',trunc(d.fec_comprobante),'107',trunc(d.fec_comprobante),trunc(d.fec_confirmacion))*/
                                d.fec_comprobante between :P681_FECHA_INICIAL 
                               and :P681_FECHA_FINAL
                          and d.asientos is null
                          AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy');
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_DEPOSITOS
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-gastos (
            name: Calcular Asientos Pendientes Gastos
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COUNT(*)
                    FROM CPW_COMPROBANTES_CABECERA CC
                    WHERE CC.ID_EMPRESA  = :P0_ID_EMPRESA
                      AND CC.FEC_COMPROBANTE BETWEEN :P681_FECHA_INICIAL AND :P681_FECHA_FINAL
                      AND ASIENTOS IS NULL
                      AND NVL(CC.IND_GENERA_ASIENTO, 'N') = 'S'
                      AND :P0_COD_EJERCICIO = TO_CHAR(CC.FEC_COMPROBANTE, 'yyyy');
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_GASTOS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-pagos (
            name: Calcular Asientos Pendientes Pagos
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                       select count(*)
                        from cpw_cabecera_cajas cc
                        where cc.id_empresa      = 121
                          and (CC.FEC_MOV_CAJ between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                          and nvl(cc.anulado,'N') <> 'S'
                       --   and nvl(cc.pagado, 'N') = 'S'
                          and asientos is null) or
                             (nvl(anulado,'N') = 'S'
                          and fec_anulacion between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                          and asientos not like('%anul%'))
                          AND :P0_COD_EJERCICIO = TO_CHAR(FEC_MOV_CAJ, 'yyyy');
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_PAGOS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-rh (
            name: Calcular Asientos Pendientes RH
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- select count(*)
                    --             from rhw_cabecera_liq cl, rhw_empleados e
                    --             where cl.id_empresa = :P0_ID_EMPRESA
                    --             and  cl.fec_liquid   between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                    --            -- and (cl.tip_liquid   =  p_tip_comprobante or p_tip_comprobante is null )
                    --            -- and (cl.ser_liquid   =  p_ser_comprobante or p_ser_comprobante is null )
                    --           --  and (cl.nro_liquid   =  p_nro_comprobante or p_nro_comprobante is null )
                    --             and cl.asientos      is null
                    --             and cl.id_empresa   = e.id_empresa
                    --             and cl.id_empleado  = e.id
                    --             AND :P0_COD_EJERCICIO = TO_CHAR(FEC_LIQUID, 'yyyy')
                    SELECT 0 FROM DUAL
                               
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_RH
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-stock (
            name: Calcular Asientos Pendientes Stock
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select count(*) cantidad from 
                    (select cc.id
                           from stw_entsal_cab cc,
                                stw_entsal_det cd,
                                cow_param_contables_st ps,
                                stw_articulos ar,
                                bsw_tipos_comprobantes tc,
                                bsw_sucursales su,
                                bsw_monedas    mn,
                                stw_motivo_ent_sal mo
                                
                          where  cc.ID_empresa   =      :P0_ID_EMPRESA
                           and  trunc(cc.fec_ent_sal)  between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                    
                            ---and  nvl( cc.anulado, 'N') = 'N' REVISAR 
                            ---and  nvl(cc.tip_ent_sal,'ENT') = 'REM'
                            and cc.id_motivo_ent_sal = mo.id
                            ---and  nvl(cc.tip_ent_sal,'AJS') = 'AJS'
                            ----and mo.cod_motivo_ent_sal = w_busca_parametro('ST', 'COD_ENT_STOCK')
                            
                            and  cc.ID_empresa  = tc.ID_empresa
                            and  cc.tip_ent_sal = tc.tip_comprobante
                            and cc.id_moneda    = mn.id
                            and  cc.ID_empresa  = cd.ID_empresa
                            and  cc.ID_sucursal = cd.ID_sucursal
                            AND CC.ID=CD.ID_ENTSAL_CAB
                            and  nvl(ar.ind_maneja_stock,'S') = 'S'
                            and  cd.ID_empresa  = ar.ID_empresa
                            and  cd.ID_articulo = ar.ID
                            and (cc.asientos is null)--- or instr(cc.asientos, '*stock*', 1,1) = 0)
                            and  cc.ID_empresa  = ps.ID_empresa
                            ---and  ar.id_familia  = ps.id_grupo
                            and  cc.ID_empresa  = su.ID_empresa
                            and  cc.ID_sucursal = su.ID
                            AND :P0_COD_EJERCICIO = TO_CHAR(trunc(cc.fec_ent_sal), 'yyyy')   
                          group by cc.id
                    ) a
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_STOCK
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action calcular-asientos-pendientes-ventas (
            name: Calcular Asientos Pendientes Ventas
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                      select count(*)
                        from vtw_comprobantes_cabecera
                        where id_empresa = :P0_ID_EMPRESA
                          and fec_comprobante between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                          and nvl(estado,'N') != 'A'
                          and asientos is null
                          AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy')
                          and nvl(tot_comprobante,0) > 0--Agregue tot_comprobante porque en pfannl existen cabeceras sin detalle y este campo es cargado a traves del detalle --DN 22/01/2020
                    
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_VTA
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    V_HOLA VARCHAR2(200);
                    
                    
                    BEGIN
                    
                    IF TO_DATE(:P681_FECHA_INICIAL,'DD/MM/YYYY') NOT BETWEEN TO_DATE(:P0_FEC_INICIAL_EJERCICIO,'DD/MM/YYYY')
                     AND TO_DATE(:P0_FEC_FINAL_EJERCICIO,'DD/MM/YYYY') THEN
                    
                    
                    
                    RAISE_APPLICATION_ERROR(-20000,'Rango de fecha fuera del ejercicio actual');
                    
                    
                    
                    end if;
                    END;
                    ```
                itemsToSubmit: P681_FECHA_INICIAL
                itemsToReturn: P681_FECHA_INICIAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 110
                fireOnInit: false
            }
        )

    )

