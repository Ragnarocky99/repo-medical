    dynamicAction generar-asiento-stock (
        name: GENERAR_ASIENTO_STOCK
        execution {
            sequence: 190
        }
        when {
            event: click
            selectionType: button
            button: @stock-2
        }

        action calcular-asientos-pendientes-stock (
            name: Calcular Asientos Pendientes Stock
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select count(*) cantidad from 
                    (select cc.id
                           from stw_entsal_cab cc,
                                stw_entsal_det cd,
                                cow_param_contables_st ps,
                                stw_articulos ar,
                                bsw_tipos_comprobantes tc,
                                bsw_sucursales su,
                                bsw_monedas    mn,
                                stw_motivo_ent_sal mo
                                
                          where  cc.ID_empresa   =      :P0_ID_EMPRESA
                           and  trunc(cc.fec_ent_sal)  between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                    
                            ---and  nvl( cc.anulado, 'N') = 'N' REVISAR 
                            ---and  nvl(cc.tip_ent_sal,'ENT') = 'REM'
                            and cc.id_motivo_ent_sal = mo.id
                            ---and  nvl(cc.tip_ent_sal,'AJS') = 'AJS'
                            ----and mo.cod_motivo_ent_sal = w_busca_parametro('ST', 'COD_ENT_STOCK')
                            
                            and  cc.ID_empresa  = tc.ID_empresa
                            and  cc.tip_ent_sal = tc.tip_comprobante
                            and cc.id_moneda    = mn.id
                            and  cc.ID_empresa  = cd.ID_empresa
                            and  cc.ID_sucursal = cd.ID_sucursal
                            AND CC.ID=CD.ID_ENTSAL_CAB
                            and  nvl(ar.ind_maneja_stock,'S') = 'S'
                            and  cd.ID_empresa  = ar.ID_empresa
                            and  cd.ID_articulo = ar.ID
                            and (cc.asientos is null)--- or instr(cc.asientos, '*stock*', 1,1) = 0)
                            and  cc.ID_empresa  = ps.ID_empresa
                            ---and  ar.id_familia  = ps.id_grupo
                            and  cc.ID_empresa  = su.ID_empresa
                            and  cc.ID_sucursal = su.ID
                            AND :P0_COD_EJERCICIO = TO_CHAR(trunc(cc.fec_ent_sal), 'yyyy')     
                          group by cc.id
                    ) a
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_STOCK
            }
            execution {
                sequence: 90
            }
        )

        action native-alert (
            action: alert
            settings {
                title: Operación Concluida
                message:
                    ```html
                    &P681_MENSAJE_PROCEDIMIENTO.
                    
                    ```
                style: information
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                    V_MENSAJE VARCHAR(4000);
                    V_NUM_ASIENTO_INI NUMBER(10);
                    V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    begin
                        cow_asiento_stock(:P0_ID_EMPRESA,
                                          NULL,
                                          :P681_FECHA_INICIAL,
                                          :P681_FECHA_FINAL,
                                          V_MENSAJE,
                                          V_NUM_ASIENTO_INI,
                                          V_NUM_ASIENTO_FIN);
                                        
                    :P681_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                    :P681_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
                    :P681_ASIENTO_NRO_FIN:=V_NUM_ASIENTO_FIN;
                    EXCEPTION 
                    WHEN OTHERS THEN 
                    :P681_MENSAJE_PROCEDIMIENTO:=SQLERRM;
                    ROLLBACK;
                    end;
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                itemsToReturn: [
                    P681_MENSAJE_PROCEDIMIENTO
                    P681_ASIENTO_NRO_INI
                    P681_ASIENTO_NRO_FIN
                ]
                showProcessing: true
            }
            execution {
