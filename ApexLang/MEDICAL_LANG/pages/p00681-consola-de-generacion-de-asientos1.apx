    dynamicAction eliminar-asientos-de-compras-locales (
        name: Eliminar Asientos de Compras - Locales
        execution {
            sequence: 410
        }
        when {
            event: click
            selectionType: button
            button: @compras-stock
        }
        clientSideCondition {
            type: item=value
            item: P681_IND_TIPO_GENERACION
            value: E
        }

        action native-confirm (
            action: confirm
            settings {
                message: &P681_MENSAJE_PROCEDIMIENTO.
                style: warning
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_cantidad number;
                    BEGIN
                        SELECT COUNT(*)
                          INTO l_cantidad
                          FROM cow_diario_cabeceras_prov dc
                         WHERE dc.fec_asiento BETWEEN :P681_FECHA_INICIAL AND :P681_FECHA_FINAL
                           AND dc.id_modulo = trae_id_modulo('CM')
                           AND INSTR(dc.descripcion, 'Importacion') = 0
                           AND EXISTS (
                            SELECT 1
                              FROM cow_ejercicios ej
                             WHERE ej.cod_ejercicio = :P0_COD_EJERCICIO
                               AND ej.id = dc.id_ejercicio
                           )
                           AND NVL(dc.ind_mayorizado, 'N') = 'N';
                        
                        :P681_MENSAJE_PROCEDIMIENTO := 'Se encontraron '||l_cantidad||' asientos.'||CHR(13)||'¿Esta seguro de procesar la eliminacion?';
                    END;
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                itemsToReturn: P681_MENSAJE_PROCEDIMIENTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code_1 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_count NUMBER;
                    BEGIN
                        DELETE
                          FROM cow_diario_cabeceras_prov dc
                         WHERE dc.fec_asiento BETWEEN :P681_FECHA_INICIAL AND :P681_FECHA_FINAL
                           AND dc.id_modulo = trae_id_modulo('CM')
                           AND INSTR(dc.descripcion, 'Importacion') = 0
                           AND exists (
                            SELECT 1
                              FROM cow_ejercicios ej
                             WHERE ej.cod_ejercicio = :P0_COD_EJERCICIO
                               AND ej.id = dc.id_ejercicio
                           )
                           AND NVL(dc.ind_mayorizado, 'N') = 'N';
                    
                        -- Captura la cantidad de registros eliminados
                        v_count := SQL%ROWCOUNT;
                    
                        -- Mostrar mensaje en APEX
                        apex_application.g_print_success_message := 'Se eliminaron '||v_count||' asientos';
                    
                    END;
                    
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

