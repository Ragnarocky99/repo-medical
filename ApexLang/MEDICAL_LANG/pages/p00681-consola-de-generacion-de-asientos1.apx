                                d.fec_comprobante between :P681_FECHA_INICIAL 
                               and :P681_FECHA_FINAL
                          and d.asientos is null
                          AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy'); 
