    region mayor (
        name: Mayor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID,
                       FEC_ASIENTO,
                       DECODE(ORDEN, 1, NULL, NUM_ASIENTO) NUM_ASIENTO,
                       DETALLE,
                       TRIM(COD_CUENTA) COD_CUENTA,
                       NOMBRE_CUENTA,
                       DECODE(ORDEN, 1, 0, MON_DEBE) MON_DEBE,
                       DECODE(ORDEN, 1, 0, MON_HABER) MON_HABER,
                       ID_SUCURSAL,
                       ID_CENTRO,
                       SUM((MON_DEBE - MON_HABER) * COEFICIENTE) OVER (PARTITION BY COD_CUENTA ORDER BY COD_CUENTA, FEC_ASIENTO, TIP_COMPROBANTE, SER_COMPROBANTE, NRO_COMPROBANTE, NUM_ASIENTO, ORDEN) SALDO,
                       ORDEN,
                       ID_PROVEEDOR
                  FROM (
                      SELECT ROW_NUMBER() OVER (ORDER BY COD_CUENTA, FEC_ASIENTO, NUM_ASIENTO)+ 1000 ORDEN,
                             M.FEC_ASIENTO,
                             M.NUM_ASIENTO,
                             M.DETALLE DETALLE,
                             M.COD_CUENTA,
                             M.NOMBRE_CUENTA,
                             DECODE(:P681_IND_MON_EXT, 'N', M.MON_DEBE, M.MON_DEBE_EXT) MON_DEBE,
                             DECODE(:P681_IND_MON_EXT, 'N', M.MON_HABER, M.MON_HABER_EXT) MON_HABER,
                             M.ID_SUCURSAL,
                             M.ID_CENTRO,
                             M.COEFICIENTE,
                             M.ID_DET,
                             M.ID,
                             NULL ID_PROVEEDOR,
                             M.TIP_COMPROBANTE,
                             M.SER_COMPROBANTE,
                             M.NRO_COMPROBANTE
                        FROM COWV_LIBRO_MAYOR_PROV M
                       WHERE M.ID_EMPRESA    = :P0_ID_EMPRESA
                         AND M.COD_EJERCICIO = :P0_COD_EJERCICIO
                         AND M.FEC_ASIENTO BETWEEN :P681_MAYOR_FEC_INI AND :P681_MAYOR_FEC_FIN
                         AND (M.COD_CUENTA BETWEEN :P681_MAYOR_COD_CUENTA_INI AND :P681_MAYOR_COD_CUENTA_FIN /*OR :P681_MAYOR_COD_CUENTA_INI IS NULL OR :P681_MAYOR_COD_CUENTA_FIN IS NULL*/)
                         AND (M.COD_CENTRO BETWEEN :P681_MAYOR_COD_CENTRO_INI AND :P681_MAYOR_COD_CENTRO_FIN OR :P681_MAYOR_COD_CENTRO_INI IS NULL OR :P681_MAYOR_COD_CENTRO_FIN IS NULL)
                         AND (M.ID_SUCURSAL = :P681_MAYOR_SUCURSAL OR :P681_MAYOR_SUCURSAL IS NULL)
                      UNION ALL
                      SELECT ROW_NUMBER() OVER (ORDER BY COD_CUENTA) ORDEN,
                             MAX(M.FEC_ASIENTO),
                             NULL,--M.NUM_ASIENTO,
                             'SALDO ANTERIOR',--M.DETALLE,
                             M.COD_CUENTA,
                             M.NOMBRE_CUENTA,
                             SUM(DECODE(:P681_IND_MON_EXT, 'N', M.MON_DEBE, M.MON_DEBE_EXT)) MON_DEBE,
                             SUM(DECODE(:P681_IND_MON_EXT, 'N', M.MON_HABER, M.MON_HABER_EXT)) MON_HABER,
                             NULL,--M.ID_SUCURSAL,
                             NULL,--M.ID_CENTRO,
                             M.COEFICIENTE,
                             NULL,
                             NULL,
                             NULL,
                             NULL,
                             NULL,
                             NULL
                        FROM COWV_LIBRO_MAYOR_PROV M
                       WHERE M.ID_EMPRESA    = :P0_ID_EMPRESA
                         AND M.COD_EJERCICIO = :P0_COD_EJERCICIO
                         AND M.FEC_ASIENTO < :P681_MAYOR_FEC_INI
                         AND (M.COD_CUENTA BETWEEN :P681_MAYOR_COD_CUENTA_INI AND :P681_MAYOR_COD_CUENTA_FIN /*OR :P681_MAYOR_COD_CUENTA_INI IS NULL OR :P681_MAYOR_COD_CUENTA_FIN IS NULL*/)
                         AND (M.COD_CENTRO BETWEEN :P681_MAYOR_COD_CENTRO_INI AND :P681_MAYOR_COD_CENTRO_FIN OR :P681_MAYOR_COD_CENTRO_INI IS NULL OR :P681_MAYOR_COD_CENTRO_FIN IS NULL)
                         AND (M.ID_SUCURSAL = :P681_MAYOR_SUCURSAL OR :P681_MAYOR_SUCURSAL IS NULL)
                       GROUP BY M.COD_CUENTA, M.NOMBRE_CUENTA, M.COEFICIENTE
                       HAVING SUM(M.MON_DEBE) - SUM(M.MON_HABER) != 0
                       ORDER BY 5, 1, 2, 3
                
                  )
                ORDER BY COD_CUENTA, FEC_ASIENTO, NUM_ASIENTO, ORDEN
                ```
            pageItemsToSubmit: [
                P681_MAYOR_FEC_INI
                P681_MAYOR_FEC_FIN
                P681_MAYOR_COD_CUENTA_INI
                P681_MAYOR_COD_CUENTA_FIN
                P681_MAYOR_SUCURSAL
                P681_IND_MON_EXT
                P681_MAYOR_COD_CENTRO_INI
                P681_MAYOR_COD_CENTRO_FIN
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            flashback: false
        }
        advanced {
            savedReportMappingIdentifier: 260287652619547263
        }

        column COD_CUENTA (
            type: plainText
            heading {
                heading: Código
                alignment: center
