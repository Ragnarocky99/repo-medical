    dynamicAction generar-asientos-compras-importacion (
        name: Generar Asientos Compras Importacion
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @compras-import
        }

        action calcular-asientos-pendientes-compras (
            name: Calcular Asientos Pendientes Compras
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COUNT(*)
                    from cmw_compras_cabecera cc, 
                         bsw_tipos_comprobantes tc, 
                         bsw_sucursales su
                    where cc.ID_empresa = :P0_ID_EMPRESA
                      and cc.fec_comprobante between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                      and nvl( cc.estado, 'H' ) = 'C'
                      and nvl( cc.tip_comprobante_ref, 'DFL' ) = 'EMB' --26/09/2023
                      and cc.ID_empresa     = tc.ID_empresa
                      and cc.tip_comprobante = tc.tip_comprobante
                      and cc.asientos is null
                      and cc.ID_empresa  = su.ID_empresa
                      and cc.ID_sucursal = su.ID
                      AND :P0_COD_EJERCICIO = TO_CHAR(FEC_COMPROBANTE, 'yyyy')
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_COMPRAS_IMPORT
            }
            execution {
                sequence: 50
            }
        )

        action native-alert (
            action: alert
            settings {
                title: Operación Concluida
                message:
                    ```html
                    &P681_MENSAJE_PROCEDIMIENTO.
                    
                    ```
                style: information
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --By Ronald P.
                    DECLARE 
                        V_MENSAJE VARCHAR(4000);
                        V_NUM_ASIENTO_INI NUMBER(10);
                        V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    BEGIN
                    
                        V_MENSAJE := NULL;
                    
                        cow_asiento_compras_cm_imp(p_empresa         => :P0_ID_EMPRESA,
                                                   --p_tip_comprobante => NULL,
                                                   --p_ser_comprobante => NULL,
                                                   --p_nro_comprobante => NULL,
                                                   p_id_registro     => NULL,
                                                   p_fec_desde       => :P681_FECHA_INICIAL,
                                                   p_fec_hasta       => :P681_FECHA_FINAL,
                                                   p_mensaje         => V_MENSAJE,
                                                   p_nro_asiento_ini => V_NUM_ASIENTO_INI,
                                                   p_nro_asiento_fin => V_NUM_ASIENTO_FIN);
                    
                        :P681_MENSAJE_PROCEDIMIENTO := V_MENSAJE;
                        :P681_ASIENTO_NRO_INI       := V_NUM_ASIENTO_INI;
                        :P681_ASIENTO_NRO_FIN       := V_NUM_ASIENTO_FIN;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                            ROLLBACK;
                            :P681_MENSAJE_PROCEDIMIENTO:=SQLERRM;
                    END;
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                itemsToReturn: [
                    P681_MENSAJE_PROCEDIMIENTO
                    P681_ASIENTO_INI
                    P681_ASIENTO_FIN
                    P681_ASIENTO_NRO_INI
                    P681_ASIENTO_NRO_FIN
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
                stopExecutionOnError: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                spinnerType: dualRing
                spinnerColor: #647edc
                accessibilityText: Processing
            }
            execution {
