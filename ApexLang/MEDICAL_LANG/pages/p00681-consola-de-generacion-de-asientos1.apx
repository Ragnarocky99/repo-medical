                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P681_FECHA_INICIAL := conv_fecha;
                            ELSIF (length(:P681_FECHA_INICIAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P681_FECHA_INICIAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P681_FECHA_INICIAL
                itemsToReturn: P681_FECHA_INICIAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

