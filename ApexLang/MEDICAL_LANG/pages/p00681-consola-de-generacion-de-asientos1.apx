    dynamicAction set-saldo-ant (
        name: SET_SALDO_ANT
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @b250-mayor-ejecutar
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                           SUM(decode(nvl(:P681_IND_MON_EXT,'N'),'N',
                                              decode(m.tipo_cuenta,'A',(nvl(m.mon_debe,0)-nvl(m.mon_haber,0)),
                                                                  'H',(nvl(m.mon_haber,0)-nvl(m.mon_debe,0)),
                                                                  'P',(nvl(m.mon_haber,0)-nvl(m.mon_debe,0)),
                                                                  'D',(nvl(m.mon_debe,0)-nvl(m.mon_haber,0)),
                                                                      (nvl(m.mon_debe,0)-nvl(m.mon_haber,0))),
                                              decode(m.tipo_cuenta,'A',(nvl(m.mon_debe_ext,0)-nvl(m.mon_haber_ext,0)),
                                                                  'H',(nvl(m.mon_haber_ext,0)-nvl(m.mon_debe_ext,0)),
                                                                  'P',(nvl(m.mon_haber_ext,0)-nvl(m.mon_debe_ext,0)),
                                                                  'D',(nvl(m.mon_debe_ext,0)-nvl(m.mon_haber_ext,0)),
                                                                      (nvl(m.mon_debe_ext,0)-nvl(m.mon_haber_ext,0)))
                                                                      )) saldo_ant
                    
                    FROM COWV_ASIENTOS_PROV M
                    WHERE M.ID_EMPRESA     = :P0_COD_EMPRESA
                      AND M.FEC_ASIENTO   < :P681_MAYOR_FEC_INI
                      AND M.cod_cuenta = :P681_MAYOR_COD_CUENTA_INI
                      AND M.COD_EJERCICIO  = :P0_COD_EJERCICIO
                    
                    ```
                itemsToSubmit: [
                    P681_MAYOR_FEC_INI
                    P681_MAYOR_FEC_FIN
                    P681_MAYOR_COD_CUENTA_INI
                    P681_IND_EXT
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P681_SALDO_ANT
            }
            execution {
                sequence: 10
            }
        )

    )

