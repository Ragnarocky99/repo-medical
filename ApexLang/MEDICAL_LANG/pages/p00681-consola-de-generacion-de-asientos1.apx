                       UPDATE COW_DIARIO_CABECERAS_PROV
                          SET IND_MAYORIZADO = 'N'
                        WHERE FEC_ASIENTO BETWEEN :P681_FEC_INI_MAYORIZACION AND :P681_FEC_FIN_MAYORIZACION
                          AND (ID_MODULO = :P681_ID_MODULO_MAYORIZACION OR :P681_ID_MODULO_MAYORIZACION IS NULL);
                       
                       :P681_MENSAJE_MAYORIZACION := 'Proceso concluido con Exito';
                    END;
                    ```
