    dynamicAction procesar-balance (
        name: PROCESAR_BALANCE
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @b250-g-procesar
        }

        action native-alert (
            action: alert
            settings {
                message: Proceso ejecutado correctamente.
                style: success
            }
            execution {
                sequence: 170
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       v_sql VARCHAR2(200);
                    BEGIN
                       -- Construct the anonymous PL/SQL block as a string
                       v_sql := 'BEGIN DBMS_MVIEW.REFRESH(''COWMV_BALANCE_GENERAL_PROV''); END;';
                    
                       -- Execute the PL/SQL block
                       EXECUTE IMMEDIATE v_sql;
                    
                    EXCEPTION
                       WHEN OTHERS THEN
                          RAISE_APPLICATION_ERROR(-20000, 'Error refreshing materialized view: ' || SQLERRM);
                    END;
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        COW_BALANCE_GENERAL_PROV( p_id_empresa    => :P0_ID_EMPRESA,
                                                  p_cod_ejercicio => :P0_COD_EJERCICIO,
                                                  p_fec_desde     => :P681_G_FEC_INI,
                                                  p_fec_hasta     => :P681_G_FEC_FIN,
                                                  p_cta_desde     => :P681_G_COD_CUENTA_INI,
                                                  p_cta_hasta     => :P681_G_COD_CUENTA_FIN,
                                                  p_cen_desde     => :P681_G_CENTRO_COSTO_INI,
                                                  p_cen_hasta     => :P681_G_CENTRO_COSTO_FIN,
                                                  p_cod_usuario   => :APP_USER,
                                                  p_incluye_cie   => :P681_G_INCLUYE_CIERRE,
                                                  p_nro_id        => SEQ_COW_TMP_BALANCE.nextval,
                                                  p_financiero    => :P681_G_ESTADO_FINANCIERO,
                                                  p_general       => :P681_G_BALANCE_GENERAL,
                                                  p_mensaje       => :P681_MENSAJE_PROCEDIMIENTO,
                                                  p_ind_mon_ext   => :P681_IND_EXT,
                                                  p_fec_desde_x2  => NULL,
                                                  p_fec_hasta_x2  => NULL,
                                                  P_ID_SUCURSAL   => NULL
                                                                        );
                        -- COW_BALANCE_GENERAL_PROV(:P0_COD_EMPRESA, :P0_COD_EJERCICIO, :P681_G_FEC_INI, :P681_G_FEC_FIN, :P681_G_COD_CUENTA_INI,
                        --                          :P681_G_COD_CUENTA_FIN, :P681_G_CENTRO_COSTO_INI, :P681_G_CENTRO_COSTO_FIN, :APP_USER, SEQ_COW_TMP_BALANCE.nextval, 
                        --                          :P681_G_ESTADO_FINANCIERO, :P681_G_BALANCE_GENERAL, :P681_MENSAJE_PROCEDIMIENTO, :P681_IND_EXT, null, null, NULL, NULL);
                    EXCEPTION
                      WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20000,'ERROR AL GENERAR INFORME '||SQLERRM);     
                    END;
                    -- BEGIN
                    --     SELECT NVL(BG.SALDO,0) SALDO
                    --        INTO :P681_G_ACTIVO
                    --     FROM COW_TMP_BALANCE_PROV BG
                    --     WHERE BG.ID_EMPRESA       = :P0_ID_EMPRESA
                    --           AND BG.COD_EJERCICIO= :P0_COD_EJERCICIO
                    --           AND BG.COD_CUENTA  = '1'
                    --           AND BG.IP_MAQUINA   = :APP_USER;--:P681_IP_MAQUINA;
                    -- EXCEPTION
                    --   WHEN OTHERS THEN
                    --     NULL;
                    -- END;
                    DBMS_LOCK.SLEEP(0.3);
                    ```
