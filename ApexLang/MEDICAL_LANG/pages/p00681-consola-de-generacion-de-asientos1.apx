                    ```plsql
                    declare 
                    V_MENSAJE VARCHAR(4000);
                    V_NUM_ASIENTO_INI NUMBER(10);
                    V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    begin
                    cow_asiento_debcred(:P0_ID_EMPRESA,
                                        NULL,
                                        NULL,
                                        NULL,
                                        :P681_FECHA_INICIAL,
                                        :P681_FECHA_FINAL,
                                        V_MENSAJE,
                                        V_NUM_ASIENTO_INI,
                                        V_NUM_ASIENTO_FIN,
                                        :APP_USER);
                                        
                    :P681_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                    :P681_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
                    :P681_ASIENTO_NRO_FIN:=V_NUM_ASIENTO_FIN;
                    EXCEPTION 
                    WHEN OTHERS THEN
                    ROLLBACK;
                    :P681_MENSAJE_PROCEDIMIENTO:=SQLERRM;
                    end;
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                itemsToReturn: [
                    P681_MENSAJE_PROCEDIMIENTO
                    P681_ASIENTO_NRO_INI
                    P681_ASIENTO_NRO_FIN
                ]
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

