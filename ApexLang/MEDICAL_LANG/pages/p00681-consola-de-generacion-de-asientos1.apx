    region asientos-diario (
        name: Asientos Diario
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  LD.ID,
                        LD.FEC_ASIENTO,
                	    LD.NUM_ASIENTO,
                	    LD.DESC_CABECERA,
                	    LD.SUCURSAL,
                	    LD.COD_CUENTA,
                	    LD.NOMBRE_CUENTA,
                	    LD.DETALLE,
                	    LD.MON_DEBE,
                	    LD.MON_HABER,
                	    LD.CENTRO_COSTO,
                        LD.NUM_LINEA
                FROM    COWV_LIBRO_DIARIO_PROV LD
                WHERE   LD.FEC_ASIENTO BETWEEN :P681_ASI_FEC_INICIO AND :P681_ASI_FEC_FINAL
                AND     LD.ID_EMPRESA = :P0_ID_EMPRESA
                AND     LD.COD_EJERCICIO = :P0_COD_EJERCICIO
                AND     (LD.NUM_ASIENTO = :P681_ASI_NRO_ASIENTO OR :P681_ASI_NRO_ASIENTO IS NULL)
                AND     ((UPPER(LD.DETALLE) LIKE UPPER(:P681_ASI_DESC) OR :P681_ASI_DESC IS NULL) OR (UPPER(LD.DETALLE) LIKE UPPER(:P681_ASI_DESC) OR :P681_ASI_DESC IS NULL))
                AND     ((CASE (LD.TOT_DEBE - LD.TOT_HABER)
                            WHEN 0 THEN 'N'
                            ELSE 'S'
                         END) = :P681_ASI_DIFERENCIA OR :P681_ASI_DIFERENCIA IS NULL)
                AND     LD.IND_MAYORIZADO = :P681_ASI_MAYORIZADO
                AND     LD.IND_ASIENTO_APERTURA = :P681_ASI_APERTURA
                AND     LD.IND_ASIENTO_CIERRE = :P681_ASI_CIERRE
                AND     (LD.ID_MODULO = :P681_ASI_ID_MODULO OR :P681_ASI_ID_MODULO IS NULL OR LD.ID_MODULO IS NULL)
                ORDER BY LD.FEC_ASIENTO, LD.NUM_ASIENTO, LD.NUM_LINEA
                ```
            pageItemsToSubmit: [
                P681_ASI_FEC_FINAL
                P681_NRO_ASIENTO
                P681_ASI_MAYORIZADO
                P681_ASI_APERTURA
                P681_ASI_CIERRE
                P681_ASI_DESC
                P681_ASI_DIFERENCIA
                P681_ASI_ID_MODULO
                P681_ASI_NRO_ASIENTO
                P681_ASI_FEC_INICIO
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
