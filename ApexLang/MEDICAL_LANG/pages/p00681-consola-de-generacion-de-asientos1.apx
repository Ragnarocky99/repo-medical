        action calcular-asientos-pendientes-cobros (
            name: Calcular Asientos Pendientes Cobros
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     select sum(a.contador) contador 
                        from 
                        (select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    ccw_recibos re,  
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where re.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                                and re.id_empresa = c.id_empresa
                                and re.id_mov_caj=c.id
                                and nvl( re.anulado, 'H') <> 'S'
                                and c.id_moneda = m.id
                                --and c.asientos is null
                                and re.asientos is null
                                and re.id_empresa  = s.id_empresa
                                and re.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona
                                AND :P0_COD_EJERCICIO = TO_CHAR(re.fec_recibo, 'yyyy')
                          /*union all
                             select count(*) contador
                               from ccw_movimientos_cajas c, 
                                    vtw_comprobantes_cabecera vt, 
                                    bsw_monedas m,
                                    bsw_sucursales s, 
                                    ccw_clientes cl, 
                                    bsw_personas p
                              where vt.id_empresa = :P0_ID_EMPRESA
                                and c.fec_mov_caj between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                                and vt.id_empresa = c.id_empresa
                                and vt.id_mov_caj = c.id
                                and vt.tip_comprobante in ('FVE','NCR')
                                and nvl( vt.estado, 'H') <> 'A'
                                and c.id_moneda = m.id
                                and c.asientos is null
                                and vt.id_empresa  = s.id_empresa
                                and vt.id_sucursal = s.id
                                and cl.id_empresa(+)  = c.id_empresa
                                and cl.id(+)  = c.id_cliente
                                and p.id(+)   = cl.id_persona*/) a
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P681_CONT_COBRO
            }
            execution {
                sequence: 80
            }
        )

        action ejecutar-procedimiento-de-asiento (
            name: Ejecutar Procedimiento de Asiento
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        V_MENSAJE VARCHAR(4000);
                        V_NUM_ASIENTO_INI NUMBER(10);
                        V_NUM_ASIENTO_FIN NUMBER(10);
                    
                    begin
                        COW_ASIENTO_COBRO(:P0_ID_EMPRESA,
                                          NULL,
                                          :P681_FECHA_INICIAL,
                                          :P681_FECHA_FINAL,
                                          V_MENSAJE,
