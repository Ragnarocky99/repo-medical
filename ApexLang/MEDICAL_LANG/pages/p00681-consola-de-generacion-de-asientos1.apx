                       select count(*)
                        from cpw_cabecera_cajas cc
                        where cc.id_empresa      = 121
                          and (CC.FEC_MOV_CAJ between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                          and nvl(cc.anulado,'N') <> 'S'
                       --   and nvl(cc.pagado, 'N') = 'S'
                          and asientos is null) or
                             (nvl(anulado,'N') = 'S'
                          and fec_anulacion between :P681_FECHA_INICIAL and :P681_FECHA_FINAL
                          and asientos not like('%anul%'))
                          AND :P0_COD_EJERCICIO = TO_CHAR(FEC_MOV_CAJ, 'yyyy');
