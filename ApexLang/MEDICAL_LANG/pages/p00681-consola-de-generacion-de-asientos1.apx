    region asientos-con-diferencia (
        name: Asientos con Diferencia
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  'IR_ASIENTO',
                       ID_EMPRESA,
                       ID_EJERCICIO,
                       FEC_ASIENTO,
                       NUM_ASIENTO,
                       DIFERENCIA,
                       ID
                       
                
                  from COWV_ASIENTOS_PROV_DIF
                 where ID_EMPRESA=:P0_ID_EMPRESA AND     
                (FEC_ASIENTO BETWEEN :P681_FECHA_INICIAL AND :P681_FECHA_FINAL)
                and 1=0
                ```
            pageItemsToSubmit: [
                P681_FECHA_INICIAL
                P681_FECHA_FINAL
            ]
        }
        layout {
            sequence: 50
            parentRegion: @generación-de-asientos
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @interactive-report
