    region generación-de-balance (
        name: Generación de Balance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT BG.NRO_ID,
                       BG.IP_MAQUINA,
                       CASE
                            WHEN BG.COD_CUENTA IS NOT NULL THEN 'fa fa-search u-primary-text'
                       END COD_CUENTA_BUSCAR,
                       BG.ID_EMPRESA,
                       BG.COD_EJERCICIO,
                       BG.COD_CUENTA,
                       BG.NOMBRE_CUENTA,
                       BG.COD_CENTRO,
                       BG.NIVEL_CUENTA,
                       BG.TIPO_CUENTA,
                       BG.ASENTABLE,
                       SUM(NVL(BG.SALDO,0)) SALDO,
                       BG.COD_USUARIO
                FROM COW_TMP_BALANCE_PROV BG
                
                WHERE BG.ID_EMPRESA       = :P0_ID_EMPRESA
                      AND BG.COD_EJERCICIO= :P0_COD_EJERCICIO
                     -- AND BG.SALDO IS NOT NULL
                      AND (BG.COD_CUENTA   BETWEEN :P681_G_COD_CUENTA_INI AND :P681_G_COD_CUENTA_FIN  OR (:P681_G_COD_CUENTA_INI IS NULL OR :P681_G_COD_CUENTA_FIN IS NULL))
                      AND (BG.COD_CENTRO   BETWEEN :P681_G_CENTRO_COSTO_INI AND :P681_G_CENTRO_COSTO_FIN OR (:P681_G_CENTRO_COSTO_INI IS NULL OR :P681_G_CENTRO_COSTO_FIN IS NULL))
                      AND BG.COD_USUARIO = :APP_USER
                      --AND (BG.FEC_PROCESO  BETWEEN :P681_G_FEC_INI AND :P681_G_FEC_FIN OR (:P681_G_FEC_INI IS NULL OR :P681_G_FEC_FIN IS NULL))
                     -- AND BG.IP_MAQUINA   = :P681_IP_MAQUINA--(SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL) 
                      /*Bueno, qué pasa con este select... Esto permite comparar lo que se procesó por
                       la ip de la máquina, para ver con más detalle fijarse en el Procedimiento de 
                       base de datos COW_BALANCE_GENERAL_PROV*/
                GROUP BY BG.NRO_ID,
                       BG.IP_MAQUINA,
                       CASE
                            WHEN BG.COD_CUENTA IS NOT NULL THEN 'fa fa-search u-primary-text'
                       END,
                       BG.ID_EMPRESA,
                       BG.COD_EJERCICIO,
                       BG.COD_CUENTA,
                       BG.NOMBRE_CUENTA,
                       BG.COD_CENTRO,
                       BG.NIVEL_CUENTA,
                       BG.TIPO_CUENTA,
                       BG.ASENTABLE,
                       BG.COD_USUARIO
                
                ORDER BY /*D.FEC_ASIENTO ASC, */regexp_replace(
                      regexp_replace(
                        regexp_replace(
                          BG.COD_CUENTA,'(^|\.)(\d{3})','\1 \2'
                          ),
                        '(^|\.)(\d{2})','\1 0\2'
                      ),
                      '(^|\.)(\d)','\1 00\2'
                    )
                ;
                ```
            pageItemsToSubmit: [
                P681_G_FEC_INI
                P681_G_FEC_FIN
                P681_G_COD_CUENTA_INI
                P681_G_COD_CUENTA_FIN
                P681_G_CENTRO_COSTO_INI
                P681_G_CENTRO_COSTO_FIN
                P0_ID_EMPRESA
                P0_COD_EJERCICIO
                P681_IND_EXT
            ]
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: balance
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            highlight: false
            chart: false
            flashback: false
        }
        heading {
            fixedTo: region
            maxReportHeight: 250
        }
        advanced {
            savedReportMappingIdentifier: 260037646129849774
        }

