                                          V_NUM_ASIENTO_FIN);
                    
                        :P681_MENSAJE_PROCEDIMIENTO:=V_MENSAJE;
                        :P681_ASIENTO_NRO_INI:=V_NUM_ASIENTO_INI;
                        :P681_ASIENTO_NRO_FIN:=V_NUM_ASIENTO_FIN;
                    EXCEPTION
                        WHEN OTHERS THEN
                    
                            ROLLBACK;
                            --RAISE_APPLICATION_ERROR(-20000,V_MENSAJE||'-- '||dbms_utility.format_error_backtrace);
                            RAISE_APPLICATION_ERROR(-20000,V_MENSAJE||'-- '||SQLERRM);
                            :P681_MENSAJE_PROCEDIMIENTO:=V_MENSAJE||'- -'||SQLERRM;
                    end;
                    ```
                itemsToSubmit: [
                    P681_FECHA_INICIAL
                    P681_FECHA_FINAL
                ]
                itemsToReturn: [
                    P681_MENSAJE_PROCEDIMIENTO
                    P681_ASIENTO_INI
                    P681_ASIENTO_FIN
                    P681_ASIENTO_NRO_INI
                    P681_ASIENTO_NRO_FIN
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
                stopExecutionOnError: false
            }
        )

