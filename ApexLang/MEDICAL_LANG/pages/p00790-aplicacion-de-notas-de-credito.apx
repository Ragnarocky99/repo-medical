page 790 (
    name: Aplicacion de Notas de Credito
    alias: APLICACION-DE-NOTAS-DE-CREDITO
    title: Aplicacion de Notas de Credito
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region aplicacion-de-notas-de-credito (
        name: Aplicacion de Notas de Credito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.NRO_CANCELACION,
                       C.ID_CLIENTE,
                       PER.NOMBRE,
                       NVL(PER.RUC,PER.NRO_CI) AS RUC,
                       C.FEC_CANCELACION,
                       C.ANULADO,
                       C.ID_USUARIO,
                       C.FEC_CARGA,
                       C.NRO_CUOTA,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.IMPORTE,
                       C.COD_USUARIO_AUD,
                       C.ID_COMPROBANTE_CAB,
                       C.ID_NOTA_DEBCRED,
                       C.ID_USUARIO_ANULA,
                       C.FECHA_ANULADO,
                       C.ID_USUARIO_DESANULA,
                       C.FECHA_DESANULADO,
                       C.ID_SALDO,
                       C.ID_CORPORACION,
                       C.TOTAL,
                       C.DIFERENCIA,
                       CASE C.ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ANULADO_ICON
                  from CCW_CANCELA_CUOTAS C,
                       CCW_CLIENTES       CL,
                       BSW_PERSONAS       PER
                  WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                    AND C.ID_CLIENTE = CL.ID
                    AND CL.ID_PERSONA = PER.ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 791
                items: {
                    P791_ID: #ID#
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 73523423530784639
        }

