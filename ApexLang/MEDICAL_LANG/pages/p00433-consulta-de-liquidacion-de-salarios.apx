page 433 (
    name: Consulta de Liquidacion de Salarios
    alias: CONSULTA-DE-LIQUIDACION-DE-SALARIOS
    title: Consulta de Liquidacion de Salarios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cabecera-liquidación (
        name: Cabecera liquidación
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       SER_LIQUID,
                       NRO_LIQUID,
                       FEC_LIQUID,
                       ID_EMPLEADO,
                       MES,
                       ANIO,
                       ID_ESTADO,
                       CASE ID_ESTADO 
                        WHEN 1 THEN 'fa fa-check u-success-text'
                        WHEN 2 THEN 'fa fa-remove u-danger-text'
                       END ID_ESTADO_ICON,
                       COD_USUARIO_AUD,
                       ID,
                       ID_SUCURSAL,
                       ID_CENTRO,
                       IND_VACACIONES,
                       IND_CIERRE_MES,
                       IND_LIQ_FINAL,
                       SUELDO_BASE,
                       TIPO_LIQ,
                       DIAS_VACACIONES,
                       SUELDO_FINAL,
                       JORNAL_BASE,
                       SALARIO_MINIMO,
                       ID_SECTOR_EMP,
                       SALDO_ROJO,
                       PROV_AGUINALDO,
                       PROV_AGUINALDO_LEGAL,
                       COMPENSACION,
                       ASIENTOS,
                       ID_DEPARTAMENTO,
                       MONTO,
                       DIAS,
                       ID_MOTIVO_CALIDA,
                       ID_MOTIVO_SALIDA,
                       CI,
                       ID_CENTRO_PAGO,
                       TIP_LIQUID,
                       ID_CAB_HABILITACION,
                       SUELDO_PROMEDIO,
                       NRO_PATRONAL,
                       DIRECCION_IP,
                       FEC_CARGA,
                       FECHA_RENUNCIA,
                       FECHA_SALIDA
                  from RHW_CABECERA_LIQ
                  WHERE (NRO_LIQUID = :P433_NRO_LIQ OR :P433_NRO_LIQ IS NULL)
                  AND SER_LIQUID = 'X'
                ```
            pageItemsToSubmit: P433_NRO_LIQ
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 443
                items: {
                    P443_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 43309613301640245
        }

