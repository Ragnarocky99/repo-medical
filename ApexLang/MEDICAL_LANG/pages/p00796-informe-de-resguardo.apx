    pageItem P796_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P796_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

