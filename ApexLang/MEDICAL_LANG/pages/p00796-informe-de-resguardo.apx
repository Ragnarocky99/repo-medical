page 796 (
    name: Informe de Resguardo
    alias: INFORME-DE-RESGUARDO
    title: Informe de Resguardo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region informe-de-resguardo (
        name: Informe de Resguardo
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LCWV_INFORME_RESGUARDO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FEC_RESGUARDO BETWEEN :P796_FEC_INI AND :P796_FEC_FIN AND
                (NRO_LICITACION = :P796_NRO_LICITACION OR :P796_NRO_LICITACION IS NULL) AND
                (NRO_ID_LICITACION = :P796_NRO_ID_LICITACION OR :P796_NRO_ID_LICITACION IS NULL) AND
                (ID_CLIENTE = :P796_ID_CLIENTE OR :P796_ID_CLIENTE IS NULL) AND
                (ID_ARTICULO = :P796_ID_ARTICULO OR :P796_ID_ARTICULO IS NULL)
                ```
            orderByClause: FEC_RESGUARDO DESC, NRO_LICITACION DESC, NRO_ITEM
            pageItemsToSubmit: [
                P796_FEC_INI
                P796_FEC_FIN
                P796_ID_CLIENTE
                P796_NRO_LICITACION
                P796_ID_ARTICULO
                P796_NRO_ID_LICITACION
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 51387427631951356
        }

        column CANT_DEVOLUCION (
            type: plainText
            heading {
                heading: Cant. Devolucion
                alignment: center
            }
            layout {
                sequence: 11
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

