            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P796_ID_CLIENTE
                P796_NRO_LICITACION
                P796_ID_ARTICULO
                P796_NRO_ID_LICITACION
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @informe-de-resguardo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @informe-de-resguardo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

