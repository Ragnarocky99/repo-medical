page 69 (
    name: AGENDA
    alias: BSAGENDA
    title: AGENDA
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region agenda (
        name: AGENDA
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_EVENTO,
                       DESCRIPCION,
                       FEC_INICIO,
                       FEC_FIN,
                       ID_USUARIO,
                       TIPO_EVENTO,
                       ID_EMPRESA,
                       TITULO
                  from BSW_AGENDA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P69_COD_EVENTO (
        type: displayOnly
        label {
            label: Cod Evento
            alignment: left
        }
        layout {
            sequence: 20
            region: @agenda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @agenda
            column: COD_EVENTO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(COD_EVENTO),0)+1 FROM BSW_AGENDA
        }
    )

    pageItem P69_DESCRIPCION (
        type: textarea
        label {
            label: Descripcion
            alignment: left
        }
        layout {
            sequence: 40
            region: @agenda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @agenda
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P69_FEC_FIN (
        type: datePicker
        label {
            label: Fec Fin
            alignment: left
        }
        layout {
            sequence: 60
            region: @agenda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @agenda
            column: FEC_FIN
            dataType: date
        }
    )

    pageItem P69_FEC_INICIO (
        type: datePicker
        label {
            label: Fec Inicio
            alignment: left
        }
        layout {
            sequence: 50
            region: @agenda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @agenda
            column: FEC_INICIO
            dataType: date
        }
    )

    pageItem P69_ID (
        type: hidden
        layout {
            sequence: 10
            region: @agenda
            slot: regionBody
        }
        source {
            formRegion: @agenda
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P69_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 90
            region: @agenda
            slot: regionBody
        }
        source {
            formRegion: @agenda
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
    )

    pageItem P69_ID_USUARIO (
        type: hidden
        layout {
            sequence: 70
            region: @agenda
            slot: regionBody
        }
        source {
            formRegion: @agenda
            column: ID_USUARIO
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v_id varchar2(10);
                BEGIN
                SELECT ID 
                INTO v_id
                FROM BSW_USUARIOS
                WHERE UPPER(COD_USUARIO)=UPPER(:APP_USER)
                AND ID_EMPRESA=:P0_COD_EMPRESA;
                RETURN V_ID;
                END;
                ```
        }
    )

    pageItem P69_TIPO_EVENTO (
        type: hidden
        layout {
            sequence: 80
            region: @agenda
            slot: regionBody
        }
        source {
            formRegion: @agenda
            column: TIPO_EVENTO
            dataType: varchar2
        }
    )

    pageItem P69_TITULO (
        type: textField
        label {
            label: Titulo
            alignment: left
        }
        layout {
            sequence: 30
            region: @agenda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @agenda
            column: TITULO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P69_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: u-danger
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P69_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P69_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 11055997705125501
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-bsagenda (
        name: Initialize form BSAGENDA
        type: formInitialization
        formRegion: @agenda
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11055154842125501
        }
    )

    process process-form-bsagenda (
        name: Process form BSAGENDA
        type: formAutoRowProcessing
        formRegion: @agenda
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11055500593125501
        }
    )

)

