    region compra-detallada-de-proveedores (
        name: Compra detallada de Proveedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CC.ID,
                       CC.FEC_COMPROBANTE,
                       CC.RUC,
                       CC.NOM_PROVEEDOR,
                       CC.RUC_REF,
                       CC.NOM_PROVEEDOR_REF,
                       CC.TIP_COMPROBANTE, 
                       CC.SER_COMPROBANTE, 
                       CC.NUM_COMPROBANTE,
                       CC.TOT_COMPROBANTE,
                       CC.ID_PROVEEDOR ID_PROVEEDOR_REF,
                       CC.REFERENCIA,
                       TO_NUMBER(CC.ASIENTOS) AS ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(CC.ASIENTOS)
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(CC.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = CC.ID_EMPRESA) ASIENTO_ID,
                     '' AS LINK
                FROM CPW_COMPROBANTES_CABECERA CC
                JOIN CMW_PROVEEDORES           PR ON PR.ID = NVL(CC.ID_PROVEEDOR_REF, CC.ID_PROVEEDOR)
                WHERE CC.ID_EMPRESA  = :P0_ID_EMPRESA
                  AND (CC.ID_PROVEEDOR = :P372_PROVEEDOR OR :P372_PROVEEDOR IS NULL)
                  AND (CC.TIP_COMPROBANTE = :P372_TIP_COMPROBANTE OR :P372_TIP_COMPROBANTE IS NULL) 
                  AND (CC.SER_COMPROBANTE = :P372_SER_COMPROBANTE OR :P372_SER_COMPROBANTE IS NULL)
                  AND (CC.NUM_COMPROBANTE = :P372_NRO_COMPROBANTE OR :P372_NRO_COMPROBANTE IS NULL)
                  AND (CC.REFERENCIA    LIKE '%'||:P372_REFERENCIA||'%' OR :P372_REFERENCIA IS NULL)
                  AND (CC.FEC_COMPROBANTE BETWEEN :P372_FEC_INI AND :P372_FEC_FIN)
                  AND (CC.TIP_COMPROBANTE IN ('PTM', 'SAP', 'DIV') AND :P372_PERMISO_CARGA_SALARIOS = 'S' OR CC.TIP_COMPROBANTE  NOT IN ('PTM', 'SAP', 'DIV'))
                  AND (PR.IND_PERMITIR_VISUALIZAR = 'N' AND :P372_PERMISO_CARGA_SALARIOS = 'S' OR PR.IND_PERMITIR_VISUALIZAR = 'S')
                
                ORDER BY CC.FEC_COMPROBANTE DESC, CC.NUM_COMPROBANTE DESC
                
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P372_PROVEEDOR
                P372_TIP_COMPROBANTE
                P372_SER_COMPROBANTE
                P372_NRO_COMPROBANTE
                P372_REFERENCIA
                P372_FEC_INI
                P372_FEC_FIN
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 392
                items: {
                    P392_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 82013288196909969
        }

