page 555 (
    name: Carga de Conceptos de Embarques
    alias: CARGA-DE-CONCEPTOS-DE-EMBARQUES
    title: Carga de Conceptos de Embarques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 228px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-concepto-de-embarque (
        name: Carga de Concepto de Embarque
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.COD_CONCEPTO,
                       EC.DESCRIPCION,
                       EC.ID,
                       EC.COD_USUARIO_AUD
                FROM CMW_EMBARQUES_CONCEPTO EC;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P555_COD_CONCEPTO (
        type: textField
        label {
            label: <p><b style="color:red;">*</b>Código</p>
            alignment: left
        }
        layout {
            sequence: 100
            region: @carga-de-concepto-de-embarque
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @carga-de-concepto-de-embarque
            column: COD_CONCEPTO
            dataType: varchar2
        }
    )

    pageItem P555_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-concepto-de-embarque
            slot: regionBody
        }
        source {
            formRegion: @carga-de-concepto-de-embarque
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P555_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción</p>
            alignment: left
        }
        layout {
            sequence: 110
            region: @carga-de-concepto-de-embarque
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 7
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-concepto-de-embarque
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P555_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-concepto-de-embarque
            slot: regionBody
        }
        source {
            formRegion: @carga-de-concepto-de-embarque
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: CMW_EMBARQUES_CONCEPTO_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P555_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P555_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P555_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p555-cod-concepto (
        itemName: P555_COD_CONCEPTO
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    vnextval    number(10);
                BEGIN
                    vnextval := 0;
                    BEGIN
                        SELECT max(to_number(E.COD_CONCEPTO))+1
                          INTO vnextval
                        FROM CMW_EMBARQUES_CONCEPTO E;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            NULL;
                    END;
                    IF vnextval IS NOT NULL THEN
                        RETURN vnextval;
                    ELSE
                        vnextval := 1;
                        RETURN vnextval;
                    END IF;    
                END;
                ```
        }
    )

    process cerrar-recuadro-de-dialogo (
        name: Cerrar recuadro de Dialogo
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 88349757799106637
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE, DELETE
        }
    )

    process inicializa (
        name: INICIALIZA
        type: formInitialization
        formRegion: @carga-de-concepto-de-embarque
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 88345896049106635
        }
    )

    process procesar-pantalla-de-carga-de-concepto-de-embarques (
        name: Procesar pantalla de Carga de Concepto de Embarques
        type: formAutoRowProcessing
        formRegion: @carga-de-concepto-de-embarque
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 88345476411106635
        }
    )

)

