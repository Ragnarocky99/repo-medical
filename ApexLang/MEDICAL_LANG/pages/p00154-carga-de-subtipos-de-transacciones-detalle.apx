    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P154_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: t-Button--danger
        }
