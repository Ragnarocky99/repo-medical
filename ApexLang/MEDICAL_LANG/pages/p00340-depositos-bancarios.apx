page 340 (
    name: Depositos Bancarios
    alias: DEPOSITOS-BANCARIOS
    title: Depositos Bancarios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region depósitos (
        name: Depositos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT vc.id,
                       vc.id_empresa,
                       vc.descripcion,
                       vc.tip_comprobante,
                       vc.ser_comprobante,
                       vc.nro_comprobante,
                       vc.fec_comprobante,
                       vc.id_per_juridica,
                       vc.nro_cuenta,
                       vc.tot_credito,
                       vc.id_cuenta,
                       vc.referencia,
                       vc.asientos,
                       dc.id AS asiento_id,
                       vc.cod_usuario_aud,
                       vc.fec_alta
                FROM   ccw_mov_valores_cab vc
                JOIN   cow_ejercicios ej
                       ON ej.cod_ejercicio = TO_CHAR(vc.fec_comprobante, 'yyyy')
                LEFT JOIN cow_diario_cabeceras_prov DC
                       ON dc.num_asiento = vc.asientos
                      AND dc.id_ejercicio = ej.id
                    WHERE vc.fec_comprobante between :P340_FEC_INI and :P340_FEC_FIN
                      AND (vc.nro_comprobante = :P340_NRO_COMPROBANTE or :P340_NRO_COMPROBANTE is null)
                      AND (vc.referencia = :P340_REFERENCIA or :P340_REFERENCIA is null)
                ORDER BY vc.fec_comprobante DESC,
                         vc.nro_comprobante DESC;
                ```
            pageItemsToSubmit: [
                P340_FEC_INI
                P340_FEC_FIN
                P340_REFERENCIA
                P340_NRO_COMPROBANTE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 341
                items: {
                    P341_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            reportsSelectList: false
        }
        advanced {
            savedReportMappingIdentifier: 15456663411899410
        }

        column ASIENTOS (
            type: link
            heading {
                heading: Asientos
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            link {
                target: {
                    page: 235
                    items: {
                        P235_ID: #ASIENTO_ID#
                    }
                }
                linkText: #ASIENTOS#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: FH
            }
        )

        column ASIENTO_ID (
            type: hidden
            heading {
                heading: Asiento Id
            }
            layout {
                sequence: 150
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: FD
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Creado Por
