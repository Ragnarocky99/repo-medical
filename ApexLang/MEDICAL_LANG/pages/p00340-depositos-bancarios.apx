        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Depósitos
        }

        savedReport 155588 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ASIENTOS (
                sequence: 9
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 10
            )

            displayColumn FEC_ALTA (
                sequence: 11
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 1
            )

            displayColumn ID_PER_JURIDICA (
                sequence: 5
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 4
            )

            displayColumn NRO_CUENTA (
                sequence: 7
            )

            displayColumn REFERENCIA (
                sequence: 6
            )

            displayColumn SER_COMPROBANTE (
                sequence: 3
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 2
            )

            displayColumn TOT_CREDITO (
                sequence: 8
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @depósitos
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    pageItem P340_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P340_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo Comprobante:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    pageItem P340_NRO_COMPROBANTE (
        type: numberField
        label {
            label: <p>Nro. Comprobante:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P340_REFERENCIA (
        type: textField
        label {
            label: <p>Nro. Boleta:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button b430-crear (
        buttonName: B430_CREAR
        label: Crear
        layout {
            sequence: 10
            region: @depósitos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 341
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }

        triggerAction refrescar-reporte (
            name: Refrescar Reporte
            action: refresh
            affectedElements {
                selectionType: region
                region: @depósitos
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction agregar-paginacion (
        name: Agregar Paginacion
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @depósitos
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction asiento-doble-click (
        name: ASIENTO_DOBLE_CLICK
        execution {
            sequence: 10
        }
        when {
            event: dblclick
            selectionType: jQuerySelector
            jquerySelector: .a-GV-row
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var r=$(this.triggeringElement);
                    r.find("table.apexir_WORKSHEET_DATA td").dblclick(function(){
                     var l=$(this);
                     $s("apexir_CURRENT_SEARCH_COLUMN",l.attr("asientos")); // comment out this line if you like search from all columns
                     $s("apexir_SEARCH",l.text());
                     r.trigger("apexrefresh");
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

