    dynamicAction setear-cod-cliente-ref (
        name: Setear COD_CLIENTE_REF
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P653_ID_CLIENTE
        }
        serverSideCondition {
            type: itemIsNull
            item: P653_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  c.cod_cliente
                    from    ccw_clientes c
                    where   id  = :P653_ID_CLIENTE
                    ```
                itemsToSubmit: P653_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P653_COD_CLIENTE_REF
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setear-monto-total (
        name: Setear Monto Total
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P653_SALDO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody: return :P653_SALDO;
                itemsToSubmit: P653_SALDO
            }
            affectedElements {
                selectionType: items
                items: P653_MONTO_TOTAL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setear-tipo-cambio (
        name: Setear Tipo Cambio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P653_ID_MONEDA
        }
        serverSideCondition {
            type: itemIsNull
            item: P653_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    if not :P653_ID_MONEDA is null then
                        return ftipos_cambio(:P653_ID_MONEDA, sysdate, 'F', 'V');
                    end if;
                    ```
                itemsToSubmit: P653_ID_MONEDA
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P653_TIP_CAMBIO
            }
            execution {
                sequence: 10
            }
        )

    )

