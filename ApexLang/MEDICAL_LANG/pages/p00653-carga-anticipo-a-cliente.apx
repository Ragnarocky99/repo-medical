page 653 (
    name: Carga Anticipo a Cliente
    alias: CARGA-ANTICIPO-A-CLIENTE
    title: Carga Anticipo a Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 950
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P653_TIP_CAMBIO").readOnly = true;
            document.getElementById("P653_TIP_COMPROBANTE").readOnly = true;
            document.getElementById("P653_SER_COMPROBANTE").readOnly = true;
            
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
                text-align: left;
            }
            
            .no-pointer{
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ccw-anticipos-clientes-cab (
        name: CCW_ANTICIPOS_CLIENTES_CAB
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       FEC_COMPROBANTE,
                       ID_CLIENTE,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       MONTO_TOTAL,
                       SALDO,
                       ACTIVO,
                       ID_SUCURSAL,
                       COD_USUARIO,
                       ID_CUENTA,
                       ID,
                       ID_TIPO_COMP,
                       ID_SERIE_COMP,
                       ID_SECTOR
                  from CCW_ANTICIPOS_CLIENTES_CAB
                ```
            pageItemsToSubmit: P653_ID
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

