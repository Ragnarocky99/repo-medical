    process cargar-coleccion-recibo (
        name: Cargar coleccion RECIBO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_ID_SALDO NUMBER;
                BEGIN
                    IF :P653_BANDERA_RECIBO = 'S' THEN
                        DBMS_LOCK.SLEEP(0.02);
                        BEGIN
                            SELECT  ID
                            INTO    V_ID_SALDO
                            FROM    CCW_SALDOS
                            WHERE   ID_ANTICIPO = :P653_ID
                            AND     TIPO_COMPROBANTE = W_BUSCA_PARAMETRO('CC', 'TIP_ANTI_CLIENTE_DEB');
                        EXCEPTION
                            WHEN OTHERS THEN
                                RAISE_APPLICATION_ERROR(-20000, 'No se encontró el saldo correspondiente '||SQLERRM);
                        END;
                        APEX_COLLECTION.ADD_MEMBER(
                            p_collection_name => 'SALDOS_CLIENTE_SELECCION',
                            p_c001  => 'N',
                            p_n001  => V_ID_SALDO,
                            p_n002  => :P653_ID_MONEDA);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 13253635674874235
        }
    )

