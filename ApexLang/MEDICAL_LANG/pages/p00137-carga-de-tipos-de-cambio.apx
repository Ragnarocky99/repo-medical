page 137 (
    name: Carga de Tipos de Cambio
    alias: CARGA-DE-TIPOS-DE-CAMBIO
    title: Carga de Tipos de Cambio
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-tipos-de-cambio (
        name: Carga de Tipos de Cambio
        type: form
        source {
            location: localDatabase
            tableName: BSW_TIPOS_CAMBIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P137_ACTUALIZADO_POR (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-tipos-de-cambio
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: ACTUALIZADO_POR
            dataType: varchar2
        }
    )

    pageItem P137_ALTA_POR (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-tipos-de-cambio
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: ALTA_POR
            dataType: varchar2
        }
    )

    pageItem P137_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-tipos-de-cambio
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P137_FEC_ACTUALIZADO (
        type: hidden
        layout {
            sequence: 120
            region: @carga-de-tipos-de-cambio
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: FEC_ACTUALIZADO
            dataType: date
        }
    )

    pageItem P137_FEC_ALTA (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-tipos-de-cambio
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: FEC_ALTA
            dataType: date
        }
    )

    pageItem P137_FEC_TIPO_CAMBIO (
        type: datePicker
        label {
            label: <p>Fecha Tipo de Cambio:</p>
            alignment: left
        }
        settings {
            displayAs: nativeHtml
        }
        layout {
            sequence: 40
            region: @carga-de-tipos-de-cambio
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: YYYY-MM-DD
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: FEC_TIPO_CAMBIO
            dataType: date
        }
    )

    pageItem P137_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-tipos-de-cambio
            slot: regionBody
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_TIPOS_CAMBIO_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P137_ID_MONEDA (
        type: selectList
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Moneda:</a>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-monedas
        }
        layout {
            sequence: 30
            region: @carga-de-tipos-de-cambio
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: ID_MONEDA
            dataType: number
        }
    )

    pageItem P137_TIPO_CAMBIO (
        type: selectList
        label {
            label: " <a style=\" color:#3f46bb; font-weight:bold;\">Tipo de Cambio:</a>"
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @p137-tipo-cambio
            displayExtraValues: false
            nullDisplayValue: -- Sin Seleccionar --
        }
        layout {
            sequence: 70
            region: @carga-de-tipos-de-cambio
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: TIPO_CAMBIO
            dataType: varchar2
        }
    )

    pageItem P137_VAL_COMPRA (
        type: numberField
        label {
            label: <p>Valor de Compra:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @carga-de-tipos-de-cambio
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: VAL_COMPRA
            dataType: number
        }
    )

    pageItem P137_VAL_VENTA (
        type: numberField
        label {
            label: <p>Valor de Venta:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @carga-de-tipos-de-cambio
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-tipos-de-cambio
            column: VAL_VENTA
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P137_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P137_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16525720974364931
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-tipos-de-cambio (
        name: Initialize form Carga de Tipos de Cambio
        type: formInitialization
        formRegion: @carga-de-tipos-de-cambio
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16524978196364931
        }
    )

    process process-form-carga-de-tipos-de-cambio (
        name: Process form Carga de Tipos de Cambio
        type: formAutoRowProcessing
        formRegion: @carga-de-tipos-de-cambio
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16525311220364931
        }
    )

)

