    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @talonario
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P663_LV_TALONARIOS_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction agregar-boton (
        name: Agregar Boton
        execution {
            sequence: 160
        }
        when {
            event: ready
        }

        action plugin-hr-bilog-extendigtoolbar (
            action: plugin/interactiveGridExtendToolbar
            settings {
                label: Facturar
                hot: true
                icon: fa-dot-circle-o
                triggerAction: trg_facturar
            }
            affectedElements {
                selectionType: region
                region: @remisiones
            }
            execution {
                sequence: 20
            }
        )

        action plugin-hr-bilog-extendigtoolbar-2 (
            action: plugin/interactiveGridExtendToolbar
            settings {
                label: Facturar Catalogo
                hot: true
                icon: fa-dot-circle-o
                triggerAction: trg_facturar_cat
            }
            affectedElements {
                selectionType: region
                region: @remisiones-catalogo
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction cambiar-sesion (
        name: Cambiar Sesion
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P663_LV_TALONARIOS
        }

        action cargar-talonario (
            name: Cargar talonario
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_SERIE CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_SERIE) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_SERIE);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_SERIE);
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_SERIE,
                        p_c001 => :P663_LV_TALONARIOS,
                        p_c002 => :P663_SER_COMPROBANTE
                         );
                      :P663_BANDERA_TALONARIO := 1;
                    END;
                    ```
                itemsToSubmit: [
                    P663_LV_TALONARIOS
