    region remisiones-ant (
        name: Remisiones Ant.
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                        RP.ID_REMISION ID,
                        RP.ID_SUCURSAL,
                        RP.precio_unitario ,
                        RP.CANTIDAD_PENDIENTE CANTIDAD,
                        RP.ID_ARTICULO,
                        AR.DESCRIPCION AS DESCRIPCION_ARTICULO,
                        RP.ID_CLIENTE,
                        RP.FEC_COMPROBANTE FEC_ENT_SAL,
                        RP.ID_MONEDA,
                        RP.ID_VENDEDOR,
                        'REM' TIP_ENT_SAL,
                        RP.NRO_REMISION NUM_ENT_SAL,
                        RP.ID_REMISION_DETALLE,
                        RP.ID_LOTE,
                        RP.NRO_LOTE,
                        RP.ID_UNIDAD_MEDIDA,
                        RP.NRO_OCC,
                        RP.ID_COTIZA_ART,
                        RP.ID_OFERTA_LIC
                        
                
                
                from REMISIONES_PENDIENTES RP
                join STW_ARTICULOS AR ON RP.ID_ARTICULO = AR.ID
                where RP.ID_EMPRESA = :P0_ID_EMPRESA
                  AND (RP.ID_CLIENTE = :P663_CLIENTE or :P663_CLIENTE is null)
                  AND (RP.ID_VENDEDOR = :P663_VENDEDOR or :P663_VENDEDOR is null)
                  AND (RP.ID_MONEDA   = :P663_MONEDA or :P663_MONEDA is null)
                  AND RP.FEC_COMPROBANTE BETWEEN :P663_FEC_DESDE AND :P663_FEC_HASTA
                  AND (RP.NRO_OCC = :P663_NRO_OCC OR :P663_NRO_OCC IS NULL)
                  AND RP.ID_SUCURSAL = :P0_ID_SUCURSAL
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
