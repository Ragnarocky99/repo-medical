    dynamicAction habilitar-copiado-en-read-only (
        name: Habilitar Copiado en read only
        execution {
            sequence: 260
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.addEventListener('copy', (event) => {
                        const activeElement = $(document.activeElement)[0];
                        const textToCopy = activeElement?.innerText || window.getSelection();
                        event.clipboardData.setData('text/plain', textToCopy);
                        event.preventDefault();
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

