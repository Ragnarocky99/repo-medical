    region remisiones (
        name: Remisiones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_REMISION_DETALLE,
                       ID_ARTICULO,
                       ID_CLIENTE,
                       ID_MONEDA,
                       ID_REMISION,
                       ID_VENDEDOR,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       ID_LOTE,
                       ID_PEDIDO,
                       ID_PEDIDO_DETALLE,
                       ID_UNIDAD_MEDIDA,
                       ID_COTIZA_ART,
                       ID_OFERTA_LIC,
                       PRECIO_UNITARIO,
                       CANTIDAD_REMISION,
                       CANTIDAD_PENDIENTE,
                       ESTADO,
                       DESC_ARTICULO,
                       NRO_LOTE,
                       FEC_COMPROBANTE,
                       TIP_ENT_SAL,
                       SER_ENT_SAL,
                       NRO_REMISION,
                       COD_ARTICULO,
                       NRO_PEDIDO,
                       NRO_LICITACION,
                       DESC_SUCURSAL,
                       DESC_CLIENTE,
                       COD_CLIENTE,
                       NRO_OCC,
                       ID_IVA,
                       NULL CANT_A_ENTREGAR,
                       '' IND_SELECCION,
                       NRO_ITEM
                  from VTWV_FACTURAR_REMISIONES
                 where ID_EMPRESA = :P0_ID_EMPRESA AND
                ID_SUCURSAL = :P0_ID_SUCURSAL AND
                (ID_CLIENTE = :P663_CLIENTE OR :P663_CLIENTE IS NULL) AND
                (ID_VENDEDOR = :P663_VENDEDOR OR :P663_VENDEDOR IS NULL) AND
                (ID_MONEDA   = :P663_MONEDA OR :P663_MONEDA IS NULL) AND
                (NRO_OCC = :P663_NRO_OCC OR :P663_NRO_OCC IS NULL) AND
                (NRO_REMISION = :P663_NRO_REMISION OR :P663_NRO_REMISION IS NULL) AND
                FEC_COMPROBANTE BETWEEN :P663_FEC_DESDE AND :P663_FEC_HASTA AND
                NRO_LICITACION IS NULL AND
                NVL(CANTIDAD_PENDIENTE, 0) > 0
                ```
            pageItemsToSubmit: [
                P663_FEC_DESDE
                P663_FEC_HASTA
                P663_CLIENTE
                P663_NRO_OCC
                P663_VENDEDOR
                P663_NRO_REMISION
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
