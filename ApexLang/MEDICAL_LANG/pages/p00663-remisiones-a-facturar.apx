    dynamicAction obtener-vendedor (
        name: obtener vendedor
        execution {
            sequence: 190
        }
        when {
            selectionType: items
            items: P663_CLIENTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    select cl.id_vendedor, cl.id_listas_precios, nvl(cl.id_moneda_limite,32), cl.id_condicion_venta
                    into   :P663_VENDEDOR, :P663_LISTA_PRECIO, :P663_MONEDA, :P663_COND_VENTA
                    from ccw_clientes cl
                    where cl.id = :P663_CLIENTE;
                    exception
                    when no_data_found then
                     null; -- para que no se rompa cuando se carga la pantalla
                    
                     dbms_lock.sleep(0.3); --porque no hacia el refresh correctamente
                    end;
                    ```
                itemsToSubmit: P663_CLIENTE
                itemsToReturn: [
                    P663_VENDEDOR
                    P663_LISTA_PRECIO
                    P663_MONEDA
                    P663_COND_VENTA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

