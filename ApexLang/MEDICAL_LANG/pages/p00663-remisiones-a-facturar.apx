    dynamicAction cargar-total (
        name: Cargar Total
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P663_NRO_REMISION
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IF :P663_NRO_COMPROBANTE IS NOT NULL THEN
                    SELECT TOT_COMPROBANTE
                    INTO :P663_TOT_COMPROBANTE
                    FROM VTW_PEDIDOS_CABECERA
                    WHERE TIP_COMPROBANTE='PED'
                    AND  SER_COMPROBANTE='A'
                    AND  NRO_COMPROBANTE=:P663_NRO_COMPROBANTE;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el pedido');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el pedido'||sqlerrm);
                    end;
                    ```
                itemsToSubmit: P663_NRO_REMISION
                itemsToReturn: P663_TOT_COMPROBANTE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

