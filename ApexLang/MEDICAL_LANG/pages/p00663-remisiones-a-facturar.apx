    process validar-cabecera (
        name: Validar cabecera
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P663_CLIENTE is null then
                  raise_application_error(-20000, 'Debe elegir un cliente');
                end if;
                if :P663_COND_VENTA is null then
                  raise_application_error(-20000, 'Debe elegir una condicion de venta');
                end if;
                if :P663_LISTA_PRECIO is null then
                  raise_application_error(-20000, 'Elija una lista de precios');
                end if;
                if :P663_MONEDA is null then
                  raise_application_error(-20000, 'Elija una moneda');
                end if;
                if :P663_VENDEDOR is null then
                  raise_application_error(-20000, 'Elija un vendedor');
                end if;
                if :P663_LV_TALONARIOS is null then
                  raise_application_error(-20000, 'Elija un talonario');
                end if;
                if :P663_NRO_OCC is null and :REQUEST = 'Facturar' then
                  raise_application_error(-20000, 'Elija un Nro de OCC' || :P663_NRO_OCC);
                end if;
                --raise_application_error(-20000,:P663_NRO_OCC);
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 42024550065450545
        }
        serverSideCondition {
