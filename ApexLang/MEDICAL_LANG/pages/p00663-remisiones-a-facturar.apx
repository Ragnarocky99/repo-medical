    process creamos-coleccion (
        name: Creamos coleccion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF APEX_COLLECTION.collection_exists('REMISION_FACTURA') THEN
                   APEX_COLLECTION.delete_collection('REMISION_FACTURA');
                END IF ;
                
                IF NOT APEX_COLLECTION.COLLECTION_EXISTS('REMISION_FACTURA') THEN
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('REMISION_FACTURA');
                END IF;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 42024643809450546
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: Facturar,Facturar Catalogo
        }
    )

