    dynamicAction poner-grilla-modo-edicion (
        name: Poner grilla modo edicion
        execution {
            sequence: 240
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid_cat = apex.region("RemCat").call("getViews").grid;
                        grid_cat.model.setOption("editable", true);
                        grid_cat.setEditMode(true);
                    
                    var grid = apex.region("Rem").call("getViews").grid;
                        grid.model.setOption("editable", true);
                        grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

