                                       p_nro_comprobante  => :P663_NRO_COMPROBANTE,
                                       p_id_cliente       => :P663_CLIENTE,
                                       p_id_moneda        => :P663_MONEDA,
                                       p_id_vendedor      => :P663_VENDEDOR,
                                       p_id_cond_venta    => :P663_COND_VENTA, 
                                       p_id_lista_precio  => :P663_LISTA_PRECIO,
                                       p_session_id       => APEX_CUSTOM_AUTH.GET_SESSION_ID,
                                       p_id_comprobante   => :P663_ID_COMPROBANTE,
                                       p_nro_occ          => :P663_NRO_OCC);
                    
                    --raise_application_error(-20000,'hola');
                    ```
                itemsToSubmit: [
                    P663_SER_COMPROBANTE
                    P663_LV_TALONARIOS
                    P663_NRO_COMPROBANTE
                    P663_CLIENTE
                    P663_MONEDA
                    P663_VENDEDOR
