    dynamicAction colores (
        name: Colores
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action colores (
            name: Colores
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    
                    $(document).ready(function() {
                    
                      $('td[headers="ESTADO_FACT"]').each(function() {
                        var texto = $(this).text().trim(); 
                        if (texto === 'FACTURADO') {
                          $(this).css("color", "green");
                        } else if (texto === 'PENDIENTE') {
                          $(this).css("color", '#e1ad01');
                        } else if (texto === 'ANULADO') {
                          $(this).css("color", "red");
                        }
                      });
                    
                     
                      $('td[headers="EstadoRem"]').each(function() {
                        var texto = $(this).text().trim();
                        if (texto === 'REMISIONADO') {
                          $(this).css("color", "green");
                        } else if (texto === 'PENDIENTE') {
                          $(this).css("color", '#e1ad01');
                        }
                      });
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P663_FEC_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                        v_año NUMBER;
                    
                    begin
                    SELECT EXTRACT(YEAR FROM SYSDATE) INTO v_año FROM DUAL;
                    
                        if (length(:P663_FEC_COMPROBANTE_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P663_FEC_COMPROBANTE_HASTA,'/','');
                            conv_fecha := substr(:P663_FEC_COMPROBANTE_HASTA,1,2)||'/'||
                                                      substr(:P663_FEC_COMPROBANTE_HASTA,3,2)||'/'||
                                                      lpad(substr(:P663_FEC_COMPROBANTE_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P663_FEC_COMPROBANTE_HASTA := conv_fecha;
                            ELSIF (length(:P663_FEC_COMPROBANTE_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P663_FEC_COMPROBANTE_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                    
                            ELSIF (length(:P663_FEC_COMPROBANTE_HASTA) = 4) THEN
                                conv_fecha := replace(:P663_FEC_COMPROBANTE_HASTA,'/','');
                                conv_fecha := substr(:P663_FEC_COMPROBANTE_HASTA,1,2)||'/'||
                                                      substr(:P663_FEC_COMPROBANTE_HASTA,3,2) ||'/'|| v_año;
                                :P663_FEC_COMPROBANTE_HASTA := conv_fecha;
                    
                            ELSIF (length(:P663_FEC_COMPROBANTE_HASTA) = 5) THEN
                                conv_fecha := :P663_FEC_COMPROBANTE_HASTA ||'/'|| v_año;
                                :P663_FEC_COMPROBANTE_HASTA := conv_fecha;
                        end if;
                    end;
                    ```
                itemsToSubmit: P663_FEC_HASTA
                itemsToReturn: P663_FEC_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

