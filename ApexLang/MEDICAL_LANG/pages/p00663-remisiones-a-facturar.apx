    region remisiones-catalogo (
        name: Remisiones Catalogo
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: VTWV_FACTURAR_REMISIONES
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                ID_SUCURSAL = :P0_ID_SUCURSAL AND
                (ID_CLIENTE = :P663_CLIENTE OR :P663_CLIENTE IS NULL) AND
                (ID_VENDEDOR = :P663_VENDEDOR OR :P663_VENDEDOR IS NULL) AND
                (ID_MONEDA   = :P663_MONEDA OR :P663_MONEDA IS NULL) AND
                (NRO_ID_LICITACION = :P663_NRO_OCC OR :P663_NRO_OCC IS NULL) AND
                (NRO_REMISION = :P663_NRO_REMISION OR :P663_NRO_REMISION IS NULL) AND
                FEC_COMPROBANTE BETWEEN :P663_FEC_DESDE AND :P663_FEC_HASTA AND
                NRO_LICITACION IS NOT NULL
                ```
            pageItemsToSubmit: [
                P663_FEC_DESDE
                P663_FEC_HASTA
                P663_CLIENTE
                P663_NRO_OCC
                P663_VENDEDOR
                P663_NRO_REMISION
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: RemCat
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 42020720866450507
        }

