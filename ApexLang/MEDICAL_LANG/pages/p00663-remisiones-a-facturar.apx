                        ', nro occ: ' || get_value_type(:P663_NRO_OCC)
                    );
                    */
                    
                    
                    --raise_application_error(-20000,'hola');
                    genera_factura_rem(p_id_empresa       => :P0_ID_EMPRESA,
                                       p_id_sucursal      => :P0_ID_SUCURSAL,
                                       p_usuario          => :APP_USER,
