page 18 (
    name: Carga de Accesos
    alias: CARGA-DE-ACCESOS
    title: Carga de Accesos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-accesos (
        name: Carga de Accesos
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_ACCESO,
                       ID_GRUPO,
                       PAGINA_ID,
                       PERMISO,
                       PUEDE_INSERTAR,
                       PUEDE_ACTUALIZAR,
                       PUEDE_BORRAR,
                       PUEDE_CONSULTAR,
                       ID_MODULO
                  from BSW_ACCESO_POR_GRUPOS_APEX
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P18_ID_ACCESO (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-accesos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-accesos
            column: ID_ACCESO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P18_ID_GRUPO (
        type: popupLov
        label {
            label: <p>Grupo:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-grupos-usuarios
        }
        layout {
            sequence: 20
            region: @carga-de-accesos
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-accesos
            column: ID_GRUPO
            dataType: number
        }
        readOnly {
            type: itemIsNotNull
            item: P18_ID_GRUPO
        }
    )

    pageItem P18_ID_MODULO (
        type: popupLov
        label {
            label: <p>Modulo</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-modulos
        }
        layout {
            sequence: 50
            region: @carga-de-accesos
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @carga-de-accesos
            column: ID_MODULO
            dataType: varchar2
        }
        readOnly {
            type: itemIsNotNull
            item: P18_ID_ACCESO
        }
    )

    pageItem P18_PAGINA_ID (
        type: popupLov
        label {
            label: <p>Página:</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT '('||F.PAGE_NO||')'|| F.NAV_NAME AS PAGINA, 
                       F.NAV_ID 
                FROM BSW_FORMAS_PAGINAS F
                WHERE F.PAGE_NO IS NOT NULL
                  -- OR F.NAV_ID    = 1 --COMENTADO PORQUE NO ES NECESARIO Y HACE QUE LA CONDICION EXISTS NO FUNCIONE
                  AND F.ID_MODULO = :P18_ID_MODULO
                  AND F.PAGE_NO NOT IN ('22', '8')
                  /*AND EXISTS (SELECT A.PAGINA_ID
                              FROM BSW_ACCESO_POR_GRUPOS_APEX A, BSW_GRUPOS_USUARIOS G
                              WHERE A.PAGINA_ID = F.NAV_ID
                                AND A.ID_GRUPO = G.ID
                                AND G. IN (:P18_ID_GRUPO)
                                --AND G.COD_GRUPO <> 'ADMIN'
                             )*/
                ORDER BY TO_NUMBER(PAGE_NO)
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P18_ID_MODULO
            itemsToSubmit: P18_ID_MODULO
        }
        layout {
            sequence: 80
            region: @carga-de-accesos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-accesos
            column: PAGINA_ID
            dataType: number
        }
        readOnly {
            type: itemIsNotNull
            item: P18_ID_ACCESO
        }
    )

