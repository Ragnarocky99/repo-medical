page 842 (
    name: Tipo de Asistencia
    alias: TIPO-DE-ASISTENCIA
    title: Tipo de Asistencia
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var i = 0;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tipos-de-asistencia (
        name: Tipos de Asistencia
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: RHW_TIPO_NOVEDADES
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
            orderByClause: TO_NUMBER(COD_TIPO_NOVEDAD) DESC
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Cabecera
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 155071514566663840
        }

        savedReport 718083 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @FEC_ALTA
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @COD_TIPO_NOVEDAD
                layout {
                    width: 125.5
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_TIPO_NOVEDAD (
            type: numberField
            heading {
                heading: <p>Codigo</p>
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: COD_TIPO_NOVEDAD
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DESCRIPCION (
            type: textarea
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
                maxLength: 300
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column FEC_ALTA (
            type: hidden
            layout {
                sequence: 100
            }
            source {
                databaseColumn: FEC_ALTA
                dataType: date
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Tipos de Asistencia
        }
    )

    dynamicAction inicializar-grilla (
        name: Inicializar Grilla
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @tipos-de-asistencia
        }

        action cod-tipo-novedad (
            name: COD_TIPO_NOVEDAD
            action: setValue
            settings {
                type: jsExpression
                jsExpression: i
            }
            affectedElements {
                selectionType: columns
                columns: COD_TIPO_NOVEDAD
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: COD_TIPO_NOVEDAD
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: i = apex.region("Cabecera").widget().interactiveGrid("getViews", "grid").model.getTotalRecords();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process sub-categoria-flujo-de-caja-save-interactive-grid-data (
        name: Sub Categoria Flujo de Caja - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @tipos-de-asistencia
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 83268615204286392
        }
    )

)

