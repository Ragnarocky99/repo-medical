page 243 (
    name: Reportes de Entrada Salida Articulos
    alias: REPORTES-DE-ENTRADA-SALIDA-ARTICULOS
    title: Reportes de Entrada Salida Articulos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                DECLARE
                vcName PK_JRXML2PDF_TYPES.tName;
                
                l_ReportList PK_JRXML2PDF_TYPES.tReportNameList;
                
                r_Params PK_JRXML2PDF_REPGEN.TPARAMETER;
                l_Params PK_JRXML2PDF_REPGEN.TPARAMLIST;
                
                bl BLOB;
                
                BEGIN
                
                vcName := 'EntSal';
                
                r_Params.vcName := 'idcab';
                r_Params.vcValue := :P171_ID;
                l_Params(l_Params.COUNT+1) := r_Params;
                
                l_ReportList(1) := vcName;
                
                
                
                bl := PK_JRXML2PDF_REPGEN.FK_RUN(i_lReports=>l_ReportList,
                i_lParams=>l_Params,
                i_bResetPageNumber=>false
                );
                
                PK_JRXML2PDF_REPGEN.PR_SHOW_REPORT(bl);
                APEX_APPLICATION.STOP_APEX_ENGINE;
                
                END;
                ```
        }
    )

)

