    region existencia (
        name: Existencia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT AR.ID,
                       AR.ID_EMPRESA,
                       SU.DESCRIPCION AS SUCURSAL,
                       AR.COD_ARTICULO,
                       AR.COD_ORIGEN_ART AS COD_FABRICANTE,
                       AR.ID_RUBRO AS CATEGORIA_PRODUCTO,
                       AR.DESCRIPCION,
                       ar.id_marca,
                       ar.id_envase,
                       ar.id_unidad_medida,
                       LO.NRO_LOTE,
                       NVL(
                           CALCULA_SALDO_STOCK(p_id_empresa  => AR.ID_EMPRESA,
                                               p_id_articulo => AR.ID,
                                               p_id_lote     => LO.ID,
                                               p_id_sucursal => SU.ID,
                                               p_fecha       => :P684_FEC_HASTA
                           )
                       ,0) AS CANT_DISPON_SUCURSAL,
                       NVL(TRAE_COSTO_PROM(AR.ID_EMPRESA,AR.ID,:P684_FEC_HASTA),0) AS COSTO,
                       NVL(
                           ROUND(
                               TRAE_COSTO_PROM(AR.ID_EMPRESA,AR.ID,:P684_FEC_HASTA) * 
                               CALCULA_SALDO_STOCK(p_id_empresa  => AR.ID_EMPRESA,
                                                   p_id_articulo => AR.ID,
                                                   p_id_lote     => LO.ID,
                                                   p_id_sucursal => SU.ID,
                                                   p_fecha       => :P684_FEC_HASTA)
                           )
                       ,0) AS COSTO_TOTAL,
                       (select  (SELECT LISTAGG(DISTINCT PFC.NRO_COMPROBANTE_REF,CHR(13)) WITHIN GROUP (ORDER BY PFD.ID_PROFORMA_CABECERA) AS PROFORMAS
                                  FROM CMW_PROFORMAS_DETALLE  PFD
                                  JOIN CMW_PROFORMAS_CABECERA PFC ON PFC.ID = PFD.ID_PROFORMA_CABECERA
                                 WHERE PFD.NRO_OCP = PC.NRO_COMPROBANTE
                                   AND PFD.ID_ARTICULO = PD.ID_ARTICULO) AS NRO_PROFORMA
                                   
                        from cmw_pedidos_cabecera PC
                        join cmw_pedidos_detalle PD on PD.Id_Pedido_Cab = PC.ID
                        join stw_articulos A on PD.Id_Articulo = A.ID
                        left join vtw_pedidos_cabecera VPC on PD.Id_Pedido = VPC.ID
                        left join cmw_cotiza_Articulos CA on CA.Id_Articulo = PD.Id_Articulo and CA.Id_Pedido = VPC.ID and pd.id_cotiza_art = ca.id--and CA.Id_Pedido_Det = pd.id_pedido_det
                
                        WHERE  (A.ID = ar.id)
                          and rownum = 1) AS NRO_PROFORMA
                
                FROM STW_ARTICULOS AR
                JOIN STW_LOTES LO ON LO.ID_ARTICULO = AR.ID
                JOIN BSW_SUCURSALES SU ON SU.ID_EMPRESA = AR.ID_EMPRESA
                WHERE AR.ID_EMPRESA  = :P0_ID_EMPRESA
                  AND AR.COD_ARTICULO != '742' -- ARTICULO DE MIGRACION
                  AND (AR.ID = :P684_ARTICULOS OR :P684_ARTICULOS IS NULL)
                  AND (SU.ID = :P684_SUCURSAL  OR :P684_SUCURSAL  IS NULL)
                  AND NVL(
                           CALCULA_SALDO_STOCK(p_id_empresa  => AR.ID_EMPRESA,
                                               p_id_articulo => AR.ID,
                                               p_id_lote     => LO.ID,
                                               p_id_sucursal => SU.ID,
                                               p_fecha       => :P684_FEC_HASTA
                           )
                       ,0) > 0 --añadido para que solo me muestre los items con stock.
                  --AND :P684_SUCURSAL IS NOT NULL
                 -- AND (UPPER(AR.COD_ARTICULO) LIKE UPPER('%'|| :P684_ARTICULOS || '%') OR :P684_ARTICULOS IS NULL)
                ```
            pageItemsToSubmit: [
                P0_ID_EMPRESA
                P684_SUCURSAL
                P684_ARTICULOS
            ]
        }
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
