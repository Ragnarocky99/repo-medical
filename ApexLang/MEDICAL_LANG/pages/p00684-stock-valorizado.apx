    dynamicAction agregar-paginacion (
        name: Agregar paginacion
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @existencia
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction convert-fec-desde (
        name: CONVERT_FEC_DESDE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P684_FEC_DESDE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P684_FEC_DESDE) = 8) then
                    
                            conv_fecha := replace(:P684_FEC_DESDE,'/','');
                            conv_fecha := substr(:P684_FEC_DESDE,1,2)||'/'||
                                                      substr(:P684_FEC_DESDE,3,2)||'/'||
                                                      lpad(substr(:P684_FEC_DESDE,5,4),4,'0');
                    
                        :P684_FEC_DESDE := conv_fecha;
                            ELSIF (length(:P684_FEC_DESDE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P684_FEC_DESDE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P684_FEC_DESDE
                itemsToReturn: P684_FEC_DESDE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @existencia
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fec-hasta (
        name: CONVERT_FEC_HASTA
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P684_FEC_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P684_FEC_HASTA) = 8) then
                    
                            conv_fecha := replace(:P684_FEC_HASTA,'/','');
                            conv_fecha := substr(:P684_FEC_HASTA,1,2)||'/'||
                                                      substr(:P684_FEC_HASTA,3,2)||'/'||
                                                      lpad(substr(:P684_FEC_HASTA,5,4),4,'0');
                    
                        :P684_FEC_HASTA := conv_fecha;
                            ELSIF (length(:P684_FEC_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P684_FEC_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P684_FEC_HASTA
                itemsToReturn: P684_FEC_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

