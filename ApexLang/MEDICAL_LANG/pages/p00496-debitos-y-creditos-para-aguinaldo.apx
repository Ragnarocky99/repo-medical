    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P496_FEC_DEBCRED
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P496_FEC_DEBCRED) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P496_FEC_DEBCRED,'/','');
                            conv_fecha := substr(:P496_FEC_DEBCRED,1,2)||'/'||
                                                      substr(:P496_FEC_DEBCRED,3,2)||'/'||
                                                      lpad(substr(:P496_FEC_DEBCRED,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P496_FEC_DEBCRED := conv_fecha;
                            ELSIF (length(:P496_FEC_DEBCRED) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P496_FEC_DEBCRED) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P496_FEC_DEBCRED
                itemsToReturn: P496_FEC_DEBCRED
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction lose-focus (
        name: LOSE FOCUS
        execution {
            sequence: 30
        }
        when {
            event: focusout
            selectionType: items
            items: P496_FEC_DEBCRED
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P496_ID_SUCURSAL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-fechas (
        name: Setear Fechas
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :p496_mes_desde   := to_char(sysdate,'MM');
                    :p496_mes_hasta   := to_char(sysdate,'MM');
                    :p496_anio        := to_char(sysdate, 'yyyy');
                    :p496_fec_debcred := sysdate;
                    ```
                itemsToSubmit: [
                    P496_FEC_DEBCRED
                    P496_MES_DESDE
                    P496_MES_HASTA
                    P496_ANIO
                ]
                itemsToReturn: [
                    P496_FEC_DEBCRED
                    P496_MES_DESDE
                    P496_MES_HASTA
                    P496_ANIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    process borrar (
        name: BORRAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  delete rhw_debcred d
                   where id_empresa = :P0_ID_empresa  
                     and id_concepto in ( :P496_conc_aguin, :P496_conc_ant_ag )
                     and nro_liquid_afecto is null
                     and to_char( fec_debcred, 'MM/YYYY') = to_char( :P496_fec_debcred,'MM/YYYY');
                exception
                  when others then
                       null ;
                end ;
                commit ;
                apex_application.g_print_success_message := 'Proceso de borrado concluido' ;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 63596993305935209
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process ejecutar (
        name: EJECUTAR
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 begin
                  genera_aguinaldo(:P0_ID_EMPRESA, :P496_ID_EMPLEADO, :P496_ID_SUCURSAL, :P496_TIP_LIQUID, :P496_FEC_DEBCRED,
                  :P496_ID_CENTRO_PAGO, :P496_MES_HASTA, :P496_ANIO, :P496_MES_DESDE, :P496_ID_PLANILLA, :P496_PROCESA, 
                  :P496_CONC_AGUIN, :P496_AGREGA, :P496_TIPO, :P496_ANTICIPO, :P496_CONC_ANT_AG, :P496_COD_USUARIO_AUD);
                 --exception
                 	--when others then
                 	--	RAISE_APPLICATION_ERROR(-20000, 'Error al ejecutar proceso');
                 end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 60476090581735343
        }
        serverSideCondition {
            whenButtonPressed: @execute
        }
    )

    process limpiar (
        name: LIMPIAR
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 63597423629935214
        }
        serverSideCondition {
            type: never
        }
    )

    process parametros (
        name: PARAMETROS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 :P496_conc_aguin      := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_Busca_parametro( 'RH', 'RH_CONC_AGUIN' ));
                  :P496_conc_ant_ag     := TRAE_ID_CONCEPTO_RRHH(:P0_ID_EMPRESA, W_Busca_parametro( 'RH', 'RH_CONC_ANT_AG' ));
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 63596816189935208
        }
    )

)

