page 415 (
    name: Carga de  Monedas Facturación Electrónica
    alias: CARGA-DE-MONEDAS-FACTURACIÓN-ELECTRÓNICA
    title: Carga de  Monedas Facturación Electrónica
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-monedas-facturación-electrónicas (
        name: "Carga de monedas facturación electrónicas "
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_MONEDA,
                       DESCRIPCION
                  from FEW_MONEDAS
                
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P415_COD_MONEDA (
        type: textField
        label {
            label: <p>Cod Moneda: </p>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-monedas-facturación-electrónicas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-monedas-facturación-electrónicas
            column: COD_MONEDA
            dataType: varchar2
        }
    )

    pageItem P415_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: </p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-monedas-facturación-electrónicas
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @carga-de-monedas-facturación-electrónicas
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P415_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-monedas-facturación-electrónicas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-monedas-facturación-electrónicas
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P415_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P415_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P415_ID
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 23566112560800207
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-monedas-facturación-electrónica (
        name: Initialize form Carga de  Monedas Facturación Electrónica
        type: formInitialization
        formRegion: @carga-de-monedas-facturación-electrónicas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22654099499125642
        }
    )

    process process-form-carga-de-monedas-facturacion-electronica (
        name: Process form Carga de Monedas Facturacion electronica
        type: formAutoRowProcessing
        formRegion: @carga-de-monedas-facturación-electrónicas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 23566034137800206
        }
    )

)

