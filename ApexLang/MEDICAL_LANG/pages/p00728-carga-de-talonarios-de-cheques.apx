page 728 (
    name: Carga de Talonarios de Cheques
    alias: CARGA-DE-TALONARIOS-DE-CHEQUES
    title: Carga de Talonarios de Cheques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-talonarios-de-cheques (
        name: Carga de Talonarios de Cheques
        type: form
        source {
            location: localDatabase
            tableName: CCW_TALONARIOS_CHEQUES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P728_ACTIVO (
        type: checkbox
        label {
            label: Activo
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 100
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: ACTIVO
            dataType: varchar2
        }
        readOnly {
            type: expression
            plsqlExpression: W_BUSCA_PERMISO(:P0_ID_EMPRESA, :APP_PAGE_ID, TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER),'PERMITE_INACTIVAR_CHEQUES') = 'N'
        }
    )

    pageItem P728_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 120
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
    )

    pageItem P728_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P728_ID_CUENTA_BANCARIA (
        type: popupLov
        label {
            label: Cuenta Bancaria
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @ccw-cuentas-bancarias-talon
        }
        layout {
            sequence: 30
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: ID_CUENTA_BANCARIA
            dataType: number
        }
    )

    pageItem P728_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: P0_ID_EMPRESA
        }
    )

    pageItem P728_NRO_TALONARIO (
        type: numberField
        label {
            label: Nro Talonario
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: NRO_TALONARIO
            dataType: number
        }
    )

    pageItem P728_NUMERO_FINAL (
        type: numberField
        label {
            label: Numero Final
            alignment: left
        }
        layout {
            sequence: 80
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: NUMERO_FINAL
            dataType: number
        }
    )

    pageItem P728_NUMERO_INICIAL (
        type: numberField
        label {
            label: Numero Inicial
            alignment: left
        }
        layout {
            sequence: 70
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: NUMERO_INICIAL
            dataType: number
        }
    )

    pageItem P728_SERIE (
        type: textField
        label {
            label: Serie
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: SERIE
            dataType: varchar2
        }
    )

    pageItem P728_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Vista;V,Diferido;D
        }
        layout {
            sequence: 90
            region: @carga-de-talonarios-de-cheques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @carga-de-talonarios-de-cheques
            column: TIPO
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P728_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Eliminar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P728_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Guardar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P728_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation control (
        name: Control
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P728_NUMERO_FINAL >= :P728_NUMERO_INICIAL
            alwaysExecute: true
        }
        error {
            errorMessage: El número final no puede ser menor al número inicial
            associatedItem: @P728_NUMERO_FINAL
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 70890026262710290
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-talonarios-de-cheques (
        name: Initialize form Carga de Talonarios de Cheques
        type: formInitialization
        formRegion: @carga-de-talonarios-de-cheques
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 70889256723710289
        }
    )

    process process-form-carga-de-talonarios-de-cheques (
        name: Process form Carga de Talonarios de Cheques
        type: formAutoRowProcessing
        formRegion: @carga-de-talonarios-de-cheques
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 70889602768710290
        }
    )

)

