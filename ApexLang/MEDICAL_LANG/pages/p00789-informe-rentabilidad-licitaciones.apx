    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P789_ID_ARTICULO
                P789_NRO_LICITACION
                P789_NRO_ID_LICITACION
                P789_ID_CLIENTE
                P789_NRO_ITEM
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rentabilidad
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rentabilidad
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

