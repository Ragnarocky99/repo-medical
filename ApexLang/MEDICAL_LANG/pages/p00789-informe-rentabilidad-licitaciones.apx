            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region rentabilidad (
        name: Rentabilidad
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LCWV_INFORME_RENTABILIDAD
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (FEC_NOTA_ENTREGA BETWEEN :P789_FEC_INI_NE AND :P789_FEC_FIN_NE OR
                 FEC_FACTURA BETWEEN :P789_FEC_INI_FAC AND :P789_FEC_FIN_FAC) AND
                (NRO_ID_LICITACION = :P789_NRO_ID_LICITACION OR :P789_NRO_ID_LICITACION IS NULL) AND
                (NRO_LICITACION = :P789_NRO_LICITACION OR :P789_NRO_LICITACION IS NULL) AND
                (ID_CLIENTE = :P789_ID_CLIENTE OR :P789_ID_CLIENTE IS NULL) AND
                (ID_ARTICULO = :P789_ID_ARTICULO OR :P789_ID_ARTICULO IS NULL) AND
                (NRO_ITEM = :P789_NRO_ITEM OR :P789_NRO_ITEM IS NULL)
                ```
            pageItemsToSubmit: [
                P789_FEC_INI_NE
                P789_FEC_FIN_NE
                P789_FEC_INI_FAC
                P789_FEC_FIN_FAC
                P789_NRO_LICITACION
                P789_NRO_ID_LICITACION
                P789_ID_ARTICULO
                P789_ID_CLIENTE
                P789_NRO_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 48923176108971535
        }

