    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction grilla-modo-edicion (
        name: Grilla modo edicion
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                        grid.model.setOption("editable", true);
                        grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refrescar-grilla (
        name: Refrescar Grilla
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comprobantes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process comprobantes-save-interactive-grid-data (
        name: Comprobantes - Save Interactive Grid Data
        type: executeCode
        editableRegion: @comprobantes
        source {
            plsqlCode:
                ```plsql
                IF :ANULADO = 'S' THEN
                    CASE :TIPO
                        WHEN 'REM' THEN
                            UPDATE STW_ENTSAL_CAB
                               SET ESTADO = 'A'
                             WHERE ID = :ID_REGISTRO;
                            
                            UPDATE STW_ENTSAL_DET D
                               SET D.ESTADO = 'A'
                             WHERE D.ID_ENTSAL_CAB = :ID_REGISTRO
                               AND D.ID_APROBACION_LIC IS NOT NULL;
                        ELSE
                            UPDATE VTW_COMPROBANTES_CABECERA
                               SET ESTADO = 'A'
                             WHERE ID = :ID_REGISTRO;
                    END CASE;
                END IF;
                
                IF :ANULADO = 'N' THEN
                    CASE :TIPO
                        WHEN 'REM' THEN
                            UPDATE STW_ENTSAL_CAB
                               SET ESTADO = 'N'
                             WHERE ID = :ID_REGISTRO;
                        UPDATE STW_ENTSAL_DET D
                               SET D.ESTADO = 'N'
                             WHERE D.ID_ENTSAL_CAB = :ID_REGISTRO
                               AND D.ID_APROBACION_LIC IS NOT NULL;
                        ELSE
                            UPDATE VTW_COMPROBANTES_CABECERA
                               SET ESTADO = 'P'
                             WHERE ID = :ID_REGISTRO;
                    END CASE;
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 71880345296216525
        }
    )

)

