    title: Anulacion de Comprobantes (Interno)
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region comprobantes (
        name: Comprobantes
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: FEWV_COMPROBANTES
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FECHA BETWEEN :P833_FEC_INI AND :P833_FEC_FIN AND
                (SERIE = :P833_SERIE OR :P833_SERIE IS NULL) AND
                (NUMERO = :P833_NUMERO OR :P833_NUMERO IS NULL) AND
                (SERIE||'-'||LPAD(NUMERO, 7, '0') = :P833_NRO_COMPROBANTE OR :P833_NRO_COMPROBANTE IS NULL)
                ```
            orderByClause: FECHA DESC, TIPO, SERIE, NUMERO DESC
            pageItemsToSubmit: [
                P833_FEC_INI
                P833_FEC_FIN
                P833_SERIE
                P833_NUMERO
                P833_NRO_COMPROBANTE
            ]
        }
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: [
