    computation p483-cod-grupo-comision (
        itemName: P483_COD_GRUPO_COMISION
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: select  nvl( max( cod_grupo_comision ), 0 ) + 1 from FVW_GRUPOS_COMISION where id_empresa = :P0_ID_EMPRESA
        }
        serverSideCondition {
            type: itemIsNull
            item: P483_ID
        }
    )

