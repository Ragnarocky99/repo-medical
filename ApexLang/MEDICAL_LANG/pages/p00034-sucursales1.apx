page 34 (
    name: Sucursales
    alias: SUCURSALES1
    title: Sucursales - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region sucursales (
        name: Sucursales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_SUCURSAL,
                       DESCRIPCION,
                       ES_MATRIZ,
                       CASE ES_MATRIZ
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ES_MATRIZ_ICON,
                       ESTADO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       CASILLA_CORREO,
                       CODIGO_POSTAL,
                       DETALLE_DIR,
                       TRABAJA_DOM,
                       CASE TRABAJA_DOM
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END TRABAJA_DOM_ICON,
                       TRABAJA_SAB,
                       CASE TRABAJA_SAB
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END TRABAJA_SAB_ICON,
                       ID_PAIS,
                       ID_PROVINCIA,
                       ID_CIUDAD,
                       ID_BARRIO,
                       MANEJA_STOCK,
                       PLAZO_ENVIO,
                       DIRECCION,
                       COD_USUARIO_AUD,
                       KILOMETRAJE,
                       ID_SUCURSAL_CENTRAL,
                       ID_CUSTODIO_INI,
                       NRO_PATRONAL,
                       STOCK_PROPIO,
                       IND_UM_DEF,
                       RETIENE_RENTA,
                       ORDEN,
                       DIRECCION_IP,
                       ID_CENTRO_COSTO,
                       IND_STOCK_AUTO,
                       IND_CENTRO_DISTRIBUCION,
                       IND_NO_VER_STOCK,
                       TELEFONO,
                       MOVIL,
                       IND_SUCURSAL_CENTRAL,
                       LIMITE_CREDITO,
                       ID_ENCARGADO,
                       ID_SUCURSAL_ANTERIOR,
                       COD_SUCURSAL_ANTERIOR,
                       IND_DEPOSITO_AUX,
                       LOGO_COMPROBANTE,
                       LOGO_REPORTE
                  from BSW_SUCURSALES
                  WHERE ID_EMPRESA=:P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 35
                items: {
                    P35_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 9975743900767885
        }

