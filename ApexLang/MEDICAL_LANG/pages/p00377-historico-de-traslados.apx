page 377 (
    name: Historico de Traslados
    alias: HISTORICO-DE-TRASLADOS
    title: Historico de Traslados
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region histórico-de-traslados (
        name: Histórico de Traslados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID,
                ID_EMPLEADO,
                FEC_TRASLADO,
                ID_SUCURSAL_ANT,
                ID_CENTRO_PAGO_ANT,
                ID_SECCION_ANT,
                ID_SUCURSAL_ACT,
                ID_CENTRO_PAGO_ACT,
                ID_SECCION_ACT
                FROM RHW_HIST_TRASLADOS
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                ORDER BY ID DESC;
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 378
                items: {
                    P378_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 21728449971810827
        }

        column FEC_TRASLADO (
            type: plainText
            heading {
                heading: Fecha Traslado
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_CENTRO_PAGO_ACT (
            type: plainTextBasedOnLov
            heading {
                heading: Centro Pago Actual
                alignment: center
            }
            lov {
                lov: @lv-centros-pagos
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_CENTRO_PAGO_ANT (
            type: plainTextBasedOnLov
            heading {
                heading: Centro Pago Anterior
                alignment: center
            }
            lov {
                lov: @lv-centros-pagos
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ID_EMPLEADO (
            type: plainTextBasedOnLov
            heading {
                heading: Empleado
                alignment: center
            }
            lov {
                lov: @lv-empleados
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_SECCION_ACT (
            type: plainTextBasedOnLov
            heading {
                heading: Sección Actual
                alignment: center
            }
            lov {
                lov: @lv-secciones
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ID_SECCION_ANT (
            type: plainTextBasedOnLov
            heading {
                heading: Sección Anterior
                alignment: center
            }
            lov {
                lov: @lv-secciones
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_SUCURSAL_ACT (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal Actual
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID_SUCURSAL_ANT (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal Anterior
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Histórico de Traslados
        }

        savedReport 221960 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FEC_TRASLADO (
                sequence: 3
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_CENTRO_PAGO_ACT (
                sequence: 8
            )

            displayColumn ID_CENTRO_PAGO_ANT (
                sequence: 5
            )

            displayColumn ID_EMPLEADO (
                sequence: 2
            )

            displayColumn ID_SECCION_ACT (
                sequence: 9
            )

            displayColumn ID_SECCION_ANT (
                sequence: 6
            )

            displayColumn ID_SUCURSAL_ACT (
                sequence: 7
            )

            displayColumn ID_SUCURSAL_ANT (
                sequence: 4
            )

        )

    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 10
            region: @histórico-de-traslados
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 378
                items: {
                    P378_ID: &P378_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @histórico-de-traslados
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @histórico-de-traslados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

