page 8 (
    name: Paginas
    alias: PAGINAS
    title: Paginas - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            main::before {
            
              width: 0px;
            
            }
            
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region paginas (
        name: Paginas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select LEVEL,
                       NAV_NAME,
                       PAGE_NO,
                       PARENT_ID,
                       NAV_ID,
                       ICON_IMG,
                       ID_MODULO,
                       TIPO,
                       TIPO_PAGINA,
                       ORDEN
                       
                  from BSW_FORMAS_PAGINAS
                  WHERE PAGE_NO IS NOT NULL
                  AND (ID_MODULO=:P8_MODULO OR :P8_MODULO IS NULL)
                  AND (TIPO_PAGINA=:P8_TIPO OR :P8_TIPO IS NULL)
                  AND (PAGE_NO=:P8_PAGINA OR :P8_PAGINA IS NULL)
                  START WITH PARENT_ID IS NULL
                CONNECT BY PRIOR  NAV_ID=PARENT_ID
                ORDER BY ID_MODULO ASC;
                ```
            pageItemsToSubmit: [
                P8_MODULO
                P8_TIPO
                P8_PAGINA
            ]
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: zebra
        }
        link {
            linkColumn: customTarget
            target: {
                page: 9
                items: {
                    P9_NAV_ID: \#NAV_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5582200187866007
        }

        column ICON_IMG (
            type: plainText
            heading {
                heading: Ícono
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                         <span class="fa #ICON_IMG#" style="color: blue;"></span> 
                         <span class="dm-IRR-iconLabel">#ICON_IMG#</span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: G
            }
            security {
                authorizationScheme: @derechos-consultar
            }
        )

        column ID_MODULO (
            type: plainTextBasedOnLov
            heading {
                heading: Modulo
                alignment: center
            }
            lov {
                lov: @lv-modulos
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column LEVEL (
            type: plainText
            heading {
                heading: Level
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
            security {
                authorizationScheme: @derechos-consultar
            }
        )

        column NAV_ID (
            type: hidden
            heading {
                heading: Nav ID
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column NAV_NAME (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: Nombre
                endUserAlias: C
            }
            security {
                authorizationScheme: @derechos-consultar
            }
        )

        column ORDEN (
            type: plainText
            heading {
                heading: Orden
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
            security {
                authorizationScheme: @derechos-consultar
            }
        )

        column PAGE_NO (
            type: plainTextBasedOnLov
            heading {
                heading: Página
            }
            lov {
                lov: @lv-paginas
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            security {
                authorizationScheme: @derechos-consultar
            }
        )

        column PARENT_ID (
            type: hidden
            heading {
                heading: Parent ID
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPO (
            type: hidden
            heading {
                heading: Tipo
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column TIPO_PAGINA (
            type: plainTextBasedOnLov
            heading {
                heading: Tipo Página
            }
            lov {
                lov: @lv-tipos-formas
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
            security {
                authorizationScheme: @derechos-consultar
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                PÁGINAS
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        columnHeadings {
            backgroundColor: #ffffff
        }
        pageFooter {
            alignment: start
            pageFooterText:
                ```
                USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
                
                ```
        }

        savedReport 55882 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ICON_IMG (
                sequence: 4
            )

            displayColumn ID_MODULO (
                sequence: 2
            )

            displayColumn NAV_NAME (
                sequence: 1
            )

            displayColumn ORDEN (
                sequence: 6
            )

            displayColumn PAGE_NO (
                sequence: 3
            )

            displayColumn TIPO_PAGINA (
                sequence: 5
            )

        )

    )

    region ruta-de-navegación (
        name: Ruta de Navegación
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P8_MODULO (
        type: popupLov
        label {
            label: <p>Módulo: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-modulos
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    pageItem P8_PAGINA (
        type: popupLov
        label {
            label: <p>Página: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-paginas
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    pageItem P8_TIPO (
        type: popupLov
        label {
            label: <p>Tipo: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-tipos-formas
            nullDisplayValue: --SIN SELECCIONAR--
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @paginas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                clearCache: 9
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button filtrar (
        buttonName: Filtrar
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @paginas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @paginas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P8_MODULO
                P8_TIPO
                P8_PAGINA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @paginas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17180359232882104
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

