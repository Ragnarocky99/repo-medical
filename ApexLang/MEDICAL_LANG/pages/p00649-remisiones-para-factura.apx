            plsqlCode:
                ```plsql
                DECLARE 
                TMP_REMISIONES VARCHAR2(100):= 'TMP_REMISIONES';
                
                BEGIN
                /*iF NVL(:AUTORIZAR,'N') = 'S' THEN
                   INSERT INTO VTW_COMPROBANTES_CABECERA_REM (ID_COMPROBANTE,ID_COMPROBANTE_REF) 
                   VALUES (:P649_ID_FACTURA,:ID);
                
                END IF;
                   EXCEPTION
                    WHEN OTHERS THEN
                     RAISE_APPLICATION_ERROR(-20000,'Error al relacionar los comprobantes: '||sqlerrm);*/
                IF NVL(:AUTORIZAR,'N') = 'S' THEN
                     apex_collection.add_member (p_collection_name      => TMP_REMISIONES,
                
                     p_c001                 => :ID);
                END IF;     
                END;
                ```
        }
        execution {
