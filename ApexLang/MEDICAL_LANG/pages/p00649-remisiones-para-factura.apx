    region remisiones-para-factura (
        name: Remisiones para factura
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.id, a.num_ent_sal, a.SER_ENT_SAL, P.NOMBRE, a.TOT_COSTO, A.ID_CLIENTE,A.NRO_OCC
                from stw_entsal_cab A,
                     BSW_PERSONAS   P,
                     CCW_CLIENTES   C
                where tip_ent_sal = 'REM'
                  and a.ID_CLIENTE = C.ID(+)
                  AND C.ID_PERSONA = P.ID(+)
                  AND (a.ID,a.ser_ent_sal,a.num_ent_sal) NOT IN (select D.ID_REMISION, D.SER_REF_REM, D.NRO_REF_REM
                                                                   from VTW_COMPROBANTES_DETALLE D
                                                                  WHERE D.CANTIDAD_REMISIONADA IS NOT NULL)
                  /*and (a.tip_ent_sal,a.ser_ent_sal,a.num_ent_sal) not in (select c.tip_comprobante_ref,c.ser_comprobante_ref,c.nro_comprobante_ref
                                                                                from vtw_comprobantes_cabecera c
                                                                               where c.tip_comprobante_ref = 'REM')*/
                
                  --and a.id_cliente = :P135_ID_CLIENTE---:pagina.id_cliente
                  /*and not exists (select 1
                                  from vtw_comprobantes_cabecera_rem
                                  where id_comprobante_ref = a.id)*/
                  and a.id_cliente = :P649_ID_CLIENTE
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 52007617789002418
        }

