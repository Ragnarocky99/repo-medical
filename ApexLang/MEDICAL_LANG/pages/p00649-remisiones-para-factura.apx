    dynamicAction cargar-seleccionados (
        name: Cargar Seleccionados
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                      OPEN l_cursor FOR
                    select A.COD_ARTICULO,
                           D.ID_ARTICULO,
                           D.CANTIDAD,
                           D.COSTO_C_IVA,
                           0 MONTO_TOTAL,  -----
                           0 TOTAL_IVA,----
                           0 PORC_DESCUENTO, -----
                           D.ID_IVA,
                           D.ID_LOTE,
                           D.TOTAL_COSTO,
                           D.DESC_ARTICULO,
                           C.NRO_OCC,
                           D.CANTIDAD CANTIDAD_REMISIONADA,
                           D.ID_PEDIDO_DETALLE,
                           C.ID,
                           C.SER_ENT_SAL,
                           C.NUM_ENT_SAL
                    
                      from STW_ENTSAL_CAB C,
                           STW_ENTSAL_DET D,
                           STW_ARTICULOS A
                    where  C.ID = D.ID_ENTSAL_CAB 
                      AND  D.ID_ENTSAL_CAB = :ID
                      AND  D.ID_ARTICULO = A.ID;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P649_JSON_DETALLE:=JSON_DETALLE;
                      EXCEPTION
                      WHEN OTHERS THEN  
                      NULL;
                    
                    END;
                    ```
                itemsToSubmit: P649_ID_FACTURA
                itemsToReturn: P649_JSON_DETALLE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P649_JSON_DETALLE'));
                    
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    if((json_detalle.DETALLE[i].COD_ARTICULO!=null)){
                    $model.setValue($newRecord, "COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_ARTICULO!=null)){
                    $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD).toString());
                    }
                    if((json_detalle.DETALLE[i].COSTO_C_IVA!=null)){
                    $model.setValue($newRecord, "PRECIO_UNITARIO",(json_detalle.DETALLE[i].COSTO_C_IVA).toString());
                    }
                    if((json_detalle.DETALLE[i].MONTO_TOTAL!=null)){
                    $model.setValue($newRecord, "MONTO_TOTAL",(json_detalle.DETALLE[i].MONTO_TOTAL).toString());
                    }
                    if((json_detalle.DETALLE[i].TOTAL_IVA!=null)){
                    $model.setValue($newRecord, "TOTAL_IVA",(json_detalle.DETALLE[i].TOTAL_IVA).toString());
                    }
                    if((json_detalle.DETALLE[i].PORC_DESCUENTO!=null)){
                    $model.setValue($newRecord, "PORC_DESCUENTO",(json_detalle.DETALLE[i].PORC_DESCUENTO).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_IVA!=null)){
                    $model.setValue($newRecord, "IVA",(json_detalle.DETALLE[i].ID_IVA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_LOTE!=null)){
                    $model.setValue($newRecord, "ID_LOTE",(json_detalle.DETALLE[i].ID_LOTE).toString());
                    }
                    if((json_detalle.DETALLE[i].TOTAL_COSTO!=null)){
                    $model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].TOTAL_COSTO).toString());
                    }
                    if((json_detalle.DETALLE[i].DESC_ARTICULO!=null)){
                    $model.setValue($newRecord, "DESC_ARTICULO",(json_detalle.DETALLE[i].DESC_ARTICULO).toString());
                    }
                    if((json_detalle.DETALLE[i].CANTIDAD_REMISIONADA!=null)){
                    $model.setValue($newRecord, "CANTIDAD_REMISIONADA",(json_detalle.DETALLE[i].CANTIDAD_REMISIONADA).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_PEDIDO_DETALLE!=null)){
                    $model.setValue($newRecord, "ID_PEDIDO_DETALLE",(json_detalle.DETALLE[i].ID_PEDIDO_DETALLE).toString());
                    }
                    if((json_detalle.DETALLE[i].ID!=null)){
                    $model.setValue($newRecord, "ID",(json_detalle.DETALLE[i].ID).toString());
                    }
                    if((json_detalle.DETALLE[i].SER_ENT_SAL!=null)){
                    $model.setValue($newRecord, "SER_ENT_SAL",(json_detalle.DETALLE[i].SER_ENT_SAL).toString());
                    }
                    if((json_detalle.DETALLE[i].NUM_ENT_SAL!=null)){
                    $model.setValue($newRecord, "NUM_ENT_SAL",(json_detalle.DETALLE[i].NUM_ENT_SAL).toString());
                    }
                    
                    }
                    
                    }
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

