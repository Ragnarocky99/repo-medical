    dynamicAction cargar-datos-proveedor (
        name: Cargar Datos Proveedor
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P7_ID_PROVEEDOR
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nombre_proveedor  BSW_PERSONAS.NOMBRE%TYPE;
                    BEGIN
                    select ltrim(p.nombre) nombre
                    INTO v_nombre_proveedor
                     from bsw_personas p, cmw_proveedores v 
                     where v.id_empresa = :P0_COD_EMPRESA
                     and v.id_persona = p.ID 
                     AND V.ID=:P7_ID_PROVEEDOR;
                    RETURN v_nombre_proveedor;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    return null;
                    when others then
                    raise_application_error(-20000,'Error en la tabla de proveedores'||sqlerrm);
                    return null;
                    END;
                    ```
                itemsToSubmit: P7_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P7_NOM_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT EXENTO 
                    FROM CMW_PROVEEDORES
                    WHERE ID=:P7_ID_PROVEEDOR
                    ```
                itemsToSubmit: P7_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P7_IND_EXENTO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    V_CONDICION_COMPRA  VARCHAR2(10);
                    BEGIN
                    select V.ID_CONDICION_COMPRA
                    INTO V_CONDICION_COMPRA
                     from cmw_proveedores v 
                     where v.id_empresa = :P0_COD_EMPRESA
                     AND V.ID=:P7_ID_PROVEEDOR;
                    RETURN V_CONDICION_COMPRA;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    return '61';
                    when others then
                    raise_application_error(-20000,'Error en la tabla de proveedores'||sqlerrm);
                    return null;
                    END;
                    ```
                itemsToSubmit: P7_ID_PROVEEDOR
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P7_ID_CONDICION_COMPRA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 250
        }
        when {
            selectionType: items
            items: P7_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P7_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P7_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P7_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P7_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P7_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P7_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P7_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P7_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

