                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND ID=:P0_COD_SUCURSAL
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P7_ID
        }
    )

    computation p7-iva (
        itemName: P7_IVA_5
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_PEDIDOS_DETALLE
                    WHERE :P7_ID=ID_PEDIDO_CAB;
                    item_detalle CMW_PEDIDOS_DETALLE%rowtype;
                    v_total_iva_5    CMW_PEDIDOS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ID
        }
    )

    computation p7-iva-2 (
        itemName: P7_IVA_10
        execution {
            sequence: 80
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_PEDIDOS_DETALLE
                    WHERE :P7_ID=ID_PEDIDO_CAB;
                    item_detalle CMW_PEDIDOS_DETALLE%rowtype;
                    v_total_iva_10    CMW_PEDIDOS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_iva_10:=v_total_iva_10+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_10;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ID
        }
    )

    computation p7-nro-comprobante (
        itemName: P7_NRO_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P7_NRO_COMPROBANTE IS  NULL THEN
                SELECT NVL(MAX(NRO_COMPROBANTE),0)+1
                INTO v_nro_comprobante
                FROM
                CMW_PEDIDOS_CABECERA 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P7_SER_COMPROBANTE=SER_COMPROBANTE
                AND :P7_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P7_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
        comments {
            comments: "Calculo para calcular el nro comprobante a guardarse si es qque no se escribio un numero de manera manual "
        }
    )

    computation p7-subtotal (
        itemName: P7_SUBTOTAL
        execution {
            sequence: 60
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_cabecera IS SELECT * FROM CMW_PEDIDOS_CABECERA
                    WHERE :P7_ID=ID;
                    item_cabecera CMW_PEDIDOS_CABECERA%rowtype;
                    v_subtotal   CMW_PEDIDOS_CABECERA.TOT_COMPROBANTE%TYPE:=0;
                BEGIN
                  OPEN cursor_CABECERA;
                  LOOP
                    FETCH cursor_cabecera INTO item_cabecera;
                    EXIT WHEN cursor_cabecera%NOTFOUND;
                    v_subtotal:=nvl(item_cabecera.tot_comprobante,0)-nvl(item_cabecera.tot_iva,0);
                  END LOOP;
                  CLOSE cursor_cabecera;
                  RETURN v_subtotal;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ID
        }
    )

    computation p7-tot-gravadas (
        itemName: P7_TOT_GRAVADAS
        execution {
            sequence: 40
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: NVL(REPLACE(:P7_TOT_GRAVADAS_10,'.',''),0)+NVL(REPLACE(:P7_TOT_GRAVADAS_5,'.',''),0)
        }
        comments {
            comments: "Metodo para calcular las gravadas de la factura "
        }
    )

    computation p7-tot-gravadas-2 (
        itemName: P7_TOT_GRAVADAS_10
        execution {
            sequence: 40
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_PEDIDOS_DETALLE
                    WHERE :P7_ID=ID_PEDIDO_CAB;
                    item_detalle CMW_PEDIDOS_DETALLE%rowtype;
                    v_total_gravadas_10    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_gravadas_10:=v_total_gravadas_10+item_detalle.monto_total;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_gravadas_10;
                  EXCEPTION WHEN 
                  OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ID
        }
    )

    computation p7-tot-gravadas-3 (
        itemName: P7_TOT_GRAVADAS_5
        execution {
            sequence: 50
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_PEDIDOS_DETALLE
                    WHERE :P7_ID=ID_PEDIDO_CAB;
                    item_detalle CMW_PEDIDOS_DETALLE%rowtype;
