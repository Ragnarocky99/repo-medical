    dynamicAction abrir-lista-de-valores (
        name: Abrir Lista de Valores
        execution {
            sequence: 180
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_ART_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction after-dialog-close (
        name: AFTER DIALOG CLOSE
        execution {
            sequence: 200
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @orden-de-compra-proveedor-ocp
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P7_ID_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction auditoría-anulación-ocp (
        name: Auditoría Anulación OCP
        execution {
            sequence: 300
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ANULADO
        }

        action set-cantidad (
            name: Set Cantidad
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vcantidad number;
                    BEGIN
                        IF NVL(:ANULADO, 'N') = 'S' THEN
                            vcantidad := :CANTIDAD;
                        ELSE
                            vcantidad := null;
                        END IF;
                        RETURN vcantidad;
                    END;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    ANULADO
                ]
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_ANULADA
            }
            execution {
                sequence: 30
            }
        )

        action set-fecha (
            name: Set Fecha
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vfecha date;
                    BEGIN
                        IF NVL(:ANULADO, 'N') = 'S' THEN
                            vfecha := sysdate;
                        ELSE
                            vfecha := null;
                        END IF;
                        RETURN vfecha;
                    END;
                    ```
                itemsToSubmit: ANULADO
                escapeSpecialChars: false
            }
            affectedElements {
