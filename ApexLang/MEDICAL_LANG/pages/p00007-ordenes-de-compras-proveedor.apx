                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detalles
        }
    )

    region orden-de-compra-proveedor-ocp (
        name: Orden de Compra Proveedor - OCP
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_SUCURSAL,
                       FEC_COMPROBANTE,
                       ID_PROVEEDOR,
                       ID_CONDICION_COMPRA,
                       TOT_COMPROBANTE,
                       TOT_GRAVADAS,
                       TOT_EXENTAS,
                       TOT_IVA,
                       DESCUENTO,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       VERIFICADORA,
                       TRANSPORTE,
                       ID_VIA,
                       FEC_EMBARQUE,
                       FEC_CONFIRMACION,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       ANULADO,
                       CAMBIO_MONEDA_PRECIO,
                       TIP_COMPROBANTE_REF,
                       SER_COMPROBANTE_REF,
                       NRO_COMPROBANTE_REF,
                       REFERENCIA,
                       ID_PROVEEDOR_REF,
                       COD_USUARIO_AUD,
                       ID_ENTSAL_CAB,
                       FAC_REFERENCIA,
                       ID_SUCURSAL_CENTRAL,
                       COMENTARIO,
                       FEC_ANULACION,
                       TIPO,
                       FOTO_COMPROBANTE,
                       MIMETYPE,
                       FILENAME,
                       ID_COMPROBANTE_REF,
                       PROFORMA,
                       MODALIDAD_ENVIO,
                       PLAZO_ENTREGA_CAB,
                       NRO_POLIZA,
                       FEC_POLIZA_INI,
                       FEC_POLIZA_FIN
                  from CMW_PEDIDOS_CABECERA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            htmlDomId: Contenedor
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region totales (
        name: Totales
        type: staticContent
