    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(400);
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P7_FEC_COMPROBANTE) 
                    into vmensaje
                    from dual;
                    IF VMENSAJE IS NULL THEN
                    RETURN TRUE;
                    ELSE 
                    RETURN FALSE;
                    END IF;
                end;
                ```
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P7_FEC_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }
    )

