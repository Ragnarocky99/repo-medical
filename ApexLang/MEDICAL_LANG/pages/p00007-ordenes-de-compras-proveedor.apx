            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
    )

    region ultimas-compras (
        name: Ultimas compras
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CC.FEC_COMPROBANTE,
                       CC.REFERENCIA,
                       CC.ID_PROVEEDOR,
                       CD.PRECIO_UNITARIO_C_IVA COSTO_UNITARIO,
                       CC.ID_MONEDA
                  FROM CMW_COMPRAS_CABECERA CC
                  JOIN CMW_COMPRAS_DETALLE  CD ON CC.ID = CD.ID_COMPRAS_CAB
                 WHERE NVL(CC.ESTADO, 'P') = 'C'
                   AND CD.ID_ARTICULO = :P7_ID_ARTICULO
                ORDER BY CC.FEC_COMPROBANTE DESC, CC.NRO_COMPROBANTE DESC
                FETCH FIRST 1 ROW ONLY
                ```
            pageItemsToSubmit: P7_ID_ARTICULO
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: UltCompra
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column COSTO_UNITARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: <p>Costo Unitario</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

