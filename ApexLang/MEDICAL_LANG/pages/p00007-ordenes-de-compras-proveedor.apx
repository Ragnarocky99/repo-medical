            readOnly {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                      FROM CMW_COMPRAS_CABECERA CC
                      JOIN CMW_COMPRAS_DETALLE  CD ON CC.ID = CD.ID_COMPRAS_CAB
                      JOIN CMW_PEDIDOS_CABECERA PC ON CC.NRO_COMPROBANTE_REF = PC.NRO_COMPROBANTE
                     WHERE CC.TIP_COMPROBANTE_REF = 'PED'
                       AND CC.SER_COMPROBANTE_REF = 'A'
                       AND PC.ID = :ID_PEDIDO_CAB
                       AND CD.ID_ARTICULO = :ID_ARTICULO
                       AND NVL(CC.ESTADO, 'P') = 'C'
                    ```
                execute: forEachRow
            }
        )

