    dynamicAction setear-precios-y-lote (
        name: Setear Precios y Lote
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_ARTICULO
        }
        comments {
            comments: "Al seleccionar un producto setea su precio y lote correspondiente si es que tienen "
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null then
                         :PRECIO_UNITARIO_C_IVA :=0;
                    end if;
                    if :IVA IS NULL THEN
                    :IVA:=0;
                    END IF;
                    
                    
                    BEGIN
                    SELECT NVL(MAX(PRECIO),0) 
                    INTO :PRECIO_UNITARIO_C_IVA
                    FROM CMWV_PROVEEDORES_ARTICULOS
                    WHERE ID_PROVEEDOR=:P7_ID_PROVEEDOR
                    AND ID_ARTICULO=:ID_ARTICULO;
                    
                    SELECT ID_UNIDAD_MEDIDA
                    INTO :ID_UNIDAD_MEDIDA
                    FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    IF :CANTIDAD IS NULL THEN
                        SELECT 1
                        INTO :CANTIDAD 
                        FROM DUAL;
                    END IF;
                    
                    END;
                    
                    
                        
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P7_ID_PROVEEDOR
                    CANTIDAD
                ]
                itemsToReturn: [
                    PRECIO_UNITARIO_C_IVA
                    IVA
                    PORC_IVA
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      v_maneja_lote varchar(1);
                      v_id_iva number;
                      vind_exento varchar2(1);
                    BEGIN
                        begin
                          select NVL(EXENTO,'N')
                           into vind_exento
                          from cmw_proveedores
                          where id = :P7_ID_PROVEEDOR;
                        exception
                         when no_data_found then
                           raise_application_error(-20000,'No se encuentra proveedor '||:P7_ID_PROVEEDOR);
                         when others then
                           raise_application_error(-20000,'Error encuentra proveedor '||:P7_ID_PROVEEDOR||' '||sqlerrm);
                        end;
                        --IF NVL(:P7_IND_EXENTO,'N')='N' THEN 
                        /* Si es una importacion siempre es exento o el proveedor tiene marcado como exento en la ficha */
                        IF NVL(vind_exento,'N') = 'N' THEN 
                          BEGIN
                              SELECT NVL(ar.IND_MANEJA_LOTE,'N'), ar.ID_IVA, Iv.PORC_IVA_VENTA
                                into v_maneja_lote, :ID_IVA, :PORC_IVA
                              from stw_articulos ar, stw_iva iv 
                              where ar.id = :id_articulo 
                                and ar.id_iva = iv.id;
                          exception
                            when no_data_found then
                              raise_application_error(-20000,'No se encuentra el id_articulo '||:id_articulo);
                            when others then
                              raise_application_error(-20000,'Error No se encuentra el id_articulo '||:id_articulo);
                          end;
                        ELSE 
                          begin
                            SELECT  I.ID, I.PORC_IVA_VENTA 
                              INTO :id_iva, :PORC_IVA
                            FROM STW_IVA I 
                            WHERE COD_IVA = '0'; ---W_BUSCA_PARAMETRO('ST','COD_IVA_EXENTA');
                            --raise_application_error(-20000,v_id_iva);
                          exception
                            when no_data_found then
                              raise_application_error(-20000,'No se encuentra codigo de iva excento ');
                            when others then
                              raise_application_error(-20000,'Error No se encuentra codigo de iva excento '||sqlerrm);
                          end;
                        END IF;
                    EXCEPTION
                      when OTHERS THEN
                        raise_application_error(-20000,'Error en procedimiento '||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P7_IND_EXENTO
                    P7_ID_PROVEEDOR
                ]
                itemsToReturn: [
                    PORC_IVA
                    ID_IVA
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    grid.gotoCell(array[0][0],'COD_ARTICULO');
                    
                    ```
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P7_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM 
                    STW_ARTICULOS WHERE
                    ID=:ID_ARTICULO 
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
