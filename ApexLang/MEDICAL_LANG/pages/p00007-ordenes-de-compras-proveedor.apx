    dynamicAction traer-ultimo-timbrado (
        name: Traer Ultimo Timbrado
        execution {
            sequence: 140
        }
        when {
            event: focusout
            selectionType: items
            items: P7_NRO_TIMBRADO
        }
        clientSideCondition {
            type: itemIsNull
            item: P7_NRO_TIMBRADO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_nro_timbrado CMW_COMPRAS_CABECERA.NRO_TIMBRADO%TYPE;
                    v_ven_timbrado CMW_COMPRAS_CABECERA.FEC_VENC_TIMBRADO%TYPE;
                    begin
                    IF :P7_ID_PROVEEDOR IS NOT NULL THEN 
                    SELECT TIMBRADO,FEC_VENC_TIMBRADO  
                    INTO V_NRO_TIMBRADO,V_VEN_TIMBRADO
                    FROM CMWV_PROVEEDORES_COMPRAS
                    WHERE ID_PROVEEDOR=:P7_ID_PROVEEDOR AND 
                    ID_EMPRESA=:P0_COD_EMPRESA;
                    :P7_NRO_TIMBRADO:=v_nro_timbrado;
                    :P7_FEC_VENC_TIMBRADO:=v_ven_timbrado;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN 
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    end;
                    ```
                itemsToSubmit: P7_ID_PROVEEDOR
                itemsToReturn: [
                    P7_NRO_TIMBRADO
                    P7_FEC_VENC_TIMBRADO
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

