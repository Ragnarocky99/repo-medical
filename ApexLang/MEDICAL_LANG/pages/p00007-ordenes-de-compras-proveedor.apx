    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       D.ID,
                       D.ID_ARTICULO,
                       A.cod_articulo,
                       D.CANTIDAD,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.MONTO_TOTAL_C_IVA,
                       D.IND_STOCK,
                       D.ID_PEDIDO_CAB,
                       D.PRECIO_UNITARIO_C_IVA,
                       NVL(D.PORC_DESCUENTO,0) PORC_DESCUENTO,
                       NVL(D.DESCUENTO,0) DESCUENTO,
                       NVL(D.DESCUENTO_C_IVA,0) DESCUENTO_C_IVA,
                       D.PORC_GRAVADA,
                       D.IVA,
                       D.EXENTO,
                       D.GRAVADA,
                       D.TOTAL_EXENTO,
                       D.TOTAL_GRAVADA,
                       A.DESCRIPCION DESC_ARTICULO,
                       D.ID_IVA,
                       D.PRECIO_UNITARIO,
                       A.id_envase,
                       A.ID_MARCA,
                       A.Cod_Origen_Art COD_FABRICANTE,
                       A.ID_RUBRO,
                       D.ID_PLAZO_ENTREGA,
                       PC.FEC_COMPROBANTE + T.NRO_DIAS         AS FECHA_PLAZO,
                       D.FEC_VENCIMIENTO,
                       D.NRO_LOTE,
                       A.ID_grupo_art,
                       D.COMENTARIO,
                       '' vacio,
                       PC.FEC_COMPROBANTE                       AS FEC_COMPROBANTE,
                       D.ANULADO,
                       D.NRO_OCC,
                       D.FECHA_ANULACION,
                       D.CANTIDAD_ANULADA,
                       D.COD_USUARIO_ANULA,
                       D.COMENTARIO_ANULACION,
                       D.Nro_Pedido,
                       D.COMENTARIO_A_COMPRA,
                       D.id_cotiza_art,
                       D.ID_OFERTA_LIC,
                       D.IND_PARA_STOCK,
                       D.IND_ANULA_OCC,
                       NVL(D.ID_COTIZA_ART, D.ID_APROBACION_LIC) REF_COTIZACION,
                       CASE
                           WHEN D.ID_COTIZA_ART IS NOT NULL THEN 'PED'
                           WHEN D.ID_APROBACION_LIC IS NOT NULL THEN 'LIC'
                       END TIP_COMPROBANTE,
                       COALESCE(PC_COT.NRO_COMPROBANTE, LC.NRO_LICITACION) AS NRO_COMPROBANTE,
                       ROUND((COST.ULT_COSTO - D.PRECIO_UNITARIO_C_IVA) / COST.ULT_COSTO * 100) PORC_VARIACION_COSTO,
                       D.ID_APROBACION_LIC
                       
                  FROM CMW_PEDIDOS_DETALLE D
                  JOIN STW_ARTICULOS            A     ON A.ID = D.ID_ARTICULO
                  LEFT JOIN CMW_PEDIDOS_CABECERA PC   ON PC.ID = D.ID_PEDIDO_CAB
                  LEFT JOIN CMW_TIPO_ENTREGA     T    ON T.ID = D.ID_PLAZO_ENTREGA
                  LEFT JOIN CMW_COTIZA_ARTICULOS CA   ON CA.ID = D.ID_COTIZA_ART
                  LEFT JOIN VTW_PEDIDOS_CABECERA PC_COT ON PC_COT.ID = CA.ID_PEDIDO
                  LEFT JOIN LCW_OFERTAS_APROBACIONES OA ON OA.ID = D.ID_APROBACION_LIC
                  LEFT JOIN LCW_OFERTAS          O    ON O.ID = OA.ID_OFERTA
                  LEFT JOIN LCW_LICITACIONES_CAB LC   ON LC.ID = O.ID_LICITACION_CAB
                  CROSS APPLY (SELECT CMWF_TRAE_ULTIMO_COSTO_FACTURA(D.ID_ARTICULO) AS ULT_COSTO FROM DUAL) COST
                
                 WHERE D.ID_PEDIDO_CAB = :P7_ID
                ```
            pageItemsToSubmit: P7_ID
        }
