                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_gravadas_5:=v_total_gravadas_5+item_detalle.monto_total;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_gravadas_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_ID
        }
    )

    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                             
                             
                
                             --SELECT REPLACE(:TOTAL_IVA,'.','') INTO :TOTAL_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL_C_IVA,'.','') INTO :MONTO_TOTAL_C_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL,'.','') INTO :MONTO_TOTAL  FROM DUAL;
                
                               
                               IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                              :DESCUENTO:=(NVL(:DESCUENTO_C_IVA,0))-(NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0))));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                  
                              END IF;
                
                                insert into CMW_PEDIDOS_DETALLE 
                                (ID_ARTICULO,ID_PEDIDO_CAB,CANTIDAD,ID_IVA,TOTAL_IVA,MONTO_TOTAL_C_IVA,
                                PRECIO_UNITARIO_C_IVA,PRECIO_UNITARIO,ID_UNIDAD_MEDIDA,COD_USUARIO_AUD,MONTO_TOTAL,IVA,PORC_DESCUENTO
                                ,DESCUENTO_C_IVA,DESCUENTO,DESC_ARTICULO,FEC_VENCIMIENTO, NRO_LOTE, COMENTARIO, ANULADO,ID_PLAZO_ENTREGA
                                ,ID_COTIZA_ART, IND_PARA_STOCK, IND_ANULA_OCC, ID_APROBACION_LIC)
                                values(:ID_ARTICULO,:P7_ID,:CANTIDAD,:ID_IVA,REPLACE(:TOTAL_IVA,'.',''),
                                REPLACE(:MONTO_TOTAL_C_IVA,'.',''),REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                :PRECIO_UNITARIO,:ID_UNIDAD_MEDIDA,:COD_USUARIO_AUD,
                                REPLACE(:MONTO_TOTAL,'.',''),:PORC_IVA,:PORC_DESCUENTO,
                                :DESCUENTO_C_IVA,:DESCUENTO,:DESC_ARTICULO,:FEC_VENCIMIENTO,:NRO_LOTE, :COMENTARIO, :ANULADO,
                                :ID_PLAZO_ENTREGA, :ID_COTIZA_ART, :IND_PARA_STOCK, :IND_ANULA_OCC, :ID_APROBACION_LIC);
                            
                            WHEN 'U' then  
                
                                IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN   
                             :DESCUENTO:=NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0)));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              END IF;
                                update CMW_PEDIDOS_DETALLE  d
                                    set  ID_ARTICULO = :ID_ARTICULO,
                                         cantidad     = :cantidad,
                                         precio_unitario_c_iva       = REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                         id_iva     = :ID_IVA,
                                         TOTAL_IVA    = REPLACE(:TOTAL_IVA,'.',''),
                                         monto_total  = REPLACE(:MONTO_TOTAL,'.',''),
                                         MONTO_TOTAL_C_IVA      = REPLACE(:MONTO_TOTAL_C_IVA,'.',''),
                                         PRECIO_UNITARIO=REPLACE(:PRECIO_UNITARIO,'.',''),
                                         ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                                         IVA=:PORC_IVA,
                                         PORC_DESCUENTO=:PORC_DESCUENTO,
                                         DESCUENTO_C_IVA=:DESCUENTO_C_IVA,
                                         DESCUENTO=:DESCUENTO,
                                         DESC_ARTICULO=:DESC_ARTICULO,
                                         FEC_VENCIMIENTO=:FEC_VENCIMIENTO,
                                         NRO_LOTE=:NRO_LOTE,
                                         COMENTARIO=:COMENTARIO,
                                         ID_PLAZO_ENTREGA = :ID_PLAZO_ENTREGA,
                                         ANULADO =:ANULADO,
                                         FECHA_ANULACION = :FECHA_ANULACION,
                                         CANTIDAD_ANULADA = :CANTIDAD_ANULADA,
                                         COD_USUARIO_ANULA = :COD_USUARIO_ANULA,
                                         COMENTARIO_ANULACION = :COMENTARIO_ANULACION,
                                         ID_COTIZA_ART = :ID_COTIZA_ART,
                                         IND_PARA_STOCK = :IND_PARA_STOCK,
                                         IND_ANULA_OCC = :IND_ANULA_OCC,
                                         ID_APROBACION_LIC = :ID_APROBACION_LIC
                                where d.ID_PEDIDO_CAB = :P7_ID
                                    and d.id = :id;
                           when 'D' then
                                delete CMW_PEDIDOS_DETALLE d     
                                WHERE d.ID_PEDIDO_CAB = :ID_PEDIDO_CAB
                                           and d.id = :id;  
                    end case;
                END;
                
                ```
        }
        lockRow {
            preventLostUpdates: false
        }
        execution {
            sequence: 40
        }
        error {
            errorMessage:
                ```
                Error al actualizar el detalle: #SQLERRM_TEXT#
                
                ```
        }
        advanced {
            executionMappingIdentifier: 59659979250867273
        }
        comments {
            comments: "Proceso para guardar, actualizar, eliminar los detalles de la factura "
        }
    )

