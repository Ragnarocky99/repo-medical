            }
        )

        action set-user (
            name: Set User
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vuser VARCHAR2(30);
                    BEGIN
                        IF NVL(:ANULADO, 'N') = 'S' THEN
                            vuser := :APP_USER;
                        ELSE
