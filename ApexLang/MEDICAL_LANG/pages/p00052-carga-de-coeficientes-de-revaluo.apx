page 52 (
    name: Carga de Coeficientes de Revaluo
    alias: CARGA-DE-COEFICIENTES-DE-REVALUO
    title: Carga de Coeficientes de Revaluo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-coeficientes-de-revaluo (
        name: Carga de Coeficientes de Revaluo
        type: form
        source {
            location: localDatabase
            tableName: COW_COEFICIENTES
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 3
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P52_ANIO (
        type: numberField
        label {
            label: <p>Año:</p>
            alignment: left
        }
        settings {
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: ANIO
            dataType: number
        }
    )

    pageItem P52_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 80
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P52_COEF_COMPRA (
        type: numberField
        label {
            label: <p>Coeficiente de Compra:</p>
            alignment: left
        }
        settings {
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: COEF_COMPRA
            dataType: number
        }
    )

    pageItem P52_COEF_VENTA (
        type: numberField
        label {
            label: <p>Coeficiente de Venta:</p>
            alignment: left
        }
        settings {
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: COEF_VENTA
            dataType: number
        }
    )

    pageItem P52_ID (
        type: hidden
        layout {
            sequence: 60
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: COW_COEF_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P52_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P52_MES (
        type: numberField
        label {
            label: <p>Mes:</p>
            alignment: left
        }
        settings {
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @carga-de-coeficientes-de-revaluo
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-coeficientes-de-revaluo
            column: MES
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P52_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P52_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P52_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 10369375908707731
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-coeficientes-de-revaluo (
        name: Initialize form Carga de Coeficientes de Revaluo
        type: formInitialization
        formRegion: @carga-de-coeficientes-de-revaluo
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10368517923707731
        }
    )

    process process-form-carga-de-coeficientes-de-revaluo (
        name: Process form Carga de Coeficientes de Revaluo
        type: formAutoRowProcessing
        formRegion: @carga-de-coeficientes-de-revaluo
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10368935299707731
        }
    )

)

