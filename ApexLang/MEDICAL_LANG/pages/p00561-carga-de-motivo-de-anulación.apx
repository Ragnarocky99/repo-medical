page 561 (
    name: Carga de Motivo de Anulación
    alias: CARGA-DE-MOTIVO-DE-ANULACIÓN
    title: Carga de Motivo de Anulación
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:12.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 190px;
            height: 25px;
            pointer-events: none;}
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-motivo-de-anulación (
        name: Carga de Motivo de Anulación
        type: form
        source {
            location: localDatabase
            tableName: LTW_MOTIVOS_ANULACION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P561_COD_MOTIVO (
        type: textField
        label {
            label: <p>Código: </p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-motivo-de-anulación
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @carga-de-motivo-de-anulación
            column: COD_MOTIVO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(M.COD_MOTIVO)), 0)+1
                from LTW_MOTIVOS_ANULACION M
                WHERE M.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

    pageItem P561_DESCRIPCION (
        type: textarea
        label {
            label: <p>Descripción: </p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-motivo-de-anulación
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @carga-de-motivo-de-anulación
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P561_ESTADO (
        type: checkbox
        label {
            label: <p>Estado</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: A
            uncheckedValue: I
        }
        layout {
            sequence: 50
            region: @carga-de-motivo-de-anulación
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-motivo-de-anulación
            column: ESTADO
            dataType: varchar2
        }
    )

    pageItem P561_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-motivo-de-anulación
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivo-de-anulación
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P561_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-motivo-de-anulación
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivo-de-anulación
            column: ID_EMPRESA
            dataType: varchar2
            primaryKey: true
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P561_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P561_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P561_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 90223594786205181
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-motivo-de-anulación (
        name: Initialize form Carga de Motivo de Anulación
        type: formInitialization
        formRegion: @carga-de-motivo-de-anulación
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 90222783147205181
        }
    )

    process process-form-carga-de-motivo-de-anulación (
        name: Process form Carga de Motivo de Anulación
        type: formAutoRowProcessing
        formRegion: @carga-de-motivo-de-anulación
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 90223188802205181
        }
    )

)

