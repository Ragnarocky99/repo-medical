                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region resumen-catalogo (
        name: Resumen Catalogo
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LCWV_RESUMEN_CATALOGO
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                (ID_CLIENTE = :P779_ID_CLIENTE OR :P779_ID_CLIENTE IS NULL) AND
                (NRO_OCC = :P779_NRO_OCC OR :P779_NRO_OCC IS NULL) AND
                (NRO_ID_LICITACION = :P779_NRO_ID_LICITACION OR :P779_NRO_ID_LICITACION IS NULL) AND
                FEC_LICITACION BETWEEN :P779_FEC_INI AND :P779_FEC_FIN AND
                (NRO_LICITACION = :P779_NRO_LICITACION OR :P779_NRO_LICITACION IS NULL) AND
                (NRO_ITEM = :P779_NRO_ITEM OR :P779_NRO_ITEM IS NULL) AND
                (ESTADO_OCC = :P779_ESTADO_OCC OR :P779_ESTADO_OCC IS NULL) AND
                (ESTADO_VINCULACION = :P779_ESTADO_VINCULACION OR :P779_ESTADO_VINCULACION IS NULL)
                ```
            pageItemsToSubmit: [
                P779_FEC_INI
                P779_FEC_FIN
                P779_ID_CLIENTE
                P779_NRO_LICITACION
                P779_NRO_ITEM
                P779_ESTADO_VINCULACION
                P779_NRO_ID_LICITACION
                P779_NRO_OCC
                P779_ESTADO_OCC
            ]
        }
        layout {
            sequence: 30
            slot: fullWidthContent
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 41391636478860873
        }

