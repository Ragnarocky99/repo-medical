    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-filtros (
        name: Change - Filtros
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P779_ID_CLIENTE
                P779_NRO_LICITACION
                P779_NRO_ITEM
                P779_ESTADO_VINCULACION
                P779_NRO_ID_LICITACION
                P779_NRO_OCC
                P779_ESTADO_OCC
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-catalogo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction change-filtros-2 (
        name: Change - Filtros
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P779_ID_CLIENTE
                P779_NRO_ID_LICITACION
                P779_NRO_OCC
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-catalogo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @resumen-catalogo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

