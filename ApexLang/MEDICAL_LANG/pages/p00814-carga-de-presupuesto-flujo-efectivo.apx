    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction procesar (
        name: Procesar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @distribuir
        }

        action calcula-total (
            name: CALCULA_TOTAL
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vTotal  NUMBER(20,2);
                        vMonto  NUMBER(20,2);
                        vResto  NUMBER(20,2);
                        vMeses  NUMBER(10);
                        
                    BEGIN
                        /*Setear variables*/
                        vMonto := REPLACE(:P814_MONTO,'.','');
                        vMeses := 12;
                    
                        /*Condición*/
                        IF NVL(vMonto, 0) > 0 THEN
                            vTotal := REPLACE(:P814_PRE_ENERO,'.','') + REPLACE(:P814_PRE_FEBRERO,'.','') + REPLACE(:P814_PRE_MARZO,'.','') + REPLACE(:P814_PRE_ABRIL,'.','') + REPLACE(:P814_PRE_MAYO,'.','') + REPLACE(:P814_PRE_JUNIO,'.','') + REPLACE(:P814_PRE_JULIO,'.','') + REPLACE(:P814_PRE_AGOSTO,'.','') + REPLACE(:P814_PRE_SEPTIEMBRE,'.','') + REPLACE(:P814_PRE_OCTUBRE,'.','') + REPLACE(:P814_PRE_NOVIEMBRE,'.','');
                            
                            vResto := vMonto - vTotal;
                    
                                IF nvl( vMonto, 0 ) > nvl(REPLACE(:P814_PRE_DICIEMBRE,'.',''), 0 ) THEN
                                    --REPLACE(:P814_PRE_DICIEMBRE := round( nvl( REPLACE(REPLACE(:P814_PRE_DICIEMBRE,'.',''), 0 ) - nvl( vMonto, 0 ), 0 );
                                    :P814_PRE_DICIEMBRE := vResto;
                                    :P814_TOTAL := vTotal  + vResto;
                                END IF;
                    
                        ELSE
                            :P814_TOTAL := 0;
                        END IF;
                    
                    END;
                    ```
                itemsToSubmit: [
                    P814_PRE_ENERO
                    P814_PRE_FEBRERO
                    P814_PRE_MARZO
                    P814_PRE_ABRIL
                    P814_PRE_MAYO
                    P814_PRE_JUNIO
                    P814_PRE_JULIO
                    P814_PRE_AGOSTO
                    P814_PRE_SEPTIEMBRE
                    P814_PRE_OCTUBRE
                    P814_PRE_NOVIEMBRE
                    P814_PRE_DICIEMBRE
                    P814_MONTO
                ]
                itemsToReturn: [
                    P814_PRE_DICIEMBRE
                    P814_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action distribuye-monto (
            name: DISTRIBUYE_MONTO
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var montoAnual = apex.item('P814_MONTO').getValue().replace(/\./g,'');
                    var meses = ['P814_PRE_ENERO', 'P814_PRE_FEBRERO', 'P814_PRE_MARZO', 'P814_PRE_ABRIL', 
                                 'P814_PRE_MAYO', 'P814_PRE_JUNIO', 'P814_PRE_JULIO', 'P814_PRE_AGOSTO', 'P814_PRE_SEPTIEMBRE', 
                                 'P814_PRE_OCTUBRE', 'P814_PRE_NOVIEMBRE', 'P814_PRE_DICIEMBRE'];
                    var montoMensual = Math.floor(montoAnual / meses.length);
                    var total = 0;
                    
                    for (var i = 0; i < meses.length; i++) {
                      apex.item(meses[i]).setValue(montoMensual);
                      total += montoMensual;
                    }
                    
                    apex.item('P814_TOTAL').setValue(total);
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction sum-total-indi (
        name: SUM_TOTAL_INDI
        execution {
            sequence: 30
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @meses
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        vTotal  NUMBER(20,2);
                        vMonto  NUMBER(20,2);
                    BEGIN
                        vMonto := TO_NUMBER(REPLACE(NVL(:P814_MONTO, '0'), '.', ''));
                        
                        --IF NVL(vMonto, 0) > 0 THEN
                            vTotal := TO_NUMBER(REPLACE(NVL(:P814_PRE_ENERO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_FEBRERO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_MARZO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_ABRIL, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_MAYO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_JUNIO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_JULIO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_AGOSTO, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_SEPTIEMBRE, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_OCTUBRE, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_NOVIEMBRE, '0'), '.', '')) + 
                                      TO_NUMBER(REPLACE(NVL(:P814_PRE_DICIEMBRE, '0'), '.', ''));
                    
                            :P814_TOTAL := TO_NUMBER(vTotal);
                        --END IF;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P814_PRE_ENERO
                    P814_PRE_FEBRERO
                    P814_PRE_MARZO
                    P814_PRE_ABRIL
                    P814_PRE_MAYO
                    P814_PRE_JUNIO
                    P814_PRE_JULIO
                    P814_PRE_AGOSTO
                    P814_PRE_SEPTIEMBRE
                    P814_PRE_OCTUBRE
                    P814_PRE_NOVIEMBRE
                    P814_PRE_DICIEMBRE
                    P814_TOTAL
                ]
                itemsToReturn: P814_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

