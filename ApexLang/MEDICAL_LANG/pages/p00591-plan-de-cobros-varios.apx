page 591 (
    name: Plan de Cobros Varios
    alias: PLAN-DE-COBROS-VARIOS
    title: Plan de Cobros Varios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region plan-de-cobros-varios (
        name: Plan de Cobros Varios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CS.ID,
                       CS.ID_EMPRESA,
                       CS.ID_SUCURSAL,
                       CS.TIP_COMPROBANTE,
                       CS.SER_COMPROBANTE,
                       CS.NRO_COMPROBANTE,
                       CS.ID_COMPROBANTE_REF,
                       CS.TIP_COMPROBANTE_REF,
                       CS.SER_COMPROBANTE_REF,
                       CS.NRO_COMPROBANTE_REF,
                       CS.FEC_COMPROBANTE,
                       CS.ID_FRACCION,
                       CS.ID_MANZANA,
                       CS.ID_LOTE,
                       CS.ID_CLIENTE,
                       CS.ID_MONEDA,
                       CS.TIP_CAMBIO,
                       CS.ID_USUARIO,
                       CS.TOT_COMPROBANTE,
                       CS.TOT_IVA,
                       CS.OBSERVACION,
                       CS.TIP_COMP_REF,
                       CS.SER_COMP_REF,
                       CS.NRO_COMP_REF,
                       CS.NOM_ESCRIBANO,
                       CS.ID_ESCRIBANO,
                       CS.IND_DISTRIBUCION,
                       CS.NRO_GESTION_JUDICIAL,
                       CS.ID_FRACCION_ORIGINAL,
                       CS.ID_MANZANA_ORIGINAL,
                       CS.ID_LOTE_ORIGINAL,
                       CS.NRO_CONTRATO_ORIGINAL,
                       CS.COD_USUARIO_AUD
                FROM LTW_COMPROBANTES_SERVICIOS CS
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 592
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 10583449995058037
