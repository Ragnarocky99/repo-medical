    dynamicAction cargar-datos-del-local (
        name: Cargar Datos del Local
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @locales
            columns: ID_LOCAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT CTA_CTE_CTRAL,DIRECCION
                    INTO :CTA_CTE_CTRAL,:DIRECCION
                    FROM ACW_LOCALES
                    WHERE ID=:ID_LOCAL;
                    
                    EXCEPTION
                     WHEN NO_DATA_FOUND THEN
                        RAISE_APPLICATION_ERROR(-20000,'No se encontraron los datos del local ');
                     WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-2000,'Error al buscar lo datos del local'||sqlerrm);
                    END;
                    ```
                itemsToSubmit: ID_LOCAL
                itemsToReturn: [
                    CTA_CTE_CTRAL
                    DIRECCION
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P547_FEC_INICIO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P547_FEC_INICIO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P547_FEC_INICIO,'/','');
                            conv_fecha := substr(:P547_FEC_INICIO,1,2)||'/'||
                                                      substr(:P547_FEC_INICIO,3,2)||'/'||
                                                      lpad(substr(:P547_FEC_INICIO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P547_FEC_INICIO := conv_fecha;
                            ELSIF (length(:P547_FEC_INICIO) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P547_FEC_INICIO) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P547_FEC_INICIO
                itemsToReturn: P547_FEC_INICIO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

