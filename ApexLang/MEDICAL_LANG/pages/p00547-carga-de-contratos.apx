        column ID_LOCAL (
            type: popupLov
            heading {
                heading: <p>Local</p>
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lv-locales
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: ID_LOCAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Locales
        }
    )

