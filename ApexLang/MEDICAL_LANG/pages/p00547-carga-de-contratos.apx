    computation p547-nro-contrato (
        itemName: P547_NRO_CONTRATO
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(NRO_CONTRATO),0)+1
                FROM ACW_CONTRATOS_CAB
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P547_ID
        }
    )

