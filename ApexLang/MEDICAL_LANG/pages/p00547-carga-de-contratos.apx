    region locales (
        name: Locales
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_LOCAL,
                       C.ID_EMPRESA,
                       C.ID_CONTRATO_CAB,
                       L.CTA_CTE_CTRAL,
                       L.DIRECCION,
                       C.COD_USUARIO_AUD
                  from ACW_CONTRATOS_LOCALES C,ACW_LOCALES L
                 where ID_CONTRATO_CAB=:P547_ID
                 AND L.ID=C.ID_LOCAL
                ```
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
