    process pre-insert (
        name: PRE_INSERT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                ---Variables Para Calcular Fec_vencimiento
                 plazo         number  (5):= :P547_PLAZO;
                tip_plazo 		varchar2(5):= :P547_TIPO_PLAZO;
                fec_contrato	date       := :P547_FEC_INICIO; ---:b_cabecera.fec_contrato;  
                BEGIN
                	  if    tip_plazo =  'DD' then 
                	  	:P547_FEC_VENCIMIENTO := fec_contrato + plazo;
                	  elsif tip_plazo =  'MM' then
                	  	:P547_FEC_VENCIMIENTO := add_months(fec_contrato,plazo);
                	  elsif tip_plazo =  'YYYY' then
                	  	plazo := plazo * 12;
                	  	:P547_FEC_VENCIMIENTO:= add_months(fec_contrato,plazo);
                	  end if;	
                      END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 86226432599411509
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

