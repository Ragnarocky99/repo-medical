            execution {
                sequence: 20
            }
        )

        action boton-cargar-seleccion-todos (
            name: Boton Cargar Seleccion Todos
            action: plugin/fosInteractiveGridAddButton
            settings {
                addButtonTo: toolbarAddRowGroup
                label: Cargar Todos
                onClick: triggerEvent
                eventName: cargar-todo
                extraOptions: toolbarOnlyHot
            }
            affectedElements {
                selectionType: region
                region: @saldos
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: never
            }
        )

        action coleccion (
            name: Coleccion
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF NOT APEX_COLLECTION.COLLECTION_EXISTS('SALDOS_CLIENTE_SELECCION') THEN
                            APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('SALDOS_CLIENTE_SELECCION');
                        END IF;
                    END;
                    ```
            }
            execution {
                sequence: 40
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6719687142156903
        }
    )

    process saldos-save-interactive-grid-data (
        name: Saldos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @saldos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13219506847811303
        }
        serverSideCondition {
            type: never
        }
    )

)

