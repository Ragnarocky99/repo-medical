    dynamicAction cargar-seleccion (
        name: Cargar Seleccion
        execution {
            sequence: 30
        }
        when {
            event: custom
            customEvent: cargar-seleccion
            selectionType: region
            region: @saldos
        }

        action monedas-distintas (
            name: Monedas distintas
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        V_CANTIDAD NUMBER;
                    BEGIN
                        SELECT  COUNT(DISTINCT(N002))
                        INTO    V_CANTIDAD
                        FROM    APEX_COLLECTIONS
                        WHERE   COLLECTION_NAME = 'SALDOS_CLIENTE_SELECCION';
                    
                        IF V_CANTIDAD > 1 THEN
                            :P751_BANDERA := 'S';
                            apex_collection.delete_members( 
                                p_collection_name => 'SALDOS_CLIENTE_SELECCION',
                                p_attr_number     => 1,
                                p_attr_value      => 'N' );
                        ELSE
                            :P751_BANDERA := 'N';
                        END IF;
                    END;
                    ```
                itemsToReturn: P751_BANDERA
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-alert (
            action: alert
            settings {
                message: No se puede seleccionar comprobantes con diferentes monedas
                style: warning
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P751_BANDERA
                value: S
            }
        )

        action native-dialog-close (
            action: submitPage
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P751_BANDERA
                value: N
            }
        )

        action plugin-com-fos-interactive-grid-process-rows (
            action: plugin/fosInteractiveGridProcessRows
            settings {
                action: processSelectedRows
                plSqlCode:
                    ```plsql
                    APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => 'SALDOS_CLIENTE_SELECCION',
                        p_c001  => 'N',
                        p_n001  => :ID_SALDO,
                        p_n002  => :ID_MONEDA_CUOTA);
                    ```
                itemsToSubmit: [
                    ID_SALDO
                    ID_MONEDA_CUOTA
                ]
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            affectedElements {
                selectionType: region
                region: @saldos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction change-cliente (
        name: Change Cliente
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P751_ID_CLIENTE
        }

        action native-set-value (
            name: P751_NOMB_CLIENTE
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT  P.NOMB_FANTASIA
                    FROM    CCW_CLIENTES C
                    JOIN    BSW_PERSONAS P ON P.ID = C.ID_PERSONA
                    WHERE   C.ID = :P751_ID_CLIENTE
                    ```
                itemsToSubmit: P751_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P751_NOMB_CLIENTE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction inicializacion (
        name: Inicializacion
