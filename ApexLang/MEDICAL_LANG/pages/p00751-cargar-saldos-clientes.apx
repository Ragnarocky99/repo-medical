page 751 (
    name: Cargar Saldos - Clientes
    alias: CARGAR-SALDOS-CLIENTES
    title: Cargar Saldos - Clientes
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                    vertical-align: middle;
                border-style: dashed;
                width: 65px;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region saldos (
        name: Saldos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT      S.ID ID_SALDO,
                            NVL(VC.FEC_COMPROBANTE, AC.FEC_COMPROBANTE) FEC_COMPROBANTE,
                            S.TIPO_COMPROBANTE,
                            S.SER_COMPROBANTE,
                            TO_CHAR(S.NRO_COMPROBANTE) NRO_COMPROBANTE,
                            S.MONTO_CUOTA,
                            S.SALDO_CUOTA,
                            S.ID_MONEDA_CUOTA,
                            S.FEC_VENCIMIENTO
                FROM        CCW_SALDOS S
                LEFT JOIN   VTW_COMPROBANTES_CABECERA  VC ON VC.ID = S.ID_COMPROBANTE
                LEFT JOIN   CCW_ANTICIPOS_CLIENTES_CAB AC ON AC.ID = S.ID_ANTICIPO --AND S.TIPO_COMPROBANTE = W_BUSCA_PARAMETRO('CC', 'TIP_ANTI_CLIENTE_CRE')
                LEFT JOIN   CCW_CONDICIONES_VENTAS     CV ON CV.ID = VC.ID_CONDICION_VENTA
                WHERE       S.ID_CLIENTE       = :P751_ID_CLIENTE
                AND         (S.ID_MONEDA_CUOTA  = :P751_ID_MONEDA OR :P751_ID_MONEDA IS NULL)
                AND         S.ID_EMPRESA       = :P0_ID_EMPRESA
                AND         S.ID_SUCURSAL      = :P0_ID_SUCURSAL
                AND         S.ID NOT IN (SELECT N001 FROM APEX_COLLECTIONS WHERE COLLECTION_NAME = 'SALDOS_CLIENTE_SELECCION')
                AND         S.SALDO_CUOTA <> 0
                AND         NVL(S.REC_PENDIENTES,0) != S.MONTO_CUOTA
                --AND         S.TIPO_COMPROBANTE <> W_BUSCA_PARAMETRO('CC', 'TIP_ANTI_CLIENTE_CRE')
                AND         (CV.PLAZO <> 0 OR CV.PLAZO IS NULL)
                ```
            pageItemsToSubmit: [
                P751_ID_CLIENTE
                P751_ID_MONEDA
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                  options.defaultGridViewOptions = {
                    persistSelection: true
                  };
                  return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 26019267629355302
        }

