page 23 (
    name: Carga de Modulos
    alias: MODULOS
    title: Carga de Modulos - Sistema Inventiva
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region modulos (
        name: Modulos
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_MODULO,
                       DESCRIPCION,
                       MANEJA_CALENDARIO,
                       COD_USUARIO_AUD,
                       ACTIVO
                  from BSW_MODULOS
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 3
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P23_ACTIVO (
        type: checkbox
        label {
            label: Activo
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 70
            region: @modulos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @modulos
            column: ACTIVO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: S
        }
    )

    pageItem P23_COD_MODULO (
        type: textField
        label {
            label: <p>Cód. Módulo: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @modulos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 2
        }
        source {
            formRegion: @modulos
            column: COD_MODULO
            dataType: varchar2
        }
    )

    pageItem P23_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 20
            region: @modulos
            slot: regionBody
        }
        source {
            formRegion: @modulos
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
    )

    pageItem P23_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @modulos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @modulos
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P23_ID (
        type: hidden
        layout {
            sequence: 10
            region: @modulos
            slot: regionBody
        }
        source {
            formRegion: @modulos
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: BSW_MODULOS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
