    dynamicAction calc-dias (
        name: CALC_DIAS
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P522_FEC_INI
                P522_FEC_FIN
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P522_FEC_INI IS NOT NULL AND :P522_FEC_FIN IS NOT NULL THEN
                        :P522_DIAS := TO_DATE(:P522_FEC_FIN) - TO_DATE(:P522_FEC_INI) + 1;
                    ELSE
                        :P522_DIAS := 0;
                    END IF;
                    ```
                itemsToSubmit: [
                    P522_FEC_INI
                    P522_FEC_FIN
                ]
                itemsToReturn: P522_DIAS
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P522_FEC_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P522_FEC_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P522_FEC_FIN,'/','');
                            conv_fecha := substr(:P522_FEC_FIN,1,2)||'/'||
                                                      substr(:P522_FEC_FIN,3,2)||'/'||
                                                      lpad(substr(:P522_FEC_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P522_FEC_FIN := conv_fecha;
                            ELSIF (length(:P522_FEC_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P522_FEC_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P522_FEC_FIN
                itemsToReturn: P522_FEC_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P522_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P522_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P522_FEC_INI,'/','');
                            conv_fecha := substr(:P522_FEC_INI,1,2)||'/'||
                                                      substr(:P522_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:P522_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P522_FEC_INI := conv_fecha;
                            ELSIF (length(:P522_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P522_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P522_FEC_INI
                itemsToReturn: P522_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P522_COD_ARTICULO_DESDE
                P522_ID_PROVEEDOR
                P522_FEC_INI
                P522_FEC_FIN
                P522_COD_ARTICULO_HASTA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pedidos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 545
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 545
                items: {
                    P522_ID_PROVEEDOR: &P522_ID_PROVEEDOR.
                    P522_FEC_INI: &P522_FEC_INI.
                    P522_FEC_FIN: &P522_FEC_FIN.
                    P522_COD_ARTICULO_DESDE: &P522_COD_ARTICULO_DESDE.
                    P522_COD_ARTICULO_HASTA: &P522_COD_ARTICULO_HASTA.
                    P522_DIAS: &P522_DIAS.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

