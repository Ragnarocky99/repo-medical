    region pedidos (
        name: Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT c.id_empresa,
                	   EM.TITULO_REPORTES,
                       lpad( rtrim( ltrim( s.cod_articulo)),5,' ') cod_articulo,
                       lpad( s.descripcion,length(s.descripcion)+2,' ') descripcion,
                       s.cod_origen_art,
                       sum( st.cant_dispon ) stock,
                       sum( decode( tc.stock, 'S', d.cantidad * -1, d.cantidad )) vendido,
                       s.id_proveedor_dflt as id_proveedor,
                       pr.cod_proveedor,
                       nvl(pe.nomb_fantasia,pe.nombre) as nom_proveedor
                
                FROM STW_ARTICULOS s,
                     VTW_COMPROBANTES_CABECERA c,
                     VTW_COMPROBANTES_DETALLE d,
                     BSW_TIPOS_COMPROBANTES tc,
                     STW_EXISTENCIA_ART st,
                     CMW_PROVEEDORES pr,
                     BSW_PERSONAS pe,
                     BSW_EMPRESAS EM
                
                WHERE nvl( c.estado,'N') <> 'A'
                  AND EM.ID = :P0_ID_EMPRESA
                  AND c.ID_EMPRESA = EM.ID
                  AND c.id_empresa = tc.id_empresa
                  AND nvl( c.tip_comprobante, 'CCC')  = tc.tip_comprobante
                  AND c.id = d.id_comprobante_cabecera
                  AND d.id_articulo = s.id
                  AND s.id_proveedor_dflt = pr.id
                  AND pr.id_persona = pe.id
                  AND s.id = st.id_articulo
                  AND (pr.id = :P522_ID_PROVEEDOR OR :P522_ID_PROVEEDOR IS NULL)
                  AND (c.fec_comprobante  BETWEEN :P522_FEC_INI AND :P522_FEC_FIN)
                  AND (to_number(s.cod_articulo) between to_number(:P522_COD_ARTICULO_DESDE) and to_number(:P522_COD_ARTICULO_HASTA) or (:P522_COD_ARTICULO_DESDE is null and :P522_COD_ARTICULO_HASTA is null))
                
                GROUP BY c.id_empresa,
                         lpad( rtrim( ltrim( s.cod_articulo )),5,' '),
                         s.cod_articulo,
                         s.descripcion,
                         s.cod_origen_art,
                         0,
                         s.id_proveedor_dflt,
                         pr.cod_proveedor,
                         nvl(pe.nomb_fantasia,pe.nombre),
                         EM.TITULO_REPORTES
                         
                ORDER BY TO_NUMBER(PR.COD_PROVEEDOR), 
                         TO_NUMBER(S.COD_ARTICULO)
                
                ```
            pageItemsToSubmit: [
                P522_COD_ARTICULO_DESDE
                P0_ID_EMPRESA
                P522_FEC_INI
                P522_FEC_FIN
                P522_ID_PROVEEDOR
                P522_COD_ARTICULO_HASTA
            ]
        }
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
