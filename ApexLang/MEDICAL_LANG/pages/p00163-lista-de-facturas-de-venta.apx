page 163 (
    name: Lista de Facturas de Venta
    alias: LISTA-DE-FACTURAS-DE-VENTA
    title: Lista de Facturas de Venta
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /*.a-IRR-header {    background-color:#4047bc;color: white;}.a-IRR-headerLink {    font-weight: bold;color: white;}
             */ 
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region lista-de-facturas-de-venta (
        name: Lista de Facturas de Venta
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-de-facturas-de-venta-2 (
        name: Lista de Facturas de Venta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_VENDEDOR,
                       C.TIP_COMPROBANTE_REF,
                       C.SER_COMPROBANTE_REF,
                       C.NRO_COMPROBANTE_REF,
                       C.ID_CONDICION_VENTA,
                       C.ID_LISTA_PRECIO,
                       C.DESCUENTO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.TOT_COMPROBANTE,
                       C.TOT_GRAVADAS,
                       C.TOT_EXENTAS,
                       C.TOT_IVA,
                       C.ID_MOV_CAJ,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.ID_USUARIO,
                       C.FEC_ALTA,
                       C.DESCUENTO_DET,
                       C.TOT_DESCUENTO_DET,
                       C.CAMBIO_DOLAR,
                       C.CAMBIO_MONEDA_PRECIO,
                       C.NOM_CLIENTE,
                       C.ESTADO_REPARO,
                       C.ESTADO_REPARTO,
                       C.TOT_IVA_SIN_REDONDEO,
                       C.TIP_CAMBIO_COMPRA,
                       C.COMENTARIO,
                       C.GRU_COMPROBANTE,
                       C.ID_PERSONA,
                       C.ACTUALIZADO_POR,
                       C.IMPRESION_AUTORIZADA,
                       C.AUTORIZADO_POR,
                       C.IMPRESO,
                       C.RUC_CLIENTE,
                       C.IND_PAGARE,
                       C.ID_COBRADOR_PAG,
                       C.ID_USUARIO_PAG,
                       C.DIAS_AUT_PAGARE,
                       C.FEC_AUT_PAGARE,
                       C.IND_REFACTURAR,
                       C.ID_MOTIVO_ANU,
                       C.ID_SECTOR_VEN,
                       C.IMPRIME_IVA,
                       C.NRO_AUTORIZ_FACT,
                       C.COD_USUARIO_AUD,
                       C.TIENE_REMISION,
                       C.NRO_MOV_CAJ,
                       C.ID_DESPACHO_CAB,
                       C.ID_CLIENTE,
                       C.ID_PEDIDO_REF,
                       C.ID_COMPROBANTE_REF,
                       C.IND_IMPRIMIR_COMENTARIO,
                       C.SERIE,
                       C.NRO_TIMBRADO,
                       C.ID_MOTIVO_NCR,
                       C.LOTE,
                       C.NRO_GARANTIA,
                       C.ID_USUARIO_ANU,
                       C.FEC_HORA_COMPROBANTE,
                       CASE (SELECT CC_ESTADO_COBRO(C.ID) FROM DUAL)
                       WHEN 'COBRADO' THEN 'green'
                       WHEN 'PENDIENTE' THEN 'red'
                       WHEN 'COBRO PARCIAL' THEN '#e3e01e'
                       end as THE_COLOR,
                       CASE C.ESTADO
                       WHEN 'A' THEN 'fa-check-circle u-danger-text'
                       WHEN NULL THEN ''
                       END AS ANULADO,
                       --TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'dep')) ASIENTOS,
                       C.ASIENTOS,
                       (SELECT D.ID
                        FROM COW_DIARIO_CABECERAS_PROV D
                        WHERE D.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS,'*'),'dep'))
                          AND D.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_COMPROBANTE)
                          AND D.ID_EMPRESA  = C.ID_EMPRESA) ASIENTO_ID,
                       TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS_COSTOS,'*'),'dep')) ASIENTOS_COSTOS,
                       (SELECT E.ID
                        FROM COW_DIARIO_CABECERAS_PROV E
                        WHERE E.NUM_ASIENTO = TO_NUMBER(REPLACE(REPLACE(C.ASIENTOS_COSTOS,'*'),'dep'))
                          AND E.ID_EJERCICIO= TRAE_ID_EJERCICIO(C.FEC_COMPROBANTE)
                          AND E.ID_EMPRESA  = C.ID_EMPRESA) ASIENTO_COSTO_ID,
                          NVL(C.NRO_OCC, LC.NRO_ID_LICITACION) NRO_OCC,
                      /* CASE
                            WHEN C.ID IS NOT NULL THEN 'fa fa-search u-primary-text'
                       END REF_RECIBO,*/
                       '' AS LINK,
                       DECODE(VTWF_REQUIERE_TRIPTICO('FVE', C.ID), 'S', 'Si',
                                                            'N', 'No') IND_REQUIERE_TRIPTICO
                
                FROM VTW_COMPROBANTES_CABECERA C
                LEFT JOIN LCW_LICITACIONES_CAB LC ON LC.ID = C.ID_LICITACION_CAB
                wHERE C.ID_EMPRESA=:P0_COD_EMPRESA 
                  AND C.TIP_COMPROBANTE=W_BUSCA_PARAMETRO('VT','TIPO_COMPROBANTE_VENTA')
                  AND C.ID_SUCURSAL=:P0_COD_SUCURSAL
                  --AND C.ID NOT IN (SELECT NVL(ID_COMPROBANTE_REF,0) 
                    --             FROM VTW_COMPROBANTES_CABECERA 
                      --           WHERE TIP_COMPROBANTE=W_BUSCA_PARAMETRO('VT','TIPO_NOTACRE'))
                  AND NVL(C.ID_MODULO, TRAE_ID_MODULO('VT')) = TRAE_ID_MODULO('VT')
                  AND (C.SER_COMPROBANTE = :P163_SER_COMPROBANTE OR :P163_SER_COMPROBANTE IS NULL)
                  AND (C.NRO_COMPROBANTE = :P163_NRO_COMPROBANTE OR :P163_NRO_COMPROBANTE IS NULL) 
                  AND (C.FEC_COMPROBANTE BETWEEN :P163_FEC_INI AND :P163_FEC_FIN)
                  AND (C.ID_CLIENTE = :P163_CLIENTE OR :P163_CLIENTE IS NULL) 
                  AND (C.RUC_CLIENTE = :P163_RUC_CLIENTE OR :P163_RUC_CLIENTE IS NULL) 
                  AND (C.ID_CONDICION_VENTA = :P163_COND_VENTA OR :P163_COND_VENTA IS NULL) 
                  AND (C.ESTADO = :P163_ANULADO OR :P163_ANULADO IS NULL)
                
                ORDER BY C.FEC_COMPROBANTE DESC, C.NRO_COMPROBANTE DESC
                
                ```
            pageItemsToSubmit: [
                P163_TIP_COMPROBANTE
                P163_SER_COMPROBANTE
                P163_NRO_COMPROBANTE
                P163_FEC_INI
                P163_FEC_FIN
                P163_CLIENTE
                P163_RUC_CLIENTE
                P163_COND_VENTA
                P163_ANULADO
            ]
        }
        layout {
            sequence: 20
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 135
                items: {
                    P135_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aún no hay facturas.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 19649401004606910
        }

