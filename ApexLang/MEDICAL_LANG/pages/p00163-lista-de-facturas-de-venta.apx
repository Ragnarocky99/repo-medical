    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P163_FEC_FIN
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P163_FEC_FIN) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P163_FEC_FIN,'/','');
                            conv_fecha := substr(:P163_FEC_FIN,1,2)||'/'||
                                                      substr(:P163_FEC_FIN,3,2)||'/'||
                                                      lpad(substr(:P163_FEC_FIN,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P163_FEC_FIN := conv_fecha;
                            ELSIF (length(:P163_FEC_FIN) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P163_FEC_FIN) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P163_FEC_FIN
                itemsToReturn: P163_FEC_FIN
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P163_FEC_INI
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P163_FEC_INI) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P163_FEC_INI,'/','');
                            conv_fecha := substr(:P163_FEC_INI,1,2)||'/'||
                                                      substr(:P163_FEC_INI,3,2)||'/'||
                                                      lpad(substr(:P163_FEC_INI,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P163_FEC_INI := conv_fecha;
                            ELSIF (length(:P163_FEC_INI) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P163_FEC_INI) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P163_FEC_INI
                itemsToReturn: P163_FEC_INI
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-facturas-de-venta-2
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-grid (
        name: REFRESH GRID
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: [
                P163_TIP_COMPROBANTE
                P163_SER_COMPROBANTE
                P163_NRO_COMPROBANTE
                P163_FEC_INI
                P163_FEC_FIN
                P163_CLIENTE
                P163_RUC_CLIENTE
                P163_COND_VENTA
                P163_ANULADO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-facturas-de-venta-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction resaltar-fila (
        name: Resaltar Fila
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @lista-de-facturas-de-venta-2
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //En el headers ponemos el Static ID de la columna que queramos comparar
                    $('td[headers="Estado"]').each(function() {  
                    
                      if ( $(this).text() == 'COBRADO' ) {
                    
                    //    $(this).closest('tr').find('td').css({"background-color":"rgb(37 90 185 / 68%)"});
                    
                          $(this).closest('tr').find('td').css({"color":"#13bd4b"});
                    
                          $(this).closest('tr').find('td').css({"font-weight":"bold"});
                    
                          $(this).closest('tr').find('td').css({"border":"1px solid #D6EAF8  !important"});
                    
                      }
                    
                      if ( $(this).text() == 'PENDIENTE' ) {
                    
                    //    $(this).closest('tr').find('td').css({"background-color":"rgb(37 90 185 / 68%)"});
                    
                          $(this).closest('tr').find('td').css({"color":"#f26555"});
                    
                          $(this).closest('tr').find('td').css({"font-weight":"bold"});
                    
                          $(this).closest('tr').find('td').css({"border":"1px solid #D6EAF8  !important"});
                    
                      }
                    
                      if ( $(this).text() == 'COBRO PARCIAL' ) {
                    
                    //    $(this).closest('tr').find('td').css({"background-color":"rgb(37 90 185 / 68%)"});
                    
                          $(this).closest('tr').find('td').css({"color":"#decd18"});
                    
                          $(this).closest('tr').find('td').css({"font-weight":"bold"});
                    
                          $(this).closest('tr').find('td').css({"border":"1px solid #D6EAF8  !important"});
                    
                      }
                    
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    computation p163-ser-comprobante (
        itemName: P163_SER_COMPROBANTE
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_ser varchar2(7);
                V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                select SER_COMPROBANTE
                INTO v_ser
                 from BSW_SERIES_COMPROB t 
                 WHERE
                ID_EMPRESA=:P0_COD_EMPRESA AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                AND TERMINAL=V_IP_MAQUINA
                AND TIP_COMPROBANTE=W_BUSCA_PARAMETRO(NULL,'TIPO_COMPROBANTE_VENTA')
                AND IND_ACTIVO='S';
                RETURN v_ser;
                EXCEPTION
                WHEN NO_DATA_FOUND THEN
                return null;
                WHEN OTHERS THEN
                 RETURN null; 
                END;
                ```
        }
    )

    computation p163-traer-ip (
        itemName: P163_TRAER_IP
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL;
        }
    )

)

