        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Lista de Facturas de Venta
        }

        savedReport 196915 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ASIENTOS (
                sequence: 19
            )

            displayColumn COMENTARIO (
                sequence: 11
            )

            displayColumn DESCUENTO (
                sequence: 13
            )

            displayColumn ESTADO (
                sequence: 17
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 4
            )

            displayColumn ID_CONDICION_VENTA (
                sequence: 6
            )

            displayColumn ID_MONEDA (
                sequence: 8
            )

            displayColumn ID_MOV_CAJ (
                sequence: 15
            )

            displayColumn IND_REQUIERE_TRIPTICO (
                sequence: 16
            )

            displayColumn LINK (
                sequence: 18
            )

            displayColumn NOM_CLIENTE (
                sequence: 5
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 3
            )

            displayColumn NRO_OCC (
                sequence: 9
            )

            displayColumn NRO_TIMBRADO (
                sequence: 14
            )

            displayColumn RUC_CLIENTE (
                sequence: 12
            )

            displayColumn SER_COMPROBANTE (
                sequence: 2
            )

            displayColumn TIP_CAMBIO (
                sequence: 10
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 1
            )

            displayColumn TOT_COMPROBANTE (
                sequence: 7
            )

            sort (
                column: FEC_COMPROBANTE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

