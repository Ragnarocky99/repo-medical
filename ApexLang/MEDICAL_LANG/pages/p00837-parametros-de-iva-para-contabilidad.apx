                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 78506539711731793
        }

        savedReport 785070 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

