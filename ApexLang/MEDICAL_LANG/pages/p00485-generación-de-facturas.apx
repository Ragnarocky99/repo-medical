    dynamicAction cambiar-sesion (
        name: Cambiar Sesion
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P485_LV_TALONARIOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: "  DBMS_LOCK.sleep(seconds => 0.1);"
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_SERIE CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_SERIE) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_SERIE);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_SERIE);
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_SERIE,
                        p_c001 => :P485_LV_TALONARIOS,
                        p_c002 => :P485_SER_COMPROBANTE
                         );
                    END;
                    ```
                itemsToSubmit: [
                    P485_LV_TALONARIOS
                    P485_SER_COMPROBANTE
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pedidos
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-total (
        name: Cargar Total
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P485_NRO_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IF :P485_NRO_COMPROBANTE IS NOT NULL THEN
                    SELECT TOT_COMPROBANTE
                    INTO :P485_TOT_COMPROBANTE
                    FROM VTW_PEDIDOS_CABECERA
                    WHERE TIP_COMPROBANTE='PED'
                    AND  SER_COMPROBANTE='A'
                    AND  NRO_COMPROBANTE=:P485_NRO_COMPROBANTE;
                    END IF;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el pedido');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el pedido'||sqlerrm);
                    end;
                    ```
                itemsToSubmit: P485_NRO_COMPROBANTE
                itemsToReturn: P485_TOT_COMPROBANTE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P485_FEC_COMPROBANTE_HASTA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P485_FEC_COMPROBANTE_HASTA) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P485_FEC_COMPROBANTE_HASTA,'/','');
                            conv_fecha := substr(:P485_FEC_COMPROBANTE_HASTA,1,2)||'/'||
                                                      substr(:P485_FEC_COMPROBANTE_HASTA,3,2)||'/'||
                                                      lpad(substr(:P485_FEC_COMPROBANTE_HASTA,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P485_FEC_COMPROBANTE_HASTA := conv_fecha;
                    
                           ELSIF (length(:P485_FEC_COMPROBANTE_HASTA) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P485_FEC_COMPROBANTE_HASTA) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P485_FEC_COMPROBANTE_HASTA
                itemsToReturn: P485_FEC_COMPROBANTE_HASTA
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

