    region remision (
        name: Remision
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  CAB.ID,
                        CAB.TIP_ENT_SAL,
                        CAB.SER_ENT_SAL,
                        CAB.NUM_ENT_SAL,
                        CAB.FEC_ENT_SAL,
                        CAB.ID_PEDIDO
                FROM    STW_ENTSAL_CAB CAB,
                        BSW_SERIES_COMPROB SER
                WHERE   SER.ID = CAB.ID_SERIE_COMP
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @pedidos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 57742878519774822
        }

        savedReport 646015 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @TIP_ENT_SAL
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SER_ENT_SAL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @NUM_ENT_SAL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @FEC_ENT_SAL
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID_PEDIDO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @VER
                layout {
                    sequence: 7
                }
            )

        )

        column FEC_ENT_SAL (
            type: displayOnly
            heading {
                heading: <p>Fecha</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: FEC_ENT_SAL
                dataType: date
            }
        )

