    region pedidos (
        name: Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select P.ID,
                       P.ID_EMPRESA,
                       P.ID_SUCURSAL,
                       NVL(P.ESTADO,'P') AS ESTADO,
                       NVL(P.ESTADO_FAC,'P') AS ESTADO_FAC,
                       P.TIP_COMPROBANTE,
                       P.SER_COMPROBANTE,
                       P.NRO_COMPROBANTE,
                       P.FEC_COMPROBANTE,
                       P.ID_CLIENTE,
                       P.ID_VENDEDOR,
                       P.ID_MONEDA,
                       P.TIP_CAMBIO,
                       P.CAMBIO_MONEDA_PRECIO,
                       P.ID_CONDICION_VENTA,
                       P.ID_LISTA_PRECIO,
                       P.TOT_COMPROBANTE,
                       P.DESCUENTO,
                       'COBRO',
                       'REMISION',
                       /*E.SER_ENT_SAL||'-'||LPAD(E.NUM_ENT_SAL,7,'0')*/NULL AS REFERENCIA_REMISION,
                       /*E.ID*/NULL AS ID_REMISION,---,
                    ---CO.ID_ARTICULO,
                    ---CO.CANTIDAD,
                     (SELECT LISTAGG( DISTINCT CA.NRO_OCC,'|')
                        FROM CMW_COTIZA_ARTICULOS CA
                       WHERE ID_PEDIDO = P.ID
                         AND OBTENER_ESTADO_OCC_CRM(CA.ID, CA.ID_ARTICULO, CA.ID_PEDIDO, CA.ID_PEDIDO_DET) != 'Anulado'
                     ) as NRO_OCC,
                     ESTADO_FAC_PED(P.ID) AS ESTADO_FACTURACION,
                     CASE ESTADO_FAC_PED(P.ID) 
                     WHEN 'Facturado Parcialmente' then 'yellow'
                     WHEN 'Facturado Total' THEN 'green'
                     WHEN 'Pendiente a Facturar' THEN 'red'
                     END AS ESTADO_FAC_COLOR,
                     ESTADO_REM_PED(P.ID) AS ESTADO_REMISION,
                     CASE ESTADO_REM_PED(P.ID) 
                     WHEN 'Remisión Parcial' then 'yellow'
                     WHEN 'Remisión Total' THEN 'green'
                     WHEN 'Pendiente a Remisionar' THEN 'red'
                     END AS ESTADO_REM_COLOR,
                     APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p='|| v('APP_ID') ||':603:'||v('APP_SESSION')||'::NO::P603_SERIE_COMPROBANTE,P603_ID_PEDIDO:' || :P485_SER_COMPROBANTE || ',' || P.ID,
                        p_checksum_type => 'SESSION') AS GENERA_REMISION_URL
                
                  from VTW_PEDIDOS_CABECERA P
                  LEFT JOIN STW_ENTSAL_CAB E   ON P.ID=E.ID_PEDIDO---,CMW_COTIZA_ARTICULOS CO 
                  WHERE P.ID_EMPRESA=:P0_ID_EMPRESA
                  AND (P.ID_CLIENTE=:P485_CLIENTE OR :P485_CLIENTE IS NULL)
                  AND (P.ID_VENDEDOR=:P485_VENDEDOR OR :P485_VENDEDOR IS NULL)
                  --AND (P.ID_SUCURSAL=:P485_SUCURSAL OR :P485_SUCURSAL IS NULL)
                  AND P.ID_SUCURSAL = :P0_ID_SUCURSAL
                  AND (P.NRO_COMPROBANTE=:P485_NRO_COMPROBANTE OR :P485_NRO_COMPROBANTE IS NULL)
                  AND (P.FEC_COMPROBANTE BETWEEN TO_DATE(:P485_FEC_COMPROBANTE_DESDE,'DD/MM/YYYY')
                  AND TO_DATE(:P485_FEC_COMPROBANTE_HASTA,'DD/MM/YYYY'))
                  --AND ((NVL(ESTADO_FAC,'P') = :P485_ESTADO or NVL(P.ESTADO,'P')=:P485_ESTADO  or :P485_ESTADO is null ))
                  AND (ESTADO_FAC_PED(P.ID) = :P485_ESTADO or ESTADO_FAC_PED(P.ID)=:P485_ESTADO  or :P485_ESTADO is null )
                  /*or(NVL(ESTADO_FAC,'P') = 'F' and (C.id_mov_caj is null and :P485_ESTADO= 'PC') 
                  or(C.id_mov_caj is not null and :P485_ESTADO= 'C')))*/
                  AND (:P485_NRO_OCC IS NULL OR :P485_NRO_OCC IN (SELECT NRO_OCC FROM CMW_COTIZA_ARTICULOS CA WHERE CA.ID_PEDIDO = P.ID))
                  AND AUTORIZA_STOCK='S'
                  AND AUTORIZA_CTACTE='S'
                  AND P.AUTORIZA_FACTURA = 'S'
                  AND (ESTADO_FAC_PED(P.ID)!='Facturado Total')
                  AND P.ID IN (
                      SELECT CO.ID_PEDIDO
                        FROM CMWV_COTIZACIONES CO
                       WHERE CO.ID_PEDIDO = P.ID
                         AND CO.ESTADO_OCC = 'Pendiente'
                         AND CO.CANTIDAD_APROBADA - CO.CANT_ANULADA > 0
                         AND CO.CANT_RESERVADA > 0
                  )
                --   AND EXISTS (
                --       SELECT 1
                --         FROM VTW_PEDIDOS_DETALLE D
                --        WHERE D.ID_PEDIDO_CABECERA = P.ID
                --          AND EXISTENCIA_ACTUAL(P_ID_SUCURSAL => P.ID_SUCURSAL,
                --                                P_ID_ARTICULO => D.ID_ARTICULO,
                --                                P_ID_EMPRESA => :P0_ID_EMPRESA,
                --                                P_IND_CONSOLIDADO => 'N') > 0
                --   )
                 
                  --and (P.ID NOT IN (14100, 13860, 14781, 14460, 14768, 14801, 15970, 16010, 17320, 17313, 17314, 17319, 18973, 17315, 17316,24672,16490,17351))
                  -- Los pedidos de arriba son muy viejos, y era urgente solucionarlo, verguenza.
                 --- AND CO.ID_EMPRESA = P.ID_EMPRESA
                 --- AND CO.ID_PEDIDO = P.ID
                 
                 GROUP BY P.ID,
                       P.ID_EMPRESA,
                       P.ID_SUCURSAL,
                       NVL(P.ESTADO,'P'),
                       NVL(P.ESTADO_FAC,'P') ,
                       P.TIP_COMPROBANTE,
                       P.SER_COMPROBANTE,
                       P.NRO_COMPROBANTE,
                       P.FEC_COMPROBANTE,
                       P.ID_CLIENTE,
                       P.ID_VENDEDOR,
                       P.ID_MONEDA,
                       P.TIP_CAMBIO,
                       P.CAMBIO_MONEDA_PRECIO,
                       P.ID_CONDICION_VENTA,
                       P.ID_LISTA_PRECIO,
                       P.TOT_COMPROBANTE,
                       P.DESCUENTO,
                       'COBRO',
                       'REMISION',
                       /*E.ID*/NULL,---,
                    ---CO.ID_ARTICULO,
                    ---CO.CANTIDAD,
                     ESTADO_FAC_PED(P.ID),
                     CASE ESTADO_FAC_PED(P.ID) 
                     WHEN 'Facturado Parcialmente' then 'yellow'
                     WHEN 'Facturado Total' THEN 'green'
                     WHEN 'Pendiente a Facturar' THEN 'red'
                     END ,
                     APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p='|| v('APP_ID') ||':603:'||v('APP_SESSION')||'::NO::P603_SERIE_COMPROBANTE,P603_ID_PEDIDO:' || :P485_SER_COMPROBANTE || ',' || P.ID,
                        p_checksum_type => 'SESSION') 
                ```
            pageItemsToSubmit: [
                P485_VENDEDOR
                P485_FEC_COMPROBANTE_DESDE
                P485_FEC_COMPROBANTE_HASTA
                P485_SUCURSAL
                P485_CLIENTE
                P485_NRO_COMPROBANTE
                P485_ESTADO
                P485_NRO_OCC
                P485_SER_COMPROBANTE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        advanced {
            htmlDomId: detalles
            regionDisplaySelector: true
        }
        edit {
            enabled: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 60253531883847638
        }

