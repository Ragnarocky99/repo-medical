    dynamicAction abrir-lv (
        name: Abrir LV
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @talonario
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P485_LV_TALONARIOS_lov_btn').click();
            }
            execution {
                sequence: 10
