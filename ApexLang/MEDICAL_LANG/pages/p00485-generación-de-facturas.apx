    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :CANTIDAD_A_ENTREGAR <= :CANTIDAD_PENDIENTE
        }
        error {
            errorMessage: La cantidad a entregar no puede ser mayor que la cantidad pendiente!!
        }
    )

    validation new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :CANTIDAD_PENDIENTE < :CATNTIDAD_ENTREGADA
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
        }
    )

    validation new-3 (
        name: New_2
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  l_cantidad_a_entregar NUMBER := :CANTIDAD_A_ENTREGAR; -- Reemplaza PXX_CANTIDAD_A_ENTREGAR con el nombre de tu item de cantidad a entregar.
                  l_cantidad_pendiente NUMBER := :CANTIDAD_PENDIENTE; -- Reemplaza PXX_CANTIDAD_PENDIENTE con el nombre de tu item de cantidad pendiente.
                BEGIN
                  IF l_cantidad_a_entregar > l_cantidad_pendiente THEN
                    RETURN FALSE; -- La validación fallará si la cantidad a entregar es mayor que la cantidad pendiente.
                  ELSE
                    RETURN TRUE; -- La validación es exitosa si la cantidad a entregar es menor o igual a la cantidad pendiente.
                  END IF;
                END;
                ```
        }
        error {
            errorMessage: La cantidad a entregar no puede ser mayor a la cantidad pendiente!!
        }
    )

