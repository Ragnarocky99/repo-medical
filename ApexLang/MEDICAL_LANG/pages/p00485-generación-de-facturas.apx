page 485 (
    name: Generación de Facturas
    alias: GENERACIÓN-DE-FACTURAS
    title: Generación de Facturas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .totalespp{
                font-weight: bold;
                font-size: large;
                   color: #365ee4;
              background-color: #d7d7d7;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #585151;
            }
            
            .fact{
                font-weight: bold;
                font-size: large;
                   color: #5c5c5c;
              background-color: #f0f0f0;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #526fac;
            }
            
            
            .a-danger{
                background-color: #f44336;
            }
            
            .totales{
                text-align: center;
                font-size: medium;
            }
            .comprobante{
              pointer-events: none;
              color: #000000;
              background-color: #e0e0e0;
              box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.075);
              border-style:solid;
              border-color: #a8a8a8;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedido-detalle (
        name: Pedido Detalle
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CAB.ID,
                       CAB.ID_PEDIDO_REF,
                       CAB.TIP_COMPROBANTE,
                       SER.SER_TIMBRADO,
                       CAB.NRO_COMPROBANTE,
                       CAB.FEC_COMPROBANTE
                  from VTW_COMPROBANTES_CABECERA CAB
                  JOIN BSW_SERIES_COMPROB SER ON SER.ID = ID_SERIE_COMP
                  ---WHERE NRO_OCC <> 0
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @pedidos
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 41712596554995314
        }

