    dynamicAction remision-state (
        name: remision state
        execution {
            sequence: 180
        }
        when {
            event: click
            selectionType: columns
            interactiveGrid: @pedidos
            columns: 'REMISION'
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var valorReferencia = apex.region("detalles").widget().interactiveGrid('getSelectedRecords')[0]['REFERENCIA'];
                    
                    if (valorReferencia != null && valorReferencia.trim() !== '') {
                        $('#remision_icon').hide(); // o deshabilita el botón si es un botón
                    } else {
                        $('#remision_icon').show(); // o habilita el botón si es un botón
                    }
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action obtiene-url-por-fila (
            name: obtiene url por fila
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                    
                    //"myGrid1" should be the static id of the IG region
                    var widget          = apex.region("detalles").widget();
                    var grid            = widget.interactiveGrid("getViews","grid");  
                    var model           = grid.model;
                    var selectedRecords = grid.getSelectedRecords();
                    
                    for (idx = 0; idx < selectedRecords.length; idx++) {
                    
                        record = model.getRecord(selectedRecords[idx][1]);
                        //console.log("record " + record);
                    
                        let value1 = model.getValue(record,"GENERA_REMISION_URL");
                        console.log(value1);
                    
                        apex.item("P485_JS_URL").setValue(value1);
                    
                        //javascript: window.location.href = model.getValue(record,"GENERA_REMISION_URL");
                    }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

