        settings {
            basedOn: lov
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT FECHA||' '||PE.NOMB_FANTASIA D, AG.ID R
                  FROM CLW_AGENDA   AG
                  JOIN CCW_CLIENTES CL ON CL.ID = AG.ID_CLIENTE
                  JOIN BSW_PERSONAS PE ON PE.ID = CL.ID_PERSONA
                ```
        }
        layout {
