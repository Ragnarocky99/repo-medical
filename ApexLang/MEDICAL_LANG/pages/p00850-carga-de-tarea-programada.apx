page 850 (
    name: Carga de Tarea Programada
    alias: CARGA-DE-TAREA-PROGRAMADA
    title: Carga de Tarea Programada
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-gestor-de-tarea (
        name: Carga de Gestor de Tarea
        type: form
        source {
            location: localDatabase
            tableName: CLW_GESTOR_TAREAS
        }
        layout {
            sequence: 20
            parentRegion: @carga-de-tarea-programada
            slot: regionBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression:
                ```plsql
                :P850_IND_FINALIZADO = 'S' AND
                TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) NOT IN ('DIR', 'ADMIN')
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region carga-de-tarea-programada (
        name: Carga de Tarea Programada
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CLW_GESTOR_TAREAS_PROG
            whereClause: ID_GESTOR_TAREA = :P850_ID
