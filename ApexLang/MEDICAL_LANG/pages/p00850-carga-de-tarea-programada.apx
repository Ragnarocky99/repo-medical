            item: P850_ID
        }
    )

    computation p850-nro-tarea (
        itemName: P850_NRO_TAREA
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(NRO_TAREA), 0) + 1
                  FROM CLW_GESTOR_TAREAS
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P850_ID
        }
    )

    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        execution {
            sequence: 40
        }
        advanced {
