page 171 (
    name: Mantenimiento de Entrada/Salida de Artículos
    alias: MANTENIMIENTO-DE-ENTRADA-SALIDA-DE-ARTÍCULOS
    title: Mantenimiento de Entrada/Salida de Artículos
    appearance {
