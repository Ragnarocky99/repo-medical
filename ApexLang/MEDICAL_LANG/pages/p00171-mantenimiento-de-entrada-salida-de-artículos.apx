    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('ST','ID_MODULO_ST'),:P171_FEC_ENT_SAL) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P171_FEC_ENT_SAL
        }
    )

    computation p171-asientos-id (
        itemName: P171_ASIENTOS_ID
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                select id 
                from cow_diario_cabeceras_prov
                where num_asiento  = to_number(replace(replace(:P171_ASIENTOS,'stock',''),'*',''))
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P171_FEC_ENT_SAL);
                ```
        }
    )

    computation p171-num-ent-sal (
        itemName: P171_NUM_ENT_SAL
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                /*DECLARE
                v_nro_comprobante STW_ENTSAL_CAB.NUM_ENT_SAL%TYPE;
                   
                   begin
                   if :P171_NUM_ENT_SAL is null then
                      select nvl( max( num_ent_sal ), 0 ) + 1
                         into v_nro_comprobante
                         from stW_entsal_cab
                         where ID_EMPRESA = :P0_COD_EMPRESA
                         AND :P171_SER_ENT_SAL = SER_ENT_SAL ;
                       RETURN v_nro_comprobante;
                      end if; 
                      RETURN :P171_NUM_ENT_SAL;
                   exception
                      when no_data_found then
                        v_nro_comprobante  := 1 ;
                        RETURN v_nro_comprobante;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de entrada/salida de artículos (cabecera)' || sqlerrm ) ;
                   end ;*/
                DECLARE
                v_nro_entsal STW_ENTSAL_CAB.NUM_ENT_SAL%TYPE;
                BEGIN
                IF :P171_NUM_ENT_SAL IS  NULL THEN
                SELECT NVL(MAX(NUM_ENT_SAL),0)+1
                INTO v_nro_entsal
                FROM
                STW_ENTSAL_CAB 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA;
                RETURN v_nro_entsal;
                END IF;
                 RETURN v_nro_entsal;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                v_nro_entsal:=1;
                RETURN v_nro_entsal;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
        serverSideCondition {
            type: never
        }
    )

