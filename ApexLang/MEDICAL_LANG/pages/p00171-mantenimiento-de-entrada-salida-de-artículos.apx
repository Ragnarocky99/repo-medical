                               COSTO_C_IVA=replace(:COSTO_C_IVA,'.',''),
                               NRO_ORDEN=:NRO_ORDEN,
                               OBSERVACION=:OBSERVACION,
                               DESC_ARTICULO=:DESC_ARTICULO,
                               ID_IVA=:ID_IVA,
                               TOTAL_COSTO=replace(:TOTAL_COSTO,'.',''),
                               ID_BARRA = :ID_BARRA
                               WHERE ID=:ID  AND
                               ID_ENTSAL_CAB=:P171_ID;
                
                           when 'D' then
                           
                                  delete stw_entsal_det d     
                                WHERE d.ID_ENTSAL_CAB = :ID_ENTSAL_CAB
                                           and d.id = :id;  
                    end case;
                                         
                
                END;
                
