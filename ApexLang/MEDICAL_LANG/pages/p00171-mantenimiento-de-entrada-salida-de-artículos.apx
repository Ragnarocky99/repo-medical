    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: items
            items: P171_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P171_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P171_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P171_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P171_URL
                    P171_ASIENTOS_ID
                ]
                itemsToReturn: P171_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P171_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P171_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cambiar-montos (
        name: Cambiar Montos
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: [
                CANTIDAD
                COSTO_C_IVA
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :CANTIDAD IS NULL THEN 
                    :CANTIDAD:=1;
                    END IF;
                    
                    IF :COSTO_C_IVA IS NULL THEN
                    :COSTO_C_IVA:=0;
                    END IF;
                    
                    
                    :TOTAL_COSTO:=:CANTIDAD*replace(:COSTO_C_IVA,'.','');
                    
                    
                    
                    
                    
                    
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    COSTO_C_IVA
                ]
                itemsToReturn: TOTAL_COSTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    recalculaTotales();
                    
                    
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P171_TOTAL_CANTIDAD
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: items
                items: P171_TOTALES
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD
                itemsToSubmit: CANTIDAD
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_OCULTO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-de-articulo (
        name: Cargar datos de articulo
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @entsal-det
            columns: ID_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT NRO_LOTE,ID
                    INTO :NRO_LOTE,:ID_LOTE
                    FROM STW_LOTES
                    WHERE ID_ARTICULO=:ID_ARTICULO
                    and rownum=1;
                    END;
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: [
                    ID_LOTE
                    NRO_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    grid.gotoCell(array[0][0],'COD_ARTICULO');
                    
                    ```
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P171_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: 1
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT STW_RECUPERA_COSTO(:P0_COD_EMPRESA,:ID_ARTICULO,W_BUSCA_PARAMETRO('BS','COD_MONEDA_GS'),TO_DATE(SYSDATE,'DD/MM/YYYY'))FROM DUAL;
                    
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: COSTO_C_IVA
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value-4 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_id_unidad_medida number(18);
                    begin
                    SELECT ID_UNIDAD_MEDIDA 
                    INTO V_ID_UNIDAD_MEDIDA
                    FROM 
                    STW_ARTICULOS 
                    WHERE ID=:ID_ARTICULO;
                    RETURN V_ID_UNIDAD_MEDIDA;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    NULL;
                    WHEN OTHERS THEN
                    NULL;
                    end;
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_UNIDAD_MEDIDA
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-5 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_id_iva number(18);
                    begin
                    select id_iva 
                    into v_id_iva
                    from stw_articulos
                    where id=:id_articulo;
                    return v_id_iva;
                    end;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    NULL;
                    WHEN OTHERS THEN 
                    NULL;
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: ID_IVA
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value-6 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COD_ARTICULO FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: columns
                columns: COD_ARTICULO
            }
            execution {
                sequence: 70
                fireOnInit: false
