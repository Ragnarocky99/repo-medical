    process eliminar-detalle (
        name: Eliminar Detalle
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* Borra todas las lineas de detalle, al borrarse la cabecera  */
                delete from STW_ENTSAL_DET   
                where id_ENTSAL_CAB = :P171_ID;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 38584143049069715
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process entsal-det-save-interactive-grid-data (
        name: ENTSAL_DET - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @entsal-det
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                             
                             
                
                             
                                insert into STW_ENTSAL_DET
                                (ID_EMPRESA,ID_SUCURSAL,ID_ENTSAL_CAB,ID_ARTICULO,CANTIDAD,ID_UNIDAD_MEDIDA,NRO_LOTE,ID_LOTE,ID_CENTRO_COSTO,COSTO_C_IVA,NRO_ORDEN,
                                COD_USUARIO_AUD,OBSERVACION,DESC_ARTICULO,ID_IVA,TOTAL_COSTO, ID_BARRA)
                                values(:P0_COD_EMPRESA,:P171_ID_SUCURSAL,:P171_ID,:ID_ARTICULO,:CANTIDAD,:ID_UNIDAD_MEDIDA,:NRO_LOTE,:ID_LOTE,:ID_CENTRO_COSTO,REPLACE(:COSTO_C_IVA,'.',''),:NRO_ORDEN,
                                :COD_USUARIO_AUD,:OBSERVACION,:DESC_ARTICULO,:ID_IVA,REPLACE(:TOTAL_COSTO,'.',''), :ID_BARRA);
                            
                            WHEN 'U' then  
                               
                               UPDATE STW_ENTSAL_DET 
                               SET ID_ARTICULO=:ID_ARTICULO,
                               CANTIDAD=:CANTIDAD,
