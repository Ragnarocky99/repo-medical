    region entsal-det (
        name: ENTSAL_DET
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_EMPRESA,
                       D.ID_SUCURSAL,
                       D.ID_ENTSAL_CAB,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.COSTO,
                       D.CANTIDAD,
                       D.CANTIDAD AS CANTIDAD_OCULTO,
                       D.OBSERVACION,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.ID_LOTE,
                       D.ID_REF_DET,
                       D.ID_CENTRO_COSTO,
                       D.COSTO_UNIDAD_ACTUAL,
                       D.PRECIO,
                       D.ESTADO,
                       D.COSTO_C_IVA,
                       D.NRO_ORDEN,
                       D.DESC_ARTICULO,
                       D.ID_IVA,
                       D.TOTAL_COSTO,
                       D.ID_BARRA
                  from STW_ENTSAL_DET d,STW_ARTICULOS A
                 where ID_ENTSAL_CAB=:P171_ID
                 AND A.ID=D.ID_ARTICULO
                
                ```
            pageItemsToSubmit: P171_ID
        }
        layout {
            sequence: 10
            parentRegion: @cabecera-entsal
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
