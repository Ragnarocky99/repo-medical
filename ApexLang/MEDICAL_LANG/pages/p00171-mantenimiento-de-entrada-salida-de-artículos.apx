    pageItem P171_NUM_ENT_SAL (
        type: numberField
        label {
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @page_plug
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 4
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: NÚMERO
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @cabecera-entsal
            column: NUM_ENT_SAL
            dataType: number
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_nro_entsal STW_ENTSAL_CAB.NUM_ENT_SAL%TYPE;
                BEGIN
                    IF :P171_NUM_ENT_SAL IS  NULL THEN
                        SELECT NVL(MAX(NUM_ENT_SAL),0)+1
                            INTO v_nro_entsal
                        FROM STW_ENTSAL_CAB 
                        WHERE ID_EMPRESA=:P0_COD_EMPRESA;
                        RETURN v_nro_entsal;
                    END IF;
                    RETURN v_nro_entsal;
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            v_nro_entsal:=1;
                            RETURN v_nro_entsal;
                        WHEN OTHERS THEN 
                            RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                ```
        }
    )

