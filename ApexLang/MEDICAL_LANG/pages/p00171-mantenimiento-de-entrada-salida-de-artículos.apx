    region cabecera-entsal (
        name: Cabecera ENTSAL
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       TIP_ENT_SAL,
                       SER_ENT_SAL,
                       NUM_ENT_SAL,
                       FEC_ENT_SAL,
                       ID_MOTIVO_ENT_SAL,
                       ID_MONEDA,
                       ID_USUARIO,
                       FEC_INICIO,
                       COMENTARIO,
                       COD_USUARIO_AUD,
                       IND_ACTUALIZA_COSTO,
                       TIP_REFERENCIA,
                       SER_REFERENCIA,
                       NUM_REFERENCIA,
                       ID_REFERENCIA,
                       ID_PROVEEDOR,
                       ESTADO,
                       FECHA_ESTADO,
                       FAC_REFERENCIA,
                       ID_COMBO,
                       ID_FAC_GENERADA,
                       ID_REMISION,
                       REM_REFERENCIA,
                       ID_SUCURSAL_CENTRAL,
                       ID_ART_SERVICIO,
                       TOT_COSTO,
                       TOT_CANTIDAD,
                       FEC_LLEGADA,
                       TELEFONO,
                       ID_CLIENTE,
                       NRO_PEDIDO,
                       ID_CUIDAD_ENV,
                       ID_SUCURSAL_ENV,
                       DIR_ENV,
                       RUC_CLIENTE,
                       DIR_SAL,
                       FEC_ALTA,
                       ID_CHOFER,
                       CI_CHOFER,
                       TOTAL_CANT,
                       ID_PERSONA,
                       REPLACE(REPLACE(ASIENTOS,'*'),'stock') ASIENTOS
                  from STW_ENTSAL_CAB
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
