        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rentabilidad-x-articulo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 499
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

