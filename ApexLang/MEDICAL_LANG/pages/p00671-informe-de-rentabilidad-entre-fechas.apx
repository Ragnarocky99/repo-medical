    region rentabilidad-x-articulo (
        name: Rentabilidad x Articulo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.fec_comprobante,
                       C.ID_CLIENTE,
                       C.COD_CLIENTE,
                       C.DESC_CLIENTE,
                       C.DOC_CLIENTE,
                       C.ID_SUCURSAL,
                       C.DESC_SUCURSAL,
                       C.NRO_COMPROBANTE,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.ID_VENDEDOR,
                       C.DESC_VENDEDOR,
                       C.ID_ARTICULO,
                       C.cod_articulo,
                       C.DESC_ARTICULO,
                       C.DESC_MARCA,
                       C.DESC_GRUPO,
                       C.CANTIDAD,
                       C.VENTA_SIN_IVA,
                       C.COSTO_DE_VENTA,
                       C.utilidad,
                       c.id_envase,
                       c.id_unidad_medida
                
                FROM VTWV_RENTABILIDAD C
                     
                WHERE c.id_empresa         = :P0_ID_EMPRESA
                 and ( c.id_sucursal      = :P671_ID_SUCURSAL or :P671_ID_SUCURSAL  is null        )
                 and ( c.id_vendedor      =  :P671_ID_VENDEDOR or   :P671_ID_VENDEDOR is null        )
                 and (:P671_ID_RUBRO     is null or C.id_rubro     =  :P671_ID_RUBRO         )
                 and ( :P671_ID_FAMILIA      is null or C.id_familia   = :P671_ID_FAMILIA          )
                 ---and ( :P671_GRUPO      is null or C.id_grupo_art   = :P671_GRUPO          )
                 and ( :P671_ID_LINEA          is null or C.id_linea     = :P671_ID_LINEA            )
                 and ( :P671_ID_MARCA         is null or C.id_marca     = :P671_ID_MARCA            )
                 and ( :P671_COD_ARTICULO_DES   is null or C.cod_articulo    = :P671_COD_ARTICULO_DES    )
                ---- and (  :P671_COD_ARTICULO_HAS is null or art.cod_articulo    <=  :P671_COD_ARTICULO_HAS  )
                 and (  :P671_FEC_INICIAL      is null or c.fec_comprobante >= :P671_FEC_INICIAL        )
                 and ( :P671_FEC_FINAL         is null or c.fec_comprobante <= :P671_FEC_FINAL         )
                 and (C.id_CLIENTE       = :P671_ID_CLIENTE  or :P671_ID_CLIENTE  is null)
                 and (C.id_corporacion = :P671_ID_CORPORACION  or   :P671_ID_CORPORACION is null)
                 --and c.cod_articulo != '742' --articulo de migracion
                ```
            pageItemsToSubmit: [
                P671_ID_SUCURSAL
                P671_ID_LINEA
                P671_ID_CLIENTE
                P671_ID_MARCA
                P671_ID_CORPORACION
                P671_COD_ARTICULO_DES
                P671_ID_VENDEDOR
                P671_COD_ARTICULO_HAS
                P671_ID_RUBRO
                P671_FEC_INICIAL
                P671_FEC_FINAL
                P671_ID_FAMILIA
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 232185922866892791
        }

