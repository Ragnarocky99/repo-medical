    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P671_FEC_FINAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P671_FEC_FINAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P671_FEC_FINAL,'/','');
                            conv_fecha := substr(:P671_FEC_FINAL,1,2)||'/'||
                                                      substr(:P671_FEC_FINAL,3,2)||'/'||
                                                      lpad(substr(:P671_FEC_FINAL,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P671_FEC_FINAL := conv_fecha;
                            ELSIF (length(:P671_FEC_FINAL) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P671_FEC_FINAL) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P671_FEC_FINAL
                itemsToReturn: P671_FEC_FINAL
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P671_FEC_INICIAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P671_FEC_INICIAL) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P671_FEC_INICIAL,'/','');
                            conv_fecha := substr(:P671_FEC_INICIAL,1,2)||'/'||
