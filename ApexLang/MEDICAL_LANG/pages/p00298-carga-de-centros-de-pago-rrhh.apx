    pageItem P298_ID (
        type: hidden
        layout {
            sequence: 40
            region: @carga-de-centros-de-pago
            slot: regionBody
        }
        source {
            formRegion: @carga-de-centros-de-pago
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P298_ID_BARRIO (
        type: popupLov
        label {
            label: <p>Barrio: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT DESCRIPCION,ID FROM BSW_BARRIOS WHERE ID_PAIS=:P298_ID_PAIS AND ID_PROVINCIA=:P298_ID_PROVINCIA AND ID_CIUDAD=:P298_ID_CIUDAD
            nullDisplayValue: --Sin Seleccionar--
        }
        cascadingLov {
            parentItems: [
                P298_ID_PAIS
                P298_ID_PROVINCIA
                P298_ID_CIUDAD
            ]
            itemsToSubmit: [
                P298_ID_PAIS
                P298_ID_PROVINCIA
                P298_ID_CIUDAD
            ]
        }
        layout {
            sequence: 100
            region: @carga-de-centros-de-pago
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-centros-de-pago
            column: ID_BARRIO
            dataType: number
        }
    )

    pageItem P298_ID_CIUDAD (
        type: popupLov
        label {
            label: <p>Ciudad: &ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT DESCRIPCION, ID FROM BSW_CIUDADES WHERE ID_PROVINCIA = :P298_ID_PROVINCIA AND ID_PAIS = :P298_ID_PAIS;
            nullDisplayValue: --Sin seleccionar--
        }
        cascadingLov {
            parentItems: [
                P298_ID_PAIS
                P298_ID_PROVINCIA
            ]
            itemsToSubmit: [
                P298_ID_PAIS
                P298_ID_PROVINCIA
            ]
        }
        layout {
            sequence: 80
            region: @carga-de-centros-de-pago
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-centros-de-pago
            column: ID_CIUDAD
            dataType: number
        }
    )

