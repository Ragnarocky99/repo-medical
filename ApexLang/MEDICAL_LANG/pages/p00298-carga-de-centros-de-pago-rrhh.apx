page 298 (
    name: Carga de Centros de Pago RRHH
    alias: CARGA-DE-CENTROS-DE-PAGO-RRHH
    title: Carga de Centros de Pago
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-centros-de-pago (
        name: Carga de Centros de Pago
        type: form
        source {
            location: localDatabase
            tableName: RHW_CENTROS_PAGOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P298_COD_CENTRO_PAGO (
        type: displayOnly
        label {
            label: <p>Cód. Centro Pago: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @carga-de-centros-de-pago
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-centros-de-pago
            column: COD_CENTRO_PAGO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_CENTRO_PAGO)), 0) + 1 
                FROM RHW_CENTROS_PAGOS WHERE ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

    pageItem P298_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 150
            region: @carga-de-centros-de-pago
            slot: regionBody
        }
        source {
            formRegion: @carga-de-centros-de-pago
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P298_DESCRIPCION (
        type: textField
