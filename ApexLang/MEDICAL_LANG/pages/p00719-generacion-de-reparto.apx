    region solicitudes-reparto (
        name: Solicitudes REPARTO
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT SC.ID_CLIENTE,
                       SC.ID_PROVEEDOR, 
                       SC.FECHA_ENTREGA_SUG,
                       SC.CANTIDAD_CAJAS,
                       SC.ID ID_SOL_CAB,
                       SC.ID NRO_SOLICITUD,
                       SC.DIRECCION_ENVIO,
                       SC.ID_MOTIVO_REPARTO,
                       SC.FECHA_SOLICITUD,
                       SC.OBSERVACION,
                       'N' AS SELECCIONAR,
                       SC.COMENTARIO
                FROM RPW_SOLICITUD_REPARTO_CAB SC
                WHERE NVL(SC.ESTADO,'PE') != 'CA'
                AND EXISTS (SELECT 1
                FROM RPW_SOLICITUD_REPARTO_DET SD     
                WHERE SD.ID_SOLICITUD_REP_CAB = SC.ID    
                  AND NVL(SD.IND_CANCELADO,'N') != 'S'
                  AND NVL(SD.ESTADO,'XY') != 'EN'
                  -- QUE EXISTA UN DETALLE NO ENVIADO O NO CANCELADO.
                  AND NOT EXISTS (
                      SELECT 1 
                      FROM RPW_REPARTO_DETALLE RD 
                      JOIN RPW_REPARTO_CABECERA RC ON RC.ID = RD.ID_REPARTO_CABECERA
                      WHERE RD.ID_SOLICITUD_DET = SD.ID
                        AND NVL(RC.ESTADO,'N') = 'N' --QUE NO EXISTA EN UN REPARTO PENDIENTE A RENDIR
                  )
                )
                
                 AND EXISTS (
                     SELECT 1
                     FROM RPW_SOLICITUD_REPARTO_DET RDD   
                     WHERE RDD.ID_SOLICITUD_REP_CAB = SC.ID
                 )
                
                  AND SC.FECHA_SOLICITUD BETWEEN :P719_FEC_DESDE AND :P719_FEC_HASTA     
                  AND (SC.ID = :P719_NRO_REPARTO OR :P719_NRO_REPARTO IS NULL)
                ```
            pageItemsToSubmit: [
                P719_FEC_DESDE
                P719_FEC_HASTA
                P719_NRO_REPARTO
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Reparto
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
            selectFirstRow: false
        }
        messages {
            whenNoDataFound: No hay datos. Compruebe que haya seleccionado un cliente, una moneda y un vendedor.
        }
