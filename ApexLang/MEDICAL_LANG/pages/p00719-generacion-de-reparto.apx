    process crea-coleccion (
        name: Crea Coleccion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF APEX_COLLECTION.collection_exists('SOLICITUD_REPARTO') THEN
                   APEX_COLLECTION.delete_collection('SOLICITUD_REPARTO');
                END IF ;
                
                IF NOT APEX_COLLECTION.COLLECTION_EXISTS('SOLICITUD_REPARTO') THEN
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('SOLICITUD_REPARTO');
                END IF;
                
                --raise_application_Error(-20000,'hoola');
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 15891943432103419
        }
        serverSideCondition {
            whenButtonPressed: @generarreparto
        }
    )

    process genera-reparto (
        name: Genera Reparto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  RPW_GENERA_REPARTO(P_ID_REPARTIDOR => :P719_ID_REPARTIDOR,
                                     P_ID_VEHICULO => :P719_ID_VEHICULO,
                                     P_ID_ACOMPANHANTE => :P719_ID_ACOMPANHANTE,
                                     P_ID_ZONA => :P719_ID_ZONA,
                                     P_ID_EMPRESA => :P0_ID_EMPRESA,
                                     P_ID_SUCURSAL => :P0_ID_SUCURSAL,
                                     P_COD_USUARIO_AUD => :APP_USER,
                                     P_ID_REPARTO => :P719_ID_REPARTO);
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 15892173953103421
        }
        serverSideCondition {
            whenButtonPressed: @generarreparto
        }
    )

    process inicializacion (
        name: inicializacion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                :P719_ID_REPARTO := null;
                apex_collection.delete_collection('REMISION_FACTURA');
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 69206191239558960
        }
    )

    process inserta-coleccion (
        name: Inserta coleccion
        type: executeCode
        editableRegion: @solicitudes-reparto
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    --raise_application_Error(-20000,'hoola '||:ID_SOL_CAB);
                    IF :SELECCIONAR = 'S' THEN
                    APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name   => 'SOLICITUD_REPARTO',
                        P_N001              => :ID_SOL_CAB,
                        P_c001              => :APP_USER   -- Agregado para que sea por usuario. ~MR. 05/03/2025.
                    );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 15892061149103420
        }
        serverSideCondition {
            whenButtonPressed: @generarreparto
        }
    )

