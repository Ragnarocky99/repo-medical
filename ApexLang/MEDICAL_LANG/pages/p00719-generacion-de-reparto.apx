    dynamicAction grilla-init (
        name: grilla init
        execution {
            sequence: 170
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Reparto").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        $grid.setEditMode(true);
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction init (
        name: init
