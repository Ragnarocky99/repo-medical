    region consulta-de-compras-de-bienes (
        name: Consulta de Compras de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  --d.id_bien,
                        b.descripcion as bien,
                        c.REFERENCIA,
                        C.ID_EMPRESA as proveedor,
                        c.TIP_COMPROBANTE,
                        c.SER_COMPROBANTE,
                        c.NRO_COMPROBANTE,
                        c.FEC_COMPROBANTE,
                        d.descripcion,
                        b.mon_costo as costo_unitario,
                        d.cantidad, 
                        d.mon_costo,
                        d.mon_costo_ext,
                        c.ID_SUCURSAL,
                        c.ID_CENTRO,
                        c.ID_DEPARTAMENTO,
                        c.ID_SECCION,
                        c.ID_RESPONSABLE,
                        d.id
                from cow_mov_bienes_det d, 
                     cow_bienes_uso b,
                     cow_mov_bienes_cab c
                where d.id_movbien_cab = C.ID 
                  AND D.ID_BIEN = B.ID
                  AND C.TIP_COMPROBANTE = 'FAC'
                  AND (c.REFERENCIA = :P503_REFERENCIA OR :P503_REFERENCIA IS NULL)
                  and (c.ID_RESPONSABLE = :P503_PROVEEDOR OR :P503_PROVEEDOR IS NULL) --VERIFICAR
                ```
        }
        layout {
            sequence: 10
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 80245074009471928
        }

