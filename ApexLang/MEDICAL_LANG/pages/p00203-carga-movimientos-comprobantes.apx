page 203 (
    name: CARGA MOVIMIENTOS COMPROBANTES
    alias: CARGA-MOVIMIENTOS-COMPROBANTES
    title: CARGA MOVIMIENTOS COMPROBANTES
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P203_ID_MOV_CAJ").readOnly = true;
            document.getElementById("P203_ID_CLIENTE").readOnly = true;
            document.getElementById("P203_TIP_COMPROBANTE").readOnly = true;
            document.getElementById("P203_SER_COMPROBANTE").readOnly = true;
            document.getElementById("P203_NRO_COMPROBANTE").readOnly = true;
            document.getElementById("P203_ID_MONEDA").readOnly = true;
            document.getElementById("P203_FECHA_COMPROBANTE").readOnly = true;
            document.getElementById("P203_TOT_COMPROBANTE").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

