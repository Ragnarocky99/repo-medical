page 826 (
    name: AGENDA CRM
    alias: AGENDA-CRM
    title: AGENDA CRM
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region agenda-crm (
        name: Agenda CRM
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT AG.ID,
                       AG.FECHA,
                       AG.DISPLAY,
                       PREPARA_URL_CARGA(P_ID_EMPRESA      => AG.ID_EMPRESA,
                                         P_TIP_COMPROBANTE => AG.TIPO,
                                         P_ID              => AG.ID) URL,
                       AG.COLOR
                  FROM AGENDAS AG
                 WHERE AG.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (AG.COD_USUARIO = :APP_USER OR
                        TRAE_COD_GRUPO_USUARIO(:P0_ID_EMPRESA, :APP_USER) IN ('DIR', 'ADMIN') OR
                        TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER) MEMBER OF APEX_STRING.SPLIT_NUMBERS(AG.ID_INVOLUCTADOS, ':'))
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            displayColumn: DISPLAY
            startDateColumn: FECHA
            pkColumn: ID
            additionalCalendarViews: [
                list
                navigation
            ]
            createLink: {
                page: 809
                items: {
                    P809_FECHA: &APEX$NEW_START_DATE.
                }
                clearCache: Y
            }
            viewEditLink: {
                type: url
                url: &URL.
            }
            cssClass: COLOR
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region selector (
        name: Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            includeShowAll: false
        }
    )

    region tareas-pendientes (
        name: Tareas Pendientes
        type: cards
        source {
            location: localDatabase
            tableName: BSWV_TAREAS_PENDIENTES_GESTOR
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                COD_USUARIO = :APP_USER
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @cards-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        card {
            cssClasses: &COLOR!ATTR.
        }
        title {
            column: TITULO
        }
        body {
            advancedFormatting: true
            htmlExpression: &HTML_BODY!RAW.
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No hay tareas pendientes
        }
    )

    region tareas-vencidas (
        name: Tareas Vencidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT NRO_PEDIDO,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       ID_ENVASE,
                       ID_UNIDAD_MEDIDA,
                       ID_MARCA,
                       DEFINICION,
                       FEC_PROX_EVENTO,
                       PRECIO_UNITARIO,
                       PRECIO_TOTAL,
                       ESTADO_OCC,
                       ID_PEDIDO,
                       ID_PEDIDO_DET,
                       ID_CLIENTE,
                       ID_COTIZA_ART,
                       ID_ARTICULO,
                       RESPONSABLE,
                       FECHA_PLAZO,
                       ESTADO_PRODUCTO,
                       CLIENTE,
                       NRO_OCC,
                       NRO_OCP,
                       TIP_COMPROBANTE,
                       ID_OFERTA,
                       ID_APROBACION_LIC,
                       (SELECT SUM(EA.CANT_DISPON)
                          FROM STW_EXISTENCIA_ART EA
                         WHERE EA.ID_ARTICULO = TV.ID_ARTICULO
                           AND EA.CANT_DISPON > 0) STOCK,
                        TV.NIVEL,
                        TV.OBS_SEGUIMIENTO
                  FROM CMWV_TAREAS_VENCIDAS TV
                 WHERE COD_USUARIO_RESPONSABLE = :APP_USER
                   AND ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 638
                items: {
                    P638_ID_COTIZA_ART: #ID_COTIZA_ART#
                    P638_IND_VARIOS: N
                    P638_ID_APROBACION_LIC: #ID_APROBACION_LIC#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No hay tareas vencidas
        }
        advanced {
            savedReportMappingIdentifier: 100115070590977193
        }

