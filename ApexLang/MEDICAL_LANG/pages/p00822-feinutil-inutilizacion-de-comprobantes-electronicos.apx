    button ejecutar (
        buttonName: Ejecutar
        label: Ejecutar
        layout {
            sequence: 10
            region: @page_plug-2
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-right
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction inutilizar-comprobantes (
        name: Inutilizar Comprobantes
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @ejecutar
        }

        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    DECLARE
                        vMotivo VARCHAR2(2000) := REPLACE(:P822_MOTIVO,' ','_');
                    BEGIN
                        FEW_INUTILIZAR_COMPROBANTE(p_id_empresa             => :P0_ID_EMPRESA,
                                                   p_ambiente_sifen         => :P822_AMBIENTE_EJECUCION,
                                                   p_id_comprobante         => :P822_NRO_FACTURA,
                                                   p_nro_timbrado           => :P822_NRO_TIMBRADO,
                                                   p_nro_establecimiento    => :P822_ESTABLECIMIENTO,
                                                   p_punto_expedicion       => :P822_EXPEDICION,
                                                   p_tipo_comprobante       => :P822_TIP_COMPROBANTE,
                                                   p_motivo_anulacion       => :P822_MOTIVO,
                                                   p_nro_comprobante_des    => :P822_NRO_COMPROBANTE_DESDE,
                                                   p_nro_comprobante_has    => :P822_NRO_COMPROBANTE_HASTA,
                                                   p_respuesta              => :P822_RESPUESTA);
                    END;
                    ```
                itemsToSubmit: [
                    P822_AMBIENTE_EJECUCION
                    P822_TIP_COMPROBANTE
                    P822_NRO_TIMBRADO
                    P822_ESTABLECIMIENTO
                    P822_EXPEDICION
                    P822_NRO_COMPROBANTE_DESDE
                    P822_NRO_COMPROBANTE_HASTA
                    P822_MOTIVO
                ]
                itemsToReturn: P822_RESPUESTA
                errorMessage: #SQLERRM#
                extraOptions: [
                    showErrorAsAlert
                    showSpinnerProcessingIcon
                    escapeSpecialCharactersInMessages
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-datos (
        name: SETEAR_DATOS
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P822_NRO_FACTURA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ftc.tip_comprobante, V.NRO_TIMBRADO,  
                           lpad( substr( ser.ser_timbrado, 1, 3 ), 3, '0' ) establecimiento, --p4
                            lpad( substr( ser.ser_timbrado, 5, 3 ), 3, '0' ) punto,
                            v.nro_comprobante,
                            v.nro_comprobante nro_comprobante_hasta
                    FROM   VTW_COMPROBANTES_CABECERA V
                           JOIN BSW_SERIES_COMPROB SER ON SER.ID = V.ID_SERIE_COMP
                           join bsw_tipos_comprobantes tc on tc.id = ser.id_tip_comp
                           join FEW_TIPOS_COMPROBANTES FTC       ON FTC.ID_EMPRESA       = TC.ID_EMPRESA AND FTC.TIP_COMPROBANTE = TC.TIP_COMPROBANTE_FE
                    where v.id_empresa = :P0_ID_EMPRESA  
                    and   v.id  = :P822_NRO_FACTURA
                    and   v.tip_comprobante in ('FVE', 'NCR')
                    
                    union all
                    
                    SELECT tc.tip_comprobante, to_char(CC.NRO_TIMBRADO) as nro_timbrado,  
                           lpad( substr( ser.ser_timbrado, 1, 3 ), 3, '0' ) establecimiento, --p4
                            lpad( substr( ser.ser_timbrado, 5, 3 ), 3, '0' ) punto,
                            CC.NUM_ENT_SAL,
                            CC.NUM_ENT_SAL nro_comprobante_hasta
                    from  stw_entsal_cab cc
                    join  bsw_series_comprob ser on ser.id_empresa = cc.id_empresa
                                                and ser.tip_comprobante = cc.Tip_Ent_Sal
                                                and ser.ser_comprobante = cc.Ser_Ent_Sal
                    join bsw_tipos_comprobantes tc on tc.id = ser.id_tip_comp
                    join few_tipos_comprobantes fc on fc.id_empresa = tc.id_empresa and fc.tip_comprobante = tc.tip_comprobante_fe                               
                    where cc.id_empresa = :P0_ID_EMPRESA
                      and cc.id  = :P822_NRO_FACTURA
                      and cc.Tip_Ent_Sal = 'REM'
                    ```
                itemsToSubmit: P822_NRO_FACTURA
            }
            affectedElements {
                selectionType: items
                items: [
                    P822_TIP_COMPROBANTE
                    P822_NRO_TIMBRADO
                    P822_ESTABLECIMIENTO
                    P822_EXPEDICION
                    P822_NRO_COMPROBANTE_DESDE
                    P822_NRO_COMPROBANTE_HASTA
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction timbrado-ambiente (
        name: TIMBRADO_AMBIENTE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P822_AMBIENTE_EJECUCION
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P822_AMBIENTE_EJECUCION = 'PROD' THEN
                        :P822_NRO_TIMBRADO := PKGFE.PARAMETRO(:P0_ID_EMPRESA,'TIMBRADO_NUM_PROD');
                    
                    ELSIF :P822_AMBIENTE_EJECUCION = 'TEST' THEN
                        :P822_NRO_TIMBRADO := PKGFE.PARAMETRO(:P0_ID_EMPRESA,'TIMBRADO_NUM_TEST');
                    
                    END IF;
                    ```
                itemsToSubmit: P822_AMBIENTE_EJECUCION
                itemsToReturn: P822_NRO_TIMBRADO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

