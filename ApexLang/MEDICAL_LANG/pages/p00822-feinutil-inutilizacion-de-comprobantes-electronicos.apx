            label: <p>Nro. de Timbrado:</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @page_plug
            slot: regionBody
            alignment: left
            column: 3
            columnSpan: 8
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            cssClasses: no-pointer-g
            width: 30
        }
        advanced {
            cssClasses: comprobante
            customAttributes: tabindex="-1"
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P822_AMBIENTE_EJECUCION = 'PROD' THEN
                    RETURN PKGFE.PARAMETRO(:P0_ID_EMPRESA,'TIMBRADO_NUM_PROD');
                
                ELSIF :P822_AMBIENTE_EJECUCION = 'TEST' THEN
                    RETURN PKGFE.PARAMETRO(:P0_ID_EMPRESA,'TIMBRADO_NUM_TEST');
                
                END IF;
                ```
        }
