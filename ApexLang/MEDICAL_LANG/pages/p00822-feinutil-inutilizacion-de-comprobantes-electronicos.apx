            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION,TIP_COMPROBANTE FROM FEW_TIPOS_COMPROBANTES
                WHERE ID_EMPRESA=:P0_ID_EMPRESA
                --  AND TIP_COMPROBANTE IN ('REM','FVE','NCR')
                ```
        }
