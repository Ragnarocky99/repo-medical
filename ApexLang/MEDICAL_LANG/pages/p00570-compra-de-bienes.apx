page 570 (
    name: Compra de Bienes
    alias: COMPRA-DE-BIENES
    title: Compra de Bienes
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region compra-de-bienes (
        name: Compra de Bienes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT FEC_COMPROBANTE, 
                       TIP_COMPROBANTE, 
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_DEPARTAMENTO,
                       ID_RESPONSABLE,
                       MON_COSTO,
                       ID
                FROM COW_MOV_BIENES_CAB  
                WHERE TIP_COMPROBANTE = 'FAC'
                --ORDER BY FEC_COMPROBANTE desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 580
                items: {
                    P580_ID: #ID#
                }
            }
            linkIcon:
                ```
                <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
                
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 167106871150975353
        }

        column FEC_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Fec. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 34
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 84
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_DEPARTAMENTO (
            type: plainTextBasedOnLov
            heading {
                heading: <p>Departamento</p>
                alignment: center
            }
            lov {
                lov: @lv-departamentos-rrhh
            }
            layout {
                sequence: 54
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_RESPONSABLE (
            type: plainTextBasedOnLov
            heading {
                heading: <p>Responsable</p>
                alignment: center
            }
            lov {
                lov: @lv-responsables-bien
            }
            layout {
                sequence: 64
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column MON_COSTO (
            type: plainText
            heading {
                heading: <p>Total Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 94
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: T
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Nro. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 24
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column SER_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Ser. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TIP_COMPROBANTE (
            type: plainText
            heading {
                heading: <p>Tip. Comprobante</p>
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Compra de Bienes
        }

        savedReport 741013 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FEC_COMPROBANTE (
                sequence: 1
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 4
            )

            displayColumn SER_COMPROBANTE (
                sequence: 3
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @compra-de-bienes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 580
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

