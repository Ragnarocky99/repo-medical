page 795 (
    name: Historial Anulaciones - Cotizacion
    alias: HISTORIAL-ANULACIONES-COTIZACION
    title: Historial Anulaciones - Cotizacion
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
    )

    region historial-anulacion (
        name: Historial Anulacion
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CMWV_HISTORIAL_ANULACION
            whereClause:
                ```sql
                ID_EMPRESA = :P0_ID_EMPRESA AND
                FEC_ANULACION BETWEEN :P795_FEC_INI AND :P795_FEC_FIN
                ```
            orderByClause: FEC_ANULACION DESC
            pageItemsToSubmit: [
                P795_FEC_INI
                P795_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 52302043228847316
        }

        column CANT_ANULADA (
            type: plainText
            heading {
                heading: Cant. Anulada
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod. Articulo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_ANULA (
            type: plainText
            heading {
                heading: Anulado Por
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COMENTARIO_ANULACION (
            type: plainText
            heading {
                heading: Comentario Anulacion
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESC_ARTICULO (
            type: plainText
            heading {
                heading: Articulo/Catalogo
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column FEC_ANULACION (
            type: plainText
            heading {
                heading: Fecha Anulacion
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column FEC_COMPROBANTE (
            type: plainText
            heading {
                heading: Fec. Comprobante
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column FEC_OCC (
            type: plainText
            heading {
                heading: Fec. OCC
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ID_CLIENTE (
            type: hidden
            heading {
                heading: Id Cliente
            }
            layout {
                sequence: 110
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column NRO_COMPROBANTE (
            type: plainText
            heading {
                heading: Nro. PED/LIC
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column NRO_ITEM (
            type: plainText
            heading {
                heading: Nro. Item
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column NRO_OCC (
            type: plainText
            heading {
                heading: Nro. OCC
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column PRECIO_UNITARIO (
            type: plainText
            heading {
                heading: Precio Unitario
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column TIP_COMPROBANTE (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Historial Anulacion
        }

        savedReport 524167 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANT_ANULADA (
                sequence: 10
            )

            displayColumn CLIENTE (
                sequence: 4
            )

            displayColumn COD_ARTICULO (
                sequence: 8
            )

            displayColumn COD_USUARIO_ANULA (
                sequence: 14
            )

            displayColumn COMENTARIO_ANULACION (
                sequence: 12
            )

            displayColumn DESC_ARTICULO (
                sequence: 9
            )

            displayColumn FEC_ANULACION (
                sequence: 13
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 2
            )

            displayColumn FEC_OCC (
                sequence: 5
            )

            displayColumn NRO_COMPROBANTE (
                sequence: 3
            )

            displayColumn NRO_ITEM (
                sequence: 7
            )

            displayColumn NRO_OCC (
                sequence: 6
            )

            displayColumn PRECIO_UNITARIO (
                sequence: 11
            )

            displayColumn TIP_COMPROBANTE (
                sequence: 1
            )

        )

    )

    pageItem P795_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P795_FEC_INI (
        type: datePicker
        label {
            label: <p>Periodo Anulacion:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @historial-anulacion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

