    region cotizacion (
        name: Cotizacion
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Rama 1: Cliente igual, APROBADO = 'S', tomando la fecha de CA.FEC_OCC
                SELECT FECHA, ID_CLIENTE, PRECIO_UNITARIO, APROBADO
                FROM (
                  SELECT CA.FEC_OCC AS FECHA,
                         PC.ID_CLIENTE,
                         CA.PRECIO_UNITARIO,
                         'S' APROBADO
                    FROM CMW_COTIZA_ARTICULOS CA
                    JOIN VTW_PEDIDOS_CABECERA PC ON PC.ID = CA.ID_PEDIDO
                   WHERE CA.FEC_OCC IS NOT NULL
                     AND PC.ID_CLIENTE = :P739_ID_CLIENTE
                     AND CA.ID_ARTICULO = :P739_ID_ARTICULO
                     AND CA.ID != :P739_ID_COTIZA
                     AND (NVL(CANTIDAD_APROBADA, 0) -NVL(CANT_ANULADA, 0)) > 0
                     AND CANTIDAD_APROBADA IS NOT NULL
                     AND CANTIDAD_APROBADA != 0
                     AND NVL(CA.PRECIO_UNITARIO, 0) != 0
                   ORDER BY CA.FEC_OCC DESC
                )
                WHERE ROWNUM = 1
                  AND ID_CLIENTE != 3479 -- Cliente Selene
                
                UNION ALL
                
                -- Rama 2: Cliente distinto, APROBADO = 'S', tomando la fecha de CA.FEC_OCC
                SELECT FECHA, ID_CLIENTE, PRECIO_UNITARIO, APROBADO
                FROM (
                  SELECT CA.FEC_OCC AS FECHA,
                         PC.ID_CLIENTE,
                         CA.PRECIO_UNITARIO,
                         'S' APROBADO
                    FROM CMW_COTIZA_ARTICULOS CA
                    JOIN VTW_PEDIDOS_CABECERA PC ON PC.ID = CA.ID_PEDIDO
                   WHERE CA.FEC_OCC IS NOT NULL
                     AND PC.ID_CLIENTE != :P739_ID_CLIENTE
                     AND CA.ID_ARTICULO = :P739_ID_ARTICULO
                     AND CA.ID != :P739_ID_COTIZA
                     AND (NVL(CANTIDAD_APROBADA, 0) -NVL(CANT_ANULADA, 0)) > 0
                     AND CANTIDAD_APROBADA IS NOT NULL
                     AND CANTIDAD_APROBADA != 0
                     AND NVL(CA.PRECIO_UNITARIO, 0) != 0
                   ORDER BY CA.FEC_OCC DESC
                )
                WHERE ROWNUM = 1
                  AND ID_CLIENTE != 3479 -- Cliente Selene
                
                UNION ALL
                
                -- Rama 3: Cliente igual, APROBADO distinto de 'S', se toma la fecha de PC.FEC_COMPROBANTE
                SELECT FECHA, ID_CLIENTE, PRECIO_UNITARIO, APROBADO
                FROM (
                  SELECT PC.FEC_COMPROBANTE AS FECHA,
                         PC.ID_CLIENTE,
                         CA.PRECIO_UNITARIO,
                         'N' APROBADO
                    FROM CMW_COTIZA_ARTICULOS CA
                    JOIN VTW_PEDIDOS_CABECERA PC ON PC.ID = CA.ID_PEDIDO
                   WHERE PC.ID_CLIENTE = :P739_ID_CLIENTE
                     AND CA.ID_ARTICULO = :P739_ID_ARTICULO
                     AND CA.ID != :P739_ID_COTIZA
                     AND (NVL(CANTIDAD_APROBADA, 0) -NVL(CANT_ANULADA, 0)) >= 0
                     AND (CANTIDAD_APROBADA IS NULL OR CANTIDAD_APROBADA = 0)
                     AND NVL(CA.PRECIO_UNITARIO, 0) != 0
                   ORDER BY PC.FEC_COMPROBANTE DESC
                )
                WHERE ROWNUM = 1
                  AND ID_CLIENTE != 3479 -- Cliente Selene
                
                UNION ALL
                
                -- Rama 4: Cliente distinto, APROBADO distinto de 'S', se toma la fecha de PC.FEC_COMPROBANTE
                SELECT FECHA, ID_CLIENTE, PRECIO_UNITARIO, APROBADO
                FROM (
                  SELECT PC.FEC_COMPROBANTE AS FECHA,
                         PC.ID_CLIENTE,
                         CA.PRECIO_UNITARIO,
                         'N' APROBADO
                    FROM CMW_COTIZA_ARTICULOS CA
                    JOIN VTW_PEDIDOS_CABECERA PC ON PC.ID = CA.ID_PEDIDO
                   WHERE PC.ID_CLIENTE != :P739_ID_CLIENTE
                     AND CA.ID_ARTICULO = :P739_ID_ARTICULO
                     AND CA.ID != :P739_ID_COTIZA
                     AND (NVL(CANTIDAD_APROBADA, 0) -NVL(CANT_ANULADA, 0)) >= 0
                     AND (CANTIDAD_APROBADA IS NULL OR CANTIDAD_APROBADA = 0)
                     AND NVL(CA.PRECIO_UNITARIO, 0) != 0
                   ORDER BY PC.FEC_COMPROBANTE DESC
                )
                WHERE ROWNUM = 1
                  AND ID_CLIENTE != 3479 -- Cliente Selene
                
                ORDER BY FECHA DESC;
                
                ```
            pageItemsToSubmit: [
                P739_ID_CLIENTE
                P739_ID_ARTICULO
                P739_ID_COTIZA
            ]
        }
