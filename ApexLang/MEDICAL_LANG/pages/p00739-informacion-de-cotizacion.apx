    region competencia (
        name: Competencia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT HP.FEC_ALTA,
                                HP.ID_PROVEEDOR,
                                HP.PRECIO_VENTA,
                                AG.COD_ARTICULO,
                                AG.DESCRIPCION DESC_ARTICULO,
                                AG.ID_ENVASE,
                                AG.ID_UNIDAD_MEDIDA,
                                AG.ID_MARCA
                       
                  FROM STW_ARTICULOS               AC  -- Articulo Cotizacion
                  JOIN STW_ARTICULOS               AG ON AC.ID_GRUPO_ART = AG.ID_GRUPO_ART
                  JOIN CMW_HIST_PRECIO_COMPETENCIA HP ON AG.ID = HP.ID_ARTICULO
                 WHERE AC.ID = :P739_ID_ARTICULO
                   AND HP.IND_ACTIVO = 'S'
                ```
            pageItemsToSubmit: P739_ID_ARTICULO
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
