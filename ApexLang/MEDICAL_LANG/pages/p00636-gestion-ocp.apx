    process apex-collection (
        name: APEX_COLLECTION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                TMP_COTIZACION  VARCHAR2(20) := 'COTIZACIONES';
                BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_COTIZACION) THEN
                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_COTIZACION);
                  END IF;
                  APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_COTIZACION);
                  END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 28503917272839102
        }
        serverSideCondition {
            whenButtonPressed: @generar
        }
    )

    process coleccion-de-apex (
        name: Coleccion de Apex
        type: executeCode
        editableRegion: @detalles
        source {
            plsqlCode:
                ```plsql
                DECLARE
                TMP_COTIZACION  VARCHAR2(20) := 'COTIZACIONES';
                BEGIN
                
                 IF NVL(:SELECCIONAR,'N') = 'S' THEN
                
                
                  APEX_COLLECTION.ADD_MEMBER(
                    p_collection_name => TMP_COTIZACION,
                    p_c001 => :ID_ARTICULO,
                    p_c002 => :CANTIDAD_OCP,
                    p_c003 => :PRECIO,
                    p_c004 => :MON_COSTO,
                    p_c005 => :ID_PEDIDO,
                    P_C006 => :P636_MONEDA,
                    ----p_C007 => :ID_PROVEEDOR,
                    p_C007 => :P636_PROVEEDOR_OC, -- agregado por que en la grilla estira productos que aun no estan en existencia
                    p_C008 => :ID_TIPO_ENTREGA,
                    p_c009 => :ID,                          
                    p_c010 => :P0_ID_SUCURSAL,
                    p_c011 => :NRO_OCC,
                    p_c012 => :comentario_a_compra,
                    p_c013 => :ID_OFERTA_LIC,
                    p_c014 => :TIP_COMPROBANTE
                     );
                END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 28503810493839101
        }
        serverSideCondition {
            whenButtonPressed: @generar
        }
    )

    process gardar-nm-process (
        name: GARDAR_NM_PROCESS
        type: executeCode
        editableRegion: @detalles
        source {
            plsqlCode:
                ```plsql
                BEGIN
                iF NVL(:IND_NO_MOSTRAR,'N') = 'S' THEN
                    IF :TIP_COMPROBANTE = 'PED' THEN
                       UPDATE CMW_COTIZA_ARTICULOS A
                       SET A.IND_NO_MOSTRAR = 'S'
                       WHERE A.ID = :ID;
                    END IF;
                
                    IF :TIP_COMPROBANTE = 'LIC' THEN
                        UPDATE LCW_OFERTAS_APROBACIONES
                           SET IND_NO_MOSTRAR = 'S'
                         WHERE ID = :ID;
                    END IF;
                   COMMIT;
                
                END IF;
                
                
                    IF :TIP_COMPROBANTE = 'PED' THEN
                      UPDATE CMW_COTIZA_ARTICULOS
                         SET OBS_GESTION_OCP = :OBS_GESTION_OCP
                      WHERE ID = :ID;
                    END IF;
                
                    IF :TIP_COMPROBANTE = 'LIC' THEN
                        UPDATE LCW_OFERTAS_APROBACIONES
                          SET OBS_GESTION_OCP = :OBS_GESTION_OCP
                        WHERE ID = :ID;
                    END IF;
                   EXCEPTION
                    WHEN OTHERS THEN
                     RAISE_APPLICATION_ERROR(-20000,'Error al actualziar los comprobantes: '||sqlerrm);
                  
                END;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Operación realizada con éxito
        }
        advanced {
            executionMappingIdentifier: 57834789636686943
        }
    )

