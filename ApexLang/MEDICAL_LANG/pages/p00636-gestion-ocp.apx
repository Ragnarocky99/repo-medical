    dynamicAction actualizar-nm (
        name: ACTUALIZAR_NM
        execution {
            sequence: 80
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: IND_NO_MOSTRAR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                       IF :IND_NO_MOSTRAR = 'S' THEN
                         UPDATE CMW_COTIZA_ARTICULOS A
                         SET A.IND_NO_MOSTRAR = 'S'
                         WHERE A.ID = :ID;
                         COMMIT;
                       END IF;
                    END;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar (
        name: Inicializar
        execution {
            sequence: 90
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: SELECCIONAR
        }

        action seleccionar (
            name: SELECCIONAR
            action: setValue
            settings {
                value: N
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: columns
                columns: SELECCIONAR
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: SELECCIONAR
            }
        )

    )

    dynamicAction mostrar-mensaje (
        name: Mostrar mensaje
        execution {
            sequence: 40
        }
        when {
            event: apexbeforepagesubmit
        }
        serverSideCondition {
            type: never
        }

        action native-alert (
            action: alert
            settings {
                message: Debe tener un valor
                okLabel: Chau
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P636_PROVEEDOR
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: CANTIDAD_OCP
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       cantidad_opc NUMBER := :CANTIDAD_OCP;  
                       cantidad_occ NUMBER := :CANTIDAD_APROBADA;  
                    BEGIN
                      IF cantidad_opc < cantidad_occ  THEN
                          -- Aquí puedes realizar acciones adicionales si la validación falla
                          RAISE_APPLICATION_ERROR(-20001, 'La cantidad OCP ingresada es menor que la cantidad OCC.');
                       END IF;
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    CANTIDAD_APROBADA
                    CANTIDAD_OCP
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction reaccion-grilla (
        name: REACCION GRILLA
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction secuencia (
        name: SECUENCIA
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: SELECCIONAR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF nvl(:SELECCIONAR,'N')  = 'S' THEN 
                           IF  nvl(:P636_ID_SELECCION,0) = 0 THEN
                             :P636_ID_SELECCION := SEQ_ID_SELECCION.NEXTVAL;
                           END IF;
                           :ID_SELECCION := :P636_ID_SELECCION;
                        ELSE
                           :ID_SELECCION := NULL;
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    SELECCIONAR
                    P636_ID_SELECCION
                ]
                itemsToReturn: [
                    P636_ID_SELECCION
                    ID_SELECCION
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-cantidad (
        name: Setear cantidad
        execution {
            sequence: 50
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: SELECCIONAR
        }
        clientSideCondition {
            type: itemColumn=value
            column: SELECCIONAR
            value: S
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_OCP
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD_APROBADA
                itemsToSubmit: CANTIDAD_APROBADA
            }
            affectedElements {
                selectionType: columns
                columns: CANTIDAD_OCP
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-condicion (
        name: Setear Condicion
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P636_PROVEEDOR
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION||'('||COD_CONDICION_COMPRA||')',ID FROM CMW_CONDICIONES_COMPRAS 
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                      AND NVL(ESTADO,'X')='A'
                      AND ROWNUM = 1;
                      
                    ```
                itemsToSubmit: P636_CONDICION
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P636_CONDICION
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

