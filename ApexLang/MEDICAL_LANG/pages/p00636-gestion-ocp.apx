page 636 (
    name: Gestion de OCP
    alias: GESTION-OCP
    title: Gestion de OCP
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            .mostrar{
            background-color:#eeeeee;
            width: 225px;
            height: 23px;
            vertical-align: bottom;
            border-style: dashed;
            font-weight: lighter;
            font-size: 13px;
            text-align: center;
            border-width: thin;
            border-color: #afa9a9;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region detalles (
        name: Gestion OCP
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                  FROM CMWV_GESTION_OCP
                 WHERE (ID_PROVEEDOR = :P636_PROVEEDOR OR :P636_PROVEEDOR IS NULL)
                   AND (ID_ARTICULO = :P636_ARTICULO OR :P636_ARTICULO IS NULL)
                   AND FEC_COMPROBANTE BETWEEN :P636_FECHA_INI AND :P636_FECHA_FIN
                   AND (NRO_COMPROBANTE = :P636_NRO_PEDIDO OR :P636_NRO_PEDIDO IS NULL)
                   AND (ID_TIPO_ENTREGA = :P636_PLAZO_ENTREGA OR :P636_PLAZO_ENTREGA IS NULL)
                   AND NVL(IND_NO_MOSTRAR,'N') = :P636_ES_MOSTRABLE
                ```
            pageItemsToSubmit: [
                P636_NRO_PEDIDO
                P636_FECHA_INI
                P636_FECHA_FIN
                P636_PROVEEDOR
                P636_ARTICULO
                P636_CONDICION
                P636_MONEDA
                P636_PLAZO_ENTREGA
                P636_ES_MOSTRABLE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        editAuthorization {
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 26261506178891256
        }

