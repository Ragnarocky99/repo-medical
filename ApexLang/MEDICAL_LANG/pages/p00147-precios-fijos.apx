page 147 (
    name: Precios Fijos
    alias: PRECIOS-FIJOS
    title: Precios Fijos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region articulos-sin-precio-vigente (
        name: Articulos sin Precio Vigente
        type: interactiveReport
        source {
            location: localDatabase
            tableName: VTWV_ARTICULOS_SIN_PRECIO_VENTA
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
            orderByClause: COD_ARTICULO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 39768332167329546
        }

        column ARTICULO (
