    dynamicAction valida-manzana (
        name: valida_manzana
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P572_ID_MANZANA
        }

        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    IF :p572_ID_LOTE is not null THEN  
                     
                      BEGIN
                          select nvl(nro_comprobante,' '), cc.id_cliente, c.id, c.id_condicion_venta
                            into :p572_nro_comprobante, :p572_id_cliente, :P572_ID_CONTRATO, :P572_ID_CONDICION_VENTA
                            from ltW_contratos c, ltw_clientes_contratos cc
                           where c.id_empresa     = :P0_ID_EMPRESA
                             and c.id_fraccion    = :p572_id_fraccion
                             and c.id_manzana     = :p572_id_manzana
                             and c.id_lote        = :p572_id_lote
                             and cc.id_Empresa    = c.ID_EMPRESA
                             and cc.id_contrato   = c.id
                             and nvl(cc.ind_defecto, 'X')    = 'S'
                             and rownum          = 1
                             and nvl(estado,'N') = 'A';
                             
                      EXCEPTION
                          WHEN no_data_found THEN
                           raise_applicatioN_error(-20000, 'La Fracción '||:p572_id_fraccion|| ' de la manzana  '||:p572_id_manzana||chr(10)||
                                       'del lote '||:p572_id_lote||'  no tiene un contrato activo' );
                    
                          WHEN others THEN
                            raise_applicatioN_error(-20001,'Error al recuperar al recuperar el nro del Contrato - '||sqlerrm);
                            
                      END;
                      BEGIN
                          select count(*)
                            into :P572_CUOTAS_PAGADAS
                            from  ltw_saldos c
                           where c.id_empresa     = :P0_ID_EMPRESA
                             and c.id_contrato    = :p572_id_contrato
                             and c.saldo_cuota    = 0;
                             
                      EXCEPTION
                          WHEN no_data_found THEN
                           :P572_CUOTAS_PAGADAS := 0;
                    
                          WHEN others THEN
                            raise_applicatioN_error(-20002,'Error al recuperar al recuperar datos de cuotas pagadas - '||sqlerrm);
                            
                      END;
                        BEGIN
                          select count(*)
                            into :P572_CUOTAS_ATRASADAS
                            from  ltw_saldos c
                           where c.id_empresa     = :P0_ID_EMPRESA
                             and c.id_contrato    = :p572_id_contrato
                             and c.saldo_cuota    <> 0
                             and c.fec_acobrar     < trunc(sysdate);
                             
                      EXCEPTION
                          WHEN no_data_found THEN
                           :P572_CUOTAS_ATRASADAS := 0;
                    
                          WHEN others THEN
                            raise_applicatioN_error(-20002,'Error al recuperar al recuperar datos de cuotas atrasadas - '||sqlerrm);
                            
                      END;
                       
                    
                    
                            IF :TIP_RECUPERO <> 'K' THEN
                                --------- Validar si necesita ser autorizado segun el tipo de operacion. ------- 
                              DECLARE
                                 ves_excepcion  varchar2(1);
                                 vrecupero      varchar2(1);
                                 vrenuncia      varchar2(1);
                                 vcancelado     varchar2(1);
                                 vestado        varchar2(1);
                    
                              BEGIN
                                 ---- Buscar el Estado del lote. ----
                                 BEGIN
                                     select r.estado
                                     into :p572_estado
                                     from LTW_CONTRATOS r
                                     where r.ID_empresa  = :p0_id_empresa
                                       and r.ID_sucursal = :p0_id_sucursal
                                       and r.ID_fraccion = :id_fraccion
                                       and r.ID_manzana  = :id_manzana
                                       and r.ID_lote     = :id_lote
                                       AND R.ESTADO       = 'A';
                                       
                                 EXCEPTION
                                    WHEN no_data_found THEN
                                       :p572_estado := 'X' ;
                                       raise_applicatioN_error(-20000,'No se encontro el lote como para Recuperar/Renuncia/Cancelacion.');
                                
                                    WHEN too_many_rows THEN
                                       :p572_estado := 'X' ;
                                       raise_applicatioN_error(-20000,'Se encontraron mas de un registro pendiente del mismo lote. Verifique el lote entre las excepciones.');
                    
                                    WHEN others THEN
                                       :p572_estado := 'X' ;
                                       raise_applicatioN_error(-20000,'Error al buscar el lote entre las excepciones. ' || sqlerrm);
                              
                                 END;
                               END;
                    
                            END IF;
                    
                    END IF;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P572_ID_SUCURSAL
                    P572_ID_LOTE
                    P572_ID_MANZANA
                    P572_ID_FRACCION
                    P572_ID_CONTRATO
                ]
                itemsToReturn: [
                    P572_NRO_COMPROBANTE
                    P572_ID_CLIENTE
                    P572_ID_CONTRATO
                    P572_ID_CONDICION_VENTA
                    P572_CUOTAS_PAGADAS
                    P572_CUOTAS_ATRASADAS
                ]
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action trae-porcentaje (
            name: trae_porcentaje
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                     declare
                       vtot_cuota       number;
                       v_cuotas_pagadas number;
                       vretorno         number;
                     BEGIN
                               begin
                                   select count(*)
                                    into vtot_cuota
                                    from  ltw_saldos c
                                   where c.id_empresa     = :P0_ID_EMPRESA
                                     and c.id_contrato    = :p572_id_contrato
                                     ;      
                              EXCEPTION
                                  WHEN no_data_found THEN
                                   vtot_cuota := 0;
                    
                                  WHEN others THEN
                                    raise_applicatioN_error(-20005,'Error al recuperar al recuperar datos de cuotas  - '||sqlerrm);     
                              END;
                               begin
                                   select count(*)
                                    into v_cuotas_pagadas
                                    from  ltw_saldos c
                                   where c.id_empresa     = :P0_ID_EMPRESA
                                     and c.id_contrato    = :p572_id_contrato
                                     and c.saldo_cuota    = 0
                                     ;  
                              EXCEPTION
                                  WHEN no_data_found THEN
                                   v_cuotas_pagadas := 0;
                    
                                  WHEN others THEN
                                    raise_applicatioN_error(-20005,'Error al recuperar al recuperar datos de cuotas  - '||sqlerrm);     
                              END;
                         IF NVL(VTOT_CUOTA,0) <> 0 AND NVL(V_CUOTAS_PAGADAS,0) <> 0 THEN
                             vretorno := v_cuotas_pagadas * 100 / vtot_cuota;
                         ELSE
                             vretorno := 0;
                         END IF;
                       :P572_PORC_PAGADO := vretorno;
                     end;
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P572_ID_CONTRATO
                ]
                itemsToReturn: P572_PORC_PAGADO
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

