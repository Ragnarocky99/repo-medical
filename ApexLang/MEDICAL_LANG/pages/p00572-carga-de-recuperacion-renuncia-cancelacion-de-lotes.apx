    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P572_ID_CONTRATO
        }
        serverSideCondition {
            type: never
        }

        action plugin-com-fos-execute-plsql-code (
            action: plugin/fosExecutePlSqlCode
            settings {
                plSqlCode:
                    ```plsql
                    --IF nro_comprobante is not null THEN
                      declare
                        v_estado varchar2(1) ;
                        v_deuda		number;
                         tip_recupero varchar(10);
                      BEGIN
                      	
                      	IF tip_recupero = 'C' THEN
                    	    BEGIN
                    			  select nvl(count(1),0)
                    			    into v_deuda
                    				  from ccw_saldos s
                    				  where s.nro_comprobante_ref = nro_comprobante
                    	 				  and s.fec_vencimiento < trunc(sysdate)
                    	 				  and s.saldo_cuota > 0;
                    	 				  --and s.tip_comprobante = 'IMP';
                    	 		  IF v_deuda > 0 THEN
                    	 		    mensaje_ex('No se puede hacer la Renuncia por que existen deudas de Impuesto Inmobiliario pendientes.',2);
                    		  	  raise form_trigger_failure;
                                
                    		    END IF;
                    	 	  END;
                      	END IF;
                      	
                    	  BEGIN
                    	    select estado 
                    	      into v_estado
                    	      from ltw_contratos
                    	     where tip_comprobante = tip_comprobante
                    	       and ser_comprobante = ser_comprobante
                    	       and nro_comprobante = nro_comprobante ;
                    	  EXCEPTION
                    	    WHEN others THEN
                    	  	  v_estado := null ;
                    	  END;
                    	  IF v_estado = 'N' THEN
                    	  	mensaje_ex('El Contrato '||nro_comprobante||' ya fue anulado.',2);
                    	  	raise form_trigger_failure ;
                    	  ELSIF v_estado = 'C' THEN
                    	  	mensaje_ex('El Contrato '||nro_comprobante||' ya fue cancelado.',2);
                    	  	raise form_trigger_failure ;
                    	  ELSE
                    		  busca_datos_contrato;
                    		  busca_cuotas_atrasadas;
                    		  busca_cliente;
                    		  porc_pagado := nvl(cuotas_pagadas,0) * 100 / cant_cuotas;
                    	  END IF ;
                     END;
                    /*ELSE
                    	mensaje_ex('Ingrese el Número del Contrato',2);
                    	raise form_trigger_failure;*/
                    --END IF ;
                    ```
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

