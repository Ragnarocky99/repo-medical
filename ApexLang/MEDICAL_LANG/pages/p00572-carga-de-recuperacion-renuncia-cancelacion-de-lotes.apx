    region carga-de-recuperacion-renuncia-cancelacion-de-lotes (
        name: Carga de Recuperacion/Renuncia/Cancelacion de Lotes
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       NRO_RECUPERACION,
                       tip_comprobante,
                       ser_comprobante,
                       nro_comprobante,
                       FEC_COMPROBANTE,
                       FEC_ALTA,
                       ID_CLIENTE,
                       COD_USUARIO_AUD,
                       FEC_MODI,
                       COD_USUARIO_MODI,
                       TIP_RECUPERO,
                       CUOTAS_PAGADAS,
                       CUOTAS_ATRASADAS,
                       ID_FRACCION,
                       ID_MANZANA,
                       ID_LOTE,
                       ID_CONDICION_VENTA,
                       PORC_PAGADO,
                       ESTADO,
                       FEC_ESTADO,
                       ID_MOTIVO,
                       OBSERVACION,
                       ID_FRACCION_ORIGINAL,
                       ID_MANZANA_ORIGINAL,
                       ID_LOTE_ORIGINAL,
                       ID_CONTRATO_ORIGINAL,
                       ID_CONTRATO
                  from LTW_RECUPERACION_LOTES
                ```
            pageItemsToSubmit: P572_ID
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

