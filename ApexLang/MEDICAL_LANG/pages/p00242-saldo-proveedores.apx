    region saldo-proveedores (
        name: Saldo Proveedores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PROVEEDOR,
                       COD_PROVEEDOR, 
                       FEC_COMPROBANTE, 
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE, 
                       FEC_VENCIMIENTO, 
                       NUM_CUOTA,
                       TOT_CUOTA,
                       TOT_SALDO,
                       MONEDA,
                       TIP_CAMBIO,
                       NRO_FACTURA
                
                FROM CPWV_SALDOS_PROVEEDOR
                
                WHERE ID_EMPRESA =:P0_ID_EMPRESA
                AND (FEC_VENCIMIENTO BETWEEN :PC_FEC_INIC AND :PC_FEC_FINA)
                AND (ID_PROVEEDOR= :P242_PROVEEDOR OR :P242_PROVEEDOR IS NULL)
                AND (ID_PROVEEDOR_CAJA = :P242_PROVEEDOR_CAJA OR :P242_PROVEEDOR_CAJA IS NULL)
                AND (ID_MONEDA= :P242_MONEDA OR :P242_MONEDA IS NULL)
                AND ((:P242_IND_SALDO = 1 AND NVL(TOT_SALDO,0) != 0) OR
                         (:P242_IND_SALDO = 0 AND NVL(TOT_SALDO,0) = 0) OR
                         (:P242_IND_SALDO = 2 ))
                ```
            pageItemsToSubmit: [
                PC_FEC_INIC
                PC_FEC_FINA
                P242_PROVEEDOR
                P242_MONEDA
                P242_PROVEEDOR_CAJA
                P242_IND_SALDO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 55512544051712056
        }

