    button create (
        buttonName: CREATE
        label: Habilitar Caja
        layout {
            sequence: 10
            region: @habilitacion-de-cajas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 208
                clearCache: 208
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @habilitacion-de-cajas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @habilitacion-de-cajas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

