page 207 (
    name: Habilitacion de Cajas
    alias: HABILITACION-DE-CAJAS
    title: Habilitacion de Cajas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region habilitacion-de-cajas (
        name: Habilitacion de Cajas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select HAB.ID,
                       HAB.ID_EMPRESA,
                       HAB.ID_SUCURSAL,
                       HAB.ID_CAJA,
                       HAB.NRO_HABILITACION,
                       HAB.FEC_HABILITACION,
                       HAB.FEC_CIERRE,
                       HAB.ID_USUARIO,
                       HAB.HORA_HABILITACION,
                       HAB.HORA_CIERRE,
                       HAB.FEC_ALTA,
                       HAB.COD_SECTOR_VEN,
                       HAB.COD_USUARIO_AUD,
                       HAB.SALDO_INICIAL,
                       HAB.SALDO_CIERRE,
                       HAB.ESTADO,
                       HAB.IND_DEPOSITO,
                       SUC.DESCRIPCION DESC_SUC,
                       SUC.COD_SUCURSAL,
                       CAJ.DESCRIPCION DESC_CAJ,
                       CAJ.COD_CAJA,
                       US.COD_USUARIO
                  from CCW_HABILITACIONES HAB, BSW_SUCURSALES SUC, CCW_CAJAS CAJ, BSW_USUARIOS US
                  where HAB.ID_EMPRESA      = :P0_COD_EMPRESA
                  and   HAB.ID_SUCURSAL     = SUC.ID
                  AND   HAB.ID_USUARIO      = US.ID
                  and   HAB.ID_CAJA         = CAJ.ID
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 208
                items: {
                    P208_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 24960586494701079
        }

