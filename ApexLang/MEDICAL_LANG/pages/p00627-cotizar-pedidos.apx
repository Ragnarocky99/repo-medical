    region lista-de-pedidos (
        name: Lista de Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       CASE
                         WHEN C.ID IS NOT NULL THEN
                          'fa fa-search u-primary-text'
                       END Cotiza,
                       C.ID_EMPRESA,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_SUCURSAL,
                       C.FEC_COMPROBANTE,
                       C.ID_CLIENTE,
                       C.ID_VENDEDOR,
                       C.ID_CONDICION_VENTA,
                       C.ID_LISTA_PRECIO,
                       C.DESCUENTO,
                       C.ID_MONEDA,
                       C.TIP_CAMBIO,
                       C.TOT_COMPROBANTE,
                       C.TOT_GRAVADAS,
                       C.TOT_EXENTAS,
                       C.TOT_IVA,
                       C.ESTADO,
                       C.FEC_ESTADO,
                       C.ID_USUARIO,
                       C.FEC_ALTA,
                       C.NRO_AUTORIZACION,
                       C.CAMBIO_MONEDA_PRECIO,
                       C.TIP_CAMBIO_COMPRA,
                       C.FEC_VENCIMIENTO,
                       C.NOM_CLIENTE,
                       C.RUC_CLIENTE,
                       C.COMENTARIO,
                       C.COD_USUARIO_AUD,
                       C.ESTADO_FAC,
                       C.IND_CAMBIO_PRECIO,
                       C.IND_LIMITE_CREDITO,
                       C.ENTREGA_INICIAL,
                       C.ID_MEDIO_PAGO,
                       C.ESTADO_CREDITO,
                       C.ID_CANAL_VENTA,
                       C.ID_TIPO_ENTREGA,
                       C.ID_SUCURSAL_CENTRAL,
                       C.IND_ENTREGA_INICIAL,
                       C.ID_CONCEPTO_COMP,
                       C.ID_CORPORACION,
                       C.NRO_OC,
                       C.ESTADO_OC,
                       C.FEC_ESTADO_OC,
                       C.ID_LISTA_BODA_CAB,
                       C.ID_SOLICITUD_CREDITO,
                       C.ID_DEPOSITO_RESGUARDO,
                       C.CONTACTO_NOMBRE,
                       C.CONTACTO_TELEFONO,
                       C.DIRECCION,
                       C.TELEFONO,
                       C.DIREC_ENTREGA,
                       C.LATITUD,
                       C.LONGITUD,
                       C.ID_ZONA,
                       C.AUTORIZA_STOCK,
                       C.AUTORIZA_STOCK_USU,
                       C.AUTORIZA_STOCK_FEC,
                       C.AUTORIZA_CTACTE,
                       C.AUTORIZA_CTACTE_USU,
                       C.AUTORIZA_CTACTE_FEC,
                       C.ID_FACTURA,
                       C.ID_SECTOR_VEN,
                       C.COD_USUARIO_DESPACHANDO,
                       CASE /*TRAE_ESTADO_PEDIDO_CABECERA2_COT(ID)---*/
                        trae_estado_pedido_cabecera3(C.ID)
                         WHEN 'PE' THEN
                          'Pendiente'
                         WHEN 'PA' THEN
                          'Parcial'
                         WHEN 'CO' THEN
                          'Cotizar'
                         WHEN 'EN' THEN
                          'Enviado'
                         WHEN 'AN' THEN
                          'Anulado'
                       END AS ESTADO_PEDIDO,
                       (SELECT MAX(COT.FEC_ENVIO)
                          FROM CMW_COTIZA_ARTICULOS COT
                         WHERE COT.ID_PEDIDO = C.ID) FECHA_COTIZACION,
                     
                          CASE
                          WHEN ROUND((SELECT MAX(COT.FEC_ENVIO)
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID))IS NULL OR NVL((SELECT MAX(COT.FEC_ENVIO)
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID),SYSDATE) - C.FEC_COMPROBANTE - 1 < 0 THEN
                             0
                          ELSE
                            ROUND( NVL((SELECT MAX(COT.FEC_ENVIO)
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID),SYSDATE) - C.FEC_COMPROBANTE - 1)
                          END ||'Dias  '||
                          
                          CASE
                          WHEN (SELECT MAX(TO_DATE(COT.FEC_ENVIO,'DD/MM/YYYY'))
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID)IS NULL THEN
                             0
                          ELSE
                          (SELECT MOD(  
                             floor((NVL((SELECT MAX(TO_DATE(COT.FEC_ENVIO,'DD/MM/YYYY'))
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID),SYSDATE) - TO_DATE(C.FEC_COMPROBANTE,'DD/MM/YYYY'))),24)     
                                FROM DUAL
                               GROUP BY C.ID) 
                           END ||':'||
                           
                          CASE
                          WHEN (SELECT MAX(COT.FEC_ENVIO)
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID)IS NULL THEN
                             0
                          ELSE
                             (SELECT 
                             round((((MIN(NVL((SELECT MAX(COT.FEC_ENVIO)
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID),SYSDATE)) - C.FEC_COMPROBANTE)*24)-(floor((NVL((SELECT MAX(COT.FEC_ENVIO)
                                          FROM CMW_COTIZA_ARTICULOS COT
                                         WHERE COT.ID_PEDIDO = C.ID),SYSDATE) - C.FEC_COMPROBANTE)*24)))*60,0)     
                                FROM DUAL
                               GROUP BY C.ID) END DIAS_PASADOS,
                          CL.NIVEL
                
                  from VTW_PEDIDOS_CABECERA C
                  join CCW_CLIENTES CL ON CL.ID = C.ID_CLIENTE
                 WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                   AND (C.NRO_COMPROBANTE = :P627_NRO_PEDIDO OR :P627_NRO_PEDIDO IS NULL)
                   AND (C.ID_CLIENTE = :P627_CLIENTE OR :P627_CLIENTE IS NULL)
                   AND (C.ID_SUCURSAL = :P627_SUCURSAL OR :P627_SUCURSAL IS NULL)
                   AND ((:P627_ESTADO = /*'SS'*/
                       'PC' AND TRAE_ESTADO_PEDIDO_CABECERA3(C.id) IN ('CO', 'PA')) OR
                       (TRAE_ESTADO_PEDIDO_CABECERA3(C.id) = :P627_ESTADO /*AND*/
                       OR :P627_ESTADO IS /*NOT*/
                       NULL))
                      ---AND (TRAE_ESTADO_PEDIDO_CABECERA2(id)  = :P627_ESTADO OR TRAE_ESTADO_PEDIDO_CABECERA2(id) IN ('CO', 'PA') OR:P627_ESTADO IS NULL)
                   AND (C.FEC_COMPROBANTE BETWEEN :P627_FECHA_DESDE AND :P627_FECHA_HASTA)
                   AND (C.ID_USUARIO =
                       (select id from bsw_usuarios U where u.cod_usuario = :APP_USER) or
                       C.ID_USUARIO = :P627_USUARIO or :p627_usuario is null)
                       --fetch first 30 rows only
                --AND ESTADO NOT IN ('EP');
                
                ```
            pageItemsToSubmit: [
                P627_CLIENTE
                P627_ESTADO
                P627_USUARIO
                P627_SUCURSAL
                P627_FECHA_DESDE
                P627_FECHA_HASTA
                P627_NRO_PEDIDO
                " APP_USER"
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 35082680705377624
        }

