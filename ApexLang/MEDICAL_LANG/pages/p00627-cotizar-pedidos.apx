    pageItem P627_CLIENTE (
        type: popupLov
        label {
            label: <P>Cliente: </P>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-clientes
            displayExtraValues: false
            nullDisplayValue: ---Sin Seleccionar---
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P627_ESTADO (
        type: selectList
