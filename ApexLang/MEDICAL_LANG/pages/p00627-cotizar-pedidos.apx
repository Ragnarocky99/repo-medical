            ]
            height: 1
        }
        default {
            type: static
            staticValue: PC
        }
    )

    pageItem P627_FECHA_DESDE (
        type: datePicker
        label {
            label: <P>Fecha Desde: </P>
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 5
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select '01/'||to_char(sysdate, 'MM/YYYY') from DUAL
        }
    )

    pageItem P627_FECHA_HASTA (
