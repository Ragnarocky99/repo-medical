    dynamicAction estado (
        name: Estado
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('td[headers="OPERACION"]').each(function() {
                      var texto = $(this).text();
                      if (texto === 'Confirmado') {
                        $(this).css("color", "green");
                      } else if (texto === 'En Proceso') {
                        $(this).css("color", '#e1ad01');
                      } else if (texto === 'Anulado') {
                        $(this).css("color", "red"); 
                      }
                      else if (texto === 'Cotizado') {
                        $(this).css("color", "green"); 
                      } 
                      else if (texto === 'En Deposito') {
                        $(this).css("color", "blue"); 
                      } 
                      else if (texto === 'Presupuestado') {
                        $(this).css("color", "orange"); 
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

