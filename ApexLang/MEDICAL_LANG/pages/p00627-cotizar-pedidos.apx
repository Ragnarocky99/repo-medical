    region detalles-de-pedido (
        name: Detalles de Pedido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_PEDIDO_CABECERA,
                       ID_ARTICULO,
                       CANTIDAD,
                       CANTIDAD_FACTURADA,
                       PRECIO_UNITARIO,
                       MONTO_TOTAL,
                       TOTAL_IVA,
                       PRECIO_LISTA,
                       DESCUENTO,
                       IND_FACTURA,
                       COD_USUARIO_AUD,
                       CANTIDAD_UB,
                       ID_UNIDAD_MEDIDA,
                       PORC_DESCUENTO,
                       IVA,
                       PORC_DESC_ESP,
                       MONTO_DESC_ESPECIAL,
                       ID_LOTE,
                       PRECIO_UNITARIO_C_IVA,
                       PRECIO_LISTA_C_IVA,
                       MONTO_TOTAL_C_IVA,
                       DESCUENTO_C_IVA,
                       CANT_CUOTA,
                       ENTREGA_INICIAL,
                       MON_CUOTA,
                       PLAZOCUOTA,
                       ID_IVA,
                       CASE TRAE_ESTADO_PEDIDO(ID_EMPRESA,ID_PEDIDO_CABECERA,ID_ARTICULO) 
                       --CASE TRAE_ESTADO_PEDIDO_X_DET(ID_EMPRESA,ID_PEDIDO_CABECERA,ID,ID_ARTICULO) 
                       WHEN 'EN' THEN 'ENVIADO'
                       WHEN 'CP' THEN 'COMPRAS'
                       WHEN 'CO' THEN 'COTIZAR'
                       WHEN 'SF' THEN 'SIN DEFINIR'
                       END AS ESTADO_PEDIDO,    
                       PORC_GRAVADA,
                       IND_PROMO,
                       --(select A.descripcion from stw_articulos A where A.id=ID_ARTICULO)DESC_ARTICULO,
                       DESC_ARTICULO,
                       DESC_ARTICULO_STD,
                       NUM_ORDEN,
                       NRO_LOTE,
                       IND_ANULADO,
                       STOCK,
                       OBSERVACION,
                       ESTADO,
                       CASE
                        WHEN cantidad <= stock THEN cantidad
                        ELSE stock
                    END AS presupuestado, 
                       ''vacio,
                       (SELECT NVL(A.IND_CONTROLADO, 'N') FROM STW_ARTICULOS A WHERE A.ID = ID_ARTICULO) IND_CONTROLADO
                  from VTW_PEDIDOS_DETALLE
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @lista-de-pedidos
        }
        edit {
            enabled: true
        }
        performance {
            lazyLoading: true
        }
