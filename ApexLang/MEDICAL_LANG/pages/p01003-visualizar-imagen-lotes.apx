page 1003 (
    name: Visualizar Imagen (Lotes)
    alias: VISUALIZAR-IMAGEN-LOTES
    title: Visualizar Imagen (Lotes)
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        source {
            htmlCode: <img src="&P1003_SRC." height="500" width="685">
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P1003_ID (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P1003_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P1003_ID_LOTES (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P1003_SRC (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    computation p1003-src (
        itemName: P1003_SRC
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_src varchar2(100);
                BEGIN
                    SELECT '/i/IMAGENES_LOTES/'||ID_LOTE||'-'||ID||'.jpg' 
                    into v_src  
                    FROM
                    LTW_LOTES_FOTOS
                    WHERE ID_LOTE=:P1003_ID_LOTES
                    AND  ID =:P1003_ID
                    AND ID_EMPRESA=:P0_ID_EMPRESA;
                    RETURN V_SRC;
                     EXCEPTION WHEN OTHERS THEN
                        RETURN NULL;
                END;
                ```
        }
    )

)

