    dynamicAction agregar-botones (
        name: Agregar botones
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-hr-bilog-extendigtoolbar (
            action: plugin/interactiveGridExtendToolbar
            settings {
                label: Generar Nota Envio
                hot: true
                icon: fa-dynamic-content
                triggerAction: gen_nota_env
            }
            affectedElements {
                selectionType: region
                region: @generacion-de-notas-env
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction generar-nota-de-envio (
        name: Generar nota de envio
        execution {
            sequence: 20
        }
        when {
            event: custom
            customEvent: gen_nota_env
            selectionType: region
            region: @generacion-de-notas-env
        }

        action native-alert (
            action: alert
            settings {
                message: &P710_MENSAJE_PROCEDIMIENTO.
                style: information
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumnIsNotNull
                componentType: item
                item: P710_MENSAJE_PROCEDIMIENTO
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P710_IDS := NULL;
                    :P710_MENSAJE_PROCEDIMIENTO := NULL;
                    ```
                itemsToReturn: [
                    P710_IDS
                    P710_MENSAJE_PROCEDIMIENTO
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: :P710_IDS  := SUBSTR(:P710_IDS, 1, LENGTH(:P710_IDS) - 1);
                itemsToSubmit: P710_IDS
                itemsToReturn: P710_IDS
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        STWP_INSERTA_NOTA_ENVIO_AUTO(p_id_empresa => :P0_ID_EMPRESA,
                                                     p_ids        => :P710_IDS);
                    EXCEPTION
                        WHEN OTHERS THEN
                            :P710_MENSAJE_PROCEDIMIENTO := SQLERRM;
                    END;
                    ```
                itemsToReturn: P710_MENSAJE_PROCEDIMIENTO
                showProcessing: true
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @generacion-de-notas-env
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action plugin-com-fos-interactive-grid-process-rows (
            action: plugin/fosInteractiveGridProcessRows
            settings {
                action: processSelectedRows
                plSqlCode: :P710_IDS := NVL(:P710_IDS, '')||:ID||':';
                itemsToSubmit: ID
                itemsToReturn: P710_IDS
                errorMessage: #SQLERRM#
                extraOptions: refreshSelectionAfterProcessing
            }
            affectedElements {
                selectionType: region
                region: @generacion-de-notas-env
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
        )

    )

    process generacion-de-notas-env-save-interactive-grid-data (
        name: Generacion de Notas Env. - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @generacion-de-notas-env
        execution {
