                sequence: 10
            )

            displayColumn COD_ARTICULO (
                sequence: 3
            )

            displayColumn DESC_ARTICULO (
                sequence: 4
            )

            displayColumn FECHA_GENERACION (
                sequence: 9
            )

            displayColumn FEC_VENCIMIENTO (
                sequence: 6
            )

            displayColumn NRO_LOTE (
                sequence: 5
            )

            displayColumn NRO_PEDIDO (
                sequence: 2
            )

            displayColumn SUCURSAL_ENTRADA (
                sequence: 8
            )

            displayColumn SUCURSAL_SALIDA (
                sequence: 1
            )

            sort (
                column: FEC_VENCIMIENTO
                sort {
                    sequence: 1
                }
            )

            controlBreak (
                column: SUCURSAL_SALIDA
                layout {
                    sequence: 1
                }
            )

        )

    )

    region selector (
        name: Selector
