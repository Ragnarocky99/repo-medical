    region resultados (
        name: Resultados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ped.nro_comprobante as nro_pedido,
                       art.cod_articulo,
                       art.descripcion as desc_articulo,
                       lot.nro_lote,
                       lot.fec_vencimiento,
                       aen.CANITDAD as cantidad,
                       sal.descripcion as sucursal_salida,
                       ent.descripcion as sucursal_entrada,
                       aen.FEC_ALTA as fecha_generacion,
                       (select p.nombre
                          from bsw_personas p,
                               ccw_clientes c,
                               vtw_pedidos_cabecera ped
                         where p.id = c.id_persona
                           and c.id = ped.id_cliente
                           and ped.id = aen.id_pedido) AS CLIENTE
                  from STW_TMP_ARTS_NOTA_ENV aen
                  join stw_articulos         art on art.id = aen.id_articulo
                  join stw_lotes             lot on lot.id = aen.id_lote
                  join bsw_sucursales        sal on sal.id = aen.id_sucursal_sal
                  join bsw_sucursales        ent on ent.id = aen.id_sucursal_ent
                  join vtw_pedidos_cabecera  ped on ped.id = aen.id_pedido
                  where aen.cod_usuario_aud = :APP_USER
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
