    pageItem P710_IDS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @generacion-de-notas-env
            slot: regionBody
        }
    )

    pageItem P710_ID_PEDIDO (
        type: popupLov
        label {
            label: <p>Nro Pedido</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct pc.nro_comprobante,
                pc.id
                from stwv_articulos_a_enviar x
                join vtw_pedidos_cabecera pc on pc.id = x.id_pedido
                join bsw_sucursales suc on suc.id = pc.id_sucursal
                
                ```
            nullDisplayValue: -- Sin Seleccionar --
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: ||' ('||suc.descripcion||')-'||pc.id
        }
    )

    pageItem P710_MENSAJE_PROCEDIMIENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @generacion-de-notas-env
            slot: regionBody
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P710_PEDIDOS (
        type: displayOnly
        label {
            label: Pedidos
            alignment: left
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl((select 'Pedidos implicados: '||listagg(distinct pc.nro_comprobante,',')
                from stwv_articulos_a_enviar x
                join vtw_pedidos_cabecera pc on pc.id = x.id_pedido), '') pedidos
                  from dual
                ```
        }
    )

