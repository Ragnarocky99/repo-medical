    region generacion-de-notas-env (
        name: Generacion de Notas Env.
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- SELECT PED.NRO_COMPROBANTE AS NRO_PEDIDO,
                --        ART.COD_ARTICULO,
                --        ART.DESCRIPCION AS DESC_ARTICULO,
                --        LOT.NRO_LOTE,
                --        LOT.FEC_VENCIMIENTO,
                --        AEN.CANITDAD AS CANTIDAD,
                --        SAL.DESCRIPCION AS SUCURSAL_SALIDA,
                --        ENT.DESCRIPCION AS SUCURSAL_ENTRADA,
                --        AEN.FEC_ALTA AS FECHA_GENERACION,
                --        (SELECT P.NOMBRE
                --           FROM BSW_PERSONAS P,
                --                CCW_CLIENTES C,
                --                VTW_PEDIDOS_CABECERA PED
                --          WHERE P.ID = C.ID_PERSONA
                --            AND C.ID = PED.ID_CLIENTE
                --            AND PED.ID = AEN.ID_PEDIDO) AS CLIENTE,
                --         AEN.ID,
                --         AEN.ID_PEDIDO,
                --         AEN.ID_ARTICULO,
                --         AEN.ID_LOTE
                --   FROM STW_TMP_ARTS_NOTA_ENV AEN
                --   JOIN STW_ARTICULOS         ART ON ART.ID = AEN.ID_ARTICULO
                --   JOIN STW_LOTES             LOT ON LOT.ID = AEN.ID_LOTE
                --   JOIN BSW_SUCURSALES        SAL ON SAL.ID = AEN.ID_SUCURSAL_SAL
                --   JOIN BSW_SUCURSALES        ENT ON ENT.ID = AEN.ID_SUCURSAL_ENT
                --   JOIN VTW_PEDIDOS_CABECERA  PED ON PED.ID = AEN.ID_PEDIDO
                --   WHERE AEN.COD_USUARIO_AUD = :APP_USER
                SELECT C002 NRO_PEDIDO,
                       C003 COD_ARTICULO,
                       C004 DESC_ARTICULO,
                       C005 NRO_LOTE,
                       C006 FEC_VENCIMIENTO,
                       N001 CANTIDAD,
                       C001 SUCURSAL_SALIDA,
                       C008 SUCURSAL_ENTRADA,
                       D001 FECHA_GENERACION,
                       C007 CLIENTE,
                       SEQ_ID ID,
                       N004 ID_PEDIDO,
                       N002 ID_ARTICULO,
                       N005 ID_LOTE,
                       C010 NRO_LICITACION
                  FROM APEX_COLLECTIONS
                 WHERE COLLECTION_NAME = 'STWC_NOTAS_ENVIO'
                   AND C001 != 'LICITACIONES'
                --   FROM STW_TMP_ARTS_NOTA_ENV AEN
                --   JOIN STW_ARTICULOS         ART ON ART.ID = AEN.ID_ARTICULO
                --   JOIN STW_LOTES             LOT ON LOT.ID = AEN.ID_LOTE
                --   JOIN BSW_SUCURSALES        SAL ON SAL.ID = AEN.ID_SUCURSAL_SAL
                --   JOIN BSW_SUCURSALES        ENT ON ENT.ID = AEN.ID_SUCURSAL_ENT
                --   LEFT JOIN VTW_PEDIDOS_CABECERA  PED ON PED.ID = AEN.ID_PEDIDO
                --   WHERE AEN.COD_USUARIO_AUD = :APP_USER
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
