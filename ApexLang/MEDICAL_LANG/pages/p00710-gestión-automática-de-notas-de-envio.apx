            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            displayRegionIcons: true
            includeShowAll: false
        }
    )

    pageItem P710_FEC_DESDE (
        type: datePicker
        label {
            label: <p>Fec Desde</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
