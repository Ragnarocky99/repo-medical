    process generar-tmp (
        name: Generar TMP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                --   STW_GENERA_PREV_NOTA_ENVIO(P_ID_PEDIDO => :P710_ID_PEDIDO,                             
                --                              P_COD_USUARIO_AUD => :APP_USER);
                  STWP_GENERA_NOTA_ENVIO_PREVIO(:P0_ID_EMPRESA);
                  :P710_IDS := NULL;
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 50350789742189520
        }
    )

)

