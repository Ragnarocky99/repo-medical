    region articulos-en-sucursal (
        name: Articulos en Sucursal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ped.nro_comprobante,
                       art.cod_articulo,
                       art.descripcion, 
                       sum(exi.cant_dispon) cant_dispon,
                       cot.id id_cot,
                       art.id id_art,
                       ped.id id_ped,
                       per.nombre as cliente
                from cmw_cotiza_articulos    cot 
                join stw_articulos           art on art.id = cot.id_articulo
                join vtw_pedidos_cabecera    ped on ped.id = cot.id_pedido
                join ccw_clientes            cli on cli.id = ped.id_cliente
                join bsw_personas            per on per.id = cli.id_persona
                join stw_existencia_art      exi on cot.id_articulo = exi.id_articulo
                                                and exi.id_sucursal = ped.id_sucursal
                where nvl(ped.autoriza_stock,'N') = 'S'
                  and nvl(ped.autoriza_ctacte,'N') = 'S'
                  and nvl(cot.cantidad_a_entregar,0) > 0
                  and nvl(cot.nro_occ,'0') != '0'
                  and obtener_cantidad_pendiente(ped.id,art.id,:P0_ID_EMPRESA,cot.id) - nvl(cot.cant_anulada,0) > 0
                group by ped.nro_comprobante, art.cod_articulo, art.descripcion,cot.id,art.id,ped.id,per.nombre
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            icon: fa-box-arrow-in-south
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 52200988943772105
        }

