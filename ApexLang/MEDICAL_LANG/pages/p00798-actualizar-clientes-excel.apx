        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM APEX_COLLECTIONS
                 WHERE COLLECTION_NAME = 'CLIENTES_ERR'
                ```
        }
    )

    button excel (
        buttonName: EXCEL
        label: Subir Excel
        layout {
            sequence: 10
            region: @datos
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload-alt
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM APEX_COLLECTIONS
                 WHERE COLLECTION_NAME = 'CLIENTES_ERR'
                ```
        }
    )

    process actualizar-clientes (
        name: Actualizar Clientes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CLIENTE   CCW_CLIENTES%ROWTYPE;
                    VCANTIDAD   NUMBER := 0;
                BEGIN
                    APEX_COLLECTION.CREATE_OR_TRUNCATE_COLLECTION('CLIENTES_ERR');
                    FOR R1 IN (SELECT *  
                                 FROM APEX_APPLICATION_TEMP_FILES F, 
                                      TABLE( APEX_DATA_PARSER.PARSE(
                                                P_CONTENT                     => F.BLOB_CONTENT,
                                                P_ADD_HEADERS_ROW             => 'N',
                                                P_FILE_NAME                   => F.FILENAME) 
                                            ) P
                                 WHERE F.NAME = :P798_EXCEL AND
                                       P.LINE_NUMBER > 1
                              )
                    LOOP
                        -- Obtemos el ID del cliente
                        BEGIN
                            SELECT ID, ID_PERSONA
                              INTO CLIENTE.ID, CLIENTE.ID_PERSONA
                              FROM CCW_CLIENTES
                             WHERE ID_EMPRESA = :P0_ID_EMPRESA
                               AND COD_CLIENTE = REPLACE(REPLACE(R1.COL001, ' ', ''), CHR(13), '');
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CLIENTES_ERR',
                                                           P_C001            => 'Cliente no encontrado',
                                                           P_C002            => R1.COL001,
                                                           P_C003            => R1.COL002,
                                                           P_N001            => R1.LINE_NUMBER);
                            WHEN OTHERS THEN
                                APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CLIENTES_ERR',
                                                           P_C001            => 'Error inesperado. Error '||SQLERRM,
                                                           P_C002            => R1.COL001,
                                                           P_C003            => R1.COL002,
                                                           P_N001            => R1.LINE_NUMBER);
                        END;
                
                        -- Obtemos el ID del Soporte
                        BEGIN
                            SELECT ID
                              INTO CLIENTE.ID_SOPORTE
                              FROM BSW_PERSONAS
                             WHERE COD_PERSONA = REPLACE(REPLACE(R1.COL005, ' ', ''), CHR(13), '');
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                IF R1.COL005 IS NOT NULL THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CLIENTES_ERR',
                                                               P_C001            => 'Soporte no encontrado',
                                                               P_C002            => R1.COL001,
                                                               P_C003            => R1.COL002,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                            WHEN OTHERS THEN
                                IF R1.COL005 IS NOT NULL THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CLIENTES_ERR',
                                                               P_C001            => 'Error inesperado. Error '||SQLERRM,
                                                               P_C002            => R1.COL001,
                                                               P_C003            => R1.COL002,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                        END;
                
                        -- Obtemos el ID de la condicion de venta
                        BEGIN
                            SELECT ID
                              INTO CLIENTE.ID_CONDICION_VENTA
                              FROM CCW_CONDICIONES_VENTAS
                             WHERE COD_CONDICION_VENTA = REPLACE(REPLACE(R1.COL009, ' ', ''), CHR(13), '')
                               AND ID_EMPRESA = :P0_ID_EMPRESA;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                IF R1.COL009 IS NOT NULL THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CLIENTES_ERR',
                                                               P_C001            => 'Condicion no encontrada',
                                                               P_C002            => R1.COL001,
                                                               P_C003            => R1.COL002,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                            WHEN OTHERS THEN
                                IF R1.COL009 IS NOT NULL THEN
                                    APEX_COLLECTION.ADD_MEMBER(P_COLLECTION_NAME => 'CLIENTES_ERR',
                                                               P_C001            => 'Error inesperado. Error '||SQLERRM,
                                                               P_C002            => R1.COL001,
                                                               P_C003            => R1.COL002,
                                                               P_N001            => R1.LINE_NUMBER);
                                END IF;
                        END;
                
                        IF CLIENTE.ID IS NOT NULL THEN
                            UPDATE CCW_CLIENTES
                               SET NIVEL              = NVL(R1.COL003, NIVEL),
                                   POTENCIAL          = NVL(REPLACE(R1.COL004, '.', ','), POTENCIAL),
                                   ID_SOPORTE         = NVL(CLIENTE.ID_SOPORTE, ID_SOPORTE),
                                   ID_CONDICION_VENTA = NVL(CLIENTE.ID_CONDICION_VENTA, ID_CONDICION_VENTA)
                                   
                             WHERE ID = CLIENTE.ID;
                            
                            UPDATE BSW_PERSONAS
                               SET DIRECCION = NVL(R1.COL006, DIRECCION),
                                   TELEFONO  = NVL(R1.COL007, TELEFONO),
                                   DIREC_ELECTRONICA = NVL(R1.COL008, DIREC_ELECTRONICA)
                             WHERE ID = CLIENTE.ID_PERSONA;
                            VCANTIDAD := VCANTIDAD + 1;
                        END IF;
                
                        
                    END LOOP;
                
                    IF VCANTIDAD > 0 THEN
                        :P798_MENSAJE := 'Proceso concluido con Exito. Se procesaron '||VCANTIDAD||' registros';
                    ELSE
                        :P798_MENSAJE := 'No se realizó ninguna accion';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P798_MENSAJE.
        }
        advanced {
            executionMappingIdentifier: 51418013283189540
        }
        serverSideCondition {
            whenButtonPressed: @excel
            type: itemIsNotNull
            item: P798_EXCEL
        }
    )

    process eliminar-coleccion (
        name: Eliminar Coleccion
        type: executeCode
        source {
            plsqlCode: APEX_COLLECTION.DELETE_COLLECTION(P_COLLECTION_NAME => 'CLIENTES_ERR');
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 51418430654189540
        }
        serverSideCondition {
            whenButtonPressed: @clear
        }
    )

)

