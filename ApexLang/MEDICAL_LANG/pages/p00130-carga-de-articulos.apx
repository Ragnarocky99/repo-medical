    dynamicAction refrescar-lv-2 (
        name: Refrescar lv
        execution {
            sequence: 70
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @moneda
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P130_ID_MONEDA_BASE
            }
