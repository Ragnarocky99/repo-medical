    dynamicAction alertas-palabras-claves (
        name: Alertas Palabras Claves
        execution {
            sequence: 180
        }
        when {
            event: keyup
            selectionType: items
            items: [
                P130_DESCRIPCION
                P130_DESCRIPCION_INGLES
                P130_SINONIMO
            ]
        }

        action p130-ind-alerta (
            name: P130_IND_ALERTA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        VIND_ALERTA      VARCHAR2(1) := 'S';
                        VITERACION       NUMBER := 0;
                    BEGIN
                        IF :P130_DESCRIPCION IS NOT NULL OR
                           :P130_DESCRIPCION_INGLES IS NOT NULL OR
                           :P130_SINONIMO IS NOT NULL THEN
                            -- Verificamos si es peligroso
                            BEGIN
                                SELECT 'S'
                                  INTO :P130_IND_ALERTA
                                  FROM STW_SINONIMOS_ALERTAS T
                                 WHERE (INSTR(UPPER(:P130_DESCRIPCION), UPPER(T.DESCRIPCION)) > 0 OR
                                        INSTR(UPPER(:P130_DESCRIPCION_INGLES), UPPER(T.DESCRIPCION)) > 0 OR
                                        INSTR(UPPER(:P130_SINONIMO), UPPER(T.DESCRIPCION)) > 0)
                                   AND T.IND_PELIGROSO = 'S';
                                :P130_MENSAJE_ALERTA := 'Posible Articulo Peligro! Verificar <br>';
                            EXCEPTION
                                WHEN OTHERS THEN
                                    :P130_IND_ALERTA := 'N';
                                    :P130_MENSAJE_ALERTA := NULL;
                            END;
                    
                            -- Verificamos si es dimabel
                            BEGIN
                                SELECT 'S'
                                  INTO :P130_IND_ALERTA
                                  FROM STW_SINONIMOS_ALERTAS T
                                 WHERE (INSTR(UPPER(:P130_DESCRIPCION), UPPER(T.DESCRIPCION)) > 0 OR
                                        INSTR(UPPER(:P130_DESCRIPCION_INGLES), UPPER(T.DESCRIPCION)) > 0 OR
                                        INSTR(UPPER(:P130_SINONIMO), UPPER(T.DESCRIPCION)) > 0)
                                   AND T.IND_DIMABEL = 'S';
                                :P130_MENSAJE_ALERTA := NVL(:P130_MENSAJE_ALERTA, '')||'Posible Articulo Dimabel! Verificar <br>';
                            EXCEPTION
                                WHEN OTHERS THEN
                                    NULL;
                            END;
                    
                            -- Verificar si pertenece a un grupo
                            BEGIN
                                FOR I IN (
                                    SELECT APEX_STRING.SPLIT(T.DESCRIPCION, ' ') PALABRAS_CLAVES,
                                           T.ID_GRUPO_ART,
                                           G.DESCRIPCION DESC_GRUPO
                                      FROM STW_SINONIMOS_ALERTAS T
                                      JOIN STW_GRUPOS_ART        G ON G.ID = T.ID_GRUPO_ART
                                )
                                LOOP
                                    VIND_ALERTA := 'S';
                                    FOR J IN 1..I.PALABRAS_CLAVES.COUNT()
                                    LOOP
                                        IF INSTR(UPPER(:P130_DESCRIPCION), UPPER(I.PALABRAS_CLAVES(J))) = 0 OR
                                           INSTR(UPPER(:P130_DESCRIPCION_INGLES), UPPER(I.PALABRAS_CLAVES(J))) = 0 OR
                                           INSTR(UPPER(:P130_SINONIMO), UPPER(I.PALABRAS_CLAVES(J))) = 0 THEN
                                            VIND_ALERTA := 'N';
                                            EXIT;
                                        END IF;
                                        
                                    END LOOP;
                    
                                    IF VIND_ALERTA = 'S' THEN
                                        IF VITERACION = 0 AND INSTR(NVL(:P130_MENSAJE_ALERTA, 'X'), 'Posible grupo del articulo') = 0THEN
                                            :P130_MENSAJE_ALERTA := NVL(:P130_MENSAJE_ALERTA, '')||'Posible grupo del articulo:<br>';
                                        END IF;
                                        IF INSTR(NVL(:P130_MENSAJE_ALERTA, 'X'), I.DESC_GRUPO) = 0 THEN
                                            :P130_MENSAJE_ALERTA := NVL(:P130_MENSAJE_ALERTA, '')||I.DESC_GRUPO||'<br>';
                                            :P130_IND_ALERTA := 'S';  
                                        END IF;
                                    END IF;
                                END LOOP;
                            EXCEPTION
                                WHEN OTHERS THEN
                                    --:P130_IND_ALERTA := 'N';
                                   -- :P130_MENSAJE_ALERTA := NULL;
                                   RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                            END;
                            
                        END IF;
                    EXCEPTION
                        WHEN OTHERS THEN
                            --:P130_IND_ALERTA := 'N';
                            --:P130_MENSAJE_ALERTA := NULL;
                            RAISE_APPLICATION_ERROR(-20000, SQLERRM);
                    END;
                    ```
                itemsToSubmit: [
                    P130_DESCRIPCION
                    P130_DESCRIPCION_INGLES
                    P130_SINONIMO
                    P130_IND_DIMABEL
                ]
                itemsToReturn: [
                    P130_IND_ALERTA
                    P130_MENSAJE_ALERTA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-notifications (
            action: plugin/fosNotifications
            settings {
                action: showWarning
                message: &P130_MENSAJE_ALERTA!RAW.
                overrideDefaults: true
                options: [
                    preventDuplicates
                    newestOnTop
                    performClientSideSubstitutions
                    dismissOnNotificationClickTap
                    dismissOnCloseButtonClick
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P130_IND_ALERTA
                value: S
            }
        )

    )

