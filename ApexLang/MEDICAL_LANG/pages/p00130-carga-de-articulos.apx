    region costos (
        name: Costos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_ARTICULO,
                       ID_COMPROBANTE,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       COSTO_PROMROBANTE,
                       CANTIDAD,
                       SALDO,
                       FEC_COMPROBANTE,
                       FEC_PROCESO
                  from STW_COSTOS_ART_FIFO
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contabilidad-y-costos
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: MY_ELEMENT
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  V_PERMISO VARCHAR2(1);
                BEGIN
                  SELECT 'S'
                    INTO V_PERMISO
                    FROM BSW_PERMISOS_FORMAS F, BSW_PERMISOS_OPCIONES O
                   WHERE F.ID_PERMISO = O.ID
                     AND F.ID_PAGINA = :APP_PAGE_ID
                     AND F.ID_EMPRESA = O.ID_EMPRESA
                     AND F.ID_EMPRESA = :P0_ID_EMPRESA
                     AND F.ID_USUARIO = TRAE_ID_USUARIO(:P0_ID_EMPRESA, UPPER(:APP_USER))
                     AND O.PARAMETRO = 'VISUALIZAR_COSTO';
                  
                  IF V_PERMISO = 'S' THEN
                    RETURN TRUE; -- Muestra la región
                  ELSE
                    RETURN FALSE; -- Oculta la región
                  END IF;
                  
                  EXCEPTION
                    WHEN OTHERS THEN
                      RETURN FALSE;
                END;
                ```
        }
