    pageItem P130_PORC_DESCUENTO (
        type: numberField
        label {
            label: <p>Porc.Descuento:</p>
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 340
            region: @datos
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @carga-de-articulos
            column: PORC_DESCUENTO
            dataType: number
        }
        readOnly {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                V_IND_PERMISO VARCHAR2(1);
                BEGIN
                V_IND_PERMISO := W_BUSCA_PERMISO(:P0_ID_EMPRESA,:APP_PAGE_ID,TRAE_ID_USUARIO(:P0_ID_EMPRESA,:APP_USER),'CARGA_DESCUENTO');
                
                IF V_IND_PERMISO='S' THEN 
                RETURN FALSE; 
                ELSIF V_IND_PERMISO='N' THEN
                RETURN TRUE;
                END IF;
                END;
                ```
        }
    )

