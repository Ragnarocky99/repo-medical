            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Global variable to store timeout ID
            var timeoutId;
            
            // This function removes the ' character from the input value
            function removeApostrophe(inputId) {
                // Clear previous timeout if any
                clearTimeout(timeoutId);
                
                // Set a timeout to run the sanitization after a short delay
                timeoutId = setTimeout(function() {
                    var inputElement = apex.item(inputId).node;
                    var inputValue = inputElement.value;
                    
                    // Remove specified special characters
                    var sanitizedInput = inputValue.replace(/[`'´"\^~\[\]{}<>&áéíóúÁÉÍÓÚÝ]/g, '');
                    
                    // Capitalize the input
                    sanitizedInput = sanitizedInput.replace(/\w+/g, function(word) {
                        return word.charAt(0).toUpperCase() + word.slice(1);
                    });
                    
                    // Update the input value
                    inputElement.value = sanitizedInput;
                }, 300); // Adjust the delay (in milliseconds) as needed
            }
            
            
            document.getElementById("P130_COD_ARTICULO").readOnly = true;
            ```
    }
