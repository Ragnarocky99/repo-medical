        execution {
            sequence: 200
        }
        when {
            selectionType: items
            items: P130_ID_MARCA
        }

        action p130-id-pais-origen (
            name: P130_ID_PAIS_ORIGEN
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(ID_PAIS, W_BUSCA_PARAMETRO('BS', 'ID_PAIS_PY'))
                      FROM STW_MARCAS
                     WHERE ID = :P130_ID_MARCA
                    ```
                itemsToSubmit: P130_ID_MARCA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P130_ID_PAIS_ORIGEN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p130-carga-descuento (
        itemName: P130_CARGA_DESCUENTO
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                RETURN W_BUSCA_PERMISO(:P0_ID_EMPRESA,:APP_PAGE_ID,TRAE_ID_USUARIO(:P0_ID_EMPRESA,:APP_USER),'CARGA_DESCUENTO');
                END;
                ```
        }
    )

    computation p130-cod-articulo (
        itemName: P130_COD_ARTICULO
        execution {
            sequence: 30
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                V_COD_ARTICULO number(10);
                
                BEGIN
                    SELECT NVL(MAX(TO_NUMBER(COD_ARTICULO)),0)+1 
                     INTO  V_COD_ARTICULO 
                     FROM STW_ARTICULOS A     
                     WHERE A.ID_EMPRESA = :P0_ID_EMPRESA; 
                    RETURN V_COD_ARTICULO;
                
                    EXCEPTION
                     WHEN OTHERS THEN
                      RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P130_ID
        }
    )

    computation p130-visualizar-costo (
        itemName: P130_VISUALIZAR_COSTO
        execution {
            sequence: 20
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  V_PERMISO VARCHAR2(1);
                BEGIN
                  SELECT 'S'
                    INTO V_PERMISO
                    FROM BSW_PERMISOS_FORMAS F, BSW_PERMISOS_OPCIONES O
                   WHERE F.ID_PERMISO = O.ID
                     AND F.ID_PAGINA = :APP_PAGE_ID
                     AND F.ID_EMPRESA = O.ID_EMPRESA
                     AND F.ID_EMPRESA = :P0_ID_EMPRESA
                     AND F.ID_USUARIO = TRAE_ID_USUARIO(:P0_ID_EMPRESA, UPPER(:APP_USER))
                     AND O.PARAMETRO = 'VISUALIZAR_COSTO';
                  RETURN V_PERMISO;
                EXCEPTION
                  WHEN OTHERS THEN
                    RETURN 'N';
                END;
                
                ```
        }
    )

