page 146 (
    name: Carga de Lista de Precios
    alias: CARGA-DE-LISTA-DE-PRECIOS
    title: Carga de Lista de Precios
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 700px
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-lista-de-precios (
        name: Carga de Lista de Precios
        type: form
        source {
            location: localDatabase
            tableName: VTW_LISTAS_PRECIOS_CAB
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar
        }
    )

    pageItem P146_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @carga-de-lista-de-precios
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-lista-de-precios
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P146_COD_LISTA_PRECIO (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Lista Precio:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-lista-de-precios
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 8
            labelColumnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        source {
            formRegion: @carga-de-lista-de-precios
            column: COD_LISTA_PRECIO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT NVL(MAX(TO_NUMBER(COD_LISTA_PRECIO)), 0) + 1 FROM VTW_LISTAS_PRECIOS_CAB WHERE ID_EMPRESA=:P0_ID_EMPRESA;
        }
    )

