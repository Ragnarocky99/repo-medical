            plsqlFunctionBody:
                ```plsql
                declare
                v_id_asiento number(10);
                begin
                select id 
                INTO V_ID_ASIENTO
                from cow_diario_cabeceras_prov
                where num_asiento  = :P155_ASIENTOS
                  and id_empresa   = :P0_ID_EMPRESA
                  and id_ejercicio = trae_id_ejercicio(:P155_FEC_COMPROBANTE);
