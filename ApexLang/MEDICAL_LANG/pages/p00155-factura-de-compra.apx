    dynamicAction cargar-datos-proveedor (
        name: Cargar Datos Proveedor
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P155_ID_PROVEEDOR
        }

        action native-set-value (
            name: P155_ID_PROVEEDOR_REF
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    :P155_ID_PROVEEDOR
                    
                    ```
                itemsToSubmit: P155_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P155_ID_PROVEEDOR_REF
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            name: P155_NOM_PROVEEDOR
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nombre_proveedor  BSW_PERSONAS.NOMBRE%TYPE;
                    BEGIN
                    select ltrim(p.nombre) nombre
                    INTO v_nombre_proveedor
                     from bsw_personas p, cmw_proveedores v 
                     where v.id_empresa = :P0_COD_EMPRESA
                     and v.id_persona = p.ID 
                     AND V.ID=:P155_ID_PROVEEDOR;
                    RETURN v_nombre_proveedor;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    return null;
                    when others then
                    raise_application_error(-20000,'Error en la tabla de proveedores'||sqlerrm);
                    return null;
                    END;
                    ```
                itemsToSubmit: P155_ID_PROVEEDOR
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P155_NOM_PROVEEDOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

