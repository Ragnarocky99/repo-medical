        action iva-y-lote (
            name: IVA Y LOTE
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_maneja_lote varchar(1);
                    BEGIN
                    IF NVL(:P155_IND_EXENTO,'N')='N' THEN 
                    SELECT NVL(IND_MANEJA_LOTE,'X')
                    into v_maneja_lote
                    from stw_articulos 
                    where id=:id_articulo ;
                    
                    --IF V_MANEJA_LOTE='S' THEN
                    SELECT NVL(:ID_LOTE, L.ID), A.ID_IVA,I.PORC_IVA_VENTA,NVL(:NRO_LOTE, MAX(L.NRO_LOTE))
                    INTO :ID_LOTE,:ID_IVA,:PORC_IVA,:NRO_LOTE
                    FROM STW_LOTES L,STW_IVA I, STW_ARTICULOS A
                    WHERE L.ID_ARTICULO=:ID_ARTICULO
                    AND  A.ID_IVA=I.ID
                    AND FEC_VENCIMIENTO>=SYSDATE
                    AND A.ID = :ID_ARTICULO
                    AND ROWNUM =1
                    GROUP BY L.ID,A.ID_IVA,I.PORC_IVA_VENTA;
                    /*ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;*/
                    --END IF;
                    ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I WHERE 
                    COD_IVA=W_BUSCA_PARAMETRO('ST','COD_IVA_EXENTA');
                    END IF;
                    EXCEPTION WHEN
                    NO_DATA_FOUND THEN
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;
                    END;
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P155_IND_EXENTO
                    ID_LOTE
                    NRO_LOTE
                ]
                itemsToReturn: [
                    ID_LOTE
                    ID_IVA
                    PORC_IVA
                    NRO_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
            }
        )

        action precio-y-medida (
            name: Precio y Medida
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null then
                         :PRECIO_UNITARIO_C_IVA :=0;
                    end if;
                    if :IVA IS NULL THEN
                    :IVA:=0;
                    END IF;
                    
                    
                    BEGIN
                    IF :PRECIO_UNITARIO_C_IVA IS NULL THEN
                        SELECT NVL(MAX(PRECIO),0) 
                        INTO :PRECIO_UNITARIO_C_IVA
                        FROM CMWV_PROVEEDORES_ARTICULOS
                        WHERE ID_PROVEEDOR=:P155_ID_PROVEEDOR
                        AND ID_ARTICULO=:ID_ARTICULO;
                    END IF;
                    
                    SELECT ID_UNIDAD_MEDIDA,ID_ARANCEL, ID_ENVASE, COD_ORIGEN_ART
                    INTO :ID_UNIDAD_MEDIDA,:ID_ARANCEL, :ID_ENVASE, :COD_ORIGEN_ART
                    FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    IF :CANTIDAD IS NULL THEN
                        SELECT 1
                        INTO :CANTIDAD 
                        FROM DUAL;
                    END IF;
                    
                    END;
                    
                    
                        
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P155_FEC_COMPROBANTE
                    P155_ID_PROVEEDOR
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                ]
                itemsToReturn: [
                    PRECIO_UNITARIO_C_IVA
                    ID_IVA
                    IVA
                    PORC_IVA
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                    ID_ARANCEL
                    ID_ENVASE
                    COD_ORIGEN_ART
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

