    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  D.ID,
                       D.ID_COMPRAS_CAB,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       A.COD_ORIGEN_ART,
                       A.ID_ENVASE,
                       D.CANTIDAD,
                       D.PRECIO_FACTURA,
                       D.PRECIO_UNITARIO,
                       D.MONTO_GASTOS,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.MONTO_REF,
                       D.MONTO_GASTOS_REF,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.ID_LOTE,
                       D.ID_CENTRO_COSTO,
                       D.ID_IVA,
                       D.DESCRIPCION,
                       D.OBSERVACION,
                       D.ID_CUENTA,
                       D.MONTO_TOTAL_C_IVA,
                       D.IND_STOCK,
                       D.ID_PEDIDO_CAB,
                       D.IND_CONSIGNACION,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PORC_DESCUENTO,
                       D.DESCUENTO,
                       D.DESCUENTO_C_IVA,
                       D.PORC_DESCUENTO_2,
                       D.DESCUENTO_2,
                       D.DESCUENTO_C_IVA_2,
                       D.PORC_GRAVADA,
                       D.IVA,
                       D.EXENTO,
                       D.GRAVADA,
                       D.TOTAL_EXENTO,
                       D.TOTAL_GRAVADA,
                       D.DESC_ARTICULO,
                       D.COD_BARRA_ART,
                       D.ID_BARRA,
                       D.ID_ARANCEL,
                       D.NRO_OCC,
                       D.TIP_OCP,
                       D.SER_OCP,
                       D.NRO_OCP,
                       L.FEC_VENCIMIENTO,
                       D.ID_PEDIDO_DET,
                       D.TRIPTICO,
                       D.FEC_TRIPTICO,
                       DECODE(NVL(A.IND_PELIGROSO, 'N'), 'N', 'No',
                                                         'S', 'Si') IND_PELIGROSO,
                       DECODE(NVL(A.IND_CONTROLADO, 'N'), 'N', 'No',
                                                         'S', 'Si') IND_CONTROLADO
                    from CMW_COMPRAS_DETALLE D,STW_ARTICULOS A,
                    STW_LOTES L
                 where ID_COMPRAS_CAB=:P155_ID
                 AND A.ID=D.ID_ARTICULO
                 AND D.ID_LOTE = L.ID(+)
                 ----AND D.ID_ARTICULO <> 726
                ```
            pageItemsToSubmit: [
                P155_ID
                P155_ID_PEDIDO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-Form--noPadding
                t-Form--labelsAbove
                margin-top-none
                margin-bottom-none
            ]
        }
