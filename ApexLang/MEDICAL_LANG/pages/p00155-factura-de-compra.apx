    region factura-de-compra (
        name: Factura de Compra
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_SUCURSAL,
                       FEC_COMPROBANTE,
                       ID_PROVEEDOR,
                       ID_CONDICION_COMPRA,
                       TIP_COMPROBANTE_REF,
                       SER_COMPROBANTE_REF,
                       NRO_COMPROBANTE_REF,
                       TOT_COMPROBANTE,
                       TOT_GRAVADAS,
                       TOT_EXENTAS,
                       TOT_IVA,
                       DESCUENTO,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       REFERENCIA,
                       ID_PROVEEDOR_REF,
                       NOM_PROVEEDOR,
                       RUC,
                       TOT_AJUSTE,
                       COD_USUARIO_AUD,
                       ID_EMBARQUE,
                       ID_PEDIDO,
                       IND_COBRO_TARJETA,
                       IND_CAJA_CHICA,
                       NRO_TIMBRADO,
                       REPLACE(REPLACE(ASIENTOS,'*'),'compras') ASIENTOS,
                       NRO_COMPROBANTE_PROV,
                       ID_CENTRO_COSTO,
                       IND_GENERA_ASIENTO,
                       ID_CUENTA,
                       ID_TIMBRADO,
                       ID_MOTIVO_NCR,
                       ID_COMPROBANTE_REF,
                       PATH_FACTURA,
                       NOMBRE_CORTO,
                       ID_RECEPCION,
                       ID_SUCURSAL_CENTRAL,
                       ID_ANTERIOR,
                       PORC_DESCUENTO_1,
                       DESCUENTO_1,
                       DESCUENTO_C_IVA_1,
                       PORC_DESCUENTO_2,
                       DESCUENTO_2,
                       DESCUENTO_C_IVA_2,
                       ID_SUBTIP_DENOMINACION,
                       FEC_VENC_TIMBRADO,
                       ID_CONCEPTO,
                       OBSERVACION,
                       IND_EXENTO,
                       DESTINO,
                       TOT_COMPROBANTE_ADUANA,
                       ind_tipo_comprobante,
                       FOTO_COMPROBANTE,
                       TIPO_CAMBIO
                  from CMW_COMPRAS_CABECERA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: Contenedor
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: 84572841242776715
            update: 85388203044202291
            delete: 85388824842213315
        }
    )

