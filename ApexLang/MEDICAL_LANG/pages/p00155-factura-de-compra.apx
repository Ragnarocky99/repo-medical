    computation p155-ind-tipo-comprobante (
        itemName: P155_IND_TIPO_COMPROBANTE
        execution {
            sequence: 70
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                    IF :P155_IND_TIPO_COMPROBANTE IS NULL THEN 
                        RETURN 'IM';
                    ELSIF :P155_IND_TIPO_COMPROBANTE = 'FE' THEN 
                        RETURN 'FE';
                    ELSIF :P155_IND_TIPO_COMPROBANTE = 'FV' THEN 
                        RETURN 'FV';
                    ELSIF :P155_IND_TIPO_COMPROBANTE = 'VI' THEN
                        RETURN 'VI';
                    ELSE
                        RETURN 'O';
                    END IF ;
                END;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    computation p155-iva (
        itemName: P155_IVA_5
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                    WHERE :P155_ID=ID_COMPRAS_CAB;
                    item_detalle CMW_COMPRAS_DETALLE%rowtype;
                    v_total_iva_5    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P155_ID
        }
    )

    computation p155-iva-2 (
        itemName: P155_IVA_10
        execution {
            sequence: 80
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                    WHERE :P155_ID=ID_COMPRAS_CAB;
                    item_detalle CMW_COMPRAS_DETALLE%rowtype;
                    v_total_iva_10    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_iva_10:=v_total_iva_10+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_10;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P155_ID
        }
    )

    computation p155-nro-comprobante (
        itemName: P155_NRO_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P155_NRO_COMPROBANTE IS  NULL THEN
                SELECT MAX(NRO_COMPROBANTE)+1
                INTO v_nro_comprobante
                FROM
                CMW_COMPRAS_CABECERA 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P155_SER_COMPROBANTE=SER_COMPROBANTE
                AND :P155_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P155_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
        comments {
            comments: "Calculo para calcular el nro comprobante a guardarse si es que no se escribio un numero de manera manual "
        }
    )

