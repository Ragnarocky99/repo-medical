    dynamicAction calcular-montos (
        name: CALCULAR_MONTOS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
                PORC_DESCUENTO
                ID_IVA
            ]
        }
        comments {
            comments: Aqui se van calculando los totales correspondientes  (Monto total con iva , monto total , total iva ,descuentos)
        }

        action calcular-totales (
            name: Calcular Totales
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action descuento (
            name: Descuento
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :PORC_DESCUENTO IS NULL THEN
                    :PORC_DESCUENTO:=0 ;
                    END IF;
                    
                    :DESCUENTO_C_IVA:=REPLACE(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_DESCUENTO/100);
                    
                    ```
                itemsToSubmit: [
                    PORC_DESCUENTO
                    PRECIO_UNITARIO_C_IVA
                ]
                itemsToReturn: DESCUENTO_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action monto-total (
            name: MONTO TOTAL
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :MONTO_TOTAL is null  then
                       :MONTO_TOTAL:= 0;
                    end if;
                    
                    
                    --:MONTO_TOTAL :=:MONTO_TOTAL_C_IVA -:IVA;
                    :MONTO_TOTAL := round((replace(:MONTO_TOTAL_C_IVA, '.', '') - replace(:TOTAL_IVA, '.', '')),:P155_DECIMALES);
                    ```
                itemsToSubmit: [
                    MONTO_TOTAL_C_IVA
                    TOTAL_IVA
                    P155_DECIMALES
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action monto-total-c-iva (
            name: Monto total C/IVA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :CANTIDAD is null then
                         :CANTIDAD := 1;
                    end if;
                    
                    if :PRECIO_UNITARIO_C_IVA is null THEN
                        :PRECIO_UNITARIO_C_IVA    := 0;
                        :TOTAL_IVA := 0;
                        END IF;
                    
                        IF :DESCUENTO_C_IVA IS NULL THEN
                        :DESCUENTO_C_IVA:=0;
                    end if;
                    
                    
                    :MONTO_TOTAL_C_IVA :=round(replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)),:P155_DECIMALES);
                    IF :DESCUENTO_C_IVA IS NOT NULL AND :DESCUENTO_C_IVA!=0 THEN 
                    :P155_DESCUENTO_V:=round(replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0),:P155_DECIMALES);
                    END IF;
                    --:MONTO_TOTAL_C_IVA:=:CANTIDAD * :PRECIO_UNITARIO_C_IVA;
                    
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    CANTIDAD
                    DESCUENTO_C_IVA
                    P155_DECIMALES
                ]
                itemsToReturn: [
                    MONTO_TOTAL
                    MONTO_TOTAL_C_IVA
                    P155_DESCUENTO_V
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action precio-unitario (
            name: PRECIO UNITARIO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_precio_unitario number;
                    begin
                    IF :PRECIO_UNITARIO IS NULL THEN
                    :PRECIO_UNITARIO:=0;
                    END IF;
                    
                     IF :P155_IND_EXENTO='N' THEN 
                    
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_IVA/(100+:PORC_IVA)),:P155_DECIMALES);
                     :PRECIO_UNITARIO:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,:P155_DECIMALES);
                     ELSE 
                     :PRECIO_UNITARIO:=:PRECIO_UNITARIO_C_IVA;
                     END IF;
                     end;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    P155_DECIMALES
                    P155_IND_EXENTO
                ]
                itemsToReturn: PRECIO_UNITARIO
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action total-iva (
            name: Total IVA
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null  then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    if :TOTAL_IVA is null then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    :TOTAL_IVA := round((((replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)) * replace(:CANTIDAD, '.', '')) * :PORC_IVA ) / (100 + :PORC_IVA),:P155_DECIMALES);
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    DESCUENTO_C_IVA
                    P155_DECIMALES
                ]
                itemsToReturn: TOTAL_IVA
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

