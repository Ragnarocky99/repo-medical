    dynamicAction cargar-datos-ref (
        name: Cargar datos REF
        execution {
            sequence: 320
            type: throttle
            time: 1
            immediate: true
        }
        when {
            selectionType: items
            items: P155_PEDIDOS_EMB
        }

        action cargar-datos-cabecera (
            name: Cargar Datos Cabecera
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                       IF :P155_TIP_COMPROBANTE_REF='PED' THEN
                    SELECT PE.ID,PE.ID_PROVEEDOR,PE.ID_PROVEEDOR,PE.ID_MONEDA,PE.ID_CONDICION_COMPRA,PE.NRO_COMPROBANTE,PR.EXENTO
                    INTO :P155_ID_PEDIDO,:P155_ID_PROVEEDOR,:P155_ID_PROVEEDOR_REF,:P155_ID_MONEDA,:P155_ID_CONDICION_COMPRA,:P155_NRO_COMPROBANTE_REF,
                    :P155_IND_EXENTO
                    FROM CMW_PEDIDOS_CABECERA PE,CMW_PROVEEDORES PR 
                    WHERE PE.ID=:P155_PEDIDOS_EMB
                    AND PE.ID_EMPRESA=:P0_ID_EMPRESA
                    AND PR.ID=PE.ID_PROVEEDOR; 
                      ELSIF :P155_TIP_COMPROBANTE_REF='EMB' THEN -- En este item se guarda el ID del comprobante elegido en la lista de valores 
                    SELECT EM.ID,PR.ID_PROVEEDOR,PR.ID_PROVEEDOR,PR.ID_MONEDA,PR.ID_CONDICION_COMPRA,EM.NRO_EMBARQUE,PO.EXENTO
                    INTO :P155_ID_EMBARQUE,:P155_ID_PROVEEDOR,:P155_ID_PROVEEDOR_REF,:P155_ID_MONEDA,:P155_ID_CONDICION_COMPRA,:P155_NRO_COMPROBANTE_REF,
                    :P155_IND_EXENTO
                    FROM CMW_EMBARQUES EM ,CMW_PROFORMAS_CABECERA PR,CMW_PROVEEDORES PO
                    WHERE EM.ID=:P155_PEDIDOS_EMB -- En este item se guarda el ID del comprobante elegido en la lista de valores  
                    AND EM.ID_EMPRESA=:P0_ID_EMPRESA 
                    AND EM.ID_PROFORMA=PR.ID
                    AND PR.ID_PROVEEDOR=PO.ID;
                       END IF;
                      
                    EXCEPTION 
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar los datos del comprobante :'||sqlerrm);
                    END;
                    
                    ```
                itemsToSubmit: [
                    P155_TIP_COMPROBANTE_REF
                    P155_PEDIDOS_EMB
                ]
                itemsToReturn: [
                    P155_ID_PEDIDO
                    P155_ID_EMBARQUE
                    P155_ID_MONEDA
                    P155_ID_CONDICION_COMPRA
                    P155_ID_PROVEEDOR_REF
                    P155_NRO_COMPROBANTE_REF
                    P155_IND_EXENTO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P155_PEDIDOS_EMB
            }
        )

        action native-javascript-code (
            action: executeJsCode
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P155_PEDIDOS_EMB
            }
        )

        action preparar-json-de-detalle (
            name: Preparar JSON de detalle
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    IF :P155_TIP_COMPROBANTE_REF='PED' THEN
                      OPEN l_cursor FOR
                    SELECT e.ID_ARTICULO AS "ID_ARTICULO",
                    nvl(E.cantidad,0) - nvl((select cd.cantidad from cmw_compras_detalle  cd where cd.id_pedido_det = e.id), 0) AS "CANTIDAD",
                    e.PRECIO_UNITARIO AS "PRECIO_UNITARIO",
                    A.COD_ARTICULO AS "COD_ARTICULO",
                    E.DESCUENTO,
                    CASE NVL(:P155_IND_EXENTO,'N')
                    WHEN 'S' THEN E.MONTO_TOTAL_C_IVA
                    ELSE E.MONTO_TOTAL
                    END AS
                    MONTO_TOTAL,
                    CASE NVL(:P155_IND_EXENTO,'N') 
                    WHEN 'S' THEN 0 
                    ELSE E.TOTAL_IVA 
                    END AS 
                    TOTAL_IVA,
                    E.CANTIDAD_UB,
                    E.ID_UNIDAD_MEDIDA,
                    E.NRO_LOTE,
                    E.FEC_VENCIMIENTO,
                    CASE NVL(:P155_IND_EXENTO,'N')
                    WHEN 'S' THEN 0
                    ELSE 
                    E.IVA END AS IVA,
                    ROUND(E.PRECIO_UNITARIO_C_IVA,M.DECIMALES) AS PRECIO_UNITARIO_C_IVA,
                    E.DESCUENTO_C_IVA,
                    E.ID_IVA,
                               E.MONTO_TOTAL_C_IVA,
                               A.DESCRIPCION,
                               NVL(E.PRECIO_UNITARIO,0) AS PRECIO_UNITARIO,
                               TRAE_ID_LOTE(:P0_ID_EMPRESA, E.ID_ARTICULO, E.NRO_LOTE) as ID_LOTE,
                               E.ID_PEDIDO_CAB,
                               E.NRO_OCC,
                               C.TIP_COMPROBANTE AS TIP_OCP,
                    C.SER_COMPROBANTE AS SER_OCP,
                    C.NRO_COMPROBANTE AS NRO_OCP,
                    C.ID AS ID_PEDIDO_CAB,
                    E.ID AS ID_PEDIDO_DET,
                    A.ID_ENVASE,
                    A.COD_ORIGEN_ART
                        FROM   CMW_PEDIDOS_DETALLE E,CMW_PEDIDOS_CABECERA C,STW_ARTICULOS A,BSW_MONEDAS M
                        WHERE  E.ID_PEDIDO_CAB= :P155_PEDIDOS_EMB
                        AND E.ID_ARTICULO= A.ID
                        AND E.ID_PEDIDO_CAB=C.ID
                        AND nvl(E.cantidad,0) - nvl((select cd.cantidad from cmw_compras_detalle  cd where cd.id_pedido_det = e.id), 0) > 0
                        AND C.ID_MONEDA=M.ID
                        AND (NVL(E.IND_APROBADO, 'N') = 'S' OR E.ID_COTIZA_ART IS NOT NULL OR E.ID_APROBACION_LIC IS NOT NULL)
                        AND NVL(E.ANULADO, 'N') != 'S';
                        ELSIF :P155_TIP_COMPROBANTE_REF='EMB' THEN
                        OPEN l_cursor FOR
                            SELECT e.ID_ARTICULO AS "ID_ARTICULO",
                               nvl(PD.CANTIDAD,0) AS "CANTIDAD",
                               E.PRECIO_UNITARIO AS "PRECIO_UNITARIO",
                               A.COD_ARTICULO AS "COD_ARTICULO",
                               E.DESCUENTO,
                               CASE NVL('S','N')
                               WHEN 'S' THEN PD.MONTO_TOTAL_C_IVA
                               ELSE PD.MONTO_TOTAL
                               END AS
                               MONTO_TOTAL,
                               CASE NVL('S','N')
                               WHEN 'S' THEN 0 
                               ELSE PD.TOTAL_IVA
                               END AS
                               TOTAL_IVA,
                               PD.CANTIDAD_UB,
                               E.ID_UNIDAD_MEDIDA,
                               E.NRO_LOTE,
                               TO_DATE(E.FEC_VENCIMIENTO, 'dd/MM/yyyy') FEC_VENCIMIENTO,
                               CASE NVL('S','N')
                               WHEN 'S' THEN 0
                               ELSE E.IVA 
                               END AS 
                               IVA,
                               ROUND(PD.PRECIO_UNITARIO_C_IVA,NVL(M.DECIMALES,0)) AS PRECIO_UNITARIO_C_IVA,
                               E.DESCUENTO_C_IVA,
                               E.ID_IVA,
                               PD.MONTO_TOTAL_C_IVA,
                               A.DESCRIPCION,
                               NVL(E.PRECIO_UNITARIO,0) AS PRECIO_UNITARIO,
                               TRAE_ID_LOTE('121',E.ID_ARTICULO, E.NRO_LOTE) ID_LOTE,
                               E.ID_PEDIDO_CAB,
                               E.NRO_OCC,
                               C.TIP_COMPROBANTE AS TIP_OCP,
                               C.SER_COMPROBANTE AS SER_OCP,
                               C.NRO_COMPROBANTE AS NRO_OCP,
                               C.ID AS ID_PEDIDO_CAB,
                               E.ID AS ID_PEDIDO_DET,
                               A.ID_ENVASE,
                               A.COD_ORIGEN_ART
                        FROM   CMW_PEDIDOS_DETALLE E,
                               CMW_PEDIDOS_CABECERA C,
                               BSW_MONEDAS M,STW_ARTICULOS A,
                               CMW_PROFORMAS_CABECERA PR,CMW_PROFORMAS_DETALLE PD,CMW_EMBARQUES EM
                        WHERE  EM.ID = :P155_PEDIDOS_EMB
                        AND    E.ID_ARTICULO = A.ID
                        AND    C.ID = E.ID_PEDIDO_CAB
                        AND    M.ID = C.ID_MONEDA
                        AND    EM.ID_PROFORMA = PR.ID
                        AND    PR.ID = PD.ID_PROFORMA_CABECERA
                        AND    PD.ID_OCP = E.ID_PEDIDO_CAB
                        AND    PD.ID_OCP_DET = E.ID
                        AND    (NVL(E.IND_APROBADO, 'N') = 'S' OR E.ID_COTIZA_ART IS NOT NULL OR E.ID_APROBACION_LIC IS NOT NULL);
                        END IF;
                      APEX_JSON.initialize_clob_output;
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P155_JSON_DETALLES:=JSON_DETALLE;
                    EXCEPTION 
                    WHEN OTHERS THEN
                     RAISE_APPLICATION_ERROR(-20000,sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    P155_PEDIDOS_EMB
                    P155_TIP_COMPROBANTE_REF
                    P155_IND_EXENTO
                    P155_DECIMALES
                ]
                itemsToReturn: P155_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P155_PEDIDOS_EMB
            }
        )

        action preparar-json-de-detalle-ped (
            name: Preparar JSON de detalle PED
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    IF :P155_TIP_COMPROBANTE_REF='PED' THEN
                      OPEN l_cursor FOR
                        SELECT e.ID_ARTICULO AS "ID_ARTICULO",
                                nvl(E.cantidad,0) - nvl((select cd.cantidad
                                                          from cmw_compras_detalle  cd
                                                         where cd.id_pedido_det = e.id), 0) AS "CANTIDAD",
                                e.PRECIO_UNITARIO AS "PRECIO_UNITARIO",
                                A.COD_ARTICULO AS "COD_ARTICULO",
                                E.DESCUENTO,
                                CASE NVL(:P155_IND_EXENTO,'N')
                                WHEN 'S' THEN E.MONTO_TOTAL_C_IVA
                                ELSE E.MONTO_TOTAL
                                END AS
                                MONTO_TOTAL,
                                CASE NVL(:P155_IND_EXENTO,'N') 
                                WHEN 'S' THEN 0 
                                ELSE E.TOTAL_IVA 
                               END AS 
                               TOTAL_IVA,
                               E.CANTIDAD_UB,
                               E.ID_UNIDAD_MEDIDA,
                               E.NRO_LOTE,
                               E.FEC_VENCIMIENTO,
                               CASE NVL(:P155_IND_EXENTO,'N')
                               WHEN 'S' THEN 0
                               ELSE 
                               E.IVA END AS IVA,
                               ROUND(E.PRECIO_UNITARIO_C_IVA,M.DECIMALES) AS PRECIO_UNITARIO_C_IVA,
                               E.DESCUENTO_C_IVA,
                               E.ID_IVA,
                               E.MONTO_TOTAL_C_IVA,
                               A.DESCRIPCION,
                               NVL(E.PRECIO_UNITARIO,0) AS PRECIO_UNITARIO,
                               TRAE_ID_LOTE(:P0_ID_EMPRESA, E.ID_ARTICULO, E.NRO_LOTE) as ID_LOTE,
                               E.ID_PEDIDO_CAB,
                               E.NRO_OCC,
                               C.TIP_COMPROBANTE AS TIP_OCP,
                               C.SER_COMPROBANTE AS SER_OCP,
                               C.NRO_COMPROBANTE AS NRO_OCP,
                               C.ID AS ID_PEDIDO_CAB,
                               E.ID AS ID_PEDIDO_DET,
                               A.ID_ENVASE,
                               A.COD_ORIGEN_ART
                        FROM   CMW_PEDIDOS_DETALLE E,CMW_PEDIDOS_CABECERA C,STW_ARTICULOS A,BSW_MONEDAS M
                        WHERE  E.ID_PEDIDO_CAB= :P155_PEDIDOS_EMB
                        AND E.ID_ARTICULO= A.ID
                        AND E.ID_PEDIDO_CAB=C.ID
                        AND nvl(E.cantidad,0) - nvl(E.cantidad_confirmada,0) > 0
                        AND C.ID_MONEDA=M.ID
                        AND (NVL(E.IND_APROBADO, 'N') = 'S' OR E.ID_COTIZA_ART IS NOT NULL);
                        
                          APEX_JSON.initialize_clob_output;
                          APEX_JSON.open_object;
                          APEX_JSON.write('DETALLE', l_cursor);
                          APEX_JSON.close_object;
                          JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                          :P155_JSON_DETALLES:=JSON_DETALLE;
                        END IF;
                    EXCEPTION 
                    WHEN OTHERS THEN
                     RAISE_APPLICATION_ERROR(-20000,'Error :'||sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    P155_PEDIDOS_EMB
                    P155_TIP_COMPROBANTE_REF
                    P155_IND_EXENTO
                    P155_DECIMALES
                ]
                itemsToReturn: P155_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P155_PEDIDOS_EMB
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction convert-fec (
        name: CONVERT_FEC
        execution {
            sequence: 360
        }
        when {
            selectionType: items
            items: P155_FEC_VENC_TIMBRADO
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P155_FEC_VENC_TIMBRADO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P155_FEC_VENC_TIMBRADO,'/','');
                            conv_fecha := substr(:P155_FEC_VENC_TIMBRADO,1,2)||'/'||
                                                      substr(:P155_FEC_VENC_TIMBRADO,3,2)||'/'||
                                                      lpad(substr(:P155_FEC_VENC_TIMBRADO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P155_FEC_VENC_TIMBRADO := conv_fecha;
                            ELSIF (length(:P155_FEC_VENC_TIMBRADO) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P155_FEC_VENC_TIMBRADO) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P155_FEC_VENC_TIMBRADO
                itemsToReturn: P155_FEC_VENC_TIMBRADO
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 350
        }
        when {
            selectionType: items
            items: P155_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P155_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P155_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P155_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P155_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P155_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P155_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P155_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P155_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P155_FEC_COMPROBANTE);
                    end;
