    pageItem P155_NRO_TIMBRADO (
        type: textField
        label {
            label: <p>Timbrado:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 140
            region: @datos-generales
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 8
        }
        advanced {
            customAttributes: TABINDEX="13"
        }
        source {
            formRegion: @factura-de-compra
            column: NRO_TIMBRADO
            dataType: number
        }
        readOnly {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vbandera varchar2(1);
                
                
                
                BEGIN
                IF :P155_ID IS NOT NULL THEN 
                SELECT NVL(T.LIBRO_IVA,'N')
                INTO vbandera
                FROM  BSW_TIPOS_COMPROBANTES T
                WHERE T.TIP_COMPROBANTE = :P155_TIP_COMPROBANTE
                AND T.LIBRO_IVA = 'N'
                AND T.ID_EMPRESA= :P0_ID_EMPRESA;
                RETURN TRUE;
                END IF;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                RETURN FALSE;
                END;
                ```
        }
    )

