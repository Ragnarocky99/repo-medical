    dynamicAction abrir-lista-de-valores (
        name: Abrir Lista de Valores
        execution {
            sequence: 180
        }
        when {
            event: dblclick
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_ART_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction abrir-lv-ped-emb (
        name: ABRIR LV PED/EMB
        execution {
            sequence: 310
        }
        when {
            event: click
            selectionType: button
            button: @buscar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("#P155_PEDIDOS_EMB_lov_btn").click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction abrir-modal-cuota (
        name: Abrir Modal Cuota
        execution {
            sequence: 420
        }
        when {
            event: click
            selectionType: button
            button: @cuota
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    calcularTotCuota();
                    openModal('Cuota');
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action p155-tot-cuota (
            name: P155_TOT_CUOTA
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P155_TOT_COMPROBANTE
                itemsToSubmit: P155_TOT_COMPROBANTE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P155_TOT_CUOTA
            }
            execution {
