    dynamicAction new (
        name: New
        execution {
            sequence: 370
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: CANTIDAD
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Obtiene el valor original de la cantidad desde un campo oculto (hidden)
                    var cantidadOriginal = $v(":CANTIDAD"); // Reemplaza "P1_CANTIDAD_ORIGINAL" con el nombre de tu campo
                    
                    // Agrega un listener al campo de cantidad
                    $("#Cantidad").on("change", function() {
                        // Obtiene el nuevo valor de cantidad
                        var nuevaCantidad = $(this).val();
                    
                        // Compara con la cantidad original
                        if (parseInt(nuevaCantidad) > parseInt(cantidadOriginal)) {
                            alert("No puedes ingresar una cantidad mayor a la original.");
                            
                            // Revierte el cambio asignando la cantidad original de vuelta al campo
                            $(this).val(cantidadOriginal);
                        }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

