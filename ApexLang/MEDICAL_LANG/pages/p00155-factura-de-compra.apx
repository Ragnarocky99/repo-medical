            sequence: 10
            parentRegion: @totales
            slot: subRegions
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region cuotas (
        name: Cuotas
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CPW_CUOTAS
            whereClause:
                ```sql
                ID_COMPROBANTE_CM = :P155_ID AND
                (TOT_CUOTA = TOT_SALDO OR :APP_USER = 'INV')
                ```
            pageItemsToSubmit: P155_ID
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size720x480
            ]
        }
        advanced {
            htmlDomId: Cuota
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
