    pageItem P155_FEC_VENC_TIMBRADO (
        type: datePicker
        label {
            label: Fecha
            alignment: left
        }
        layout {
            sequence: 150
            region: @datos-generales
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 25
        }
        advanced {
            customAttributes: TABINDEX="14"
        }
        source {
            formRegion: @factura-de-compra
            column: FEC_VENC_TIMBRADO
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select add_months(trunc(sysdate, 'y'), 12)-1 from dual;
        }
        readOnly {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                vbandera varchar2(1);
                
                
                
                BEGIN
                IF :P155_ID IS NOT NULL THEN 
                SELECT NVL(T.LIBRO_IVA,'N')
                INTO vbandera
                FROM  BSW_TIPOS_COMPROBANTES T
                WHERE T.TIP_COMPROBANTE = :P155_TIP_COMPROBANTE
                AND T.LIBRO_IVA = 'N'
                AND T.ID_EMPRESA= :P0_ID_EMPRESA;
                RETURN TRUE;
                END IF;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                RETURN FALSE;
                END;
                ```
        }
    )

