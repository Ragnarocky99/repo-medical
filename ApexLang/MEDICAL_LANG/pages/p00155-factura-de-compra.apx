        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vbandera varchar2(1);
                    
                    BEGIN
                    SELECT NVL(LIBRO_IVA,'N')
                    INTO VBANDERA
                    FROM  BSW_TIPOS_COMPROBANTES T 
                    WHERE T.TIP_COMPROBANTE = :P155_TIP_COMPROBANTE
                    AND T.LIBRO_IVA = 'N'
                    AND T.ID_EMPRESA= :P0_ID_EMPRESA;
                    :P155_BANDERA_1:=VBANDERA;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    :P155_BANDERA_1:='S';
                    END;
                    ```
                itemsToSubmit: P155_TIP_COMPROBANTE
                itemsToReturn: P155_BANDERA_1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
