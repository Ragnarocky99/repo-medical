        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cierre Caja
        }

        savedReport 696935 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COBRADO (
                sequence: 6
            )

            displayColumn COD_CAJA (
                sequence: 4
            )

            displayColumn DESCRIPCION (
                sequence: 5
            )

            displayColumn EMPRESA (
                sequence: 8
            )

            displayColumn ID_CAJA (
                sequence: 3
            )

            displayColumn MONEDA (
                sequence: 10
            )

            displayColumn RENDIDO (
                sequence: 7
            )

            displayColumn SALDO_INICIAL (
                sequence: 2
            )

            displayColumn SUBTIPOS_TRANS (
                sequence: 1
            )

            displayColumn SUCURSAL (
                sequence: 9
            )

            displayColumn TIP_CAMBIO (
                sequence: 11
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P508_CAJA_DESC (
        type: textField
        label {
            label: Caja Desc
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            cssClasses: comprobante
        }
        source {
            used: always
        }
    )

    pageItem P508_CAJERO (
        type: textField
        label {
            label: Caja Desc
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            cssClasses: comprobante
        }
        source {
            used: always
        }
    )

    pageItem P508_ID_CAJA (
        type: popupLov
        label {
            label: <p>Caja: </p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            popupWidth: 700
            popupHeight: 500
            additionalOutputs: DESCRIPCION:P508_CAJA_DESC,NOMBRE:P508_CAJERO
        }
        lov {
            type: sharedComponent
            lov: @lv-cajas-detallado
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 3
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
    )

    pageItem P508_NRO_HABILITACION (
        type: popupLov
        label {
            label: <p>Nro. Habilitacion:<p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-habilitaciones-nro-pg
        }
        cascadingLov {
            parentItems: P508_ID_CAJA
            itemsToSubmit: P508_ID_CAJA
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            column: 2
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 10
            region: @botones
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-grid (
        name: REFRESH_GRID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P508_ID_CAJA
                P508_NRO_HABILITACION
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cierre-caja
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 509
            }
        }
    )

)

