    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P592_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P592_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P592_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P592_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P592_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P592_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P592_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P592_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P592_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                    end;
                    ```
                itemsToSubmit: P592_FEC_COMPROBANTE
                itemsToReturn: P592_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction desc-fraccion (
        name: DESC_FRACCION
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P592_ID_FRACCION
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT F.DESCRIPCION
                    FROM LTW_FRACCIONES F
                    WHERE F.ID = :P592_ID_FRACCION
                    ```
                itemsToSubmit: P592_ID_FRACCION
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P592_DESC_FRACCION
            }
            execution {
                sequence: 10
            }
        )

    )

    computation p592-nro-comprobante (
        itemName: P592_NRO_COMPROBANTE
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                    vNroComprobante LTW_COMPROBANTES_SERVICIOS.NRO_COMPROBANTE%TYPE;
                BEGIN
                    IF :P592_NRO_COMPROBANTE IS  NULL THEN
                        SELECT NVL(MAX(C.NRO_COMPROBANTE),0)+1
                           INTO vNroComprobante
                        FROM LTW_COMPROBANTES_SERVICIOS C
                        WHERE C.ID_EMPRESA      = :P0_COD_EMPRESA
                          AND C.SER_COMPROBANTE = :P592_SER_COMPROBANTE
                          AND C.TIP_COMPROBANTE = :P592_TIP_COMPROBANTE;
                        RETURN vNroComprobante;
                    END IF;
                EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                        vNroComprobante:=1;
                        RETURN vNroComprobante;
                    WHEN OTHERS THEN 
                        RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                ```
        }
    )

