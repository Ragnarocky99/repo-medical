    region carga-de-plan-de-cobros-varios (
        name: Carga de Plan de Cobros Varios
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CO.ID,
                       CO.ID_EMPRESA,
                       CO.ID_SUCURSAL,
                       CO.TIP_COMPROBANTE,
                       CO.SER_COMPROBANTE,
                       CO.NRO_COMPROBANTE,
                       CO.ID_COMPROBANTE_REF,
                       CO.TIP_COMPROBANTE_REF,
                       CO.SER_COMPROBANTE_REF,
                       CO.NRO_COMPROBANTE_REF,
                       CO.NRO_COMP_REF,
                       CO.FEC_COMPROBANTE,
                       CO.ID_FRACCION,
                       CO.ID_MANZANA,
                       CO.ID_LOTE,
                       CO.ID_CLIENTE,
                       CO.ID_MONEDA,
                       CO.TIP_CAMBIO,
                       CO.ID_USUARIO,
                       CO.TOT_COMPROBANTE,
                       CO.TOT_IVA,
                       CO.OBSERVACION,
                       CO.NOM_ESCRIBANO,
                       CO.ID_ESCRIBANO,
                       CO.IND_DISTRIBUCION,
                       CO.NRO_GESTION_JUDICIAL,
                       CO.NRO_CONTRATO_ORIGINAL,
                       CO.COD_USUARIO_AUD
                
                FROM LTW_COMPROBANTES_SERVICIOS CO
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CS.ID,
                       CS.ID_EMPRESA,
                       CS.ID_COMPROBANTE_SERV,
                       CS.ID_TIPO_TRANS,
                       CS.ID_SUBTIPO_TRANS,
                       CS.NRO_CUOTA,
                       CS.FEC_VENCIMIENTO,
                       CS.TOT_CUOTA,
                       CS.TOT_SALDO,
                       CS.ID_IVA,
                       CS.PORC_IVA,
                       CS.TOT_IVA,
                       CS.IND_AUTORIZADO,
                       CS.ID_USUARIO_AUT,
                       CS.FEC_AUTORIZACION,
                       CS.ESTADO,
                       CS.IND_EXONERAR,
                       CS.DESC_SUBTRANSACCION
                
                FROM LTW_CUOTAS_SERV CS
                WHERE CS.ID_COMPROBANTE_SERV = :P592_ID
                ```
            pageItemsToSubmit: P592_ID
        }
        layout {
            sequence: 300
            parentRegion: @carga-de-plan-de-cobros-varios
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
