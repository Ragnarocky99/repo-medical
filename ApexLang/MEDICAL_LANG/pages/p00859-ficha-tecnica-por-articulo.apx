    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 20
            region: @clientes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 864
                clearCache: 92
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P0_ID_SUCURSAL = TRAE_ID_SUCURSAL(W_BUSCA_PARAMETRO('BS', 'COD_SUCURSAL_TEXTIL'), :P0_ID_EMPRESA)
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button ejecutar (
        buttonName: REFRESCAR
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @clientes
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @clientes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @clientes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process page-timestamp (
        name: Page Timestamp
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                	:P0_PAGE_TIMESTAMP := TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS'); 
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 7316210714940336
        }
        comments {
            comments:
                ```
                https://community.oracle.com/tech/developers/discussion/4480519/ir-printing-header-footer-add-date-page-item-value-apex-page
                
                https://community.oracle.com/tech/developers/discussion/960650/how-to-print-date-time-in-report-page-footer
                ```
        }
    )

)

