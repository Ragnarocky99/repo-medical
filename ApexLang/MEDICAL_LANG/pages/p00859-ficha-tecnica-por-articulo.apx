page 859 (
    name: Ficha Tecnica Por Articulo
    alias: FICHA-TECNICA-POR-ARTICULO
    title: Ficha Tecnica Por Articulo
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            
            
            
            /*
            #CLIENTES td[headers=COD]{min-width:30px}
            
            
            
            tr:nth-child(odd) {
                background-color: #f2f2f2;
            }
            */
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region clientes (
        name: Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                       A.ID,
                       A.ID_EMPRESA,
                       A.COD_FICHA,
                       A.ARTICULO_DESC,
                       A.COD_USUARIO,
                       A.FECHA_INI,
                       A.FECHA_FIN,
                       A.OBSERVACION,
                       CASE A.IND_ART_GENERADO
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       ELSE 'fa fa-remove u-danger-text'
                       END AS IND_ART_GENERADO
                FROM PDW_FICHA_TECNICA A
                WHERE A.ID_EMPRESA = :P0_ID_EMPRESA
                 AND  A.ID_SUCURSAL = :P0_ID_SUCURSAL
                AND (A.COD_FICHA = :P859_NRO_FICHA OR :P859_NRO_FICHA IS NULL)
                AND (A.ID = :P859_ARTICULO_GEN OR :P859_ARTICULO_GEN IS NULL)
                AND (A.ID = :P859_DESCRIPCION OR :P859_DESCRIPCION IS NULL)
                AND (A.IND_ART_GENERADO = :P859_IND_ART_GEN OR :P859_IND_ART_GEN IS NULL)
                AND (A.FECHA_INI BETWEEN :P859_INI_DESDE AND :P859_INI_HASTA OR (:P859_INI_DESDE IS NULL OR :P859_INI_HASTA IS NULL))
                AND (A.FECHA_FIN BETWEEN :P859_FIN_DESDE AND :P859_FIN_HASTA OR (:P859_FIN_DESDE IS NULL OR :P859_FIN_HASTA IS NULL))
                ```
            pageItemsToSubmit: [
                P859_NRO_FICHA
                P859_DESCRIPCION
                P859_ARTICULO_GEN
                P859_INI_DESDE
                P859_INI_HASTA
                P859_FIN_DESDE
                P859_FIN_HASTA
                P859_IND_ART_GEN
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: CLIENTES
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 864
                items: {
                    P864_ID: #ID#
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 182447580481768392
        }

