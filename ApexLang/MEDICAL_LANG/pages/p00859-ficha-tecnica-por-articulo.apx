            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 18
            pageHeaderText:
                ```
                CLIENTES
                &P0_DESC_EMPRESA. - &P0_DESC_SUCURSAL.
                ```
        }
        pageFooter {
            alignment: start
            pageFooterText: USUARIO: &APP_USER.     FECHA Y HORA: &P0_PAGE_TIMESTAMP.
        }

        savedReport 115374 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ARTICULO_DESC (
                sequence: 2
            )

            displayColumn COD_FICHA (
                sequence: 1
