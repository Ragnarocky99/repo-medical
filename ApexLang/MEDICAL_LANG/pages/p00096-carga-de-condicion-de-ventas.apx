    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P96_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P96_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P96_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p96-cod-condicion-venta (
        itemName: P96_COD_CONDICION_VENTA
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            sqlQuery: SELECT MAX(TO_CHAR(COD_CONDICION_VENTA)+1) FROM CCW_CONDICIONES_VENTAS;
        }
        serverSideCondition {
            type: itemIsNull
            item: P96_COD_CONDICION_VENTA
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 13037043485768032
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-condicion-de-ventas (
        name: Initialize form Carga de Condicion de Ventas
        type: formInitialization
        formRegion: @carga-de-condicion-de-ventas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13036238027768032
        }
    )

    process process-form-carga-de-condicion-de-ventas (
        name: Process form Carga de Condicion de Ventas
        type: formAutoRowProcessing
        formRegion: @carga-de-condicion-de-ventas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13036639455768032
        }
    )

)

