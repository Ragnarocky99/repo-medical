            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            cssClasses: codigo
            width: 30
        }
        source {
            formRegion: @carga-de-condicion-de-ventas
            column: COD_CONDICION_VENTA
            dataType: varchar2
        }
    )

