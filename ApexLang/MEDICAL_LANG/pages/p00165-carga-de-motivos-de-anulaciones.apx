page 165 (
    name: Carga de Motivos de Anulaciones
    alias: CARGA-DE-MOTIVOS-DE-ANULACIONES
    title: Carga de Motivos de Anulaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 650px
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .mostrar{
                background-color:#eeeeee;
                width: 171px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-motivos-de-anulaciones (
        name: Carga de Motivos de Anulaciones
        type: form
        source {
            location: localDatabase
            tableName: VTW_MOTIVOS_ANULACIONES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-consultar
        }
    )

    pageItem P165_ACTIVO (
        type: checkbox
        label {
            label: <p>Activo</p>
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 50
            region: @carga-de-motivos-de-anulaciones
            slot: regionBody
            alignment: left
            column: 2
            labelColumnSpan: 1
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                margin-top-none
                margin-left-none
            ]
        }
        source {
            formRegion: @carga-de-motivos-de-anulaciones
            column: ACTIVO
            dataType: varchar2
        }
    )

    pageItem P165_COD_MOTIVO (
        type: displayOnly
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Motivo:</a>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-motivos-de-anulaciones
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-motivos-de-anulaciones
            column: COD_MOTIVO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_MOTIVO)), 0) + 1
                from VTW_MOTIVOS_ANULACIONES A
                WHERE A.ID_EMPRESA = :P0_COD_EMPRESA;
                ```
        }
    )

    pageItem P165_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 80
            region: @carga-de-motivos-de-anulaciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-de-anulaciones
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P165_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-motivos-de-anulaciones
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-motivos-de-anulaciones
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P165_ID (
        type: hidden
        layout {
            sequence: 60
            region: @carga-de-motivos-de-anulaciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-de-anulaciones
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: VTW_MOTIVOS_ANULACIONES_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P165_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-motivos-de-anulaciones
            slot: regionBody
        }
        source {
            formRegion: @carga-de-motivos-de-anulaciones
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P165_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P165_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P165_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 20834538414975898
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-motivos-de-anulaciones (
        name: Initialize form Carga de Motivos de Anulaciones
        type: formInitialization
        formRegion: @carga-de-motivos-de-anulaciones
        execution {
            sequence: 10
            point: beforeHeader
