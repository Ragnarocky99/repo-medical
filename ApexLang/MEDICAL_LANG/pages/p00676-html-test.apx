    region new (
        name: New
        type: staticContent
        source {
            htmlCode:
                ```html
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Hello World</title>
                    <style>
                        h1 {
                            color: red;
                        }
                        table {
                            border-collapse: collapse;
                            width: 50%;
                        }
                        th, td {
                            border: 1px solid black;
                            padding: 8px;
                            text-align: left;
                        }
                        th {
                            background-color: #f2f2f2;
                        }
                    </style>
                </head>
                <body>
                    <h1>Hola</h1>
                    <button onclick="displayAlert()" id="myButton">Click me!</button>
                
                    <script>
                        function displayAlert() {
                            alert("Hola!");
                        }
                    </script>
                
                    <h2>Animals Data</h2>
                    <table>
                        <tr>
                            <th>Name</th>
                            <th>Colour</th>
                            <th>Scientific Name</th>
                        </tr>
                        <tr>
                            <td>Lion</td>
                            <td>Yellow-brown</td>
                            <td>Panthera leo</td>
                        </tr>
                        <tr>
                            <td>Elephant</td>
                            <td>Gray</td>
                            <td>Loxodonta africana</td>
                        </tr>
                        <tr>
                            <td>Giraffe</td>
                            <td>Yellow-brown spots</td>
                            <td>Giraffa camelopardalis</td>
                        </tr>
                    </table>
                    <input type="checkbox" value="xd" name="hola" id="check1">
                </body>
                </html>
                
                ```
        }
