    region new-5 (
        name: New
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_result clob := '<h4>List of employees:</h4>';
                begin
                    l_result := l_result || '<ul>';
                    for l_emp in ( select ename,
                                          job
                                     from emp
                                    order by ename )
                    loop
                        l_result := l_result ||
                                    '<li><strong>' || apex_escape.html( l_emp.ename ) || '</strong>' ||
                                    ' (' || apex_escape.html( l_emp.job ) || ')</li>';
                    end loop;
                    l_result := l_result || '</ul>';
                
                    return l_result;
                end;
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
