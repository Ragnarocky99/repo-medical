    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            let menuList = [
            { type:"action",
            label: "mostrar alerta",
            action: function() {
            apex.message.alert("un mensaje");
            } }, {
            type:"action",
            label: "mostrar confirmacion",
            action: function() {
            apex.message.confirm("estas seguro?");
            } }, {
            type:"action",
            label: "mostrar modal",
            action: function() {
            javascript:openModal('modal');
            } }];
            
            $(mContextual).on( "contextmenu", function( event ) {
            event.preventDefault();
            $( "#contextMenu" ).menu( "toggle", event.pageX, event.pageY );
            });
            
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            $( "#contextMenu" ).menu( {
            items: menuList
            } );
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        duplicateSubmissionUrl: https://www.google.com
