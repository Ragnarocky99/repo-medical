    dynamicAction setea-fraccion (
        name: setea_fraccion
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @lotes-a-recuperar
            columns: ID_LOTE
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    vretorno number;
                    begin
                     select l.id_fraccion
                       into vretorno
                      from ltw_lotes l
                     where l.id_empresa  = :p0_id_empresa
                       and l.id          = :id_lote
                      ;
                    
                       return vretorno;
                    
                    end;
                    
                    ```
                itemsToSubmit: [
                    ID_LOTE
                    P0_ID_EMPRESA
                ]
            }
            affectedElements {
                selectionType: columns
                columns: ID_FRACCION
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action set-desc (
            name: set_desc
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    vretorno varchar2(100);
                    begin
                     select d.descripcion
                       into vretorno
                      from ltw_fracciones d
                     where d.id_empresa  = :p0_id_empresa
                       and d.id          = :id_fraccion;
                    
                    /*begin
                     select f.descripcion
                       into :desc_fraccion
                      from ltw_fracciones f
                     where f.id_empresa  = :p0_id_empresa
                       and f.id          = vretorno;
                    end;*/
                    
                    
                       return vretorno;
                    
                    exception
                      when others then 
                         raise_application_error(-20004, 'error '||vretorno||'-'||:p0_id_empresa);
                       
                    end;
                    
                    ```
                itemsToSubmit: [
                    ID_FRACCION
                    P0_ID_EMPRESA
                ]
            }
            affectedElements {
                selectionType: columns
                columns: DESC_FRACCION
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action set-manzana (
            name: set_manzana
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    vretorno number;
                    begin
                     select l.id_manzana
                       into vretorno
                      from ltw_lotes l
                     where l.id_empresa  = :p0_id_empresa
                       and l.id          = :id_lote;
                    
                       return vretorno;
                    
                    end;
                    
                    ```
                itemsToSubmit: [
                    ID_LOTE
                    P0_ID_EMPRESA
                ]
            }
            affectedElements {
                selectionType: columns
                columns: ID_MANZANA
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

