    region lotes-a-recuperar (
        name: Lotes a Recuperar
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.ID_EMPRESA,
                       c.ID_SUCURSAL,
                       c.ID,
                       c.FEC_COMPROBANTE,
                       c.ID_CLIENTE,
                       c.ID_USUARIO,
                       c.ID_FRACCION,
                       f.descripcion desc_fraccion,
                       c.ID_MANZANA,
                       c.ID_LOTE,
                
                       c.ESTADO,
                       c.CUOTAS_PAGADAS,
                       c.CUOTAS_ATRASADAS,
                       c.ID_CONDICION_VENTA,
                       c.PORC_PAGADO,
                       c.ID_MOTIVO,
                       c.FEC_ESTADO,
                       c.OBSERVACION,
                       c.COD_USUARIO_AUT,
                       c.EXCEPTO,
                       c.RECUPERABLE,
                       c.ID_CONTRATO_ORIGINAL,
                       c.ID_FRACCION_ORIGINAL,
                       c.ID_MANZANA_ORIGINAL,
                       c.ID_LOTE_ORIGINAL
                  from LTW_LOTES_A_RECUPERAR c, ltw_fracciones f
                 where c.id_Empresa = :P0_ID_EMPRESA
                   and c.id_empresa  = f.ID_EMPRESA
                   AND C.ID_FRACCION = F.ID
                
                ```
            pageItemsToSubmit: P0_ID_EMPRESA
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
