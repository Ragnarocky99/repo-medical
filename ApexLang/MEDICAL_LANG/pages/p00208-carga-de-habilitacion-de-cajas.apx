            delete: @derechos-borrar-2
        }
    )

    region detalles-caja (
        name: Detalles_Caja
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_HABILITACION,
                       ID_SUBTIPO_TRANS,
                       ID_MONEDA,
                       TIPO_CAMBIO,
                       CANTIDAD,
                       MONTO_REAL,
                       MONTO_SISTEMA,
                       OBSERVACION,
                       IND_VERIFICADO,
                       COD_USUARIO_AUD,
                       TIPO
                  from CCW_HABILITACIONES_DETALLE
                  where ID_HABILITACION = :P208_ID
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: det
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P208_HORA_CIERRE
        }
        componentAppearance {
            selectFirstRow: false
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 29295823244351303
        }

