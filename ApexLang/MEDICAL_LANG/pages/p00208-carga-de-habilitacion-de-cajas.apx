        }
        computation {
            sqlQuery:
                ```sql
                SELECT DESCRIPCION FROM BSW_SUCURSALES
                WHERE ID = :P208_ID_SUCURSAL
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P208_ID
        }
    )

