    dynamicAction cargar-valor-caja-desc (
        name: Cargar Valor Caja_Desc
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P208_ID_CAJA
        }

        action set-desc-caja (
            name: SET DESC CAJA
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select descripcion from ccw_cajas
                    where id = :p208_id_caja
                    ```
                itemsToSubmit: P208_ID_CAJA
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P208_CAJA_DESC
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action set-sucursal (
            name: SET SUCURSAL
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT F.ID_SUCURSAL 
                    FROM CCW_CAJAS F
                    WHERE F.ID = :P208_ID_CAJA
                      AND F.ID_EMPRESA = :P0_ID_EMPRESA
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P208_ID_CAJA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P208_ID_SUCURSAL
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action set-usuario (
            name: SET USUARIO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT F.ID_USUARIO_ASIG 
                    FROM CCW_CAJAS F
                    WHERE F.ID = :P208_ID_CAJA
                      AND F.ID_EMPRESA = :P0_ID_EMPRESA
                    ```
                itemsToSubmit: [
                    P0_ID_EMPRESA
                    P208_ID_CAJA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P208_ID_USUARIO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cod-usuario (
        name: Cod usuario
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P208_ID_USUARIO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
