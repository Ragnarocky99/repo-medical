    computation p208-caja-desc (
        itemName: P208_CAJA_DESC
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                SELECT DESCRIPCION FROM CCW_CAJAS
                WHERE ID = :P208_ID_CAJA
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P208_ID
        }
    )

    computation p208-nro-habilitacion (
        itemName: P208_NRO_HABILITACION
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT 
                    CASE WHEN MAX(TO_CHAR(NRO_HABILITACION)) IS NULL THEN 1 ELSE MAX(TO_CHAR(NRO_HABILITACION)+1) END
                FROM CCW_HABILITACIONES
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P208_NRO_HABILITACION
        }
    )

