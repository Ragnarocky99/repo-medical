                itemsToSubmit: P208_ID_USUARIO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P208_COD_USUARIO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

