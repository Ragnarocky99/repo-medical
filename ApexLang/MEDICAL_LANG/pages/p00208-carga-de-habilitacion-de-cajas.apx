page 208 (
    name: Carga de Habilitacion de Cajas
    alias: CARGA-DE-HABILITACION-DE-CAJAS
    title: Carga de Habilitacion de Cajas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            (function($) {
            
                function update(model) {
                    var montoRealKey = model.getFieldKey("MONTO_REAL");
                    //var cambioSaldoKey = model.getFieldKey("TIP_CAMBIO");
                    total = 0;
                    //total_importe = 0;
            
                    console.log(">> empieza calculo")
                    model.forEach(function(record, index, id) {
                        var monto_real = parseFloat(record[montoRealKey].replace(/\./g,''));
                        //var cambio_saldo = parseFloat(record[cambioSaldoKey].replace(/\./g,''));
                            meta = model.getRecordMetadata(id);
            
                        if (!isNaN(monto_real) && !meta.deleted && !meta.agg) {
                            total += monto_real;
                            //total_importe += monto_cuota*cambio_saldo;
                        }
                    });
                    
                    console.log(">> setting sum MONTO_CUOTA column to " + total)
                    $s("P208_MONTO_TOTAL", total);
            
                    //
                    //var cambio_cobro = parseFloat(apex.item( "P170_TIP_CAMBIO" ).getValue().replace(',', '.'));
                    //total_importe = total_importe/cambio_cobro;
                    //apex.item( "P170_TOTAL" ).setValue(total);
                    //apex.item( "P170_IMPORTE" ).setValue(total_importe);
                    //$s("P170_TOTAL", total);
                    //$s("P170_IMPORTE", total_importe);
                    //$s("P170_IMPORTE", total_importe.toString());
                }
            
                $(function() {
                   
                    $("#det").on("interactivegridviewmodelcreate", function(event, ui) {
                        var sid,
                            model = ui.model;
            
                        if ( ui.viewId === "grid" ) {
                            sid = model.subscribe( {
                                onChange: function(type, change) {
                                    console.log(">> model changed ", type, change);
                                    if ( type === "set" ) {
                                         if (change.field === "MONTO_REAL" ) {
                                            update( model );
                                        }
                                    } else if (type !== "move" && type !== "metaChange") {
                                      update( model );
                                    }
                                },
                                progressView: $("#P208_MONTO_TOTAL")
                            } );
                             update( model );           
                            model.fetchAll(function() {});
                        }
                    });
                });
            })(apex.jQuery);
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P208_ID_SUCURSAL").readOnly = true;
            document.getElementById("P208_SUCURSAL_DESC").readOnly = true;
            document.getElementById("P208_CAJA_DESC").readOnly = true;
            document.getElementById("P208_NRO_HABILITACION").readOnly = true;
            document.getElementById("P208_COD_USUARIO_AUD").readOnly = true;
            document.getElementById("P208_FEC_HABILITACION").readOnly = true;
            document.getElementById("P208_HORA_HABILITACION").readOnly = true;
            document.getElementById("P208_FEC_CIERRE").readOnly = true;
            document.getElementById("P208_HORA_CIERRE").readOnly = true;
            document.getElementById("P208_MONTO_TOTAL").readOnly = true;
            ```
