        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Objetivo Ventas
        }
    )

    pageItem P820_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @objetivo-ventas
            slot: regionBody
        }
    )

    button excel (
        buttonName: EXCEL
        label: Excel
        layout {
            sequence: 10
            region: @objetivo-ventas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 825
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button reporte (
        buttonName: REPORTE
        label: Reporte
        layout {
            sequence: 30
            region: @objetivo-ventas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 620
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction agregar-botones (
        name: Agregar Botones
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action boton-crear (
            name: Boton Crear
            action: plugin/interactiveGridExtendToolbar
            settings {
                toolbarGroup: 7ResetGroup
                groupPosition: start
                label: Crear
                hot: true
                icon: fa-plus
                triggerAction: crear
            }
            affectedElements {
                selectionType: region
                region: @objetivo-ventas
            }
            execution {
                sequence: 20
            }
        )

        action boton-excel (
            name: Boton Excel
            action: plugin/fosInteractiveGridAddButton
            settings {
                alignment: first
                label: Excel
                icon: fa-file-excel-o
                onClick: triggerEvent
                eventName: excel
                extraOptions: toolbarOnlyHot
            }
            affectedElements {
                selectionType: region
                region: @objetivo-ventas
            }
            execution {
                sequence: 30
            }
        )

        action menu-ver (
            name: Menu - Ver
            action: plugin/fosInteractiveGridAddButton
            settings {
                addButtonTo: menuRowActions
                label: Ver
                icon: fa-eye
                onClick: returnPrimaryKeySIntoItem
                pageItem: P820_ID
                extraOptions: hideOnNoData
            }
            affectedElements {
                selectionType: region
                region: @objetivo-ventas
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction crear (
        name: Crear
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: crear
            selectionType: region
            region: @objetivo-ventas
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 824
                }
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit (
        name: Edit
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P820_ID
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 824
                    items: {
                        P824_ID: &P820_ID.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: P820_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @objetivo-ventas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @objetivo-ventas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed-2 (
        name: Edit Report - Dialog Closed_1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @objetivo-ventas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction excel (
        name: Excel
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: excel
            selectionType: region
            region: @objetivo-ventas
        }

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 825
                }
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process objetivo-ventas-save-interactive-grid-data (
        name: Objetivo Ventas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @objetivo-ventas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 75728160359089316
        }
    )

)

