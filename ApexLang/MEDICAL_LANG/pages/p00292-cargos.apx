page 292 (
    name: Cargos
    alias: CARGOS
    title: Cargos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cargos (
        name: Cargos
        type: interactiveReport
        source {
            location: localDatabase
            tableName: RHW_CARGOS
            orderByClause: ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 293
                items: {
                    P293_ID: #ID#
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 8447090633191502
        }

        column COD_CARGO (
            type: plainText
            heading {
                heading: Código Cargo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cód. Usuario Aud.
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cargos
        }

        savedReport 84540 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CARGO (
                sequence: 2
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 4
            )

        )

    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @cargos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 293
                items: {
                    P293_COD_CARGO: &P293_COD_CARGO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button imprimir (
        buttonName: Imprimir
        label: Imprimir
        layout {
            sequence: 20
            region: @cargos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button test (
        buttonName: Test
        label: Test
        layout {
            sequence: 30
            region: @cargos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @cargos
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cargos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @test
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                       l_blob        BLOB;
                       l_mime_type   VARCHAR2 (100);
                       l_report_url  varchar2(200):= W_BUSCA_PARAMETRO('BS','URL_REPORT');
                       
                       l_proc varchar2(100) := 'get report as blob, then show';
                    BEGIN
                       xlog (l_proc, 'url (orig):' || l_report_url);
                       
                       ------------------------------------------------------------------------
                       -- generate the report and return in BLOB
                       ------------------------------------------------------------------------
                       xlib_jasperreports.set_report_url (l_report_url);
                       xlib_jasperreports.get_report(p_rep_name => apex_util.url_encode('RH_CARGOS'),
                              p_rep_format          => apex_util.url_encode(:P3_rep_format),
                              p_data_source         => apex_util.url_encode(:P3_data_source),
                              p_rep_locale          => apex_util.url_encode(:P3_rep_locale),
                              p_rep_encoding        => apex_util.url_encode(:P3_rep_encoding),
                              p_additional_params   => '',
                              p_print_is_enabled    => true,
                              p_print_printer_name  => apex_util.url_encode('NPI25821E (HP LaserJet M15w)'),
                              p_print_media         => apex_util.url_encode(:P3_print_media),
                              p_print_copies        => apex_util.url_encode(:P3_print_copies),
                              p_print_duplex        => case when :P3_print_duplex='1' then true else false end,
                              p_print_collate       => case when :P3_print_collate='1' then true else false end,
                              p_save_is_enabled     => case when :P3_save_is_enabled='1' then true else false end,
                              p_save_filename       => apex_util.url_encode(:P3_save_filename),
                              p_rep_time_zone       => apex_util.url_encode(:P3_rep_time_zone),
                              p_out_blob            => l_blob,
                              p_out_mime_type       => l_mime_type,
                              p_print_job_name      => apex_util.url_encode(:P3_print_job_name));
                              end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go to Page 296
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 296
            }
        }
        serverSideCondition {
            whenButtonPressed: @imprimir
        }
    )

)

