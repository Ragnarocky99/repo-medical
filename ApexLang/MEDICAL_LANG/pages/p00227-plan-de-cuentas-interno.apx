page 227 (
    name: Plan de Cuentas Interno
    alias: PLAN-DE-CUENTAS-INTERNO
    title: Plan de Cuentas Interno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region plan-de-cuentas (
        name: Plan de Cuentas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_CUENTA,
                       NOMBRE_CUENTA,
                       ABREVIATURA,
                       NIVEL_DE_CUENTA,
                       CUENTA_TOTALIZADORA,
                       IMPRIMIBLE,
                       ASENTABLE,
                       CASE ASENTABLE
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ASENTABLE_ICON,
                       TIPO_CUENTA,
                       DEBITO_ACTUAL,
                       CREDITO_ACTUAL,
                       COD_PLAN_CUENTA,
                       COD_USUARIO_AUD,
                       ID_MONEDA,
                       ID_PLAN_CUE_TOTALIZADORA,
                       ID_PLAN_CUENTA,
                       ID_TITULO_RES49,
                       ID_SUBTITULO_RES49,
                       ID_TITULO_PAT_RES49,
                       ORDEN
                  from COW_PLAN_CUENTAS_SET
                   where ID_EMPRESA=:P0_COD_EMPRESA
                order by to_number(regexp_substr(cod_cuenta, '[0-9]+')), cod_cuenta
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 228
                items: {
                    P228_ID: #ID#
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 56461286965599058
        }

        column ABREVIATURA (
            type: hidden
            heading {
                heading: Abreviatura
            }
            layout {
                sequence: 310
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ASENTABLE (
            type: plainText
            heading {
                heading: Asentable
                alignment: center
            }
            layout {
                sequence: 250
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ASENTABLE_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
