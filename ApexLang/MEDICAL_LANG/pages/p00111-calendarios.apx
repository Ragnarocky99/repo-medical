page 111 (
    name: Calendarios
    alias: CALENDARIOS
    title: Calendarios - Sistema Inventiva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function chState(ACTIVO)
            {
                if(ACTIVO.checked) 
                    ACTIVO.value='true'; 
               else
                   ACTIVO.value='false';
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region calendarios (
        name: Calendarios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CAL.ID,
                       CAL.ID_EMPRESA,
                       CAL.ID_MODULO,
                       CAL.FEC_ACTUAL,
                       CAL.ALTA_POR,
                       CAL.FEC_ALTA,
                       CAL.ACTUALIZADO_POR,
                       CAL.FEC_ACTUALIZADO,
                       CAL.FEC_INICIAL,
                       CAL.FEC_FINAL,
                       CAL.COD_USUARIO_AUD,
                       CAL.ACTIVO,
                       CASE CAL.ACTIVO 
                       WHEN 'S' THEN 'fa fa-check u-success-text'
                       WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END ACTIVO_ICON, 
                       MOD.COD_MODULO,
                       MOD.DESCRIPCION DESC_MODULO
                       
                
                FROM BSW_CALENDARIOS CAL, BSW_MODULOS MOD
                WHERE CAL.ID_MODULO = MOD.ID
                  AND CAL.ID_EMPRESA = :P0_COD_EMPRESA
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 112
                items: {
                    P112_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 15172685069207112
        }

        column ACTIVO (
            type: plainText
            heading {
                heading: Activo
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div class="dm-IRR-icon"> <span class="fa #ACTIVO_ICON#" ></span> <span class="dm-IRR-iconLabel"></span> </div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ACTIVO_ICON (
            type: hidden
            heading {
                heading: Activo Icon
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
