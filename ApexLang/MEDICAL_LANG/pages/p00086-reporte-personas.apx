page 86 (
    name: Reporte Personas
    alias: REPORTE-PERSONAS
    title: Reporte Personas
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    branch (
        name: Branch To PL/SQL Procedure
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            type: plsqlProcedure
            plsqlCode:
                ```plsql
                DECLARE
                  vcName  VARCHAR2(200);
                  lParams PK_JRXML2PDF_REPGEN.TPARAMLIST;
                  bl BLOB;
                BEGIN
                  vcName := 'Personas';
                  bl := PK_JRXML2PDF_REPGEN.FK_RUN(i_vcName=>vcName);
                  PK_JRXML2PDF_REPGEN.PR_SHOW_REPORT(bl);
                  APEX_APPLICATION.STOP_APEX_ENGINE;
                END;
                ```
        }
    )

)

