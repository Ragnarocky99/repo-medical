page 666 (
    name: Recalculo de Costos
    alias: RECALCULO-DE-COSTOS
    title: Recalculo de Costos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region costos-historicos (
        name: Costos Historicos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.ID,
                       h.ID_ARTICULO,
                       ar.cod_articulo,
                       ar.descripcion desc_articulo,
                       mo.siglas,
                       h.CANT_MOVIM,
                       h.COSTO_PROM_NUEVO,
                       h.costo_ultimo,
                       H.COSTO_FOB_ACT,
                       h.FEC_PROCESO,
                       h.ID_EMPRESA,
                       h.ID_LOTE
                from STW_HIST_COSTOS_ART H, stw_articulos ar, bsw_monedas mo
                where (h.id_empresa  = :P0_ID_EMPRESA)
                  and (h.id_articulo = :P666_ARTICULOS or :P666_ARTICULOS is null)
                  and (ar.id_familia = :P666_FAMILIA or :P666_FAMILIA is null)
                  and (ar.id_marca   = :P666_MARCA or :P666_MARCA is null)
                  and (ar.id_rubro   = :P666_RUBRO or :P666_RUBRO is null)  
                  and h.id_articulo  = ar.id
                  and mo.id = ar.id_moneda_costo
                ```
            pageItemsToSubmit: [
                P666_LOTE
                P666_SUCURSAL
                P666_ARTICULOS
            ]
        }
        layout {
            sequence: 10
            parentRegion: @recalculo-de-costos
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 302900930428030217
        }

