    region detalles-resolucion (
        name: Detalles Resolucion
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_RESO_CAB,
                       NRO_ITEM,
                       ID_ARTICULO,
                       (select descripcion  from stw_articulos where id = id_articulo) desc_articulo,
                       (select cod_articulo from stw_articulos where id = id_articulo) cod_articulo,
                       ID_UNIDAD_MEDIDA,
                       CANT_MIN,
                       CANT_MAX,
                       PRECIO_UNITARIO,
                       MONTO_TOTAL,
                       ID_PROVEEDOR,
                       COSTO_FOB
                  from LCW_RESOLUCIONES_DET
                  where ID_RESO_CAB = :P661_ID
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calculaTotal();
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    calculaTotal();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    calculaTotal();
                            };
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    calculaTotal();
                            };                
                
                        } ;      
                        return config;
                }
                ```
        }
