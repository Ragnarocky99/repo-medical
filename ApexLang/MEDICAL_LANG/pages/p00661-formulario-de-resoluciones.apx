    dynamicAction setear-total (
        name: Setear total
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles-resolucion
            columns: MONTO_TOTAL
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detalles").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("MONTO_TOTAL");
                    model.forEach(function(igrow) {
                        n_amt = parseInt(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P661_TOTAL").setValue(n_totamt);
                    ```
            }
            affectedElements {
                selectionType: items
                items: P661_TOTAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :MONTO_TOTAL
                itemsToSubmit: MONTO_TOTAL
            }
            affectedElements {
                selectionType: items
                items: P661_TOTAL
            }
            execution {
                sequence: 10
            }
        )

    )

