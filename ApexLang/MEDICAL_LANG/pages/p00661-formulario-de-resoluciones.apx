    dynamicAction anula-resolucion (
        name: Anula Resolucion
        execution {
            sequence: 60
        }
        when {
            selectionType: region
            region: @detalles-resolucion
        }
        serverSideCondition {
            type: never
        }

        action autoriza-ctacte-fec (
            name: AUTORIZA_CTACTE_FEC
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        vfec VARCHAR2(20);
                    BEGIN
                        IF :P661_ANULADO = 'S' THEN 
                            --IF :P661_ID is null THEN
                                vfec := SYSDATE/*TO_CHAR(SYSDATE,'DD/MM/YYYY HH:MM:SS')*/;
                            --ELSE
                             --   vfec := NULL;
                            --END IF;
                        ELSE
                            vfec:= NULL;
                        END IF;
                    
                        RETURN vfec;
                    END;
                    ```
                itemsToSubmit: P661_ANULADO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P661_FEC_ANULACION
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P661_ANULADO
                value: S
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select /*TO_CHAR(SYSDATE,'DD/MM/YYYY HH:MM:SS')*/sysdate from dual;
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: AUTORIZA_CTACTE_FEC
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar articulo
        execution {
            sequence: 90
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles-resolucion
            columns: COD_ARTICULO
        }

        action set-id (
            name: Set ID
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    --raise_application_error(-20000,:COD_ARTICULO);
                    END;
                    
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos'  || sqlerrm);
                    
                    
                    --select id from stw_articulos
                    --where cod_articulo = :COD_ARTICULO
                    --AND ID_EMPRESA = :P0_ID_EMPRESA
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cálculo-del-total (
