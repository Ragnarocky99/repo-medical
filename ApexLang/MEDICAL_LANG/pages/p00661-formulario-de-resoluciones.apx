    process initialize-form-formulario-de-resoluciones (
        name: Initialize form Formulario de Resoluciones
        type: formInitialization
        formRegion: @formulario-de-resoluciones
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 74641302207313156
        }
    )

    process process-form-formulario-de-resoluciones (
        name: Process form Formulario de Resoluciones
        type: formAutoRowProcessing
        formRegion: @formulario-de-resoluciones
        target {
            targetType: tableView
            tableName: LCW_RESOLUCIONES_CAB
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 74641776145313157
        }
    )

    process save-form-data (
        name: Save Form data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles-resolucion
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                             insert into LCW_RESOLUCIONES_DET(
                               ID_RESO_CAB,
                               NRO_ITEM,
                               ID_ARTICULO,
                               ID_UNIDAD_MEDIDA,
                               CANT_MIN,
                               CANT_MAX,
                               PRECIO_UNITARIO,
                               MONTO_TOTAL,
                               ID_PROVEEDOR,
                               COSTO_FOB
                             )
                             
                              values(      
                                   :P661_ID,--:ID_RESO_CAB,
                                   :NRO_ITEM,
                                   :ID_ARTICULO,
                                   :ID_UNIDAD_MEDIDA,
                                   :CANT_MIN,
                                   :CANT_MAX,
                                   :PRECIO_UNITARIO,
                                   :MONTO_TOTAL,
                                   :ID_PROVEEDOR,
                                   :COSTO_FOB
                             );
                            
                            
                            when 'U' then
                                update LCW_RESOLUCIONES_DET D
                                set 
                                    ID_RESO_CAB = :ID_RESO_CAB,
                                    NRO_ITEM = :NRO_ITEM,
                                    ID_ARTICULO = :ID_ARTICULO,
                                    ID_UNIDAD_MEDIDA = :ID_UNIDAD_MEDIDA,
                                    CANT_MIN = :CANT_MIN,
                                    CANT_MAX = :CANT_MAX,
                                    PRECIO_UNITARIO = :PRECIO_UNITARIO,
                                    MONTO_TOTAL = :MONTO_TOTAL,
                                    ID_PROVEEDOR = :ID_PROVEEDOR,
                                    COSTO_FOB = :COSTO_FOB
                
                                 where D.id = :ID;
                
                             when 'D' then
                             delete LCW_RESOLUCIONES_DET D
                             WHERE D.ID = :ID;
                
                               
                    end case;
                                         
                
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 74139453447006839
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 659
            }
        }
    )

)

