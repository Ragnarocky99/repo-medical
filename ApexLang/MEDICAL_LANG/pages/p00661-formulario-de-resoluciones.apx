    region formulario-de-resoluciones (
        name: Formulario de Resoluciones
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       --NRO_ORDEN,
                       NRO_RESOLUCION,
                       FEC_RESOLUCION,
                       NRO_LICITACION,
                       --NRO_POLIZA,
                       --FEC_POLIZA_INI,
                       --FEC_POLIZA_FIN,
                       --TOT_RESOLUCION,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       DECIMALES,
                       COD_USUARIO,
                       FEC_ALTA,
                       ANULADO,
                       FEC_ANULACION,
                       COD_USU_ANU,
                       ID_CLIENTE,
                       --NRO_ORDEN_OF,
                       --NRO_OFERTA_OF,
                       FEC_FIRMA,
                       FEC_NOTIFICACION,
                       NRO_OFERTA,
                       --ID_OFERTA,
                       ID_SUCURSAL --id_licitacion
                  from LCW_RESOLUCIONES_CAB
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

