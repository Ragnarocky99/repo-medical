    pageItem P552_ID_BARRIO (
        type: popupLov
        label {
            label: <p>Barrio: </p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select  t.descripcion || ' -('|| t.cod_barrio || ')' barrio, t.id
                from BSW_BARRIOS t 
                where id_ciudad = :P552_ID_CIUDAD
                ```
