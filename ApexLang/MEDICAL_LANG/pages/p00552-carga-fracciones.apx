    region registro-de-la-municipalidad (
        name: Registro de la Municipalidad
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_FRACCION,
                       NRO_FINCA,
                       NRO_REGISTRO,
                       NRO_FOLIO,
                       FEC_REGISTRO,
                       NRO_ORDEN
                  from LTW_FRACCIONES_REGISTROS
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                  AND ID_FRACCION = :P552_ID
                ```
            pageItemsToSubmit: P552_ID
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 87792078344849429
        }

        savedReport 900789 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

