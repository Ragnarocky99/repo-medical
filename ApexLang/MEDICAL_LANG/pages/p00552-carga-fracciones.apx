            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-fracciones (
        name: Carga de Fracciones
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       COD_FRACCION,
                       DESCRIPCION,
                       ID_PAIS,
                       ID_PROVINCIA,
                       ID_CIUDAD,
                       ID_BARRIO,
                       PRECIO,
                       SUPERFICIE_TOTAL,
                       ID_CLIENTE,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       IND_PROPIO,
                       FEC_MODI,
                       ID_USUARIO_MODI,
                       SUPERFICIE_CALLE,
                       SUPERFICIE_PLAZA,
                       SUPERFICIE_NETA,
                       CANT_CUOTAS_DESCUENTOS,
                       PORC_COM_ADMINISTRACION,
                       PORC_COM_VENTAS,
                       PORC_COM_RENTA,
                       MEJORAS,
                       MONTO_COMPRA,
                       NOM_ESCUELA,
                       NOM_IGLESIA,
                       MONTO_IVA,
                       MONTO_TOTAL,
                       IND_LUZ,
                       IND_ESCUELA,
                       IND_IGLESIA,
                       IND_AGUA,
                       IND_IVA_INCLUIDO,
                       PORC_IVA,
                       ID_IVA,
                       IND_ESQUINA,
                       ID_MONEDA,
                       IND_TRANSPORTE,
                       TIP_CAMINO,
                       CANT_LOTES,
                       LINEAS,
                       FINCA,
                       DIRECCION,
                       OBSERVACION,
                       CANT_COPIA,
                       RESOLUCION,
                       FEC_RESOLUCION,
                       REGISTRO,
                       FOLIO,
                       FEC_REGISTRO,
                       DEBE,
                       HABER,
                       IND_COMISION,
                       IND_RETENCION,
                       ID_SUCURSAL,
                       TIP_COMISION,
                       SECCION,
                       IND_FIDUCIARIO,
                       IND_INFORCONF,
                       ID_SECTOR
                  from LTW_FRACCIONES
                ```
        }
        layout {
            sequence: 40
            slot: body
            column: 1
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

