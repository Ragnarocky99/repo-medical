    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P552_FEC_RESOLUCION
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P552_FEC_REGISTRO) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P552_FEC_REGISTRO,'/','');
                            conv_fecha := substr(:P552_FEC_REGISTRO,1,2)||'/'||
                                                      substr(:P552_FEC_REGISTRO,3,2)||'/'||
                                                      lpad(substr(:P552_FEC_REGISTRO,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
