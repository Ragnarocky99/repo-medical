        source {
            formRegion: @carga-de-fracciones
            column: COD_FRACCION
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_FRACCION)), 0)+1
                from LTW_FRACCIONES A
                WHERE A.ID_EMPRESA = :P0_ID_EMPRESA;
                ```
        }
    )

