    pageItem P552_ID_PROVINCIA (
        type: popupLov
        label {
            label: <p>Provincia: </p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                T.DESCRIPCION || ' -('|| T.COD_PROVINCIA ||')' PROVINCIA, T.ID
                from BSW_PROVINCIAS t
                where id_pais = :P552_ID_PAIS
                ```
            nullDisplayValue: --Sin Seleccionar--
        }
        cascadingLov {
            parentItems: P552_ID_PAIS
