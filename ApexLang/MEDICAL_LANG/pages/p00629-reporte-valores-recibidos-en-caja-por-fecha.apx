    dynamicAction resaltar-fila (
        name: Resaltar Fila
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @reporte-de-valores
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //En el headers ponemos el Static ID de la columna que queramos comparar
                    $('td[headers="Estado"]').each(function() {  
                    
                      if ( $(this).text() == 'COBRADO' ) {
                    
                    //    $(this).closest('tr').find('td').css({"background-color":"rgb(37 90 185 / 68%)"});
                    
                          $(this).closest('tr').find('td').css({"color":"#13bd4b"});
                    
                          $(this).closest('tr').find('td').css({"font-weight":"bold"});
                    
                          $(this).closest('tr').find('td').css({"border":"1px solid #D6EAF8  !important"});
                    
                      }
                    
                      if ( $(this).text() == 'PENDIENTE' ) {
                    
                    //    $(this).closest('tr').find('td').css({"background-color":"rgb(37 90 185 / 68%)"});
                    
                          $(this).closest('tr').find('td').css({"color":"#f26555"});
                    
                          $(this).closest('tr').find('td').css({"font-weight":"bold"});
                    
                          $(this).closest('tr').find('td').css({"border":"1px solid #D6EAF8  !important"});
                    
                      }
                    
                      if ( $(this).text() == 'COBRO PARCIAL' ) {
                    
                    //    $(this).closest('tr').find('td').css({"background-color":"rgb(37 90 185 / 68%)"});
                    
                          $(this).closest('tr').find('td').css({"color":"#decd18"});
                    
                          $(this).closest('tr').find('td').css({"font-weight":"bold"});
                    
                          $(this).closest('tr').find('td').css({"border":"1px solid #D6EAF8  !important"});
                    
                      }
                    
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    computation p629-traer-ip (
        itemName: P629_TRAER_IP
        execution {
            sequence: 10
        }
        computation {
            sqlQuery: SELECT owa_util.get_cgi_env('REMOTE_ADDR') FROM DUAL;
        }
    )

