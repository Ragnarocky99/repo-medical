    region grafico (
        name: Grafico
        type: chart
        layout {
            sequence: 10
            parentRegion: @reporte-de-valores
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select fc.id_sub_tipo_trans, st.descripcion, sum(nvl(fc.monto,0)*nvl(fc.tip_cambio,1)) tot_valor
                    from ccw_movimientos_cajas mc,
                         ccw_formas_cobros fc,
                         bsw_subtipos_trans st
                    where mc.id = fc.id_mov_caj
                      and st.id = fc.id_sub_tipo_trans
                      AND (mc.fec_mov_caj BETWEEN :P629_FEC_INI AND :P629_FEC_FIN)
                      AND (mc.NRO_HABILITACION = :P629_HABILITACION OR :P629_HABILITACION IS NULL)
                      
                    GROUP BY fc.id_sub_tipo_trans, st.descripcion
                    ```
                pageItemsToSubmit: [
                    P629_FEC_INI
                    P629_FEC_FIN
                    P629_HABILITACION
                ]
            }
            columnMapping {
                label: DESCRIPCION
                value: TOT_VALOR
            }
            label {
                show: true
            }
        )

    )

    region reporte-de-valores (
        name: Reporte de Valores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select  st.subtipo_trans, st.descripcion, sum(nvl(fc.monto,0)*nvl(fc.tip_cambio,1)) tot_valor, st.descripcion as VerDetalle
                from ccw_movimientos_cajas mc,
                     ccw_formas_cobros fc,
                     bsw_subtipos_trans st
                where mc.id = fc.id_mov_caj
                  and st.id = fc.id_sub_tipo_trans
                  AND (mc.fec_mov_caj BETWEEN :P629_FEC_INI AND :P629_FEC_FIN)
                  AND (mc.NRO_HABILITACION = :P629_HABILITACION OR :P629_HABILITACION IS NULL)
                  
                GROUP BY st.subtipo_trans, st.descripcion
                ```
            pageItemsToSubmit: [
                P629_FEC_INI
                P629_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aún no hay valores en el rango seleccionado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 111674475211317375
        }

