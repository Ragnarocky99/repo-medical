    pageItem P431_FEC_FIN (
        type: datePicker
        label {
            alignment: left
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: LAST_DAY(SYSDATE)
        }
    )

    pageItem P431_FEC_INICIO (
        type: datePicker
        label {
            label: <p>Periodo Comprobante:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE, 'MM')
        }
    )

    pageItem P431_NRO_COMPROBANTE (
        type: numberField
        label {
            label: <p>Nro. Pedido:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @pedidos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 453
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 60
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }

        triggerAction refrescar-reporte (
            name: Refrescar Reporte
            action: refresh
            affectedElements {
                selectionType: region
                region: @pedidos
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction agregar-paginacion (
        name: Agregar Paginacion
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @pedidos
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction estados (
        name: Estados
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('td[headers="OPERACION"]').each(function() {
                      var texto = $(this).text();
                      if (texto === 'Confirmado') {
                        $(this).css("color", "grey");
                      } else if (texto === 'En Proceso') {
                        $(this).css("color", '#e1ad01');
                      } else if (texto === 'Anulado') {
                        $(this).css("color", "red"); 
                      }
                      else if (texto === 'Enviado') {
                        $(this).css("color", "green"); 
                      } 
                      else if (texto === 'En Deposito') {
                        $(this).css("color", "orange"); 
                      } 
                      else if (texto === 'Pendiente') {
                        $(this).css("color", "yellow"); 
                      } 
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

