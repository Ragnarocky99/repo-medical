page 431 (
    name: Pedidos
    alias: PEDIDOS
    title: Pedidos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @pedidos
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region pedidos (
        name: Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT id,
                       fec_comprobante,
                       tip_comprobante,
                       ser_comprobante,
                       nro_comprobante,
                       nom_cliente,
                       ruc_cliente,
                       direccion,
                       telefono,
                       id_moneda,
                       tip_cambio,
                       tot_comprobante,
                       estado,
                       fec_estado,
                       cod_usuario_aud,
                       fec_alta
                  FROM vtw_pedidos_cabecera
                 WHERE id_empresa  = :P0_ID_EMPRESA
                   AND id_sucursal = :P0_ID_SUCURSAL
                   AND fec_comprobante BETWEEN :P431_FEC_INICIO AND :P431_FEC_FIN
                   AND (nro_comprobante = :P431_NRO_COMPROBANTE OR :P431_NRO_COMPROBANTE IS NULL)
                ORDER BY fec_comprobante DESC,
                         nro_comprobante DESC
                ```
            pageItemsToSubmit: [
                P431_FEC_INICIO
                P431_FEC_FIN
                P431_NRO_COMPROBANTE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 453
                items: {
                    P453_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 48913744260632957
        }

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Creado Por
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column DIRECCION (
            type: plainText
            heading {
                heading: Dirección
                alignment: center
            }
            layout {
                sequence: 51
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AY
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ESTADO (
            type: plainTextBasedOnLov
            heading {
                heading: Estado
                alignment: center
            }
            lov {
                lov: @lv-estados-pedido
            }
            layout {
                sequence: 142
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
