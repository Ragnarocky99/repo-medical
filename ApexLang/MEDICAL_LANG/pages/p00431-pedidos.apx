        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Pedidos
        }

        savedReport 489368 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_USUARIO_AUD (
                sequence: 14
            )

            displayColumn DIRECCION (
                sequence: 10
            )

            displayColumn ESTADO (
                sequence: 12
            )

            displayColumn FEC_ALTA (
                sequence: 15
            )

            displayColumn FEC_COMPROBANTE (
                sequence: 1
            )

            displayColumn FEC_ESTADO (
                sequence: 13
            )

