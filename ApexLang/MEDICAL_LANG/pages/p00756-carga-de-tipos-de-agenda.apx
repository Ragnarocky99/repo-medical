            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-tipos-de-agenda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
