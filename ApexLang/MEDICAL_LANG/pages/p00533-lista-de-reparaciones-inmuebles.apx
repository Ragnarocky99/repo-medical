page 533 (
    name: Lista de Reparaciones Inmuebles
    alias: LISTA-DE-REPARACIONES-INMUEBLES
    title: Reparaciones de Inmuebles
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region reparación-de-inmuebles (
        name: Reparación de Inmuebles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_CONTRATO,
                       FEC_OCURRENCIA,
                       NRO_COMPROBANTE,
                       TOT_COMPROBANTE,
                       ID_LOCAL,
                       ID_PROVEEDOR,
                       COD_USUARIO_AUD,
                       ID_REPARACION,
                       NRO_REPARACION
                  from ACW_REPARACIONES_INMUEBLES
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 84179271067882413
        }

        savedReport 842043 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_CONTRATO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @FEC_OCURRENCIA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @NRO_COMPROBANTE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @TOT_COMPROBANTE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ID_LOCAL
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ID_PROVEEDOR
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @ID_REPARACION
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @NRO_REPARACION
                layout {
                    sequence: 11
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
            }
            default {
                type: expression
                plsqlExpression: :APP_USER
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column FEC_OCURRENCIA (
            type: datePicker
            heading {
                heading: Fecha Ocurrencia
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: FEC_OCURRENCIA
                dataType: date
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue: select sysdate from dual
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_CONTRATO (
            type: popupLov
            heading {
                heading: Contrato
                alignment: center
            }
            settings {
                displayAs: modalDialog
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-contratos
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_CONTRATO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_LOCAL (
            type: popupLov
            heading {
                heading: Local
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT L.COD_LOCAL ||'-'|| L.DESCRIPCION AS LOCALES, L.ID
                    FROM ACW_LOCALES L, ACW_CONTRATOS_LOCALES C
                    WHERE L.ID_EMPRESA = :P0_ID_EMPRESA
                    AND L.ID_EMPRESA = C.ID_EMPRESA
                    AND C.ID_LOCAL = L.ID
                    AND C.ID_CONTRATO_CAB = :ID_CONTRATO
                    ```
            }
            cascadingLov {
                parentColumns: ID_CONTRATO
                itemsToSubmit: ID_CONTRATO
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                databaseColumn: ID_LOCAL
                dataType: number
            }
        )

        column ID_PROVEEDOR (
            type: popupLov
            heading {
                heading: Proveedor
                alignment: center
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lv-proveedores
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                databaseColumn: ID_PROVEEDOR
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_REPARACION (
            type: popupLov
            heading {
                heading: Reparación
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lv-reparaciones
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: ID_REPARACION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column NRO_COMPROBANTE (
            type: textField
            heading {
                heading: Nro Comprobante
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: NRO_COMPROBANTE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column NRO_REPARACION (
            type: textField
            heading {
                heading: Nro Reparacion
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            appearance {
                cssClasses: is-readonly
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: NRO_REPARACION
                dataType: varchar2
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue:
                    ```sql
                    SELECT NVL(MAX(NRO_REPARACION),0) + 1 FROM ACW_REPARACIONES_INMUEBLES 
                    WHERE ID_EMPRESA = :P0_ID_EMPRESA
                    ```
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TOT_COMPROBANTE (
            type: numberField
            heading {
                heading: Total
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: TOT_COMPROBANTE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reparación de Inmuebles
        }
    )

    dynamicAction contratos (
        name: Contratos
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: columns
            interactiveGrid: @reparación-de-inmuebles
            columns: ID_CONTRATO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :ID_CONTRATO
                itemsToSubmit: P533_ID_CONTRATO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P533_ID_CONTRATO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process reparación-de-inmuebles-save-interactive-grid-data (
        name: Reparación de Inmuebles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @reparación-de-inmuebles
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 84180571878882426
        }
    )

)

