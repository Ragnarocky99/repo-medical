    dynamicAction abrir-lista (
        name: Abrir Lista
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: columns
            interactiveGrid: @facturas-a-referenciar
            columns: NRO_COMPROBANTE_REF
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#ID_COMP_lov_btn').click();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cerrar-pagina (
        name: Cerrar Pagina
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inicializar (
        name: Inicializar
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.setEditMode(true);
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SUM(TOT_COMPROBANTE) AS TOTAL
                    FROM CPW_COMPROBANTES_REF 
                    WHERE ID_COMPROBANTE = :P290_ID_PARAM
                    ```
                itemsToSubmit: P290_TOTAL
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P290_TOTAL
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P290_ID_PARAM
            }
        )

    )

