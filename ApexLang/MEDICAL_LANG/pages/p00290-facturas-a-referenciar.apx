        name: INSERT_COMPROBANTE_CAJAS
        type: executeCode
        editableRegion: @facturas-a-referenciar
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    if nvl(:P290_TOTAL,0) <> 0 and :PLV_MODULO = 'CP' then
                
                       ----ULTIMO_NRO_MOV_CAJ;
                       insert_comprobante_cajas(:TIP_COMPROBANTE_REF,
                                                :SER_COMPROBANTE_REF,
                                                :NRO_COMPROBANTE_REF,
                                                :P290_PROVEEDOR_PARAM,
                                                '1',
                                                :P290_TOTAL_PARAM,
                                                :P290_MONEDA_PARAM);  
                        
                    end if;
                END;
                ```
        }
