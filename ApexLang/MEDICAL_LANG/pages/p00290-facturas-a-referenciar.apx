        action id-proveedor (
            name: ID_PROVEEDOR
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P290_PROVEEDOR_PARAM
                itemsToSubmit: P290_PROVEEDOR_PARAM
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: ID_PROVEEDOR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-total (
        name: Setear Total
        execution {
            sequence: 130
        }
        when {
            selectionType: columns
            interactiveGrid: @facturas-a-referenciar
            columns: ID_IVA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(SUM(CD.MONTO_TOTAL),0) MONTO_TOTAL
                           
                    FROM CMW_COMPRAS_CABECERA CM,
                         CMW_COMPRAS_DETALLE CD,
                         STW_IVA I
                    
                    WHERE CM.ID = CD.ID_COMPRAS_CAB
                      AND CM.TIP_COMPROBANTE = :TIP_COMPROBANTE_REF
                      AND CM.SER_COMPROBANTE = :SER_COMPROBANTE_REF
                      AND CM.NRO_COMPROBANTE = :NRO_COMPROBANTE_REF
                      AND I.ID = :ID_IVA
                      AND CD.ID_IVA  = I.ID
                      AND :PLV_MODULO = 'CM'
                      
                    GROUP BY I.ID
                    
                    UNION ALL
                    
                    SELECT NVL(SUM(DP.MONTO_TOTAL),0) MONTO_TOTAL
                           
                    FROM CPW_COMPROBANTES_CABECERA CP,
                         CPW_COMPROBANTES_DETALLE DP,
                         STW_IVA V
                    
                    WHERE CP.ID = DP.ID_COMPROBANTE
                      AND CP.TIP_COMPROBANTE = :TIP_COMPROBANTE_REF
                      AND CP.SER_COMPROBANTE = :SER_COMPROBANTE_REF
                      AND CP.NUM_COMPROBANTE = :NRO_COMPROBANTE_REF
                      AND V.ID = :ID_IVA
                      AND DP.ID_IVA  = V.ID
                      AND :PLV_MODULO = 'CP'
                    GROUP BY V.ID
                    ```
                itemsToSubmit: [
                    ID_COMPROBANTE_REF
                    TIP_COMPROBANTE_REF
                    SER_COMPROBANTE_REF
                    NRO_COMPROBANTE_REF
                    PLV_MODULO
                    ID_IVA
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: TOT_COMPROBANTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setear-valores (
        name: Setear Valores
        execution {
            sequence: 70
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    nombre varchar2(255):=WWV_FLOW.G_INSTANCE;
                    v_total varchar(500);
                    BEGIN
                    Select  c001,c002,c003,c004
                    into :P290_PROVEEDOR_PARAM,:P290_TOTAL_PARAM, :P290_MONEDA_PARAM, :P290_ID_PARAM
                    From APEX_COLLECTIONS
                    Where COLLECTION_NAME = nombre
                    AND SEQ_ID = 1;
                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => nombre);
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    null;
                    WHEN OTHERS THEN
                    null;
                    END;
                    ```
                itemsToReturn: [
                    P290_PROVEEDOR_PARAM
                    P290_TOTAL_PARAM
                    P290_MONEDA_PARAM
                    P290_ID_PARAM
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

