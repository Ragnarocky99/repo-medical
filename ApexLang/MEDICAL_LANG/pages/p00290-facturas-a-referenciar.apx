page 290 (
    name: Facturas a Referenciar
    alias: FACTURAS-A-REFERENCIAR
    title: Facturas a Referenciar
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 750
        height: 550
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
             function calculaTotales(){
                var model= apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("TOTAL_COPIA");
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                          
                        v_total_cantidad      = v_total_cantidad     + parseFloat(r[v_cantidad].replace(/\./g,''));
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                 $s('P290_TOTAL',v_total_cantidad);
            }
            ```
        executeWhenPageLoads: document.getElementById("P290_TOTAL").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .totales{
                text-align: center;
                font-size: medium;
            }
            .totalesp{
                font-weight: bold;
                font-size: large;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @standard
