        advanced {
            regionDisplaySelector: true
        }
    )

    region facturas-a-referenciar (
        name: Facturas a Referenciar
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_EMPRESA,
                       C.ID_COMPROBANTE,
                       C.TIP_COMPROBANTE,
                       C.SER_COMPROBANTE,
                       C.NRO_COMPROBANTE,
                       C.ID_COMPROBANTE_REF,
                       C.TIP_COMPROBANTE_REF,
                       C.SER_COMPROBANTE_REF,
                       C.NRO_COMPROBANTE_REF,
                       C.TOT_COMPROBANTE,
                       C.TOT_COMPROBANTE AS TOTAL_COPIA,
                       C.ID_IVA,
                       C.IND_FEC_UTILIZADO,
                       C.TIP_MOV_CAJ,
                       C.SER_MOV_CAJ,
                       C.NRO_MOV_CAJ,
                       C.ID_PROVEEDOR,
                       C.ID_SUCURSAL,
                       C.REFERENCIA
                  from CPW_COMPROBANTES_REF C
                  WHERE C.ID_COMPROBANTE = :P290_ID_PARAM
                
                ```
            pageItemsToSubmit: P290_ID_PARAM
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: Detalles
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    recalculaImporte();
                                    orden=orden-1;
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    recalculaImporte();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    recalculaImporte();
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    recalculaImporte();
                            };    
                       
                       
                                
                
                        } ;      
                        return config;
                }
                ```
        }
