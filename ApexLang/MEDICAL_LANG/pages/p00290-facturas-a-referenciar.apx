    dynamicAction validacion-total (
        name: Validacion Total
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF TO_NUMBER(NVL(REPLACE(:P290_TOTAL,'.',''),0)) != (TO_NUMBER(NVL(REPLACE(:P290_TOTAL_PARAM,'.',''),0))) THEN
                        RAISE_APPLICATION_ERROR (-20000, 'El monto total debe ser igual al monto del saldo del comprobante'||:P290_TOTAL|| ' '||:P290_TOTAL_PARAM);
                       /* ELSIF NVL(:P290_TOTAL_PARAM,0) = 0 THEN
                            RAISE_APPLICATION_ERROR (-20000, 'No puede aplicar mayor monto del saldo del comprobante');*/ 
                    END IF;
                    ```
                itemsToSubmit: [
                    P290_TOTAL
                    P290_TOTAL_PARAM
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CREATE
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

