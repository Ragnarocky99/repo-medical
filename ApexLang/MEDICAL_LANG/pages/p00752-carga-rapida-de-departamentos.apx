page 752 (
    name: Carga rapida de Departamentos
    alias: CARGA-RAPIDA-DE-DEPARTAMENTOS
    title: Carga rapida de Departamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region carga-rapida-de-departamentos (
        name: Carga rapida de Departamentos
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: BSW_DEPARTAMENTOS
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
        toolbar {
            controls: searchCol
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 25732879212051601
        }

        savedReport 257333 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_EMPRESAS
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @COD_DEPARTAMENTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ACTIVO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @COD_USUARIO_AUD
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ID_SUCURSAL
                layout {
                    sequence: 7
                }
            )

        )

        column ACTIVO (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ACTIVO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: S
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_DEPARTAMENTO (
            type: textField
            heading {
                heading: <p>Codigo</p>
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
                maxLength: 5
            }
            source {
                databaseColumn: COD_DEPARTAMENTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: COD_USUARIO_AUD
                dataType: varchar2
            }
            default {
                type: expression
                plsqlExpression: :APP_USER
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: <p>Descripcion</p>
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 65
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_EMPRESAS (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_EMPRESAS
                dataType: number
            }
            default {
                type: item
                item: P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_SUCURSAL (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ID_SUCURSAL
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Carga rapida de Departamentos
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 10
            region: @carga-rapida-de-departamentos
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process carga-rapida-de-departamentos-save-interactive-grid-data (
        name: Carga rapida de Departamentos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @carga-rapida-de-departamentos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25742534601051606
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25602869579339430
        }
    )

)

