page 554 (
    name: Conceptos de Embarques
    alias: CONCEPTOS-DE-EMBARQUES
    title: Conceptos de Embarques
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region mantenimiento-de-coeficientes-de-revaluo (
        name: Mantenimiento de Coeficientes de Revaluo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT EC.COD_CONCEPTO,
                       EC.DESCRIPCION,
                       EC.ID,
                       EC.COD_USUARIO_AUD
                FROM CMW_EMBARQUES_CONCEPTO EC;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 555
                items: {
                    P555_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Editar"><span class="fa fa-edit" aria-hidden="true" title="Editar"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No se ha encontrado ningún dato.
            whenMoreDataFound: El recuento máximo de filas de este informe es #MAX_ROW_COUNT# filas. Aplique un filtro para reducir el número de registros de la consulta.
        }
        advanced {
            savedReportMappingIdentifier: 148332734104299429
        }

        column COD_CONCEPTO (
            type: plainText
            heading {
                heading: Cód. Concepto
                alignment: center
            }
            layout {
                sequence: 24
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column COD_USUARIO_AUD (
            type: plainText
            heading {
                heading: Cod Usuario Aud
                alignment: center
            }
            layout {
                sequence: 44
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 34
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 14
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Mantenimiento de Coeficientes de Revaluo
        }

        savedReport 600008 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CONCEPTO (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 3
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

        )

    )

    region ruta-de-navegación (
        name: "Ruta de Navegación "
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: "Crear "
        layout {
            sequence: 10
            region: @mantenimiento-de-coeficientes-de-revaluo
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 555
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction editar-informe-cuadro-de-diálogo-cerrado (
        name: "Editar Informe: Cuadro de Diálogo Cerrado "
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @mantenimiento-de-coeficientes-de-revaluo
        }

        action refresh (
            name: Refresh
            action: refresh
            affectedElements {
                selectionType: region
                region: @mantenimiento-de-coeficientes-de-revaluo
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

