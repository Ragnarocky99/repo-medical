    region carga-solicitud-de-reparto (
        name: Carga Solicitud de Reparto
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_CLIENTE,
                       FECHA_ENTREGA_SUG,
                       CANTIDAD_CAJAS,
                       COD_USUARIO_AUD,
                       FEC_ALTA,
                       ID_PROVEEDOR,
                       ID NRO_REPARTO,
                       DIRECCION_ENVIO,
                       OBSERVACION,
                       FECHA_SOLICITUD,
                       ESTADO,
                       ID_MOTIVO_REPARTO,
                       COMENTARIO
                  from RPW_SOLICITUD_REPARTO_CAB sc
                  where sc.fecha_solicitud between :P723_FEC_SOL_DESDE and :P723_FEC_SOL_HASTA
                    and ((sc.fecha_entrega_sug between :P723_FEC_SUG_DESDE and :P723_FEC_SUG_HASTA)
                          or sc.fecha_entrega_sug is null)
                    and (sc.id = :P723_NRO_SOLICITUD or :P723_NRO_SOLICITUD is null)
                
                   
                      AND (
                       ((SELECT COUNT(1) FROM RPW_SOLICITUD_REPARTO_DET SD1
                       WHERE SD1.ID_SOLICITUD_REP_CAB = SC.ID) 
                       != --QUE LA CANTIDAD DETALLE != CANTIDAD ENVIADA + CANCELADA
                       (SELECT COUNT(1) FROM RPW_SOLICITUD_REPARTO_DET SD2
                       WHERE SD2.ID_SOLICITUD_REP_CAB = SC.ID
                         AND NVL(SD2.ESTADO,'XY') = 'EN') --CANTIDAD ENVIADA 
                       +(SELECT COUNT(1) FROM RPW_SOLICITUD_REPARTO_DET SD3
                          WHERE SD3.ID_SOLICITUD_REP_CAB = SC.ID
                           AND NVL(SD3.ESTADO,'XY') = 'CA'))) --CANTIDAD CANCELADA
                         OR ((SELECT COUNT(1) FROM RPW_SOLICITUD_REPARTO_DET SD4
                               WHERE SD4.ID_SOLICITUD_REP_CAB = SC.ID) = 0 
                         --PERO QUE TENGA ALGUN DETALLE. SI NO, SI SE CARGA SIN DETALLES, DESAPARECERA.
                        
                        --QUERY COMPLICADO. PERO LO MANTENGO AQUI EN VEZ DE HACERLA UNA FUNCION
                        --YA QUE HACE QUE SEA MAS RAPIDO
                  )
                  
                /*AND (
                    (:P723_ESTADO IS NULL AND sc.ID IS NOT NULL) -- Mostrar todos si P723_ESTADO es NULL
                    OR (:P723_ESTADO = 'PE' AND EXISTS (
                        SELECT 1 
                        FROM RPW_SOLICITUD_REPARTO_DET det 
                        WHERE det.ID_SOLICITUD_REP_CAB = sc.id 
                        AND det.ESTADO = 'PE'
                    ))
                    OR (:P723_ESTADO IS NOT NULL AND :P723_ESTADO <> 'PE') -- Si eligen otro estado, no filtrar por detalle
                )*/
                ```
            pageItemsToSubmit: [
                P723_FEC_SOL_DESDE
                P723_FEC_SOL_HASTA
                P723_FEC_SUG_DESDE
                P723_FEC_SUG_HASTA
                P723_NRO_SOLICITUD
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Reparto
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
        }
        toolbar {
