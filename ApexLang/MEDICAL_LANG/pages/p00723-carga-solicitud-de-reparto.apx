    dynamicAction inicializar-grilla (
        name: Inicializar Grilla
        execution {
            sequence: 100
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Reparto").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        $grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-detalles-de-solicitud
            columns: ID_FACTURA_VT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :ID_FACTURA_VT IS NOT NULL THEN
                    begin
                    select fac.tip_comprobante||'-'||fac.ser_comprobante||'-'||fac.nro_comprobante,nvl(per.direccion,'No especificada')
                    into :NRO_COMPROBANTE, :DIRECCION_ENVIO
                    from vtw_comprobantes_cabecera fac
                    join ccw_clientes              cli on cli.id = fac.id_cliente
                    join bsw_personas              per on per.id = cli.id_persona
                    where fac.id = :ID_FACTURA_VT;
                    end;
                    END IF;
                    ```
                itemsToSubmit: [
                    ID_FACTURA_VT
                    P723_CURR_ID_CLIENTE
                ]
                itemsToReturn: [
                    NRO_COMPROBANTE
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-10 (
        name: New_9
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @carga-solicitud-de-reparto
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-detalles-de-solicitud
            columns: ID_FACTURA_CM
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :ID_FACTURA_CM IS NOT NULL THEN
                    BEGIN
                    SELECT 'FAC-'||C.SER_COMPROBANTE||'-'||C.NRO_COMPROBANTE,nvl(PE.DIRECCION,'No especificada')
                    INTO :NRO_COMPROBANTE, :DIRECCION_ENVIO
                    FROM CMW_COMPRAS_CABECERA C
                    JOIN CMW_PROVEEDORES      PR ON PR.ID = C.ID_PROVEEDOR
                    JOIN BSW_PERSONAS         PE ON PE.ID = PR.ID_PERSONA
                    WHERE C.ID = :ID_FACTURA_CM;
                    END;
                    END IF;
                    ```
                itemsToSubmit: ID_FACTURA_CM
                itemsToReturn: [
                    NRO_COMPROBANTE
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-detalles-de-solicitud
            columns: ID_REMISION
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :ID_REMISION IS NOT NULL THEN
                    begin
                     select 'REM-'||rem.ser_ent_sal||'-'||rem.num_ent_sal, nvl(per.direccion,'No especificada')
                     into :NRO_COMPROBANTE, :DIRECCION_ENVIO
                     from stw_entsal_cab rem
                     join ccw_clientes              cli on cli.id = rem.id_cliente
                     join bsw_personas              per on per.id = cli.id_persona
                     where rem.id = :ID_REMISION;
                    end;
                    END IF;
                    ```
                itemsToSubmit: ID_REMISION
                itemsToReturn: [
                    NRO_COMPROBANTE
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

