    dynamicAction new-6 (
        name: New_5
        execution {
            sequence: 60
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-detalles-de-solicitud
            columns: ID_NOTA_ENVIO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    SELECT 'ENV-'||NEN.SER_ENVIO||'-'||NEN.NRO_ENVIO, NVL(ENT.DIRECCION,'No especificada')
                    into :NRO_COMPROBANTE, :DIRECCION_ENVIO
                    FROM STW_NOTAS_ENVIO_CAB NEN
                    JOIN BSW_SUCURSALES      SAL ON SAL.ID = NEN.ID_SUCURSAL
                    JOIN BSW_SUCURSALES      ENT ON ENT.ID = NEN.ID_SUCURSAL_ENT
                    WHERE NEN.ID = :ID_NOTA_ENVIO;
                    end;
                    ```
                itemsToSubmit: ID_NOTA_ENVIO
                itemsToReturn: [
                    NRO_COMPROBANTE
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-7 (
        name: New_6
        execution {
            sequence: 70
        }
        when {
            selectionType: columns
            interactiveGrid: @carga-solicitud-de-reparto
            columns: ID_CLIENTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    :P723_CURR_ID_CLIENTE := :ID_CLIENTE; 
                    SELECT NVL(PE.DIRECCION,'Sin definir')
                    INTO :DIRECCION_ENVIO
                    FROM CCW_CLIENTES CL     
                    JOIN BSW_PERSONAS PE ON PE.ID = CL.ID_PERSONA
                    WHERE CL.ID = :ID_CLIENTE;
                    EXCEPTION 
                      WHEN OTHERS THEN NULL;
                    END;
                    ```
                itemsToSubmit: ID_CLIENTE
                itemsToReturn: [
                    P723_CURR_ID_CLIENTE
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

