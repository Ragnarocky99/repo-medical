                    BEGIN
                     :P723_CURR_ID_CLIENTE := :ID_CLIENTE;
                     :P723_CURR_ID_PROVEEDOR := :ID_PROVEEDOR;
                    END;
                    ```
                itemsToSubmit: [
                    ID_CLIENTE
                    ID_PROVEEDOR
                ]
                itemsToReturn: [
