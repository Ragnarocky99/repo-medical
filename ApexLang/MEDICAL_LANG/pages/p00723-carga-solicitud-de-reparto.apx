        column ID_FACTURA_CM (
            type: popupLov
            heading {
                heading: Id Factura Cm
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 'FAC-'||C.SER_COMPROBANTE||'-'||C.NRO_COMPROBANTE||' de '||PE.NOMBRE, C.ID
                    FROM CMW_COMPRAS_CABECERA C
                    JOIN CMW_PROVEEDORES      PR ON PR.ID = C.ID_PROVEEDOR
                    JOIN BSW_PERSONAS         PE ON PE.ID = PR.ID_PERSONA
                    AND PR.ID = :P723_CURR_ID_PROVEEDOR
                    and not exists (
                        select 1
                        from rpw_solicitud_reparto_det d
                        where d.id_factura_cm =  c.id  
                        and d.estado = 'EN'
                    )
                    ORDER BY C.ID DESC
                    ```
            }
            cascadingLov {
                parentColumns: P723_CURR_ID_PROVEEDOR
                itemsToSubmit: P723_CURR_ID_PROVEEDOR
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ID_FACTURA_CM
                dataType: number
            }
            advanced {
                htmlDomId: ID_FACOMP
            }
        )

        column ID_FACTURA_VT (
            type: popupLov
            heading {
                heading: Id Factura Vt
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select fac.tip_comprobante||'-'||fac.ser_comprobante||'-'||fac.nro_comprobante||' de '||per.nombre, fac.id
                    from vtw_comprobantes_cabecera fac
                    join ccw_clientes   cli on cli.id = fac.id_cliente
                    join bsw_personas   per on per.id = cli.id_persona
                    where cli.id = :P723_CURR_ID_CLIENTE
                    and not exists (
                        select 1
                        from rpw_solicitud_reparto_det d
                        where d.id_factura_vt = fac.id  
                        and d.estado = 'EN'
                    );
                    ```
            }
            cascadingLov {
                parentColumns: P723_CURR_ID_CLIENTE
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ID_FACTURA_VT
                dataType: number
            }
            advanced {
                htmlDomId: ID_FVE
            }
        )

        column ID_NOTA_ENVIO (
            type: popupLov
            heading {
                heading: Id Nota Envio
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 'ENV-'||NEN.SER_ENVIO||'-'||NEN.NRO_ENVIO||' '||sal.descripcion||'->'||ent.descripcion, NEN.ID
                    FROM STW_NOTAS_ENVIO_CAB NEN
                    JOIN BSW_SUCURSALES      SAL ON SAL.ID = NEN.ID_SUCURSAL
                    JOIN BSW_SUCURSALES      ENT ON ENT.ID = NEN.ID_SUCURSAL_ENT
                    and not exists (
                        select 1
                        from rpw_solicitud_reparto_det d
                        where d.id_nota_envio = nen.id  
                        and d.estado = 'EN'
                    )
                    ORDER BY NEN.ID DESC;
                    ```
            }
            layout {
                sequence: 90
            }
            source {
