            interactiveGrid: @carga-solicitud-de-reparto
            columns: ID_PROVEEDOR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                     :P723_CURR_ID_PROVEEDOR := :ID_PROVEEDOR;
                     SELECT nvl(PE.DIRECCION,'Sin Definir')
                       INTO :DIRECCION_ENVIO
                     FROM CMW_PROVEEDORES PR     
                     JOIN BSW_PERSONAS  PE ON PE.ID = PR.ID_PERSONA
                     WHERE PR.ID = :ID_PROVEEDOR;
                     EXCEPTION
                      WHEN OTHERS THEN 
                       :DIRECCION_ENVIO := 'Sin Definir';
                    end;
                    ```
                itemsToSubmit: ID_PROVEEDOR
                itemsToReturn: [
                    P723_CURR_ID_PROVEEDOR
                    DIRECCION_ENVIO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

