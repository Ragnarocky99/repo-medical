page 21 (
    name: Carga de Ciudades
    alias: CARGA-DE-CIUDADES
    title: Carga de Ciudades
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 220
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-ciudades (
        name: Carga de Ciudades
        type: form
        source {
            location: localDatabase
            tableName: BSW_CIUDADES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P21_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @carga-de-ciudades
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-ciudades
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P21_COD_CIUDAD (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Ciudad:</a>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @carga-de-ciudades
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-ciudades
            column: COD_CIUDAD
            dataType: varchar2
        }
    )

    pageItem P21_COD_CIUDAD_FE (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-ciudades
            slot: regionBody
        }
        source {
            formRegion: @carga-de-ciudades
            column: COD_CIUDAD_FE
            dataType: varchar2
        }
    )

    pageItem P21_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-ciudades
            slot: regionBody
        }
        source {
            formRegion: @carga-de-ciudades
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P21_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @carga-de-ciudades
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-ciudades
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P21_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-ciudades
            slot: regionBody
        }
        source {
            formRegion: @carga-de-ciudades
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P21_ID_CIUDAD_FE (
        type: popupLov
        label {
            label: <p>Ciudad F.E:</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION, ID
                  FROM FEW_CIUDADES
                ```
        }
        layout {
            sequence: 90
            region: @carga-de-ciudades
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-ciudades
            column: ID_CIUDAD_FE
            dataType: number
        }
    )

    pageItem P21_ID_PAIS (
        type: selectList
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">País:</a>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lv-paises
        }
        layout {
            sequence: 20
            region: @carga-de-ciudades
            slot: regionBody
            alignment: left
            columnSpan: 5
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-ciudades
            column: ID_PAIS
            dataType: number
        }
    )

    pageItem P21_ID_PROVINCIA (
        type: selectList
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Departamento:</a>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION||'('||COD_PROVINCIA||')',ID FROM BSW_PROVINCIAS WHERE
                ID_PAIS=:P21_ID_PAIS
                ```
        }
        cascadingLov {
            parentItems: P21_ID_PAIS
            itemsToSubmit: P21_ID_PAIS
        }
        layout {
            sequence: 40
            region: @carga-de-ciudades
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 5
        }
        appearance {
            template: @required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @carga-de-ciudades
            column: ID_PROVINCIA
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button pais (
        buttonName: PAIS
        label: Pais
        layout {
            sequence: 30
            region: @carga-de-ciudades
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button provincias (
        buttonName: PROVINCIAS
        label: Provincias
        layout {
            sequence: 50
            region: @carga-de-ciudades
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-lista (
        name: Refrescar Lista
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @provincias
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P21_ID_PROVINCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-lv (
        name: Refrescar LV
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pais
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P21_ID_PAIS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p21-cod-ciudad (
        itemName: P21_COD_CIUDAD
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_CIUDAD)),0)+1
                from BSW_CIUDADES A
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9415805490929351
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-ciudades (
        name: Initialize form Carga de Ciudades
        type: formInitialization
        formRegion: @carga-de-ciudades
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9415046235929350
        }
    )

    process process-form-carga-de-ciudades (
        name: Process form Carga de Ciudades
        type: formAutoRowProcessing
        formRegion: @carga-de-ciudades
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9415434684929351
        }
    )

)

