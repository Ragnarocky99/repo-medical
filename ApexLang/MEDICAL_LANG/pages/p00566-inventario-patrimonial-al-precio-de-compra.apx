    region inventario-patrimonial-al-precio-de-compra (
        name: Inventario Patrimonial al Precio de Compra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT MC.ID_SUCURSAL, 
                       MC.ID_CENTRO, 
                       MC.ID_DEPARTAMENTO, 
                       MC.ID_SECCION, 
                       MC.ID_RESPONSABLE, 
                       MD.MON_COSTO, 
                       MD.ID_BIEN, 
                       B.DESCRIPCION AS BIEN, 
                       B.ID_TIPO_BIEN,
                       T.DESCRIPCION AS TIPO_BIEN, 
                       MD.MON_COSTO_EXT AS MONTO_EXTRANJERO,
                       MC.FEC_COMPROBANTE
                       FROM  COW_MOV_BIENES_CAB MC, COW_MOV_BIENES_DET MD, COW_BIENES_USO B, COW_TIPOS_BIENES T
                       WHERE MC.ID = MD.ID_MOVBIEN_CAB
                             AND B.ID_TIPO_BIEN = T.ID
                             and B.id_empresa = MD.id_empresa
                             and B.id = MD.id_bien
                             and MD.MON_COSTO = (select max(MD2.MON_COSTO)
                                 from cow_mov_bienes_cab mc2, cow_mov_bienes_det md2, cow_bienes_uso bu2,
                                 cow_tipos_bienes tb2
                                 where mc2.id_empresa = B.id_empresa
                                 and bu2.id = B.id  
                                 and mc2.id_empresa = md2.id_empresa
                                 and mc2.id = md2.id_movbien_cab
                                 and bu2.id_empresa = md2.id_empresa
                                 and bu2.id = md2.id_bien
                                 and bu2.id_tipo_bien = tb2.id)
                             and (MC.ID_SUCURSAL = :P566_SUCURSAL OR :P566_SUCURSAL IS NULL)  
                             and (MC.ID_CENTRO = :P566_CENTRO OR :P566_CENTRO IS NULL)
                             and (MC.ID_DEPARTAMENTO = :P566_DEPARTAMENTO OR :P566_DEPARTAMENTO IS NULL) 
                             AND (MC.ID_SECCION = :P566_SECCION OR :P566_SECCION IS NULL) 
                             AND (B.ID_TIPO_BIEN = :P566_TIPO_BIEN OR :P566_TIPO_BIEN IS NULL)
                             AND (MC.FEC_COMPROBANTE BETWEEN :P566_FEC_INI AND :P566_FEC_FIN)
                             AND MC.TIP_COMPROBANTE = 'INV'
                order by B.ID_TIPO_BIEN
                ```
            pageItemsToSubmit: [
                P566_TIPO_BIEN
                P566_SUCURSAL
                P566_DEPARTAMENTO
                P566_CENTRO
                P566_SECCION
                P566_FEC_INI
                P566_FEC_FIN
            ]
        }
        layout {
            sequence: 20
            parentRegion: @filtros
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
