page 543 (
    name: Lista de tipos de reparaciones
    alias: LISTA-DE-TIPOS-DE-REPARACIONES
    title: Lista de tipos de reparaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region lista-de-tipos-de-reparaciones (
        name: Lista de tipos de reparaciones
        type: interactiveReport
        source {
            location: localDatabase
            tableName: ACW_TIPOS_REPARACION
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 544
                items: {
                    P544_ID: \#ID#\
                    P544_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 83438732244833973
        }

        column COD_TIP_REPARACION (
            type: plainText
            heading {
                heading: "Código "
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Lista de tipos de reparaciones
        }

        savedReport 834439 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_TIP_REPARACION (
                sequence: 3
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 5
            )

            displayColumn DESCRIPCION (
                sequence: 4
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ID_EMPRESA (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @lista-de-tipos-de-reparaciones
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 544
                clearCache: 544
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lista-de-tipos-de-reparaciones
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-tipos-de-reparaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

