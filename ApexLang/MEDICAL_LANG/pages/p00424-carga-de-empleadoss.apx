    region evaluaciones (
        name: Evaluaciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select C.ID,
                       C.ID_PERSONA,
                       C.ID_TIPO_DATO,
                       C.FECHA,
                       C.FECHA_FIN,
                       C.INVERSION_EMP,
                       C.INVERSION_AUT,
                       C.ID_CALIFICACION,
                       C.HORAS,
                       C.OBS,
                       C.ID_PAIS,
                       C.CERTIFICADO,
                       C.NOMBRE_INSTRUCTOR,
                       C.NOMBRE_INSTITUTO,
                       C.REG_VIOLADO,
                       C.COD_VIOLADO,
                       C.DESC_EXTERNA,
                       C.TIPO,
                       C.ID_EMPRESA,
                       C.NRO_MOVIMIENTO,
                       C.COD_USUARIO_AUD
                  from RHW_CAPACITACIONES_SANCIONES C, BSW_PERSONAS P, RHW_EMPLEADOS E
                  WHERE C.ID_EMPRESA = :P0_ID_EMPRESA
                  AND C.ID_PERSONA = P.ID
                  AND E.ID_PERSONA = P.ID 
                  AND E.ID= :P424_ID
                ```
        }
        layout {
            sequence: 100
            parentRegion: @carga-de-empleados
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: eval
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derecho-pagina-3
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 44259657624780753
        }

