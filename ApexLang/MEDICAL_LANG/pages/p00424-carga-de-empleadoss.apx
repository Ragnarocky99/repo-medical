page 424 (
    name: Carga de empleados
    alias: CARGA-DE-EMPLEADOSS
    title: Carga de empleados
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1300
        height: 640
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P424_COD_USUARIO_AUD").readOnly = true;
            document.getElementById("P424_EDAD").readOnly = true;
            document.getElementById("P424_COD_EMPLEADO").readOnly = true;
            document.getElementById("P424_ID_PERSONA").readOnly = true;
            document.getElementById("P424_CATEG_HORA").readOnly = true;
            ```
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 214px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: left;
                border-width: thin;
                border-color: #afa9a9;
            }
            canvas#image-preview{  
            text-align: center;  
            margin-left: 100px;  
            margin-top: 30px;  
            border: 1px solid black; 
             width: 240px !important;
            }
            
            td[headers="Mostrar"] img {   width: 74px; } 
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 370
            parentRegion: @datos-empleados
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
                margin-top-none
                margin-left-none
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-empleados (
        name: Carga de Empleados
        type: form
