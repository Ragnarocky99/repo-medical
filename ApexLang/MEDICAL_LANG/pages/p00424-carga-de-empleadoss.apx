        }
        error {
            errorMessage: Debe ingresar un tipo de documento
            associatedItem: @P424_NRO_CI
        }
    )

    computation p424-cod-empleado (
        itemName: P424_COD_EMPLEADO
        execution {
            sequence: 40
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                   declare
                   v_numero number;
                   
                   begin
                   if :P424_COD_EMPLEADO is null then
                      select nvl( max( TO_NUMBER(COD_EMPLEADO) ), 0 ) + 1
                         into v_numero
                         from RHW_EMPLEADOS
                         where ID_EMPRESA = :P0_COD_EMPRESA ;
                       RETURN v_numero;
                      end if; 
                      RETURN :P424_COD_EMPLEADO;
                   exception
                      when no_data_found then
                        :P424_COD_EMPLEADO  := 1 ;
                        RETURN :P424_COD_EMPLEADO;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Empleados' || sqlerrm ) ;
                   end ;
                ```
        }
    )

    computation p424-cod-persona (
        itemName: P424_COD_PERSONA
