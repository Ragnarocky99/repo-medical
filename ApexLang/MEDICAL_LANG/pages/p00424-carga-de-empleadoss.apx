    process setear-id-persona (
        name: SETEAR ID PERSONA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P424_ID_PERSONA IS NULL THEN 
                :P424_ID_PERSONA:=:P424_ID_1;
                END IF;
                ```
        }
        execution {
            sequence: 120
        }
        advanced {
            executionMappingIdentifier: 49538336213443349
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update-persona (
        name: UPDATE PERSONA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                IF (:P424_ID_PERSONA IS NOT NULL AND :P424_ID IS NULL) OR (:P424_ID IS NOT NULL AND :P424_ID_1 IS NOT NULL) THEN
                        update BSW_PERSONAS  P
                        set P.NOMBRE    = :P424_NOMBRE,
                            P.PRIMER_NOMBRE         = :P424_PRIMER_NOMBRE,
                            P.SEGUNDO_NOMBRE        = :P424_SEGUNDO_NOMBRE,
                            P.PRIMER_APELLIDO       = :P424_PRIMER_APELLIDO,
                            P.SEGUNDO_APELLIDO      = :P424_SEGUNDO_APELLIDO,
                            P.ID_SECTOR        = :P424_ID_SECTOR,
                            P.ID_PROFESION       = :P424_ID_PROFESION,
                            P.ID_NIVEL_ESTUDIOS       = :P424_ID_NIVEL_ESTUDIOS,
                            P.NACIONALIDAD          = :P424_NACIONALIDAD,
                            P.IND_VIVIENDA            = :P424_IND_VIVIENDA,
                            P.DIREC_ELECTRONICA    = :P424_DIREC_ELECTRONICA,
                            P.PAGINA_WEB            = :P424_PAGINA_WEB,
                            P.FEC_NACIMIENTO        = :P424_FEC_NACIMIENTO,
                            P.SEXO                  = :P424_SEXO,
                            P.ID_ESTADO_CIVIL       = :P424_ID_ESTADO_CIVIL,
                            P.RELIGION              = :P424_RELIGION,
                            P.TELEFONO              = :P424_TELEFONO,
                            P.GRUPO_SANGUINEO       = :P424_GRUPO_SANGUINEO_1,
                            P.RECOMENDACION         = :P424_RECOMENDACION,
                            p.direccion             = :P424_DIRECCION,
                            P.ID_PAIS               = :P424_ID_PAIS,
                            P.COD_DEPARTAMENTO      = :P424_COD_DEPARTAMENTO,
                            P.COD_BARRIO            = :P424_COD_BARRIO,
                            P.COD_DISTRITO          = :P424_COD_DISTRITO,
                            P.COD_CUIDAD            = :P424_COD_CUIDAD,
                            P.NRO_CI                = :P424_NRO_CI,
                            P.RUC                   = :P424_RUC
                            where   (P.ID = :P424_ID_PERSONA) OR (P.ID=:P424_ID_1);
                            END IF;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 27074680639896048
        }
        serverSideCondition {
            type: never
        }
    )

)

