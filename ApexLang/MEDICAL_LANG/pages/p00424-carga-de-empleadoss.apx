                begin
                
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                                insert into RHW_FAMILIAS 
                                (ID_EMPLEADO,ID_EMPRESA,ID_TIP_RELACION,NOMBRE,FEC_NACIMIENTO,
                                NIVEL_EDUCACION, OBSERVACION, PAGA, COD_USUARIO_AUD)
