    process evaluaciones-save-interactive-grid-data (
        name: Evaluaciones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @evaluaciones
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                declare 
                v_nro_movimiento number(18);
                V_ID_PERSONA NUMBER(6);
                begin
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                            IF :P424_ID_PERSONA IS NULL THEN
                V_ID_PERSONA:=:P424_ID_1;
                ELSIF :P424_ID_PERSONA IS NOT NULL THEN
                V_ID_PERSONA:=:P424_ID_PERSONA;
                END IF;
                            begin
                	select nvl( max( nro_movimiento ), 0 ) + 1
                	  into v_nro_movimiento
                	  from rhw_capacitaciones_sanciones;
                EXCEPTION
                	WHEN others THEN
                	  :nro_movimiento := 1;
                END;
                
                
                                insert into RHW_CAPACITACIONES_SANCIONES 
                                (ID_PERSONA,ID_EMPRESA,ID_TIPO_DATO, FECHA, ID_CALIFICACION, HORAS,
                                OBS, COD_USUARIO_AUD, NRO_MOVIMIENTO)
                                values(V_ID_PERSONA,:ID_EMPRESA,:ID_TIPO_DATO, :FECHA,
                                :ID_CALIFICACION,:HORAS, :OBS, :APP_USER, v_nro_movimiento);
                            
                            WHEN 'U' then  
                                update RHW_CAPACITACIONES_SANCIONES  d
                                    set  D.ID_TIPO_DATO  = :ID_TIPO_DATO,
                                         D.FECHA  = :FECHA,
                                         D.ID_CALIFICACION  = :ID_CALIFICACION,
                                         D.HORAS    =   :HORAS,
                                         D.OBS       = :OBS
                                         --D.ID_PERSONA = :P424_ID_PERSONA
                                where   d.ID_PERSONA = :P424_ID_1
                                    and d.id = :id;
                
                           when 'D' then
                                delete RHW_CAPACITACIONES_SANCIONES d     
                                WHERE d.ID_PERSONA = :ID_PERSONA
                                           and d.id = :id;  
                    end case;
                                         
                
                END;
                ```
        }
        execution {
            sequence: 160
        }
        advanced {
            executionMappingIdentifier: 27067472781896045
        }
    )

    process historicos-de-entrada-y-salida-save-interactive-grid-data (
        name: Historicos de Entrada y Salida - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @historicos-de-entrada-y-salida
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                    case :APEX$ROW_STATUS
                            when 'C' then
                                insert into RHW_ENTSAL_EMP
                                (ID_EMPLEADO, FEC_INGRESO, FEC_EGRESO, FEC_PRUE_INI, FEC_PRUE_FIN, FEC_CONTRATO, 
                                FEC_SAL_MJT, FEC_ING_IPS, NRO_IPS, ID_MOTIVO_SALIDA, IND_VIGENTE, ID_EMPRESA, DIRECCION_IP,
                                COD_USUARIO_AUD)
                 values(:P424_ID, :FEC_INGRESO, :FEC_EGRESO, :FEC_PRUE_INI, :FEC_PRUE_FIN, :FEC_CONTRATO,
                 :FEC_SAL_MJT, :FEC_ING_IPS, :NRO_IPS, :ID_MOTIVO_SALIDA, :IND_VIGENTE, :ID_EMPRESA, :P424_DIRECCION_IP, :APP_USER);     
                
                
                WHEN 'U' then  
                update RHW_ENTSAL_EMP  E
                set E.FEC_INGRESO    = :FEC_INGRESO,
                E.FEC_EGRESO         = :FEC_EGRESO,
                E.ID_EMPLEADO        = :P424_ID,
                E.ID_MOTIVO_SALIDA   = :ID_MOTIVO_SALIDA,
                E.FEC_PRUE_INI       =   :FEC_PRUE_INI,
                E.FEC_PRUE_FIN        = :FEC_PRUE_FIN,
                E.FEC_CONTRATO       = :FEC_CONTRATO,
                E.DIRECCION_IP       = :P424_DIRECCION_IP,
                E.FEC_SAL_MJT          = :FEC_SAL_MJT,
                E.FEC_ING_IPS            = :FEC_ING_IPS,
                E.NRO_IPS    = :NRO_IPS,
                E.IND_VIGENTE            = :IND_VIGENTE
                                where   E.ID_EMPLEADO = :P424_ID
                                AND E.ID = :ID;
                
                           when 'D' then
                                delete RHW_ENTSAL_EMP E     
                                WHERE E.ID_EMPLEADO = :P424_ID
                                AND E.ID = :ID;
                    end case;
                END;
                ```
        }
        execution {
            sequence: 150
        }
        advanced {
            executionMappingIdentifier: 26909604728895978
        }
    )

