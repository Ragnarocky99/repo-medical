    region historicos-de-entrada-y-salida (
        name: Historicos de Entrada y Salida
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_EMPLEADO,
                       FEC_INGRESO,
                       FEC_EGRESO,
                       FEC_PRUE_INI,
                       FEC_PRUE_FIN,
                       FEC_CONTRATO,
                       FEC_ENV_MJT,
                       FEC_SAL_MJT,
                       FEC_ING_IPS,
                       FEC_SAL_IPS,
                       NRO_IPS,
                       NRO_CONTRATO,
                       IND_VIGENTE,
                       ID_MOTIVO_SALIDA,
                       COD_USUARIO_AUD,
                       MOTIVO_SALIDA,
                       DIRECCION_IP
                  from RHW_ENTSAL_EMP
                  where id_empresa = :P0_ID_EMPRESA
                  AND ID_EMPLEADO = :P424_ID
                ```
        }
        layout {
            sequence: 80
            parentRegion: @horario
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
                margin-top-sm
            ]
        }
