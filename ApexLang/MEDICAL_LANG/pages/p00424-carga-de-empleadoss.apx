    dynamicAction validar-ruc (
        name: VALIDAR RUC
        execution {
            sequence: 240
        }
        when {
            selectionType: items
            items: P424_RUC
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    VPERSONA NUMBER;
                    
                    begin
                    IF :P424_RUC IS NOT NULL THEN
                      SELECT 1
                        INTO VPERSONA
                        FROM BSW_PERSONAS P
                        WHERE P.RUC = :P185_RUC
                        AND ROWNUM=1;
                        IF VPERSONA = 1 THEN
                            RAISE_APPLICATION_ERROR (-20000, 'Este numero de documento ya está asignado a una persona: ' || VPERSONA);
                        END IF;
                    end if ;
                       EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                        NULL;
                    end;
                    ```
                itemsToSubmit: P424_RUC
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

