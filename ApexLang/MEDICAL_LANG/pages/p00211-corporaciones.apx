page 211 (
    name: Corporaciones
    alias: CORPORACIONES
    title: Corporaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region corporaciones (
        name: Corporaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_CORPORACION,
                       NOMBRE,
                       ID_EMPRESA,
                       COD_USUARIO_AUD,
                       LIMITE_CREDITO,
                       ID_MONEDA,
                       ESTADO,
                       CASE ESTADO
                        WHEN 'A' THEN 'fa fa-check u-success-text'
                        WHEN 'I' THEN 'fa fa-remove u-danger-text'
                       END ESTADO_ICON,
                       TIPO_CORP,
                       DIA_CIERRE,
                       DIA_VENC,
                       PORC_BONI,
                       GERENTE,
                       TESORERO,
                       ULTI_IDPG_AMAE,
                       FECHA_VIGENCIA
                  from CCW_CORPORACIONES
                  where ID_EMPRESA = :P0_COD_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 212
                items: {
                    P212_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 27498101383720220
        }

        column COD_CORPORACION (
            type: plainText
            heading {
                heading: Cód. Corporación
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 190
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DIA_CIERRE (
            type: plainText
            heading {
                heading: Día Cierre
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column DIA_VENC (
            type: plainText
            heading {
                heading: Día Vencimiento
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#ESTADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ESTADO_ICON (
            type: plainText
            heading {
                heading: Estado Icon
                alignment: center
            }
            layout {
                sequence: 170
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column FECHA_VIGENCIA (
            type: plainText
            heading {
                heading: Fecha Vigencia
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
        )

        column GERENTE (
            type: plainText
            heading {
                heading: Gerente
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 180
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 200
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column ID_MONEDA (
            type: plainText
            heading {
                heading: Moneda
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column LIMITE_CREDITO (
            type: plainText
            heading {
                heading: Límite Crédito
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column PORC_BONI (
            type: plainText
            heading {
                heading: Porcentaje Bonificación
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column TESORERO (
            type: plainText
            heading {
                heading: Tesorero
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column TIPO_CORP (
            type: plainText
            heading {
                heading: Tipo Corporación
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ULTI_IDPG_AMAE (
            type: plainText
            heading {
                heading: Ulti Idpg Amae
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Corporaciones
        }

        savedReport 275156 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COD_CORPORACION (
                sequence: 1
            )

            displayColumn COD_USUARIO_AUD (
                sequence: 3
            )

            displayColumn DIA_CIERRE (
                sequence: 6
            )

            displayColumn DIA_VENC (
                sequence: 7
            )

            displayColumn ESTADO (
                sequence: 13
            )

            displayColumn FECHA_VIGENCIA (
                sequence: 12
            )

            displayColumn GERENTE (
                sequence: 9
            )

            displayColumn LIMITE_CREDITO (
                sequence: 4
            )

            displayColumn NOMBRE (
                sequence: 2
            )

            displayColumn PORC_BONI (
                sequence: 8
            )

            displayColumn TESORERO (
                sequence: 10
            )

            displayColumn TIPO_CORP (
                sequence: 5
            )

            displayColumn ULTI_IDPG_AMAE (
                sequence: 11
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 10
            region: @corporaciones
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 212
                clearCache: 212
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @corporaciones
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @corporaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

