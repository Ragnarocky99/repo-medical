page 216 (
    name: Carga de Aduanas
    alias: CARGA-DE-ADUANAS
    title: Carga de Aduanas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            .mostrar{
                background-color:#eeeeee;
                width: 219px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-aduanas (
        name: Carga de Aduanas
        type: form
        source {
            location: localDatabase
            tableName: CMW_ADUANAS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P216_COD_ADUANA (
        type: displayOnly
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Aduana: &ensp;</a>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-aduanas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        advanced {
            cssClasses: mostrar
        }
        source {
            formRegion: @carga-de-aduanas
            column: COD_ADUANA
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT nvl(MAX(TO_NUMBER(A.COD_ADUANA)),0)+1
                from CMW_ADUANAS A
                
                ```
        }
    )

    pageItem P216_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-aduanas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-aduanas
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P216_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @carga-de-aduanas
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 15
        }
        source {
            formRegion: @carga-de-aduanas
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P216_ID (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-aduanas
            slot: regionBody
        }
        source {
            formRegion: @carga-de-aduanas
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: CMW_ADUANAS_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P216_ID_CIUDAD (
        type: popupLov
        label {
            label: <p>Ciudad: &ensp;</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @bsw-ciudades-cod-ciudad
        }
        layout {
            sequence: 80
            region: @carga-de-aduanas
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @carga-de-aduanas
            column: ID_CIUDAD
            dataType: number
        }
    )

    pageItem P216_ID_PAIS (
        type: popupLov
        label {
            label: <p>País: &ensp;</p>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @bsw-paises-cod-pais
        }
        layout {
            sequence: 40
            region: @carga-de-aduanas
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @carga-de-aduanas
            column: ID_PAIS
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button ciudad (
        buttonName: CIUDAD
        label: Ciudad
        layout {
            sequence: 90
            region: @carga-de-aduanas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P216_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P216_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button pais (
        buttonName: PAIS
        label: Pais
        layout {
            sequence: 50
            region: @carga-de-aduanas
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--simple
                t-Button--padLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P216_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar (
        name: Refrescar
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @ciudad
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P216_ID_CIUDAD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pais
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P216_ID_PAIS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 27550942229036954
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-aduanas (
        name: Initialize form Carga de Aduanas
        type: formInitialization
        formRegion: @carga-de-aduanas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27550111215036954
        }
    )

    process process-form-carga-de-aduanas (
        name: Process form Carga de Aduanas
        type: formAutoRowProcessing
        formRegion: @carga-de-aduanas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 27550563798036954
        }
    )

)

