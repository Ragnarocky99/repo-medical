page 464 (
    name: Facturas de Compras
    alias: FACTURAS-DE-COMPRAS
    title: Facturas de Compras
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region facturas-de-compras (
        name: Facturas de compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT cm.id,
                       cm.fec_comprobante,
                       cm.tip_comprobante,
                       cm.ser_comprobante,
                       cm.nro_comprobante,
                       cm.referencia,
                       cm.id_proveedor,
                       cm.nom_proveedor,
                       cm.id_condicion_compra,
                       cm.tot_comprobante,
                       cm.id_moneda,
                       CASE cm.estado
                        WHEN 'P' THEN 'Pendiente'
                        WHEN 'C' THEN 'Confirmado'
                        ELSE '-'
                       END estado,
                       cm.asientos,
                       dc.id asiento_id,
                       '' as link,
                       cm.id_proveedor_ref,
                       cm.tip_comprobante_ref,
                       cm.ser_comprobante_ref,
                       cm.nro_comprobante_ref,
                       cm.fec_estado,
                       cm.observacion,
                       cm.cod_usuario_aud,
                       cm.fec_alta
                 FROM  cmw_compras_cabecera cm
                 JOIN  cow_ejercicios       ej
                       ON ej.cod_ejercicio = to_char(cm.fec_comprobante, 'yyyy')
                 LEFT JOIN cow_diario_cabeceras_prov dc
                        ON dc.num_asiento  = cm.asientos
                       AND dc.id_ejercicio = ej.id
                WHERE  cm.id_empresa   = :P0_ID_EMPRESA
                  AND cm.id_sucursal = :P0_ID_SUCURSAL
                  AND cm.fec_comprobante BETWEEN :P464_FEC_INI AND :P464_FEC_FIN
                  AND (cm.id_proveedor = :P464_PROVEEDOR OR :P464_PROVEEDOR IS NULL)
                ORDER BY cm.fec_comprobante DESC,
                         cm.nro_comprobante DESC
                ```
            pageItemsToSubmit: [
                P464_FEC_INI
                P464_FEC_FIN
                P464_PROVEEDOR
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 155
                items: {
                    P155_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 58952586952321809
        }

