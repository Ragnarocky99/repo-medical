        behavior {
            action: redirectThisApp
            target: {
                page: 155
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refrescar
        layout {
            sequence: 10
            region: @filtros
            slot: help
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: triggerAction
        }

        triggerAction refrescar-reporte (
            name: Refrescar Reporte
            action: refresh
            affectedElements {
                selectionType: region
                region: @facturas-de-compras
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction agregar-paginacion (
        name: Agregar paginacion
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            affectedElements {
                selectionType: region
                region: @facturas-de-compras
            }
            execution {
                sequence: 10
            }
        )

    )

)

