        column ID_REMISION (
            type: selectList
            heading {
                heading: <p>Remision</p>
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT SER_ENT_SAL||'-'||LPAD(NUM_ENT_SAL, 7, '0') D, EC.ID R
                      FROM STW_ENTSAL_CAB           EC
                      JOIN VTW_COMPROBANTES_DETALLE VD ON VD.ID_COMPROBANTE_CABECERA = :P161_ID_COMPROBANTE_REF
                     WHERE EC.ID_EMPRESA = :P0_ID_EMPRESA
                       AND EC.ID         = VD.ID_REMISION
                    GROUP BY SER_ENT_SAL, NUM_ENT_SAL, EC.ID
                    ```
            }
            cascadingLov {
                parentColumns: P161_ID_COMPROBANTE_REF
                itemsToSubmit: P161_ID_COMPROBANTE_REF
            }
            layout {
                sequence: 500
                columnAlignment: center
            }
            source {
                databaseColumn: ID_REMISION
                dataType: number
            }
        )

