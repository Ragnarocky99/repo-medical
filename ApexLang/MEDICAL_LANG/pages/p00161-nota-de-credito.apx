    region limite-de-credito (
        name: Limite de Credito
        type: staticContent
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
                t-Form--noPadding
            ]
            cssClasses: u-normal-border
        }
        serverSideCondition {
            type: never
        }
    )

    region nota-de-credito (
        name: Nota de Credito
        type: form
        source {
            location: localDatabase
            tableName: VTW_COMPROBANTES_CABECERA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
            ]
        }
        advanced {
            htmlDomId: Contenedor
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region totales (
        name: Totales
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
    )

