    process insertar-detalle-nota-de-credito (
        name: Insertar Detalle Nota de Credito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_COMPROBANTES_DETALLE
                    WHERE :P161_ID_COMPROBANTE_REF=ID_COMPROBANTE_CABECERA;
                    item_detalle VTW_COMPROBANTES_DETALLE%rowtype;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                                insert into VTW_COMPROBANTES_DETALLE 
                                (ID_ARTICULO,ID_COMPROBANTE_CABECERA,CANTIDAD,ID_IVA,TOTAL_IVA,MONTO_TOTAL_C_IVA,
                                PRECIO_UNITARIO_C_IVA,NUM_ORDEN,PRECIO_UNITARIO,ID_UNIDAD_MEDIDA,COD_USUARIO_AUD,MONTO_TOTAL,IVA,PORC_DESCUENTO
                                ,ID_LOTE,NRO_LOTE,DESCUENTO_C_IVA,DESCUENTO)
                                values(item_detalle.id_articulo,:P161_ID,item_detalle.cantidad,item_detalle.id_iva,item_detalle.total_iva,
                                item_detalle.monto_total_c_iva,item_detalle.precio_unitario_c_iva,item_detalle.num_orden,
                                item_detalle.precio_unitario,item_detalle.id_unidad_medida,:APP_USER,
                                item_detalle.monto_total,item_detalle.iva,item_detalle.porc_descuento,
                                item_detalle.id_lote,item_detalle.nro_lote,item_detalle.descuento_c_iva,item_detalle.descuento);
                  END LOOP;
                  CLOSE cursor_detalle;
                  EXCEPTION WHEN OTHERS THEN
                 RAISE_APPLICATION_ERROR(-20000,'No se pudo guardar el detalle'||SQLERRM);
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 36398678327485946
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

