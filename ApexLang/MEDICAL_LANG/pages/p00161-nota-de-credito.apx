        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_COMPROBANTE_CABECERA,
                       D.ID_EMPRESA,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.CANTIDAD_REFERENCIA,
                       D.PRECIO_UNITARIO,
                       D.PRECIO_LISTA,
                       D.DESCUENTO,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.COSTO_PROMEDIO,
                       D.COSTO_PROMEDIO_REF,
                       D.COSTO_CON,
                       D.NUM_ORDEN,
                       D.ID_MECANICO,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.PORC_DESCUENTO,
                       D.IVA,
                       D.ID_PEDIDO_DETALLE,
                       D.ID_COMPROBANTE_DETALLE_REF,
                       D.PORC_DESC_ESP,
                       D.MONTO_DESC_ESPECIAL,
                       D.ID_LOTE,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PRECIO_LISTA_C_IVA,
                       D.MONTO_TOTAL_C_IVA,
                       D.DESCUENTO_C_IVA,
                       D.IND_MUEVE_STOCK,
                       D.CANTIDAD_ENTREGADA,
                       D.CANTIDAD_REMISIONADA,
                       D.ID_PROMO_CAB_GRUPO,
                       D.ID_IVA,
                       D.PORC_GRAVADA,
                       D.IND_PROMO,
                       D.CANTIDAD_RESGUARDADA,
                       D.DESC_ARTICULO DESCRIPCION,
                       D.ID_BARRA,
                       D.ID_PEDIDO,
                       D.TIP_COMPROBANTE,
                       D.ID_COTIZA_ART,
                       d.ID_REMISION,
                       D.ID_REMISION_DET,
                       D.ID_LICITACION_DET
                  from VTW_COMPROBANTES_DETALLE D,STW_ARTICULOS A
                 where ID_COMPROBANTE_CABECERA=:P161_ID
                 and d.id_articulo=a.id
                 
                
                ```
