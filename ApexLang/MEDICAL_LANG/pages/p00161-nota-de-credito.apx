    pageItem P161_LINEAS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            slot: body
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT LINEAS FROM  
                BSW_TIPOS_COMPROBANTES 
                WHERE TIP_COMPROBANTE=W_BUSCA_PARAMETRO('VT','TIPO_NOTACRE')
                AND ID_EMPRESA=:P0_COD_EMPRESA
                AND ID_MODULO=(SELECT ID FROM BSW_MODULOS
                WHERE COD_MODULO='VT')
                ```
        }
    )

