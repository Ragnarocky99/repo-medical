                    FROM BSW_PERSONAS P,CCW_CLIENTES C
                    WHERE C.ID=:P161_ID_CLIENTE
                    AND P.ID=C.ID_PERSONA
                    ```
                itemsToSubmit: P161_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P161_TELEFONO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            comments {
                comments: Setea Telefono
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT CASE 
                    WHEN P.RUC IS NOT NULL THEN P.RUC 
                    WHEN P.RUC IS NULL THEN TO_CHAR(P.NRO_CI)
                    WHEN P.RUC IS NULL AND P.NRO_CI IS NULL THEN NULL
                    END 
                    AS DOCUMENTO
                    FROM BSW_PERSONAS P,CCW_CLIENTES C
                    WHERE P.ID=C.ID_PERSONA
                    AND C.ID=:P161_ID_CLIENTE
