    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var orden = 0;
            // Funcion  para calcular los totales de la factura cada vez que se ingresa un detalle 
            function recalculaImporte(){
                var model = apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
            
                // Función auxiliar para convertir valores a número
                function toNumber(val) {
                    if (val === null || val === undefined || val === "") return 0;
                    return Number(val.toString().replace(/\./g,'').replace(',', '.')) || 0;
                }
            
                var v_importe   = model.getFieldKey("MONTO_TOTAL_C_IVA");
                var v_iva       = model.getFieldKey("TOTAL_IVA");
                var v_porc_iva  = model.getFieldKey("PORC_IVA");
                var v_total_s_iva = model.getFieldKey("MONTO_TOTAL");
                var v_descuento_c_iva = model.getFieldKey("DESCUENTO_C_IVA");
            
                var v_total = 0, v_total_iva = 0, v_total_descuento = 0;
                var v_total_gravadas_10 = 0, v_total_gravadas_5 = 0, v_total_exentas = 0;
                var v_subtotal = 0, v_iva_10 = 0, v_iva_5 = 0;
            
                model.forEach(function(r, index, id) {
                    var meta = model.getRecordMetadata(id);
                    if (meta.fields !== undefined && !meta.deleted) {
                        var porcIva = toNumber(r[v_porc_iva]);
                        var totalSinIva = toNumber(r[v_total_s_iva]);
                        var importe = toNumber(r[v_importe]);
                        var iva = toNumber(r[v_iva]);
                        var descConIva = toNumber(r[v_descuento_c_iva]);
            
                        if (porcIva === 10) {
                            v_total_gravadas_10 += totalSinIva;
                            v_iva_10 += iva;
                        } else if (porcIva === 5) {
                            v_total_gravadas_5 += totalSinIva;
                            v_iva_5 += iva;
                        } else {
                            v_total_exentas += totalSinIva;
                        }
            
                        v_total += importe;
                        v_total_iva += iva;
            
                        // descuento neto = descuento con IVA - parte del IVA incluido
                        v_total_descuento += descConIva - (descConIva * porcIva / (100 + porcIva));
                    }
                });
            
                v_subtotal = v_total - v_total_iva;
            
                // Actualizar items de la página
                $s('P161_TOT_COMPROBANTE', v_total.toString().replace('.', ','));
                $s('P161_TOT_GRAVADAS_10', v_total_gravadas_10.toString().replace('.', ','));
                $s('P161_TOT_GRAVADAS_5', v_total_gravadas_5.toString().replace('.', ','));
                $s('P161_TOT_EXENTAS', v_total_exentas.toString().replace('.', ','));
                $s('P161_TOT_IVA', v_total_iva.toString().replace('.', ','));
                $s('P161_SUBTOTAL', v_subtotal.toString().replace('.', ','));
                $s('P161_IVA_10', v_iva_10.toString().replace('.', ','));
                $s('P161_IVA_5', v_iva_5.toString().replace('.', ','));
                // Si querés mostrar el descuento total:
                // $s('P161_TOT_DESCUENTO_DET', Math.round(v_total_descuento));
            }
            ```
