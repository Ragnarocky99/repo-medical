                comments: Setea la sigla de las monedas del limite de credito
            }
        )

    )

    dynamicAction cargar-datos-de-factura (
        name: Cargar datos de Factura
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: [
                P161_TIP_COMPROBANTE_REF
                P161_SER_COMPROBANTE_REF
                P161_NRO_COMPROBANTE_REF
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_contador number(18);
                    BEGIN
                    IF :P161_TIP_COMPROBANTE_REF IS NOT NULL  AND :P161_SER_COMPROBANTE_REF IS NOT NULL AND :P161_NRO_COMPROBANTE_REF IS NOT NULL THEN 
                    SELECT ID/*ID_CLIENTE*/,ID_VENDEDOR,ID_CONDICION_VENTA,ID_MONEDA,DIRECCION,TELEFONO,NOM_CLIENTE,RUC_CLIENTE,ID_LISTA_PRECIO,TOT_COMPROBANTE,TOT_EXENTAS,TOT_IVA
                    INTO :P161_ID_COMPROBANTE_REF/*:P161_ID_CLIENTE*/,:P161_ID_VENDEDOR,:P161_ID_CONDICION_VENTA,:P161_ID_MONEDA,:P161_DIRECCION,:P161_TELEFONO,
                    :P161_NOM_CLIENTE,:P161_RUC_CLIENTE,
                    :P161_ID_LISTA_PRECIO,:P161_TOT_COMPROBANTE,:P161_TOT_EXENTAS,:P161_TOT_IVA
                    FROM 
                    VTW_COMPROBANTES_CABECERA 
                    WHERE 
                    TIP_COMPROBANTE=:P161_TIP_COMPROBANTE_REF AND
                    NRO_COMPROBANTE =:P161_NRO_COMPROBANTE_REF AND
                    SER_COMPROBANTE=:P161_SER_COMPROBANTE_REF AND 
                    (ID_CLIENTE=:P161_ID_CLIENTE OR :P161_ID_CLIENTE IS NULL);
                    /*SELECT count(*) 
                    into v_contador
                    from vtw_comprobantes_cabecera where
                    ID_COMPROBANTE_REF=:P161_ID_COMPROBANTE_REF;
                    IF v_contador>0 then
                    raise_application_error(-20000,'Esta factura ya cuenta con nota de credito');
                    end if;*/
                    ELSE
                    :P161_ID_MONEDA:=W_BUSCA_PARAMETRO('BS','COD_MONEDA_GS');
                    END IF;
                    
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                        raise_application_error(-20000,'No se encontro el comprobante');
                        null;
                    WHEN OTHERS THEN
                        raise_application_error(-20000,'Error '||sqlerrm);
                        NULL;
                    END;
                    
                    
                    ```
                itemsToSubmit: [
                    P161_TIP_COMPROBANTE_REF
                    P161_SER_COMPROBANTE_REF
                    P161_NRO_COMPROBANTE_REF
                    P161_ID_CLIENTE
                ]
                itemsToReturn: [
                    P161_ID_VENDEDOR
                    P161_ID_CONDICION_VENTA
                    P161_ID_MONEDA
                    P161_DIRECCION
                    P161_TELEFONO
                    P161_NOM_CLIENTE
                    P161_RUC_CLIENTE
                    P161_ID_LISTA_PRECIO
                    P161_TIP_CAMBIO
                    P161_ID_COMPROBANTE_REF
                    P161_TOT_COMPROBANTE
                    P161_TOT_EXENTAS
                    P161_TOT_IVA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                        SELECT e.ID_ARTICULO AS "ID_ARTICULO",
                               e.CANTIDAD AS "CANTIDAD",
                               e.PRECIO_UNITARIO AS "PRECIO_UNITARIO",
                               A.COD_ARTICULO AS "COD_ARTICULO",
                               E.DESCUENTO,
                               E.MONTO_TOTAL,
                               E.TOTAL_IVA,
                               E.NUM_ORDEN,
                               E.CANTIDAD_UB,
                               E.ID_UNIDAD_MEDIDA,
                               E.NRO_LOTE,
                               E.IVA,
                               E.ID_LOTE,
                               E.PRECIO_UNITARIO_C_IVA,
                               E.DESCUENTO_C_IVA,
                               E.IND_MUEVE_STOCK,
                               E.ID_IVA,
                               E.MONTO_TOTAL_C_IVA,
                               E.DESC_ARTICULO,
                               E.ID_PEDIDO,
                               E.ID_PEDIDO_DETALLE,
                               E.ID_COTIZA_ART,
                               e.id_remision as id_remision,
                               E.ID AS ID_COMPROBANTE_DETALLE_REF,
                               E.ID_REMISION_DET,
                               E.ID_LICITACION_DET
                        FROM   VTW_COMPROBANTES_DETALLE E,STW_ARTICULOS A
                        WHERE  ID_COMPROBANTE_CABECERA=:P161_ID_COMPROBANTE_REF
                        AND E.ID_ARTICULO=A.ID;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P161_JSON_DETALLES:=JSON_DETALLE;
                    
                    
                      EXCEPTION 
                      WHEN OTHERS THEN 
                      RAISE_APPLICATION_ERROR(-20000,'Error al recuperar el detalle');
                    
                    END;
                    ```
                itemsToSubmit: P161_ID_COMPROBANTE_REF
                itemsToReturn: P161_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearChanges();
                    
                    
                    
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                      var T = $v("P161_JSON_DETALLES"), J, intento = 0, maxIntentos = 20;
                      var orden = 0;
                    
                      if(!T){ console.warn("P161_JSON_DETALLES vacío. No se carga nada."); return; }
                      try{ J = JSON.parse(T); }
                      catch(e){ console.error("JSON inválido:",e); apex.message.alert("El JSON de detalles no es válido."); return; }
                    
                      function txt(v){ return v===null||v===undefined?"":v.toString(); }
                      function dec(v){ return v===null||v===undefined?"":v.toString().replace(/\./g,","); }
                      function tieneDatos(o){ return o && Object.keys(o).some(k => o[k]!==null && o[k]!==undefined && o[k]!=="" ); }
                      function setCol(model,rec,col,val){
                        if(val===null||val===undefined||val===""){ return; }
                        try{ model.setValue(rec,col,val.toString()); }
                        catch(e){ console.error("Error en columna:",col,"Valor:",val,e);
                          apex.message.alert("Error al cargar la columna "+col+". Verificá si está Read Only, Display Only o Query Only en el IG Detalles.");
                          throw e;
                        }
                      }
                    
                      function esperarIG(){
                        var ig$ = apex.region("Detalles").widget();
                        var grid = ig$.interactiveGrid("getCurrentView");
                        grid.setEditMode(true);
                        var model = grid.model;
                        console.log("Intento:",intento,"allowAdd:",model.allowAdd(),"canAdd:",model.check("canAdd"));
                        if(model.allowAdd() && model.check("canAdd")){ cargarDetalles(model); return; }
                        intento++;
                        if(intento<maxIntentos){ setTimeout(esperarIG,300); return; }
                        apex.message.alert("El grid Detalles no permite agregar filas todavía. Revisá si el código se ejecuta antes del refresh del IG o si alguna configuración bloquea Add Row.");
                      }
                    
                      function cargarDetalles(model){
                        try{
                          if(!J || !Array.isArray(J.DETALLE) || J.DETALLE.length===0){ console.log("No hay detalles para cargar."); return; }
                          var filas = J.DETALLE.filter(tieneDatos);
                          if(filas.length===0){ console.log("El JSON no tiene filas con datos."); return; }
                    
                          for(let i=0;i<filas.length;i++){
                            var d = filas[i];
                            if(!model.allowAdd() || !model.check("canAdd")){ throw new Error("El modelo dejó de permitir insertar en la línea "+(i+1)); }
                            var rec = model.getRecord(model.insertNewRecord());
                            orden++;
                    
                            setCol(model,rec,"ID_ARTICULO",txt(d.ID_ARTICULO));
                            setCol(model,rec,"CANTIDAD",txt(d.CANTIDAD));
                            setCol(model,rec,"CANTIDAD_UB",txt(d.CANTIDAD_UB));
                            setCol(model,rec,"DESCUENTO",txt(d.DESCUENTO));
                            setCol(model,rec,"DESCUENTO_C_IVA",txt(d.DESCUENTO_C_IVA));
                            setCol(model,rec,"ID_IVA",txt(d.ID_IVA));
                            setCol(model,rec,"ID_LOTE",txt(d.ID_LOTE));
                            setCol(model,rec,"ID_UNIDAD_MEDIDA",txt(d.ID_UNIDAD_MEDIDA));
                            setCol(model,rec,"IND_MUEVE_STOCK",txt(d.IND_MUEVE_STOCK));
                            setCol(model,rec,"MONTO_TOTAL",dec(d.MONTO_TOTAL));
                            setCol(model,rec,"NRO_LOTE",txt(d.NRO_LOTE));
                            setCol(model,rec,"PRECIO_UNITARIO",dec(d.PRECIO_UNITARIO));
                            setCol(model,rec,"PRECIO_UNITARIO_C_IVA",dec(d.PRECIO_UNITARIO_C_IVA));
                            setCol(model,rec,"TOTAL_IVA",dec(d.TOTAL_IVA));
                            setCol(model,rec,"MONTO_TOTAL_C_IVA",dec(d.MONTO_TOTAL_C_IVA));
                            setCol(model,rec,"PORC_IVA",txt(d.IVA));
                            setCol(model,rec,"NUM_ORDEN",txt(d.NUM_ORDEN));
                            setCol(model,rec,"DESCRIPCION",txt(d.DESC_ARTICULO));
                            setCol(model,rec,"COD_ARTICULO",txt(d.COD_ARTICULO));
                            setCol(model,rec,"ID_PEDIDO",txt(d.ID_PEDIDO));
                            setCol(model,rec,"ID_PEDIDO_DETALLE",txt(d.ID_PEDIDO_DETALLE));
                            setCol(model,rec,"ID_COTIZA_ART",txt(d.ID_COTIZA_ART));
                            setCol(model,rec,"ID_COMPROBANTE_DETALLE_REF",txt(d.ID_COMPROBANTE_DETALLE_REF));
                            setCol(model,rec,"ID_REMISION",txt(d.ID_REMISION));
                            setCol(model,rec,"ID_REMISION_DET",txt(d.ID_REMISION_DET));
                            setCol(model,rec,"ID_LICITACION_DET",txt(d.ID_LICITACION_DET));
                          }
                    
                        }catch(e){ console.error("Error cargando detalles:",e); }
                      }
                      setTimeout(esperarIG,300);
                      setTimeout(recalculaImporte(),300);
                    })();
                    
                    ```
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

