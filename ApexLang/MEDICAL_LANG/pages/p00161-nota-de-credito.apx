    dynamicAction cargar-datos-de-cliente (
        name: Cargar Datos de Cliente
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P161_ID_CLIENTE
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Al cargar el cliente se cargan todos sus datos correspondientes en el la cabecera de la factura "
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    grid.view$.grid("option", "editable", true);
                    grid.model.setOption("editable", true);
                    ```
            }
            execution {
                sequence: 120
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DIRECCION
                    FROM BSW_PERSONAS P,CCW_CLIENTES C
                    WHERE C.ID=:P161_ID_CLIENTE
                    AND P.ID=C.ID_PERSONA
                    ```
                itemsToSubmit: P161_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P161_DIRECCION
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            comments {
                comments:
                    ```
                    Setea Dirección
                    
                    ```
            }
        )

        action native-set-value-10 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(SUM(SALDO_CUOTA),0) FROM CCW_SALDOS 
                    WHERE ID_CLIENTE=:P161_ID_CLIENTE
                    AND ID_EMPRESA=:P0_COD_EMPRESA
                    AND SALDO_CUOTA<>0
                    ```
                itemsToSubmit: P161_ID_CLIENTE
            }
            affectedElements {
                selectionType: items
                items: P161_SALDO
            }
            execution {
                sequence: 100
            }
            comments {
                comments: Setea el saldo del cliente
            }
        )

        action native-set-value-11 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: replace(:P161_LIMITE_CREDITO,'.','')-replace(:P161_SALDO,'.','')
                itemsToSubmit: [
                    P161_LIMITE_CREDITO
                    P161_SALDO
