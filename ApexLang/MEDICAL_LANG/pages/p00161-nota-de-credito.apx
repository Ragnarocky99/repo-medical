    dynamicAction setear-precios-y-lote (
        name: Setear Precios y Lote
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_ARTICULO
        }
        comments {
            comments: "Al seleccionar un producto setea su precio y lote correspondiente si es que tienen "
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    if :PRECIO_UNITARIO_C_IVA is null then
                         :PRECIO_UNITARIO_C_IVA :=0;
                    end if;
                    if :IVA IS NULL THEN
                    :IVA:=0;
                    END IF;
                    
                    
                    BEGIN 
                     SELECT 1,/*I.ID,I.PORC_IVA_VENTA,*/P.PRECIO_FIJO,A.ID_UNIDAD_MEDIDA
                        INTO :CANTIDAD,/*:ID_IVA,:PORC_IVA,*/:PRECIO_UNITARIO_C_IVA,:ID_UNIDAD_MEDIDA
                         FROM /*STW_IVA I,*/STW_ARTICULOS A,VTW_PRECIOS_FIJOS P
                         WHERE A.ID=P.ID_ARTICULO
                         AND A.ID_EMPRESA=:P0_COD_EMPRESA
                         AND P.ID_EMPRESA=:P0_COD_EMPRESA
                         AND NVL(P.ACTIVO,'X')='S'
                         AND P.ID_PRECIO=:P161_ID_LISTA_PRECIO
                         AND A.ID=:ID_ARTICULO
                       --  AND A.ID_IVA=I.ID
                         AND P.fec_vigencia   <=:P161_FEC_COMPROBANTE 
                            		      and P.fec_vigencia    = ( select max(fec_vigencia)
                            		                                 from vtw_precios_fijos
                            		                                 where ID_empresa     = :P0_COD_EMPRESA
                            		                                   and ID_articulo    = :ID_ARTICULO
                            		                                   and ID_PRECIO= :P161_ID_LISTA_PRECIO
                            		                                   and fec_vigencia   <= :P161_FEC_COMPROBANTE);
                    
                    
                    
                    
                    
                    
                         
                       
                          
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    BEGIN
                    /*SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;*/
                    
                    SELECT 1
                    INTO :CANTIDAD 
                    FROM DUAL;
                    
                    
                      EXCEPTION 
                      WHEN NO_DATA_FOUND THEN
                      RAISE_APPLICATION_ERROR(20999,'Error al cargar el precio del articulo'||sqlerrm);
                    END;
                    WHEN OTHERS THEN
                      RAISE_APPLICATION_ERROR(20999,'Error  al cargar los datos del articulo '||sqlerrm);
                    
                        
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P161_ID_LISTA_PRECIO
                    P161_FEC_COMPROBANTE
                ]
                itemsToReturn: [
                    PRECIO_UNITARIO_C_IVA
                    ID_IVA
                    IVA
                    PORC_IVA
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_maneja_lote varchar(1);
                    BEGIN
                    SELECT NVL(IND_MANEJA_LOTE,'X')
                    into v_maneja_lote
                    from stw_articulos 
                    where id=:id_articulo ;
                    
                    IF V_MANEJA_LOTE='S' THEN
                    SELECT L.ID,L.ID_IVA,I.PORC_IVA_VENTA,MAX(L.NRO_LOTE)
                    INTO :ID_LOTE,:ID_IVA,:PORC_IVA,:NRO_LOTE
                    FROM STW_LOTES L,STW_IVA I
                    WHERE L.ID_ARTICULO=:ID_ARTICULO
                    AND  L.ID_IVA=I.ID
                    AND FEC_VENCIMIENTO>=SYSDATE
                    GROUP BY L.ID,L.ID_IVA,I.PORC_IVA_VENTA;
                    ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;
                    END IF;
                    EXCEPTION WHEN
                    NO_DATA_FOUND THEN
                    NULL;
                    END;
                    
                    ```
                itemsToSubmit: ID_ARTICULO
                itemsToReturn: [
                    ID_LOTE
                    ID_IVA
                    PORC_IVA
                    NRO_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    grid.gotoCell(array[0][0],'COD_ARTICULO');
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P161_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM 
                    STW_ARTICULOS WHERE
                    ID=:ID_ARTICULO 
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: DESCRIPCION
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COD_ARTICULO FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
                escapeSpecialChars: false
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: columns
                columns: COD_ARTICULO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                value: 0
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P161_BANDERA
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

    )

    validation validar-articulo (
        name: Validar Articulo
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @detalles
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if :cod_articulo is not null then
                return true;
                else
                return false;
                end if;
                ```
        }
        error {
            errorMessage: Debe cargar un Articulo
        }
    )

    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('VT','ID_MODULO_VT'),:P161_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                    RETURN TRUE;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha Fuera de Rango
            associatedItem: @P161_FEC_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-lineas (
        name: Validar Lineas
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P161_CANTIDAD_DET<=:P161_LINEAS
        }
        error {
            errorMessage: "El comprobante no puede tener mayor a  &P161_LINEAS. lineas ! "
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-remision (
        name: Validar remision
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @detalles
            type: columnIsNotNull
            column: ID_REMISION
        }
        error {
            errorMessage: No se guardó la referencia de la remision. Vuelta a cargar los datos de la factura por favor
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    VTIENE_REMISION VARCHAR2(1);
                BEGIN
                    BEGIN
                        SELECT DISTINCT('S')
                          INTO VTIENE_REMISION
                          FROM VTW_COMPROBANTES_DETALLE VD
                         WHERE VD.ID_COMPROBANTE_CABECERA = :P161_ID_COMPROBANTE_REF
                           AND VD.ID_REMISION IS NOT NULL
                           AND ROWNUM = 1;
                    EXCEPTION
                        WHEN OTHERS THEN
                            VTIENE_REMISION := 'N';
                    END;
                
                    IF VTIENE_REMISION = 'S' THEN
                        RETURN TRUE;
                    END IF;
                
                    RETURN FALSE;
                END;
                ```
        }
    )

    computation p161-gravadas (
        itemName: P161_GRAVADAS_5
        execution {
            sequence: 100
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: NVL(REPLACE(:P161_TOT_GRAVADAS_5,'.',''),0)+NVL(REPLACE(:P161_IVA_5,'.',''),0)
        }
    )

    computation p161-gravadas-2 (
        itemName: P161_GRAVADAS_10
        execution {
            sequence: 100
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: NVL(REPLACE(:P161_TOT_GRAVADAS_10,'.',''),0)+NVL(REPLACE(:P161_IVA_10,'.',''),0)
        }
    )

    computation p161-gravadas-3 (
        itemName: P161_GRAVADAS_10
        execution {
            sequence: 40
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM VTW_COMPROBANTES_DETALLE
                    WHERE :P161_ID=ID_COMPROBANTE_CABECERA;
                    item_detalle VTW_COMPROBANTES_DETALLE%rowtype;
                    v_total_gravadas_10    VTW_COMPROBANTES_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_gravadas_10:=v_total_gravadas_10+item_detalle.monto_total;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_gravadas_10;
                  EXCEPTION WHEN 
                  OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P161_ID
        }
    )

    computation p161-id-ncr (
        itemName: P161_ID_NCR
        execution {
            sequence: 90
        }
        computation {
            type: expression
            plsqlExpression: :P161_ID
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P161_ID
        }
    )

    computation p161-id-serie-comp (
        itemName: P161_ID_SERIE_COMP
        execution {
            sequence: 120
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    v_ser varchar2(7);
                    V_IP_MAQUINA VARCHAR2(200);
                BEGIN
                    SELECT owa_util.get_cgi_env('REMOTE_ADDR')  INTO V_IP_MAQUINA FROM DUAL;
                    select ID
                        INTO v_ser
                    from BSW_SERIES_COMPROB t 
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA 
                      AND ID_SUCURSAL=:P0_COD_SUCURSAL 
                      AND TIP_COMPROBANTE=W_BUSCA_PARAMETRO(NULL,'TIPO_NOTACRE')
                      AND IND_ACTIVO='S'
                      AND SER_COMPROBANTE = :P161_SER_COMPROBANTE;
                    RETURN v_ser;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            return null;
                        WHEN OTHERS THEN
                            RETURN null; 
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P161_ID_SERIE_COMP
        }
    )

