        column ID_LOTE (
            type: selectList
            heading {
                heading: <p>Lote</p>
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NRO_LOTE,ID FROM STW_LOTES
                    WHERE ID_ARTICULO=:ID_ARTICULO
                    AND ID_EMPRESA=:P0_ID_EMPRESA
                    ```
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: ID_ARTICULO
            }
            layout {
                sequence: 420
            }
            validation {
                valueRequired: true
            }
