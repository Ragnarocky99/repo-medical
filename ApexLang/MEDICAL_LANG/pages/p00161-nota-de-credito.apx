            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P161_ID IS NOT NULL AND
                NVL(:P161_ESTADO_FE, 'P') != 'A'
                ```
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button movcaja (
        buttonName: MovCaja
        label: Caja
        layout {
            sequence: 20
            region: @nota-de-credito
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-money
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_ID_CLIENTE: &P161_ID_CLIENTE.
                    P75_ID_MONEDA: &P161_ID_MONEDA.
                    P75_ID_COMPROBANTE: &P161_ID.
                    P75_ID: &P161_ID_MOV_CAJ.
                    P75_SER_COMPROBANTE: &P161_SER_COMPROBANTE.
                    P75_TIP_COMPROBANTE: &P161_TIP_COMPROBANTE.
                    P75_IMPORTE: &P161_TOT_COMPROBANTE.
                    P75_MONEDA: &P161_ID_MONEDA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                v_id_comprobante  BSW_SERIES_COMPROBANTES.ID%TYPE;
                v_ind_caja  varchar2(1);
                BEGIN
                SELECT ID
                INTO v_id_comprobante
                 FROM 
                BSW_SERIES_COMPROB
                WHERE 
                SER_COMPROBANTE=:P161_SER_COMPROBANTE
                AND TIP_COMPROBANTE=:P161_TIP_COMPROBANTE; 
                
                SELECT IND_MOV_CAJA
                INTO v_ind_caja
                FROM BSW_SERIES_COMPROB
                WHERE ID=V_ID_COMPROBANTE;
                
                if v_ind_caja='S' AND :P161_ID IS NOT NULL  AND :P161_ID_CONDICION_VENTA=W_BUSCA_PARAMETRO('CC','CONDICION_CONTADO') THEN
                RETURN TRUE;
                ELSE 
                RETURN FALSE;
                END IF;
                EXCEPTION 
                WHEN OTHERS THEN
                NULL;
                END;
                ```
        }
    )

