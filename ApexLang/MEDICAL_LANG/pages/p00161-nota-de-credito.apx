    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 140
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P161_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-montos (
        name: CALCULAR_MONTOS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
                PORC_DESCUENTO
            ]
        }
        comments {
            comments: Aqui se van calculando los totales correspondientes  (Monto total con iva , monto total , total iva ,descuentos)
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :PORC_DESCUENTO IS NULL THEN
                    :PORC_DESCUENTO:=0 ;
                    END IF;
                    
                    :DESCUENTO_C_IVA:=REPLACE(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_DESCUENTO/100);
                    
                    ```
                itemsToSubmit: [
                    PORC_DESCUENTO
                    PRECIO_UNITARIO_C_IVA
                ]
                itemsToReturn: DESCUENTO_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :CANTIDAD is null then
                         :CANTIDAD := 1;
                    end if;
                    
                    if :PRECIO_UNITARIO_C_IVA is null THEN
                        :PRECIO_UNITARIO_C_IVA    := 0;
                        :TOTAL_IVA := 0;
                        END IF;
                    
                        IF :DESCUENTO_C_IVA IS NULL THEN
                        :DESCUENTO_C_IVA:=0;
                    end if;
                    
                    
                    :MONTO_TOTAL_C_IVA := replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0));
                    IF :DESCUENTO_C_IVA IS NOT NULL AND :DESCUENTO_C_IVA!=0 THEN 
                    :P161_DESCUENTO_V:=replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0);
                    END IF;
                    --:MONTO_TOTAL_C_IVA:=:CANTIDAD * :PRECIO_UNITARIO_C_IVA;
                    
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    CANTIDAD
                    DESCUENTO_C_IVA
                ]
                itemsToReturn: [
                    MONTO_TOTAL
                    MONTO_TOTAL_C_IVA
                    P161_DESCUENTO_V
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null  then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    if :TOTAL_IVA is null then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    :TOTAL_IVA := round(((((replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)) * replace(:CANTIDAD, '.', '')) * :PORC_IVA ) / (100 + :PORC_IVA)), 0);
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    DESCUENTO_C_IVA
                ]
                itemsToReturn: TOTAL_IVA
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-4 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :MONTO_TOTAL is null  then
                       :MONTO_TOTAL:= 0;
                    end if;
                    
                    
                    --:MONTO_TOTAL :=:MONTO_TOTAL_C_IVA -:IVA;
                    :MONTO_TOTAL := round((replace(:MONTO_TOTAL_C_IVA, '.', '') - replace(:TOTAL_IVA, '.', '')),0);
                    ```
                itemsToSubmit: [
                    MONTO_TOTAL_C_IVA
                    TOTAL_IVA
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-5 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_precio_unitario number;
                    begin
                    IF :PRECIO_UNITARIO IS NULL THEN
                    :PRECIO_UNITARIO:=0;
                    END IF;
                    
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_IVA/(100+:PORC_IVA)),0);
                     :PRECIO_UNITARIO:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,0);
                     end;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                ]
                itemsToReturn: PRECIO_UNITARIO
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

