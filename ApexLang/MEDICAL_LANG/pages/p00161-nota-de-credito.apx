    dynamicAction cargar-factura-lv (
        name: Cargar Factura LV
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: P161_LISTA_COMPROBANTES
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P161_LISTA_COMPROBANTES
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_nro_comprobante_ref  VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE_REF%TYPE;
                    v_ser_comprobante_ref  VTW_COMPROBANTES_CABECERA.SER_COMPROBANTE_REF%TYPE;
                    v_tip_comprobante_ref  VTW_COMPROBANTES_CABECERA.TIP_COMPROBANTE_REF%TYPE;
                    begin
                    SELECT nro_comprobante,ser_comprobante,tip_comprobante  
                    into :P161_NRO_COMPROBANTE_REF,:P161_SER_COMPROBANTE_REF,:P161_TIP_COMPROBANTE_REF
                    from vtw_comprobantes_cabecera
                    where id=:P161_LISTA_COMPROBANTES;
                    EXCEPTION 
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error al cargar los datos del comprobante');
                    when others then
                    raise_application_error(-20000,'Error en la tabla de comprobantes'||sqlerrm);
                    end;
                    ```
                itemsToSubmit: P161_LISTA_COMPROBANTES
                itemsToReturn: [
                    P161_NRO_COMPROBANTE_REF
                    P161_SER_COMPROBANTE_REF
                    P161_TIP_COMPROBANTE_REF
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction convert-fecha (
        name: CONVERT_FECHA
        execution {
            sequence: 260
        }
        when {
            selectionType: items
            items: P161_FEC_COMPROBANTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        conv_fecha varchar2(20);
                    
                    begin
                    
                        if (length(:P161_FEC_COMPROBANTE) = 8)
                                 /*and (nvl(:P392_IVA_INCLUIDO,'N') = 'S' or :P392_TIP_COMPROBANTE IN  ('RTI'))*/ then
                    
                            conv_fecha := replace(:P161_FEC_COMPROBANTE,'/','');
                            conv_fecha := substr(:P161_FEC_COMPROBANTE,1,2)||'/'||
                                                      substr(:P161_FEC_COMPROBANTE,3,2)||'/'||
                                                      lpad(substr(:P161_FEC_COMPROBANTE,5,4),4,'0');
                            
                            /*if conv_fecha between '01/'||to_date(conv_fecha, 'MM/YYYY') and last_day(conv_fecha) then
                                :P392_FEC_COMPROBANTE := conv_fecha;
                                raise_application_error(-20000,'fecha');
                    
                            end if;*/
                            /*if conv_fecha between '01/' || to_date(conv_fecha, 'MM/YYYY') AND last_day(conv_fecha) then
                                raise_application_error(-20000,'01/' || to_date(conv_fecha, 'MM/YYYY'));
                            else
                                raise_application_error(-20000,'no paso la validación de días');
                            end if;*/
                    
                        :P161_FEC_COMPROBANTE := conv_fecha;
                            ELSIF (length(:P161_FEC_COMPROBANTE) = 10) THEN
                            NULL;
                    
                            ELSIF (length(:P161_FEC_COMPROBANTE) > 10) THEN
                                raise_application_error(-20000,'Formato de fecha inválido.');
                        end if;
                        ver_fecha_valida(:P0_ID_EMPRESA, W_BUSCA_PARAMETRO('VT','ID_MODULO_VT'),:P161_FEC_COMPROBANTE);
                    end;
                    ```
                itemsToSubmit: P161_FEC_COMPROBANTE
                itemsToReturn: P161_FEC_COMPROBANTE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

