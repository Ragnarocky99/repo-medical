page 713 (
    name: Resumen OCP Licitaciones
    alias: RESUMEN-OCP-LICITACIONES
    title: Resumen OCP Licitaciones
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region resumen-ocp-licitaciones (
        name: Resumen OCP Licitaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nro_comprobante as nro_ocp, a.cod_articulo, d.cantidad
                from cmw_pedidos_cabecera c
                join cmw_pedidos_detalle  d on d.id_pedido_cab = c.id
                join stw_articulos        a on d.id_articulo                  = a.id
                where d.id_oferta_lic = :P711_ID_OFERTA_LIC
                ```
            pageItemsToSubmit: P713_ID_OFERTA_LIC
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 29834083124594887
        }

        column CANTIDAD (
            type: plainText
            heading {
                heading: Cantidad
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column COD_ARTICULO (
            type: plainText
            heading {
                heading: Cod Articulo
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NRO_OCP (
            type: plainText
            heading {
                heading: Nro Ocp
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 298416 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CANTIDAD (
                sequence: 3
            )

            displayColumn COD_ARTICULO (
                sequence: 2
            )

            displayColumn NRO_OCP (
                sequence: 1
            )

        )

    )

    pageItem P713_ID_OFERTA_LIC (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

)

