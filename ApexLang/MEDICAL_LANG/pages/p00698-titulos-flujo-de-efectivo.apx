            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region titulos-flujo-de-efectivo-2 (
        name: Titulos Flujo de Efectivo
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: COW_TITULO_FLUJO_CAJA_SET
            orderByClause: CODIGO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 130253052333012513
        }

        savedReport 1068134 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_EMPRESA
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @CODIGO
                layout {
                    width: 110.66699999999997
                    sequence: 4
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @DESCRIPCION_TOTAL
