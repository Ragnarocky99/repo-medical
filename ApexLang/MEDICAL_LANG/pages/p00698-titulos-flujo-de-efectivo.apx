                    sequence: 6
                }
            )

            displayColumn (
                column: @IND_REPLICA
                layout {
                    show: false
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CODIGO (
            type: numberField
            heading {
                heading: Codigo
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CODIGO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DESCRIPCION (
            type: textarea
            heading {
                heading: Descripcion
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 300
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
