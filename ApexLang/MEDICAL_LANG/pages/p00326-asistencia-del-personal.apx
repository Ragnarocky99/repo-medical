page 326 (
    name: Asistencia del personal
    alias: ASISTENCIA-DEL-PERSONAL
    title: Asistencia del personal
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asistencia-del-personal (
        name: Asistencia del Personal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_EMPLEADO,
                       ID_ESTADO_ASI,
                       HORA,
                       FEC_ASISTENCIA,
                       FEC_HOR_ASISTENCIA,
                       COD_USUARIO_AUD,
                       NRO_ORDEN,
                       ID_SUCURSAL,
                       ID_HORARIO
                  from RHW_ASISTENCIAS
                  where ID_EMPRESA=:P0_ID_EMPRESA
                  order by ID;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 327
                items: {
                    P327_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 13936499019291144
        }

        column COD_USUARIO_AUD (
            type: hidden
            heading {
                heading: Cod Usuario Aud
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column FEC_ASISTENCIA (
            type: plainText
            heading {
                heading: Fecha Asistencia
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column FEC_HOR_ASISTENCIA (
            type: plainText
            heading {
                heading: Fecha y Hora Asistencia
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column HORA (
            type: plainText
            heading {
                heading: Hora
                alignment: center
            }
            layout {
                sequence: 330
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AG
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ID_EMPLEADO (
            type: plainTextBasedOnLov
            heading {
                heading: Empleado
                alignment: center
            }
            lov {
                lov: @lv-empleados
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Empresa
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID_ESTADO_ASI (
            type: plainTextBasedOnLov
            heading {
                heading: Estado Asistencia
                alignment: center
            }
            lov {
                lov: @rhw-estados-asistencia
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID_HORARIO (
            type: hidden
            heading {
                heading: Id Horario
            }
            layout {
                sequence: 320
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AF
            }
        )

        column ID_SUCURSAL (
            type: hidden
            heading {
                heading: Sucursal
            }
            layout {
                sequence: 140
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column NRO_ORDEN (
            type: plainText
            heading {
                heading: Orden
                alignment: center
            }
            layout {
                sequence: 120
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                &P0_DESC_EMPRESA.
                Asistencia del Personal
                ```
        }
        pageFooter {
            pageFooterText:
                ```
                Usuario: &APP_USER.
                Fecha y hora: &P0_PAGE_TIMESTAMP.
                ```
        }

        savedReport 144448 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FEC_ASISTENCIA (
                sequence: 1
            )

            displayColumn FEC_HOR_ASISTENCIA (
                sequence: 4
            )

            displayColumn HORA (
                sequence: 2
            )

            displayColumn ID_EMPLEADO (
                sequence: 6
            )

            displayColumn ID_ESTADO_ASI (
                sequence: 5
            )

            displayColumn NRO_ORDEN (
                sequence: 3
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button crear (
        buttonName: Crear
        label: Crear
        layout {
            sequence: 10
            region: @asistencia-del-personal
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 327
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction when-dialog-closed (
        name: When dialog closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @asistencia-del-personal
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asistencia-del-personal
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

