page 397 (
    name: Despachos
    alias: DESPACHOS
    title: Despachos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region despachos (
        name: Despachos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID_EMPRESA,
                       NRO_DESPACHO,
                       FEC_PAGO,
                       TIP_CAMBIO,
                       ID_DESPACHANTE,
                       ID_ADUANA,
                       VALOR_FOB,
                       VALOR_IMP,
                       TOT_GASTOS,
                       (ROUND(TOT_GASTOS/VALOR_FOB,2)*100) PORC_IMP,
                       FEC_CONFIRMACION,
                       CONFIRMADO,
                        CASE CONFIRMADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       ICONO_CONFIRMADO,
                        CASE ANULADO
                        WHEN 'S' THEN 'fa fa-check u-success-text'
                        WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END AS 
                       ICONO_ANULADO,
                       ANULADO,
                       TIP_CAMBIO_CIVA,
                       TIP_CAMBIO_SIVA,
                       FACTOR_CIVA,
                       FACTOR_SIVA,
                       TOT_GASTOS_CIVA,
                       REFERENCIA,
                       BASE_IMPONIBLE,
                       COD_USUARIO_AUD,
                       ID,
                       TIPO_DESPACHO,
                       ID_SUC_STOCK,
                       PORC_PARTICIPACION,
                       ASIENTOS,
                       TIP_CAMBIO_DOLAR,
                       COMENTARIO,
                       ID_PROVEEDOR_ORIGEN,
                       DNA_NUMERO,
                       '' PRINT,
                       (SELECT SUM(TOTAL_IVA_GS)
                         FROM CMWV_GASTOS_DESPACHO
                        WHERE ID_DESPACHO = DC.ID) TOTAL_IVA_GS
                  from CMW_DESPACHOS_CABECERA DC
                  WHERE ID_EMPRESA=:P0_ID_EMPRESA
                  AND (DC.FEC_PAGO >= :P397_FEC_DESDE OR :P397_FEC_DESDE IS NULL)
                  AND (DC.FEC_PAGO <= :P397_FEC_HASTA OR :P397_FEC_HASTA IS NULL)
                ```
            pageItemsToSubmit: [
                P397_FEC_DESDE
                P397_FEC_HASTA
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 306
                items: {
                    P306_ID: #ID#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 22873987019050873
        }

