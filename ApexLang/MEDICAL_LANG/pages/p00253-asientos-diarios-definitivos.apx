page 253 (
    name: Asientos Diarios Definitivos
    alias: ASIENTOS-DIARIOS-DEFINITIVOS
    title: Asientos Diarios Definitivos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asientos-diarios (
        name: Asientos diarios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DC.ID,
                       DC.NUM_ASIENTO,
                       DC.NUM_ASIENTO_REF,
                       DC.FEC_ASIENTO,
                       DC.DESCRIPCION,
                       DC.ID_SUCURSAL
                       
                       FROM COW_DIARIO_CABECERAS DC
                --WHERE ID_EMPRESA = :P0_COD_EMPRESA
                       ORDER BY DC.NUM_ASIENTO DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 254
                items: {
                    P254_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            authorizationScheme: @derechos-actualizar-2
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        heading {
            fixedTo: region
            maxReportHeight: 330
        }
        advanced {
            savedReportMappingIdentifier: 109135079834357072
        }

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FEC_ASIENTO (
            type: plainText
            heading {
                heading: Fecha del Asiento
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NUM_ASIENTO (
            type: plainText
            heading {
                heading: Nro. Asiento Def.
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column NUM_ASIENTO_REF (
            type: plainText
            heading {
                heading: Nro. Asiento
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Asientos diarios
        }

        savedReport 511174 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRIPCION (
                sequence: 3
            )

            displayColumn FEC_ASIENTO (
                sequence: 4
            )

            displayColumn ID_SUCURSAL (
                sequence: 5
            )

            displayColumn NUM_ASIENTO (
                sequence: 1
            )

            displayColumn NUM_ASIENTO_REF (
                sequence: 2
            )

            sort (
                column: NUM_ASIENTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button b253-crear (
        buttonName: B253_CREAR
        label: Crear
        layout {
            sequence: 10
            region: @asientos-diarios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 254
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction after-dialog-closed (
        name: AFTER_DIALOG_CLOSED
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @asientos-diarios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asientos-diarios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

