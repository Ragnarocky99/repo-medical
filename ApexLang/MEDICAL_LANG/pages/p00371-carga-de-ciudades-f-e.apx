page 371 (
    name: Carga de Ciudades F.E.
    alias: CARGA-DE-CIUDADES-F-E
    title: Carga de Ciudades F.E.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                   background-color:#eeeeee;
                width: 228px;
                height: 25px;
                pointer-events: none;
              
                vertical-align: text-bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-ciudades-f-e (
        name: Carga de Ciudades F.E.
        type: form
        source {
            location: localDatabase
            tableName: FEW_CIUDADES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P371_COD_CIUDAD (
        type: textField
        label {
            label: <p>Código Ciudad: &ensp;</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @carga-de-ciudades-f-e
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 5
        }
        advanced {
            customAttributes: TABINDEX="4"
        }
        source {
            formRegion: @carga-de-ciudades-f-e
            column: COD_CIUDAD
            dataType: varchar2
        }
    )

    pageItem P371_COD_DEPARTAMENTO (
        type: popupLov
        label {
            label: <p>Departamento: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT DESCRIPCION, COD_DEPARTAMENTO FROM FEW_DEPARTAMENTOS WHERE COD_PAIS=:P371_COD_PAIS
        }
        cascadingLov {
            parentItems: P371_COD_PAIS
            itemsToSubmit: P371_COD_PAIS
        }
        layout {
            sequence: 30
            region: @carga-de-ciudades-f-e
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            customAttributes: TABINDEX="2"
        }
        source {
            formRegion: @carga-de-ciudades-f-e
            column: COD_DEPARTAMENTO
            dataType: varchar2
        }
    )

    pageItem P371_COD_DISTRITO (
        type: popupLov
        label {
            label: <p>Distrito: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION, COD_DISTRITO FROM FEW_DISTRITOS
                WHERE COD_PAIS=:P371_COD_PAIS
                AND COD_DEPARTAMENTO = :P371_COD_DEPARTAMENTO
                ```
        }
        cascadingLov {
            parentItems: [
                P371_COD_PAIS
                P371_COD_DEPARTAMENTO
            ]
            itemsToSubmit: [
                P371_COD_PAIS
                P371_COD_DEPARTAMENTO
            ]
        }
        layout {
            sequence: 50
            region: @carga-de-ciudades-f-e
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            customAttributes: TABINDEX="3"
        }
        source {
            formRegion: @carga-de-ciudades-f-e
            column: COD_DISTRITO
            dataType: varchar2
        }
    )

    pageItem P371_COD_PAIS (
        type: popupLov
        label {
            label: <p>País: &ensp;</p>
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lv-paises-fe
        }
        layout {
            sequence: 10
            region: @carga-de-ciudades-f-e
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 5
        }
        advanced {
            customAttributes: TABINDEX="1"
        }
        source {
            formRegion: @carga-de-ciudades-f-e
            column: COD_PAIS
            dataType: varchar2
        }
    )

    pageItem P371_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 40
            region: @carga-de-ciudades-f-e
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 500
        }
        advanced {
            customAttributes: TABINDEX="5"
        }
        source {
            formRegion: @carga-de-ciudades-f-e
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P371_ID (
        type: hidden
        layout {
            sequence: 70
            region: @carga-de-ciudades-f-e
            slot: regionBody
        }
        source {
            formRegion: @carga-de-ciudades-f-e
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P371_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P371_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P371_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction deshabilitar (
        name: Deshabilitar
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P371_COD_CIUDAD
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P371_ID
            }
        )

    )

    computation p371-cod-ciudad (
        itemName: P371_COD_CIUDAD
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                   declare
                   v_numero number;
                   
                   begin
                   if :P371_COD_CIUDAD is null then
                      select nvl( max( COD_CIUDAD ), 0 ) + 1
                         into v_numero
                         from FEW_CIUDADES;
                       RETURN v_numero;
                      end if; 
                      RETURN :P371_COD_CIUDAD;
                   exception
                      when no_data_found then
                        :P371_COD_CIUDAD  := 1 ;
                        RETURN :P371_COD_CIUDAD;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Ciudades' || sqlerrm ) ;
                   end ;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P371_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 22630258353079437
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-ciudades-f-e (
        name: Initialize form Carga de Ciudades F.E.
        type: formInitialization
        formRegion: @carga-de-ciudades-f-e
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22629447160079437
        }
    )

    process process-form-carga-de-ciudades-f-e (
        name: Process form Carga de Ciudades F.E.
        type: formAutoRowProcessing
        formRegion: @carga-de-ciudades-f-e
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 22629809533079437
        }
    )

)

