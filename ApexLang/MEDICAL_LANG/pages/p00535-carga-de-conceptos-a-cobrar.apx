page 535 (
    name: Carga de conceptos a cobrar
    alias: CARGA-DE-CONCEPTOS-A-COBRAR
    title: Carga de conceptos a cobrar
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: document.getElementById("P535_COD_ARTICULO").readOnly = true;
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .mostrar{
                background-color:#eeeeee;
                width: 225px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: buttons
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region carga-de-conceptos-a-cobrar (
        name: Carga de Conceptos a cobrar
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ID,
                       A.COD_ARTICULO,
                       A.DESCRIPCION,
                       A.ID_IVA,
                       A.ESTADO,
                       A.IND_MODIFICA_PRECIO,
                       A.IND_ALQUILERES,
                       A.IND_MANEJA_LOTE,
                       A.IND_MANEJA_STOCK,
                       A.ID_GRUPO_ART,
                       A.ID_PAIS_ORIGEN,
                       A.ID_MARCA,
                       A.ID_RUBRO,
                       A.ID_FAMILIA,
                       A.ID_LINEA,
                       A.ID_ENVASE,
                       A.ID_EMPRESA,
                       A.ID_UNIDAD_MEDIDA,
                       A.ID_MONEDA_COSTO,
                       A.ID_MONEDA_BASE,
                       A.IND_GASTO_GARANTIA   
                  from STW_ARTICULOS A
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P535_COD_ARTICULO (
        type: textField
        label {
            label: <P>Código: </P>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-conceptos-a-cobrar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @carga-de-conceptos-a-cobrar
            column: COD_ARTICULO
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(A.COD_ARTICULO)),0)+1
                from STW_ARTICULOS A
                WHERE A.ID_EMPRESA = :P0_COD_EMPRESA;
                ```
        }
    )

