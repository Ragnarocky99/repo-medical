page 239 (
    name: Asientos Diarios Provisorios
    alias: ASIENTOS-DIARIOS-PROVISORIOS1
    title: Asientos Diarios Provisorios
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asientos-diarios (
        name: Asientos diarios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CP.ID,
                       CP.NUM_ASIENTO,
                       CP.FEC_ASIENTO,
                       CP.DESCRIPCION,
                       CP.ID_SUCURSAL,
                       
                       CP.IND_MAYORIZADO AS MAYORIZADO,
                       CASE CP.IND_MAYORIZADO
                            WHEN 'S' THEN 'fa fa-check u-success-text'
                            WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END MAYORIZADO_ICON,
                
                       CP.IND_ASIENTO_CIERRE AS CIERRE,
                       CASE CP.IND_ASIENTO_CIERRE
                            WHEN 'S' THEN 'fa fa-check u-success-text'
                            WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END CIERRE_ICON,
                
                       CP.IND_ASIENTO_APERTURA AS APERTURA,
                       CASE CP.IND_ASIENTO_APERTURA
                            WHEN 'S' THEN 'fa fa-check u-success-text'
                            WHEN 'N' THEN 'fa fa-remove u-danger-text'
                       END APERTURA_ICON,
                       CP.ID_MODULO
                
                       FROM COW_DIARIO_CABECERAS_PROV CP
                       WHERE ID_EMPRESA = :P0_COD_EMPRESA
                         AND ID_EJERCICIO = TRAE_ID_EJERCICIO(:P0_FEC_INICIAL_EJERCICIO)
                       ORDER BY CP.NUM_ASIENTO DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        link {
            linkColumn: customTarget
            target: {
                page: 235
                items: {
                    P235_ID: #ID#
                }
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        heading {
            fixedTo: region
            maxReportHeight: 330
        }
        advanced {
            savedReportMappingIdentifier: 50018493281974737
        }

        column APERTURA (
            type: plainText
            heading {
                heading: Apertura
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#APERTURA_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column APERTURA_ICON (
            type: hidden
            heading {
                heading: Apertura Icon
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CIERRE (
            type: plainText
            heading {
                heading: Cierre
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#CIERRE_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CIERRE_ICON (
            type: hidden
            heading {
                heading: Cierre Icon
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Descripción
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FEC_ASIENTO (
            type: plainText
            heading {
                heading: Fecha del Asiento
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ID (
            type: hidden
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ID_MODULO (
            type: plainTextBasedOnLov
            heading {
                heading: Modulo
                alignment: center
            }
            lov {
                lov: @lv-modulos
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column ID_SUCURSAL (
            type: plainTextBasedOnLov
            heading {
                heading: Sucursal
                alignment: center
            }
            lov {
                lov: @lv-sucursales
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column MAYORIZADO (
            type: plainText
            heading {
                heading: Mayorizado
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="dm-IRR-icon">
                    	<span class="#MAYORIZADO_ICON#" ></span>
                    	<span class="dm-IRR-iconLabel"></span>
                    </div>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column MAYORIZADO_ICON (
            type: hidden
            heading {
                heading: Mayorizado Icon
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column NUM_ASIENTO (
            type: plainText
            heading {
                heading: Nro. Asiento
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Asientos diarios
        }

        savedReport 511174 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APERTURA (
                sequence: 5
            )

            displayColumn CIERRE (
                sequence: 6
            )

            displayColumn DESCRIPCION (
                sequence: 2
            )

            displayColumn FEC_ASIENTO (
                sequence: 3
            )

            displayColumn ID_SUCURSAL (
                sequence: 4
            )

            displayColumn NUM_ASIENTO (
                sequence: 1
            )

            sort (
                column: NUM_ASIENTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button b239-crear (
        buttonName: B239_CREAR
        label: Crear
        layout {
            sequence: 10
            region: @asientos-diarios
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 235
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    dynamicAction after-dialog-closed (
        name: AFTER_DIALOG_CLOSED
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @asientos-diarios
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asientos-diarios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

