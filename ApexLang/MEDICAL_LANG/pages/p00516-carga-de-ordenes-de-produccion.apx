    region materias-primas (
        name: Materias Primas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_PRODUCCION_CAB,
                       ID_EMPRESA,
                       ID_ARTICULO,
                       CANTIDAD,
                       CANTIDAD_REFERENCIA,
                       COSTO_UNITARIO,
                       COSTO_LISTA,
                       MONTO_TOTAL,
                       MONTO_TOTAL AS MONTO_COPIA,
                       COSTO_PROMEDIO,
                       ID_SUCURSAL,
                       CANTIDAD_UB,
                       ID_UNIDAD_MEDIDA,
                       ID_LOTE,
                       FEC_VENCIMIENTO,
                       NRO_ORDEN,
                       ANULADO,
                       ESTADO,
                       TIPO,
                       AFECTA_MERMA,
                       COSTO_UNITARIO_ME,
                       COSTO_LISTA_ME,
                       MONTO_TOTAL_ME,
                       COSTO_PROMEDIO_ME,
                       IND_MP_FUNDAMENTAL,
                       INDICE
                  from PDW_PRODUCCION_DET
                  WHERE INDICE = 'M'
                  and id_produccion_cab = :p516_id
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--noPadding
                margin-bottom-none
            ]
        }
