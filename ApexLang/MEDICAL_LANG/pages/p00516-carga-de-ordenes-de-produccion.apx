    dynamicAction calcula-costo (
        name: Calcula Costo
        execution {
            sequence: 320
        }
        when {
            selectionType: items
            items: P516_TOTAL_AGREGADOS
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var v_monto = $v("P516_TOTAL_PRIMAS");
                    var v_monto_agg = $v("P516_TOTAL_AGREGADOS");
                    var costo = 0;  
                    
                    var $widget = apex.region("Articulos").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        var v_cantidad = $model.getFieldKey("CANTIDAD");
                    
                    
                    
                    
                    
                    var model = apex.region("Articulos").widget().interactiveGrid("getCurrentView").model;
                    
                    try {
                    
                    model.forEach(function(r, index, id) {
                    
                    
                        var meta = model.getRecordMetadata(id);
                        if ((meta.fields != undefined) && (!meta.deleted)) {
                    
                    
                          costo = (parseFloat(v_monto.replace(/\./g,'')) + parseFloat(v_monto_agg.replace(/\./g,'')))/parseFloat(r[v_cantidad]);
                          model.setValue(r,"COSTO", costo);
                    
                        }
                    console.log('TU PRIMAAAAA ');
                    });
                    
                    
                    
                    }catch(e){
                        console.log(e);
                    };
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcula-costo-2 (
        name: Calcula Costo 2
        execution {
            sequence: 330
        }
        when {
            selectionType: columns
            interactiveGrid: @artículos-producidos
            columns: CANTIDAD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    :costo := (NVL(REPLACE(nvl(:P516_total_PRIMAS,0), '.', ''),0)+NVL(REPLACE(nvl(:P516_total_AGREGADOS,0), '.', ''),0))/:cantidad;
                    end;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    P516_TOTAL_PRIMAS
                    P516_TOTAL_AGREGADOS
                    COSTO
                ]
                itemsToReturn: COSTO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var v_monto = $v("P516_TOTAL_PRIMAS");
                    var v_monto_agg = $v("P516_TOTAL_AGREGADOS");
                    var costo = 0;  
                    
                    var $widget = apex.region("Articulos").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                        var v_cantidad = $model.getFieldKey("CANTIDAD");
                    
                    
                    
                    
                    
                    var model = apex.region("Articulos").widget().interactiveGrid("getCurrentView").model;
                    
                    try {
                    
                    
                    model.forEach(function(r, index, id) {
                    
                    
                        var meta = model.getRecordMetadata(id);
                        if ((meta.fields != undefined) && (!meta.deleted)) {
                    
                    
                          costo = (parseFloat(v_monto.replace(/\./g,'')) + parseFloat(v_monto_agg.replace(/\./g,'')))/parseFloat(r[v_cantidad]);
                          model.setValue(r,"COSTO", costo);
                    
                        }
                    console.log('TU PRIMAAAAA ');
                    });
                    
                    
                    
                    
                    }catch(e){
                        console.log(e);
                    };
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction calcular-monto (
        name: CALCULAR MONTO
        execution {
            sequence: 300
        }
        when {
            selectionType: columns
            interactiveGrid: @artículos-producidos
            columns: CANTIDAD
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      vmult NUMBER(18,7);
                      vdiv  NUMBER(18,7);
                      error EXCEPTION;
                    BEGIN
                      select r.mult, r.divisor, r.mult, r.divisor
                        into vmult, vdiv, :mult, :div
                        from stw_relaciones r,  stw_unidades_medida u, stw_articulos a
                       where a.id_empresa = :P0_ID_empresa
                         and a.id = :id_articulo
                         and r.id_relacion_um = a.id
                         and r.id_unidad_rel = :id_unidad_medida
                         and u.id = r.id_unidad_rel ;
                      :cantidad_ub := ( ( nvl( :cantidad, 0 ) *
                                                      nvl( vmult, 0 ) ) /
                                                      nvl( vdiv, 0 ) );
                        if nvl( :cantidad, 0 ) > 0 then
                          if nvl( :cantidad_ub, 0 ) < nvl( :cantidad_ub_de_formula, 0 ) then
                        	  RAISE_APPLICATION_ERROR(-20000, 'La cantidad Ingresada no puede ser menor a la Cantidad Minima a Producir segun Formula.' ||
                        	              'La cantidad Minima a producir es ' || to_char( :cantidad_de_formula ));
                            raise error ;
                          end if ;
                        end if ;
                      
                    ------controla que no se tipeee la cantidad producida 26.10.2022-------
                    
                    
                    
                    
                        if nvl( :cantidad, 0 ) > 0 then
                          if nvl( :cantidad, 0 ) < nvl( :P516_CANT_A_PRODUCIR, 0 ) then
                        	  RAISE_APPLICATION_ERROR(-20000, 'La cantidad Ingresada no puede ser menor a la Cantidad  a Producir segun Cantidad a producir Ingresada.' ||
                        	              'La cantidad ingrrsada  a producir es ' || to_char( :P516_CANT_A_PRODUCIR ) );
                       	         :cantidad := nvl( :P516_CANT_A_PRODUCIR, 0 );     
                            raise error ;
                          end if ;
                        end if ;
                      
                      
                    -------------------fin cantidad producida-----------------------------  
                      
                      
                      
                      
                      
                    EXCEPTION
                      when error then
                        RAISE_APPLICATION_ERROR(-20000, sqlerrm) ;
                      when no_data_found then
                        :cantidad_ub := NULL;
                        :mult := 1 ;
                        :div := 1 ;
                        RAISE_APPLICATION_ERROR(-20000, 'La unidad de medida no corresponde al artículo seleccionado.');
                    --    mensaje_ex('cod_art='||:b_envdeta.cod_articulo||'cod_um '||:b_envdeta.cod_unidad_medida||'cod_um_rel');
                      when others then
                        :cantidad_ub := NULL;
                        :mult := 1 ;
                        :div := 1 ;
                        RAISE_APPLICATION_ERROR(-20000, 'Error en la tabla Relaciones de Artículos '|| sqlerrm);
                    END;
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                    CANTIDAD_UB
                ]
                itemsToReturn: [
                    CANTIDAD_UB
                    MULT
                    DIV
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-total (
        name: CALCULAR TOTAL
        execution {
            sequence: 290
        }
        when {
            selectionType: columns
            interactiveGrid: @productos-agregados
            columns: COSTO_UNITARIO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :monto_total := nvl(:cantidad_ub,0) * nvl(replace(:costo_unitario, '.', ''),0) ;
                itemsToSubmit: [
                    CANTIDAD_UB
                    COSTO_UNITARIO
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cantidad (
        name: Cantidad
        execution {
            sequence: 280
        }
        when {
            selectionType: columns
            interactiveGrid: @productos-agregados
            columns: CANTIDAD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      vmult NUMBER(18,7);
                      vdiv  NUMBER(18,7);
                    BEGIN
                    --mensaje_ex ('Entra art. '||:b_auxiliar.cod_articulo||' cod_um '||:b_auxiliar.cod_unidad_medida);
                      select  r.mult, r.divisor
                         into vmult, vdiv
                         from stw_relaciones r, stw_unidades_medida u, stw_articulos a
                        where a.id_empresa	= :P0_ID_empresa
                          and a.id = :id_articulo
                          and r.id_relacion_um	= a.id
                          and r.id_unidad_rel = :id_unidad_medida
                          and u.id = r.ID_unidad_rel;
                    
                    
                      :cantidad_ub := ( ( nvl( :cantidad, 0 ) *
                                                     nvl( vmult, 0 ) ) /
                                                     nvl( vdiv, 0 ) );
                      :monto_total := nvl(:cantidad_ub,0) * nvl(replace(:costo_unitario, '.', ''),0);
                      
                    EXCEPTION
                      when no_data_found then
                        :cantidad_ub := NULL;
                        RAISE_APPLICATION_ERROR(-20000, 'El código de relaciones no corresponde al artículo seleccionado.');
                        RAISE_APPLICATION_ERROR(-20000, 'cod_art='||:ID_articulo||'cod_um '||:ID_unidad_medida||'cod_um_rel');
                      when others then
                        :cantidad_ub := NULL;
                        RAISE_APPLICATION_ERROR(-20000, 'Error en la tabla Relaciones de Artículos DETALLE '|| sqlerrm);
                    END;
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    ID_UNIDAD_MEDIDA
                    CANTIDAD
                    CANTIDAD_UB
                    COSTO_UNITARIO
                ]
                itemsToReturn: [
                    CANTIDAD_UB
                    MONTO_TOTAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fec-vencimiento (
        name: FEC_VENCIMIENTO
        execution {
            sequence: 270
        }
        when {
            selectionType: columns
            interactiveGrid: @artículos-producidos
            columns: ID_LOTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :ID_lote is not null then
                    BEGIN
                      select fec_vencimiento
                        into :fec_vencimiento
                        from stW_lotes
                       where ID_empresa = :P0_ID_empresa
                         and ID_articulo = :ID_articulo
                         and ID = :ID_lote;
                    
                    EXCEPTION
                      when no_data_found then
                        IF ltrim( rtrim( :ID_lote ) ) IS NULL OR
                           ltrim( rtrim( :ID_lote ) ) = '' THEN
                          RAISE_APPLICATION_ERROR(-20000, 'Debe ingresar el número de lote.');
                        END IF;
                    END;
                    ELSIF :ID_LOTE IS NULL THEN
                        :FEC_VENCIMIENTO :=NULL;
                    END IF;
                    ```
                itemsToSubmit: [
                    ID_LOTE
                    FEC_VENCIMIENTO
                    ID_ARTICULO
                    P0_ID_EMPRESA
                ]
                itemsToReturn: FEC_VENCIMIENTO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

