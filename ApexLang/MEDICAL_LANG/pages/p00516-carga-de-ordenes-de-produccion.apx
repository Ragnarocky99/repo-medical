    computation p516-nro-produccion (
        itemName: P516_NRO_PRODUCCION
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                   v_numero number;
                   
                   begin
                   if :P516_NRO_PRODUCCION is null then
                      select nvl(max(to_number(NRO_PRODUCCION)), 0) + 1
                         into v_numero
                         from PDW_PRODUCCION_CAB
                         where SER_PRODUCCION=:P516_SER_PRODUCCION;
                       RETURN v_numero;
                      end if; 
                      RETURN :P516_NRO_PRODUCCION;
                   exception
                      when no_data_found then
                        :P516_NRO_PRODUCCION := 1 ;
                        RETURN :P516_NRO_PRODUCCION;
                      when others then
                         raise_application_error(-20000,'Error en la tabla de Cabecera de Producción' || sqlerrm ) ;
                   end ;
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P516_ID
        }
    )

