page 516 (
    name: Carga de Ordenes de Produccion
    alias: CARGA-DE-ORDENES-DE-PRODUCCION
    title: Carga de Ordenes de Produccion
    appearance {
        pageTemplate: @standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function calculaTotales(){
                var model= apex.region("Agregados").widget().interactiveGrid("getCurrentView").model;
                var v_cantidad = model.getFieldKey("MONTO_COPIA");
                var v_total_cantidad     = 0;
            
                model.forEach(function(r, index, id) {
            
                
                    var meta = model.getRecordMetadata(id);
                    if ((meta.fields != undefined) && (!meta.deleted)){
                          
                        v_total_cantidad      = v_total_cantidad     + parseFloat(r[v_cantidad].replace(/\./g,''));
                    }
                    
                });
            
                if(isNaN(v_total_cantidad)){
                     v_total_cantidad=1;
                 }
            
                 $s('P516_TOTAL_AGREGADOS',v_total_cantidad);
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            document.getElementById("P516_FEC_VENCIMIENTO_PRIMAS").readOnly = true;
            document.getElementById("P516_FEC_VENCIMIENTO_AGREGADOS").readOnly = true;
            document.getElementById("P516_ARTICULO").readOnly = true;
            document.getElementById("P516_TIP_PRODUCCION_1").readOnly = true;
            document.getElementById("ID_ARTICULO").readOnly = true;
            document.getElementById("P516_ASIENTOS").readOnly = true;
            document.getElementById("P516_TOTAL_PRIMAS").readOnly = true;
            document.getElementById("P516_CANTIDAD_UB").readOnly = true;
            document.getElementById("P516_TOTAL_AGREGADOS").readOnly = true;
            ```
    }
