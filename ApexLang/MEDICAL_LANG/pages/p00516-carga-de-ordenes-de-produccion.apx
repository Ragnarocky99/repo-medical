                type: expression
                plsqlExpression: :P0_ID_EMPRESA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_LOTE (
            type: selectList
            heading {
                heading: <p>Nro. Lote</p>
                alternativeLabel: Nro. Lote
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NRO_LOTE,ID FROM STW_LOTES
                    WHERE ID_EMPRESA=:P0_ID_EMPRESA
                    AND ID_ARTICULO = :ID_ARTICULO
                    ```
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: ID_ARTICULO
            }
            layout {
                sequence: 160
            }
            source {
                databaseColumn: ID_LOTE
                dataType: number
            }
        )

