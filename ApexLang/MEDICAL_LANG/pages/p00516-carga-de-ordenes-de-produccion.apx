                    }
                    
                    if((json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA!=null)){
                        $model.setValue($newRecord, "ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA));
                    }
                    
                    if((json_detalle.DETALLE[i].CANTIDAD!=null)){
                        $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD));
