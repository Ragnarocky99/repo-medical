        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.region("Articulos").widget().interactiveGrid("getActions").hide("selection-add-row");
                    apex.region("Articulos").widget().interactiveGrid("getActions").hide("edit");
                    
                    apex.region("Agregados").widget().interactiveGrid("getActions").hide("edit");
                    
                    
                    
                    
                    var grid = apex.region("Prima").call("getViews").grid;
                    grid.setEditMode(true);
                    
                    var grid = apex.region("Agregados").call("getViews").grid;
                    grid.setEditMode(true);
                    
                    var grid = apex.region("Articulos").call("getViews").grid;
                    grid.setEditMode(true);
                    ```
