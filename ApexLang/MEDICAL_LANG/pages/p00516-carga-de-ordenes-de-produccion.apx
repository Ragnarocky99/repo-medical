    dynamicAction set-grilla-ap (
        name: SET GRILLA AP
        execution {
            sequence: 210
            eventScope: once
        }
        when {
            event: focusin
            selectionType: region
            region: @artículos-producidos
        }
        clientSideCondition {
            type: itemColumn=value
            componentType: item
            item: P516_BANDERA_DETALLE
            value: 1
        }
        serverSideCondition {
            type: itemIsNull
            item: P516_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    vitem                       NUMBER;
                    TMP_SERIE CONSTANT          VARCHAR2(255) := 'DETALLE'; 
                    l_cursor SYS_REFCURSOR;
                    json_detalle                CLOB;
                    vcantidad                   number;
                    vcantidad_ub                number;
                    vlote                       number;
                    vfecha                      date;
                    vcosto_unitario             number;
                    vmonto_total                number;
                    vtip_costeo                 varchar2(5);
                    vcosto                      number;
                    vporcentaje                 number;
                    vdecimales_costo_total      number;
                    vdecimales_costo_unitario   number;
                    CURSOR cprod IS 
                       Select fo.id_articulo, a.descripcion desc_art, fo.id_sucursal_destino sucursal,
                               fo.cantidad, fo.id_unidad_medida, fo.tipo_costeo, fo.costo_fijo,
                               ( nvl( :P516_cant_a_producir, 0 ) / nvl( c.cantidad, 1 ) ) ind,
                               fo.porcentaje, fo.decimales_costo_total, fo.decimales_costo_unitario,
                                c.se_informa, c.cantidad cant_cab
                          from PDW_FORMULA_CAB c, PDW_FORMULA_PRODUCIDOS fo, STW_ARTICULOS a
                         where c.id_empresa   = :P0_ID_EMPRESA
                           and c.id           = :P516_ID_FORMULA
                           and fo.id_empresa  = c.id_empresa
                           and fo.id_formula  = c.id
                           and a.id_empresa   = fo.id_empresa
                           and a.id           = fo.id_articulo ;
                    vcom NUMBER  (18,7);
                    vexi NUMBER  (18,7);
                    vafe VARCHAR2(1);
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_SERIE) THEN
                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_SERIE);
                      END IF;
                        APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_SERIE);
                     for c in cprod loop
                    
                     BEGIN
                     SELECT ID, fec_vencimiento
                     INTO vlote, vfecha
                     FROM STW_LOTES
                     WHERE ID_ARTICULO=c.ID_ARTICULO
                     AND NRO_LOTE='0';
                     EXCEPTION
                     when others then
                    raise_application_error(-20000, 'Error al recuperar lote ' ||sqlerrm);
                    END;
                        if c.se_informa <> 'MP' then
                          vcantidad               := round(( :P516_CANT_A_PRODUCIR * nvl( c.cantidad, 1 ) ) / nvl(c.cant_cab,0),4) ;
                        else
                           vcantidad                := round(( nvl( c.cantidad, 0 ) * nvl( c.ind, 0 ) ),4) ;
                        end if ;
                        vtip_costeo                := c.tipo_costeo ;
                        if c.tipo_costeo = 'F' then
                          vcosto                    := c.costo_fijo ;
                        elsif c.tipo_costeo = 'P' then
                          vporcentaje              :=  c.porcentaje;
                          vdecimales_costo_total    := c.decimales_costo_total ;
                          vdecimales_costo_unitario := c.decimales_costo_unitario ;
                        else
                          vcosto                    := 0 ;
                          vporcentaje               := 0 ;
                          vdecimales_costo_total     := 0 ;
                          vdecimales_costo_unitario := 0 ;
                        end if ;
                        --:b_producido.de_formula := 'S' ;
                    APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_SERIE,
                        p_c001 => :P0_ID_EMPRESA,
                        p_c002 => c.ID_ARTICULO,
                        p_c003 => c.sucursal,
                        --p_c004 => vlote, --LOTE POR DEFECTO 
                       -- p_c005 => vfecha,
                        p_c006 => c.ID_UNIDAD_MEDIDA,
                        p_c007 => vcantidad,
                        p_c008 => vtip_costeo,
                        p_c009 => vcosto ,
                        p_c010 => vporcentaje,
                        p_c011 => vdecimales_costo_total,
                        p_c012 => vdecimales_costo_unitario
                        );
                    
                     END LOOP;
                     OPEN l_cursor FOR
                        SELECT C001 AS ID_EMPRESA,
                               c002 as ID_ARTICULO,
                               c003 as ID_SUCURSAL,
                               --c004 as ID_LOTE,
                               --c005 as FEC_VENCIMIENTO,
                               c006 as ID_UNIDAD_MEDIDA,
                               c007 as vcantidad,
                               c008 as TIP_COSTO,
                               c009 as COSTO,
                               c010 as PORCENTAJE,
                               c011 as DECIMALES_COSTO_TOTAL,
                               c012 as DECIMALES_COSTO_UNITARIO
                        FROM   APEX_COLLECTIONS
                        Where COLLECTION_NAME = TMP_SERIE;
                    
                      APEX_JSON.initialize_clob_output;
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P516_JSON_PRODUCIDO:=JSON_DETALLE;
                    END;
                    ```
                itemsToSubmit: [
                    P516_ID_FORMULA
                    P516_CANT_A_PRODUCIR_ANT
                    P516_CANT_A_PRODUCIR
                    P516_FEC_PRODUCCION
                    ID_ARTICULO
                ]
                itemsToReturn: P516_JSON_PRODUCIDO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var total=0;
                    var json_detalle = JSON.parse($v('P516_JSON_PRODUCIDO'));
                    console.log(json_detalle);
                    
                    try {
                    
                    
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Articulos").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    
                    if((json_detalle.DETALLE[i].ID_EMPRESA!=null)){
                        $model.setValue($newRecord, "ID_EMPRESA",(json_detalle.DETALLE[i].ID_EMPRESA).toString());
                    }
                    
                    if((json_detalle.DETALLE[i].ID_ARTICULO!=null)){
                        $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO));
                    }
                    
                    if((json_detalle.DETALLE[i].ID_SUCURSAL!=null)){
                        $model.setValue($newRecord, "ID_SUCURSAL",(json_detalle.DETALLE[i].ID_SUCURSAL));
                    }
                    
                    /*if((json_detalle.DETALLE[i].ID_LOTE!=null)){
                        $model.setValue($newRecord, "ID_LOTE",(json_detalle.DETALLE[i].ID_LOTE));
                    }
                    
                    if((json_detalle.DETALLE[i].FEC_VENCIMIENTO!=null)){
                        $model.setValue($newRecord, "FEC_VENCIMIENTO",(json_detalle.DETALLE[i].FEC_VENCIMIENTO));
                    }*/
                    
                    if((json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA!=null)){
                        $model.setValue($newRecord, "ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA));
                    }
                    
                    if((json_detalle.DETALLE[i].VCANTIDAD!=null)){
                        $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].VCANTIDAD));
                    }
                    
                    if((json_detalle.DETALLE[i].AFECTA_MERMA!=null)){
                        $model.setValue($newRecord, "TIPO_COSTEO",(json_detalle.DETALLE[i].tip_costo));
                    }
                    
                    if((json_detalle.DETALLE[i].CANTIDAD_UB!=null)){
                        $model.setValue($newRecord, "COSTO",(json_detalle.DETALLE[i].COSTO));
                    }
                    
                    if((json_detalle.DETALLE[i].CANTIDAD_UB!=null)){
                        $model.setValue($newRecord, "PORCENTAJE",(json_detalle.DETALLE[i].porcentaje));
                    }
                    
                    if((json_detalle.DETALLE[i].FEC_VENCIMIENTO!=null)){
                        $model.setValue($newRecord, "DECIMALES_COSTO_TOTAL",(json_detalle.DETALLE[i].DECIMALES_COSTO_TOTAL));
                    }
                    
                    if((json_detalle.DETALLE[i].COSTO_UNITARIO!=null)){
                        $model.setValue($newRecord, "DECIMALES_COSTO_UNITARIO",(json_detalle.DETALLE[i].DECIMALES_COSTO_UNITARIO));
                    }
                    
                    
                    };
                    
                        
                     var $widget = apex.region("Articulos").widget();
                     var $grid = $widget.interactiveGrid("getViews", "grid");
                     var $model = $grid.model;
                     var cantidadDet= $model.getTotalRecords();
                    
                      
                    
                        var model= apex.region("Articulos").widget().interactiveGrid("getCurrentView").model;
                    
                    
                        model.forEach(function(r, index, id) {
                    
                        
                            var meta = model.getRecordMetadata(id);
                            if ((meta.fields != undefined) && (!meta.deleted)){
                    
                                 
                                model.setValue(r,'COSTO',$v('P516_TOTAL_PRIMAS'));
                    
                               
                            }
                            
                        });
                    
                      //if(isNaN(r,'COSTO')){
                       //      'COSTO'=0;
                        // }
                    
                    
                    }
                    
                    }catch(e){
                        console.log(e);
                    };
                    ```
            }
            affectedElements {
                selectionType: region
                region: @materias-primas
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction set-grilla-mp (
        name: SET GRILLA MP
        execution {
            sequence: 200
            eventScope: once
        }
        when {
            event: focusin
            selectionType: region
            region: @materias-primas
        }
        clientSideCondition {
            type: itemColumn=value
            componentType: item
            item: P516_BANDERA_DETALLE
            value: 1
        }
        serverSideCondition {
            type: itemIsNull
            item: P516_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    vitem NUMBER;
                    TMP_SERIE CONSTANT VARCHAR2(255) := 'DETALLE'; 
                    l_cursor SYS_REFCURSOR;
                    json_detalle CLOB;
                    vcantidad number;
                    vcantidad_ub number;
                    vlote number;
                    vfecha date;
                    vcosto_unitario number;
                    vmonto_total number;
                    CURSOR detalle IS 
                    select d.id_articulo,
                            c.id_empresa,
                           d.id_unidad_medida,
                           c.cantidad cantidad_cab,
                           d.cantidad cantidad_det,
                           d.id_sucursal,
                           a.ind_maneja_stock,
                           nvl(d.afecta_merma, 'S') afecta_merma,
                           d.nro_orden,
                           r.mult,
                           r.divisor,
                           c.se_informa,
                           (nvl(:P516_cant_a_producir, 0) / nvl(c.cantidad, 1)) ind,
                           a.cod_articulo
                      from pdw_formula_det d,
                           pdw_formula_cab c,
                           stw_articulos   a,
                           stw_relaciones  r
                     where c.id_empresa = :P0_id_empresa
                       and c.id = :P516_id_formula
                       and c.id_empresa = d.id_empresa
                       and c.id = d.id_formula_cab
                       and d.id_empresa = a.id_empresa
                       and d.id_articulo = a.id
                       and r.id_relacion_um = a.id
                       and r.id_unidad_rel = d.id_unidad_medida
                     order by d.nro_orden;
                    vcom NUMBER  (18,7);
                    vexi NUMBER  (18,7);
                    vafe VARCHAR2(1);
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_SERIE) THEN
                    APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_SERIE);
                      END IF;
                        APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_SERIE);
                     FOR f IN detalle LOOP
                    BEGIN
                     SELECT ID, fec_vencimiento
                     INTO vlote, vfecha
                     FROM STW_LOTES
                     WHERE ID_ARTICULO=F.ID_ARTICULO
                     AND NRO_LOTE='0';
                     EXCEPTION
                     when others then
                    raise_application_error(-20000, 'Error al recuperar lote ' ||sqlerrm);
                    END;
                    IF :ID_ARTICULO IS NULL OR :P516_CANT_A_PRODUCIR_ANT <> :P516_CANT_A_PRODUCIR  THEN 
                    BEGIN
                    select trae_costo_prom(:P0_ID_empresa,f.ID_articulo,:P516_FEC_PRODUCCION)--nvl( costo_prom, 1 )
                    into vcosto_unitario
                    from stw_articulos a 
                    where a.id_empresa = :P0_ID_empresa
                    and a.id = f.id_articulo;
                    EXCEPTION
                    when others then
                    raise_application_error(-20000, 'Error al recuperar costo' || sqlerrm);
                    END;
                       if f.se_informa = 'MP' then
                             vcantidad   := ( nvl( f.cantidad_det, 0 ) * nvl( f.ind, 0 ) ) ;
                          else
                             vcantidad   := ( :P516_CANT_A_PRODUCIR * nvl( f.cantidad_det, 1 ) ) / f.cantidad_cab ;
                          end if ;
                        vcantidad_ub := ( ( nvl( vcantidad, 0 ) * nvl( f.mult, 1 ) ) / nvl( f.divisor, 1 ) );
                        Vmonto_total := nvl( vcantidad_ub, 0 ) * nvl( vcosto_unitario, 0 );
                    APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_SERIE,
                        p_c001 => :P0_ID_EMPRESA,
                        p_c002 => F.ID_ARTICULO,
                        p_c003 => F.ID_SUCURSAL,
                        p_c004 => vlote, --LOTE POR DEFECTO
                        p_c005 => F.ID_UNIDAD_MEDIDA,
                        p_c006 => vcantidad,
                        p_c007 => F.AFECTA_MERMA,
                        p_c008 => ( ( nvl( vcantidad, 0 ) * nvl( f.mult, 1 ) ) / nvl( f.divisor, 1 ) ),
                        p_c009 => vfecha,
                        p_c010 => vcosto_unitario,
                        p_c011 => vmonto_total
                        );
                          vcom := 0 ;
                          vexi := existencia (f.id_empresa, f.id_sucursal, f.id_articulo );
                            if ( ( ( nvl( vcom, 0 ) + nvl(vcantidad_ub, 0 ) ) > nvl( vexi, 0 ) ) and
                              	   ( nvl( vafe, 'N' ) = 'S' ) ) then
                              	RAISE_APPLICATION_ERROR(-20000, 'El Articulo ' || f.cod_articulo || ' no posee suficiente existencia para procesar la orden.' ) ;
                              end if ;
                              end if;
                     END LOOP;
                     OPEN l_cursor FOR
                        SELECT C001 AS ID_EMPRESA,
                               c002 as ID_ARTICULO,
                               c003 as ID_SUCURSAL,
                               c004 as ID_LOTE,
                               c005 as ID_UNIDAD_MEDIDA,
                               c006 as cantidad,
                               c007 as AFECTA_MERMA,
                               c008 as CANTIDAD_UB,
                               c009 as FEC_VENCIMIENTO,
                               c010 as COSTO_UNITARIO,
                               c011 as MONTO_TOTAL
                        FROM   APEX_COLLECTIONS
                        Where COLLECTION_NAME = TMP_SERIE;
                      APEX_JSON.initialize_clob_output;
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                      :P516_JSON_DETALLES:=JSON_DETALLE;
                       SELECT SUM(c011)  
                       INTO :P516_TOTAL_PRIMAS 
                       FROM APEX_COLLECTIONS
                      WHERE COLLECTION_NAME = TMP_SERIE;
                    END;
                    ```
                itemsToSubmit: [
                    P516_ID_FORMULA
                    P516_CANT_A_PRODUCIR_ANT
                    P516_CANT_A_PRODUCIR
                    P516_FEC_PRODUCCION
                    ID_ARTICULO
                ]
                itemsToReturn: [
                    P516_JSON_DETALLES
                    P516_TOTAL_PRIMAS
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                        var total=0;
                    var json_detalle = JSON.parse($v('P516_JSON_DETALLES'));
                    console.log(json_detalle);
                    
                    try{
                    
                    
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    var $widget = apex.region("Prima").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    var $newRecord = $model.getRecord(newRecordId);
                    
                    
                    
                    if((json_detalle.DETALLE[i].ID_EMPRESA!=null)){
                        $model.setValue($newRecord, "ID_EMPRESA",(json_detalle.DETALLE[i].ID_EMPRESA).toString());
                    }
                    
                    if((json_detalle.DETALLE[i].ID_ARTICULO!=null)){
                        $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO));
                    }
                    
                    if((json_detalle.DETALLE[i].ID_SUCURSAL!=null)){
                        $model.setValue($newRecord, "ID_SUCURSAL",(json_detalle.DETALLE[i].ID_SUCURSAL));
