                    if((json_detalle.DETALLE[i].AFECTA_MERMA!=null)){
                        $model.setValue($newRecord, "AFECTA_MERMA",(json_detalle.DETALLE[i].AFECTA_MERMA));
                    }
                    
                    if((json_detalle.DETALLE[i].CANTIDAD_UB!=null)){
                        $model.setValue($newRecord, "CANTIDAD_UB",(json_detalle.DETALLE[i].CANTIDAD_UB));
