    dynamicAction set-valor-a-page-item (
        name: SET VALOR A PAGE ITEM
        execution {
            sequence: 310
        }
        when {
            selectionType: columns
            interactiveGrid: @productos-agregados
            columns: CANTIDAD_UB
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :CANTIDAD_UB
                itemsToSubmit: CANTIDAD_UB
            }
            affectedElements {
                selectionType: items
                items: P516_CANTIDAD_UB
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
