    region productos-agregados (
        name: Productos Agregados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_PRODUCCION_CAB,
                       ID_EMPRESA,
                       ID_ARTICULO,
                       CANTIDAD,
                       CANTIDAD_REFERENCIA,
                       COSTO_UNITARIO,
                       COSTO_LISTA,
                       MONTO_TOTAL,
                       MONTO_TOTAL AS MONTO_COPIA,
                       COSTO_PROMEDIO,
                       ID_SUCURSAL,
                       CANTIDAD_UB,
                       ID_UNIDAD_MEDIDA,
                       ID_LOTE,
                       FEC_VENCIMIENTO,
                       NRO_ORDEN,
                       ANULADO,
                       ESTADO,
                       TIPO,
                       AFECTA_MERMA,
                       COSTO_UNITARIO_ME,
                       COSTO_LISTA_ME,
                       MONTO_TOTAL_ME,
                       COSTO_PROMEDIO_ME,
                       IND_MP_FUNDAMENTAL,
                       INDICE
                  from PDW_PRODUCCION_DET
                  WHERE INDICE = 'A'
                  AND id_produccion_cab = :p516_id
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--noPadding
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: Agregados
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 200
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config){
                        config.defaultGridViewOptions = {
                            footer: false
                        }
                
                        $( ".selector" ).grid( {
                    autoAddRecord: false
                } );
                        
                           
                
                
                        config.initActions = function(actions){
                            var rowDelete = actions.lookup("row-delete"),
                                originalDeleteAction = rowDelete.action;
                
                            rowDelete.action = function(_, el){
                                    originalDeleteAction(_, el);
                                    calculaTotales();
                            };    
                        
                
                            var rowRevert = actions.lookup("row-revert"),
                                originalRevertAction = rowRevert.action;
                
                            rowRevert.action = function(_, el){
                                    originalRevertAction(_, el);
                                    calculaTotales();
                            }; 
                
                            var rowRefresh = actions.lookup("row-refresh"),
                                originalRefresthAction = rowRefresh.action;
                
                            rowRefresh.action = function(_, el){
                                   //originalRefreshAction(_, el); esta correcto sea revert. por alguna explicacion que dio el autor.
                                    originalRevertAction(_, el);
                                    calculaTotales();
                            }; 
                
                            
                            var rowDuplicate = actions.lookup("row-duplicate"),
                                originalDuplicateAction = rowDuplicate.action;
                
                            rowDuplicate.action = function(_, el){
                                    originalDuplicateAction(_, el);
                                    calculaTotales();
                            };    
                
                            /*
                             var rowAddRow = actions.lookup("selection-add-row"),
                                originalDuplicateAction = rowAddRow.action;
                
                            rowAddRow.action = function(_, el){
                                 var $widget = apex.region("Detalles").widget();
                               var $grid = $widget.interactiveGrid("getViews", "grid");
                              var $model = $grid.model;
                                var cantidadDet= $model.getTotalRecords();
                                var lineas = $v('P135_LINEAS');
                                if (cantidadDet>lineas){
                                    apex.message.alert('El comprobante solo puede contener '+lineas+'  lineas!');
                                    return;
                                }
                                  var newRecordId=  $model.insertNewRecord();
                                  
                                   $grid.gotoCell(newRecordId,'COD_ARTICULO');
                                   
                            };  
                
                */
                
                /*
                
                            var rowAddRow2 = actions.lookup("row-add-row"),
                                originalDuplicateAction = rowAddRow2.action;
                
                            rowAddRow2.action = function(_, el){
                                 var det=   apex.region("Detalles").widget().interactiveGrid("getCurrentView").model;
                                var cantidadDet= det.getTotalRecords();
                                var lineas = $v('P135_LINEAS');
                                if (cantidadDet>lineas){
                                    apex.message.alert('El comprobante solo puede contener '+lineas+'  lineas!');
                                    return;
                                }
                                    originalDuplicateAction(_, el);
                            }; 
                       
                       */
                                
                
                        } ;      
                        return config;
                }
                ```
        }
