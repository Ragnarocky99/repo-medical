        column ID_ARTICULO (
            type: popupLov
            heading {
                heading: <P>Artículo</P>
                alignment: center
                alternativeLabel: Articulo
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lv-articulos
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: ID_ARTICULO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: varchar2
            }
