page 114 (
    name: IMPRESION REPORTE
    alias: IMPRESION-REPORTE
    title: IMPRESION REPORTE
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bla (
        name: bla
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P114_ZONA (
        type: popupLov
        label {
            label: Zona
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @bsw-zonas-geograficas-cod-zona
        }
        layout {
            sequence: 10
            region: @bla
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button new (
        buttonName: New
        label: BOTON
        layout {
            sequence: 10
            region: @bla
            slot: copy
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @new
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 113
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 113
            }
        }
    )

)

