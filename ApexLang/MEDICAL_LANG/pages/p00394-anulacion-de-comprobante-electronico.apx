    dynamicAction proceso-anulacion (
        name: Proceso anulacion
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @ejecutar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN 
                     FEW_ANULAR_COMPROBANTE_ELECTRONICO(P_ID_EMPRESA           => :P0_ID_EMPRESA,
                                                         P_AMBIENTE_EJECUCION   => :P394_AMBIENTE_EJECUCION,
                                                         P_ID_COMPROBANTE       => :P394_ID_COMPROBANTE,
                                                         P_TIP_COMPROBANTE      => :P394_TIP_COMPROBANTE,
                                                         P_MOTIVO_ANULACION     => :P394_MOTIVO_ANULACION,
                                                         P_RESPUESTA =>:P394_RESPUESTA);
                                                         END;
                    ```
                itemsToSubmit: [
                    P394_AMBIENTE_EJECUCION
                    P394_ID_COMPROBANTE
                    P394_MOTIVO_ANULACION
                    P394_TIP_COMPROBANTE
                ]
                itemsToReturn: P394_RESPUESTA
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction refrescar-reporte (
        name: Refrescar Reporte
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refrescar
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comprobantes-electronicos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process anular-comprobante (
        name: Anular Comprobante
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  FEW_ANULAR_COMPROBANTE_ELECTRONICO(P_ID_EMPRESA           => :P0_ID_EMPRESA,
                                                     P_AMBIENTE_EJECUCION   => :P394_AMBIENTE_EJECUCION,
                                                     P_ID_COMPROBANTE       => :P394_ID_COMPROBANTE,
                                                     P_TIP_COMPROBANTE      => :P394_TIP_COMPROBANTE,
                                                     P_MOTIVO_ANULACION     => :P394_MOTIVO_ANULACION,
                                                     p_respuesta              => :P394_RESPUESTA);
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Operación realizada con éxito.
        }
        advanced {
            executionMappingIdentifier: 63447828569150407
        }
        serverSideCondition {
            type: never
        }
    )

)

