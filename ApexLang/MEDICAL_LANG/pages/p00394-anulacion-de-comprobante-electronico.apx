    region comprobantes-electronicos (
        name: Comprobantes Electronicos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.tip_comprobante,
                       c.ser_comprobante,
                       c.nro_comprobante,
                       c.fec_comprobante,
                       c.nombre_cliente,
                       c.ruc_cliente,
                       c.nro_cdc_fe,
                       c.estado,
                       c.tot_bruto,
                       c.desc_condicion_operacion,
                       case c.estado 
                       WHEN 'A' THEN 'fa fa-check u-success-text'
                       ELSE NULL
                       END AS ICONO_ESTADO,
                       enlace_qr_fe
                  FROM FEWV_FACTURA_CAB C
                 WHERE NVL(C.ind_aprobado_fe, 'X') = 'S'
                   AND C.FEC_COMPROBANTE = :P394_FEC_COMPROBANTE
                 UNION ALL
                 SELECT C.tip_comprobante,
                       c.ser_comprobante,
                       c.nro_comprobante,
                       c.fec_comprobante,
                       c.nombre_cliente,
                       c.ruc_cliente,
                       c.nro_cdc_fe,
                       c.estado,
                       c.tot_bruto,
                       c.desc_condicion_operacion,
                       case c.estado 
                       WHEN 'A' THEN 'fa fa-check u-success-text'
                       ELSE NULL
                       END AS ICONO_ESTADO,
                       enlace_qr_fe
                  FROM FEWV_NOTCRED_CAB C
                 WHERE NVL(C.ind_aprobado_fe, 'X') = 'S'
                   AND C.FEC_COMPROBANTE = :P394_FEC_COMPROBANTE
                UNION ALL
                 SELECT C.tip_comprobante,
                       c.ser_comprobante,
                       c.nro_comprobante,
                       c.fec_comprobante,
                       c.nombre_cliente,
                       c.ruc_cliente,
                       c.nro_cdc_fe,
                       c.estado,
                      0,-- c.tot_bruto,
                       c.descripcion,
                       case c.estado 
                       WHEN 'A' THEN 'fa fa-check u-success-text'
                       ELSE NULL
                       END AS ICONO_ESTADO,
                       enlace_qr_fe
                  FROM FEWV_REMISION_CAB C
                 WHERE NVL(C.ind_aprobado_fe, 'X') = 'S'
                   AND C.FEC_COMPROBANTE = :P394_FEC_COMPROBANTE
                ORDER BY 3 DESC, 4 DESC, 1 ASC
                ```
            pageItemsToSubmit: P394_FEC_COMPROBANTE
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
