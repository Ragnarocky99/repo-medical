    region carga-de-series-de-comprobantes-f-e (
        name: Carga de Series de Comprobantes F.E.
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NUM_INICIAL,
                       NUM_FINAL
                  from FEW_SERIES_COMPROB
                  WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P391_ID (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-series-de-comprobantes-f-e
            slot: regionBody
        }
        source {
            formRegion: @carga-de-series-de-comprobantes-f-e
            column: ID
            dataType: number
