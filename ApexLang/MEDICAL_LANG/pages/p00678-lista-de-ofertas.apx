    region lista-de-ofertas (
        name: Lista de Ofertas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                        CAB.ID,
                        EMP.DESCRIPCION as EMPRESA,
                        CAB.NRO_ORDEN,
                        CAB.NRO_OFERTA,
                        CAB.FEC_OFERTA,
                        CAB.NRO_LICITACION,
                        CAB.NRO_POLIZA,
                        CAB.FEC_POLIZA_INI,
                        CAB.FEC_POLIZA_FIN,
                        CAB.TOT_RESOLUCION,
                        MON.DESCRIPCION AS MONEDA,
                        CAB.TIP_CAMBIO,
                        CAB.DECIMALES,
                        USR.COD_USUARIO as Usuario_Alta, 
                        CAB.FEC_ALTA,
                        CAB.COD_USU_ANU,
                        PER.NOMBRE AS CLIENTE,
                        CAB.NRO_ID,
                        CASE CAB.ESTADO
                          WHEN 'P' THEN 'PENDIENTE'
                          WHEN 'A' THEN 'ANULADO'
                          WHEN 'C' THEN 'CONFIRMADO'
                          WHEN 'N' THEN 'NO ADJUDICADO'
                        END AS ESTADO,
                        CAB.FEC_ESTADO
                  from LCW_OFERTAS_CAB CAB
                  join BSW_EMPRESAS    EMP ON EMP.ID = CAB.ID_EMPRESA
                  JOIN BSW_MONEDAS     MON ON MON.ID = CAB.ID_MONEDA
                  JOIN CCW_CLIENTES    CLI ON CLI.ID = CAB.ID_CLIENTE
                  JOIN BSW_PERSONAS    PER ON PER.ID = CLI.ID_PERSONA
                  JOIN BSW_USUARIOS    USR ON USR.ID = CAB.ID_USUARIO
                  ORDER BY CAB.NRO_ORDEN ASC
                /*SELECT tablespace_name, SUM(bytes)/1024/1024 AS "Size (MB)"
                FROM dba_data_files GROUP BY tablespace_name*/
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P0_ID_SUCURSAL
            value: 690
        }
        link {
            linkColumn: customTarget
            target: {
                page: 679
                items: {
                    P679_ID: \#ID#\
                }
                action: resetPagination
