    region reporte-del-detalle-de-contactos (
        name: Reporte del Detalle de Contactos
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_PERSONA,
                       ES_FISICA,
                       NOMBRE,
                       NOMB_FANTASIA,
                       PRIMER_NOMBRE,
                       SEGUNDO_NOMBRE,
                       ID_PROFESION,
                       ID_CONYUGUE,
                       NACIONALIDAD,
                       ID_SECTOR,
                       DIREC_ELECTRONICA,
                       ID_PAIS,
                       FEC_NACIMIENTO,
                       PAGINA_WED,
                
                       CARGO,
                       RUC,
                       DIRECCION,
                       TELEFONO,
                
                       PAGINA_WEB,
                
                       NRO_CI,
                
                       ID_DEPARTAMENTO
                  from BSW_PERSONAS
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region seguimiento (
        name: SEGUIMIENTO
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select AC.ID,
                       AC.ID_EMPRESA,
                       AC.DEFINICION,
                       AC.FEC_PROX_EVENTO,
                       AC.OBSERVACION,
                       AC.ID_PEDIDO,
                       AC.FEC_CARGA
                  from CLW_ACCIONES_SEGUI AC, VTW_PEDIDOS_CABECERA PC
                WHERE AC.ID_PEDIDO = PC.ID
                AND PC.ID_CLIENTE = :P645_CLIENTE
                ```
            pageItemsToSubmit: P645_CLIENTE
        }
        layout {
            sequence: 10
            parentRegion: @reporte-del-detalle-de-contactos
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 47432571795094515
        }

