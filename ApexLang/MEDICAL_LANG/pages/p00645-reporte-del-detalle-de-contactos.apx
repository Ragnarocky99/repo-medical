page 645 (
    name: Reporte del Detalle de Contactos
    alias: REPORTE-DEL-DETALLE-DE-CONTACTOS
    title: Reporte del Detalle de Contactos
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cotización (
        name: Cotización
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       ID_SUCURSAL,
                       NUM_SOLICITUD_COMPRA,
                       ID_ARTICULO,
                       ID_PROVEEDOR,
                       ID_MONEDA,
                       PRECIO,
                       APROBADO,
                       TIPO_IVA,
                       PORCENTAJE_DESCUENTO,
                       CANTIDAD,
                       COD_ARTICULO_REF,
                       NRO_ITEM,
                       SALDO,
                       OBSERVACION,
                       COTIZA,
                       COD_USUARIO_APRO,
                       CAMBIO,
                       ID_CONDICION_COMPRA,
                       IND_GENERA_OC,
                       IND_ORDEN,
                       MON_COSTO,
                       ID_PEDIDO,
                       ID_TIPO_ENTREGA,
                       PORC_MARGEN,
                       IND_ENVIO,
                       MARGEN_UNITARIO,
                       MARGEN_TOTAL,
                       PRECIO_UNITARIO,
                       PRECIO_TOTAL,
                       ID_USUARIO,
                       ID_SELECCION,
                       CANTIDAD_APROBADA,
                       NRO_OCC,
                       FEC_OCC,
                       CANTIDAD_OCP,
                       IND_ANULADO,
                       DESC_ARTICULO,
                       PRECIO_RECARGO,
                       ID_PEDIDO_DET,
                       COSTO_TOTAL,
                       IND_CLIENTE,
                       CANTIDAD_A_ENTREGAR,
                       CANTIDAD_ENTREGADA
                  from CMW_COTIZA_ARTICULOS
                ```
        }
        layout {
            sequence: 20
            parentRegion: @reporte-del-detalle-de-contactos
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 47433481621094524
        }

