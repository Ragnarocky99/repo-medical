            item: P645_ID
        }
    )

    dynamicAction seteo (
        name: Seteo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P645_CLIENTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT P.ID,
                           P.COD_PERSONA,
                           P.ES_FISICA,
                           P.NOMBRE,
                           P.NOMB_FANTASIA,
                           P.PRIMER_NOMBRE,
                           P.SEGUNDO_NOMBRE,
                           P.ID_PROFESION,
                           P.ID_CONYUGUE,
                           P.NACIONALIDAD,
                           P.ID_SECTOR,
                           P.DIREC_ELECTRONICA,
                           P.ID_PAIS,
                           P.FEC_NACIMIENTO,
                           P.PAGINA_WED,
                           P.CARGO,
                           P.RUC,
                           P.DIRECCION,
                           P.TELEFONO,
                           P.PAGINA_WEB,
                           P.NRO_CI,
                           P.ID_DEPARTAMENTO
                      INTO :P645_ID,
                           :P645_COD_PERSONA,
                           :P645_ES_FISICA,
                           :P645_NOMBRE,
                           :P645_NOMB_FANTASIA,
                           :P645_PRIMER_NOMBRE,
                           :P645_SEGUNDO_NOMBRE,
                           :P645_ID_PROFESION,
                           :P645_ID_CONYUGUE,
                           :P645_NACIONALIDAD,
                           :P645_ID_SECTOR,
                           :P645_DIREC_ELECTRONICA,
                           :P645_ID_PAIS,
                           :P645_FEC_NACIMIENTO,
                           :P645_PAGINA_WED,
                           :P645_CARGO,
                           :P645_RUC,
                           :P645_DIRECCION,
                           :P645_TELEFONO,
                           :P645_PAGINA_WEB,
                           :P645_NRO_CI,
                           :P645_ID_DEPARTAMENTO
                    FROM CCW_CLIENTES C , BSW_PERSONAS p
                    WHERE C.ID_PERSONA = P.ID
                    AND C.ID = :P645_CLIENTE;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro cliente');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de personas');
                    ```
                itemsToSubmit: P645_CLIENTE
                itemsToReturn: [
                    P645_ID
                    P645_COD_PERSONA
                    P645_ES_FISICA
                    P645_NOMBRE
                    P645_NOMB_FANTASIA
                    P645_PRIMER_NOMBRE
                    P645_SEGUNDO_NOMBRE
                    P645_ID_PROFESION
                    P645_ID_CONYUGUE
                    P645_NACIONALIDAD
                    P645_ID_SECTOR
                    P645_DIREC_ELECTRONICA
                    P645_ID_PAIS
                    P645_FEC_NACIMIENTO
                    P645_PAGINA_WED
                    P645_CARGO
                    P645_RUC
                    P645_DIRECCION
                    P645_TELEFONO
                    P645_PAGINA_WEB
                    P645_NRO_CI
                    P645_ID_DEPARTAMENTO
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P645_COD_PERSONA
                    P64
                ]
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

    )

