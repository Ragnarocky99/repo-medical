page 712 (
    name: pagina hecha para desconciliar registro
    alias: PAGINA-HECHA-PARA-DESCONCILIAR-REGISTRO
    title: pagina hecha para desconciliar registro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region desconciliacion (
        name: Desconciliacion
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P712_ID_COMPROBANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @desconciliacion
            slot: regionBody
        }
    )

    pageItem P712_TIP_COMPROBANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @desconciliacion
            slot: regionBody
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-alert (
            action: alert
            settings {
                title: Exito
                message: Todo salio bien liz
            }
            execution {
                sequence: 20
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                     CHW_ACTUALIZA_ESTADO_CONCI_DESCONCILIA(:P712_ID_COMPROBANTE,:P712_TIP_COMPROBANTE);
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

