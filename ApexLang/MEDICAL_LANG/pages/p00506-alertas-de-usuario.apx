page 506 (
    name: Alertas de Usuario
    alias: ALERTAS-DE-USUARIO
    title: Alertas de Usuario
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
            font-family: "Arial", serif;
            font-weight: bold;
            font-size:11.5px;
            color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region grupos-email (
        name: Grupos Email
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                ID,
                COD_GRUPO,
                DESCRIPCION,
                FECHA_ENVIO
                FROM BSW_GRUPOS_EMAIL
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            icon: fa-assistive-listening-systems
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <h2>Grupos</h2>
                
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 68340547487110518
        }

        savedReport 694787 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @FECHA_ENVIO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @COD_GRUPO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRIPCION
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COD_GRUPO (
            type: textField
            heading {
                heading: <p>Cod Grupo</p>
                alignment: center
                alternativeLabel: Cod Grupo
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                maxLength: 80
            }
            source {
                databaseColumn: COD_GRUPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRIPCION (
            type: textarea
            heading {
                heading: <p>Descripcion</p>
                alignment: center
                alternativeLabel: Descripcion
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 400
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column FECHA_ENVIO (
            type: datePicker
            heading {
                heading: <p>Fecha Envio</p>
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: FECHA_ENVIO
                dataType: date
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Grupos Email
        }
    )

    region usuarios-grupos-email (
        name: USUARIOS_GRUPOS_EMAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_USUARIO,
                       ID_GRUPO,
                       E_MAIL,
                       ESTADO,
                       ID_SUCURSAL,
                       TELEFONO
                  from BSW_USUARIOS_GRUPOS_EMAIL
                ```
        }
        layout {
            sequence: 10
            parentRegion: @grupos-email
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @grupos-email
        }
        headerAndFooter {
            headerText:
                ```html
                <h2>Usuario por Grupo</h2>
                
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 68341478518110527
        }

        savedReport 694937 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_USUARIO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ID_GRUPO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @E_MAIL
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ESTADO
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @ID_SUCURSAL
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

            displayColumn (
                column: @TELEFONO
                layout {
                    sequence: 6
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ESTADO (
            type: checkbox
            heading {
                heading: <p>Estado</p>
                alignment: center
                alternativeLabel: Estado
            }
            settings {
                useDefaults: false
                checkedValue: S
                uncheckedValue: N
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column E_MAIL (
            type: textarea
            heading {
                heading: <p>E-Mail</p>
                alignment: center
                alternativeLabel: E-Mail
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: E_MAIL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_GRUPO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_GRUPO
                dataType: number
            }
            masterDetail {
                masterColumn: @ID
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_SUCURSAL (
            type: popupLov
            heading {
                heading: <p>Sucursal</p>
                alignment: center
                alternativeLabel: Sucursal
            }
            lov {
                type: sharedComponent
                lov: @lv-sucursales
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: ID_SUCURSAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ID_USUARIO (
            type: popupLov
            heading {
                heading: <p>Usuario</p>
                alignment: center
                alternativeLabel: Usuario
            }
            lov {
                type: sharedComponent
                lov: @lv-usuarios
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: ID_USUARIO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TELEFONO (
            type: textField
            heading {
                heading: <p>Telefono</p>
                alignment: center
                alternativeLabel: Telefono
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                valuePlaceholder: +595971554987
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: TELEFONO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: USUARIOS_GRUPOS_EMAIL
        }
    )

