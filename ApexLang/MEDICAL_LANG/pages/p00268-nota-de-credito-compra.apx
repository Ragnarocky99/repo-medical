    computation p268-nro-comprobante (
        itemName: P268_NRO_COMPROBANTE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                --Cargo el numero de comprobante si que es no escribio de manera manual 
                DECLARE
                v_nro_comprobante VTW_COMPROBANTES_CABECERA.NRO_COMPROBANTE%TYPE;
                BEGIN
                IF :P268_NRO_COMPROBANTE IS  NULL THEN
                SELECT MAX(NRO_COMPROBANTE)+1
                INTO v_nro_comprobante
                FROM
                CMW_COMPRAS_CABECERA 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND :P268_SER_COMPROBANTE=SER_COMPROBANTE
                AND :P268_TIP_COMPROBANTE=TIP_COMPROBANTE;
                RETURN V_NRO_COMPROBANTE;
                END IF;
                 RETURN :P268_NRO_COMPROBANTE;
                EXCEPTION 
                WHEN NO_DATA_FOUND THEN
                V_NRO_COMPROBANTE:=1;
                RETURN V_NRO_COMPROBANTE;
                WHEN OTHERS THEN 
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                END;
                EXCEPTION WHEN
                OTHERS THEN
                RAISE_APPLICATION_ERROR(-20000,'Error al cargar el numero de comprobante'||sqlerrm);
                ```
        }
        comments {
            comments: "Calculo para calcular el nro comprobante a guardarse si es qque no se escribio un numero de manera manual "
        }
    )

    computation p268-subtotal (
        itemName: P268_SUBTOTAL
        execution {
            sequence: 60
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_cabecera IS SELECT * FROM CMW_COMPRAS_CABECERA
                    WHERE :P268_ID=ID;
                    item_cabecera CMW_COMPRAS_CABECERA%rowtype;
                    v_subtotal   CMW_COMPRAS_CABECERA.TOT_COMPROBANTE%TYPE:=0;
                BEGIN
                  OPEN cursor_CABECERA;
                  LOOP
                    FETCH cursor_cabecera INTO item_cabecera;
                    EXIT WHEN cursor_cabecera%NOTFOUND;
                    v_subtotal:=nvl(item_cabecera.tot_comprobante,0)-nvl(item_cabecera.tot_iva,0);
                  END LOOP;
                  CLOSE cursor_cabecera;
                  RETURN v_subtotal;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P268_ID
        }
    )

