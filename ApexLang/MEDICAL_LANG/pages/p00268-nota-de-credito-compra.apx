    region detalles (
        name: Detalles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select D.ID,
                       D.ID_COMPRAS_CAB,
                       D.ID_ARTICULO,
                       A.COD_ARTICULO,
                       D.CANTIDAD,
                       D.PRECIO_FACTURA,
                       D.PRECIO_UNITARIO,
                       D.MONTO_GASTOS,
                       D.MONTO_TOTAL,
                       D.TOTAL_IVA,
                       D.MONTO_REF,
                       D.MONTO_GASTOS_REF,
                       D.COD_USUARIO_AUD,
                       D.CANTIDAD_UB,
                       D.ID_UNIDAD_MEDIDA,
                       D.NRO_LOTE,
                       D.FEC_VENC,
                       D.ID_LOTE,
                       D.ID_CENTRO_COSTO,
                       D.ID_IVA,
                       D.DESCRIPCION,
                       D.OBSERVACION,
                       D.ID_CUENTA,
                       D.MONTO_TOTAL_C_IVA,
                       D.IND_STOCK,
                       D.ID_PEDIDO_CAB,
                       D.IND_CONSIGNACION,
                       D.PRECIO_UNITARIO_C_IVA,
                       D.PORC_DESCUENTO,
                       D.DESCUENTO,
                       D.DESCUENTO_C_IVA,
                       D.PORC_DESCUENTO_2,
                       D.DESCUENTO_2,
                       D.DESCUENTO_C_IVA_2,
                       D.PORC_GRAVADA,
                       D.IVA,
                       D.EXENTO,
                       D.GRAVADA,
                       D.TOTAL_EXENTO,
                       D.TOTAL_GRAVADA,
                       D.DESC_ARTICULO,
                       D.ID_BARRA,
                       D.ID_PEDIDO_DET
                  from CMW_COMPRAS_DETALLE D,STW_ARTICULOS A
                 where ID_COMPRAS_CAB=:P268_ID
                 AND A.ID=D.ID_ARTICULO
                ```
            pageItemsToSubmit: P268_ID
        }
