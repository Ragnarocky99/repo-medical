        action p268-nom-proveedor (
            name: P268_NOM_PROVEEDOR
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_nombre_proveedor  BSW_PERSONAS.NOMBRE%TYPE;
                    BEGIN
                    select ltrim(p.nombre) nombre
                    INTO v_nombre_proveedor from bsw_personas p, cmw_proveedores v 
                     where v.id_empresa = :P0_COD_EMPRESA
                     and v.id_persona = p.ID 
                     AND V.ID=:P268_ID_PROVEEDOR;
                    RETURN v_nombre_proveedor;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN 
                    return null;
                    when others then
                    raise_application_error(-20000,'Error en la tabla de proveedores'||sqlerrm);
                    return null;
                    END;
                    ```
                itemsToSubmit: P268_ID_PROVEEDOR
            }
            affectedElements {
                selectionType: items
                items: P268_NOM_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-factura-lv (
        name: Cargar Factura LV
        execution {
            sequence: 230
        }
        when {
            selectionType: items
            items: P268_LISTA_FACTURAS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      v_contador number(18);
                    BEGIN
                      IF :P268_LISTA_FACTURAS IS NOT NULL THEN
                        SELECT ID /*ID_CLIENTE*/,
                               ID_CONDICION_COMPRA,
                               ID_MONEDA,
                               TOT_COMPROBANTE * -1,
                               TOT_EXENTAS * -1,
                               TOT_IVA * -1,
                               NRO_TIMBRADO,
                               FEC_VENC_TIMBRADO,
                               ID_PROVEEDOR,
                               REFERENCIA
                          INTO :P268_ID_COMPROBANTE_REF /*:P161_ID_CLIENTE*/,
                               :P268_ID_CONDICION_COMPRA,
                               :P268_ID_MONEDA,
                               :P268_TOT_COMPROBANTE,
                               :P268_TOT_EXENTAS,
                               :P268_TOT_IVA,
                               :P268_NRO_TIMBRADO,
                               :P268_FEC_VENC_TIMBRADO,
                               :P268_ID_PROVEEDOR,
                               :P268_REFERENCIA_NC
                          FROM CMW_COMPRAS_CABECERA
                         WHERE ID = :P268_LISTA_FACTURAS;
                        SELECT count(*)
                          into v_contador
                          from CMW_COMPRAS_CABECERA
                         where ID_COMPROBANTE_REF = :P268_ID_COMPROBANTE_REF;
                        IF v_contador > 0 then
                          raise_application_error(-20000,
                                                  'Esta factura ya cuenta con nota de credito');
                        END IF;
                      ELSE
                        :P268_FEC_VENC_TIMBRADO := last_day(trunc(sysdate));
                        :P268_ID_MONEDA         := W_BUSCA_PARAMETRO('BS', 'COD_MONEDA_GS');
                      end if;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        raise_application_error(-20000, 'No se encontro comprobante');
                        null;
                      WHEN OTHERS THEN
                        raise_application_error(-20000, 'Error ' || sqlerrm);
                        NULL;
                    END;
                    
                    ```
                itemsToSubmit: P268_LISTA_FACTURAS
                itemsToReturn: [
                    P268_ID_COMPROBANTE_REF
                    P268_ID_CONDICION_COMPRA
                    P268_ID_MONEDA
                    P268_TOT_COMPROBANTE
                    P268_TOT_EXENTAS
                    P268_TOT_IVA
                    P268_NRO_TIMBRADO
                    P268_FEC_VENC_TIMBRADO
                    P268_REFERENCIA_NC
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    SELECT TIP_COMPROBANTE,SER_COMPROBANTE,NRO_COMPROBANTE  
                    INTO :P268_TIP_COMPROBANTE_REF,:P268_SER_COMPROBANTE_REF,:P268_NRO_COMPROBANTE_REF
                    FROM CMW_COMPRAS_CABECERA
                    WHERE ID=:P268_LISTA_FACTURAS;
                    EXCEPTION
                    WHEN OTHERS THEN
                    NULL;
                    END;
                    ```
                itemsToSubmit: P268_LISTA_FACTURAS
                itemsToReturn: [
                    P268_NRO_COMPROBANTE_REF
                    P268_SER_COMPROBANTE_REF
                    P268_TIP_COMPROBANTE_REF
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      l_cursor SYS_REFCURSOR;
                      json_detalle CLOB;
                    BEGIN
                    
                    
                      
                      OPEN l_cursor FOR
                     SELECT e.ID_ARTICULO AS "ID_ARTICULO",
                               e.CANTIDAD AS "CANTIDAD",
                               nvl(e.PRECIO_UNITARIO,0) AS "PRECIO_UNITARIO",
                               nvl(E.DESCUENTO,0) DESCUENTO,
                               nvl(E.MONTO_TOTAL,0) MONTO_TOTAL,
                               NVL(E.TOTAL_IVA,0) TOTAL_IVA,
                               NVL(E.CANTIDAD_UB,0) CANTIDAD_UB,
                               NVL(E.ID_UNIDAD_MEDIDA,83) ID_UNIDAD_MEDIDA,
                               NVL(E.NRO_LOTE,'0') NRO_LOTE,
                               NVL(E.IVA,0) IVA,
                               E.ID_LOTE,
                               NVL(E.PRECIO_UNITARIO_C_IVA,0) PRECIO_UNITARIO_C_IVA,
                               nvl(E.DESCUENTO_C_IVA,0) DESCUENTO_C_IVA,
                               NVL(E.ID_IVA,64) ID_IVA,
                               NVL(E.MONTO_TOTAL_C_IVA,0) MONTO_TOTAL_C_IVA,
                               A.COD_ARTICULO,
                               A.DESCRIPCION AS DESC_ARTICULO,
                               E.ID_PEDIDO_DET
                        FROM   CMW_COMPRAS_DETALLE E,STW_ARTICULOS A
                        WHERE  ID_COMPRAS_CAB=:P268_ID_COMPROBANTE_REF
                        AND    E.ID_ARTICULO=A.ID ;
                    
                      APEX_JSON.initialize_clob_output;
                    
                      APEX_JSON.open_object;
                      APEX_JSON.write('DETALLE', l_cursor);
                      APEX_JSON.close_object;
                    
                      JSON_DETALLE:=APEX_JSON.GET_CLOB_OUTPUT;
                    
                      :P268_JSON_DETALLES:=JSON_DETALLE;
                      EXCEPTION
                      WHEN OTHERS THEN 
                      NULL;
                    
                    END;
                    ```
                itemsToSubmit: P268_ID_COMPROBANTE_REF
                itemsToReturn: P268_JSON_DETALLES
                showProcessing: true
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var orden =0;
                    var json_detalle = JSON.parse($v('P268_JSON_DETALLES'));
                    var $widget = apex.region("Detalles").widget();
                    var $grid = $widget.interactiveGrid("getViews", "grid");
                    var $model = $grid.model;
                    $model.clearData();
                    
                    
                    
                    //console.log(json_detalle);
                    if ((Object.keys(json_detalle.DETALLE).length)!=0){
                    
                    
                    for(let i=0;i<json_detalle.DETALLE.length;i++){
                    
                    console.log(json_detalle.DETALLE.length);
                    //Con este codigo podemos insertar una nueva fila en el detalle de comprobantes 
                    
                    
                         $grid.setEditMode(true);
                    //insert new record on a model
                    var newRecordId = $model.insertNewRecord();
                    
                    //continuation of above code
                    //get the new record
                    
                    var $newRecord = $model.getRecord(newRecordId);
                    $model.setValue($newRecord, "ID_ARTICULO",(json_detalle.DETALLE[i].ID_ARTICULO).toString());
                    $model.setValue($newRecord, "CANTIDAD",(json_detalle.DETALLE[i].CANTIDAD*-1).toString());
                    $model.setValue($newRecord, "CANTIDAD_UB",(json_detalle.DETALLE[i].CANTIDAD_UB*-1).toString());
                    $model.setValue($newRecord, "DESCUENTO",(json_detalle.DETALLE[i].DESCUENTO*-1).toString());
                    $model.setValue($newRecord, "DESCUENTO_C_IVA",(json_detalle.DETALLE[i].DESCUENTO_C_IVA*-1).toString());
                    $model.setValue($newRecord, "ID_IVA",(json_detalle.DETALLE[i].ID_IVA).toString());
                    if((json_detalle.DETALLE[i].ID_LOTE!=null)){
                    $model.setValue($newRecord, "ID_LOTE",(json_detalle.DETALLE[i].ID_LOTE).toString());
                    }
                    if((json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA!=null)){
                    $model.setValue($newRecord, "ID_UNIDAD_MEDIDA",(json_detalle.DETALLE[i].ID_UNIDAD_MEDIDA).toString());
                    }
                    $model.setValue($newRecord, "MONTO_TOTAL",(json_detalle.DETALLE[i].MONTO_TOTAL*-1).toString());
                    if((json_detalle.DETALLE[i].NRO_LOTE!=null)){
                    $model.setValue($newRecord, "NRO_LOTE",(json_detalle.DETALLE[i].NRO_LOTE).toString());
                    }
                    $model.setValue($newRecord, "PRECIO_UNITARIO",(json_detalle.DETALLE[i].PRECIO_UNITARIO).toString());
                    $model.setValue($newRecord, "PRECIO_UNITARIO_C_IVA",(json_detalle.DETALLE[i].PRECIO_UNITARIO_C_IVA).toString());
                    $model.setValue($newRecord, "TOTAL_IVA",(json_detalle.DETALLE[i].TOTAL_IVA*-1).toString());
                    $model.setValue($newRecord, "MONTO_TOTAL_C_IVA",(json_detalle.DETALLE[i].MONTO_TOTAL_C_IVA*-1).toString());
                    $model.setValue($newRecord, "PORC_IVA",(json_detalle.DETALLE[i].IVA).toString());
                    $model.setValue($newRecord, "COD_ARTICULO",(json_detalle.DETALLE[i].COD_ARTICULO).toString());
                    $model.setValue($newRecord, "DESC_ARTICULO",(json_detalle.DETALLE[i].DESC_ARTICULO).toString());
                    if((json_detalle.DETALLE[i].ID_PEDIDO_DET!=null)){
                    $model.setValue($newRecord, "ID_PEDIDO_DET",(json_detalle.DETALLE[i].ID_PEDIDO_DET).toString());
                    }
                    console.log(json_detalle.DETALLE[i].COD_ARTICULO);
                    
                    
                    
                    
                    }
                    
                    }
                    
                    ```
            }
            execution {
                sequence: 100
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P268_ID_COMPROBANTE_REF
            }
        )

