        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    IF :P268_ID_COMPROBANTE_REF IS NOT NULL THEN 
                    DECLARE
                        CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                        WHERE :P268_ID_COMPROBANTE_REF=ID_COMPRAS_CAB;
                        item_detalle CMW_COMPRAS_DETALLE%rowtype;
                        v_total_gravadas_10    VTW_COMPROBANTES_CABECERA.TOT_GRAVADAS%TYPE:=0;
                    BEGIN
                      OPEN cursor_detalle;
                      LOOP
                        FETCH cursor_detalle INTO item_detalle;
                        EXIT WHEN cursor_detalle%NOTFOUND;
                        IF( item_detalle.IVA = 10 ) THEN
                         v_total_gravadas_10:=v_total_gravadas_10+item_detalle.monto_total;
                        END IF;
                      END LOOP;
                      CLOSE cursor_detalle;
                      RETURN v_total_gravadas_10*-1;
                      EXCEPTION WHEN 
                      OTHERS THEN
                      RETURN NULL;
                    END;
                    ELSE 
                    RETURN NULL;
                    END IF ;
                    
                    ```
                itemsToSubmit: P268_ID_COMPROBANTE_REF
                escapeSpecialChars: false
            }
            affectedElements {
