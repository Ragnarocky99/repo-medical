    dynamicAction preparar-checksum (
        name: Preparar Checksum
        execution {
            sequence: 290
        }
        when {
            event: click
            selectionType: button
            button: @relacionar-fact
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      TMP_PROVEEDOR CONSTANT VARCHAR2(255) := WWV_FLOW.G_INSTANCE;     -- WWV_FLOW.G_INSTANCE is your user session number and will keep the collections per user session
                    BEGIN
                      IF APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => TMP_PROVEEDOR) THEN
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => TMP_PROVEEDOR);
                      END IF;
                      APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => TMP_PROVEEDOR);
                     
                      APEX_COLLECTION.ADD_MEMBER(
                        p_collection_name => TMP_PROVEEDOR,
                        p_c001 => :P268_ID_PROVEEDOR,
                        p_C002 => replace(:P268_TOT_COMPROBANTE,'.','')*-1,
                        p_c003 => :P268_ID_MONEDA,
                        p_c004 => :P268_ID
                         );
                    END;
                    ```
                itemsToSubmit: [
                    P268_ID_PROVEEDOR
                    P268_TOT_COMPROBANTE
                    P268_ID_MONEDA
                    P268_ID
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //console.log($v('P268_URL_MODAL'));
                    apex.navigation.redirect($v('P268_URL_MODAL'));
                    ```
            }
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression: document
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_checksum varchar2(2000);
                    
                    BEGIN 
                     RETURN  APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':290:'||:APP_SESSION||'::NO::', p_checksum_type => 'SESSION');
                     exception 
                     when others then 
                     RAISE_APPLICATION_ERROR(-20000,'ERROR al filtrar!');
                    END;
                    
                    
                    ```
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P268_URL_MODAL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

