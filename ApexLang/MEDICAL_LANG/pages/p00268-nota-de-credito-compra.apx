    computation p268-id-sucursal (
        itemName: P268_ID_SUCURSAL
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                SELECT ID FROM BSW_SUCURSALES 
                WHERE ID_EMPRESA=:P0_COD_EMPRESA
                AND ID=:P0_COD_SUCURSAL
                ```
        }
    )

    computation p268-iva (
        itemName: P268_IVA_5
        execution {
            sequence: 70
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                    WHERE :P268_ID=ID_COMPRAS_CAB;
                    item_detalle CMW_COMPRAS_DETALLE%rowtype;
                    v_total_iva_5    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 5 ) THEN
                     v_total_iva_5:=v_total_iva_5+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_5;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P268_ID
        }
    )

    computation p268-iva-2 (
        itemName: P268_IVA_10
        execution {
            sequence: 80
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    CURSOR cursor_detalle IS SELECT * FROM CMW_COMPRAS_DETALLE
                    WHERE :P268_ID=ID_COMPRAS_CAB;
                    item_detalle CMW_COMPRAS_DETALLE%rowtype;
                    v_total_iva_10    CMW_COMPRAS_CABECERA.TOT_GRAVADAS%TYPE:=0;
                BEGIN
                  OPEN cursor_detalle;
                  LOOP
                    FETCH cursor_detalle INTO item_detalle;
                    EXIT WHEN cursor_detalle%NOTFOUND;
                    IF( item_detalle.IVA = 10 ) THEN
                     v_total_iva_10:=v_total_iva_10+item_detalle.total_iva;
                    END IF;
                  END LOOP;
                  CLOSE cursor_detalle;
                  RETURN v_total_iva_10;
                  EXCEPTION WHEN OTHERS THEN
                  RETURN NULL;
                END;
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P268_ID
        }
    )

