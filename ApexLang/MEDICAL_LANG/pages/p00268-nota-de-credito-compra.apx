        column ID_LOTE (
            type: popupLov
            heading {
                heading: <p>Lote</p>
                alignment: center
            }
            settings {
                displayAs: modalDialog
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT L.NRO_LOTE,L.ID 
                      FROM STW_LOTES L,
                           STW_EXISTENCIA_ART E
                    WHERE E.ID_EMPRESA  = L.ID_EMPRESA
                      AND E.ID_ARTICULO = L.ID_ARTICULO
                      AND E.ID_LOTE     = L.ID
                      AND L.ID_ARTICULO = :ID_ARTICULO
                      AND E.ID_SUCURSAL = :P268_ID_SUCURSAL
                      AND E.CANT_DISPON > 0
                    ```
            }
            cascadingLov {
                parentColumns: [
                    ID_ARTICULO
                    P268_ID_SUCURSAL
                ]
                itemsToSubmit: [
                    ID_ARTICULO
                    P268_ID_SUCURSAL
                ]
                parentRequired: false
            }
            layout {
                sequence: 440
                columnAlignment: center
            }
            source {
                databaseColumn: ID_LOTE
                dataType: number
            }
            advanced {
                htmlDomId: ID_LOTE
            }
        )

