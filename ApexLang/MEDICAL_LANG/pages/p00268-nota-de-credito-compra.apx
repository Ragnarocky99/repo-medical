    validation validar-fec (
        name: Validar Fec
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  vmensaje varchar2(200);
                begin
                  begin
                    select ver_fecha(:P0_ID_EMPRESA,W_BUSCA_PARAMETRO('CM','ID_MODULO_CM'),:P155_FEC_COMPROBANTE) 
                       into vmensaje
                    from dual;
                  exception
                    when no_data_found then
                      vmensaje := null;
                    when others then
                      vmensaje := null;
                  end;
                  return FALSE;
                end;
                ```
        }
        error {
            errorMessage: Fecha fuera de rango
            associatedItem: @P268_FEC_COMPROBANTE
        }
        serverSideCondition {
            type: never
        }
    )

    validation validar-fecha (
        name: Validar Fecha
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P268_FEC_VENC_TIMBRADO>=:P268_FEC_COMPROBANTE
        }
        error {
            errorMessage: La fecha de vencimiento no puede ser anterior a la fecha de comprobante
            associatedItem: @P268_FEC_VENC_TIMBRADO
        }
        serverSideCondition {
            type: never
        }
    )

