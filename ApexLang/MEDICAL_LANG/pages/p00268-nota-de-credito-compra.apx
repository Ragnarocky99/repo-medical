    dynamicAction after-dialog-close (
        name: AFTER DIALOG CLOSE
        execution {
            sequence: 200
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: button
            button: @carga-rapida-proveedores
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P268_ID_PROVEEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction asiento-click (
        name: ASIENTO_CLICK
        execution {
            sequence: 300
        }
        when {
            event: click
            selectionType: items
            items: P268_ASIENTOS
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P268_ASIENTOS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_app number := v('APP_ID');
                        l_session number := v('APP_SESSION');
                    BEGIN
                        :P268_URL:= APEX_UTIL.PREPARE_URL(
                            p_url => 'f?p=100:235:'||l_session||'::NO::P235_ID:&P268_ASIENTOS_ID.',
                            p_checksum_type => 'SESSION');
                    END;
                    ```
                itemsToSubmit: [
                    P268_URL
                    P268_ASIENTOS_ID
                ]
                itemsToReturn: P268_URL
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: window.location.href = apex.item('P268_URL').getValue();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction buscar-articulo (
        name: Buscar Articulo
        execution {
            sequence: 170
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: COD_ARTICULO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --Cargan los datos del articulo
                    BEGIN
                    SELECT A.ID
                    INTO :ID_ARTICULO
                    FROM STW_ARTICULOS A
                    LEFT JOIN STW_BARRAS B ON A.ID=B.ID_ARTICULO
                    WHERE
                    (COD_ARTICULO=:COD_ARTICULO OR B.COD_BARRA=:COD_ARTICULO) AND
                    A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    ROWNUM=1;
                    END;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                    RAISE_APPLICATION_ERROR(-20000,'No se encontro el articulo');
                    WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20000,'Error en la tabla de articulos');
                    
                    
                    ```
                itemsToSubmit: COD_ARTICULO
                itemsToReturn: ID_ARTICULO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P268_BANDERA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-montos (
        name: CALCULAR_MONTOS
        execution {
            sequence: 40
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: [
                CANTIDAD
                PRECIO_UNITARIO_C_IVA
                PORC_DESCUENTO
            ]
        }
        comments {
            comments: Aqui se van calculando los totales correspondientes  (Monto total con iva , monto total , total iva ,descuentos)
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :PORC_DESCUENTO IS NULL THEN
                    :PORC_DESCUENTO:=0 ;
                    END IF;
                    
                    :DESCUENTO_C_IVA:=REPLACE(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_DESCUENTO/100);
                    
                    ```
                itemsToSubmit: [
                    PORC_DESCUENTO
                    PRECIO_UNITARIO_C_IVA
                ]
                itemsToReturn: DESCUENTO_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :CANTIDAD is null then
                         :CANTIDAD := 1;
                    end if;
                    
                    :CANTIDAD := ABS(:CANTIDAD)* -1;
                    
                    if :PRECIO_UNITARIO_C_IVA is null THEN
                        :PRECIO_UNITARIO_C_IVA    := 0;
                        :TOTAL_IVA := 0;
                        END IF;
                    
                        IF :DESCUENTO_C_IVA IS NULL THEN
                        :DESCUENTO_C_IVA:=0;
                    end if;
                    
                    
                    --:MONTO_TOTAL_C_IVA :=round(replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)),:P268_DECIMALES);
                    IF :DESCUENTO_C_IVA IS NOT NULL AND :DESCUENTO_C_IVA!=0 THEN 
                    :P268_DESCUENTO_V:=round(replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0),:P268_DECIMALES);
                    END IF;
                    --:MONTO_TOTAL_C_IVA:=:CANTIDAD * :PRECIO_UNITARIO_C_IVA;
                    
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    CANTIDAD
                    DESCUENTO_C_IVA
                    P268_DECIMALES
                ]
                itemsToReturn: [
                    MONTO_TOTAL
                    MONTO_TOTAL_C_IVA
                    P268_DESCUENTO_V
                    CANTIDAD
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode: :MONTO_TOTAL_C_IVA :=round(replace(:CANTIDAD, '.', '') * (replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)),:P268_DECIMALES);
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    DESCUENTO_C_IVA
                    P268_DECIMALES
                ]
                itemsToReturn: MONTO_TOTAL_C_IVA
                showProcessing: true
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-4 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null  then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    if :TOTAL_IVA is null then
                       :TOTAL_IVA := 0;
                    end if;
                    
                    :TOTAL_IVA := round((((replace(:PRECIO_UNITARIO_C_IVA, '.', '')-NVL(:DESCUENTO_C_IVA,0)) * replace(:CANTIDAD, '.', '')) * :PORC_IVA ) / (100 + :PORC_IVA),:P268_DECIMALES);
                    ```
                itemsToSubmit: [
                    CANTIDAD
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                    DESCUENTO_C_IVA
                    P268_DECIMALES
                ]
                itemsToReturn: TOTAL_IVA
                showProcessing: true
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-5 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :MONTO_TOTAL is null  then
                       :MONTO_TOTAL:= 0;
                    end if;
                    
                    
                    --:MONTO_TOTAL :=:MONTO_TOTAL_C_IVA -:IVA;
                    :MONTO_TOTAL := round((replace(:MONTO_TOTAL_C_IVA, '.', '') - replace(:TOTAL_IVA, '.', '')),:P268_DECIMALES);
                    ```
                itemsToSubmit: [
                    MONTO_TOTAL_C_IVA
                    TOTAL_IVA
                    P268_DECIMALES
                ]
                itemsToReturn: MONTO_TOTAL
                showProcessing: true
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-6 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_precio_unitario number;
                    begin
                    IF :PRECIO_UNITARIO IS NULL THEN
                    :PRECIO_UNITARIO:=0;
                    END IF;
                    
                     v_precio_unitario:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')*(:PORC_IVA/(100+:PORC_IVA)),:P268_DECIMALES);
                     :PRECIO_UNITARIO:=round(replace(:PRECIO_UNITARIO_C_IVA,'.','')-v_precio_unitario,:P268_DECIMALES);
                     end;
                    ```
                itemsToSubmit: [
                    PRECIO_UNITARIO_C_IVA
                    PORC_IVA
                ]
                itemsToReturn: PRECIO_UNITARIO
                showProcessing: true
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: recalculaImporte();
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

    )

    dynamicAction cambiar-factura-proveedor (
        name: Cambiar Factura Proveedor
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: [
                P268_VALOR3
                P268_VALOR2
                P268_VALOR1
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    nvl(:P268_VALOR1,'001')||'-'||nvl(:P268_VALOR2,'001')
                    	                        ||'-'||LPAD(:P268_VALOR3,7,'0')
                    ```
                itemsToSubmit: [
                    P268_VALOR1
                    P268_VALOR2
                    P268_VALOR3
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P268_REFERENCIA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cargar-datos-proveedor (
        name: Cargar Datos Proveedor
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P268_ID_PROVEEDOR
        }

        action p268-id-proveedor-ref (
            name: P268_ID_PROVEEDOR_REF
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P268_ID_PROVEEDOR
                itemsToSubmit: P268_ID_PROVEEDOR
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P268_ID_PROVEEDOR_REF
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action p268-ind-exento (
            name: P268_IND_EXENTO
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
