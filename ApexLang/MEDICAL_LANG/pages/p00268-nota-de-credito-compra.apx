    process detalles-save-interactive-grid-data (
        name: Detalles - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                begin
                
                    case :APEX$ROW_STATUS
                            when 'C' then
                
                
                             
                
                             --SELECT REPLACE(:TOTAL_IVA,'.','') INTO :TOTAL_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL_C_IVA,'.','') INTO :MONTO_TOTAL_C_IVA  FROM DUAL;
                              --SELECT REPLACE(:MONTO_TOTAL,'.','') INTO :MONTO_TOTAL  FROM DUAL;
                
                               
                               IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                             :DESCUENTO:=(NVL(:DESCUENTO_C_IVA,0))-(NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0))));   
                             :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              END IF;
                
                                insert into CMW_COMPRAS_DETALLE 
                                (ID_ARTICULO,ID_COMPRAS_CAB,CANTIDAD,ID_IVA,TOTAL_IVA,MONTO_TOTAL_C_IVA,
                                PRECIO_UNITARIO_C_IVA,PRECIO_UNITARIO,ID_UNIDAD_MEDIDA,COD_USUARIO_AUD,MONTO_TOTAL,IVA,PORC_DESCUENTO
                                ,ID_LOTE,NRO_LOTE,DESCUENTO_C_IVA,DESCUENTO,DESC_ARTICULO, ID_BARRA)
                                values(:ID_ARTICULO,:P268_ID,:CANTIDAD,:ID_IVA,REPLACE(:TOTAL_IVA,'.',''),
                                REPLACE(:MONTO_TOTAL_C_IVA,'.',''),REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                REPLACE(:PRECIO_UNITARIO,'.',''),:ID_UNIDAD_MEDIDA,:COD_USUARIO_AUD,
                                REPLACE(:MONTO_TOTAL,'.',''),:PORC_IVA,:PORC_DESCUENTO,
                                :ID_LOTE,:NRO_LOTE,REPLACE(:DESCUENTO_C_IVA,'.',''),REPLACE(:DESCUENTO,'.',''),:DESC_ARTICULO ,:ID_BARRA);
                            
                
                
                
                
                
                
                
                
                            WHEN 'U' then  
                         
                                IF :DESCUENTO_C_IVA IS NOT NULL AND :PORC_IVA IS NOT NULL 
                               THEN 
                                 
                             :DESCUENTO:=NVL(REPLACE(:DESCUENTO_C_IVA,'.',''),0)*(NVL(:PORC_IVA,0)/(100+NVL(:PORC_IVA,0)));   
                              :DESCUENTO_C_IVA:=NVL(:DESCUENTO_C_IVA,0)*NVL(:CANTIDAD,0);
                
                              END IF;
                
                 
                
                                update CMW_COMPRAS_DETALLE  d
                                    set  ID_ARTICULO = :ID_ARTICULO,
                                         cantidad     = :cantidad,
                                         precio_unitario_c_iva       = REPLACE(:PRECIO_UNITARIO_C_IVA,'.',''),
                                         id_iva     = :ID_IVA,
                                         TOTAL_IVA    = REPLACE(:TOTAL_IVA,'.',''),
                                         monto_total  = REPLACE(:MONTO_TOTAL,'.',''),
                                         MONTO_TOTAL_C_IVA      = REPLACE(:MONTO_TOTAL_C_IVA,'.',''),
                                         PRECIO_UNITARIO=REPLACE(:PRECIO_UNITARIO,'.',''),
                                         ID_UNIDAD_MEDIDA=:ID_UNIDAD_MEDIDA,
                                         IVA=:IVA,
                                         PORC_DESCUENTO=:PORC_DESCUENTO,
                                         ID_LOTE=:ID_LOTE,
                                         NRO_LOTE=:NRO_LOTE,
                                         DESCUENTO_C_IVA=:DESCUENTO_C_IVA,
                                         DESCUENTO=:DESCUENTO,
                                         DESC_ARTICULO=:DESC_ARTICULO,
                                         ID_BARRA = :ID_BARRA
                
                                where   d.ID_COMPRAS_CAB = :P268_ID
                                    and d.id = :id;
                
                           when 'D' then
                                delete CMW_COMPRAS_DETALLE d     
                                WHERE d.ID_COMPRAS_CAB = :ID_COMPRAS_CAB
                                           and d.id = :id;  
                    end case;
                                         
                
                END;
                
                ```
        }
        lockRow {
            preventLostUpdates: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 25743261556953770
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments: "Proceso para guardar, actualizar, eliminar los detalles de la factura "
        }
    )

