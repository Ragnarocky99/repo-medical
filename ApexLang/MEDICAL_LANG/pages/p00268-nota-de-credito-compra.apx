    dynamicAction setear-precios-y-lote (
        name: Setear Precios y Lote
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @detalles
            columns: ID_ARTICULO
        }
        comments {
            comments: "Al seleccionar un producto setea su precio y lote correspondiente si es que tienen "
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :PRECIO_UNITARIO_C_IVA is null then
                         :PRECIO_UNITARIO_C_IVA :=0;
                    end if;
                    if :IVA IS NULL THEN
                    :IVA:=0;
                    END IF;
                    
                    
                    BEGIN
                    SELECT NVL(MAX(PRECIO),0)
                    INTO :PRECIO_UNITARIO_C_IVA
                    FROM CMWV_PROVEEDORES_ARTICULOS
                    WHERE ID_PROVEEDOR=:P268_ID_PROVEEDOR
                    AND ID_ARTICULO=:ID_ARTICULO;
                    
                    SELECT ID_UNIDAD_MEDIDA
                    INTO :ID_UNIDAD_MEDIDA
                    FROM STW_ARTICULOS
                    WHERE ID=:ID_ARTICULO;
                    
                    SELECT -1
                    INTO :CANTIDAD 
                    FROM DUAL;
                    
                    END;
                    
                    
                        
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P268_FEC_COMPROBANTE
                    P268_ID_PROVEEDOR
                ]
                itemsToReturn: [
                    PRECIO_UNITARIO_C_IVA
                    ID_IVA
                    IVA
                    PORC_IVA
                    CANTIDAD
                    ID_UNIDAD_MEDIDA
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                    v_maneja_lote varchar(1);
                    BEGIN
                    IF NVL(:P268_IND_EXENTO,'N')='N' THEN 
                    SELECT NVL(IND_MANEJA_LOTE,'X')
                    into v_maneja_lote
                    from stw_articulos 
                    where id=:id_articulo ;
                    
                    --IF V_MANEJA_LOTE='S' THEN
                    SELECT L.ID,L.ID_IVA,I.PORC_IVA_VENTA,MAX(L.NRO_LOTE)
                    INTO :ID_LOTE,:ID_IVA,:PORC_IVA,:NRO_LOTE
                    FROM STW_LOTES L,STW_IVA I
                    WHERE L.ID_ARTICULO=:ID_ARTICULO
                    AND  L.ID_IVA=I.ID
                    AND FEC_VENCIMIENTO>=SYSDATE
                    and rownum = 1
                    GROUP BY L.ID,L.ID_IVA,I.PORC_IVA_VENTA;
                    /*ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;*/
                    --END IF;
                    ELSE 
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I WHERE 
                    COD_IVA=W_BUSCA_PARAMETRO('ST','COD_IVA_EXENTA');
                    END IF;
                    EXCEPTION WHEN
                    NO_DATA_FOUND THEN
                    SELECT  I.ID,I.PORC_IVA_VENTA 
                    INTO :ID_IVA,:PORC_IVA
                    FROM STW_IVA I,STW_ARTICULOS  A
                    WHERE A.ID_EMPRESA=:P0_COD_EMPRESA AND
                    A.ID=:ID_ARTICULO AND
                    A.ID_IVA=I.ID;
                    END;
                    
                    ```
                itemsToSubmit: [
                    ID_ARTICULO
                    P268_IND_EXENTO
                ]
                itemsToReturn: [
                    ID_LOTE
                    ID_IVA
                    PORC_IVA
                    NRO_LOTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("Detalles").call("getViews").grid;
                    var array = grid.getSelectedRecords();
                    grid.gotoCell(array[0][0],'COD_ARTICULO');
                    
                    ```
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P268_BANDERA
                value: 0
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DESCRIPCION FROM 
                    STW_ARTICULOS WHERE
                    ID=:ID_ARTICULO 
                    ```
                itemsToSubmit: ID_ARTICULO
            }
            affectedElements {
                selectionType: columns
                columns: DESC_ARTICULO
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT COD_ARTICULO FROM STW_ARTICULOS
                    WHERE ID_EMPRESA=:P0_COD_EMPRESA
                    AND ID=:ID_ARTICULO
                    ```
                itemsToSubmit: ID_ARTICULO
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: columns
                columns: COD_ARTICULO
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                value: 0
            }
            affectedElements {
                selectionType: items
                items: P268_BANDERA
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

