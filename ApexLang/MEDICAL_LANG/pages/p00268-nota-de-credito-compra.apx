    region nota-de-credito-compra (
        name: Nota de Credito-Compra
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_EMPRESA,
                       TIP_COMPROBANTE,
                       SER_COMPROBANTE,
                       NRO_COMPROBANTE,
                       ID_SUCURSAL,
                       FEC_COMPROBANTE,
                       ID_PROVEEDOR,
                       ID_CONDICION_COMPRA,
                       TIP_COMPROBANTE_REF,
                       SER_COMPROBANTE_REF,
                       NRO_COMPROBANTE_REF,
                       TOT_COMPROBANTE,
                       TOT_GRAVADAS,
                       TOT_EXENTAS,
                       TOT_IVA,
                       DESCUENTO,
                       ID_MONEDA,
                       TIP_CAMBIO,
                       ESTADO,
                       FEC_ESTADO,
                       ID_USUARIO,
                       FEC_ALTA,
                       REFERENCIA,
                       ID_PROVEEDOR_REF,
                       NOM_PROVEEDOR,
                       RUC,
                       TOT_AJUSTE,
                       COD_USUARIO_AUD,
                       ID_EMBARQUE,
                       IND_CAJA_CHICA,
                       NRO_TIMBRADO,
                       ASIENTOS,
                       NRO_COMPROBANTE_PROV,
                       ID_CENTRO_COSTO,
                       IND_GENERA_ASIENTO,
                       ID_CUENTA,
                       ID_TIMBRADO,
                       ID_MOTIVO_NCR,
                       ID_COMPROBANTE_REF,
                       PATH_FACTURA,
                       NOMBRE_CORTO,
                       ID_RECEPCION,
                       ID_SUCURSAL_CENTRAL,
                       ID_ANTERIOR,
                       ID_SUBTIP_DENOMINACION,
                       FEC_VENC_TIMBRADO,
                       ID_CONCEPTO,
                       OBSERVACION,
                       IND_EXENTO,
                       REFERENCIA_NC
                  from CMW_COMPRAS_CABECERA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--stacked
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            htmlDomId: Contenedor
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: 55428634601297024
            update: 56243996402722600
            delete: 56244618200733624
        }
    )

