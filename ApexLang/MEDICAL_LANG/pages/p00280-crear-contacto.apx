                      $("body").removeClass('loading');
                     
                    
                    
                    $s('P280_RESPUESTA',JSON.parse(this.responseText).status);
                    $.event.trigger('Alerta');
                     // console.log(this.responseText);
                    }
                    
                    
                    const formData = new FormData();
                    
                    console.log(API_SECRET);
                    formData.append("secret", API_SECRET);
                    formData.append('name',$v('P280_NOMBRE'));
                    formData.append('phone',$v('P280_NUMERO'));
                    formData.append('groups',$v('P280_GRUPO').replace(/:/g,','));
                    
                    // HTML file input, chosen by user
                    
                     
                       // document.getElementById("overlay__spinner").innerHTML = '<img src="#APP_FILES#Spinner-1s-200px (1).gif" />'; // Set here the image before sending request
                       
                    $("body").addClass('loading');
                    
                    
                    const request = new XMLHttpRequest();
                    request.addEventListener("load", reqListener);
                    request.open("POST", "https://flow.cnid.com.py/api/create/contact");
                    request.send(formData);
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction mensaje-de-respuesta (
        name: Mensaje de Respuesta
        execution {
            sequence: 50
        }
        when {
            event: custom
            customEvent: Alerta
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action native-alert (
            action: alert
            settings {
                message: Proceso realizado de manera correcta
                style: success
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P280_RESPUESTA
                value: 200
            }
        )

        action native-alert-2 (
            action: alert
            settings {
                message: Clave de API es invalido !
                style: danger
                icon: fa-warning
            }
            execution {
