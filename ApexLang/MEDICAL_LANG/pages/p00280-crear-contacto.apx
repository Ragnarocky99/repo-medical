    dynamicAction ocultar (
        name: Ocultar
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P280_IMAGEN
                    P280_DOCUMENTO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ocultar-desocultar (
        name: Ocultar/Desocultar
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P280_TIPO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
