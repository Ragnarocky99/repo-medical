    dynamicAction setear-vendedor (
        name: Setear Vendedor
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P750_ID_CLIENTE
        }

        action p750-id-vendedor (
            name: P750_ID_VENDEDOR
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ID_VENDEDOR
                      FROM CCW_CLIENTES
                     WHERE ID = :P750_ID_CLIENTE
                    ```
                itemsToSubmit: P750_ID_CLIENTE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P750_ID_VENDEDOR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation tener-al-menos-una-tarea (
        name: Tener al menos una tarea
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM CLW_GESTOR_TAREAS
                 WHERE ID_AGENDA = :P750_ID
                ```
        }
        error {
            errorMessage: Debe tener al menos definida una tarea para poner como Realizado
        }
        serverSideCondition {
            type: item=value
            item: P750_ESTADO
            value: REA
        }
    )

