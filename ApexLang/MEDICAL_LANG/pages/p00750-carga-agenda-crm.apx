page 750 (
    name: Carga Agenda CRM
    alias: CARGA-AGENDA-CRM
    title: Carga Agenda CRM
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region agenda (
        name: Agenda
        type: form
        source {
            location: localDatabase
            tableName: CLW_AGENDA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--noPadding
                t-Form--stretchInputs
            ]
        }
    )

    region participantes (
        name: Participantes
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CLW_AGENDA_PARTICIPANTES
            whereClause: ID_AGENDA = :P750_ID
            pageItemsToSubmit: P750_ID
        }
        layout {
            sequence: 20
            parentRegion: @agenda
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                margin-top-lg
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 27599310255429833
        }

        savedReport 276755 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID_AGENDA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ID_PERSONA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_AGENDA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_AGENDA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID_PERSONA (
            type: popupLov
            heading {
                heading: <p>Persona</p>
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @lv-personas
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_PERSONA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Participantes
        }
    )

    region tareas (
        name: Tareas
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CLW_GESTOR_TAREAS
