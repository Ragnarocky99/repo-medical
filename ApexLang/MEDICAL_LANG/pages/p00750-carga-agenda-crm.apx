    process guardar-coleccion (
        name: Guardar coleccion
        type: executeCode
        editableRegion: @tareas
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VNRO_TAREA CLW_GESTOR_TAREAS.NRO_TAREA%TYPE;
                BEGIN
                    SELECT NVL(MAX(NRO_TAREA), 0) + 1
                      INTO VNRO_TAREA
                      FROM CLW_GESTOR_TAREAS
                     WHERE ID_EMPRESA = :P0_ID_EMPRESA;
                    IF :APEX$ROW_STATUS = 'C' THEN
                        APEX_COLLECTION.add_member(
                            p_collection_name => 'TAREAS_COL',
                            p_n001            => VNRO_TAREA
                        );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 65810210303809725
        }
    )

