    process nro-tarea (
        name: Nro. Tarea
        type: executeCode
        editableRegion: @tareas
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    VNRO_TAREA CLW_GESTOR_TAREAS.NRO_TAREA%TYPE;
                    VSEQ_ID    NUMBER := 1;
                BEGIN
                    IF :APEX$ROW_STATUS = 'C' THEN
                        SELECT N001
                          INTO VNRO_TAREA
                          FROM APEX_COLLECTIONS
                         WHERE COLLECTION_NAME = 'TAREAS_COL'
                           AND SEQ_ID = VSEQ_ID;
                
                        :NRO_TAREA := VNRO_TAREA;
                
                        APEX_COLLECTION.update_member(
                            p_collection_name => 'TAREAS_COL',
                            p_seq             => VSEQ_ID,
                            p_n001            => VNRO_TAREA + 1
                        );
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 65810045086809723
        }
    )

