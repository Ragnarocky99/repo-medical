        }
    )

    pageItem P750_ESTADO (
        type: selectList
        label {
            label: <p>Estado:&ensp;</p>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DESCRIPCION, COD_ESTADO
                  FROM CLW_AGENDA_ESTADOS
                 WHERE IND_SELECCIONABLE = 'S'
                   AND :P750_IND_FINALIZADO = 'N'
                UNION ALL
                SELECT DESCRIPCION, COD_ESTADO
                  FROM CLW_AGENDA_ESTADOS
                 WHERE IND_SELECCIONABLE = 'N'
                   AND :P750_IND_FINALIZADO = 'S'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @agenda
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @agenda
            column: ESTADO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: PEN
        }
        readOnly {
            type: expression
            plsqlExpression:
                ```plsql
                :P750_IND_FINALIZADO = 'S' AND
                W_BUSCA_PERMISO(P_ID_EMPRESA => :P0_ID_EMPRESA,
                                P_PAGINA     => :APP_PAGE_ID,
                                P_ID_USUARIO => TRAE_ID_USUARIO(:P0_ID_EMPRESA, :APP_USER),
                                P_PERMISO    => 'MODIFICAR_ESTADO_AGENDAMIENTO') = 'N'
                ```
        }
    )

