page 446 (
    name: Carga de Colores
    alias: CARGA-DE-COLORES
    title: Carga de Colores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-colores (
        name: Carga de Colores
        type: form
        source {
            location: localDatabase
            tableName: STW_COLORES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P446_ABREVIATURA (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-colores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-colores
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P446_COD_COLOR (
        type: displayOnly
        label {
            label: <p>Código: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 10
            region: @carga-de-colores
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        source {
            formRegion: @carga-de-colores
            column: COD_COLOR
            dataType: varchar2
        }
    )

    pageItem P446_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción: &ensp;</p>
            alignment: left
        }
        layout {
            sequence: 30
            region: @carga-de-colores
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 60
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @carga-de-colores
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P446_ID (
        type: hidden
        layout {
            sequence: 20
            region: @carga-de-colores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-colores
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P446_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-colores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-colores
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: item
            item: P0_ID_EMPRESA
        }
    )

    pageItem P446_IND_GENERAR (
        type: hidden
        layout {
            sequence: 10
            region: @carga-de-colores
            slot: regionBody
        }
        source {
            formRegion: @carga-de-colores
            column: IND_GENERAR
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P446_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P446_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P446_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p446-cod-color (
        itemName: P446_COD_COLOR
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_COLOR)), 0) + 1
                  FROM STW_COLORES
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P446_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 44770768749279485
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-carga-de-colores (
        name: Initialize form Carga de Colores
        type: formInitialization
        formRegion: @carga-de-colores
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44769903444279484
        }
    )

    process process-form-carga-de-colores (
        name: Process form Carga de Colores
        type: formAutoRowProcessing
        formRegion: @carga-de-colores
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 44770398331279485
        }
    )

)

