page 66 (
    name: Carga de Grupos de Articulos
    alias: STGRUPOSF
    title: Carga de Grupos de Articulos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            
            .cambio{
                vertical-align: middle;
                border-style: dashed;
                border-width: thin;
                border-color: #afa9a9;
                background-color:#eeeeee;
                pointer-events: none;
            }
            .mostrar{
                background-color:#eeeeee;
                width: 171px;
                height: 23px;
                vertical-align: bottom;
                border-style: dashed;
                font-weight: lighter;
                font-size: 13px;
                text-align: center;
                border-width: thin;
                border-color: #afa9a9;
            }
            
            ```
    }
    security {
        authorizationScheme: @derecho-pagina-3
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region carga-de-grupos-de-articulos (
        name: Carga de Grupos de Articulos
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       COD_GRUPO_ART,
                       DESCRIPCION,
                       ABREVIATURA,
                       ID_EMPRESA,
                       COD_USUARIO_AUD,
                       IND_REPLICA,
                       PORC_DESCUENTO,
                       COD_QUIMICO,
                       ID_SUCURSAL
                  from STW_GRUPOS_ART
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
                t-Form--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    pageItem P66_ABREVIATURA (
        type: textField
        label {
            label: <p>Abreviatura:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: ABREVIATURA
            dataType: varchar2
        }
    )

    pageItem P66_COD_GRUPO_ART (
        type: textField
        label {
            label: <a style=" color:#3f46bb; font-weight:bold;">Cód. Grupo Art.:</a>
            alignment: left
        }
        layout {
            sequence: 20
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 5
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: COD_GRUPO_ART
            dataType: varchar2
        }
    )

    pageItem P66_COD_QUIMICO (
        type: textField
        label {
            label: <p>Cod. Quimico:&ensp;</p>
            alignment: left
        }
        layout {
            sequence: 50
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: COD_QUIMICO
            dataType: varchar2
        }
    )

    pageItem P66_COD_USUARIO_AUD (
        type: hidden
        layout {
            sequence: 110
            region: @carga-de-grupos-de-articulos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: COD_USUARIO_AUD
            dataType: varchar2
        }
        default {
            type: expression
            plsqlExpression: :APP_USER
        }
    )

    pageItem P66_DESCRIPCION (
        type: textField
        label {
            label: <p>Descripción:</p>
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 80
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: DESCRIPCION
            dataType: varchar2
        }
    )

    pageItem P66_ID (
        type: hidden
        layout {
            sequence: 90
            region: @carga-de-grupos-de-articulos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: ID
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: STW_GRUPOS_ART_ID_SEQ
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P66_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 100
            region: @carga-de-grupos-de-articulos
            slot: regionBody
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_COD_EMPRESA
        }
    )

    pageItem P66_ID_SUCURSAL (
        type: popupLov
        label {
            label: <p>Sucursal:&ensp;</p>
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
        }
        layout {
            sequence: 80
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: ID_SUCURSAL
            dataType: number
        }
    )

    pageItem P66_IND_REPLICA (
        type: switch
        label {
            label: <p>Réplica:</p>
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: SI
            offValue: N
            offLabel: NO
        }
        layout {
            sequence: 70
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: IND_REPLICA
            dataType: varchar2
        }
    )

    pageItem P66_PORC_DESCUENTO (
        type: numberField
        label {
            label: <p>Porc. Descuento: </p>
            alignment: left
        }
        layout {
            sequence: 60
            region: @carga-de-grupos-de-articulos
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @carga-de-grupos-de-articulos
            column: PORC_DESCUENTO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P66_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-trash
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P66_ID
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar cambios
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P66_ID
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p66-cod-grupo-art (
        itemName: P66_COD_GRUPO_ART
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                SELECT NVL(MAX(TO_NUMBER(COD_GRUPO_ART)), 0) + 1
                  FROM STW_GRUPOS_ART
                 WHERE ID_EMPRESA = :P0_ID_EMPRESA
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P66_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 10705500559834600
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-stgruposf (
        name: Initialize form STGRUPOSF
        type: formInitialization
        formRegion: @carga-de-grupos-de-articulos
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10704797002834600
        }
    )

    process process-form-stgruposf (
        name: Process form STGRUPOSF
        type: formAutoRowProcessing
        formRegion: @carga-de-grupos-de-articulos
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10705123824834600
        }
    )

)

