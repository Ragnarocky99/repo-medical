    region detalles-aprobaciones (
        name: Detalles Aprobaciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ID_APROBACION,
                       CANT_PEND_A_ENTREGAR,
                       ID_LICITACION_CAB,
                       CANT_A_ENTREGAR,
                       COD_ARTICULO,
                       DESC_ARTICULO,
                       PRESENTACION,
                       UNIDAD_MEDIDA,
                       MARCA,
                       NRO_ITEM,
                       STOCK,
                       ID_ARTICULO,
                       CANT_RESERVADA,
                       ID_SUCURSAL,
                       OBTENER_CANTIDAD_EXISTENTE(P_ID_ARTICULO    => ID_ARTICULO,
                                                  P_ID_SUCURSAL    => ID_SUCURSAL,
                                                  P_IND_DISPONIBLE => 'S') DISPONIBILIDAD
                  FROM LCWV_ARTICULOS_A_ENTREGAR
                 WHERE CANT_RESERVADA > 0
                ```
        }
        layout {
            sequence: 10
            parentRegion: @autorizaciones
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
