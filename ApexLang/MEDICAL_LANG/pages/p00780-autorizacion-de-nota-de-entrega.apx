    dynamicAction abrir-generacion-de-nota-entrega (
        name: Abrir Generacion de Nota Entrega
        execution {
            sequence: 40
        }
        when {
            event: custom
            customEvent: gen_ne
            selectionType: region
            region: @autorizaciones
        }

        action plugin-com-fos-interactive-grid-process-rows (
            action: plugin/fosInteractiveGridProcessRows
            settings {
                action: processSelectedRows
                plSqlCode: :P780_ID_LICITACION_CAB := :ID;
                itemsToSubmit: ID
                itemsToReturn: P780_ID_LICITACION_CAB
                errorMessage: #SQLERRM#
                extraOptions: escapeSpecialCharactersInMessages
            }
            affectedElements {
                selectionType: region
                region: @autorizaciones
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action plugin-com-fos-redirect (
            action: plugin/fosRedirect
            settings {
                targetPageUrl: {
                    page: 783
                    items: {
                        P783_ID: &P780_ID_LICITACION_CAB.
                    }
                }
                options: submitPageItemsBeforeRedirect
                pageItemsToSubmit: P780_ID_LICITACION_CAB
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions (
            action: plugin/fosSpinnerActions
            settings {
                accessibilityText: Processing
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-com-fos-spinner-actions-2 (
            action: plugin/fosSpinnerActions
            settings {
                action: removeSpinner
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction acciones-al-iniciar-pagina (
        name: Acciones al iniciar pagina
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action boton-generacion-nota-entrega (
            name: Boton Generacion Nota Entrega
            action: plugin/interactiveGridExtendToolbar
            settings {
                label: Gen. Nota de Entrega
                hot: true
                icon: fa-dynamic-content
                triggerAction: gen_ne
            }
            affectedElements {
                selectionType: region
                region: @autorizaciones
            }
            execution {
                sequence: 20
            }
        )

        action grilla-licitacion-modo-edicion (
            name: Grilla Licitacion Modo Edicion
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid = apex.region("LicitacionCab").call("getViews").grid;
                        grid.model.setOption("editable", true);
                        grid.setEditMode(true);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

