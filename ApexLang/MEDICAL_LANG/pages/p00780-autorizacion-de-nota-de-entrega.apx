    validation validar-cantidad-a-entregar-pend (
        name: Validar Cantidad a Entregar Pend.
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @detalles-aprobaciones
            plsqlExpression: TO_NUMBER(:CANT_A_ENTREGAR) <= TO_NUMBER(:CANT_PEND_A_ENTREGAR)
        }
        error {
            errorMessage: La cantidad a entregar no puede superar la cantidad pendiente.
            associatedColumn: CANT_A_ENTREGAR
        }
    )

    validation validar-cantidad-entregar-stock (
        name: Validar Cantidad Entregar Stock
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @detalles-aprobaciones
            plsqlExpression: TO_NUMBER(:CANT_A_ENTREGAR) <= TO_NUMBER(:STOCK)
        }
        error {
            errorMessage: La cantidad a entregar no puede superar el stock.
            associatedColumn: CANT_A_ENTREGAR
        }
    )

    process autorizaciones-save-interactive-grid-data (
        name: Autorizaciones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @autorizaciones
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 42398200512188127
        }
    )

    process detalles-aprobaciones-save-interactive-grid-data (
        name: Detalles Aprobaciones - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles-aprobaciones
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                BEGIN
                    CASE :APEX$ROW_STATUS
                    WHEN 'C' THEN
                        NULL;
                    WHEN 'U' THEN
                        UPDATE LCW_OFERTAS_APROBACIONES
                           SET CANT_A_ENTREGAR = :CANT_A_ENTREGAR
                         WHERE ID = :ID_APROBACION;
                    WHEN 'D' THEN
                        NULL;
                    END CASE;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 43409813229485409
        }
    )

)

