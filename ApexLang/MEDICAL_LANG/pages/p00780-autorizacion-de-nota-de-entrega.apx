page 780 (
    name: Autorizacion de Nota de Entrega
    alias: AUTORIZACION-DE-NOTA-DE-ENTREGA
    title: Autorizacion de Nota de Entrega
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region autorizaciones (
        name: Autorizaciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT LC.ID,
                       LC.ID_SUCURSAL,
                       LC.FEC_LICITACION,
                       LC.NRO_LICITACION,
                       LC.ID_CLIENTE,
                       LC.IND_AUTORIZA_STOCK,
                       LC.COD_USUARIO_AUT_STOCK,
                       LC.FEC_AUTORIZA_STOCK,
                       LC.IND_AUTORIZA_CTACTE,
                       LC.COD_USUARIO_AUT_CTACTE,
                       LC.FEC_AUTORIZA_CTACTE
                  FROM LCW_LICITACIONES_CAB LC
                 WHERE ID_EMPRESA  = :P0_ID_EMPRESA
                   AND ID_SUCURSAL = :P0_ID_SUCURSAL
                   AND EXISTS (SELECT 1
                                 FROM LCWV_RESUMEN_SISTEMA RS
                                WHERE RS.ID_LICITACION_CAB = LC.ID
                                  AND CANT_PEND_A_ENTREGAR > 0
                                  AND CALCULA_SALDO_STOCK(P_ID_EMPRESA  => LC.ID_EMPRESA,
                                                          P_ID_ARTICULO => RS.ID_ARTICULO,
                                                          P_ID_LOTE     => NULL,
                                                          P_ID_SUCURSAL => NULL,
                                                          P_FECHA       => SYSDATE) > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: LicitacionCab
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @derechos-actualizar-2
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 42396891193188113
        }

