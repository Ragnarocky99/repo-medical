page 706 (
    name: Gestión de Licitaciones
    alias: GESTIÓN-DE-LICITACIONES
    title: Gestión de Licitaciones
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            p{
                font-family: "Arial", serif;
                font-weight: bold;
                font-size:11.5px;
                color:#3f46bb;
            }
            .a-IG-controlsContainer{display: none;}
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @ruta-de-navegación
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region detalles-oferta (
        name: Detalles Oferta
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_OFERTA_CAB,       
                       NRO_ITEM,
                       ID_ARTICULO,
                       (SELECT DESCRIPCION FROM STW_ARTICULOS WHERE ID = D.ID_ARTICULO) DESC_ARTICULO,
                       ID_PROVEEDOR,     
                       COSTO_UNITARIO_LOCAL,
                       COSTO_TOTAL_LOCAL,       
                       nvl(PRECIO_TOTAL_PRC,0) PRECIO_TOTAL_PRC,
                       PAC,
                       IND_CONVIENE,              
                       CANTIDAD_SISTEMA,
                       CANTIDAD_CONFIRMADA,
                       cantidad_sistema - cantidad_confirmada as cantidad_pendiente,
                       IND_SE_OFERTA       ,
                       CANTIDAD_OCP,
                       COSTO_TOTAL_GS,
                       id_moneda
                  from LCW_OFERTAS_DET D
                  where ind_conviene = 'S'
                    and cantidad_sistema - cantidad_confirmada > 0
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        masterDetail {
            masterRegion: @gestión-de-licitaciones
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 23702711570412321
        }

