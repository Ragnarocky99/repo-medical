            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region gestión-de-licitaciones (
        name: Gestión de Licitaciones
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       NRO_OFERTA,
                       FEC_OFERTA,
                       NRO_LICITACION,
                       NRO_POLIZA,       
                       TOT_RESOLUCION,
                       ID_MONEDA,
                       TIP_CAMBIO,      
                       ID_CLIENTE,
                       ESTADO,
                       '' as previsualizacion       
                  from LCW_OFERTAS_CAB oc
                  where exists (
                      select 1
                      from lcw_ofertas_det
                      where ind_conviene = 'S'
                        and id_oferta_cab = oc.id
                        and cantidad_sistema - cantidad_confirmada > 0
                  )
                  and (oc.nro_oferta = :P706_NRO_OFERTA or :P706_NRO_OFERTA is null)
                  and (id_cliente = :P706_ID_CLIENTE or :P706_ID_CLIENTE is null)
                  and (nro_licitacion = :P706_NRO_LICITACION or :P706_NRO_LICITACION is null)
                  and fec_oferta between :P706_FEC_DESDE and :P706_FEC_HASTA
                ```
            pageItemsToSubmit: [
                P706_NRO_OFERTA
                P706_ID_CLIENTE
                P706_NRO_LICITACION
                P706_FEC_DESDE
                P706_FEC_HASTA
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 23677660882412304
        }

