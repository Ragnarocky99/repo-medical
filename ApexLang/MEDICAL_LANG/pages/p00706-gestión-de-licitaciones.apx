    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P0_ID_SUCURSAL
            value: 690
        }
    )

    dynamicAction r (
        name: R
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P706_NRO_OFERTA
                P706_ID_CLIENTE
                P706_NRO_LICITACION
                P706_FEC_DESDE
                P706_FEC_HASTA
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @gestión-de-licitaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation validar-cantidad (
        name: Validar Cantidad
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @detalles-oferta
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                begin
                if :CANTIDAD_OCP > :CANTIDAD_PENDIENTE THEN
                  RETURN FALSE;
                ELSE 
                  RETURN TRUE;
                END IF;
                end;
                ```
        }
        error {
            errorMessage: Error, no se puede generar una cantidad mayor a la pendiente.
            associatedColumn: CANTIDAD_OCP
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process detalles-oferta-save-interactive-grid-data (
        name: Detalles Oferta - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detalles-oferta
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 23745091469412335
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

