page 1001 (
    name: Visualizar Imagen (Bienes Uso)
    alias: VISUALIZAR-IMAGEN-BIENES-USO
    title: Visualizar Imagen (Bienes Uso)
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        source {
            htmlCode: <img src="&P1001_SRC." height="600" width="700">
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P1001_ID (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P1001_ID_BIEN (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P1001_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P1001_SRC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    computation p1001-src (
        itemName: P1001_SRC
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                v_src varchar2(100);
                BEGIN
                    SELECT '/i/IMAGENES_APEX/'||ID_BIEN||'-'||ID||'.jpg' 
                    into v_src  
                    FROM
                    COW_IMG_BIENES_USO
                    WHERE ID_BIEN=:P1001_ID_BIEN
                    AND  ID =:P1001_ID
                    AND ID_EMPRESA=:P0_ID_EMPRESA;
                    RETURN V_SRC;
                     EXCEPTION WHEN OTHERS THEN
                        RETURN NULL;
                END;
                ```
        }
    )

)

