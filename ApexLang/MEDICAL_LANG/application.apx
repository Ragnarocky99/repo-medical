app SISTEMA-INVENTIVA001116120 (
    name: 120-MEDICAL QUIMICA
    version: Versión 1.22
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#icons/app-icon-192.png
        text: Sistema Inventiva
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--default
            t-TreeNav--classic
        ]
        list: @menu-dinamico
    }
    navigationBar {
        list: @barra-de-navegación
        listTemplate: @navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    javaScript {
        fileUrls: https://cdn.jsdelivr.net/npm/sweetalert2@11
    }
    authentication {
        scheme: @cuentas-de-base-de-datos
        publicUser: APEX_PUBLIC_USER
    }
    sessionStateProtection {
        checksumSalt: 0EB9E1E2592DA132BFFC231C3587476958A7644FB142AFFA8DB9EE71F9EF151A
    }
    sessionManagement {
        sessionStateCommits: immediate
        maxSessionLength: 31536000
        maxSessionIdleTime: 31536000
        sessionTimeoutWarning: 600
    }
    globalization {
        primaryLanguage: es
        documentDirection: leftToRight
        autoTimeZone: true
    }
    errorHandling {
        errorHandlingFunctionName: apex_error_handling_example
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        modernizeApp: true
    }

    substitution APP_NAME (
        value {
            staticValue: Sistema Inventiva
        }
    )

    appSetting FEEDBACK_ATTACHMENTS_YN (
        value {
            staticValue: Y
            onUpgradeKeepValue: true
        }
        validation {
            validValues: Y, N
        }
        config {
            buildOption: @feature-feedback
        }
    )

)

